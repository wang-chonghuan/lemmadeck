  "exercises": [
    {
      "number": "231",
      "text": "\u4e0b\u5217\u5404\u8868\u7ed9\u51fa\u7684\u51fd\u6570\u662f\u6b63\u6bd4\u4f8b\u5173\u7cfb\u5417\uff1f",
      "figure_ids": [
        "tbl-p0069-01"
      ]
    },
    {
      "number": "232",
      "text": "\u51fd\u6570 $f$ \u662f\u6b63\u6bd4\u4f8b\u51fd\u6570\uff0c\u6bd4\u4f8b\u7cfb\u6570\u662f $3$\u3002\u7528\u5f0f\u5b50\u5199\u51fa\u51fd\u6570 $f$ \u5e76\u586b\u8868\uff1a",
      "figure_ids": [
        "tbl-p0069-02"
      ]
    },
    {
      "number": "233",
      "text": "\u51fd\u6570 $a\\xrightarrow{f}b$ \u662f\u6b63\u6bd4\u4f8b\u51fd\u6570\uff0c\u6bd4\u4f8b\u7cfb\u6570\u662f $-5$\u3002\u7528\u5f0f\u5b50\u5199\u51fa\u51fd\u6570\u5e76\u586b\u8868\uff1a",
      "figure_ids": [
        "tbl-p0069-03"
      ]
    },
    {
      "number": "234",
      "text": "\u51fd\u6570 $g$ \u662f\u6b63\u6bd4\u4f8b\u51fd\u6570\u3002\u4ece\u4e0b\u8868\u4e2d\u6c42\u51fa\u6bd4\u4f8b\u7cfb\u6570\u3002\u7528\u5f0f\u5b50\u5199\u51fa\u51fd\u6570 $g$ \u5e76\u586b\u8868\uff1a",
      "figure_ids": [
        "tbl-p0069-04"
      ]
    },
    {
      "number": "235",
      "text": "\u6b63\u6bd4\u4f8b\u51fd\u6570 $h$ \u7531\u4e0b\u5404\u8868\u7ed9\u51fa\uff0c\u4f46\u53d8\u91cf $x$ \u548c $y$ \u7684\u4e00\u4e9b\u503c\u6ca1\u6709\u5217\u51fa\u3002\u5c3d\u53ef\u80fd\u586b\u51fa\u7a7a\u683c\u91cc\u7684\u6570\uff1a",
      "figure_ids": [
        "tbl-p0069-05",
        "tbl-p0070-01"
      ]
    },
    {
      "number": "236",
      "text": "\u4e0b\u8868\u4e2d\u5217\u51fa\u4e86\u5feb\u8f66\u5305\u53a2\u7684\u7968\u4ef7 $p$\uff08\u7f8e\u5143\uff09\u548c\u8ddd\u79bb $s$\uff08\u516c\u91cc\uff09\u7684\u8868\uff1a\u53d8\u91cf $p$ \u548c\u53d8\u91cf $s$ \u6210\u6b63\u6bd4\u4f8b\u5417\uff1f",
      "figure_ids": [
        "tbl-p0070-02"
      ]
    },
    {
      "number": "237",
      "text": "a) \u8bbe $t$ \u662f\u706b\u8f66\u884c\u9a76\u65f6\u95f4\uff08\u5c0f\u65f6\uff09\uff0c$s$ \u662f\u884c\u9a76\u7684\u8def\u7a0b\uff08\u516c\u91cc\uff09\u3002\u5982\u679c\u706b\u8f66\u4ee5\u5300\u901f\u884c\u9a76\uff0c\u53d8\u91cf $s$ \u548c\u53d8\u91cf $t$ \u6210\u6b63\u6bd4\u4f8b\u5417\uff1f\nb) \u8bbe $x$ \u662f\u4e00\u6bb5\u6599\u5b50\u7684\u957f\u5ea6\uff08\u7c73\uff09\uff0c$y$ \u662f\u8fd9\u6bb5\u6599\u5b50\u7684\u4ef7\u683c\uff08\u7f8e\u5143\uff09\u3002\u53d8\u91cf $y$ \u548c\u53d8\u91cf $x$ \u6210\u6b63\u6bd4\u4f8b\u5417\uff1f\nc) \u8bbe $x$ \u662f\u6b63\u65b9\u5f62\u7684\u8fb9\u957f\uff08\u5398\u7c73\uff09\uff0c$S$ \u662f\u5b83\u7684\u9762\u79ef\uff08\u5e73\u65b9\u5398\u7c73\uff09\u3002\u53d8\u91cf $S$ \u548c\u53d8\u91cf $x$ \u6210\u6b63\u6bd4\u4f8b\u5417\uff1f\nd) \u8bbe $V$ \u662f\u94c1\u5757\u7684\u4f53\u79ef\uff08\u7acb\u65b9\u5398\u7c73\uff09\uff0c$m$ \u662f\u94c1\u5757\u7684\u8d28\u91cf\uff08\u514b\uff09\u3002\u53d8\u91cf $m$ \u548c\u53d8\u91cf $V$ \u6210\u6b63\u6bd4\u4f8b\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "238",
      "text": "\u6469\u6258\u8f66\u884c\u9a76\u901f\u5ea6\u662f 18 \u516c\u91cc/\u5c0f\u65f6\u3002\u7528\u5f0f\u5b50\u8868\u793a\u8def\u7a0b $s$\uff08\u516c\u91cc\uff09\u548c\u65f6\u95f4 $t$\uff08\u5c0f\u65f6\uff09\u7684\u4f9d\u8d56\u5173\u7cfb\u3002\u5982\u679c\u7528 $s$ \u8868\u793a\u8def\u7a0b\u7684\u957f\u5ea6\uff0c\u7528 $t$ \u8868\u793a\u8fd0\u52a8\u7684\u65f6\u95f4\uff08\u79d2\uff09\uff0c\u5f0f\u5b50\u53d8\u6210\u600e\u6837\uff1f",
      "figure_ids": []
    },
    {
      "number": "239",
      "text": "\u4e00\u79cd\u5546\u54c1\u6bcf\u516c\u65a4\u503c 3 \u7f8e\u5143 50 \u7f8e\u5206\u3002\u7528\u5f0f\u5b50\u8868\u793a\u4ef7\u503c $y$\uff08\u7f8e\u5143\uff09\u548c\u5546\u54c1\u91cd\u91cf\uff08\u516c\u65a4\uff09\u7684\u4f9d\u8d56\u5173\u7cfb\u3002",
      "figure_ids": []
    },
    {
      "number": "240",
      "text": "\u89e3\u65b9\u7a0b\uff1a\na) $3.6:x=18:27$\uff1b\nb) $1.2:0.04=3.7:b$\uff1b\nc) $\\frac{81}{0.5}=\\frac{y}{0.75}$\uff1b\nd) $\\frac{16}{a}=\\frac{0.48}{1.7}$\u3002",
      "figure_ids": []
    },
    {
      "number": "241",
      "text": "\u6e38\u8247\u5728\u6e56\u4e0a\u884c\u8fdb\u3002\u968f\u7740\u65f6\u95f4\u7684\u53d8\u5316\uff0c\u8239\u548c\u8239\u575e\u7684\u8ddd\u79bb\u4e5f\u5728\u53d8\u5316\u3002\u8ddd\u79bb $s$\uff08\u516c\u91cc\uff09\u548c\u65f6\u95f4 $t$\uff08\u5206\u949f\uff09\u7684\u4f9d\u8d56\u5173\u7cfb\u89c1\u56fe 58 \u7684\u56fe\u8c61\u3002\u51fa\u53d1\u540e 20 \u5206\u949f\u6e38\u8247\u548c\u8239\u575e\u7684\u8ddd\u79bb\u6709\u591a\u8fdc\uff1f40 \u5206\u949f\u5462\uff1f1 \u5c0f\u65f6 20 \u5206\u949f\u5462\uff1f2 \u5c0f\u65f6 30 \u5206\u949f\u5462\uff1f\u51fa\u53d1\u540e\u7ecf\u8fc7\u591a\u5c11\u5206\u949f\u6e38\u8247\u548c\u8239\u575e\u7684\u8ddd\u79bb\u662f 8 \u516c\u91cc\uff1f",
      "figure_ids": [
        "fig-58"
      ]
    },
    {
      "number": "242",
      "text": "\u89e3\u65b9\u7a0b\uff1a\na) $|x|=12$\uff1b\nb) $|y|=3$\uff1b\nc) $|x|=-1$\u3002",
      "figure_ids": []
    },
    {
      "number": "243",
      "text": "\u7528\u5217\u51fa\u5143\u7d20\u7684\u65b9\u6cd5\u8868\u793a\u4e0b\u9762\u7684\u96c6\u5408\uff1a\na) $\\{n|n\\in N,n^2<17\\}$\uff1b\nb) $\\{a|a\\in Z,a^2<10\\}$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u4e0a\u9762\u4e24\u4e2a\u4f8b\u5b50\u4e2d\u8ba8\u8bba\u7684\u51fd\u6570\uff0c\u90fd\u662f\u7528\u5f0f $y=kx$ \u7ed9\u51fa\u7684\uff0c\u5176\u4e2d $x$ \u548c $y$ \u662f\u53d8\u91cf\uff0c$k$ \u662f\u4e0d\u7b49\u4e8e\u96f6\u7684\u6570\u3002"
    },
    {
      "block": 3,
      "text": "\u53ef\u4ee5\u7528\u5f0f $y=kx$\uff08\u5176\u4e2d $k$ \u662f\u4e0d\u7b49\u4e8e\u96f6\u7684\u6570\uff09\u7ed9\u51fa\u7684\u51fd\u6570\uff0c\u53eb\u505a\u6b63\u6bd4\u4f8b\u51fd\u6570\uff08\u7b80\u79f0\u6b63\u6bd4\u4f8b\uff09\u3002"
    },
    {
      "block": 4,
      "text": "\u6570 $k$ \u53eb\u505a\u6bd4\u4f8b\u7cfb\u6570\u3002\n\u5c31\u53d8\u91cf $y$ \u6765\u8bf4\uff0c$y$ \u548c\u53d8\u91cf $x$ \u6210\u6b63\u6bd4\u3002"
    },
    {
      "block": 6,
      "text": "\u5f53 $x\\ne0$ \u65f6\uff0c\u7531\u516c\u5f0f $y=kx$ \u5f97\u51fa $\\frac{y}{x}=k$\u3002\n\u53cd\u8fc7\u6765\u4e5f\u5bf9\uff1a\u5982\u679c$\\frac{y}{x}=k$\uff0c\u90a3\u4e48 $y=kx$\u3002\n\u56e0\u6b64\uff0c\u8981\u8bf4\u660e\u51fd\u6570 $x\\xrightarrow{f}y$ \u662f\u4e0d\u662f\u6b63\u6bd4\u4f8b\u51fd\u6570\uff0c\u53ea\u8981\u68c0\u9a8c\u53d8\u91cf $x$ \u548c $y$ \u6240\u6709\u7684\u5bf9\u5e94\u503c\u6570\u5bf9\u7684\u5546 $\\frac{y}{x}$ \u662f\u5426\u76f8\u7b49\u5c31\u884c\u4e86\uff08\u5176\u4e2d $x\\ne0$\uff09\u3002\n\n\u5982\u679c\u6240\u5f97\u7684\u5546\u90fd\u7b49\u4e8e\u540c\u4e00\u4e2a\u4e0d\u7b49\u4e8e\u96f6\u7684\u6570 $k$\uff0c\u800c\u4e14\u5f53 $x$ \u7b49\u4e8e\u96f6\u65f6\uff08\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u5305\u542b $0$ \u7684\u60c5\u51b5\uff09\uff0c\u5bf9\u5e94\u7684 $y$ \u4e5f\u7b49\u4e8e\u96f6\uff0c\u90a3\u4e48 $y$ \u5bf9 $x$ \u7684\u4f9d\u8d56\u5173\u7cfb\u5c31\u662f\u6b63\u6bd4\u4f8b\u5173\u7cfb\u3002"
    }
  ],
