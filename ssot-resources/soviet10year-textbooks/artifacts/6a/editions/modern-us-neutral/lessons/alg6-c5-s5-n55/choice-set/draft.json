        {"id": "f", "text": "$\\frac{4y^2-12y+9}{9-4y^2}=\\frac{3-2y}{3+2y}$；$y\\ne\\frac32,-\\frac32$。", "figure_ids": []}
      ]},
      "intent": {"task": "结合完全平方与平方差完成六个原分式的约分和域判断。", "source_solution": "依次1/(a+x)，5/(a-b)，(a-7)/7，a/(3b-1)，(a+10)/(a-10)，(3-2y)/(3+2y)；原禁值分别a+x=0,a=b,a=7,b=1/3,a=10,y=±3/2。", "unit_reason": "完整分式和原禁值一起作判断，不单独选一项因子。", "concept_blocks": [0, 1], "limitations": ["不证明自主因式分解约分和列取值条件。"], "figure_observations": []},
      "key": {"correct": ["a", "c", "d", "f"], "rationales": [
        {"option_id": "a", "truth": "correct", "derivation": "分母(a+x)²，只取消一个非零因子。", "misconception": null},
        {"option_id": "b", "truth": "incorrect", "derivation": "把(a-b)²误分成(a-b)(a+b)，取消后错得5/(a+b)。", "misconception": "差平方误作平方差。"},
