        {"id": "d", "text": "$64+16b+b^2=(b+8)^2$", "figure_ids": []},
        {"id": "e", "text": "$1-2z+z^2=(1+z)^2$", "figure_ids": []},
        {"id": "f", "text": "$n^2+4n+4=(n+2)^2$", "figure_ids": []}
      ]},
      "intent": {"task": "识别六个完全平方三项式的符号、系数和项次序。", "source_solution": "依次(x+y)²，(p-q)²，(a+6)²，(b+8)²，(1-z)²，(n+2)²。", "unit_reason": "完整恒等变换作为多选单位，不只选择一个平方底数。", "concept_blocks": [0, 1], "limitations": ["不证明自主重排项并写出六个平方。"], "figure_observations": []},
      "key": {"correct": ["a", "b", "d", "f"], "rationales": [
        {"option_id": "a", "truth": "correct", "derivation": "中项是两底数乘积的2倍。", "misconception": null},
        {"option_id": "b", "truth": "correct", "derivation": "差平方的中项为-2pq。", "misconception": null},
        {"option_id": "c", "truth": "incorrect", "derivation": "直接将一次项系数12作常数底数，展开变a²+24a+144；应取6。", "misconception": "中项系数未减半。"},
        {"option_id": "d", "truth": "correct", "derivation": "8²=64，中项2×8b=16b。", "misconception": null},
        {"option_id": "e", "truth": "incorrect", "derivation": "忽略中项负号选和平方，展开为1+2z+z²。", "misconception": "中项符号遗漏。"},
        {"option_id": "f", "truth": "correct", "derivation": "2²=4，中项2×2n=4n。", "misconception": null}
      ]}
    },
