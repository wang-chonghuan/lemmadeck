  "exercises": [
    {
      "number": "259",
      "text": "\u4f5c\u5f0f $y=3x$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u6839\u636e\u56fe\u8c61\u6c42\uff1a\na) $x$ \u7b49\u4e8e 1\u30011.5\u30012.5\u30013 \u65f6\u5bf9\u5e94\u7684 $y$ \u503c\uff1b\nb) \u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6 $y$ \u503c\u7b49\u4e8e $-3$\u30010\u30013\uff1b\nc) \u53d8\u91cf $y$ \u5206\u522b\u53d6\u6b63\u503c\u548c\u8d1f\u503c\u65f6 $x$ \u503c\u7684\u96c6\u5408\u3002",
      "figure_ids": []
    },
    {
      "number": "260",
      "text": "\u4f5c\u5f0f $y=-0.5x$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u6839\u636e\u56fe\u8c61\u6c42\uff1a\na) $x$ \u7b49\u4e8e $-2$\u30014\u30011 \u65f6\u5bf9\u5e94\u7684 $y$ \u503c\uff1b\nb) \u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\u51fd\u6570\u503c\u7b49\u4e8e $-1$\u30010\u30012.5\uff1f\nc) \u51fd\u6570\u5206\u522b\u53d6\u6b63\u503c\u548c\u8d1f\u503c\u65f6 $x$ \u503c\u7684\u96c6\u5408\u3002\u6709\u6ca1\u6709\u4f7f $y$ \u7684\u503c\u7b49\u4e8e $-150$ \u7684 $x$ \u503c\uff1f\u5982\u679c\u6709\uff0c\u5c31\u6c42\u51fa\u6765\u3002",
      "figure_ids": []
    },
    {
      "number": "261",
      "text": "\u4f5c\u5f0f $y=2x$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u6839\u636e\u56fe\u8c61\u6c42\uff1a\na) $g(2)$\u3001$g(2.5)$\u3001$g(3)$\u3001$g(4)$\uff1b\nb) \u6570\u533a\u95f4 $[2,4]$ \u548c $[2.5,3]$ \u5206\u522b\u6620\u5c04\u5230\u54ea\u4e2a\u96c6\u5408\uff1f\nc) $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\u51fd\u6570\u503c\u7b49\u4e8e 7\uff08\u901a\u8fc7\u8ba1\u7b97\u68c0\u67e5\u7b54\u6848\u662f\u5426\u6b63\u786e\uff09\uff1f\nd) $g(x)>0$\u3001$g(x)<0$ \u65f6 $x$ \u503c\u7684\u96c6\u5408\u3002",
      "figure_ids": []
    },
    {
      "number": "262",
      "text": "\u4f5c\u5f0f $y=-2.5x$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u6839\u636e\u56fe\u8c61\u6c42\uff1a\na) $f(0)$\u3001$f(2.5)$\u3001$f(3)$\uff1b\nb) $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\u51fd\u6570\u503c\u7b49\u4e8e 5\u3001$-7.5$\uff08\u901a\u8fc7\u8ba1\u7b97\u68c0\u67e5\u7b54\u6848\u662f\u5426\u6b63\u786e\uff09\uff1b\nc) \u6570\u533a\u95f4 $[-2,0]$ \u548c $[-2,3]$ \u6620\u5c04\u5230\u4ec0\u4e48\u96c6\u5408\uff1f\nd) $f(x)>0$\u3001$f(x)<0$ \u65f6 $x$ \u503c\u7684\u96c6\u5408\u3002",
      "figure_ids": []
    },
    {
      "number": "263",
      "text": "\u77e9\u5f62\u7684\u5e95\u8fb9\u957f 2.5 m\uff0c\u9ad8 $x$ m\u3002\u7528 $x$ \u8868\u793a\u77e9\u5f62\u7684\u9762\u79ef\uff08\u5355\u4f4d\uff1a\u5e73\u65b9\u7c73\uff09\u3002\u4f5c $y$ \u5bf9 $x$ \u7684\u4f9d\u8d56\u5173\u7cfb\u7684\u56fe\u8c61\u3002\na) \u77e9\u5f62\u7684\u9ad8\u662f 3.5 m\u30014 m \u65f6\uff0c\u77e9\u5f62\u7684\u9762\u79ef\u662f\u591a\u5c11\u5e73\u65b9\u7c73\uff1f\nb) \u77e9\u5f62\u7684\u9762\u79ef\u662f 6 \u5e73\u65b9\u7c73\u30018 \u5e73\u65b9\u7c73\uff0c\u9ad8\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "264",
      "text": "\u56fe 64 \u7ed9\u51fa\u7684\u662f\u6b65\u884c\uff08\u7ebf\u6bb5 $OA$\uff09\u548c\u9a91\u81ea\u884c\u8f66\uff08\u7ebf\u6bb5 $OB$\uff09\u8fd0\u52a8\u7684\u56fe\u8c61\u3002\u6839\u636e\u56fe\u8c61\u56de\u7b54\u4e0b\u5217\u95ee\u9898\uff1a\na) \u5728\u8def\u4e0a\u6b65\u884c\u4e86\u591a\u5c11\u5c0f\u65f6\uff1f\u9a91\u81ea\u884c\u8f66\u591a\u5c11\u5c0f\u65f6\uff1f\nb) \u6b65\u884c\u548c\u9a91\u81ea\u884c\u8f66\u7684\u8def\u7a0b\u5206\u522b\u662f\u591a\u5c11\u516c\u91cc\uff1f\nc) \u6b65\u884c\u548c\u9a91\u81ea\u884c\u8f66\u7684\u901f\u5ea6\u600e\u6837\uff1f\nd) \u9a91\u81ea\u884c\u8f66 2 \u5c0f\u65f6\u6240\u7ecf\u8fc7\u7684\u8def\u7a0b\u662f\u6b65\u884c 2 \u5c0f\u65f6\u7684\u51e0\u500d\uff1f",
      "figure_ids": [
        "fig-64"
      ]
    },
    {
      "number": "265",
      "text": "\u4e00\u4e2a\u96f6\u4ef6\u7684\u8d28\u91cf\u662f 0.75 kg\u3002\u5982\u679c\u7528 $y$ \u8868\u793a $x$ \u4e2a\u96f6\u4ef6\u7684\u8d28\u91cf\uff0c\u5199\u51fa\u7528 $x$ \u8868\u793a $y$ \u7684\u5f0f\u5b50\u3002\u4f5c $y$ \u5bf9 $x$ \u4f9d\u8d56\u5173\u7cfb\u7684\u56fe\u8c61\u3002",
      "figure_ids": []
    },
    {
      "number": "266",
      "text": "\u51fd\u6570 $f$ \u7684\u56fe\u8c61\u662f\u4e00\u6761\u76f4\u7ebf\uff08\u56fe 65\uff09\u3002\u7528\u5f0f\u5b50\u5199\u51fa\u8fd9\u4e2a\u51fd\u6570\u3002",
      "figure_ids": [
        "fig-65"
      ]
    },
    {
      "number": "267",
      "text": "\u56fe 66 \u4e0a\u753b\u51fa\u7684\u662f\u6b63\u6bd4\u4f8b\u51fd\u6570\u7684\u56fe\u8c61\u3002\u5bf9\u6bcf\u4e00\u4e2a\u56fe\u8c61\u5199\u51fa\u6bd4\u4f8b\u7cfb\u6570\u3002",
      "figure_ids": [
        "fig-66"
      ]
    },
    {
      "number": "268",
      "text": "\u4e00\u4eba\u4ece\u57ce\u91cc\u51fa\u53d1\u3002\u7ecf\u8fc7 $x$ \u5c0f\u65f6\u540e\u4ed6\u79bb\u57ce\u7684\u8ddd\u79bb\u662f $y$ \u516c\u91cc\u3002$y$ \u5bf9 $x$ \u7684\u4f9d\u8d56\u5173\u7cfb\u5982\u4e0b\u8868\uff1a\u5728\u5750\u6807\u5e73\u9762\u4e0a\u63cf\u51fa\u8868\u4e2d\u6240\u5217\u5750\u6807\u7684\u70b9\uff0c\u7136\u540e\u7528\u76f4\u5c3a\u8bf4\u660e\u8fd9\u4e9b\u70b9\u5927\u81f4\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\u3002\u5217\u51fa\u8fd1\u4f3c\u5730\u8868\u793a $y$ \u5bf9 $x$ \u4f9d\u8d56\u5173\u7cfb\u7684\u5f0f\u5b50\u3002",
      "figure_ids": [
        "tbl-p0080-01"
      ]
    },
    {
      "number": "269",
      "text": "\u94a2\u4e1d\u5728\u62c9\u529b $p$\uff08\u5355\u4f4d\uff1a\u725b\u987f\uff09\u4f5c\u7528\u4e0b\u4f38\u957f $y$\uff08\u6beb\u7c73\uff09\uff0c\u56fe 67\u753b\u51fa\u4e86 $y$ \u5bf9 $p$ \u7684\u4f9d\u8d56\u5173\u7cfb\u7684\u56fe\u8c61\u3002\u6307\u51fa\u4f38\u957f\u548c\u62c9\u529b\u6210\u6b63\u6bd4\u7684\u6761\u4ef6\u4e0b\u53d8\u91cf $p$ \u53d6\u503c\u7684\u96c6\u5408\u3002",
      "figure_ids": [
        "fig-67"
      ]
    },
    {
      "number": "270",
      "text": "$A(6,-2)$\u3001$B(-2,-10)$\u3001$C(1,1)$\u3001$D\\left(-\\frac{1}{3},1\\frac{2}{3}\\right)$\u3001$E$ $(0,0)$ \u51e0\u70b9\u4e2d\uff0c\u54ea\u4e9b\u70b9\u5c5e\u4e8e\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\uff1a\na) $y=-\\frac{1}{3}x$\uff1b\nb) $y=5x$\u3002",
      "figure_ids": []
    },
    {
      "number": "271",
      "text": "\u753b\u51fa\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u7684\u8349\u56fe\uff1a\na) $y=1.7x$\uff1b\nb) $y=-3.1x$\uff1b\nc) $y=0.9x$\uff1b\nd) $y=-2.3x$\uff1b\ne) $y=kx,\\ k>0$\uff1b\nf) $y=kx,\\ k<0$\u3002",
      "figure_ids": []
    },
    {
      "number": "272",
      "text": "\u89e3\u65b9\u7a0b\uff1a\na) $3(0.9x-1)-2(x+0.6)=0$\u3002\nb) $7-5(3.2-0.01y)=3-0.2y$\u3002",
      "figure_ids": []
    },
    {
      "number": "273",
      "text": "\u5236\u4f5c\u74f7\u571f\u65f6\u6309 25\u30011\u30012 \u7684\u6bd4\u4f8b\u53d6\u571f\u3001\u77f3\u818f\u3001\u7ec6\u7802\u6df7\u5408\u3002\u8981\u5236\u4f5c 350 \u514b\u74f7\u571f\uff0c\u9700\u7528\u571f\u3001\u77f3\u818f\u3001\u7ec6\u7802\u5404\u591a\u5c11\u514b\u3002",
      "figure_ids": []
    },
    {
      "number": "274",
      "text": "Pine \u6cb3\u3001Cedar \u6cb3\u3001Maple \u6cb3\u7684\u957f\u5ea6\uff08\u516c\u91cc\uff09\u548c\u6570 22\u300119\u300115 \u6210\u6b63\u6bd4\u3002\u5df2\u77e5Maple \u6cb3\u6bd4Pine \u6cb3\u77ed 700 \u516c\u91cc\uff0c\u6c42\u6bcf\u6761\u6cb3\u7684\u957f\u5ea6\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 13,
      "text": "\u4e00\u822c\u5730\uff0c\u5f0f $y=kx$\uff08$k\\ne0$\uff09\u7ed9\u51fa\u7684\u51fd\u6570\u56fe\u8c61\u662f\u7ecf\u8fc7\u5750\u6807\u539f\u70b9\u7684\u4e00\u6761\u76f4\u7ebf\u3002"
    },
    {
      "block": 15,
      "text": "\u5f0f $y=kx$\uff08$k\\ne0$\uff09\u7ed9\u51fa\u7684\u51fd\u6570\uff0c\u5982\u679c\u5b9a\u4e49\u57df\u4e0d\u662f\u6240\u6709\u6570\u7684\u96c6\u5408\uff0c\u90a3\u4e48\u5b83\u7684\u56fe\u8c61\u662f\u76f4\u7ebf\u4e0a\u70b9\u7684\u5b50\u96c6\uff08\u5982\u5c04\u7ebf\u3001\u7ebf\u6bb5\u3001\u79bb\u6563\u7684\u70b9\uff09\u3002"
    },
    {
      "block": 16,
      "text": "\u4f5c\u4e00\u6761\u76f4\u7ebf\uff0c\u53ea\u8981\u77e5\u9053\u5b83\u4e0a\u9762\u4e24\u4e2a\u70b9\u7684\u4f4d\u7f6e\u5c31\u53ef\u4ee5\u4e86\u3002\n\u56e0\u6b64\uff0c\u5728\u6240\u6709\u6570\u7684\u96c6\u5408\u4e0a\u7ed9\u51fa\u7684\u6b63\u6bd4\u4f8b\u7684\u56fe\u8c61\uff0c\u63cf\u51fa\u4e24\u4e2a\u70b9\u5c31\u53ef\u4ee5\u4f5c\u51fa\uff08\u5176\u4e2d\u4e00\u4e2a\u70b9\u9009\u53d6\u539f\u70b9\u6bd4\u8f83\u65b9\u4fbf\uff09\u3002"
    },
    {
      "block": 23,
      "text": "\u53ef\u4ee5\u8bc1\u660e\uff0c\u7ecf\u8fc7\u539f\u70b9\u800c\u4e14\u4e0d\u548c\u5750\u6807\u8f74\u91cd\u5408\u7684\u4efb\u4f55\u76f4\u7ebf\uff0c\u90fd\u662f\u6b63\u6bd4\u4f8b\u51fd\u6570\u7684\u56fe\u8c61\u3002"
    }
