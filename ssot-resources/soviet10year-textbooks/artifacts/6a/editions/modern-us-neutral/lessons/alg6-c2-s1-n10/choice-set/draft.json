      "view": {
        "mode": "single",
        "stem": "每个两位质数对应 $0$，每个两位合数对应 $1$。$12,17,29,99$ 依次对应什么？该关系是函数吗？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$(0,1,1,0)$；是函数。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$(1,0,0,1)$；不是函数。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$(1,0,0,1)$；是函数。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "分类质数合数并检验唯一对应。",
        "source_solution": "12=3×4、99=9×11是合数，17和29无除1及自身外的正因数，是质数；像为1,0,0,1。每个两位自然数恰为质数或合数，分类互斥完整，故为函数。",
        "unit_reason": "四数分类与整条规则的唯一性是一次完整判断。",
        "concept_blocks": [],
        "limitations": [
          "选择结果不证明独立书写计算或推导。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "四个像把两类标签对调。",
            "misconception": "质数合数分类正确，却把质数记1、合数记0，反转题设编码。"
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "不同合数共像1、不同质数共像0不影响输入的唯一输出。",
            "misconception": "因12与99同像、17与29同像，错误要求不同输入有不同输出。"
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "12、99为合数对应1，17、29为质数对应0；每个两位数唯一落在两类之一。",
            "misconception": null
          }
        ]
      }
    },
