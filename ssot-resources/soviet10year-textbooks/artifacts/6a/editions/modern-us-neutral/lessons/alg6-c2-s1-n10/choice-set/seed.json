  "exercises": [
    {
      "number": "201",
      "text": "\u89c4\u5b9a\u6bcf\u4e2a\u4e24\u4f4d\u7684\u8d28\u6570\u5bf9\u5e94 0\uff0c\u800c\u6bcf\u4e2a\u4e24\u4f4d\u7684\u5408\u6570\u5bf9\u5e94 1\u300212\u300117\u300129\u300199 \u5206\u522b\u5bf9\u5e94\u54ea\u4e2a\u6570\uff1f\u4e0a\u9762\u7684\u53d9\u8ff0\u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "202",
      "text": "\u7528\u4e0b\u9762\u7684\u53d9\u8ff0\u7ed9\u51fa\u51fd\u6570 $r$\uff1a\u201c\u6bcf\u4e00\u4e2a\u81ea\u7136\u6570\u5bf9\u5e94\u8fd9\u4e2a\u6570\u88ab 4 \u6574\u9664\u540e\u7684\u4f59\u6570\u201d\u300213\u3001120\u3001162\u3001999 \u7684\u8c61\u662f\u4ec0\u4e48\u6570\uff1f\u51fd\u6570 $r$ \u7684\u503c\u57df\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "203",
      "text": "\u89c4\u5b9a\u5706\u5468\u4e0a\u6bcf\u4e00\u70b9\uff08\u56fe 41\uff09\u5bf9\u5e94\u5706\u5468\u4e0a\u8fc7\u8fd9\u70b9\u7684\u76f4\u5f84\u7684\u53e6\u4e00\u7aef\u70b9\uff08\u4f8b\u5982\uff0c$A\\to C,D\\to B$\uff09\u3002\u4e3a\u4ec0\u4e48\u4e0a\u9762\u7684\u53d9\u8ff0\u7ed9\u51fa\u7684\u662f\u4e00\u4e2a\u51fd\u6570\uff1f$B$ \u70b9\u7684\u8c61\u662f\u54ea\u4e00\u70b9\uff1f$C$ \u70b9\u5462\uff1f$M$ \u70b9\u5462\uff1f\u5706\u5468\u6620\u5c04\u5230\u54ea\u4e2a\u96c6\u5408\u5462\uff1f",
      "figure_ids": [
        "fig-41"
      ]
    },
    {
      "number": "204",
      "text": "\u7528\u5f0f $f(x)=0.1x+5$ \u7ed9\u51fa\u51fd\u6570 $f$\u3002\u6c42 $f(-100)$\u3001$f(-10)$\u3001$f(0)$\u3001$f(20)$\u3001$f(400)$\u3002",
      "figure_ids": []
    },
    {
      "number": "205",
      "text": "\u5df2\u77e5 $g(x)=x^2$\uff0c\u6c42 $g(0.2)$\u3001$g\\left(-\\frac{1}{5}\\right)$\u3001$g(10)$\u3001$g\\left(\\frac{1}{3}\\right)$\u3001$g\\left(\\frac{1}{7}\\right)$\u3002",
      "figure_ids": []
    },
    {
      "number": "206",
      "text": "\u7528\u5f0f $y=\\frac{x^2-1}{3}$ \u7ed9\u51fa\u51fd\u6570 $f$\uff0c\u5176\u4e2d $x\\in\\{-7,-4,0,5,7\\}$\uff08\u4ee5\u540e\u5982\u679c\u4e0d\u4f5c\u8bf4\u660e\uff0c\u51fd\u6570 $f$ \u90fd\u7406\u89e3\u4e3a $x\\xrightarrow{f}y$\uff09\u3002\u5bf9\u4e8e\u6bcf\u4e00\u4e2a $x$ \u503c\u6c42\u51fa\u5bf9\u5e94\u7684 $y$ \u503c\u3002",
      "figure_ids": []
    },
    {
      "number": "207",
      "text": "\u7528\u5f0f $h(x)=10x+1$ \u7ed9\u51fa\u51fd\u6570 $h$\uff0c\u5176\u4e2d $x\\in\\{1,2,3,4,5,$ $6,7,8,9\\}$\u3002\u7528\u5217\u6570\u5bf9\u7684\u65b9\u6cd5\u7ed9\u51fa\u51fd\u6570 $h$\u3002",
      "figure_ids": []
    },
    {
      "number": "208",
      "text": "\u7528\u5f0f $y=2x+7$ \u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u3002$x=-200$\u3001$-5.5$\u3001$1000$ \u5206\u522b\u5bf9\u5e94 $y$ \u7684\u4ec0\u4e48\u503c\uff1f$x$ \u53d6\u4ec0\u4e48\u503c\u65f6\u5bf9\u5e94\u7684 $y$ \u503c\u7b49\u4e8e $17$\u3001$1007$\u3001$-21$\uff1f",
      "figure_ids": []
    },
    {
      "number": "209",
      "text": "\u7528\u4e0b\u9762\u7684\u5f0f\u5b50\u7ed9\u51fa\u51fd\u6570\uff1a$f(x)=\\frac{1}{5}(2x-1)$\u3002\u6c42 $f(3)$\u3001$f(10)$\u3001$f(-7)$\u3002\u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c$f(x)=9$\uff0c$f(x)=-7$ \u662f\u771f\u547d\u9898\u3002",
      "figure_ids": []
    },
    {
      "number": "210",
      "text": "\u6307\u51fa\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u51fd\u6570\u7684\u5b9a\u4e49\u57df\uff1a\na) $y=\\frac{5}{x-3}$\uff1b\nb) $y=\\frac{16}{x}$\uff1b\nc) $y=2.4x+3$\uff1b\nd) $y=\\frac{71}{3x+12}$\u3002",
      "figure_ids": []
    },
    {
      "number": "211",
      "text": "\u89e3\u65b9\u7a0b\uff1a\na) $1-1.7x+3(0.9x+2)=3.4$\uff1b\nb) $(5-0.2y)\\times7-0.3y=39$\u3002",
      "figure_ids": []
    },
    {
      "number": "212",
      "text": "\u7528\u6570\u533a\u95f4\u7684\u5f62\u5f0f\u5199\u51fa\uff1a\na) \u7ebf\u6bb5 $AB$ \u4e0a\u70b9\u7684\u6a2a\u5750\u6807\u7684\u96c6\u5408\uff08\u56fe 42\uff09\uff1b\nb) \u7ebf\u6bb5 $AB$ \u4e0a\u70b9\u7684\u7eb5\u5750\u6807\u7684\u96c6\u5408\uff08\u56fe 42\uff09\u3002",
      "figure_ids": [
        "fig-42"
      ]
    },
    {
      "number": "213",
      "text": "a) \u6c42\u5f0f\u7684\u503c\uff1a$|x-2.3|$\uff0c\u5f53 $x=14.3$ \u548c $x=-9.7$\u3002\nb) \u5df2\u77e5 $|y-5|=11$\uff0c\u6c42 $y$ \u7684\u503c\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 3,
      "text": "\u5f53\u51fd\u6570\u7528\u5f0f $y=f(x)$ \u7ed9\u51fa\u65f6\uff0c\u5982\u679c\u5b83\u7684\u5b9a\u4e49\u57df\u548c\u8868\u793a\u5f0f$f(x)$ \u7684\u5b9a\u4e49\u57df\u5b8c\u5168\u76f8\u540c\uff0c\u90a3\u4e48\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u901a\u5e38\u4e0d\u5fc5\u6307\u660e\u3002\n\u4f8b\u5982\uff0c\u51fd\u6570 $x\\xrightarrow{f}y$ \u7528\u516c\u5f0f $y=\\frac{1}{x-2}$ \u7ed9\u51fa\uff08\u800c\u6ca1\u6709\u6307\u660e\u5b83\u7684\u5b9a\u4e49\u57df\uff09\uff0c\u90a3\u4e48\u5c31\u8ba4\u4e3a\u51fd\u6570 $f$ \u7684\u5b9a\u4e49\u57df\u662f\u4e0d\u7b49\u4e8e 2 \u7684\u4efb\u4f55\u6570\u3002"
    }
  ],
