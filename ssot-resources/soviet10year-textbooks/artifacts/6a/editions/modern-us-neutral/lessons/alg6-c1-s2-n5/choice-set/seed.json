    {
      "number": "72",
      "text": "\u8bf4\u51fa\u56fe 13 \u4e2d\u8868\u793a\u7684\u6570\u533a\u95f4\uff1a",
      "figure_ids": [
        "fig-13"
      ]
    },
    {
      "number": "73",
      "text": "\u5728\u6570\u8f74\u4e0a\u8868\u793a\u6570\u533a\u95f4\u5e76\u4e14\u8bfb\u51fa\u6765\uff1a\na) $[3,+\\infty[$\uff1b\nb) $[-2,4]$\uff1b\nc) $]-\\infty,2[$\uff1b\nd) $]-3,3[$\uff1b\ne) $[0,5[$\uff1b\nf) $]-4,0]$\u3002",
      "figure_ids": []
    },
    {
      "number": "74",
      "text": "\u5728\u6570\u8f74\u4e0a\u8868\u793a\u4e0b\u5217\u4e0d\u7b49\u5f0f\u7684\u89e3\u96c6\u5408\uff0c\u5e76\u4e14\u7528\u6570\u533a\u95f4\u7684\u8bb0\u53f7\u5199\u51fa\u6765\uff1a\na) $x\\ge-2$\uff1b\nb) $x\\le3$\uff1b\nc) $x>8$\uff1b\nd) $x<-5$\uff1b\ne) $-1\\le x\\le4$\uff1b\nf) $-2<x<1$\uff1b\ng) $-5\\le x<-3$\uff1b\nh) $2<x\\le6$\u3002",
      "figure_ids": []
    },
    {
      "number": "75",
      "text": "\u4e0b\u5217\u5404\u6570\u5c5e\u4e8e\u6570\u533a\u95f4 $]-4,6.5[$ \u5417\uff1f$-3$\uff0c$-5$\uff0c5\uff0c6.5\uff0c$-3.9$\uff0c$-4.1$\u3002",
      "figure_ids": []
    },
    {
      "number": "76",
      "text": "\u8bf4\u51fa\u5c5e\u4e8e\u4e0b\u5217\u6570\u533a\u95f4\u7684\u4e24\u4e2a\u6b63\u6570\u548c\u4e24\u4e2a\u8d1f\u6570\uff1a\na) $]-4,5[$\uff1b\nb) $[-1,1]$\u3002",
      "figure_ids": []
    },
    {
      "number": "77",
      "text": "\u54ea\u51e0\u4e2a\u6574\u6570\u5c5e\u4e8e\u4e0b\u5217\u6570\u533a\u95f4\uff1f\na) $[0,8]$\uff1b\nb) $]-3,3[$\uff1b\nc) $[-5,3[$\uff1b\nd) $]-4,8]$\u3002",
      "figure_ids": []
    },
    {
      "number": "78",
      "text": "\u8bf4\u51fa\u5c5e\u4e8e\u4e0b\u5217\u6570\u533a\u95f4\u7684\u6700\u5927\u6574\u6570\uff1a\na) $[-12,-9]$\uff1b\nb) $[-1,17[$\uff1b\nc) $]-\\infty,31]$\uff1b\nd) $]-\\infty,-8]$\u3002",
      "figure_ids": []
    },
    {
      "number": "79",
      "text": "\u6570 1.98 \u5c5e\u4e8e\u5f00\u7684\u6570\u5c04\u7ebf $]-\\infty,2[$ \u5417\uff1f\u8bf4\u51fa\u5c5e\u4e8e\u8fd9\u4e2a\u6570\u533a\u95f4\u4f46\u5927\u4e8e 1.98 \u7684\u4e24\u4e2a\u6570\u3002\u80fd\u4e0d\u80fd\u627e\u5230\u5c5e\u4e8e\u8fd9\u4e2a\u533a\u95f4\u7684\u6700\u5927\u7684\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "80",
      "text": "\u5229\u7528\u6570\u8f74\u6c42\u4e24\u4e2a\u96c6\u5408\u7684\u4ea4\u96c6\uff1a\na) $[2,6]$ \u548c $[4,7]$\uff1b\nb) $]-1,9]$ \u548c $[0,10[$\uff1b\nc) $]-\\infty,4]$ \u548c $[1,+\\infty[$\uff1b\nd) $]-\\infty,2]$ \u548c $[5,+\\infty[$\u3002",
      "figure_ids": []
    },
    {
      "number": "81",
      "text": "\u5229\u7528\u6570\u8f74\u6c42\u4e24\u4e2a\u96c6\u5408\u7684\u5e76\u96c6\uff1a\na) $[5,+\\infty[$ \u548c $[-1,+\\infty[$\uff1b\nb) $]-\\infty,7]$ \u548c $[4,+\\infty[$\u3002",
      "figure_ids": []
    },
    {
      "number": "82",
      "text": "\u6570\u8f74\u4e0a\u753b\u51fa\u4e86\u4e0b\u5217\u4e0d\u7b49\u5f0f\u7684\u89e3\u96c6\u5408\uff1a\na) $|x|\\le2.5$\uff08\u56fe 14a\uff09\uff1b\nb) $|x|\\ge3.5$\uff08\u56fe 14b\uff09\u3002\u7528\u6570\u533a\u95f4\u6216\u8005\u6570\u533a\u95f4\u7684\u5e76\u96c6\u7684\u5f62\u5f0f\u8868\u793a\u8fd9\u4e2a\u96c6\u5408\u3002",
      "figure_ids": [
        "fig-14"
      ]
    },
    {
      "number": "83",
      "text": "\u6c42\u4e0d\u7b49\u5f0f\u7684\u89e3\u96c6\u5408\uff08\u628a\u7ed3\u679c\u5199\u6210\u6570\u533a\u95f4\u6216\u6570\u533a\u95f4\u7684\u5e76\u96c6\u7684\u5f62\u5f0f\uff09\uff1a\na) $|x|\\le2$\uff1b\nb) $|x|\\le5$\uff1b\nc) $|x|\\ge3$\uff1b\nd) $|x|\\ge10$\u3002",
      "figure_ids": []
    },
    {
      "number": "84",
      "text": "\u5316\u7b80\u4e0b\u5217\u5404\u5f0f\u5e76\u6c42\u503c\uff1a\na) $1.2(3a-2b)+8.6a$\uff0c\u5f53 $a=-0.5,b=-2$\uff1b\nb) $(7.8m-2.6n)-(2.3m-3.1n)$\uff0c\u5f53 $m=-2,n=4$\u3002",
      "figure_ids": []
    },
    {
      "number": "85",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\na) $\\frac{3.76\\times0.001}{0.01}$\uff1b\nb) $\\frac{0.1\\times6.14}{0.001}$\u3002",
