  "exercises": [
    {
      "number": "442",
      "text": "\u53d8\u91cf\u53d6\u503c\u662f $x=3$ \u548c $y=-1$\uff0c\u8fd9\u5bf9\u503c\u662f\u4e0b\u5217\u65b9\u7a0b\u7ec4\u7684\u89e3\u5417\uff1f\na) $\\begin{cases}2x+y=5,\\\\x^2+y^2=10;\\end{cases}$\nb) $\\begin{cases}x+2y=1,\\\\3x-y=10,\\\\x-y=4.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "443",
      "text": "\u6570\u5bf9 $(3,\\frac{1}{3})$\uff0c$(1,1)$\uff0c$(-1,-1)$\uff0c$(0.5,2)$\uff0c$(-0.5,-2)$ \u4e2d\uff0c\u524d\u4e00\u4e2a\u6570\u662f\u53d8\u91cf $p$ \u7684\u503c\uff0c\u540e\u4e00\u4e2a\u662f $q$ \u7684\u503c\u3002\u8fd9\u4e9b\u6570\u5bf9\u4e2d\u54ea\u4e9b\u662f\u4e0b\u5217\u65b9\u7a0b\u7ec4\u7684\u89e3\uff1f\na) $\\begin{cases}p+q=-2,\\\\3p-2q=-1;\\end{cases}$\nb) $\\begin{cases}pq=1,\\\\2p-q=1.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "444",
      "text": "\u5df2\u77e5\u65b9\u7a0b\u7ec4\u7684\u89e3\uff0c\u4f5c\u65b9\u7a0b\uff1a\na) $x=2$\uff0c$y=-5$\uff1b\nb) $x=0$\uff0c$y=3$\u3002",
      "figure_ids": []
    },
    {
      "number": "445",
      "text": "\u7528\u9009\u62e9\u7684\u529e\u6cd5\u627e\u51fa\u4e0b\u5217\u65b9\u7a0b\u7ec4\u7684\u4e24\u4e2a\u89e3\u3002\na) $\\begin{cases}u+v=7,\\\\uv=12;\\end{cases}$\nb) $\\begin{cases}u+v=10,\\\\uv=21.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "446",
      "text": "\u56fe 101 \u4e0a\u4f5c\u51fa\u4e86\u4e0b\u5217\u65b9\u7a0b\u7684\u56fe\u8c61\uff1a$xy=-6$\uff0c$x+y=1$\uff0c$x-y=7$\u3002\u5229\u7528\u56fe\u8c61\u89e3\u4e0b\u5217\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}x+y=1,\\\\x-y=7;\\end{cases}$\nb) $\\begin{cases}xy=-6,\\\\x+y=1;\\end{cases}$\nc) $\\begin{cases}xy=-6,\\\\x-y=7;\\end{cases}$\nd) $\\begin{cases}xy=-6,\\\\x+y=1,\\\\x-y=7.\\end{cases}$",
      "figure_ids": [
        "fig-101"
      ]
    },
    {
      "number": "447",
      "text": "\u7528\u56fe\u89e3\u6cd5\u89e3\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}xy=6,\\\\x-y=1;\\end{cases}$\nb) $\\begin{cases}xy=8,\\\\y=2x.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "448",
      "text": "\u7528\u56fe\u89e3\u6cd5\u89e3\u7ebf\u6027\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}y=x,\\\\y=5-x;\\end{cases}$\nb) $\\begin{cases}x+3y=8,\\\\3x-y=2;\\end{cases}$\nc) $\\begin{cases}3x+y=-1,\\\\-2x+3y=19;\\end{cases}$\nd) $\\begin{cases}2x-y+1=0,\\\\x+2y=7;\\end{cases}$\ne) $\\begin{cases}4x-1=3y,\\\\6y-5=8x;\\end{cases}$\nf) $\\begin{cases}0x+2y=6,\\\\3x+y=0.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "449",
      "text": "\u5217\u51fa\u8868\u8fbe\u5f0f\u5e76\u6c42\u503c\uff1a\na) $12\\frac{1}{3}$ \u4e0e $\\frac{1}{12}$ \u548c $8$ \u7684\u79ef\u7684\u5dee\uff1b\nb) $37.8$ \u548c $35$ \u4e24\u6570\u7684\u548c\u4e0e\u4e24\u6570\u7684\u5dee\u7684\u79ef\u3002",
      "figure_ids": []
    },
    {
      "number": "450",
      "text": "\u4e0d\u4f5c\u56fe\uff0c\u6c42\u7ebf\u6027\u65b9\u7a0b $0.3x-0.4y=12$ \u7684\u56fe\u8c61\u548c\na) \u6a2a\u8f74\u3001\nb) \u7eb5\u8f74\u7684\u4ea4\u70b9\u5750\u6807\u3002",
      "figure_ids": []
    },
    {
      "number": "451",
      "text": "\u4e00\u4e2a\u4e24\u4f4d\u6570\u7b49\u4e8e\u5b83\u7684\u4e24\u4e2a\u6570\u5b57\u7684\u548c\u7684\u4e94\u500d\uff0c\u6c42\u8fd9\u4e2a\u6570\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u4e24\u4e2a\u53d8\u91cf\u7684\u503c\u7ec4\u6210\u7684\u6570\u5bf9\uff0c\u5982\u679c\u80fd\u628a\u4e8c\u5143\u65b9\u7a0b\u7ec4\u7684\u6bcf\u4e00\u4e2a\u65b9\u7a0b\u53d8\u6210\u771f\u7b49\u5f0f\uff0c\u8fd9\u4e2a\u6570\u5bf9\u5c31\u53eb\u505a\u4e8c\u5143\u65b9\u7a0b\u7ec4\u7684\u89e3\u3002"
    },
    {
