  "exercises": [
    {
      "number": "1025",
      "text": "\u4e24\u4e2a\u65c5\u884c\u8005\u8981\u5728\u4e00\u4e2a\u534a\u5c0f\u65f6\u5185\u8d70\u5b8c $12$ \u516c\u91cc\u957f\u7684\u8def\u7a0b\u3002\u4ed6\u4eec\u53ea\u6709\u4e00\u8f86\u81ea\u884c\u8f66\u3002\u5df2\u77e5\uff0c\u9a91\u81ea\u884c\u8f66\u7684\u901f\u5ea6\u53ef\u4ee5\u8fbe\u5230$20$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u6b65\u884c\u53ef\u4ee5\u8fbe\u5230 $6$ \u516c\u91cc/\u5c0f\u65f6\u3002\u65c5\u884c\u8005\u80fd\u4e0d\u80fd\u6309\u65f6\u8d70\u5b8c\u8fd9\u6bb5\u8def\u7a0b\uff1f\uff08\u4e24\u4e2a\u4eba\u4e0d\u80fd\u540c\u65f6\u9a91\u81ea\u884c\u8f66\uff09\u3002",
      "figure_ids": []
    },
    {
      "number": "1026",
      "text": "\u4e24\u4e2a\u4eba\u505a\u4e00\u79cd\u6e38\u620f\uff1a\u7b2c\u4e00\u4e2a\u4eba\u5148\u8bf4\u51fa\u4e00\u4e2a\u4e00\u4f4d\u6570\uff0c\u7b2c\u4e8c\u4e2a\u4eba\u968f\u4fbf\u52a0\u4e0a\u4e00\u4e2a\u4e00\u4f4d\u6570\uff1b\u7b2c\u4e00\u4e2a\u4eba\u5bf9\u5f97\u5230\u7684\u548c\u518d\u52a0\u4e0a\u4e00\u4e2a\u4e00\u4f4d\u6570\uff0c\u7b49\u7b49\u3002\u8c01\u9996\u5148\u5f97\u5230 $75$\uff0c\u5c31\u7b97\u662f\u83b7\u80dc\u3002\u5e94\u8be5\u600e\u6837\u73a9\uff0c\u624d\u80fd\u83b7\u80dc\uff1f\u5728\u73a9\u6cd5\u4e0d\u51fa\u9519\u7684\u60c5\u51b5\u4e0b\uff0c\u8c01\u80fd\u83b7\u80dc\uff1a\u7b2c\u4e00\u4e2a\u4eba\u8fd8\u662f\u7b2c\u4e8c\u4e2a\u4eba\uff1f",
      "figure_ids": []
    },
    {
      "number": "1027",
      "text": "\u6e38\u6cf3\u6bd4\u8d5b\u524d\uff0c\u56db\u4e2a\u8fd0\u52a8\u5458\u7532\u3001\u4e59\u3001\u4e19\u548c\u4e01\u53d1\u8868\u8c08\u8bdd\u3002\u7532\u8bf4\uff1a\u201c\u6211\u5c06\u5f97\u7b2c\u4e00\u540d\u201d\u3002\u4e59\u8bf4\uff1a\u201c\u6211\u4e0d\u4f1a\u662f\u6700\u540e\u4e00\u540d\u201d\u3002\u4e19\u8bf4\uff1a\u201c\u6211\u4e0d\u80fd\u5f97\u7b2c\u4e00\uff0c\u4e5f\u4e0d\u4f1a\u662f\u6700\u540e\u201d\u3002\u4e01\u8bf4\uff1a\u201c\u6211\u5c06\u662f\u6700\u540e\u4e00\u540d\u201d\u3002\u6bd4\u8d5b\u7ed3\u679c\u8868\u660e\uff0c\u53ea\u6709\u4e00\u4e2a\u4eba\u8bf4\u9519\u4e86\u3002\u54ea\u4e2a\u8fd0\u52a8\u5458\u8bf4\u9519\u4e86\uff1f",
      "figure_ids": []
    },
    {
      "number": "1028",
      "text": "\u5728\u4e09\u4e2a\u76d2\u5b50\u91cc\u88c5\u8fdb\u4e86\u5c0f\u7403\uff1a\u7b2c\u4e00\u4e2a\u76d2\u5b50\u88c5\u7684\u662f\u4e24\u4e2a\u767d\u7403\uff0c\u7b2c\u4e8c\u4e2a\u76d2\u5b50\u88c5\u7684\u662f\u4e24\u4e2a\u9ed1\u7403\uff0c\u7b2c\u4e09\u4e2a\u76d2\u5b50\u88c5\u7684\u662f\u4e00\u4e2a\u767d\u7403\u548c\u4e00\u4e2a\u9ed1\u7403\u3002\u5728\u6bcf\u4e2a\u76d2\u5b50\u4e0a\u6309\u7167\u6240\u88c5\u7684\u7403\u5206\u522b\u4f5c\u51fa\u8bb0\u53f7\uff1a\u9ed1\u9ed1\uff0c\u767d\u767d\uff0c\u9ed1\u767d\u3002\u7136\u540e\uff0c\u628a\u7403\u91cd\u65b0\u88c5\u8fdb\u76d2\u5b50\uff0c\u6bcf\u4e2a\u76d2\u5b50\u88c5\u4e24\u4e2a\u7403\uff0c\u5e76\u4e14\u4f7f\u6bcf\u4e2a\u8bb0\u53f7\u90fd\u4e0e\u76d2\u5b50\u91cc\u88c5\u7684\u4e1c\u897f\u4e0d\u4e00\u81f4\u3002\u5982\u679c\u4e0d\u8bb8\u5411\u76d2\u5b50\u91cc\u9762\u770b\uff0c\u90a3\u4e48\uff0c\u81f3\u5c11\u8981\u4ece\u76d2\u5b50\u91cc\u53d6\u51fa\u51e0\u4e2a\u7403\uff0c\u624d\u80fd\u5224\u65ad\u6bcf\u4e2a\u76d2\u5b50\u88c5\u7684\u662f\u4ec0\u4e48\u7403\uff1f",
      "figure_ids": []
    },
    {
      "number": "1029",
      "text": "\u62bd\u5c49\u91cc\u88c5\u4e86\u5404\u79cd\u989c\u8272\u7684\u5c0f\u7403\uff1a$5$ \u4e2a\u767d\u7684\uff0c$12$ \u4e2a\u7ea2\u7684\u548c$20$ \u4e2a\u9ed1\u7684\u3002\u5982\u679c\u4e0d\u8bb8\u5411\u62bd\u5c49\u91cc\u770b\uff0c\u90a3\u4e48\uff0c\u81f3\u5c11\u8981\u53d6\u51fa\u591a\u5c11\u4e2a\u5c0f\u7403\uff0c\u624d\u80fd\u4fdd\u8bc1\u5176\u4e2d\uff1a\na) \u5404\u79cd\u989c\u8272\u7684\u5c0f\u7403\u8d77\u7801\u6709\u4e00\u4e2a\uff1b\nb) \u4e00\u79cd\u989c\u8272\u7684\u5c0f\u7403\u6709 $10$ \u4e2a\u4ee5\u4e0a\uff1f",
      "figure_ids": []
    },
    {
      "number": "1030",
      "text": "\u8bc1\u660e\uff1a\u7528 $3$ \u7f8e\u5206\u548c $5$ \u7f8e\u5206\u7684\u786c\u5e01\uff0c\u53ef\u4ee5\u7ec4\u6210\u4efb\u4f55\u5927\u4e8e $7$\u7f8e\u5206\u7684\u94b1\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "1031",
      "text": "\u516d\u5e74\u7ea7\u7684 $9$ \u540d\u5b66\u751f\u53c2\u52a0\u5b66\u6821\u7684\u6570\u5b66\u7ade\u8d5b\u3002\u6bcf\u89e3\u51fa\u4e00\u4e2a\u95ee\u9898\u5f97 $2$ \u5206\uff0c\u6bcf\u6709\u4e00\u4e2a\u672a\u89e3\u51fa\u7684\u95ee\u9898\u6263 $1$ \u5206\u3002\u603b\u5171\u51fa\u4e86\u5341\u4e2a\u95ee\u9898\u3002\u8bc1\u660e\uff1a\u81f3\u5c11\u6709\u4e24\u540d\u5b66\u751f\u5f97\u4e86\u540c\u6837\u7684\u5206\u6570\uff08\u6263\u7684\u5206\u6570\u5927\u4e8e\u5f97\u7684\u5206\u6570\u65f6\uff0c\u7b97\u662f\u5f97\u96f6\u5206\uff09\u3002",
      "figure_ids": []
    },
    {
      "number": "1032",
      "text": "\u7528\u591a\u5c11\u79cd\u65b9\u6cd5\u53ef\u4ee5\u628a\u96c6\u5408 $\\{1,2,3\\}$ \u6620\u5c04\u5230\u4e0b\u5217\u96c6\u5408\u4e0a\uff1a\na) $\\{a,b\\}$\uff1b\nb) $\\{a,b,c\\}$\u3002",
      "figure_ids": []
    },
    {
      "number": "1033",
      "text": "\u73b0\u6709 $10$ \u5806\u786c\u5e01\uff0c\u6bcf\u5806\u6709 $10$ \u4e2a\u3002\u5176\u4e2d\u6709\u4e00\u5806\u5168\u90e8\u662f\u5047\u5e01\uff0c\u4f46\u662f\u7a76\u7adf\u662f\u54ea\u4e00\u5806\u5e76\u4e0d\u77e5\u9053\u3002\u5df2\u77e5\u6bcf\u679a\u771f\u5e01\u7684\u91cd\u91cf\uff0c\u800c\u4e14\u6bcf\u679a\u5047\u5e01\u7684\u91cd\u91cf\u6bd4\u771f\u5e01\u7684\u91cd\u91cf\u5927 $1$ \u514b\u3002\u73b0\u6709\u5929\u5e73\u548c\u4e00\u5957\u5c0f\u781d\u7801\uff0c\u53ea\u8bb8\u7528\u5929\u5e73\u79f0\u4e00\u6b21\u91cd\u91cf\uff0c\u8981\u6c42\u786e\u5b9a\u54ea\u4e00\u5806\u662f\u5047\u5e01\u3002",
      "figure_ids": []
    },
    {
      "number": "1034",
      "text": "\u6211\u60f3\u4e00\u4e2a\u4e0d\u5927\u4e8e $1000$ \u7684\u6570\u3002\u600e\u6837\u63d0\u51fa\u4e0d\u591a\u4e8e $10$ \u4e2a\u95ee\u9898\uff0c\u5728\u6211\u53ea\u56de\u7b54\u201c\u662f\u201d\u6216\u8005\u201c\u4e0d\u662f\u201d\u7684\u6761\u4ef6\u4e0b\uff0c\u53ef\u4ee5\u6307\u51fa\u6211\u60f3\u7684\u662f\u4ec0\u4e48\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "1035",
      "text": "\u518d\u8fc7 $5$ \u5e74\uff0c\u5f1f\u5f1f\u4e0e\u59b9\u59b9\u7684\u5e74\u9f84\u4e4b\u6bd4\u662f $5:3$\u3002\u4e00\u5e74\u4ee5\u524d\uff0c\u5f1f\u5f1f\u5e74\u9f84\u662f\u59b9\u59b9\u5e74\u9f84\u7684\u4e24\u500d\u3002\u8bf4\u660e\uff0c\u5f1f\u5f1f\u4e0e\u59b9\u59b9\u4eca\u5e74\u662f\u591a\u5c11\u5c81\uff1f",
      "figure_ids": []
    },
    {
      "number": "1036",
      "text": "\u8bc1\u660e\uff1a\u5f0f\u5b50 $11^6+14^6-13^3$ \u7684\u503c\u662f $10$ \u7684\u500d\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "1037",
      "text": "\u5728 $750$ \u9875\u7684\u624b\u7a3f\u4e2d\uff0c\u5982\u679c\u628a\u6240\u6709\u7684\u9875\u6570\u90fd\u7f16\u4e0a\u9875\u7801\uff0c\u4e00\u5171\u8981\u5199\u591a\u5c11\u4e2a\u6570\u5b57\uff08\u6bcf\u4e00\u4e2a\u6570\u5b57\u5199\u4e00\u56de\uff0c\u5c31\u7b97\u4e00\u4e2a\uff09\uff1f",
      "figure_ids": []
    },
    {
      "number": "1038",
      "text": "\u4e00\u4e2a\u56db\u4f4d\u6570\uff0c\u5de6\u8fb9\u7684\u7b2c\u4e00\u4e2a\u6570\u5b57\u662f $7$\u3002\u5982\u679c\u628a\u8fd9\u4e2a\u6570\u5b57\u8c03\u5230\u6700\u540e\u4e00\u4f4d\uff0c\u90a3\u8fd9\u4e2a\u6570\u8981\u51cf\u5c11 $864$\u3002\u6c42\u8fd9\u4e2a\u56db\u4f4d\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "1039",
      "text": "\u4e00\u4e2a\u516d\u4f4d\u6570\uff0c\u5de6\u8fb9\u7684\u7b2c\u4e00\u4e2a\u6570\u5b57\u662f $1$\u3002\u5982\u679c\u628a\u8fd9\u4e2a\u6570\u5b57\u8c03\u5230\u6700\u540e\u4e00\u4f4d\uff0c\u90a3\u4e48\u8fd9\u4e2a\u6570\u589e\u5927\u4e3a\u539f\u6570\u7684 $3$ \u500d\u3002\u6c42\u8fd9\u4e2a\u516d\u4f4d\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "1040",
      "text": "\u5982\u679c\u5fc3\u91cc\u60f3\u7684\u4e24\u4f4d\u6570\u9664\u4ee5\u4ed6\u7684\u6570\u5b57\u548c\uff0c\u5546\u662f $4$\uff0c\u4f59\u6570\u662f$3$\u3002\u5982\u679c\u8fd9\u4e2a\u6570\u51cf\u53bb\u4ed6\u7684\u6570\u5b57\u548c\u7684\u4e24\u500d\uff0c\u5f97 $25$\u3002\u5fc3\u91cc\u60f3\u7684\u662f\u4ec0\u4e48\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "1041",
      "text": "\u5982\u679c\u5728\u4e00\u4e2a\u4e24\u4f4d\u6570\u7684\u6570\u5b57\u4e2d\u95f4\uff0c\u518d\u5199\u4e0a\u8fd9\u4e2a\u4e24\u4f4d\u6570\uff0c\u90a3\u4e48\uff0c\u5f97\u5230\u7684\u56db\u4f4d\u6570\u662f\u539f\u6765\u4e24\u4f4d\u6570\u7684 $77$ \u500d\u3002\u6c42\u8fd9\u4e2a\u4e24\u4f4d\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "1042",
      "text": "\u591a\u9879\u5f0f $2x^3-5x^2+7x-8$ \u548c\u591a\u9879\u5f0f $ax^2+bx+11$ \u76f8\u4e58\u7684\u79ef\uff0c\u4e0d\u542b\u6709 $x^4$\uff0c\u4e5f\u4e0d\u542b\u6709 $x^3$\u3002\u6c42\u7cfb\u6570 $a$ \u548c $b$\uff0c\u5e76\u4e14\u8bf4\u660e\u79ef\u662f\u4ec0\u4e48\u591a\u9879\u5f0f\u3002",
      "figure_ids": []
    },
    {
      "number": "1043",
      "text": "\u5728\u5bb9\u91cf\u4e3a $144$ \u5347\u548c $100$ \u5347\u7684\u4e24\u4e2a\u5bb9\u5668\u4e2d\uff0c\u88c5\u4e86\u4e00\u5b9a\u6570\u91cf\u7684\u6c34\u3002\u5982\u679c\u628a\u6c34\u4ece\u5c0f\u5bb9\u5668\u5012\u5165\u5927\u5bb9\u5668\uff0c\u628a\u5927\u5bb9\u5668\u5012\u6ee1\uff0c\u90a3\u4e48\u5c0f\u5bb9\u5668\u91cc\u5269\u4e0b\u7684\u6c34\u662f\u539f\u6765\u6570\u91cf\u7684 $\\frac{1}{5}$\u3002\u5982\u679c\u628a\u6c34\u4ece\u5927\u5bb9\u5668\u5012\u5165\u5c0f\u5bb9\u5668\uff0c\u628a\u5c0f\u5bb9\u5668\u5012\u6ee1\uff0c\u90a3\u4e48\u5927\u5bb9\u5668\u91cc\u5269\u4e0b\u7684\u6c34\u662f\u539f\u6765\u6570\u91cf\u7684 $\\frac{7}{12}$\u3002\u6bcf\u4e2a\u5bb9\u5668\u88c5\u4e86\u591a\u5c11\u5347\u6c34\uff1f",
      "figure_ids": []
    },
    {
      "number": "1044",
      "text": "\u4e00\u4e2a\u5bb9\u5668\u88c5\u4e86 $49$ \u5347\u6c34\uff0c\u53e6\u4e00\u4e2a\u5bb9\u5668\u88c5\u4e86 $56$ \u5347\u6c34\u3002\u5982\u679c\u628a\u6c34\u4ece\u7b2c\u4e8c\u4e2a\u5bb9\u5668\u5012\u5165\u7b2c\u4e00\u4e2a\u5bb9\u5668\uff0c\u628a\u7b2c\u4e00\u4e2a\u5bb9\u5668\u5012\u6ee1\uff0c\u90a3\u4e48\u7b2c\u4e8c\u4e2a\u5bb9\u5668\u5269\u4e0b\u7684\u6c34\u76f8\u5f53\u4e8e\u8fd9\u4e2a\u5bb9\u5668\u5bb9\u91cf\u7684$\\frac{1}{2}$\u3002\u5982\u679c\u628a\u6c34\u4ece\u7b2c\u4e00\u4e2a\u5bb9\u5668\u5012\u5165\u7b2c\u4e8c\u4e2a\u5bb9\u5668\uff0c\u628a\u7b2c\u4e8c\u4e2a\u5bb9\u5668\u5012\u6ee1\uff0c\u90a3\u4e48\u7b2c\u4e00\u4e2a\u5bb9\u5668\u5269\u4e0b\u7684\u6c34\u76f8\u5f53\u4e8e\u8fd9\u4e2a\u5bb9\u5668\u5bb9\u91cf\u7684 $\\frac{1}{3}$\u3002\u6c42\u6bcf\u4e2a\u5bb9\u5668\u7684\u5bb9\u91cf\u3002",
      "figure_ids": []
    },
    {
      "number": "1045",
      "text": "\u516c\u5171\u6c7d\u8f66\u548c\u76f4\u8fbe\u8f66\u5728 $8$ \u70b9 $45$ \u5206\u51c6\u65f6\u4ece $M$ \u4e0e $N$ \u8fce\u9762\u5f00\u51fa\u3002\u8fd9\u4e24\u8f86\u8f66\u5e73\u5e38\u90fd\u5728 $8$ \u70b9 $52$ \u5206\u76f8\u9047\u3002\u6709\u4e00\u6b21\uff0c\u76f4\u8fbe\u8f66\u665a\u5f00 $8$ \u5206\u949f\uff0c\u5e76\u4e14\u5728 $8$ \u70b9 $57$ \u5206\u4e0e\u516c\u5171\u6c7d\u8f66\u76f8\u9047\u3002\u5df2\u77e5 $MN$ \u7b49\u4e8e $24$ \u516c\u91cc\uff0c\u6c42\u516c\u5171\u6c7d\u8f66\u548c\u76f4\u8fbe\u8f66\u7684\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "1046",
      "text": "\u4e24\u8f86\u516c\u5171\u6c7d\u8f66\u5206\u522b\u5728 $7$ \u70b9 $18$ \u5206\u548c $7$ \u70b9 $48$ \u5206\u7528\u76f8\u540c\u7684\u901f\u5ea6\u4ece $A$ \u5f00\u5f80 $B$\u3002$A$ \u548c $B$ \u4e4b\u95f4\u7684\u8ddd\u79bb\u662f $37$ \u516c\u91cc\u3002\u4e00\u4eba\u9a91\u81ea\u884c\u8f66\u5728 $7$ \u70b9 $28$ \u5206\u4ece $B$ \u51fa\u53d1\u5230 $A$\u3002\u4ed6\u5728 $7$ \u70b9 $58$ \u5206\u9047\u5230\u7b2c\u4e00\u8f86\u516c\u5171\u6c7d\u8f66\uff0c\u5728 $8$ \u70b9 $19$ \u5206\u9047\u5230\u7b2c\u4e8c\u8f86\u516c\u5171\u6c7d\u8f66\u3002\u6c42\u9a91\u81ea\u884c\u8f66\u7684\u901f\u5ea6\u548c\u516c\u5171\u6c7d\u8f66\u7684\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "1047",
      "text": "\u4ece\u76f8\u8ddd $70$ \u516c\u91cc\u7684\u4e24\u5730 $M$ \u4e0e $N$\uff0c\u4e00\u8f86\u516c\u5171\u6c7d\u8f66\u4e0e\u4e00\u4eba\u9a91\u81ea\u884c\u8f66\u540c\u65f6\u8fce\u9762\u51fa\u53d1\uff0c\u7ecf\u8fc7 $1$ \u5c0f\u65f6 $24$ \u5206\u540e\u76f8\u9047\u3002\u516c\u5171\u6c7d\u8f66\u5230\u8fbe $N$ \u4ee5\u540e\uff0c\u505c\u7559 $20$ \u5206\u949f\uff0c\u5e76\u4e14\u7528\u540c\u6837\u901f\u5ea6\u8fd4\u56de\u3002\u5df2\u77e5\uff0c\u7b2c\u4e00\u6b21\u76f8\u9047\u540e\u7ecf\u8fc7 $2$ \u5c0f\u65f6 $41$ \u5206\uff0c\u516c\u5171\u6c7d\u8f66\u53c8\u8ffd\u4e0a\u4e86\u9a91\u81ea\u884c\u8f66\u7684\u4eba\u3002\u6c42\u516c\u5171\u6c7d\u8f66\u7684\u901f\u5ea6\u548c\u9a91\u81ea\u884c\u8f66\u7684\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "1048",
      "text": "\u4e00\u4eba\u6b65\u884c\u4ece $A$ \u524d\u5f80 $B$\u3002\u8fc7\u4e86 $1$ \u5c0f\u65f6 $20$ \u5206\uff0c\u53e6\u4e00\u4eba\u9a91\u81ea\u884c\u8f66\u4e5f\u4ece $A$ \u51fa\u53d1\u524d\u5f80 $B$\uff0c$30$ \u5206\u949f\u540e\u8ffd\u4e0a\u4e86\u6b65\u884c\u7684\u4eba\u3002\u9a91\u81ea\u884c\u8f66\u7684\u4eba\u5230\u8fbe $B$ \u540e\u7acb\u5373\u8fd4\u56de\uff0c\u5728\u7b2c\u4e00\u6b21\u8ffd\u4e0a\u6b65\u884c\u7684\u4eba\u4ee5\u540e\u7ecf\u8fc7\u4e00\u4e2a\u534a\u5c0f\u65f6\uff0c\u53c8\u9047\u5230\u4e86\u6b65\u884c\u7684\u4eba\u3002\u5df2\u77e5 $AB$ \u7684\u8ddd\u79bb\u7b49\u4e8e $24$ \u516c\u91cc\u3002\u6c42\u81ea\u884c\u8f66\u7684\u901f\u5ea6\u548c\u6b65\u884c\u7684\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "1049",
      "text": "\u6211\u5fc3\u91cc\u60f3\u4e86\u4e24\u4e2a\u4e24\u4f4d\u6570\u3002\u8fd9\u4e24\u4e2a\u4e24\u4f4d\u6570\u90fd\u662f\u4ee5 $6$ \u5f00\u5934\uff0c\u800c\u53e6\u4e00\u4e2a\u6570\u5b57\u4e0d\u7b49\u4e8e $6$\u3002\u5982\u679c\u628a\u6211\u60f3\u7684\u4e24\u4e2a\u6570\u7684\u5404\u4e2a\u6570\u5b57\u4ea4\u6362\u4f4d\u7f6e\uff0c\u7ed3\u679c\u4e24\u4e2a\u4e24\u4f4d\u6570\u7684\u79ef\u7684\u503c\u4e0d\u53d8\u3002\u6211\u60f3\u7684\u662f\u4ec0\u4e48\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "1050",
      "text": "\u4e00\u4e2a\u5b66\u751f\u544a\u8bc9\u4ed6\u7684\u540c\u5b66\u8bf4\uff0c\u4ed6\u60f3\u4e86\u4e00\u4e2a\u4e24\u4f4d\u6570\uff0c\u4ece\u8fd9\u4e2a\u4e24\u4f4d\u6570\u51cf\u53bb\u4e0e\u5b83\u6570\u5b57\u76f8\u540c\u800c\u987a\u5e8f\u76f8\u53cd\u7684\u6570\uff0c\u7ed3\u679c\u5f97\u5230\u4e00\u4e2a\u5076\u6570\u7684\u5e73\u65b9\u3002\u4ed6\u7684\u540c\u5b66\u7acb\u5373\u8bf4\uff1a\u6240\u5f97\u7684\u5dee\u7b49\u4e8e $36$\u3002\u4ed6\u8bf4\u7684\u5bf9\u5417\uff1f\u6c42\u51fa\u4e00\u5207\u5177\u6709\u8fd9\u79cd\u6027\u8d28\u7684\u4e24\u4f4d\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "1051",
      "text": "\u4e24\u4e2a\u6570\u5b57\u76f8\u540c\u987a\u5e8f\u76f8\u53cd\u7684\u4e09\u4f4d\u6570\u7684\u5dee\uff0c\u80fd\u4e0d\u80fd\u662f\u4e00\u4e2a\u81ea\u7136\u6570\u7684\u5e73\u65b9\uff1f",
      "figure_ids": []
    },
    {
      "number": "1052",
      "text": "a) \u4e94\u4e2a\u8fde\u7eed\u81ea\u7136\u6570\u7684\u548c\u80fd\u4e0d\u80fd\u662f\u8d28\u6570\uff1f\nb) \u4e94\u4e2a\u8fde\u7eed\u81ea\u7136\u6570\u7684\u5e73\u65b9\u548c\u80fd\u4e0d\u80fd\u662f\u8d28\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "1053",
      "text": "\u8bc1\u660e\uff1a\u5bf9\u4e8e\u4efb\u610f\u7684 $n\\in N$\uff0c\u5f0f\u5b50 $3^{n+2}-2^{n+2}+3^n-2^n$ \u7684\u503c\u80fd\u88ab $10$ \u6574\u9664\u3002",
      "figure_ids": []
    },
    {
      "number": "1054",
      "text": "\u8bc1\u660e\uff1a$p^2-1$ \u80fd\u88ab $24$ \u6574\u9664\uff0c\u5176\u4e2d $p$ \u662f\u5927\u4e8e $3$ \u7684\u8d28\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "1055",
      "text": "\u8bc1\u660e\uff1a\u5bf9\u4e8e\u5927\u4e8e $1$ \u7684\u4efb\u610f\u81ea\u7136\u6570 $n$\uff0c\u4e0b\u5217\u5404\u5f0f\u7684\u503c\u4e0d\u53ef\u80fd\u662f\u8d28\u6570\uff1a\na) $n^4+4$\uff1b\nb) $n^4+n^2+1$\u3002",
