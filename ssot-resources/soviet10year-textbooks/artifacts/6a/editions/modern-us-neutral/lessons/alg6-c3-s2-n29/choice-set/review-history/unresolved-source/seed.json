    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "476",
      "text": "\u4e24\u6570\u7684\u548c\u662f $13$\uff0c\u5dee\u662f $2$\u3002\u6c42\u8fd9\u4e24\u4e2a\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "477",
      "text": "\u77e9\u5f62\u7684\u5468\u957f\u662f $30$ \u7c73\uff0c\u957f\u6bd4\u5bbd\u591a\u4e00\u7c73\uff0c\u6c42\u77e9\u5f62\u7684\u8fb9\u957f\u3002",
      "figure_ids": []
    },
    {
      "number": "478",
      "text": "\u519c\u573a\u79cd\u4e86 $700$ \u516c\u9877\u835e\u9ea6\u548c\u71d5\u9ea6\uff0c\u71d5\u9ea6\u7684\u5730\u6bd4\u79cd\u835e\u9ea6\u7684\u5730\u8981\u591a $60$ \u516c\u9877\u3002\u71d5\u9ea6\u548c\u835e\u9ea6\u5404\u79cd\u4e86\u591a\u5c11\u516c\u9877\uff1f",
      "figure_ids": []
    },
    {
      "number": "479",
      "text": "\u67d0\u5730\u533a\u64ad\u79cd\u65f6\u6d3e\u53bb\u4e86 $187$ \u53f0 Model A \u548c Model B-80 \u578b\u62d6\u62c9\u673a\uff0c\u5176\u4e2d Model A \u578b\u62d6\u62c9\u673a\u6bd4 Model B-80 \u578b\u8981\u591a $23$\u53f0\u3002\u6bcf\u79cd\u578b\u53f7\u7684\u62d6\u62c9\u673a\u5404\u6709\u51e0\u53f0\uff1f",
      "figure_ids": []
    },
    {
      "number": "480",
      "text": "\u8db3\u7403\u9526\u6807\u8d5b\u65f6\uff0cFalcons\u8db3\u7403\u961f\u6bd4\u8d5b $11$ \u573a\uff0c\u6ca1\u6709\u8f93\u8fc7\u4e00\u573a\uff0c\u5f97\u4e86 $17$ \u5206\u3002Falcons\u8db3\u7403\u961f\u80dc\u4e86\u51e0\u573a\uff0c\u5e73\u4e86\u51e0\u573a\uff1f\uff08\u80dc\u4e00\u573a\u5f97 $2$ \u5206\uff0c\u5e73\u4e00\u573a\u5f97 $1$ \u5206\uff09\u3002",
      "figure_ids": []
    },
    {
      "number": "481",
      "text": "\u7528 $47$ \u7f8e\u5143\u4e70\u4e86\u4e09\u4ed8\u6ed1\u96ea\u677f\uff0c\u56db\u53cc\u51b0\u978b\u3002\u5982\u679c\u4e24\u53cc\u51b0\u978b\u8981\u6bd4\u4e00\u4ed8\u6ed1\u96ea\u677f\u591a\u4ed8 $1$ \u7f8e\u5143\uff0c\u90a3\u4e48\u4e00\u4ed8\u6ed1\u96ea\u677f\u548c\u4e00\u53cc\u51b0\u978b\u5404\u503c\u591a\u5c11\u7f8e\u5143\uff1f",
      "figure_ids": []
    },
    {
      "number": "482",
      "text": "\u4e94\u652f\u5706\u73e0\u7b14\u8981\u6bd4\u4e24\u76d2\u989c\u8272\u94c5\u7b14\u591a\u4ed8 $2$ \u7f8e\u5143 $55$ \u7f8e\u5206\uff0c\u800c\u4e24\u652f\u5706\u73e0\u7b14\u8981\u6bd4\u4e94\u76d2\u989c\u8272\u94c5\u7b14\u5c11\u4ed8 $1$ \u7f8e\u5143 $50$ \u7f8e\u5206\u3002\u4e00\u652f\u5706\u73e0\u7b14\u548c\u4e00\u76d2\u989c\u8272\u94c5\u7b14\u5404\u503c\u591a\u5c11\u7f8e\u5143\uff1f",
      "figure_ids": []
    },
    {
      "number": "483",
      "text": "\u7528\u4e24\u6839\u7ba1\u5b50\u5411\u8d2e\u6c34\u69fd\u704c\u6c34\u3002\u5982\u679c\u7b2c\u4e00\u6839\u7ba1\u5b50\u704c\u6c34 $20$ \u5206\u949f\uff0c\u7b2c\u4e8c\u6839\u7ba1\u5b50\u704c\u6c34 $10$ \u5206\u949f\uff0c\u90a3\u4e48\u8d2e\u6c34\u69fd\u5185\u6709\u6c34 $120$ \u767e\u5347\u3002\u5982\u679c\u7b2c\u4e00\u6839\u7ba1\u5b50\u5f00 $15$ \u5206\u949f\uff0c\u7b2c\u4e8c\u6839\u5f00 $7$ \u5206\u949f\uff0c\u90a3\u4e48\u8d2e\u6c34\u69fd\u5185\u6709\u6c34 $88.5$ \u767e\u5347\u3002\u6bcf\u6839\u7ba1\u5b50\u6bcf\u5206\u949f\u5411\u8d2e\u6c34\u69fd\u704c\u591a\u5c11\u767e\u5347\u6c34\uff1f",
      "figure_ids": []
    },
    {
      "number": "484",
      "text": "\u6211\u60f3\u4e86\u4e24\u4e2a\u6570\u3002\u5982\u679c\u7b2c\u4e00\u4e2a\u6570\u52a0\u4e0a\u7b2c\u4e8c\u4e2a\u6570\u7684\u4e00\u534a\uff0c\u5f97$65$\uff1b\u5982\u679c\u4ece\u7b2c\u4e8c\u4e2a\u6570\u51cf\u53bb\u7b2c\u4e00\u4e2a\u6570\u7684\u4e09\u5206\u4e4b\u4e00\uff0c\u5f97\u5230\u7b2c\u4e00\u4e2a\u6570\u3002\u6211\u60f3\u7684\u662f\u4ec0\u4e48\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "485",
      "text": "\u4e24\u4e2a\u5c0f\u5b69\u4e00\u5171\u6709 $16$ \u4e2a\u6838\u6843\u3002\u5982\u679c\u4e00\u4e2a\u5c0f\u5b69\u7ed9\u53e6\u4e00\u4e2a\u5c0f\u5b69 $6$ \u4e2a\u6838\u6843\uff0c\u4ed6\u5269\u4e0b\u7684\u6838\u6843\u7b49\u4e8e\u53e6\u4e00\u4e2a\u5c0f\u5b69\u7684\u6838\u6843\u6570\u7684\u4e09\u5206\u4e4b\u4e00\u3002\u6bcf\u4e2a\u5c0f\u5b69\u539f\u6765\u5404\u6709\u51e0\u4e2a\u6838\u6843\uff1f",
      "figure_ids": []
    },
    {
      "number": "486",
      "text": "\u4e24\u79cd\u679c\u812f\uff0c\u4e00\u79cd\u6bcf\u516c\u65a4\u7684\u4ef7\u683c\u662f $1$ \u7f8e\u5143 $20$ \u7f8e\u5206\uff0c\u53e6\u4e00\u79cd\u662f $1$ \u7f8e\u5143 $50$ \u7f8e\u5206\u3002\u73b0\u5728\u8981\u7528\u8fd9\u4e24\u79cd\u6df7\u5408\u6210\u6bcf\u516c\u65a4\u662f $1$\u7f8e\u5143 $30$ \u7f8e\u5206\u7684\u679c\u812f $36$ \u516c\u65a4\uff0c\u6bcf\u79cd\u679c\u812f\u5e94\u53d6\u591a\u5c11\u516c\u65a4\uff1f",
      "figure_ids": []
    },
    {
      "number": "487",
      "text": "\u4e24\u79cd\u9762\u7c89\uff0c\u4e00\u79cd\u6bcf\u516c\u65a4\u7684\u4ef7\u683c\u662f $31$ \u7f8e\u5206\uff0c\u53e6\u4e00\u79cd\u662f $46$\u7f8e\u5206\u3002\u6df7\u5408\u540e\u5f97\u5230 $50$ \u516c\u65a4\u4ef7\u683c\u662f\u6bcf\u516c\u65a4 $40$ \u7f8e\u5206\u7684\u9762\u7c89\u3002\u6bcf\u79cd\u9762\u7c89\u5e94\u53d6\u591a\u5c11\u516c\u65a4\uff1f",
      "figure_ids": []
    },
    {
      "number": "488",
      "text": "\u519c\u573a\u7528\u4e8e\u79cb\u64ad\u4f5c\u7269\u7684\u5730\u6bd4\u7528\u4e8e\u6625\u64ad\u4f5c\u7269\u7684\u5730\u591a $480$\u516c\u9877\u3002\u5f53\u6536\u5b8c $80\\%$ \u79cb\u64ad\u4f5c\u7269\u548c $25\\%$ \u6625\u64ad\u4f5c\u7269\u4ee5\u540e\uff0c\u672a\u6536\u5272\u7684\u79cb\u64ad\u4f5c\u7269\u6bd4\u6625\u64ad\u4f5c\u7269\u5c11 $300$ \u516c\u9877\u3002\u519c\u573a\u7684\u79cb\u64ad\u4f5c\u7269\u548c\u6625\u64ad\u4f5c\u7269\u5404\u7528\u5730\u591a\u5c11\u516c\u9877\uff1f",
      "figure_ids": []
    },
    {
      "number": "489",
      "text": "\u4e24\u4e2a\u5de5\u4eba\u5c0f\u7ec4\uff0c\u6309\u8ba1\u5212\u5e94\u5f53\u4e00\u4e2a\u6708\u751f\u4ea7 $680$ \u4e2a\u96f6\u4ef6\u3002\u4e00\u4e2a\u5c0f\u7ec4\u8d85\u989d $20\\%$ \u5b8c\u6210\u6708\u8ba1\u5212\u6307\u6807\uff0c\u53e6\u4e00\u4e2a\u8d85\u989d $15\\%$\uff0c\u7ed3\u679c\u4e24\u4e2a\u5c0f\u7ec4\u6bd4\u8ba1\u5212\u591a\u751f\u4ea7\u4e86 $118$ \u4e2a\u96f6\u4ef6\u3002\u6309\u8ba1\u5212\u6bcf\u4e2a\u5c0f\u7ec4\u5e94\u5f53\u5728\u4e00\u4e2a\u6708\u5185\u751f\u4ea7\u591a\u5c11\u4e2a\u96f6\u4ef6\uff1f",
      "figure_ids": []
    }
  ],
