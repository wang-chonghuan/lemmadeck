  "exercises": [
    {
      "number": "290",
      "text": "\u56fe $72$ \u4e0a\u753b\u51fa\u7684\u662f\u5f0f $y=\\frac{8}{x}$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u4ece\u56fe\u4e0a\u6c42\u51fa\uff1a\na) $x$ \u7b49\u4e8e $2,4,-1,-4,-5$ \u65f6\u5bf9\u5e94\u7684 $y$ \u503c\u3002\nb) \u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6 $y$ \u503c\u7b49\u4e8e $-4,-2,8$\uff1f\nc) $y$ \u503c\u662f\u6b63\u6570\u6216\u8d1f\u6570\u65f6 $x$ \u503c\u7684\u96c6\u5408\u3002",
      "figure_ids": [
        "fig-72"
      ]
    },
    {
      "number": "291",
      "text": "\u4f5c\u5f0f $y=\\frac{6}{x}$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u4ece\u56fe\u4e0a\u6c42\u51fa\uff1a\na) $f(1),\\ f(1.5),\\ f(2),\\ f(3)$\u3002\nb) \u6570\u533a\u95f4 $[1,3],[1.5,6]$ \u6620\u5c04\u5230\u4ec0\u4e48\u96c6\u5408\uff1f\nc) \u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\u51fd\u6570\u7684\u503c\u662f $3,-2$\uff1f",
      "figure_ids": []
    },
    {
      "number": "292",
      "text": "\u4f5c\u5f0f $y=\\frac{-8}{x}$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\na) \u6307\u51fa\u51fd\u6570\u503c\u662f\u6b63\u6570\u65f6 $x$ \u503c\u7684\u96c6\u5408\u3002\nb) \u70b9 $A(-4,-1),\\ B(0,0),\\ C(0.01,-400),\\ D(16,$ $-\\frac{1}{4})$ \u662f\u56fe\u8c61\u4e0a\u7684\u70b9\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "293",
      "text": "\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u53cd\u6bd4\u4f8b\u51fd\u6570\u7684\u56fe\u8c61\u5728\u54ea\u4e2a\u8c61\u9650\u5185\uff1f\na) $y=\\frac{2.5}{x}$\uff1b\nb) $y=\\frac{-18}{x}$\uff1b\nc) $y=\\frac{15}{x}$\uff1b\nd) $y=-\\frac{16}{x}$\u3002",
      "figure_ids": []
    },
    {
      "number": "294",
      "text": "\u77e9\u5f62\u7684\u9762\u79ef\u662f $15cm^2$\u3002\u4e00\u8fb9\u957f $xcm$\uff0c\u53e6\u4e00\u8fb9\u957f $ycm$\u3002\u7528 $x$ \u8868\u793a $y$\u3002\u4f5c\u51fa $y$ \u5bf9 $x$ \u7684\u4f9d\u8d56\u5173\u7cfb\u7684\u56fe\u8c61\u3002",
      "figure_ids": []
    },
    {
      "number": "295",
      "text": "\u56fe $73$ \u753b\u51fa\u7684\u662f\u4ece $A$ \u5730\u5230 $B$ \u5730\u6240\u9700\u65f6\u95f4\u5bf9\u8fd0\u52a8\u901f\u5ea6\u7684\u4f9d\u8d56\u5173\u7cfb\u7684\u56fe\u8c61\u3002\u6839\u636e\u56fe\u8c61\u56de\u7b54\u4e0b\u5217\u95ee\u9898\uff1a\na) \u5982\u679c\u901f\u5ea6\u662f $800$ \u516c\u91cc/\u5c0f\u65f6\u3001$250$ \u516c\u91cc/\u5c0f\u65f6\u3001$120$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u4ece $A$ \u5230 $B$ \u9700\u8981\u591a\u5c11\u5c0f\u65f6\uff1f\nb) \u5982\u679c\u8981\u6c42 $1$ \u5c0f\u65f6\u4ece $A$ \u5230\u8fbe $B$\uff0c\u901f\u5ea6\u5e94\u5f53\u662f\u591a\u5c11\uff1f$4$ \u5c0f\u65f6\u5462\uff1f$8$ \u5c0f\u65f6\u5462\uff1f$16$ \u5c0f\u65f6\u5462\uff1f\nc) $A$ \u5730\u5230 $B$ \u5730\u7684\u8ddd\u79bb\u662f\u591a\u5c11\uff1f",
      "figure_ids": [
        "fig-73"
      ]
    },
    {
      "number": "296",
      "text": "\u4e00\u4eba\u9a91\u81ea\u884c\u8f66\u7531 $A$ \u5730\u5230 $B$ \u5730\uff0c\u901f\u5ea6\u662f $10$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u7528\u4e86 $2$ \u5c0f\u65f6 $30$ \u5206\u949f\u3002\u8fd4\u56de\u65f6\uff0c\u5982\u679c\u901f\u5ea6\u589e\u52a0 $2$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u4ed6\u5728 $2$ \u5c0f\u65f6\u5185\u80fd\u56de\u5230 $A$ \u5730\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "297",
      "text": "\u5982\u679c\u5728\u8bed\u53e5\u201c\u6570 $a$ \u548c $b$ \u7684\u79ef\u7b49\u4e8e\u5b83\u4eec\u7684\u548c\u201d\u4e2d\u4ee3\u5165\u53d8\u91cf$a$ \u548c $b$ \u7684\u53d6\u503c\u6570\u5bf9\uff0c\u5f97\u5230\u7684\u662f\u771f\u547d\u9898\u5417\uff1f\na) $(6,1.2)$\uff1b\nb) $(7,1.3)$\uff1b\nc) $(5,1.25)$\uff1b\nd) $(11,1.1)$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 7,
      "text": "\u5df2\u77e5\u51fd\u6570\u7684\u56fe\u8c61\u662f\u4ec0\u4e48\u6837\u5b50\u5462\uff1f\n\u56e0\u4e3a $0$ \u4e0d\u5c5e\u4e8e\u51fd\u6570\u7684\u5b9a\u4e49\u57df\uff0c\u6240\u4ee5\u56fe\u8c61\u4e0a\u6ca1\u6709\u6a2a\u5750\u6807\u662f $0$ \u7684\u70b9\uff0c\u4e5f\u5c31\u662f\u8bf4\uff0c\u56fe\u8c61\u548c $y$\u8f74\u4e0d\u76f8\u4ea4\u3002\n\u56e0\u4e3a $x$ \u53d6\u4efb\u4f55\u503c\u65f6\uff0c$y$ \u90fd\u4e0d\u7b49\u4e8e\u96f6\uff0c\u6240\u4ee5\u56fe\u8c61\u548c $x$\u8f74\u4e5f\u4e0d\u76f8\u4ea4\u3002"
    },
    {
      "block": 9,
      "text": "$x$ \u53d6\u76f8\u53cd\u6570\u65f6\uff0c\u5bf9\u5e94\u7684\u662f $y$ \u503c\u7684\u76f8\u53cd\u6570\u3002\n\u56fe\u8c61\u4e0a\u5750\u6807\u4e3a\u8d1f\u7684\u70b9\u548c\u5750\u6807\u4e3a\u6b63\u7684\u70b9\uff0c\u5173\u4e8e\u5750\u6807\u539f\u70b9\u5bf9\u79f0\u3002"
    },
    {
      "block": 10,
      "text": "\u56fe $70$ \u753b\u51fa\u7684\u662f\u5f0f $y=\\frac{12}{x}$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\n\u5b83\u662f\u7531\u4e24\u652f\u7ec4\u6210\u7684\uff0c\u4e00\u652f\u5728\u7b2c\u4e00\u8c61\u9650\u5185\uff0c\u53e6\u4e00\u652f\u5728\u7b2c\u4e09\u8c61\u9650\u5185\u3002"
    },
    {
      "block": 15,
      "text": "\u5982\u679c\u51fd\u6570\u662f\u7528\u5f0f $y=\\frac{k}{x}\\ (k<0)$ \u7ed9\u51fa\u7684\uff0c\u90a3\u4e48 $x$ \u53d6\u6b63\u503c\u65f6\uff0c\u5bf9\u5e94\u7684 $y$ \u503c\u662f\u8d1f\u6570\uff1b\n\u53cd\u8fc7\u6765\uff0c$x$ \u53d6\u8d1f\u503c\u65f6\uff0c\u5bf9\u5e94\u7684 $y$ \u503c\u662f\u6b63\u6570\u3002\n\u56fe $71$ \u753b\u51fa\u7684\u662f\u516c\u5f0f $y=-\\frac{12}{x}$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\n\n\u5b83\u662f\u7531\u4e24\u652f\u7ec4\u6210\u7684\u66f2\u7ebf\uff0c\u4e00\u652f\u5728\u7b2c\u4e8c\u8c61\u9650\u5185\uff0c\u53e6\u4e00\u652f\u5728\u7b2c\u56db\u8c61\u9650\u5185\u3002"
    },
    {
      "block": 16,
      "text": "\u4e00\u822c\u5730\uff0c\u5f0f $y=\\frac{k}{x}\\ (k\\ne0)$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\uff0c\u662f\u7531\u4e24\u652f\u7ec4\u6210\u7684\u66f2\u7ebf\u3002\n\u8fd9\u79cd\u66f2\u7ebf\u53eb\u505a\u53cc\u66f2\u7ebf\u3002"
    },
    {
      "block": 17,
      "text": "\u5982\u679c\u5f0f $y=\\frac{k}{x}$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u4e0d\u5305\u62ec\u6240\u6709\u4e0d\u7b49\u4e8e $0$\u7684\u6570\uff0c\u90a3\u4e48\u5b83\u7684\u56fe\u8c61\u662f\u53cc\u66f2\u7ebf\u4e0a\u70b9\u7684\u5b50\u96c6\u3002"
    }
  ],
