        "limitations": [
          "图像识别不能证明学生独立描点并绘制曲线；绘图仍由书写题承担。",
          "候选图窗口为[-4,4]，不能从中读出原任务全部区间端点与函数值；这些值改由代数对应题检验。",
          "通过符号和形状排除错误图，不一定需要核验全部系数对应点。"
        ],
        "figure_observations": [
          {
            "figure_id": "fig-six-graphs",
            "observation": "四个完整候选a至d，坐标框同尺度；a有I、III两支并过(2,3)、(3,2)，b符号相反，c直线穿原点，d在上半平面两支；底部d及最右轴标清楚。"
          }
        ]
      },
      "key": {
        "correct": [
          "a"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "correct",
            "derivation": "两支在第一、第三象限，(2,3)与(3,2)的乘积均为6，且不与轴相交。",
            "misconception": null
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "在第二、第四象限，表示负系数y=-6/x。",
            "misconception": "把正系数反比例的坐标同号关系变成异号关系。"
          },
          {
            "option_id": "c",
            "truth": "incorrect",
            "derivation": "直线穿原点，表示y=6x而非6/x。",
            "misconception": "把除以x误作乘以x，得到正比例直线。"
          },
          {
            "option_id": "d",
            "truth": "incorrect",
            "derivation": "左右两支都在横轴上方，x=-2时给正值1.5，表示6/x^2。",
            "misconception": "把分母x换成x^2，消除了负输入的负函数值。"
          }
        ]
      }
    },
