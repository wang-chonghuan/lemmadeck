    {
      "id": "q298-n4-sum",
      "source": {
        "exercise": "298",
        "target": "n4-sum"
      },
      "group": null,
      "prompt": "凸多边形的内角和为 $S=180n-360$，其中 $n$ 是边数。边数为 $4$ 时，内角和是多少度？",
      "figureRefs": [],
      "options": [
        {
          "id": "a",
          "text": "$720$",
          "value": "720",
          "misconception": "只算了 $180\\times4$，漏减 $360$。"
        },
        {
          "id": "b",
          "text": "$360$",
          "value": "360"
        },
        {
          "id": "c",
          "text": "$540$",
          "value": "540",
          "misconception": "把 $180n-360$ 错写成 $180(n-1)$，只减去一个 $180$。"
        }
      ],
      "correctOptionId": "b",
      "explanation": "$S=180\\times4-360=360$，所以内角和是 $360$ 度。",
      "verification": {
        "kind": "numeric",
        "expected": "360",
        "reason": "代入给定 n=4 得 720-360=360；选项 a=720、b=360、c=540，只有 b 等于结果。"
      }
    },
