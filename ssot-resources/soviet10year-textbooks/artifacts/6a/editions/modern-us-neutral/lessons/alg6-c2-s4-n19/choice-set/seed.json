  "exercises": [
    {
      "number": "298",
      "text": "\u51f8\u591a\u8fb9\u5f62\u5185\u89d2\u548c\uff08\u5355\u4f4d\uff1a\u5ea6\uff09\u7684\u8ba1\u7b97\u5f0f\u662f $S=180n-360$\uff0c\u5176\u4e2d $n$ \u662f\u591a\u8fb9\u5f62\u7684\u8fb9\u6570\u3002\u5982\u679c $n=4$\uff0c$S$ \u7b49\u4e8e\u591a\u5c11\uff1f$n=5$\u5462\uff1f$n=10$ \u5462\uff1f",
      "figure_ids": []
    },
    {
      "number": "299",
      "text": "\u6c34\u6c60\u5b58\u6c34 $140m^3$\u3002\u4ece\u6c34\u6c60\u4e2d\u6bcf\u4e00\u79d2\u949f\u6d41\u51fa $0.1m^3$ \u6c34\u3002$t$\u79d2\u949f\u4ee5\u540e\uff0c\u6c34\u6c60\u5269\u6c34\u591a\u5c11\u7acb\u65b9\u7c73\uff08$V$\uff09\uff1f\u7528\u5f0f\u5199\u51fa $V$ \u5bf9 $t$\u7684\u4f9d\u8d56\u5173\u7cfb\u3002\u51fd\u6570 $t\\xrightarrow{f}V$ \u662f\u4e0d\u662f\u7ebf\u6027\u51fd\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "300",
      "text": "\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u51fd\u6570\u662f\u7ebf\u6027\u51fd\u6570\u5417\uff1f\u5982\u679c\u662f\uff0c\u5c31\u6307\u51fa $k$\u548c $l$ \u7684\u503c\uff1a\na) $y=-x+2$\uff1b\nb) $y=1-10x$\uff1b\nc) $y=-3x$\uff1b\nd) $y=0x-7$\uff1b\ne) $y=\\frac{x}{5}$\uff1b\nf) $y=\\frac{5}{x}$\uff1b\ng) $y=2x^2+8$\uff1b\nh) $y=\\frac{x-7}{10}$\uff1b\ni) $y=5(3-x)$\u3002",
      "figure_ids": []
    },
    {
      "number": "301",
      "text": "\u7528\u96c6\u5408 $X$ \u4e0a\u7684\u5f0f $y=2x-5$ \u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u3002\u6c42\u51fd\u6570\u7684\u503c\u57df $Y$\uff1a\na) $X=\\{-1,0,1,2,3\\}$\uff1b\nb) $\\{-\\frac{2}{3},-\\frac{1}{2},-\\frac{5}{12},0,\\frac{5}{6}\\}$\u3002",
      "figure_ids": []
    },
    {
      "number": "302",
      "text": "\u5f0f $y=0.4x-6$ \u7ed9\u51fa\u4e00\u4e2a\u7ebf\u6027\u51fd\u6570\u3002\u586b\u8868\uff1a",
      "figure_ids": [
        "tbl-p0093-01"
      ]
    },
    {
      "number": "303",
      "text": "\u4f5c\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\uff1a\na) $y=0.2x$\uff1b\nb) $y=-\\frac{1}{3}x$\u3002",
      "figure_ids": []
    },
    {
      "number": "304",
      "text": "\u5f53\u7cfb\u6570 $k$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u5f0f $y=kx$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u7ecf\u8fc7\u70b9 $A(0.3,2)$\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 8,
      "text": "\u53ef\u4ee5\u7528\u5f0f $y=kx+l$\uff08\u5176\u4e2d $k$ \u548c $l$ \u662f\u4e24\u4e2a\u6570\uff09\u7ed9\u51fa\u7684\u51fd\u6570\uff0c\u53eb\u505a\u7ebf\u6027\u51fd\u6570\u3002"
    },
    {
      "block": 9,
      "text": "\u56e0\u4e3a\u5f0f $kx+l$ \u5bf9\u4e8e\u4efb\u4f55 $x$ \u503c\u90fd\u6709\u610f\u4e49\uff0c\u6240\u4ee5\u7ebf\u6027\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u53ef\u4ee5\u662f\u6240\u6709\u6570\u7684\u96c6\u5408\uff0c\u4e5f\u53ef\u4ee5\u662f\u5b83\u7684\u4efb\u4e00\u5b50\u96c6\u3002"
    },
    {
      "block": 10,
      "text": "\u4ee5\u524d\u5b66\u8fc7\u7684\u6b63\u6bd4\u4f8b\u5173\u7cfb\u662f\u7ebf\u6027\u51fd\u6570\u7684\u7279\u6b8a\u60c5\u51b5\u3002\n\u8fd9\u662f\u56e0\u4e3a\u5f53 $l=0$ \u548c $k\\ne0$ \u65f6\uff0c\u5f0f $y=kx+l$ \u53d8\u5f62\u4e3a $y=kx$\u3002\n\u6211\u4eec\u77e5\u9053\uff0c\u8fd9\u4e2a\u5f0f\u5b50\uff08\u5f53 $k\\ne0$ \u65f6\uff09\u7ed9\u51fa\u7684\u662f\u6b63\u6bd4\u4f8b\u5173\u7cfb\u3002"
    }
  ],
