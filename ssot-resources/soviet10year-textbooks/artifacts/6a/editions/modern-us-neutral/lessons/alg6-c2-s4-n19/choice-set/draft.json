      ],
      "view": {
        "mode": "single",
        "stem": "凸多边形的内角和为 $S=180n-360$ 度，其中 $n$ 是边数。四边形、五边形、十边形的内角和依次是多少？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$720^\\circ,900^\\circ,1800^\\circ$",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$360^\\circ,540^\\circ,1440^\\circ$",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$540^\\circ,720^\\circ,1620^\\circ$",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$1080^\\circ,1260^\\circ,2160^\\circ$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "把边数代入同一内角和规则，得到完整对应。",
        "source_solution": "S(4)=720-360=360，S(5)=900-360=540，S(10)=1800-360=1440度。",
        "unit_reason": "三次数值属于同一对应规则，保留为一个完整结果而非三次点击。",
        "concept_blocks": [
          8
        ],
        "limitations": [
          "选择结果不能证明独立书写代入过程。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "B"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "误用S=180n，得到720、900、1800。",
            "misconception": "省略整项-360。"
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "180×4-360=360；180×5-360=540；180×10-360=1440。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "误用S=180(n-1)，得到540、720、1620。",
            "misconception": "把减去两个三角形角和误作只减一个。"
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "把-360误写为+360，得到1080、1260、2160。",
            "misconception": "改变常数项符号。"
          }
        ]
      }
    },
