        "figure_observations": []
      },
      "key": {
        "correct": [
          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "将流出量加回初始量，140+0.1t。",
            "misconception": "把排水按注水列式。"
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "只保留时间非负而不解140-0.1t≥0；例如t=1500给出V=-10。",
            "misconception": "把代数定义域当成物理适用范围。"
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "140-0.1t≥0给出t≤1400，形式为kx+l。",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "排空时间误算140×0.1=14，而不是140÷0.1。",
