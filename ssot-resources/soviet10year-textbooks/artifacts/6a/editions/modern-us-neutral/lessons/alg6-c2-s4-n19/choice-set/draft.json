            "text": "$V=140-0.1t$，$0\\le t\\le1400$；线性函数。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$V=140-0.1t$，$0\\le t\\le14$；线性函数。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
