    },
    {
      "number": "536",
      "text": "\u76f4\u7ebf $2x+3y=20$\uff0c$3x-5y=11$ \u548c $x+y=9$ \u662f\u5426\u7ecf\u8fc7\u540c\u4e00\u70b9\u3002",
