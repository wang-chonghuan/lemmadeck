  "exercises": [
    {
      "number": "452",
      "text": "\u5c06\u6bcf\u4e2a\u65b9\u7a0b\u4e2d\u7684 $y$ \u7528 $x$ \u6765\u8868\u793a\uff0c\u7136\u540e\u8bf4\u51fa\u54ea\u4e00\u4e2a\u65b9\u7a0b\u7ec4\u6709\u552f\u4e00\u89e3\uff0c\u54ea\u4e00\u4e2a\u65e0\u89e3\uff0c\u54ea\u4e00\u4e2a\u6709\u65e0\u9650\u591a\u4e2a\u89e3\uff1a\na) $\\begin{cases}y-6x=0,\\\\4x-y=-2;\\end{cases}$\nb) $\\begin{cases}5x+8y=24,\\\\x+12y=36;\\end{cases}$\nc) $\\begin{cases}1.5x-4y=1,\\\\8y=3x-2;\\end{cases}$\nd) $\\begin{cases}0.2x+0.3y=0,\\\\x+1.5y=4;\\end{cases}$\ne) $\\begin{cases}2x=11-3y,\\\\3y=11-2x;\\end{cases}$\nf) $\\begin{cases}4x-3y=7,\\\\5x+2y=26.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "453",
      "text": "\u5229\u7528\u56fe\u8c61\u8bf4\u660e\u4e3a\u4ec0\u4e48\u4e0b\u5217\u65b9\u7a0b\u7ec4\u6709\u89e3\uff0c\u800c\u4e14\u662f\u552f\u4e00\u89e3\uff1a$\\begin{cases}3x+0y=15,\\\\x+y=7.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "454",
      "text": "\u5df2\u77e5\u65b9\u7a0b $5x-y=2$\u3002\u81ea\u5df1\u5199\u4e00\u4e2a\u65b9\u7a0b\uff0c\u4f7f\u5f97\u5b83\u548c\u5df2\u77e5\u65b9\u7a0b\u7ec4\u6210\u7684\u65b9\u7a0b\u7ec4\u6ee1\u8db3\u4e0b\u5217\u6761\u4ef6\uff1a\na) \u6709\u4e00\u4e2a\u800c\u4e14\u4ec5\u6709\u4e00\u4e2a\u89e3\uff1b\nb) \u65e0\u89e3\uff1b\nc) \u6709\u65e0\u9650\u591a\u4e2a\u89e3\u3002",
      "figure_ids": []
    },
    {
      "number": "455",
      "text": "\u76f4\u7ebf $3x-7y=1$ \u662f\u5426\u7ecf\u8fc7\u4e0b\u9762\u4e24\u6761\u76f4\u7ebf\u7684\u4ea4\u70b9\uff1f\na) $x+0y=-2$ \u548c $5x-y=-9$\uff1b\nb) $0x+y=5$ \u548c $x+y=11$\u3002",
      "figure_ids": []
    },
    {
      "number": "456",
      "text": "\u5229\u7528\u56fe\u8c61\u8bf4\u660e\u4e09\u4e2a\u4e8c\u5143\u65b9\u7a0b\u7ec4\u6210\u7684\u65b9\u7a0b\u7ec4\u6709\u6ca1\u6709\u89e3\uff1a\na) $\\begin{cases}x+y=2,\\\\2x+3y=0,\\\\x-y=10;\\end{cases}$\nb) $\\begin{cases}x-y=1,\\\\x+2y=13,\\\\2x-y=3.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "457",
      "text": "\u4e0b\u5217\u65b9\u7a0b\u7ec4\u6709\u6ca1\u6709\u89e3\uff1f$\\begin{cases}0x+0y=1,\\\\x+y=2.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "458",
      "text": "\u65b9\u7a0b\u7ec4$\\begin{cases}0x+0y=0,\\\\x-y=10\\end{cases}$\u6709\u591a\u5c11\u4e2a\u89e3\uff1f\u6c42\u51fa\u8fd9\u4e2a\u65b9\u7a0b\u7ec4\u7684\u4e24\u4e2a\u89e3\u3002",
      "figure_ids": []
    },
    {
      "number": "459",
      "text": "\u8ba1\u7b97\uff1a\na) $(\\frac{4}{15}+\\frac{7}{12}-\\frac{19}{20})\\times2.5+0.25$\uff1b\nb) $30+2.8\\div(\\frac{4}{25}-\\frac{9}{15}-\\frac{1}{6})$\u3002",
      "figure_ids": []
    },
    {
      "number": "460",
      "text": "\u4efb\u610f\u627e\u51fa\u4e0b\u5217\u4e0d\u7b49\u5f0f\u7684\u4e24\u4e2a\u89e3\uff1a\na) $|x-1|<1$\uff1b\nb) $|x+3|<0.1$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6211\u4eec\u6765\u8ba8\u8bba\u4e8c\u5143\u7ebf\u6027\u65b9\u7a0b\u7ec4\uff0c\u5176\u4e2d\u6bcf\u4e00\u4e2a\u65b9\u7a0b\u81f3\u5c11\u6709\u4e00\u4e2a\u7cfb\u6570\u4e0d\u7b49\u4e8e\u96f6\u3002"
    },
    {
      "block": 1,
      "text": "\u7528\u56fe\u89e3\u6cd5\u89e3\u8fd9\u79cd\u65b9\u7a0b\u7ec4\uff0c\u53ef\u4ee5\u5f52\u7ed3\u4e3a\u6c42\u4e24\u6761\u76f4\u7ebf\u4ea4\u70b9\u7684\u5750\u6807\u3002"
    },
    {
      "block": 2,
      "text": "\u6211\u4eec\u77e5\u9053\uff0c\u5e73\u9762\u4e0a\u4e24\u6761\u76f4\u7ebf\u6216\u76f8\u4ea4\uff0c\u6216\u5e73\u884c\u3002\n\u5e73\u884c\u53c8\u6709\u4e24\u79cd\u60c5\u51b5\uff0c\u4e00\u662f\u4e24\u76f4\u7ebf\u6ca1\u6709\u4ea4\u70b9\uff0c\u4e00\u662f\u4e24\u76f4\u7ebf\u91cd\u5408\u3002"
    },
    {
      "block": 14,
      "text": "\u603b\u8d77\u6765\u8bf4\uff0c\u4e24\u4e2a\u4e8c\u5143\u7ebf\u6027\u65b9\u7a0b\u7ec4\u6210\u7684\u65b9\u7a0b\u7ec4\u4e2d\uff0c\u5982\u679c\u6bcf\u4e00\u4e2a\u65b9\u7a0b\u81f3\u5c11\u6709\u4e00\u4e2a\u672a\u77e5\u6570\u7684\u7cfb\u6570\u4e0d\u7b49\u4e8e\u96f6\uff0c\u90a3\u4e48\u65b9\u7a0b\u7ec4\u6216\u8005\u6709\u552f\u4e00\u89e3\uff0c\u6216\u8005\u65e0\u89e3\uff0c\u6216\u8005\u6709\u65e0\u9650\u591a\u4e2a\u89e3\u3002"
    }
