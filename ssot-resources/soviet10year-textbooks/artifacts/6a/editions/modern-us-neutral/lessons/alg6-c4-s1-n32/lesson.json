  "chapter": "第四章　自然数指数幂",
  "section": "§ 10．幂的定义和性质",
  "number": "32",
  "title": "幂的乘方",
  "printed_title": "32．幂的乘方",
  "start_page": 164,
  "start_printed": 158,
  "figures": [
