  "exercises": [
    {
      "number": "281",
      "text": "\u5982\u679c\u706b\u8f66\u7684\u901f\u5ea6\u7531 $60$ \u516c\u91cc/\u5c0f\u65f6\u589e\u81f3 $90$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u706b\u8f66\u901a\u8fc7\u4e24\u4e2a\u7ad9\u4e4b\u95f4\u7684\u8def\u7a0b\u53ef\u4ee5\u5feb\u591a\u5c11\u500d\uff1f",
      "figure_ids": []
    },
    {
      "number": "282",
      "text": "\u6709\u540c\u6837\u8d28\u91cf\u7684\u94c1\u5757\u548c\u94dd\u5757\u5404\u4e00\u5757\u3002\u5df2\u77e5\u94dd\u7684\u5bc6\u5ea6\u662f $2.7$\u514b/\u5398\u7c73$^3$\uff0c\u94c1\u7684\u5bc6\u5ea6\u662f $7.8$ \u514b/\u5398\u7c73$^3$\u3002\u54ea\u4e00\u5757\u7684\u4f53\u79ef\u5927\uff1f\u5927\u5757\u7684\u4f53\u79ef\u662f\u5c0f\u5757\u7684\u51e0\u500d\uff1f",
      "figure_ids": []
    },
    {
      "number": "283",
      "text": "\u4e09\u53f0\u62d6\u62c9\u673a\u7528 $60$ \u5c0f\u65f6\u53ef\u4ee5\u8015\u5b8c\u67d0\u519c\u573a\u7684\u5730\u3002\u5982\u679c\u5341\u4e8c\u53f0\u540c\u6837\u7684\u62d6\u62c9\u673a\uff0c\u51e0\u5c0f\u65f6\u53ef\u4ee5\u8015\u5b8c\uff1f",
      "figure_ids": []
    },
    {
      "number": "284",
      "text": "\u8981\u7528\u591a\u5c11\u8f86\u8f7d\u91cd\u91cf $5$ \u5428\u7684\u8d27\u8f66\u53bb\u6362 $15$ \u8f86 $8$ \u5428\u7684\u8d27\u8f66\uff0c\u624d\u80fd\u4f7f\u8f7d\u91cd\u91cf\u76f8\u7b49\uff1f",
      "figure_ids": []
    },
    {
      "number": "285",
      "text": "\u5de5\u4eba\u6539\u8fdb\u8f66\u5200\u4ee5\u540e\uff0c\u6bcf\u751f\u4ea7\u4e00\u4e2a\u96f6\u4ef6\u7531 $10$ \u5206\u949f\u7f29\u77ed\u4e3a$8$ \u5206\u949f\u3002\u5982\u679c\u4ee5\u524d\u4ed6\u6bcf\u73ed\u751f\u4ea7 $48$ \u4e2a\u96f6\u4ef6\uff0c\u73b0\u5728\u6bcf\u73ed\u80fd\u751f\u4ea7\u591a\u5c11\u4e2a\u96f6\u4ef6\uff1f",
      "figure_ids": []
    },
    {
      "number": "286",
      "text": "\u6c7d\u8f66\u4ee5 $60$ \u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u884c\u9a76\u65f6\uff0c\u4ece $A$ \u5730\u5230 $B$ \u5730\u9700 $3$\u5c0f\u65f6 $15$ \u5206\u949f\u3002\u5982\u679c\u901f\u5ea6\u589e\u52a0 $15$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u6c7d\u8f66\u7528\u51e0\u5c0f\u65f6\u53ef\u4ee5\u884c\u9a76\u540c\u6837\u8ddd\u79bb\uff1f",
      "figure_ids": []
    },
    {
      "number": "287",
      "text": "\u8f6e\u8239\u987a\u6d41\u800c\u4e0b\uff0c\u884c\u9a76\u4e86 $18$ \u5c0f\u65f6\u3002\u5982\u679c\u8f6e\u8239\u672c\u8eab\u7684\u901f\u5ea6\u662f $26$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u6c34\u6d41\u901f\u5ea6\u662f $2$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u8f6e\u8239\u9006\u6d41\u800c\u4e0a\u9700\u7528\u51e0\u5c0f\u65f6\u624d\u80fd\u884c\u9a76\u540c\u6837\u8def\u7a0b\uff1f",
      "figure_ids": []
    },
    {
      "number": "288",
      "text": "\u5728\u5750\u6807\u5e73\u9762\u4e0a\u63cf\u70b9 $A(2,7)$ \u548c $B(6,1)$\uff0c\u7136\u540e\u4f5c\u51fa\u5b83\u4eec\u5173\u4e8e\u5750\u6807\u539f\u70b9\u7684\u5bf9\u79f0\u70b9 $A_1$ \u548c $B_1$\u3002\u6c42 $A_1$ \u548c $B_1$ \u7684\u5750\u6807\u3002",
      "figure_ids": []
    },
    {
      "number": "289",
      "text": "\u5f0f $y=\\frac{10}{x}$ \u7ed9\u51fa\u4e00\u53cd\u6bd4\u4f8b\u51fd\u6570\u3002$x$ \u53d6\u503c $-0.2$ \u65f6\u5bf9\u5e94\u7684\u51fd\u6570\u503c\u662f\u4ec0\u4e48\uff1f\u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\u51fd\u6570\u503c\u662f $-5$\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 6,
      "text": "\u4e00\u822c\u5730\uff0c\u5982\u679c\u51fd\u6570 $x\\xrightarrow{f}y$ \u662f\u53cd\u6bd4\u4f8b\u51fd\u6570\uff0c$(x_1,y_1)$ \u548c $(x_2,$ $y_2)$ \u662f\u53d8\u91cf $x$ \u548c $y$ \u7684\u5bf9\u5e94\u503c\u6570\u5bf9\uff0c\u90a3\u4e48$\\frac{x_1}{x_2}=\\frac{y_2}{y_1}$\u3002"
    },
    {
      "block": 10,
      "text": "\u5982\u679c\u53d8\u91cf $x$ \u548c $y$ \u7684\u503c\u662f\u6b63\u6570\uff0c\u90a3\u4e48\u4e0a\u9762\u8bc1\u660e\u7684\u53cd\u6bd4\u4f8b\u51fd\u6570\u7684\u6027\u8d28\u53ef\u4ee5\u7528\u8bed\u8a00\u53d9\u8ff0\u6210\uff1a"
    },
    {
      "block": 11,
      "text": "\u5f53 $x$ \u7684\u503c\u589e\u5927\u4e3a $n$ \u500d\uff0c\u5bf9\u5e94\u7684 $y$ \u503c\u5c31\u7f29\u5c0f\u4e3a $n$ \u5206\u4e4b\u4e00\u3002\n\u540c\u6837\uff0c\u5f53 $x$ \u7684\u503c\u7f29\u5c0f\u4e3a $n$ \u5206\u4e4b\u4e00\uff0c\u5bf9\u5e94\u7684 $y$ \u503c\u5c31\u6269\u5927 $n$ \u500d\u3002"
    }
  ],
