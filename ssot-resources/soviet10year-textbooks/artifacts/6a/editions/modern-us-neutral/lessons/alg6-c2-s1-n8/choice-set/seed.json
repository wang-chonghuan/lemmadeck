  "exercises": [
    {
      "number": "180",
      "text": "\u56fe 36 \u7ed9\u51fa\u7684\u5173\u7cfb\u4e2d\uff0c\u54ea\u51e0\u4e2a\u662f\u51fd\u6570\uff1f",
      "figure_ids": [
        "fig-36"
      ]
    },
    {
      "number": "181",
      "text": "\u96c6\u5408 $K=\\{m,n,p,q\\}$ \u548c $M=\\{0,1\\}$ \u7684\u5143\u7d20\u4e4b\u95f4\uff0c\u7528\u5217\u51fa\u6570\u5bf9\u96c6\u5408\u7684\u65b9\u6cd5\u7ed9\u51fa\u4e86\u4e24\u79cd\u5173\u7cfb\uff1a$\\{(m,0),(n,0),$ $(p,1),(q,1)\\}$\uff0c$\\{(m,1),(n,0),(n,1),(p,1),(q,1)\\}$\u3002\u7528\u7bad\u5934\u53f7\u8868\u793a\u4e0a\u9762\u4e24\u79cd\u5173\u7cfb\u3002\u8bf4\u660e\u5176\u4e2d\u54ea\u4e00\u79cd\u5173\u7cfb\u662f\u51fd\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "182",
      "text": "\u5df2\u77e5\u96c6\u5408 $A$ \u548c $B$ \u7684\u5143\u7d20\u4e4b\u95f4\u7684\u5173\u7cfb\u662f\u7528\u5217\u6570\u5bf9\u7684\u65b9\u6cd5\u7ed9\u51fa\u7684\u3002\u5982\u679c\u53ea\u77e5\u9053\u5176\u4e2d\u4e24\u5bf9 $(a,2)$ \u548c $(a,5)$\uff0c\u80fd\u4e0d\u80fd\u5224\u65ad\u8fd9\u79cd\u5173\u7cfb\u662f\u51fd\u6570\u6216\u8005\u4e0d\u662f\u51fd\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "183",
      "text": "\u7528\u6570\u5bf9\u96c6\u5408 $\\{(1,1),(2,\\frac12),(\\frac27,3.5),(-0.01,-100)\\}$\u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u3002\u6307\u51fa\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df\u3002\u6c42 $p(1)$\u3001$p(2),p(\\frac27),p(-0.01)$\u3002",
      "figure_ids": []
    },
    {
      "number": "184",
      "text": "\u7528\u4e0b\u9762\u7684\u53d9\u8ff0\u89c4\u5b9a\u4e00\u79cd\u5173\u7cfb\uff1a\u201c\u4f60\u4eec\u73ed\u7684\u6bcf\u4e00\u4e2a\u5b66\u751f\u548c\u6700\u540e\u4e00\u6b21\u4ee3\u6570\u6d4b\u9a8c\u5f97\u7684\u5206\u6570\u5bf9\u5e94\u201d\u3002\u8fd9\u6837\u5728\u5b66\u751f\u548c\u8003\u8bd5\u5206\u6570\u4e4b\u95f4\u5efa\u7acb\u7684\u5173\u7cfb\u662f\u4e0d\u662f\u51fd\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "185",
      "text": "\u7528\u4e0b\u9762\u7684\u53d9\u8ff0\u89c4\u5b9a\u4e00\u79cd\u5173\u7cfb\uff1a\u201c\u6bcf\u4e00\u4e2a\u4e24\u4f4d\u6570\u548c\u5b83\u7684\u6570\u5b57\u548c\u5bf9\u5e94\u201d\u3002\u4e3a\u4ec0\u4e48\u8fd9\u6837\u5b9a\u4e49\u7684\u5173\u7cfb\u662f\u51fd\u6570\uff1f\u6c42 $f(25)$\u3001$f(74),f(92)$\u3002\u6307\u51fa\u8fd9\u4e2a\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df\u3002",
      "figure_ids": []
    },
    {
      "number": "186",
      "text": "\u7528\u4e0b\u9762\u7684\u53d9\u8ff0\u5b9a\u4e49\u4e00\u4e2a\u51fd\u6570\uff1a\u201c\u96c6\u5408 $X$ \u4e2d\u7684\u6bcf\u4e00\u4e2a\u6570\u548c\u5b83\u7684\u76f8\u53cd\u6570\u5bf9\u5e94\u3002\u201d\u6c42\u8fd9\u4e2a\u51fd\u6570\u7684\u503c\u57df\uff1a\na) $X=\\{-6,-5,-4,-3,-2\\}$\uff1b\nb) $X=[-6,-2]$\uff1b\nc) $X=[0,5]$\uff1b\nd) $X=[-6,6]$\u3002",
      "figure_ids": []
    },
    {
      "number": "187",
      "text": "\u8bbe $A\\mapsto C,B\\mapsto D$\uff08\u56fe 37\uff09\uff0c\u70b9 $O$ \u662f\u76f4\u7ebf $AC$ \u548c $BD$ \u7684\u4ea4\u70b9\uff1b\u7ebf\u6bb5 $AB$ \u4e0a\u4e00\u70b9 $K$ \u548c\u7ebf\u6bb5 $CD$ \u4e0a\u4e00\u70b9 $M$ \u5bf9\u5e94\uff0c\u800c $M$ \u548c$K,O$ \u5e94\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\u3002\u8fd9\u6837\u89c4\u5b9a\u7684\u7ebf\u6bb5 $AB$ \u548c $CD$ \u7684\u70b9\u4e4b\u95f4\u7684\u5173\u7cfb\u662f $[AB]$ \u5230 $[CD]$ \u7684\u6620\u5c04\u5417\uff1f",
      "figure_ids": [
        "fig-37"
      ]
    },
    {
      "number": "188",
      "text": "\u5982\u56fe 38\uff0c\u5706\u5468\u7684\u70b9\u548c\u7ebf\u6bb5 $AB$ \u7684\u5173\u7cfb $f$ \u89c4\u5b9a\u5982\u4e0b\uff1a\u201c\u5706\u5468\u7684\u6bcf\u4e00\u70b9\u548c\u7ebf\u6bb5 $AB$ \u4e0a\u4e00\u70b9\u5bf9\u5e94\uff0c\u8fd9\u70b9\u548c\u5706\u5468\u4e0a\u7684\u70b9\u90fd\u5728\u59cb\u70b9\u4e3a $O$ \u7684\u540c\u4e00\u5c04\u7ebf\u4e0a\u3002\u201d\u4e3a\u4ec0\u4e48\u5173\u7cfb $f$ \u662f\u5706\u5468\u5230\u7ebf\u6bb5 $AB$ \u7684\u6620\u5c04\uff1f\u6c42 $f(P),f(Q),f(K)$\u3002",
      "figure_ids": [
        "fig-38"
      ]
    },
    {
      "number": "189",
      "text": "\u5982\u56fe 39\uff0c\u7ebf\u6bb5 $AB$ \u4e0a\u6bcf\u4e00\u70b9\u548c\u4ee5\u7ebf\u6bb5\u7684\u4e2d\u5782\u7ebf $l$ \u4e3a\u5bf9\u79f0\u8f74\u7684\u5bf9\u79f0\u70b9\u5bf9\u5e94\u3002$A$ \u70b9\u548c\u54ea\u4e00\u70b9\u5bf9\u5e94\uff1f$B$ \u70b9\u5462\uff1f$O$ \u70b9\u5462\uff1f\u8fd9\u6837\u89c4\u5b9a\u7684\u5173\u7cfb\u662f\u4e0d\u662f\u7ebf\u6bb5 $AB$ \u5230\u7ebf\u6bb5 $AB$ \u7684\u6620\u5c04\uff08\u5373\u7ebf\u6bb5 $AB$ \u5230\u5b83\u81ea\u8eab\u7684\u6620\u5c04\uff09\uff1f",
      "figure_ids": [
        "fig-39"
      ]
    },
    {
      "number": "190",
      "text": "\u5df2\u77e5\u96c6\u5408 $A=\\{\\frac1{20},\\frac23,\\frac45,\\frac54,\\frac32,20\\}$\u3002\u89c4\u5b9a\u96c6\u5408 $A$ \u7684\u6bcf\u4e00\u4e2a\u6570\u548c\u5b83\u7684\u5012\u6570\u5bf9\u5e94\u3002$\\frac23$ \u548c\u54ea\u4e00\u4e2a\u6570\u5bf9\u5e94\uff1f20 \u5462\uff1f\u8fd9\u6837\u89c4\u5b9a\u7684\u5173\u7cfb\u662f\u96c6\u5408 $A$ \u5230\u5b83\u81ea\u8eab\u7684\u6620\u5c04\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "191",
      "text": "\u5408\u5e76\u540c\u7c7b\u9879\u5e76\u6c42\u503c\uff1a$\\frac23x^3+\\frac56x^3-\\frac12x^3$\uff0c\u5f53 $x=3$\u3002",
      "figure_ids": []
    },
    {
      "number": "192",
      "text": "\u8ba1\u7b97\uff1a$(0.15+0.84\\times\\frac5{12})\\times1.4$\u3002",
      "figure_ids": []
    },
    {
      "number": "193",
      "text": "\u7528\u6570\u533a\u95f4\u7684\u5f62\u5f0f\u5199\u51fa\u4e0d\u7b49\u5f0f\u7684\u89e3\u96c6\u5408\uff1a\na) $2<x\\le15$\uff1b\nb) $-8\\le x<17$\u3002",
      "figure_ids": []
    },
    {
      "number": "194",
      "text": "\u96c6\u5408 $X=\\{2,4,6\\},Y=\\{1,2,3,4,5,6\\}$\u3002\u7528\u8bed\u53e5\u201c$x<y$\u201d\uff08\u5176\u4e2d $x\\in X,\\ y\\in Y$\uff09\u89c4\u5b9a\u96c6\u5408 $X$ \u548c $Y$ \u7684\u5143\u7d20\u95f4\u7684\u5173\u7cfb\u3002\u7528\u5217\u6570\u5bf9\u7684\u65b9\u6cd5\u7ed9\u51fa\u8fd9\u79cd\u5173\u7cfb\u5e76\u4f5c\u56fe\u8c61\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 3,
      "text": "\u5173\u7cfb $h,g$ \u548c $p$ \u6709\u8fd9\u6837\u7684\u7279\u70b9\uff1a\u96c6\u5408 $A$ \u7684\u6bcf\u4e00\u4e2a\u5143\u7d20\uff0c\u5728\u96c6\u5408 $B$ \u4e2d\u6216\u8005\u53ea\u6709\u4e00\u4e2a\u5143\u7d20\u548c\u5b83\u5bf9\u5e94\uff0c\u6216\u8005\u6839\u672c\u6ca1\u6709\u5143\u7d20\u548c\u5b83\u5bf9\u5e94\u3002\n\u6362\u53e5\u8bdd\u8bf4\uff0c\u96c6\u5408 $A$ \u7684\u6bcf\u4e00\u4e2a\u5143\u7d20\u81f3\u591a\u53ea\u548c\u96c6\u5408 $B$ \u7684\u4e00\u4e2a\u5143\u7d20\u5bf9\u5e94\uff1b\n\u4ece\u6bcf\u4e00\u70b9\u5f15\u51fa\u7684\u7bad\u5934\u4e0d\u591a\u4e8e\u4e00\u4e2a\u3002"
    },
    {
      "block": 5,
      "text": "\u5b9a\u4e49\uff1a\u5982\u679c\u4e24\u4e2a\u96c6\u5408\u7684\u5143\u7d20\u95f4\u7684\u5173\u7cfb\uff0c\u4f7f\u7b2c\u4e00\u4e2a\u96c6\u5408\u7684\u6bcf\u4e00\u4e2a\u5143\u7d20\u81f3\u591a\u53ea\u548c\u7b2c\u4e8c\u4e2a\u96c6\u5408\u7684\u4e00\u4e2a\u5143\u7d20\u5bf9\u5e94\uff0c\u90a3\u4e48\u8fd9\u79cd\u5173\u7cfb\u53eb\u505a\u51fd\u6570\u3002"
    },
    {
      "block": 7,
      "text": "\u51fd\u6570\u662f\u4e00\u79cd\u5173\u7cfb\uff1a\u5b9a\u4e49\u57df\u4e2d\u7684\u6bcf\u4e00\u4e2a\u5143\u7d20\uff0c\u90fd\u548c\u503c\u57df\u4e2d\u552f\u4e00\u7684\u4e00\u4e2a\u5143\u7d20\u5bf9\u5e94\u3002"
    },
    {
      "block": 8,
      "text": "\u5982\u679c\u4e00\u79cd\u5173\u7cfb\u662f\u51fd\u6570\uff0c\u90a3\u4e48\u5173\u7cfb\u7684\u5b9a\u4e49\u57df\u53eb\u505a\u51fd\u6570\u7684\u5b9a\u4e49\u57df\uff0c\u5173\u7cfb\u7684\u503c\u57df\u53eb\u505a\u51fd\u6570\u7684\u503c\u57df\u3002"
    },
    {
      "block": 10,
      "text": "\u5b9a\u4e49\u57df\u662f $X$\u3001\u503c\u57df\u662f $Y$ \u7684\u51fd\u6570\uff0c\u4e5f\u53eb\u505a\u96c6\u5408 $X$ \u5230\u96c6\u5408 $Y$ \u4e0a\u7684\u6620\u5c04\u3002"
    },
    {
      "block": 14,
      "text": "\u4e00\u822c\u5730\uff0c\u5982\u679c $x$ \u662f\u51fd\u6570 $f$ \u5b9a\u4e49\u57df\u4e2d\u7684\u4efb\u610f\u4e00\u4e2a\u5143\u7d20\uff0c$y$ \u662f\u51fd\u6570\u503c\u57df\u4e2d\u548c\u5b83\u5bf9\u5e94\u7684\u5143\u7d20\uff0c\u90a3\u4e48\u8bb0\u4f5c\uff1a\n$f(x)=y$\u3002\n\u4e5f\u53ef\u4ee5\u5199\u6210\uff1a\n$\\displaystyle x\\xrightarrow{f}y$\u3002"
    }
  ],
