  "exercises": [
    {
      "number": "437",
      "text": "\u4e0b\u5217\u542b\u4e24\u4e2a\u53d8\u91cf\u7684\u65b9\u7a0b\u4e2d\uff0c\u54ea\u4e9b\u662f\u7ebf\u6027\u65b9\u7a0b\uff1f\na) $3x-y=1.7$\uff1b\nb) $1.5x+y^2=12$\uff1b\nc) $0x+6y=11.9$\uff1b\nd) $0x+0y=0$\u3002",
      "figure_ids": []
    },
    {
      "number": "438",
      "text": "\u4f5c\u4e0b\u5217\u7ebf\u6027\u65b9\u7a0b\u7684\u56fe\u8c61\uff1a\na) $x+y=6$\uff1b\nb) $2x-y=8$\uff1b\nc) $x-y-1=0$\uff1b\nd) $4-3x+y=0$\uff1b\ne) $5x+0y=15$\uff1b\nf) $0x+3y=12$\u3002\u8fd9\u4e9b\u65b9\u7a0b\u7ed9\u51fa\u7684\u662f\u7ebf\u6027\u51fd\u6570 $x\\xrightarrow{f}y$ \u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "439",
      "text": "\u4e0d\u4f5c\u56fe\uff0c\u6c42\u4e0b\u5217\u65b9\u7a0b\u7684\u56fe\u8c61\u548c\u5750\u6807\u8f74\u4ea4\u70b9\u7684\u5750\u6807\uff1a\na) $3x+2y=6$\uff1b\nb) $x-5y=12$\u3002",
      "figure_ids": []
    },
    {
      "number": "440",
      "text": "a) \u76f4\u7ebf $3x-2y=5$ \u4e0a\u4e00\u70b9\u7684\u6a2a\u5750\u6807\u662f 0.4\uff0c\u8fd9\u70b9\u7684\u7eb5\u5750\u6807\u662f\u4ec0\u4e48\uff1f\nb) \u76f4\u7ebf $x-2y-1=0$ \u4e0a\u4e00\u70b9\u7684\u7eb5\u5750\u6807\u662f $-0.5$\uff0c\u8fd9\u70b9\u7684\u6a2a\u5750\u6807\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "441",
      "text": "\u6c42\u6570\u8f74\u4e0a\u4e24\u70b9\u95f4\u7684\u8ddd\u79bb\uff1a\na) $A(5)$ \u548c $B(9)$\uff1b\nb) $C(-7)$ \u548c $D(2)$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "$ax+by=c$ \u5f62\u5f0f\u7684\u65b9\u7a0b\uff08\u5176\u4e2d $a$\u3001$b$\u3001$c$ \u662f\u6570\uff0c$x$ \u548c $y$ \u662f\u53d8\u91cf\uff09\uff0c\u53eb\u505a\u4e8c\u5143\u7ebf\u6027\u65b9\u7a0b\uff08\u6216\u4e8c\u5143\u4e00\u6b21\u65b9\u7a0b\uff09\u3002"
    },
    {
      "block": 5,
      "text": "\u5728\u6240\u8ba8\u8bba\u7684\u65b9\u7a0b $ax+by=c$ \u4e2d\uff0c\u8bbe\u7cfb\u6570 $b\\ne0$\u3002\n\u5f53 $b\\ne0$\u65f6\uff0c\u7531\u65b9\u7a0b $ax+by=c$ \u5f97$y=-\\frac{a}{b}x+\\frac{c}{b}$\u3002"
    },
    {
      "block": 6,
      "text": "\u8fd9\u5c31\u662f\u8bf4\uff0c\u5f53 $b\\ne0$ \u65f6\uff0c\u4e0d\u7ba1 $a$\u53d6\u4ec0\u4e48\u503c\uff08\u5305\u62ec $a=0$ \u7684\u60c5\u51b5\uff09\uff0c\u65b9\u7a0b $ax+by=c$ \u8868\u793a\u7684\u662f\u7ebf\u6027\u51fd\u6570\uff0c\u5b83\u7684\u56fe\u8c61\u662f\u76f4\u7ebf\u3002"
    },
    {
      "block": 15,
      "text": "\u5728\u6240\u8ba8\u8bba\u7684\u65b9\u7a0b $ax+by=c$ \u4e2d\uff0c\u8bbe $b=0$\uff0c\u7cfb\u6570 $a\\ne0$\u3002\n\u5f53$b=0$ \u548c $a\\ne0$ \u65f6\uff0c\u65b9\u7a0b $ax+by=c$ \u7684\u56fe\u8c61\u4e5f\u662f\u76f4\u7ebf\u3002"
    },
    {
      "block": 20,
      "text": "\u5982\u679c\u7ebf\u6027\u65b9\u7a0b $ax+by=c$ \u7684\u7cfb\u6570 $a=b=0$\uff0c\u90a3\u4e48\u65b9\u7a0b\u7684\u56fe\u8c61\u4e0d\u662f\u76f4\u7ebf\u3002\n\u56e0\u4e3a\u5f53 $c=0$ \u65f6\uff0c\u65b9\u7a0b\u53d8\u4e3a $0x+0y=0$\uff0c\u4efb\u4f55\u6570\u5bf9\u90fd\u662f\u5b83\u7684\u89e3\uff0c\u6240\u4ee5\u5b83\u7684\u56fe\u8c61\u662f\u6574\u4e2a\u5750\u6807\u5e73\u9762\u3002\n\u5f53 $c\\ne0$ \u65f6\uff0c\u65b9\u7a0b\u65e0\u89e3\uff0c\u5b83\u7684\u56fe\u8c61\u662f\u7a7a\u96c6\u3002"
    }
  ],
