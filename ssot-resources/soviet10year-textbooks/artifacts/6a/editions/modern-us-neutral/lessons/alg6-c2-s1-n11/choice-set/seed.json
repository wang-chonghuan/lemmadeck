  "exercises": [
    {
      "number": "214",
      "text": "\u5982\u56fe 48\uff0c\u7528\u56fe\u8c61\u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u3002\u6839\u636e\u56fe\u8c61\u586b\u8868\uff1a",
      "figure_ids": [
        "tbl-p0061-02",
        "fig-48"
      ]
    },
    {
      "number": "215",
      "text": "\u56fe 49 \u662f\u4e00\u4e2a\u51fd\u6570\u7684\u56fe\u8c61\u3002\u6c42\u8fd9\u4e2a\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df\u3002",
      "figure_ids": [
        "fig-49"
      ]
    },
    {
      "number": "216",
      "text": "\u56fe 50a \u548c\u56fe 50b \u7684\u56fe\u8c61\u7ed9\u51fa\u7684\u5173\u7cfb\u662f\u51fd\u6570\u5417\uff1f",
      "figure_ids": [
        "fig-50"
      ]
    },
    {
      "number": "217",
      "text": "\u56fe 51 \u7684\u56fe\u8c61\u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u3002\u6839\u636e\u56fe\u8c61\u6c42\u4e0b\u8868\u4e2d\u6240\u5217 $x$\u503c\u5bf9\u5e94\u7684 $y$ \u503c\uff1a",
      "figure_ids": [
        "fig-51",
        "tbl-p0062-05"
      ]
    },
    {
      "number": "218",
      "text": "\u7ebf\u6bb5 $AB$\uff08\u56fe 52\uff09\u662f\u4e00\u4e2a\u51fd\u6570\u7684\u56fe\u8c61\u3002$x=-2,0,2,4,6$\u5bf9\u5e94\u7684 $y$ \u503c\u662f\u4ec0\u4e48\uff1f$x$ \u7684\u4ec0\u4e48\u503c\u5bf9\u5e94 $y=5,4.5$\uff1f\u6c42\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df\u3002",
      "figure_ids": [
        "fig-52"
      ]
    },
    {
      "number": "219",
      "text": "\u56fe 53 \u4e0a\u6240\u63cf\u7684\u70b9\u7684\u96c6\u5408\u662f\u51fd\u6570 $f$ \u7684\u56fe\u8c61\u3002\u6839\u636e\u56fe\u8c61\u6c42\na) \u51fd\u6570 $f$ \u7684\u5b9a\u4e49\u57df $X$\uff1b\nb) \u548c $f(x)=0$ \u5bf9\u5e94\u7684 $x\\in X$ \u7684\u503c\u7684\u96c6\u5408\uff1b\nc) \u548c $f(x)<0$ \u5bf9\u5e94\u7684 $x\\in X$ \u7684\u503c\u7684\u96c6\u5408\uff1b\nd) \u548c $f(x)>0$ \u5bf9\u5e94\u7684 $x\\in X$ \u7684\u503c\u7684\u96c6\u5408\u3002",
      "figure_ids": [
        "fig-53"
      ]
    },
    {
      "number": "220",
      "text": "\u51fd\u6570 $g$ \u7684\u56fe\u8c61\u662f\u4e24\u6761\u7ebf\u6bb5\u7684\u5e76\u96c6\uff08\u56fe 54\uff09\u3002\u6839\u636e\u56fe\u8c61\u6c42 $g(-3)$\u3001$g(-2)$\u3001$g(-1)$\u3001$g(0)$\u3001$g(3)$\u3002\u6240\u5f97\u7684\u51fd\u6570\u503c\u6bd4 0 \u5927\uff0c\u8fd8\u662f\u6bd4 0 \u5c0f\uff1f\u6307\u51fa\u51fd\u6570 $g$ \u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df\u3002\u5f53\u51fd\u6570 $g$ \u7b49\u4e8e 0\u3001\u5927\u4e8e 0\u3001\u5c0f\u4e8e 0 \u65f6\uff0c\u5206\u522b\u6c42\u51fa\u76f8\u5e94\u7684 $x$ \u503c\u7684\u96c6\u5408\u3002",
      "figure_ids": [
        "fig-54"
      ]
    },
    {
      "number": "221",
      "text": "\u56fe 55 \u7ed9\u51fa\u7684\u662f\u5b9a\u4e49\u5728\u96c6\u5408 $[-4,7]$ \u4e0a\u7684\u51fd\u6570 $f$ \u7684\u56fe\u8c61\uff0c\u6c42 $f(-4)$\u3001$f(-3)$\u3001$f(0)$\u3001$f(1)$\u3001$f(2)$\u3001$f(4)$\u3001$f(6)$\u3001$f(7)$\u3002\u5f53 $f(x)=0$\u3001$f(x)>0$\u3001$f(x)<0$ \u65f6\uff0c\u5206\u522b\u6c42\u51fa\u76f8\u5e94\u7684 $x$ \u503c\u7684\u96c6\u5408\u3002",
      "figure_ids": [
        "fig-55"
      ]
    },
    {
      "number": "222",
      "text": "\u56fe 56a \u548c 56b \u5206\u522b\u753b\u51fa\u4e86\u4e00\u4e2a\u534a\u5706\u5468\uff0c\u5176\u4e2d\u54ea\u4e00\u4e2a\u662f\u51fd\u6570\u7684\u56fe\u8c61\uff1f",
      "figure_ids": [
        "fig-56"
      ]
    },
    {
      "number": "223",
      "text": "\u56fe 57 \u7684\u56fe\u8c61\u8868\u793a\u7684\u662f\u677e\u6811\u7684\u9ad8\u5ea6\u548c\u5b83\u7684\u5e74\u9f84\uff08\u6811\u9f84\uff09\u4e4b\u95f4\u7684\u5173\u7cfb\u3002\u5229\u7528\u56fe\u8c61\u6c42\uff1a\na) \u6811\u9f84\u5206\u522b\u662f 40 \u5e74\u300190 \u5e74\u65f6\u677e\u6811\u7684\u9ad8\uff1b\nb) \u677e\u6811\u4ece 20 \u5e74\u957f\u5230 60 \u5e74\u3001\u4ece 60 \u5e74\u957f\u5230 100 \u5e74\u589e\u52a0\u7684\u9ad8\u5ea6\u662f\u591a\u5c11\u7c73\uff1f\nc) \u677e\u6811\u9ad8 20 \u7c73\u300127 \u7c73\u300132 \u7c73\u65f6\uff0c\u5b83\u7684\u6811\u9f84\u662f\u591a\u5c11\uff1f\nd) \u6811\u9f84\u662f\u591a\u5c11\u5e74\u65f6\uff0c\u6811\u9ad8\u662f 20 \u5e74\u65f6\u7684\u4e24\u500d\uff1f",
      "figure_ids": [
        "fig-57"
      ]
    },
    {
      "number": "224",
      "text": "\u56fe 47 \u7ed9\u51fa\u7684\u56fe\u8c61\uff0c\u662f\u81ea\u52a8\u8bb0\u5f55\u4eea\u8bb0\u5f55\u7684\u7a7a\u6c14\u6e29\u5ea6\u66f2\u7ebf\u3002\u5229\u7528\u8fd9\u6761\u66f2\u7ebf\u56de\u7b54\u4e0b\u5217\u95ee\u9898\uff1a\na) 4 \u70b9\u300111 \u70b9\u300118 \u70b9\u7684\u6e29\u5ea6\u662f\u591a\u5c11\u5ea6\uff1f\nb) \u4ec0\u4e48\u65f6\u5019\u7684\u6c14\u6e29\u662f $0^\\circ\\mathrm{C}$\uff1f\u4ec0\u4e48\u65f6\u5019\u7684\u6c14\u6e29\u662f $3^\\circ\\mathrm{C}$\uff1f\nc) \u4e00\u663c\u591c\u5f53\u4e2d\u6700\u9ad8\u6e29\u5ea6\u548c\u6700\u4f4e\u6e29\u5ea6\u5206\u522b\u662f\u591a\u5c11\u5ea6\uff1f\nd) \u54ea\u51e0\u6bb5\u65f6\u95f4\u91cc\u6c14\u6e29\u5347\u9ad8\u3001\u964d\u4f4e\u3001\u9ad8\u4e8e $0^\\circ\\mathrm{C}$\u3001\u4f4e\u4e8e $0^\\circ\\mathrm{C}$\uff1f",
      "figure_ids": [
        "fig-47"
      ]
    },
    {
      "number": "225",
      "text": "\u6bcf\u8fc7\u540c\u6837\u957f\u7684\u65f6\u95f4\u6d4b\u91cf\u4e00\u6b21\u6c34\u69fd\u4e2d\u7684\u6c34\u6e29\uff0c\u5f97\u51fa\u4e0b\u8868\uff1a\u4f5c\u51fa $y$ \u5bf9 $x$ \u7684\u4f9d\u8d56\u5173\u7cfb\u7684\u56fe\u8c61\uff08\u6bd4\u4f8b\uff1a$x$ \u8f74\u4e0a\u5355\u4f4d\u957f\u76f8\u5f53\u4e8e 1 \u5206\u949f\uff0c$y$ \u8f74\u4e0a\u5355\u4f4d\u957f\u76f8\u5f53\u4e8e $10^\\circ\\mathrm{C}$\uff09\u3002\u5229\u7528\u56fe\u8c61\u56de\u7b54\u4e0b\u5217\u95ee\u9898\uff1a\na) \u5f00\u59cb\u52a0\u6e29\u4ee5\u540e\u7ecf\u8fc7 4 \u5206\u949f\u6c34\u6e29\u662f\u591a\u5c11\u5ea6\uff1f5.5 \u5206\u949f\u5462\uff1f9 \u5206\u949f\u5462\uff1f10.7 \u5206\u949f\u5462\uff1f\nb) \u5f00\u59cb\u52a0\u6e29\u4ee5\u540e\u7ecf\u8fc7\u51e0\u5206\u949f\u6c34\u6e29\u662f $41^\\circ\\mathrm{C}$\u3001$60^\\circ\\mathrm{C}$\u3001$93^\\circ\\mathrm{C}$\u3001$100^\\circ\\mathrm{C}$\uff1f",
      "figure_ids": [
        "tbl-p0065-01"
      ]
    },
    {
      "number": "226",
      "text": "\u5f0f $y=\\frac{x-2}{5}$ \u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u3002\u8bf4\u660e\u4e0b\u5217\u5404\u70b9\u662f\u5426\u5c5e\u4e8e\u51fd\u6570\u7684\u56fe\u8c61\uff1a$A(7,1),B(-3,-1),C(3,1),D(11,1.8),$ $E(0,0.4)$\u3002",
      "figure_ids": []
    },
    {
      "number": "227",
      "text": "\u4f5c\u51fa\u4e0b\u5217\u6bcf\u4e2a\u51fd\u6570\u56fe\u8c61\u4e0a\u7684\u5341\u4e2a\u70b9\uff1a\na) $y=x(x-3)$\uff1b\nb) $y=4-x^2$\u3002",
      "figure_ids": []
    },
    {
      "number": "228",
      "text": "\u51fd\u6570\u7531\u5f0f $f(x)=1-8x$ \u7ed9\u51fa\u3002\u4e0b\u5217\u547d\u9898\u662f\u4e0d\u662f\u771f\u547d\u9898\uff1f$f(-1)=9,\\quad f\\left(\\frac{1}{2}\\right)=-3,\\quad f(3)=25$\u3002",
      "figure_ids": []
    },
    {
      "number": "229",
      "text": "\u89e3\u65b9\u7a0b\uff1a\na) $\\frac{x}{22.2}=\\frac{5}{37}$\uff1b\nb) $\\frac{3.4}{x}=\\frac{0.17}{1.5}$\u3002",
      "figure_ids": []
    },
    {
      "number": "230",
      "text": "a) \u706b\u8f66\u7684\u901f\u5ea6\u662f 72 \u516c\u91cc/\u5c0f\u65f6\u3002\u7528\u6bcf\u79d2\u591a\u5c11\u7c73\u8868\u793a\u706b\u8f66\u7684\u901f\u5ea6\u3002\nb) \u81ea\u884c\u8f66\u7684\u901f\u5ea6\u662f 5 \u7c73/\u79d2\u3002\u7528\u6bcf\u5c0f\u65f6\u591a\u5c11\u516c\u91cc\u8868\u793a\u81ea\u884c\u8f66\u7684\u901f\u5ea6\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 3,
      "text": "\u8fd8\u53ef\u4ee5\u7528\u56fe\u8c61\u8bf4\u660e\u5173\u7cfb $g$ \u4e3a\u4ec0\u4e48\u662f\u51fd\u6570\uff1a\u5173\u7cfb $g$ \u56fe\u8c61\u4e0a\u7684\u70b9\u5177\u6709\u4e0d\u540c\u7684\u6a2a\u5750\u6807\uff0c\u4e5f\u5c31\u662f\u8bf4\uff0c\u6bcf\u4e00\u6a2a\u5750\u6807\u53ea\u5bf9\u5e94\u552f\u4e00\u7684\u4e00\u4e2a\u7eb5\u5750\u6807\u3002"
    },
    {
      "block": 4,
      "text": "\u4e00\u822c\u5730\uff0c\u5982\u679c\u56fe\u8c61\u4e0a\u6ca1\u6709\u6a2a\u5750\u6807\u76f8\u540c\u7684\u70b9\uff0c\u4ea6\u5373\u6bcf\u4e00\u6a2a\u5750\u6807\u53ea\u5bf9\u5e94\u552f\u4e00\u7684\u4e00\u4e2a\u7eb5\u5750\u6807\uff0c\u90a3\u4e48\u8fd9\u4e2a\u56fe\u8c61\u7ed9\u51fa\u7684\u5173\u7cfb\u5c31\u662f\u51fd\u6570\u3002"
    },
    {
      "block": 10,
      "text": "\u5982\u679c\u5173\u7cfb\u662f\u51fd\u6570\uff0c\u5173\u7cfb\u7684\u56fe\u8c61\u53eb\u505a\u51fd\u6570\u7684\u56fe\u8c61\u3002"
    },
    {
      "block": 18,
      "text": "\u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\uff0c\u901a\u5e38\u603b\u662f\u5148\u5217\u51fa\u6570\u5bf9\u6216\u8005\u5199\u51fa\u8868\u793a\u5f0f\uff0c\u7136\u540e\u518d\u4f5c\u51fa\u51fd\u6570\u7684\u56fe\u8c61\u3002"
    }
  ],
