    {
      "kind": "p",
      "text": "给出一个函数，通常总是先列出数对或者写出表示式，然后再作出函数的图象。",
      "id": null,
      "label": null,
      "printed_page": 55,
      "source_text": "给出一个函数，通常总是先列出数对或者写出表示式，然后再作出函数的图象。",
