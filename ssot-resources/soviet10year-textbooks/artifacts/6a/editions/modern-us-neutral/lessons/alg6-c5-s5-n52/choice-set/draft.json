        {"id": "i", "text": "$(a^2-3)(a^2+3)=a^2-9$", "figure_ids": []},
        {"id": "j", "text": "$(11+b^3)(11-b^3)=121-b^6$", "figure_ids": []},
        {"id": "k", "text": "$(a^3-x^2)(a^3+x^2)=a^6-x^4$", "figure_ids": []},
        {"id": "l", "text": "$(2x^5-y)(2x^5+y)=4x^{10}-y^2$", "figure_ids": []}
      ]},
      "intent": {"task": "逐式识别共同项、平方系数和幂次，判断十二个完整乘法关系。", "source_solution": "a a²-x²；b b²-a²；c p²-49；d4x²-1；e25y²-16；f64c²-9；g100a²-9b²；h144y²-25z²；i a⁴-9；j121-b⁶；k a⁶-x⁴；l4x¹⁰-y²。", "unit_reason": "同一平方差变换任务采用自然多选，每个原式都出现；不按两个结果项拆成计算点击。", "concept_blocks": [2, 3, 5], "limitations": ["不能证明自主写出十二个结果或改正错误等式。"], "figure_observations": []},
      "key": {"correct": ["a", "e", "f", "h", "j", "k", "l"], "rationales": [
        {"option_id": "a", "truth": "correct", "derivation": "共同项a、另一项x，平方差a²-x²。", "misconception": null},
        {"option_id": "b", "truth": "incorrect", "derivation": "误用(A+B)(A-B)=A²+B²，把负平方项变成正项。", "misconception": "把平方差规则写成平方和。"},
        {"option_id": "c", "truth": "incorrect", "derivation": "把7²错误保留为7，得到p²-7而非p²-49。", "misconception": "常数没有平方。"},
        {"option_id": "d", "truth": "incorrect", "derivation": "对2x只平方x，错误得到2x²而不是4x²。", "misconception": "单项式平方时漏平方系数。"},
        {"option_id": "e", "truth": "correct", "derivation": "(5y)²-4²=25y²-16。", "misconception": null},
        {"option_id": "f", "truth": "correct", "derivation": "(8c)²-3²=64c²-9。", "misconception": null},
        {"option_id": "g", "truth": "incorrect", "derivation": "对3b只平方b，故错写减3b²；正确减9b²。", "misconception": "平方系数遗漏。"},
        {"option_id": "h", "truth": "correct", "derivation": "(12y)²-(5z)²=144y²-25z²。", "misconception": null},
        {"option_id": "i", "truth": "incorrect", "derivation": "把(a²)²误作a²，实际指数相乘得a⁴。", "misconception": "嵌套乘方未乘指数。"},
        {"option_id": "j", "truth": "correct", "derivation": "共同项11给121，(b³)²=b⁶。", "misconception": null},
        {"option_id": "k", "truth": "correct", "derivation": "(a³)²-(x²)²=a⁶-x⁴。", "misconception": null},
        {"option_id": "l", "truth": "correct", "derivation": "(2x⁵)²-y²=4x¹⁰-y²。", "misconception": null}
      ]}
    },
    {
