        {"option_id": "d", "truth": "incorrect", "derivation": "只平方c不平方2/3，得到错误减项2c²/3。", "misconception": "分数系数未平方。"},
        {"option_id": "e", "truth": "correct", "derivation": "(2/7)²=4/49。", "misconception": null},
        {"option_id": "f", "truth": "correct", "derivation": "15²a⁴-2²=225a⁴-4。", "misconception": null},
        {"option_id": "g", "truth": "incorrect", "derivation": "把0.8b³当作共同项，颠倒减法顺序；共同项实为1。", "misconception": "未辨共同项而按首项位置套平方差。"},
        {"option_id": "h", "truth": "correct", "derivation": "共同项5，25-(0.2xy)²=25-0.04x²y²。", "misconception": null},
        {"option_id": "i", "truth": "incorrect", "derivation": "共同项by，正确为(by)²-(ay²)²；误交换减法得到候选。", "misconception": "把被减项和减项交换。"},
        {"option_id": "j", "truth": "correct", "derivation": "(c²)²-(3c³)²=c⁴-9c⁶。", "misconception": null},
        {"option_id": "k", "truth": "incorrect", "derivation": "平方分母2但漏对n²再平方，错得n²/4而非n⁴/4。", "misconception": "嵌套幂未平方。"},
        {"option_id": "l", "truth": "incorrect", "derivation": "按第一因式首项x²/3套共同项，颠倒两平方；实际共同项x/2。", "misconception": "忽略第二因式减法顺序。"}
      ]}
