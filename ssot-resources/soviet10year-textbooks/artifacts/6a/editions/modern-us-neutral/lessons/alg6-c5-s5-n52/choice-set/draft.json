        {"id": "d", "text": "$(2x-1)(2x+1)=2x^2-1$", "figure_ids": []},
        {"id": "e", "text": "$(5y+4)(5y-4)=25y^2-16$", "figure_ids": []},
        {"id": "f", "text": "$(8c-3)(8c+3)=64c^2-9$", "figure_ids": []},
