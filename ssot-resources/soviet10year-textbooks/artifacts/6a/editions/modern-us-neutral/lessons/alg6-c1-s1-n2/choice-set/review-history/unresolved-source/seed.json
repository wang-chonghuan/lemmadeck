  "exercises": [
    {
      "number": "13",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\na) $9a(a-8)+135,\\ a=3$\uff1b\nb) $(p+0.6)(p-0.6),\\ p=0.2$\uff1b\nc) $k+\\frac{2}{3}(k-\\frac{2}{3}),\\ k=\\frac{1}{6}$\uff1b\nd) $(3m+6)n,\\ m=-\\frac{1}{3},\\ n=1.2$\uff1b\ne) $\\frac{a}{b}+3c,\\ a=10,\\ b=5,\\ c=-\\frac{1}{3}$\uff1b\nf) $(a+b)(b+c)(c+d)(d+e),$ $a=0,\\ b=1,\\ c=2,\\ d=3,\\ e=4$.",
      "figure_ids": []
    },
    {
      "number": "14",
      "text": "\u53d8\u91cf $x$ \u7684\u503c\u7b49\u4e8e $-3$\uff0c\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n(1) $(2x-5)x+5$\uff1b\n(2) $(2x-5)(x+5)$.",
      "figure_ids": []
    },
    {
      "number": "15",
      "text": "\u586b\u8868\uff1a\na)\nb)",
      "figure_ids": [
        "tbl-p0012-01",
        "tbl-p0012-02"
      ]
    },
    {
      "number": "16",
      "text": "\u5df2\u77e5 $b=-3,-1,0,1,3$\uff0c\u6c42\u5f0f $b^2-9$ \u7684\u503c\u3002\u5bf9\u4e8e\u53d8\u91cf $b$\u6240\u53d6\u7684\u503c\uff0c\u5f0f\u7684\u503c\u7684\u96c6\u5408\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "17",
      "text": "\u5df2\u77e5 $x\\in Z$\uff08$Z$ \u8868\u793a\u6574\u6570\u96c6\uff09\uff0c\u6c42\u5f0f $(2x+4.3)\\times0$ \u7684\u503c\u7684\u96c6\u5408\u3002",
      "figure_ids": []
    },
    {
      "number": "18",
      "text": "\u6c42\u5f0f $a^2-2ab$ \u7684\u503c\uff1a\na) $a=5,\\ b=2$\uff1b\nb) $a=2,\\ b=5$.",
      "figure_ids": []
    },
    {
      "number": "19",
      "text": "\u5df2\u77e5\u53d8\u91cf $m$ \u548c $n$ \u7684\u503c\u6240\u7ec4\u6210\u7684\u6570\u5bf9 $(m,n)$ \u5982\u4e0b\uff0c\u6c42\u5f0f$3m-2n$ \u7684\u503c\uff1a\na) $(5,3)$\uff1b\nb) $(0,1)$\uff1b\nc) $(2,4)$\uff1b\nd) $(4,2)$.",
      "figure_ids": []
    },
    {
      "number": "20",
      "text": "\u5199\u51fa\u56fe 2 \u4e2d\u70b9 $A,B,C,D,E$ \u7684\u5750\u6807\u7ec4\u6210\u7684\u6570\u5bf9\u3002",
      "figure_ids": [
        "fig-02"
      ]
    },
    {
      "number": "21",
      "text": "\u56fe 3 \u662f\u56fd\u9645\u8c61\u68cb\u7684\u68cb\u76d8\uff0c\u5b83\u7684\u6bcf\u4e00\u683c\u53ef\u4ee5\u7528\u4e00\u4e2a\u5b57\u6bcd\u548c\u4e00\u4e2a\u6570\u7ec4\u6210\u7684\u6570\u5bf9\u8868\u793a\u3002\u4f8b\u5982\uff0c\u53f3\u4e0a\u89d2\u7684\u65b9\u683c\u662f $(h,8)$\uff0c\u901a\u5e38\u7b80\u5355\u8bb0\u4f5c $h8$\u3002\u5de6\u4e0b\u89d2\u7684\u65b9\u683c\u8bb0\u4f5c $a1$\u3002\u5199\u51fa\u8868\u793a\u4e0b\u5217\u5404\u65b9\u683c\u7684\u6570\u5bf9\u7684\u96c6\u5408\uff1a\n(1) \u4ece\u5de6\u4e0b\u89d2\u5230\u53f3\u4e0a\u89d2\u7684\u5bf9\u89d2\u7ebf\u4e0a\u5404\u65b9\u683c\uff1b\n(2) \u4ece\u5de6\u4e0a\u89d2\u5230\u53f3\u4e0b\u89d2\u7684\u5bf9\u89d2\u7ebf\u4e0a\u5404\u65b9\u683c\u3002",
      "figure_ids": [
        "fig-03"
      ]
    },
    {
      "number": "22",
      "text": "\u5b66\u6821\u5c0f\u5403\u90e8\u7684\u65e9\u9910\u6709\u4e24\u9053\u996d\u83dc\uff1a\u7b2c\u4e00\u9053\uff1a\u8089\u997c\uff0c\u7a00\u996d\uff0c\u9178\u5976\u3002\u7b2c\u4e8c\u9053\uff1a\u8336\uff0c\u751c\u716e\u6c34\u679c\uff0c\u679c\u6c41\uff0c\u725b\u5976\u3002\u7531\u8fd9\u4e9b\u996d\u83dc\u53ef\u4ee5\u914d\u6210\u51e0\u79cd\u65e9\u9910\u5403\u6cd5\uff1f\u7528\u6570\u5bf9\u7684\u96c6\u5408\u7684\u5f62\u5f0f\u5199\u51fa\u7b54\u6848\u3002",
      "figure_ids": []
    },
    {
      "number": "23",
      "text": "a) \u4e0b\u8868\u4e2d\uff0c\u9876\u4e0a\u4e00\u884c\u5217\u51fa\u4e86 $x$ \u7684\u503c\uff0c\u53f3\u8fb9\u4e00\u884c\u5217\u51fa\u4e86 $y$\u7684\u503c\u3002\u5728\u7a7a\u683c\u5904\u586b\u5165\u5f0f $x+y$ \u7684\u503c\uff1a\u5bf9\u5e94\u4e8e\u53d8\u91cf $x$ \u548c $y$ \u7684\u6240\u7ec4\u6210\u7684\u6570\u5bf9\uff0c\u5f0f $x+y$ \u7684\u503c\u7684\u96c6\u5408\u662f\u4ec0\u4e48\uff1f\nb) \u5982\u679c\u5f0f\u662f $xy$\uff0c\u89e3\u7b54\u4e0a\u9762\u6240\u63d0\u95ee\u9898\u3002",
      "figure_ids": [
        "tbl-p0014-01"
      ]
    },
    {
      "number": "24",
      "text": "a) \u586b\u8868\uff1a\nb) \u5df2\u77e5\u5f53\u53d8\u91cf $a$ \u548c $b$ \u53d6\u4e00\u5bf9\u503c\u65f6\uff0c\u5f0f $a-2b$ \u7684\u503c\u662f1.8\u3002\u5f53\u53d8\u91cf $a$ \u548c $b$ \u4ecd\u53d6\u8fd9\u4e00\u5bf9\u503c\u65f6\uff0c\u5f0f $2b-a$ \u53d6\u4ec0\u4e48\u503c\u5462\uff1f",
      "figure_ids": [
        "tbl-p0014-02"
      ]
    },
    {
      "number": "25",
      "text": "\u5f53 $y$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u4e0b\u5217\u5404\u5f0f\u6ca1\u6709\u610f\u4e49\uff1f\na) $\\frac{1}{y-7}$\uff1b\nb) $\\frac{7y}{3+y}$\uff1b\nc) $\\frac{18}{y}$\uff1b\nd) $\\frac{2y+14}{2y-14}$.",
      "figure_ids": []
    },
    {
      "number": "26",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u5b9a\u4e49\u57df\uff1a\na) $\\frac{12}{x-4}$\uff1b\nb) $\\frac{3a}{2-a}$\uff1b\nc) $\\frac{b+7}{b}$\uff1b\nd) $5(y+2)$\uff1b\ne) $\\frac{12x+7}{10}$.",
      "figure_ids": []
    },
    {
      "number": "27",
      "text": "a) \u627e\u51fa\u53d8\u91cf $a$ \u548c $b$ \u7684\u4e00\u5bf9\u6570\u503c\uff0c\u5206\u522b\u4f7f\u4e0b\u5217\u5404\u5f0f\u6ca1\u6709\u610f\u4e49\uff1a1) $\\frac{17}{a-b}$\uff1b\u3000\u30002) $\\frac{34}{a+b}$\uff1b\u3000\u30003) $\\frac{4}{a-2b}$\uff1b\u3000\u30004) $\\frac{6a}{2b+a}$.b) \u6307\u51fa\u4f7f\u4e0b\u5217\u5f0f\u5b50\u6709\u610f\u4e49\u65f6\u53d8\u91cf $m$ \u548c $n$ \u7684\u503c\u6240\u7ec4\u6210\u7684\u6570\u5bf9\u96c6\u5408\uff1a1) $\\frac{57}{m-n}$\uff1b\u3000\u3000\u3000\u3000\u30002) $-\\frac{128}{m+n}$.",
      "figure_ids": []
    },
    {
      "number": "28",
      "text": "\u7528\u5217\u51fa\u5143\u7d20\u7684\u65b9\u6cd5\u7ed9\u51fa\u96c6\u5408\uff1a\na) $\\{x\\mid x\\in N,\\ x<13\\}$\uff1b\nb) $\\{a\\mid a\\in Z,\\ -5<a<5\\}$\uff1b\nc) $\\{p\\mid p\\in N,\\ p\\text{ \u662f }12\\text{ \u7684\u56e0\u6570}\\}$\uff1b\nd) $\\{y\\mid y\\in Z,\\ |y|=8\\}$.",
      "figure_ids": []
    },
    {
      "number": "29",
      "text": "\u4e0b\u9762\u53d8\u91cf $x$ \u548c $y$ \u7684\u503c\u6240\u7ec4\u6210\u7684\u6570\u5bf9\u5c5e\u4e8e\u96c6\u5408$\\{(x,y)\\mid x<y\\}$ \u5417\uff1f\na) $(7,11)$\uff1b\nb) $(3,8)$\uff1b\nc) $(-3,-4)$\uff1b\nd) $(\\frac{1}{4},\\frac{1}{3})$.",
      "figure_ids": []
    },
    {
      "number": "30",
      "text": "\u56fe 4 \u4e0a\u753b\u51fa\u4e86 $A,B,C,D,E,F$ \u516d\u70b9\u3002\na) \u54ea\u4e9b\u70b9\u7684\u6a2a\u5750\u6807\u662f\u6b63\u7684\uff1f\nb) \u54ea\u4e9b\u70b9\u7684\u6a2a\u5750\u6807\u662f\u8d1f\u7684\uff1f\nc) \u54ea\u4e9b\u70b9\u7684\u7eb5\u5750\u6807\u662f\u6b63\u7684\uff1f\nd) \u54ea\u4e9b\u70b9\u7684\u7eb5\u5750\u6807\u662f\u8d1f\u7684\uff1f",
      "figure_ids": [
        "fig-04"
      ]
    },
    {
      "number": "31",
      "text": "\u5df2\u77e5\u77e9\u5f62 $ABCD$ \u7684\u4e09\u4e2a\u9876\u70b9\u7684\u5750\u6807\u662f\uff1a$A(-2,1),\\ B(-2,4),\\ C(3,4)$\uff0c\u4f5c\u77e9\u5f62\uff0c\u5e76\u5199\u51fa\u53e6\u4e00\u4e2a\u9876\u70b9\u7684\u5750\u6807\u3002\u6c42\u77e9\u5f62\u7684\u9762\u79ef\u3002",
      "figure_ids": []
    },
    {
      "number": "32",
      "text": "\u8ba1\u7b97\uff1a\na) $\\frac{36\\times77}{12}$\uff1b\nb) $\\frac{35\\times150}{125}$\uff1b\nc) $\\frac{23\\times0.18}{9}$.",
      "figure_ids": []
    },
    {
      "number": "33",
      "text": "a) \u4e0a\u4e00\u671f\uff0c\u4e24\u4e2a\u519c\u4e1a\u5408\u4f5c\u793e\u5171\u8d2d\u7f6e\u4e8644 \u4e07 9 \u5343\u53f0\u8c37\u7269\u8054\u5408\u6536\u5272\u673a\u3002\u4e0b\u4e00\u671f\u8ba1\u5212\u8d2d\u7f6e\u7684\u8c37\u7269\u8054\u5408\u6536\u5272\u673a\u8fd8\u8981\u591a 20%\u3002\u4e0b\u4e00\u671f\u5c06\u8d2d\u7f6e\u591a\u5c11\u53f0\u8c37\u7269\u8054\u5408\u6536\u5272\u673a\uff1f\nb) 1975 \u5e74\u67d0\u5730\u533a\u7684\u94a2\u4ea7\u91cf\u662f 1.41 \u4ebf\u5428\u30021980 \u5e74\u9884\u8ba1\u94a2\u4ea7\u91cf\u7ea6 1.70 \u4ebf\u5428\u3002\u5230 1980 \u5e74\u94a2\u4ea7\u91cf\u5c06\u589e\u52a0\u767e\u5206\u4e4b\u51e0\uff1f",
