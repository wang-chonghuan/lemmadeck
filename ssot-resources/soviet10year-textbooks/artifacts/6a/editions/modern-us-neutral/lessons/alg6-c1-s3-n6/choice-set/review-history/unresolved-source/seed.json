  ],
  "concepts": [
    {
      "block": 7,
      "text": "\u6211\u4eec\u770b\u5230\uff0c\u5f53\u8ba8\u8bba\u4e00\u79cd\u5173\u7cfb\u65f6\uff0c\u603b\u8981\u6d89\u53ca\u5230\u5904\u4e8e\u8fd9\u79cd\u5173\u7cfb\u5f53\u4e2d\u7684\u4e24\u4e2a\u5143\u7d20\uff08\u5143\u7d20\u5bf9\uff09\u3002"
    },
    {
      "block": 28,
      "text": "\u4e0a\u9762\u6211\u4eec\u8ba8\u8bba\u4e86\u4e00\u4e2a\u6216\u8005\u4e24\u4e2a\u96c6\u5408\u5143\u7d20\u95f4\u7684\u4e0d\u540c\u7684\u5173\u7cfb\u7684\u56db\u4e2a\u4f8b\u5b50\u3002\n\u4ece\u8ba8\u8bba\u4e2d\u53ef\u4ee5\u770b\u51fa\uff0c\u6bcf\u4e00\u79cd\u5173\u7cfb\u90fd\u53ef\u4ee5\u7528\u6ee1\u8db3\u8fd9\u79cd\u5173\u7cfb\u7684\u5143\u7d20\u5bf9\u7684\u96c6\u5408\u6765\u5b9a\u4e49\u3002\n\u5143\u7d20\u5bf9\u4e2d\u524d\u4e00\u4e2a\u5143\u7d20\u7684\u96c6\u5408\u53eb\u505a\u5173\u7cfb\u7684\u5b9a\u4e49\u57df\uff0c\u540e\u4e00\u4e2a\u5143\u7d20\u7684\u96c6\u5408\u53eb\u505a\u5173\u7cfb\u7684\u503c\u57df\u3002"
