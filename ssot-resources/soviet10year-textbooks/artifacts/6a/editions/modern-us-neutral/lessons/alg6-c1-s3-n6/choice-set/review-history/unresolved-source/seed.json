  "exercises": [
    {
      "number": "87",
      "text": "\u56fe 19 \u4e2d\u7528\u7bad\u5934\u53f7\u8868\u793a\u96c6\u5408 $\\{1,2,3,4\\}$ \u7684\u5143\u7d20\u95f4\u7684\u4e00\u79cd\u5173\u7cfb\u3002\u54ea\u4e00\u4e2a\u5143\u7d20\u548c\u5143\u7d20 2 \u6709\u8fd9\u79cd\u5173\u7cfb\uff1f\u548c\u5143\u7d20 3 \u5462\uff1f\u548c\u5143\u7d20 4 \u5462\uff1f\u5199\u51fa\u6709\u8fd9\u79cd\u5173\u7cfb\u7684\u6240\u6709\u7684\u5143\u7d20\u5bf9\u3002",
      "figure_ids": [
        "fig-19"
      ]
    },
    {
      "number": "88",
      "text": "\u8bbe $a,b,c$ \u662f\u6570\u3002\u7528\u7bad\u5934\u53f7\u8868\u793a\u5b83\u4eec\u4e4b\u95f4\u7684\u5173\u7cfb\u201c\u5c0f\u4e8e\u6216\u7b49\u4e8e\u201d\uff08\u56fe 20\uff09\u3002\u4e0b\u5217\u547d\u9898\u662f\u4e0d\u662f\u771f\u547d\u9898\uff1f\na) $a\\le b$\uff1b\nb) $c\\le a$\uff1b\nc) $b\\le c$\u3002",
      "figure_ids": [
        "fig-20"
      ]
    },
    {
      "number": "89",
      "text": "\u56fe 21 \u4e2d\u7528\u7bad\u5934\u8868\u793a Alex\u3001Ben\u3001Chris \u548c Dana \u56db\u4e2a\u5b69\u5b50\u4e4b\u95f4\u7684\u201c\u5e74\u9f84\u5927\u4e8e\u201d\u5173\u7cfb\u3002Alex \u548c Ben \u8c01\u5e74\u9f84\u5927\uff1f\u54ea\u4e2a\u5b69\u5b50\u6bd4 Chris \u5e74\u9f84\u5927\uff1f",
      "figure_ids": [
        "fig-21"
      ]
    },
    {
      "number": "90",
      "text": "\u96c6\u5408 $M=\\{5,7,10,14,20\\}$ \u7684\u5143\u7d20\u95f4\u7684\u5173\u7cfb\u7528\u4e0b\u5217\u8bed\u53e5\u7ed9\u51fa\uff1a\na) $x$ \u7b49\u4e8e $y$ \u7684\u4e24\u500d\uff0c\u5176\u4e2d $x\\in M,y\\in M$\uff1b\nb) $x$ \u80fd\u88ab $y$ \u6574\u9664\uff0c\u5176\u4e2d $x\\in M,y\\in M$\u3002\u7528\u7bad\u5934\u53f7\u8868\u793a\u8fd9\u79cd\u5173\u7cfb\u3002",
      "figure_ids": []
    },
    {
      "number": "91",
      "text": "\u8bed\u53e5\u201c$x$ \u662f $y$ \u7684\u7ea6\u6570\u201d\uff08\u5176\u4e2d $x\\in N,y\\in N$\uff09\u7ed9\u51fa\u4e86\u81ea\u7136\u6570\u4e4b\u95f4\u7684\u4e00\u79cd\u5173\u7cfb\u3002\u8bf4\u51fa\u51e0\u4e2a\u5177\u6709\u8fd9\u79cd\u5173\u7cfb\u7684\u81ea\u7136\u6570\u5bf9\u3002\u7b2c\u4e00\u4e2a\u5143\u7d20\u662f 5\uff0c\u6307\u51fa\u4e09\u4e2a\u6570\u5bf9 $(x,y)$ \u6765\u3002\u7b2c\u4e8c\u4e2a\u5143\u7d20\u662f12\uff0c\u5199\u51fa\u6240\u6709\u8fd9\u79cd\u6570\u5bf9\u6765\u3002",
      "figure_ids": []
    },
    {
      "number": "92",
      "text": "\u8bbe $A=\\{$Hudson River\uff0cMississippi River\uff0cRio Grande\uff0cColumbia River\uff0cColorado River$\\}$ \u662f\u6cb3\u6d41\u7684\u96c6\u5408\uff0c$B=\\{$Atlantic Ocean\uff0cGulf of Mexico\uff0cPacific Ocean$\\}$ \u662f\u6c34\u57df\u7684\u96c6\u5408\u3002\u8bed\u53e5\u201c\u6cb3 $x$ \u6d41\u5165\u6c34\u57df $y$\u201d\uff08\u5176\u4e2d $x\\in A,y\\in B$\uff09\u7ed9\u51fa\u4e86\u96c6\u5408 $A$ \u548c $B$ \u7684\u5143\u7d20\u95f4\u7684\u4e00\u79cd\u5173\u7cfb\u3002\u5199\u51fa\u8fd9\u79cd\u5173\u7cfb\u7684\u5143\u7d20\u5bf9\u7684\u96c6\u5408\u3002",
      "figure_ids": []
    },
    {
      "number": "93",
      "text": "Alice\u3001Ben\u3001Chloe \u548c Daniel \u5236\u4f5c\u4e86\u4e00\u5468\u7684\u503c\u65e5\u8868\uff1a\u5728\u5b66\u751f\u96c6\u5408 $\\{$Alice\uff0cBen\uff0cChloe\uff0cDaniel$\\}$ \u7684\u5143\u7d20\u548c\u6bcf\u5468\u6559\u5b66\u65e5\u96c6\u5408 $\\{$\u661f\u671f\u4e00\uff0c\u661f\u671f\u4e8c\uff0c\u661f\u671f\u4e09\uff0c\u661f\u671f\u56db\uff0c\u661f\u671f\u4e94\uff0c\u661f\u671f\u516d$\\}$ \u7684\u5143\u7d20\u4e4b\u95f4\uff0c\u8fd9\u5f20\u8868\u786e\u5b9a\u4e86\u4e00\u79cd\u5173\u7cfb\u3002\u7528\u7bad\u5934\u53f7\u8868\u793a\u8fd9\u79cd\u5173\u7cfb\u3002",
      "figure_ids": [
        "tbl-p0032-01"
      ]
    },
    {
      "number": "94",
      "text": "\u56fe 22 \u4e2d\u7528\u7bad\u5934\u53f7\u7ed9\u51fa\u4e86\u4e00\u79cd\u5173\u7cfb\u3002\u8bf4\u51fa\u96c6\u5408 $X$ \u548c $Y$ \u7684\u5143\u7d20\u3002\u54ea\u4e00\u4e2a\u5143\u7d20\u548c\u5143\u7d20 $a$ \u5bf9\u5e94\uff08\u5373\u54ea\u4e00\u4e2a\u5143\u7d20\u548c\u5143\u7d20$a$ \u6709\u5df2\u77e5\u7684\u5173\u7cfb\uff09\uff1f\u5143\u7d20 $a,b,c$ \u5206\u522b\u548c\u51e0\u4e2a\u5143\u7d20\u5bf9\u5e94\uff1f",
      "figure_ids": [
        "fig-22"
      ]
    },
    {
      "number": "95",
      "text": "\u7814\u7a76\u56fe 23 \u4e2d\u7528\u7bad\u5934\u53f7\u8868\u793a\u7684\u5173\u7cfb\u300270\u3001140\u300148 \u548c\u54ea\u4e2a\u6570\u5206\u522b\u5bf9\u5e94\uff1f\u54ea\u4e2a\u6570\u5206\u522b\u548c 35\u300115\u300112 \u5bf9\u5e94\uff1f\u6307\u51fa\u8fd9\u4e2a\u5173\u7cfb\u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df\u3002",
      "figure_ids": [
        "fig-23"
      ]
    },
    {
      "number": "96",
      "text": "\u56fe 24 \u4e2d\u7528\u7bad\u5934\u53f7\u5206\u522b\u8868\u793a\u96c6\u5408 $X$ \u548c $Y$ \u7684\u5143\u7d20\u95f4\u7684\u51e0\u79cd\u5173\u7cfb\u3002\u4e3a\u4e86\u628a\u8fd9\u51e0\u79cd\u5173\u7cfb\u52a0\u4ee5\u533a\u522b\uff0c\u5206\u522b\u7528\u5b57\u6bcd $f,p$ \u548c$q$ \u8868\u793a\u3002\u5173\u7cfb $f,p$ \u548c $q$ \u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df\u662f\u4ec0\u4e48\uff1f\u6307\u51fa\u96c6\u5408 $X$ \u4e2d\u81f3\u5c11\u6709\u4e00\u4e2a\u5143\u7d20\u548c\u96c6\u5408 $Y$ \u4e24\u4e2a\u4ee5\u4e0a\u5143\u7d20\u5bf9\u5e94\u7684\u5173\u7cfb\u3002",
      "figure_ids": [
        "fig-24"
      ]
    },
    {
      "number": "97",
      "text": "\u5df2\u77e5\u96c6\u5408 $X=\\{7,20,45,80\\}$ \u548c $Y=\\{2,15,19,70\\}$\u3002\u7528\u7bad\u5934\u53f7\u8868\u793a\u96c6\u5408 $X$ \u548c $Y$ \u7684\u5143\u7d20\u95f4\u7684\u201c\u5c0f\u4e8e\u201d\u5173\u7cfb\u300220 \u548c 45 \u5206\u522b\u548c\u54ea\u4e2a\u6570\u5bf9\u5e94\uff1f7 \u548c\u51e0\u4e2a\u6570\u5bf9\u5e94\uff1f80 \u5c5e\u4e8e\u8fd9\u79cd\u5173\u7cfb\u7684\u5b9a\u4e49\u57df\u5417\uff1f45 \u5462\uff1f2 \u5c5e\u4e8e\u8fd9\u79cd\u5173\u7cfb\u7684\u503c\u57df\u5417\uff1f15 \u5462\uff1f",
      "figure_ids": []
    },
    {
      "number": "98",
      "text": "\u96c6\u5408 $\\{14,25,32,34,44,62\\}$ \u4e2d\u7684\u6bcf\u4e00\u4e2a\u4e24\u4f4d\u6570\uff0c\u548c\u5b83\u7684\u6570\u5b57\u548c\u5bf9\u5e94\u3002\u7528\u6570\u5bf9\u96c6\u5408\u7ed9\u51fa\u4e0a\u9762\u8bf4\u7684\u5173\u7cfb\u300214\u300125\u548c 32 \u5206\u522b\u548c\u54ea\u4e2a\u6570\u5bf9\u5e94\uff1f\u4ec0\u4e48\u6570\u548c 8 \u5bf9\u5e94\uff1f\u4ec0\u4e48\u6570\u548c5 \u5bf9\u5e94\uff1f",
      "figure_ids": []
    },
    {
      "number": "99",
      "text": "\u4e0b\u5217\u8bed\u53e5\u7ed9\u51fa\u4e86\u96c6\u5408 $X=\\{-8,0,9\\}$ \u548c $Y=\\{-4,-1,$ $7,8\\}$ \u5143\u7d20\u95f4\u7684\u4e00\u79cd\u5173\u7cfb\uff1a\na) $x+y>0$\uff0c\u5176\u4e2d $x\\in X,y\\in Y$\uff1b\nb) $xy>0$\uff0c\u5176\u4e2d $x\\in X,y\\in Y$\u3002\u7528\u5217\u51fa\u6570\u5bf9\u7684\u65b9\u6cd5\u8868\u793a\u8fd9\u79cd\u5173\u7cfb\u3002",
      "figure_ids": []
    },
    {
      "number": "100",
      "text": "\u7528\u4e0b\u9762\u7684\u65b9\u6cd5\u7ed9\u51fa\u5173\u7cfb\uff1a\u5982\u56fe 25\uff0c\u5706\u5468\u7684\u76f4\u5f84 $AB$ \u4e0a\u6bcf\u4e00\u70b9\u548c\u8fc7\u8fd9\u70b9\u6240\u4f5c\u76f4\u5f84\u7684\u5782\u7ebf\u4e0e\u5706\u5468\u7684\u4ea4\u70b9\u5bf9\u5e94\uff08\u4f8b\u5982\uff0c$C\\to K,C\\to L$\uff09\u3002\u70b9 $D,E,B$ \u5206\u522b\u548c\u54ea\u4e9b\u70b9\u5bf9\u5e94\uff1f\u76f4\u5f84\u4e0a\u54ea\u4e9b\u70b9\u5206\u522b\u548c\u70b9 $M,A,N$ \u5bf9\u5e94\uff1f",
      "figure_ids": [
        "fig-25"
      ]
    },
    {
      "number": "101",
      "text": "\u586b\u8868\uff1a",
      "figure_ids": [
        "tbl-p0035-01"
      ]
    },
    {
      "number": "102",
      "text": "$x$ \u8f74\u548c $y$ \u8f74\u628a\u5750\u6807\u5e73\u9762\u5206\u6210\u56db\u4e2a\u8c61\u9650\uff08\u56fe 26\uff09\u3002\u4e0b\u5217\u5404\u70b9\u5206\u522b\u5c5e\u4e8e\u54ea\u4e2a\u8c61\u9650\uff1f$A(5,3)$\uff0c$B(-1.5,-7)$\uff0c$C(2.8,-7.6)$\uff0c$D(-4,0.81)$\uff0c$E(-102,-87.6)$\uff0c$F(963,-49.3)$\u3002",
      "figure_ids": [
        "fig-26"
      ]
    },
    {
      "number": "103",
      "text": "\u5229\u7528\u4e58\u6cd5\u5206\u914d\u5f8b\u6c42\u5f0f\u7684\u503c\uff1a$0.618\\times27.2+0.618\\times72.8$\u3002",
      "figure_ids": []
