  },
  "exercises": [
    {
      "number": "413",
      "text": "\u9a8c\u8bc1\u6570\u5bf9 $x=1\\frac{5}{7}$ \u548c $y=5\\frac{2}{7}$ \u662f\u4e0d\u662f\u65b9\u7a0b $x+y=7$ \u7684\u89e3\u3002\u4efb\u610f\u6307\u51fa\u8fd9\u4e2a\u65b9\u7a0b\u7684\u4e24\u4e2a\u89e3\u3002",
      "figure_ids": []
    },
    {
      "number": "414",
      "text": "\u4e0b\u8868\u4e2d\u7ed9\u51fa\u4e86\u53d8\u91cf $x$ \u548c $y$ \u7684\u53d6\u503c\u6570\u5bf9\uff1a\u5176\u4e2d\u54ea\u4e9b\u662f\u4e0b\u5217\u65b9\u7a0b\u7684\u89e3\uff1f\na) $x^2+y^2=25$\uff1b\nb) $x^2-y^2=7$\u3002",
      "figure_ids": [
        "tbl-p0121-01"
      ]
    },
    {
      "number": "415",
      "text": "\u5df2\u77e5\u65b9\u7a0b $2u+7v=4$\u3002\na) \u7528\u53d8\u91cf $u$ \u8868\u793a $v$\uff1b\nb) \u7528\u53d8\u91cf $v$ \u8868\u793a $u$\u3002",
      "figure_ids": []
    },
    {
      "number": "416",
      "text": "\u5728\u4e0b\u5217\u65b9\u7a0b\u4e2d\uff0c\u7528\u53d8\u91cf $x$ \u8868\u793a $y$\uff0c\u5e76\u6c42\u51fa\u65b9\u7a0b\u7684\u4efb\u610f\u4e8c\u4e2a\u89e3\uff1a\na) $3x+2y=1$\uff1b\nb) $xy=12$\uff1b\nc) $5y-2x=7$\uff1b\nd) $xy=-8$\u3002",
      "figure_ids": []
    },
    {
      "number": "417",
      "text": "\u4efb\u610f\u4f5c\u4e00\u4e2a\u4e8c\u5143\u65b9\u7a0b\uff0c\u4f7f\u5b83\u7684\u89e3\u662f\u4e0b\u5217\u6570\u5bf9\uff1a\na) $x=2$\uff0c$y=4.5$\uff0c\nb) $x=-1$\uff0c$y=2$\u3002",
      "figure_ids": []
    },
    {
      "number": "418",
      "text": "\u4e0b\u5217\u542b\u53d8\u91cf $p$ \u548c $q$ \u7684\u65b9\u7a0b\u6709\u6ca1\u6709\u89e3\uff1f\na) $p^2+q^2=-4$\uff1b\nb) $2p-q+2=2p-q+7$\u3002",
      "figure_ids": []
    },
    {
      "number": "419",
      "text": "\u4e0b\u5217\u65b9\u7a0b\u6709\u51e0\u4e2a\u89e3\uff1f\na) $x^2+y^2=0$\uff1b\nb) $(x-1)^2+(y-2)^2=0$\u3002",
      "figure_ids": []
    },
    {
      "number": "420",
      "text": "\u6570\u5bf9 $(u,v)$ \u4e2d\uff0c$u$ \u7684\u503c\u53ef\u4ee5\u4efb\u610f\u53d6\uff0c$v$ \u7684\u503c\u7b49\u4e8e 5\u3002\u8bc1\u660e\u6570\u5bf9\u662f\u65b9\u7a0b $0u+7v=35$ \u7684\u89e3\u3002",
      "figure_ids": []
    },
    {
      "number": "421",
      "text": "\u6c42\u4e0b\u5217\u65b9\u7a0b\u7684\u4efb\u610f\u4e09\u4e2a\u89e3\uff1a\na) $0x+2y=6$\uff1b\nb) $4x+0y=-12$\u3002",
      "figure_ids": []
    },
    {
      "number": "422",
      "text": "\u65b9\u7a0b $x+2y=18$ \u7684\u89e3\u5f53\u4e2d\uff0c\u6709\u4e00\u4e2a\u6570\u5bf9\u662f\u7531\u76f8\u540c\u7684\u4e24\u4e2a\u6570\u7ec4\u6210\u7684\u3002\u6c42\u51fa\u8fd9\u4e2a\u6570\u5bf9\u3002",
      "figure_ids": []
    },
    {
      "number": "423",
      "text": "\u7528\u5217\u6570\u5bf9\u7684\u65b9\u6cd5\u5199\u51fa\u96c6\u5408\uff1a\na) $\\{(x,y)\\mid x\\in N,y\\in N,x+y=5\\}$\uff1b\nb) $\\{(x,y)\\mid x\\in N,y\\in N,2x+y=22\\}$\u3002",
      "figure_ids": []
    },
    {
      "number": "424",
      "text": "\u6bcf\u4ed8\u8df3\u68cb\u503c 3 \u7f8e\u5143\uff0c\u6bcf\u4ed8\u8c61\u68cb\u503c 5 \u7f8e\u5143\uff0c\u519c\u6751\u4ff1\u4e50\u90e8\u4e70\u4e86 $p$ \u4ed8\u8df3\u68cb\u548c $q$ \u4ed8\u8c61\u68cb\uff0c\u4ed8\u6b3e 67 \u7f8e\u5143\u3002\u4e70\u4e86\u591a\u5c11\u4ed8\u8c61\u68cb\uff1f\uff08\u6c42\u51fa\u6240\u6709\u7684\u89e3\u3002\uff09",
      "figure_ids": []
    },
    {
      "number": "425",
      "text": "\u4e00\u672c\u7ec3\u4e60\u672c\u503c 2 \u7f8e\u5206\uff0c\u4e00\u652f\u94c5\u7b14\u503c 3 \u7f8e\u5206\u3002\u4e00\u4e2a\u5b66\u751f\u4e70\u4e86 $n$ \u672c\u7ec3\u4e60\u672c\u548c $m$ \u652f\u94c5\u7b14\uff0c\u4ed8\u6b3e 19 \u7f8e\u5206\u3002\u8fd9\u4e2a\u5b66\u751f\u4e70\u4e86\u51e0\u652f\u94c5\u7b14\uff1f\uff08\u6c42\u51fa\u6240\u6709\u7684\u89e3\u3002\uff09",
      "figure_ids": []
    },
    {
      "number": "426",
      "text": "\u753b\u51fa\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u51fd\u6570\u56fe\u8c61\u7684\u8349\u56fe\uff1a\na) $y=-1.08x+4$\uff1b\nb) $y=2.75x$\u3002",
      "figure_ids": []
    },
    {
      "number": "427",
      "text": "\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u51fd\u6570\u662f\u6b63\u6bd4\u4f8b\u51fd\u6570\u6216\u8005\u53cd\u6bd4\u4f8b\u51fd\u6570\u5417\uff1f\na) $y=-1.27x$\uff1b\nb) $y=\\frac{7.5}{x}$\uff1b\nc) $y=3x+4$\uff1b\nd) $y=-\\frac{5}{x}$\u3002",
      "figure_ids": []
    },
    {
      "number": "428",
      "text": "\u5173\u7cfb $p$ \u7531\u6570\u5bf9\u96c6\u5408\u7ed9\u51fa\uff1a$\\{(1,1),(1,2),(1,3),(2,1),(2,3),(3,1),$ $(3,2),(3,3)\\}$\u3002\u4f5c\u8fd9\u4e2a\u5173\u7cfb\u7684\u56fe\u8c61\u3002\u5173\u7cfb $p$ \u662f\u51fd\u6570\u5417\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u7b49\u5f0f $3x+2y=5$\uff0c\u662f\u542b\u4e24\u4e2a\u53d8\u91cf\u7684\u8bed\u53e5\u3002\n\u8fd9\u6837\u7684\u7b49\u5f0f\u53eb\u505a\u4e8c\u5143\u65b9\u7a0b\u3002"
    },
    {
