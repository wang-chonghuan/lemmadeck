      "view": {
        "mode": "single",
        "stem": "验证$(x,y)=(1\\frac57,5\\frac27)$是否为$x+y=7$的解，并给这个方程另外两个不同的解。哪项完整回答正确？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "给定数对不是解，因为$1\\frac57+5\\frac27=\\frac{13}7$；另外可取$(0,7),(2,5)$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "给定数对是解，因为和为7；另外可取$(0,0),(2,2)$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "给定数对是解，因为$\\frac{12}7+\\frac{37}7=7$；另外可取$(0,7),(2,5)$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "给定数对是解，因为和为7；另外可取$(0,-7),(2,-5)$。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "保留带分数数对验证及任意两解构造。",
        "source_solution": "12/7+37/7=7；全解(t,7-t)，例(0,7),(2,5)均不同。",
        "unit_reason": "验证与两完整见证共同回应一个方程任务，不只留下是/否。",
