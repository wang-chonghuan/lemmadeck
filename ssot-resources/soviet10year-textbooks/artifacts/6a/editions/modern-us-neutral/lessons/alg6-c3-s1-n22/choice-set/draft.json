          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "把带分数误作分子相加：(1+5)/7=6/7，(5+2)/7=7/7，和13/7，错误判不是解；另外两例保持正确。",
            "misconception": "带分数的整数部分未乘分母。"
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "验证正确；另取x=0,2时把y=7-x错作y=x，产(0,0),(2,2)，和0/4都不是7。",
            "misconception": "构造解时把两个变量强行相等。"
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "给定和49/7=7；两个见证分别0+7和2+5，均为7。",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "验证正确；构造时把y=7-x反号成y=x-7，x0/2给-7/-5，产所列两对。",
            "misconception": "移项后把整个正确表达式取相反数。"
          }
        ]
      }
