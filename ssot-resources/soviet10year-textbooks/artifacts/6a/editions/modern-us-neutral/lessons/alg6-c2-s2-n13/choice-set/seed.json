  "exercises": [
    {
      "number": "244",
      "text": "a) \u4e00\u4eba\u4ece\u6e38\u89c8\u5730\u5230\u57ce\u91cc\u8d70\u4e86 1 \u5c0f\u65f6 20 \u5206\u949f\u3002\u5982\u679c\u884c\u8d70\u7684\u901f\u5ea6\u4e0d\u53d8\uff0c\u8def\u7a0b\u4e3a\u539f\u6765\u7684 1.5 \u500d\u65f6\uff0c\u4ed6\u8981\u8d70\u591a\u5c11\u5c0f\u65f6\uff1f\nb) \u7528\u6c34\u6cf5\u5f80\u8d2e\u6c34\u69fd\u4e2d\u704c\u6c34\uff0c2 \u5c0f\u65f6 30 \u5206\u949f\u53ef\u4ee5\u704c\u6ee1\u3002\u4ecd\u7136\u7528\u8fd9\u53f0\u6c34\u6cf5\u704c\u6c34\uff0c\u4f46\u6c34\u69fd\u7684\u5bb9\u79ef\u5c11\u4e00\u534a\uff0c\u8981\u7528\u591a\u5c11\u65f6\u95f4\uff1f",
      "figure_ids": []
    },
    {
      "number": "245",
      "text": "a) \u5236\u9020 250 \u4e2a\u9489\u5b50\u7528\u53bb\u4e00\u6346\u94c1\u4e1d\u3002\u5982\u679c\u53e6\u4e00\u6346\u94c1\u4e1d\u7684\u957f\u5ea6\u53ea\u6709\u524d\u4e00\u6346\u7684\u56db\u5206\u4e4b\u4e00\uff0c\u7528\u5b83\u80fd\u5236\u9020\u591a\u5c11\u4e2a\u9489\u5b50\uff1f\nb) \u4e00\u5b9a\u6570\u91cf\u7684\u725b\u5976\u5206\u88c5\u5230 7 \u4e2a\u540c\u6837\u5927\u5c0f\u7684\u725b\u5976\u7f50\uff0c\u6070\u597d\u5168\u90e8\u5145\u6ee1\u3002\u5982\u679c\u725b\u5976\u7684\u6570\u91cf\u4e3a\u539f\u6765\u7684 2.5 \u500d\uff0c\u9700\u8981\u591a\u5c11\u4e2a\u725b\u5976\u7f50\u624d\u80fd\u88c5\u5b8c\uff1f",
      "figure_ids": []
    },
    {
      "number": "246",
      "text": "\u5236\u4f5c\u7b14\u8bb0\u672c\u5171\u7528\u53bb 14.4 \u516c\u65a4\u7eb8\u3002\u8981\u5236\u4f5c\u7684\u7b14\u8bb0\u672c\u4e3a\u539f\u6765\u7684 1.2 \u500d\uff0c18 \u516c\u65a4\u7eb8\u591f\u7528\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "247",
      "text": "13 \u7acb\u65b9\u5398\u7c73\u94c1\u7684\u8d28\u91cf\u7b49\u4e8e 93.6 \u514b\u300225 \u7acb\u65b9\u5398\u7c73\u7684\u94c1\u5757\uff0c\u5b83\u7684\u8d28\u91cf\u662f\u591a\u5c11\u514b\uff1f",
      "figure_ids": []
    },
    {
      "number": "248",
      "text": "\u4e00\u5428\u6d77\u6c34\u542b\u76d0 25 \u516c\u65a4\u3002\u5982\u679c\u4e00\u4e2a\u7f38\u5b50\u53ef\u4ee5\u88c5\u6d77\u6c34 250\u514b\uff0c\u8fd9\u4e2a\u7f38\u5b50\u7684\u6d77\u6c34\u91cc\u542b\u76d0\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "249",
      "text": "\u4e94\u4e2a\u6cb9\u7f50\u704c\u6ee1\u6c7d\u6cb9\u8981\u7528 1 \u5c0f\u65f6 15 \u5206\u949f\u30022 \u5c0f\u65f6\u80fd\u704c\u6ee1\u4e03\u4e2a\u8fd9\u6837\u7684\u6cb9\u7f50\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "250",
      "text": "\u5df2\u77e5 17 \u5347\u7164\u6cb9\u7684\u8d28\u91cf\u662f 13.6 \u516c\u65a4\u3002\u4e00\u4e2a\u5bb9\u79ef\u662f 16 \u5347\u7684\u7f50\u5b50\u80fd\u88c5\u4e0b 12 \u516c\u65a4\u7164\u6cb9\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "251",
      "text": "\u5f0f $y=-1.8x$ \u7ed9\u51fa\u4e00\u4e2a\u6b63\u6bd4\u4f8b\u51fd\u6570\u3002$x$ \u7684\u503c\u7b49\u4e8e $-15$\u65f6\uff0c\u5bf9\u5e94\u7684\u51fd\u6570\u503c\u662f\u4ec0\u4e48\uff1f\u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u51fd\u6570\u503c\u7b49\u4e8e 72\uff1f",
      "figure_ids": []
    },
    {
      "number": "252",
      "text": "\u5728\u6570\u8f74\u4e0a\u8868\u793a\u4e0d\u7b49\u5f0f\u7684\u89e3\u96c6\u5408\uff1a\na) $|x|\\leqslant7$\uff1b\nb) $|x|\\geqslant3$\u3002\u628a\u89e3\u96c6\u5408\u5199\u6210\u6570\u533a\u95f4\u6216\u8005\u6570\u533a\u95f4\u7684\u5e76\u96c6\u7684\u5f62\u5f0f\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u4e00\u822c\u5730\uff0c\u5982\u679c\u51fd\u6570 $x\\xrightarrow{f}y$ \u662f\u6b63\u6bd4\u4f8b\u51fd\u6570\uff0c$(x_1,y_1)$ \u548c$(x_2,y_2)$ \u662f\u53d8\u91cf $x$ \u548c $y$ \u7684\u5bf9\u5e94\u503c\u6570\u5bf9\uff0c\u800c\u4e14 $x_2\\ne0$\uff0c\u90a3\u4e48$\\frac{x_1}{x_2}=\\frac{y_1}{y_2}$\u3002"
    },
    {
      "block": 7,
      "text": "$x$ \u7684\u503c\u589e\u5927\u51e0\u500d\uff0c$y$ \u7684\u5bf9\u5e94\u503c\u4e5f\u589e\u5927\u51e0\u500d\u3002\n\u540c\u6837\uff0c$x$ \u7684\u503c\u7f29\u5c0f\u51e0\u500d\uff0c$y$ \u7684\u5bf9\u5e94\u503c\u4e5f\u7f29\u5c0f\u51e0\u500d\u3002"
    }
