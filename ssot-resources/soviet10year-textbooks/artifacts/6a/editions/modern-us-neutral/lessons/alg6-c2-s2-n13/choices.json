    {
      "id": "n13-e244-walk",
      "source": {
        "exercise": "244",
        "target": "walk"
      },
      "group": null,
      "prompt": "走一段路需 $1$ 小时 $20$ 分钟，速度不变，走原路程的 $1.5$ 倍需多少小时？",
      "figureRefs": [],
      "options": [
        {
          "id": "a",
          "text": "$2$",
          "value": "2"
        },
        {
          "id": "b",
          "text": "$1.5$",
          "misconception": "把原来的 1 小时 20 分钟当成 1 小时。",
          "value": "1.5"
        },
        {
          "id": "c",
          "text": "$\\frac{8}{9}$",
          "misconception": "将时间除以 1.5，错用反比例。",
          "value": "\\frac{8}{9}"
        }
      ],
      "correctOptionId": "a",
      "explanation": "$1$ 小时 $20$ 分钟是 $\\frac{4}{3}$ 小时，乘 $1.5$ 得 $2$ 小时。",
      "verification": {
        "kind": "numeric",
        "expected": "2"
      }
    },
    {
      "id": "n13-e244-pump",
      "source": {
        "exercise": "244",
        "target": "pump"
      },
      "group": null,
      "prompt": "水泵灌满一个水槽需 $2$ 小时 $30$ 分钟，水槽容积减半，同一水泵需多少小时？",
      "figureRefs": [],
      "options": [
        {
          "id": "b",
          "text": "$5$",
          "misconception": "容积减半却将时间翻倍，错用反比例。",
          "value": "5"
        },
        {
          "id": "c",
          "text": "$1.15$",
          "misconception": "错误地把小时分钟写成十进制 2.30 再除以 2。",
          "value": "1.15"
        },
        {
          "id": "a",
          "text": "$1.25$",
          "value": "1.25"
        }
      ],
      "correctOptionId": "a",
      "explanation": "灌水速度不变，时间与容积成正比，$2.5\\div2=1.25$ 小时。",
      "verification": {
        "kind": "numeric",
        "expected": "1.25"
      }
    },
    {
      "id": "n13-e245-nails",
      "source": {
        "exercise": "245",
        "target": "nails"
      },
      "group": null,
      "prompt": "一捆铁丝可做 $250$ 个钉子。另一捆的长度只有它的四分之一，最多能做多少个同样大小的完整钉子？",
      "figureRefs": [],
      "options": [
        {
          "id": "c",
          "text": "$1000$ 个。",
          "misconception": "将 250 除以四分之一而不是乘。"
        },
        {
          "id": "a",
          "text": "$62$ 个。"
        },
        {
          "id": "b",
          "text": "$63$ 个。",
          "misconception": "把完整件数向上取整，铁丝不够第 63 个。"
        }
      ],
      "correctOptionId": "a",
      "explanation": "$250\\times\\frac{1}{4}=62.5$，铁丝够做 $62$ 个完整钉子，不够做第 $63$ 个。",
      "verification": {
        "kind": "literal",
        "reason": "$250\\times\\frac{1}{4}=62.5$，完整钉子最多为62个；向上取整得63、比例倒置得1000均错误。"
      }
    },
