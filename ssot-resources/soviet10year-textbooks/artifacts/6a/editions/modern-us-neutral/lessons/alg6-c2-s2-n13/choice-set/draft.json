          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "把1小时20分钟写成1.20小时，再乘1.5得1.8。",
            "misconception": "误用十进制拼接小时和分钟。"
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "80分钟×1.5=120分钟，除60得2小时。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "把80分钟除1.5得160/3分钟，再除60得8/9小时。",
            "misconception": "把同速路程和时间的正比例误作反比例。"
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "把原4/3小时加1.5小时，得到17/6小时。",
            "misconception": "把变为1.5倍误当成增加1.5小时。"
          }
        ]
      }
    },
