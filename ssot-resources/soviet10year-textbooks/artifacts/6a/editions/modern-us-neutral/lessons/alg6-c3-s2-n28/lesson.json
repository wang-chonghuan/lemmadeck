      "historical_entities": []
    },
    {
      "kind": "cap",
      "text": "图 104",
      "id": null,
      "label": "图 104",
      "printed_page": 133,
      "source_refs": [
        "p0139#5"
      ],
      "source_text": "图 104",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "cap",
      "text": "图 105",
      "id": null,
      "label": "图 105",
      "printed_page": 133,
      "source_refs": [
        "p0139#6"
      ],
      "source_text": "图 105",
