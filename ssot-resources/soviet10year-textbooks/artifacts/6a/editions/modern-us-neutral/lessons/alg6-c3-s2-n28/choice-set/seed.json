  "exercises": [
    {
      "number": "463",
      "text": "\u4f5c\u56fe\u8bc1\u660e\uff1a\u65b9\u7a0b\u7ec4$\\begin{cases}2x-y=5,\\\\x+y=16\\end{cases}$\u548c\u4e0b\u5217\u65b9\u7a0b\u7ec4\u6709\u76f8\u540c\u7684\u89e3\uff1a\na) $\\begin{cases}2x-y=5,\\\\3x=21;\\end{cases}$\nb) $\\begin{cases}3x=21,\\\\x+y=16.\\end{cases}$\uff08\u65b9\u7a0b\u7ec4\uff081\uff09\u548c\uff082\uff09\u662f\u539f\u65b9\u7a0b\u7ec4\u7ecf\u8fc7\u66f4\u6362\u4e00\u4e2a\u65b9\u7a0b\u800c\u5f97\u5230\u7684\uff0c\u65b0\u65b9\u7a0b\u7684\u5de6\u8fb9\u662f\u539f\u65b9\u7a0b\u7ec4\u4e24\u4e2a\u65b9\u7a0b\u5de6\u8fb9\u7684\u548c\uff0c\u65b0\u65b9\u7a0b\u7684\u53f3\u8fb9\u662f\u4e24\u4e2a\u65b9\u7a0b\u53f3\u8fb9\u7684\u548c\u3002\uff09",
      "figure_ids": []
    },
    {
      "number": "464",
      "text": "\u89e3\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}2x+11y=15,\\\\10x-11y=9;\\end{cases}$\nb) $\\begin{cases}9x-17y=-14,\\\\-9x+15y=12;\\end{cases}$\nc) $\\begin{cases}4x-7y=30,\\\\4x-5y=90;\\end{cases}$\nd) $\\begin{cases}13x-8y=28,\\\\11x-8y=24.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "465",
      "text": "\u89e3\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}40x+3y=10,\\\\20x-7y=5;\\end{cases}$\nb) $\\begin{cases}5x-2y=1,\\\\15x-3y=-3;\\end{cases}$\nc) $\\begin{cases}33x+42y=10,\\\\9x+14y=4;\\end{cases}$\nd) $\\begin{cases}13x-12y=14,\\\\11x+18y=40;\\end{cases}$\ne) $\\begin{cases}10x-9y=8,\\\\15x+21y=0.5;\\end{cases}$\nf) $\\begin{cases}9y+8z=-2,\\\\4y+5z=-11;\\end{cases}$\ng) $\\begin{cases}0.75x+20y=95,\\\\0.32x-25y=7;\\end{cases}$\nh) $\\begin{cases}5u-6v=0,\\\\4u+17v=109.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "466",
      "text": "\u628a\u65b9\u7a0b\u5316\u4e3a $ax+by=c$ \u5f62\u5f0f\uff0c\u5e76\u89e3\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}5(x+2y)-3=x+5,\\\\4(x-3y)-50=-y;\\end{cases}$\nb) $\\begin{cases}5(x-3y)-6=2x+1,\\\\3(x+6y)+4=9y+19.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "467",
      "text": "\u89e3\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}\\frac{1}{3}x+\\frac{1}{4}y-2=0,\\\\5x-y=56;\\end{cases}$\nb) $\\begin{cases}\\frac{1}{5}x-\\frac{1}{6}y=0,\\\\5x-4y=2;\\end{cases}$\nc) $\\begin{cases}\\frac{1}{2}(x+11)=\\frac{1}{3}(y+13)+2,\\\\5x=3y+8;\\end{cases}$\nd) $\\begin{cases}\\frac{1}{4}(x-3y)=\\frac{1}{3}(x+2y),\\\\x+5y=12.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "468",
      "text": "\u9a8c\u8bc1\uff1a\na) \u65b9\u7a0b\u7ec4 $\\begin{cases}7x-3y=0,\\\\2x-y=-1\\end{cases}$ \u7684\u89e3\u662f\u4e0d\u662f\u65b9\u7a0b $3x+5y=44$\u7684\u89e3\uff1b\nb) \u65b9\u7a0b\u7ec4 $\\begin{cases}4x+5y=18,\\\\-5x+4y=80\\end{cases}$ \u7684\u89e3\u662f\u4e0d\u662f\u65b9\u7a0b $7x-2y=-96$ \u7684\u89e3\u3002",
      "figure_ids": []
    },
    {
      "number": "469",
      "text": "\u4e0b\u5217\u65b9\u7a0b\u7ec4\u6709\u6ca1\u6709\u89e3\uff1f\na) $\\begin{cases}3x+5y=34,\\\\4x-5y=-13,\\\\2x-y=1;\\end{cases}$\nb) $\\begin{cases}6x-5y=-15,\\\\13x+3y=-86,\\\\3x+y=-18.\\end{cases}$",
      "figure_ids": []
    },
    {
      "number": "470",
      "text": "\u5f53 $k$ \u548c $l$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u8868\u793a\u65b9\u7a0b $y=kx+l$ \u7684\u76f4\u7ebf\u7ecf\u8fc7\u4e0b\u5217\u4e24\u70b9\uff1a\na) $M(5,5)$ \u548c $N(-10,-19)$\uff1b\nb) $P(4,-4)$ \u548c $Q(-3,13.5)$\u3002",
      "figure_ids": []
    },
    {
      "number": "471",
      "text": "\u4e0d\u4f5c\u56fe\uff0c\u5224\u65ad\u4e0b\u9762\u6307\u51fa\u7684\u70b9\u662f\u5426\u5728\u8868\u793a\u65b9\u7a0b $3x-2y=25$\u7684\u76f4\u7ebf\u4e0a\uff1a\na) \u6a2a\u5750\u6807\u548c\u7eb5\u5750\u6807\u76f8\u7b49\u7684\u70b9\uff1b\nb) \u6a2a\u5750\u6807\u548c\u7eb5\u5750\u6807\u4e92\u4e3a\u76f8\u53cd\u6570\u7684\u70b9\u3002",
      "figure_ids": []
    },
    {
      "number": "472",
      "text": "\u5df2\u77e5 $a-b=3$\u3002$b-a$\uff0c$|a-b|$\uff0c$|b-a|$\uff0c$\\frac{|b-a|}{a-b}$ \u5404\u7b49\u4e8e\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "473",
      "text": "\u89e3\u65b9\u7a0b\uff1a\na) $|x|=18$\uff1b\nb) $|x-1|=5$\uff1b\nc) $|x-4|=3.5$\uff1b\nd) $|x+2|=6$\u3002",
      "figure_ids": []
    },
    {
      "number": "474",
      "text": "\u5148\u586b\u8868\uff0c\u7136\u540e\u6307\u51fa\u54ea\u4e9b\u6570\u5bf9 $(a,b)$ \u628a\u7b49\u5f0f $|a|+|b|=|a+b|$ \u53d8\u6210\u771f\u7b49\u5f0f\uff1a",
      "figure_ids": [
        "tbl-p0144-01"
      ]
    },
    {
      "number": "475",
      "text": "\u56fe 106 \u4e0a\u753b\u51fa\u7684\u662fCity A\u548cCity B\u4e00\u663c\u591c\u6c14\u6e29\u7684\u56fe\u793a\u3002\na) \u6307\u51faCity A\u548cCity B\u4e24\u5730\u6c14\u6e29\u90fd\u4e0a\u5347\u7684\u65f6\u95f4\uff1b\nb) \u5f53City B\u7684\u6e29\u5ea6\u8ba1\u6307\u7740 $0^\\circ$ \u65f6\uff0cCity A\u662f\u591a\u5c11\u5ea6\uff1f\nc) \u5f53City A\u7684\u6e29\u5ea6\u8ba1\u4e0a\u5347\u5230\u4e00\u663c\u591c\u6700\u9ad8\u6e29\u5ea6\u65f6\uff0cCity B\u662f\u591a\u5c11\u5ea6\uff1f\nd) \u5728\u51e0\u70b9\u949f\u7684\u65f6\u5019City B\u7684\u6c14\u6e29\u548cCity A $10$ \u70b9\u65f6\u7684\u6c14\u6e29\u76f8\u540c\uff1f\ne) \u54ea\u4e2a\u5730\u65b9\u4e00\u663c\u591c\u7684\u6e29\u5dee\uff08\u6700\u9ad8\u6e29\u5ea6\u548c\u6700\u4f4e\u6e29\u5ea6\u7684\u5dee\uff09\u6bd4\u8f83\u5927\uff1a\u5728City A\u8fd8\u662f\u5728City B\uff1f",
      "figure_ids": [
        "fig-106"
      ]
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u9700\u8981\u6c42\u89e3\u7684\u7ebf\u6027\u65b9\u7a0b\u7ec4\uff0c\u5b83\u7684\u53d8\u91cf\u7684\u7cfb\u6570\u5e38\u5e38\u90fd\u4e0d\u7b49\u4e8e\u96f6\u3002\n\u8fd9\u5c31\u8981\u6c42\u5c06\u65b9\u7a0b\u7ec4\u53d8\u5f62\uff0c\u81f3\u5c11\u4f7f\u5176\u4e2d\u4e00\u4e2a\u65b9\u7a0b\u7684\u67d0\u4e2a\u53d8\u91cf\u7684\u7cfb\u6570\u7b49\u4e8e\u96f6\uff0c\u4e5f\u5c31\u662f\u5316\u6210\u4e0a\u9762\u8ba8\u8bba\u8fc7\u7684\u90a3\u79cd\u7c7b\u578b\u3002"
