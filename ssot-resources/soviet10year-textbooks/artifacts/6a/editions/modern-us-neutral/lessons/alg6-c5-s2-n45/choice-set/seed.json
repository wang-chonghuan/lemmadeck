  "concepts": [
    {
      "block": 1,
      "text": "\u6574\u5f0f\u4e4b\u95f4\u7684\u6052\u7b49\u5173\u7cfb\u6709\u81ea\u53cd\u6027\u3001\u5bf9\u79f0\u6027\u548c\u4f20\u9012\u6027\uff0c\u4e5f\u5c31\u662f\u7b49\u4ef7\u5173\u7cfb\uff0e"
    },
    {
      "block": 2,
      "text": "\u5b9e\u9645\u4e0a\uff1a1\uff09\u4efb\u4f55\u6574\u5f0f\u548c\u5b83\u672c\u8eab\u6052\u7b49\uff1b\n2\uff09\u5982\u679c\u4e00\u4e2a\u6574\u5f0f\u548c\u53e6\u4e00\u4e2a\u6574\u5f0f\u6052\u7b49\uff0c\u90a3\u4e48\u7b2c\u4e8c\u4e2a\u6574\u5f0f\u4e5f\u548c\u7b2c\u4e00\u4e2a\u6574\u5f0f\u6052\u7b49\uff1b\n3\uff09\u5982\u679c\u4e00\u4e2a\u6574\u5f0f\u548c\u7b2c\u4e8c\u4e2a\u6574\u5f0f\u6052\u7b49\uff0c\u7b2c\u4e8c\u4e2a\u6574\u5f0f\u53c8\u548c\u7b2c\u4e09\u4e2a\u6574\u5f0f\u6052\u7b49\uff0c\u90a3\u4e48\u7b2c\u4e00\u4e2a\u548c\u7b2c\u4e09\u4e2a\u4e5f\u6052\u7b49\uff0e"
    },
    {
      "block": 3,
      "text": "\u5bf9\u6574\u5f0f\u4f5c\u6052\u7b49\u53d8\u6362\u65f6\uff0c\u6211\u4eec\u53ef\u4ee5\u628a\u4e00\u4e2a\u6574\u5f0f\u7528\u4e0e\u5b83\u6052\u7b49\u7684\u53e6\u5916\u7684\u6574\u5f0f\u6765\u4ee3\u66ff\uff0e\u8fd9\u6837\u5f97\u5230\u7684\u4efb\u4f55\u4e00\u4e2a\u6574\u5f0f\uff0c\u90fd\u4e0e\u539f\u6765\u7684\u6574\u5f0f\u6052\u7b49\uff0e"
    },
    {
      "block": 4,
      "text": "\u6574\u5f0f\u6052\u7b49\u53d8\u5f62\u7684\u4e3b\u8981\u4efb\u52a1\uff0c\u662f\u628a\u6574\u5f0f\u53d8\u6362\u6210\u6807\u51c6\u5f62\u5f0f\u7684\u591a\u9879\u5f0f\uff0e\u6211\u4eec\u4ee5\u540e\u4f1a\u770b\u5230\uff0c\u8fd9\u79cd\u53d8\u6362\u603b\u662f\u80fd\u591f\u5b8c\u6210\u7684\uff0e"
    },
    {
      "block": 7,
      "text": "\u6211\u4eec\u77e5\u9053\uff0c\u5982\u679c\u62ec\u53f7\u524d\u9762\u6ca1\u6709\u4efb\u4f55\u7b26\u53f7\u6216\u8005\u662f\u201c$+$\u201d\u53f7\uff0c\u90a3\u4e48\u628a\u62ec\u53f7\u53bb\u6389\uff0c\u62ec\u53f7\u91cc\u9762\u5404\u9879\u7684\u7b26\u53f7\u90fd\u4e0d\u53d8\uff0e"
    },
    {
      "block": 14,
      "text": "\u524d\u4e00\u79cd\u60c5\u51b5\uff0c\u53eb\u505a\u591a\u9879\u5f0f\u6309\u7167\u53d8\u91cf $a$ \u7684\u964d\u5e42\u6392\u5217\uff1b\n\u540e\u4e00\u79cd\u60c5\u51b5\uff0c\u53eb\u505a\u591a\u9879\u5f0f\u6309\u7167\u53d8\u91cf $a$ \u7684\u5347\u5e42\u6392\u5217\uff0e"
    },
    {
      "block": 15,
      "text": "\u5728\u4f5c\u6574\u5f0f\u7684\u6052\u7b49\u53d8\u5f62\u65f6\uff0c\u7ecf\u5e38\u8981\u9002\u5f53\u5730\u5c06\u591a\u9879\u5f0f\u6309\u7167\u67d0\u4e00\u4e2a\u53d8\u91cf\u7684\u964d\u5e42\u6392\u5217\u6216\u8005\u5347\u5e42\u6392\u5217\uff0e"
    }
  ],
