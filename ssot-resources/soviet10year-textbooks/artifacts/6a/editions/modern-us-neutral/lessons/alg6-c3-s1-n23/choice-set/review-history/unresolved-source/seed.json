  "exercises": [
    {
      "number": "429",
      "text": "\u4e0b\u5217\u5404\u70b9\u5c5e\u4e8e\u65b9\u7a0b $5x-2y=4$ \u7684\u56fe\u8c61\u5417\uff1f$A(2,3)$\uff0c$B(-2,-7)$\uff0c$C(4,5)$\uff0c$D(20,48)$\u3002",
      "figure_ids": []
    },
    {
      "number": "430",
      "text": "\u70b9 $A(2,-4.5)$ \u5728\u4e0b\u5217\u65b9\u7a0b\u7684\u56fe\u8c61\u4e0a\u5417\uff1f\na) $5x+y=5.5$\uff1b\nb) $x^3+y=3.5$\u3002",
      "figure_ids": []
    },
    {
      "number": "431",
      "text": "\u4e0b\u5217\u65b9\u7a0b\u7684\u56fe\u8c61\u7ecf\u8fc7\u539f\u70b9\u5417\uff1f\na) $y=x^2+x-1$\uff1b\nb) $y=x^4-3x^2+x$\u3002",
      "figure_ids": []
    },
    {
      "number": "432",
      "text": "\u8bc1\u660e\uff1a\u70b9 $A(-2,8)$ \u548c $B(1\\frac{1}{2},3\\frac{5}{8})$ \u4e0d\u5728\u65b9\u7a0b $x^3-y=0$\u7684\u56fe\u8c61\u4e0a\u3002",
      "figure_ids": []
    },
    {
      "number": "433",
      "text": "\u56fe 96 \u4e0a\u753b\u51fa\u4e86\u65b9\u7a0b$x^2+y^2=16$ \u7684\u56fe\u8c61\u3002\u4ece\u56fe\u8c61\u4e0a\u4efb\u610f\u627e\u51fa\u65b9\u7a0b\u7684\u4e09\u4e2a\u89e3\u5e76\u4f5c\u9a8c\u8bc1\u3002",
      "figure_ids": [
        "fig-96"
      ]
    },
    {
      "number": "434",
      "text": "\u5bf9\u4e0b\u5217\u65b9\u7a0b\u5148\u7528 $x$ \u8868\u793a$y$\uff0c\u7136\u540e\u8bf4\u660e\u8fd9\u4e9b\u65b9\u7a0b\u7ed9\u51fa\u7684\u5173\u7cfb\u662f\u4e0d\u662f\u7ebf\u6027\u51fd\u6570\uff1a\na) $y-2x=0$\uff1b\nb) $y-5x+1=0$\uff1b\nc) $xy-4=0$\u3002",
      "figure_ids": []
    },
    {
      "number": "435",
      "text": "\u4e0b\u5217\u65b9\u7a0b\u7684\u56fe\u8c61\u662f\u4ec0\u4e48\u56fe\u5f62\uff1f\na) $x^2+y^2=0$\uff1b\nb) $2x+y=y+2x$\u3002",
      "figure_ids": []
    },
    {
      "number": "436",
      "text": "\u4e0b\u5217\u6570\u5bf9\u7684\u96c6\u5408\u5404\u7ed9\u51fa\u4e86\u4e00\u79cd\u5173\u7cfb\uff1a\na) $\\{(x,y)\\mid x\\in N,y\\in N,y=7-x\\}$\uff1b\nb) $\\{(x,y)\\mid x\\in N,y\\in N,xy=6\\}$\u3002\u5199\u51fa\u5df2\u77e5\u5173\u7cfb\u7684\u6240\u6709\u5143\u7d20\u5bf9\uff0c\u5e76\u4f5c\u51fa\u56fe\u8c61\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6bcf\u4e00\u4e2a\u542b\u4e24\u4e2a\u53d8\u91cf $x$ \u548c $y$ \u7684\u65b9\u7a0b\u90fd\u6709\u4e00\u4e2a\u89e3\u96c6\u5408\uff0c\u5373\u4f7f\u65b9\u7a0b\u53d8\u6210\u771f\u7b49\u5f0f\u7684\u53d8\u91cf\u503c\u6570\u5bf9\u96c6\u5408\u3002\n\u6362\u53e5\u8bdd\u8bf4\uff0c\u6bcf\u4e00\u4e2a\u542b\u4e24\u4e2a\u53d8\u91cf $x$ \u548c $y$ \u7684\u65b9\u7a0b\uff0c\u90fd\u5728\u53d8\u91cf $x$ \u7684\u503c\u548c\u53d8\u91cf $y$ \u7684\u503c\u4e4b\u95f4\u5efa\u7acb\u4e00\u79cd\u5173\u7cfb\u3002\n\u6211\u4eec\u5c06\u4f1a\u770b\u5230\uff0c\u542b\u53d8\u91cf $x$ \u548c $y$ \u7684\u65b9\u7a0b\u8fd8\u53ef\u4ee5\u5efa\u7acb\u53e6\u5916\u4e00\u79cd\u5173\u7cfb\u2014\u2014\u53d8\u91cf $y$ \u7684\u503c\u548c\u53d8\u91cf $x$ \u7684\u503c\u4e4b\u95f4\u7684\u5173\u7cfb\u3002\n\n\u4ee5\u540e\u4e00\u63d0\u5230\u542b\u4e24\u4e2a\u53d8\u91cf $x$ \u548c $y$ \u7684\u65b9\u7a0b\u5efa\u7acb\u7684\u5173\u7cfb\uff0c\u5c31\u662f\u6307\u53d8\u91cf $x$ \u7684\u503c\u548c\u53d8\u91cf $y$ \u7684\u503c\u4e4b\u95f4\u7684\u5173\u7cfb\u3002"
    },
    {
      "block": 6,
      "text": "\u4e8c\u5143\u65b9\u7a0b\u7ed9\u51fa\u7684\u5173\u7cfb\u7684\u56fe\u8c61\uff0c\u7b80\u79f0\u4e3a\u8fd9\u4e2a\u65b9\u7a0b\u7684\u56fe\u8c61\u3002"
    },
    {
      "block": 7,
      "text": "\u4e8c\u5143\u65b9\u7a0b\u7684\u56fe\u8c61\uff0c\u662f\u4ee5\u8fd9\u4e2a\u65b9\u7a0b\u7684\u89e3\u4e3a\u5750\u6807\u7684\u70b9\u7684\u96c6\u5408\u3002"
    }
  ],
