  "exercises": [
    {
      "number": "34",
      "text": "\u4e0b\u5217\u547d\u9898\u662f\u771f\u547d\u9898\u5417\uff1f\na) \u5206\u6570 $\\frac{35}{91}$ \u4e0d\u80fd\u7ea6\u7b80\uff1b\nb) 21.5 \u662f 27.2 \u548c 15.8 \u7684\u7b97\u672f\u5e73\u5747\u6570\uff1b\nc) 16 \u548c 0.25 \u7684\u79ef\u5c0f\u4e8e\u5b83\u4eec\u7684\u548c\u3002",
      "figure_ids": []
    },
    {
      "number": "35",
      "text": "\u4e0b\u5217\u547d\u9898\u4e2d\u54ea\u4e9b\u662f\u771f\u547d\u9898\uff1f\na) $2^3=8$\uff1b\nb) $\\frac14:3=12$\uff1b\nc) $-7>-9$\uff1b\nd) $-\\frac1{20}>-\\frac1{24}$\u3002",
      "figure_ids": []
    },
    {
      "number": "36",
      "text": "\u4e0b\u5217\u547d\u9898\u662f\u771f\u547d\u9898\u5417\uff1f\na) $5\\frac17-\\frac17\\cdot\\left(1\\frac34+\\frac14\\right)=4$\uff1b\nb) $8\\frac23\\div4\\frac13-50<-47$\uff1b\nc) $4+1248\\div(11.8+0.2)=108$\uff1b\nd) $(90.9\\div3.03)\\left(\\frac13-\\frac56\\right)>-1$\u3002",
      "figure_ids": []
    },
    {
      "number": "37",
      "text": "\u586b\u8868\uff08\u771f\u547d\u9898\u8bb0\u4f5c\u201c\u771f\u201d\uff0c\u5047\u547d\u9898\u8bb0\u4f5c\u201c\u5047\u201d\uff09\uff1a",
      "figure_ids": [
        "tbl-p0018-01"
      ]
    },
    {
      "number": "38",
      "text": "\u4ece\u96c6\u5408 $\\{-10,-8,-6,-1,1,12,15\\}$ \u4e2d\uff0c\u627e\u51fa\u4f7f\u4e0b\u5217\u8bed\u53e5\u53d8\u6210\u771f\u547d\u9898\u7684\u6570\u6240\u7ec4\u6210\u7684\u5b50\u96c6\u3002\na) $\\frac{48}{x}$ \u662f\u6574\u6570\uff1b\nb) $1+x$ \u662f\u6b63\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "39",
      "text": "\u586b\u8868\uff08\u771f\u547d\u9898\u8bb0\u4f5c\u201c\u771f\u201d\uff0c\u5047\u547d\u9898\u8bb0\u4f5c\u201c\u5047\u201d\uff09\uff1a",
      "figure_ids": [
        "tbl-p0018-02"
      ]
    },
    {
      "number": "40",
      "text": "\u6307\u51fa\u53d8\u91cf $k$ \u7684\u4e00\u4e2a\u503c\uff0c\u5f53 $k$ \u53d6\u8fd9\u4e2a\u503c\u65f6\u8bed\u53e5\u53d8\u6210\u771f\u547d\u9898\uff1a\na) $\\frac{k}{4}$ \u662f\u771f\u5206\u6570\uff1b\nb) $k+8$ \u662f\u8d28\u6570\uff1b\nc) $k-5$ \u662f\u6b63\u6570\uff1b\nd) $k+97$ \u662f\u4e24\u4f4d\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "41",
      "text": "\u6307\u51fa\u53d8\u91cf $x$ \u548c $y$ \u7684\u4e00\u5bf9\u503c $(x,y)$\uff0c\u5f53\u53d8\u91cf\u53d6\u8fd9\u5bf9\u503c\u65f6\u8bed\u53e5\u53d8\u6210\u771f\u547d\u9898\uff1a\na) $x$ \u57ce\u4f4d\u4e8e $y$ \u57ce\u7684\u5317\u65b9\uff1b\nb) $x$ \u8fd9\u4e2a\u5355\u8bcd\u5c5e\u4e8e $y$ \u8bcd\u7c7b\u3002",
      "figure_ids": []
    },
    {
      "number": "42",
      "text": "\u627e\u4e00\u5bf9\u81ea\u7136\u6570\uff0c\u4f7f\u4e0b\u5217\u8bed\u53e5\u53d8\u6210\u771f\u547d\u9898\uff1a\na) \u6570 $a$ \u80fd\u88ab\u6570 $b$ \u6574\u9664\uff1b\nb) \u6570 $a$ \u662f\u6570 $b$ \u7684\u7ea6\u6570\uff1b\nc) \u4e24\u4f4d\u6570 $a$ \u7684\u6570\u5b57\u548c\u7b49\u4e8e\u4e24\u4f4d\u6570 $b$ \u7684\u6570\u5b57\u548c\uff1b\nd) $a+b$ \u662f\u8d28\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "43",
      "text": "\u627e\u51fa\u53d8\u91cf $x$ \u548c $y$ \u7684\u4e00\u5bf9\u503c $(x,y)$\uff0c\u4f7f\u4e0b\u5217\u8bed\u53e5\u53d8\u6210\u771f\u547d\u9898\uff1a\na) $x<y$\uff1b\nb) $x>2y$\uff1b\nc) $2x=y$\uff1b\nd) $x-y=4$\u3002",
      "figure_ids": []
    },
    {
      "number": "44",
      "text": "\u627e\u51fa\u53d8\u91cf $a$ \u548c $c$ \u7684\u4e09\u5bf9\u503c\uff0c\u4f7f\u8bed\u53e5\u201c$a+c=100$\u201d\u53d8\u6210\uff1a\na) \u771f\u547d\u9898\uff1b\nb) \u5047\u547d\u9898\u3002",
      "figure_ids": []
    },
    {
      "number": "45",
      "text": "\u5f53\u53d8\u91cf $x$ \u548c $y$ \u7684\u6570\u503c\u7ec4\u6210\u4e0b\u5217\u6570\u5bf9\u65f6\uff0c\u8bed\u53e5\u201c\u6570 $x$ \u662f\u6570$y$ \u7684\u7ea6\u6570\u201d\u662f\u5426\u53d8\u6210\u771f\u547d\u9898\uff1f\na) $(2,18)$\uff1b\nb) $(18,2)$\uff1b\nc) $(4,4)$\uff1b\nd) $(3,23)$\uff1b\ne) $(5,25)$\u3002",
      "figure_ids": []
    },
    {
      "number": "46",
      "text": "\u5316\u7b80\u4e0b\u5217\u5404\u5f0f\u5e76\u6c42\u503c\uff1a\na) $(5x-1)-(1+3x)$\uff0c\u5f53 $x=-5$\uff1b\nb) $2(3-x)+(5-3x)$\uff0c\u5f53 $x=-0.2$\uff1b\nc) $12+7x-2(1+3x)$\uff0c\u5f53 $x=-9.6$\uff1b\nd) $37-(x-36)+(11x-53)$\uff0c\u5f53 $x=-0.03$\u3002",
      "figure_ids": []
    },
    {
      "number": "47",
      "text": "\u8bbe $n$ \u662f\u81ea\u7136\u6570\u3002\na) \u5199\u51fa\u81ea\u7136\u6570\u5217\u4e2d $n$ \u540e\u9762\u7684\u4e00\u4e2a\u6570\uff1b\nb) \u5199\u51fa\u81ea\u7136\u6570\u5217\u4e2d $n$\uff08$n>1$\uff09\u524d\u9762\u7684\u4e00\u4e2a\u6570\uff1b\nc) \u8fde\u7eed\u7684\u4e24\u4e2a\u81ea\u7136\u6570\uff08\u5176\u4e2d\u8f83\u5c0f\u7684\u4e00\u4e2a\u662f $n$\uff09\u7684\u79ef\uff1b\nd) \u8fde\u7eed\u7684\u4e09\u4e2a\u81ea\u7136\u6570\uff08\u5176\u4e2d\u8f83\u5927\u7684\u4e00\u4e2a\u662f $n$\uff0c\u4e14 $n>2$\uff09\u7684\u79ef\u3002",
      "figure_ids": []
    },
    {
      "number": "48",
      "text": "\u5217\u5f0f\u89e3\u5e94\u7528\u9898\uff1a\n\u4e00\u4eba\u9a91\u81ea\u884c\u8f66\uff0c\u4e00\u4eba\u6b65\u884c\uff0c\u4ece\u4e00\u4e2a\u6751\u5b50\u540c\u65f6\u51fa\u53d1\u8fdb\u57ce\u3002\n\u5982\u679c\u81ea\u884c\u8f66\u7684\u901f\u5ea6\u662f $v$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u800c\u6b65\u884c\u7684\u901f\u5ea6\u662f $u$ \u516c\u91cc/\u5c0f\u65f6\uff0c\n\u7ecf\u8fc7 2 \u5c0f\u65f6\u540e\uff0c\u4ed6\u4eec\u76f8\u8ddd\u591a\u8fdc\uff1f\n\u6839\u636e\u9898\u610f\u4efb\u610f\u9009\u53d6\u53d8\u91cf $u$ \u548c $v$ \u7684\u4e00\u5bf9\u503c\uff0c\u7136\u540e\u6c42\u51fa\u6240\u5217\u5f0f\u5b50\u76f8\u5e94\u7684\u503c\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
