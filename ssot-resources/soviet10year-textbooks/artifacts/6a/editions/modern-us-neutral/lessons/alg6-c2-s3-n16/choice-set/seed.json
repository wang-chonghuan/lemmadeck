  "exercises": [
    {
      "number": "275",
      "text": "\u7531\u4e0b\u5217\u5404\u8868\u7ed9\u51fa\u7684\u51fd\u6570\u662f\u53cd\u6bd4\u4f8b\u51fd\u6570\u5417\uff1f",
      "figure_ids": [
        "tbl-p0083-01"
      ]
    },
    {
      "number": "276",
      "text": "\u4e0b\u8868\u7ed9\u51fa\u4e86\u53d8\u91cf $p$ \u5bf9\u53d8\u91cf $q$ \u7684\u4f9d\u8d56\u5173\u7cfb\uff1a\u8bf4\u660e\u8fd9\u79cd\u4f9d\u8d56\u5173\u7cfb\u8fd1\u4f3c\u4e8e\u53cd\u6bd4\u4f8b\u51fd\u6570\u3002",
      "figure_ids": [
        "tbl-p0083-02"
      ]
    },
    {
      "number": "277",
      "text": "\u51fd\u6570\u7531\u5f0f $y=\\frac{8}{x}$ \u7ed9\u51fa\u3002\u586b\u8868\uff1a",
      "figure_ids": [
        "tbl-p0083-03"
      ]
    },
    {
      "number": "278",
      "text": "\u5df2\u77e5\u51fd\u6570 $a\\xrightarrow{f}b$ \u662f\u53cd\u6bd4\u4f8b\u51fd\u6570\u3002\u4ece\u4e0b\u8868\u6c42\u51fa $k$ \u7684\u503c\uff0c\u7136\u540e\u7528\u5f0f\u8868\u793a\u8fd9\u4e2a\u51fd\u6570\u5e76\u586b\u8868\uff1a",
      "figure_ids": [
        "tbl-p0084-01"
      ]
    },
    {
      "number": "279",
      "text": "a) \u8bbe $v$ \u662f\u4ece $A$ \u5230 $B$ \u7684\u94c1\u8def\u4e0a\u706b\u8f66\u884c\u9a76\u7684\u901f\u5ea6\uff08\u516c\u91cc/\u5c0f\u65f6\uff09\uff0c$t$ \u662f\u4ece $A$ \u5230 $B$ \u6240\u9700\u884c\u9a76\u65f6\u95f4\uff08\u5c0f\u65f6\uff09\u3002\u53d8\u91cf $t$ \u5bf9\u53d8\u91cf $v$ \u7684\u4f9d\u8d56\u5173\u7cfb\u662f\u4e0d\u662f\u53cd\u6bd4\u4f8b\u51fd\u6570\uff1f\nb) \u8bbe $n$ \u662f\u6253\u5b57\u5458\u4e00\u5c0f\u65f6\u6253\u51fa\u539f\u7a3f\u7684\u9875\u6570\uff0c$t$ \u662f\u6253\u51fa\u5168\u90e8\u539f\u7a3f\u6240\u9700\u7684\u65f6\u95f4\uff08\u5c0f\u65f6\u6570\uff09\u3002\u53d8\u91cf $t$ \u5bf9\u53d8\u91cf $n$ \u7684\u4f9d\u8d56\u5173\u7cfb\u662f\u53cd\u6bd4\u4f8b\u51fd\u6570\u5417\uff1f\nc) \u8bbe\u4e00\u672c\u4e66\u8bfb\u4e86 $x$ \u9875\uff0c\u5269\u4e0b $y$ \u9875\u6ca1\u6709\u8bfb\u3002\u53d8\u91cf $y$ \u5bf9\u53d8\u91cf $x$ \u7684\u4f9d\u8d56\u5173\u7cfb\u662f\u53cd\u6bd4\u4f8b\u5173\u7cfb\u5417\uff1f\nd) \u5728\u4e00\u6bb5\u8def\u4e0a\uff0c\u8f66\u8f6e\u8f6c\u7684\u5708\u6570\u548c\u8f66\u8f6e\u5706\u5468\u7684\u957f\u5ea6\u6709\u5173\u3002\u8bbe $a$ \u662f\u8f66\u8f6e\u5706\u5468\u957f\uff08\u7c73\uff09\uff0c$b$ \u662f\u4ece\u5c45\u6c11\u70b9 $M$ \u5230\u5c45\u6c11\u70b9$N$ \u7684\u8def\u4e0a\u8f6e\u5b50\u8f6c\u7684\u5708\u6570\u3002\u53d8\u91cf $b$ \u5bf9\u53d8\u91cf $a$ \u7684\u4f9d\u8d56\u5173\u7cfb\u662f\u53cd\u6bd4\u4f8b\u51fd\u6570\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "280",
      "text": "\u5df2\u77e5\u6b63\u6bd4\u4f8b\u51fd\u6570\u7684\u56fe\u8c61\u7ecf\u8fc7\u4e0b\u9762\u7684\u70b9\uff0c\u5199\u51fa\u6b63\u6bd4\u4f8b\u51fd\u6570\u7684\u8868\u793a\u5f0f\uff1a\na) $A(2,8)$\uff1b\nb) $B(-6,3)$\uff1b\nc) $C(5,3)$\uff1b\nd) $D(-2,7)$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u53ef\u4ee5\u7528\u5f0f $y=\\frac{k}{x}$\uff08\u5176\u4e2d $k$ \u662f\u4e0d\u7b49\u4e8e\u96f6\u7684\u6570\uff09\u7ed9\u51fa\u7684\u51fd\u6570\uff0c\u53eb\u505a\u53cd\u6bd4\u4f8b\u51fd\u6570\u3002"
    },
    {
      "block": 2,
      "text": "\u901a\u5e38\u8bf4\uff0c\u53d8\u91cf $y$ \u548c\u53d8\u91cf $x$ \u6210\u53cd\u6bd4\u3002"
    },
    {
      "block": 3,
      "text": "\u56e0\u4e3a\u5f0f $\\frac{k}{x}$ \u5bf9\u4e8e\u4efb\u4f55\u4e0d\u7b49\u4e8e 0 \u7684 $x$ \u503c\u90fd\u6709\u610f\u4e49\uff0c\u6240\u4ee5\u5f0f $y=\\frac{k}{x}$ \u7ed9\u51fa\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u53ef\u4ee5\u662f\u4e0d\u7b49\u4e8e\u96f6\u7684\u6240\u6709\u6570\u7684\u96c6\u5408\uff0c\u4e5f\u53ef\u4ee5\u662f\u5b83\u7684\u4e00\u4e2a\u5b50\u96c6\u3002"
    },
    {
      "block": 4,
      "text": "\u7531\u5f0f $y=\\frac{k}{x}$ \u53ef\u4ee5\u5f97\u51fa $xy=k$\u3002\n\u53cd\u8fc7\u6765\uff0c\u7531 $xy=k\\ (k\\ne0)$\uff0c\u4e5f\u53ef\u4ee5\u5f97\u51fa $y=\\frac{k}{x}$\u3002\n\u56e0\u6b64\uff0c\u8981\u5224\u65ad\u51fd\u6570 $x\\xrightarrow{f}y$ \u662f\u4e0d\u662f\u53cd\u6bd4\u4f8b\u51fd\u6570\uff0c\u53ea\u8981\u6bd4\u8f83\u53d8\u91cf $x$ \u548c $y$ \u5404\u5bf9\u5bf9\u5e94\u503c\u7684\u79ef $xy$ \u662f\u5426\u76f8\u7b49\u5c31\u884c\u4e86\u3002\n\n\u5982\u679c\u8fd9\u4e9b\u79ef\u90fd\u7b49\u4e8e\u540c\u4e00\u4e2a\u4e0d\u7b49\u4e8e 0 \u7684\u6570\uff0c\u90a3\u4e48\u8fd9\u51fd\u6570\u5c31\u662f\u53cd\u6bd4\u4f8b\u51fd\u6570\u3002"
    }
  ],
