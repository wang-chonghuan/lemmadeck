  "exercises": [
    {
      "number": "305",
      "text": "\u56fe $77$ \u4e0a\u753b\u51fa\u7684\u76f4\u7ebf\u662f\u5f0f $y=-3x$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u76f8\u5bf9\u4e8e\u8fd9\u6761\u76f4\u7ebf\u6765\u8bf4\uff0c\u4e0b\u9762\u5f0f\u5b50\u7ed9\u51fa\u7684\u51fd\u6570\u56fe\u8c61\u7684\u4f4d\u7f6e\u600e\u6837\u5462\uff1f\na) $y=-3x+1$\uff1b\nb) $y=-3x-4$\u3002",
      "figure_ids": [
        "fig-77"
      ]
    },
    {
      "number": "306",
      "text": "\u4f5c\u5f0f $y=0.8x-4$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u5229\u7528\u6240\u4f5c\u56fe\u8c61\uff0c\u56de\u7b54\u4e0b\u5217\u95ee\u9898\uff1a\na) \u5f53 $x$ \u7b49\u4e8e $5$ \u548c $1.5$ \u65f6\uff0c\u51fd\u6570\u53d6\u4ec0\u4e48\u503c\uff1f\nb) \u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u53d8\u91cf $y$ \u7684\u503c\u7b49\u4e8e $4$\uff1f\nc) \u51fd\u6570\u53d6\u8d1f\u503c\u3001\u6b63\u503c\u3001\u5927\u4e8e $4$ \u7684\u503c\u65f6\uff0c$x$ \u503c\u7684\u96c6\u5408\u662f\u4ec0\u4e48\uff1f\nd) \u6570\u533a\u95f4 $[5,10]$ \u88ab\u6620\u5c04\u5230\u4ec0\u4e48\u96c6\u5408\u4e0a\uff1f",
      "figure_ids": []
    },
    {
      "number": "307",
      "text": "\u4f5c\u5f0f $y=-1.5x+6$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u5229\u7528\u6240\u4f5c\u56fe\u8c61\uff0c\u56de\u7b54\u4e0b\u5217\u95ee\u9898\uff1a\na) \u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c$y$ \u7b49\u4e8e $0,-3,3$\uff1f\nb) \u51fd\u6570\u53d6\u8d1f\u503c\u3001\u6b63\u503c\u3001\u5927\u4e8e $3$ \u7684\u503c\u65f6\uff0c$x$ \u503c\u7684\u96c6\u5408\u662f\u4ec0\u4e48\uff1f\nc) \u6570\u533a\u95f4 $]0,3]$ \u88ab\u6620\u5c04\u5230\u4ec0\u4e48\u96c6\u5408\u4e0a\uff1f",
      "figure_ids": []
    },
    {
      "number": "308",
      "text": "\u4f5c\u5f0f $y=x-3$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u3002\u5229\u7528\u56fe\u8c61\u6c42 $x$ \u503c\u7684\u96c6\u5408\uff0c\u5df2\u77e5\u5f0f $x-3$ \u7684\u503c\uff1a\na) \u7b49\u4e8e $4$\uff1b\nb) \u7b49\u4e8e $-2$\uff1b\nc) \u5927\u4e8e $4$\uff1b\nd) \u5c0f\u4e8e $5$\u3002",
      "figure_ids": []
    },
    {
      "number": "309",
      "text": "\u4e0d\u4f5c\u56fe\uff0c\u8bf4\u660e\u5f0f $y=1.2x-7$ \u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u662f\u5426\u7ecf\u8fc7\u4e0b\u5217\u5404\u70b9\uff1a\na) $A(10,5)$\uff1b\nb) $B(15,11)$\uff1b\nc) $C(-1.5,-10)$\uff1b\nd) $D(-40,-50)$\u3002",
      "figure_ids": []
    },
    {
      "number": "310",
      "text": "\u4f5c\u5f0f $y=2x-5$ \u7ed9\u51fa\u7684\u7ebf\u6027\u51fd\u6570\u7684\u56fe\u8c61\u3002\u5229\u7528\u56fe\u8c61\u4e86\u89e3$y$ \u503c\u7684\u53d8\u5316\u60c5\u51b5\uff1a\na) $x$ \u503c\u7531 $-3$ \u589e\u5927\u5230 $-2$\uff1b\nb) $x$ \u503c\u7531 $1$ \u589e\u5927\u5230 $2$\uff1b\nc) $x$ \u503c\u7531 $3$ \u589e\u5927\u5230 $4$\uff1b\nd) $x$ \u503c\u7531 $5$ \u589e\u5927\u5230 $6$\u3002",
      "figure_ids": []
    },
    {
      "number": "311",
      "text": "\u5f0f $y=-2.5x+4$ \u7ed9\u51fa\u4e00\u7ebf\u6027\u51fd\u6570\uff0c\u5b9a\u4e49\u57df\u662f $[-2,5]$\u3002\u4f5c\u8fd9\u4e2a\u51fd\u6570\u7684\u56fe\u8c61\u5e76\u6c42\u51fa\u5b83\u7684\u503c\u57df\u3002",
      "figure_ids": []
    },
    {
      "number": "312",
      "text": "\u5f0f $y=-3x+9$ \u5728\u96c6\u5408 $\\{x|x\\in Z,\\ 3\\le x\\le7\\}$ \u4e0a\u7ed9\u51fa\u4e00\u7ebf\u6027\u51fd\u6570\u3002\u4f5c\u8fd9\u4e2a\u51fd\u6570\u7684\u56fe\u8c61\u5e76\u6c42\u51fa\u5b83\u7684\u503c\u57df\u3002",
      "figure_ids": []
    },
    {
      "number": "313",
      "text": "\u4e00\u961f\u65c5\u884c\u8005\u7ecf\u8fc7 $A$ \u5730\u540e\uff0c\u73b0\u5728\u6b63\u5728\u79bb $A$ \u5730 $8$ \u516c\u91cc\u5904\u3002\u5982\u679c\u4ed6\u4eec\u6b65\u884c\u7684\u901f\u5ea6\u662f $4$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u6b65\u884c $t\\ (0\\le t\\le4)$ \u5c0f\u65f6\u540e\uff0c\u4ed6\u4eec\u79bb $A$ \u5730\u7684\u8ddd\u79bb $s$ \u662f\u591a\u5c11\u516c\u91cc\uff1f\u7528\u5f0f\u8868\u793a $s$ \u5bf9$t$ \u7684\u4f9d\u8d56\u5173\u7cfb\uff0c\u5e76\u4f5c\u51fa\u8fd0\u52a8\u7684\u56fe\u8c61\u3002\u6839\u636e\u56fe\u8c61\u6c42\uff1a\na) \u7ecf\u8fc7 $1.5$ \u5c0f\u65f6\u3001$2.5$ \u5c0f\u65f6\u3001$3$ \u5c0f\u65f6\u540e\uff0c\u65c5\u884c\u8005\u548c $A$ \u5730\u7684\u8ddd\u79bb\u662f\u591a\u5c11\u516c\u91cc\u3002\nb) \u7ecf\u8fc7\u51e0\u5c0f\u65f6\u4ee5\u540e\uff0c\u65c5\u884c\u8005\u53ef\u4ee5\u5230\u8fbe\u79bb $A$ \u5730 $12$ \u516c\u91cc\u8fdc\u7684 $B$ \u5730\u548c\u79bb $A$ \u5730 $20$ \u516c\u91cc\u8fdc\u7684 $C$ \u5730\uff1f",
      "figure_ids": []
    },
    {
      "number": "314",
      "text": "\u5f0f $f(x)=5-0.1x$ \u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u3002\u6c42 $f(-100),\\ f(0),$ $f(20),f(300)$\u3002\u5f53 $x$ \u53d6\u4ec0\u4e48\u503c\u65f6\u51fd\u6570\u503c\u7b49\u4e8e $1$\uff1f\u7b49\u4e8e$-2$\uff1f",
      "figure_ids": []
    },
    {
      "number": "315",
      "text": "\u4e00\u4e2a\u73ed\u6709 $36$ \u4e2a\u5b66\u751f\uff0c\u6bcf\u4e2a\u4eba\u81f3\u5c11\u4f1a\u4e00\u9879\u8fd0\u52a8\uff1a\u6ed1\u51b0\u6216\u8005\u6ed1\u96ea\u3002\u4f1a\u6ed1\u51b0\u7684\u5b66\u751f\u548c\u4f1a\u6ed1\u96ea\u7684\u5b66\u751f\u7684\u4eba\u6570\u6bd4\u662f $4:5$\uff0c\u540c\u65f6\u4f1a\u6ed1\u96ea\u7684\u6bd4\u4f1a\u6ed1\u51b0\u7684\u591a $6$ \u4eba\u3002\u6709\u591a\u5c11\u4e2a\u5b66\u751f\u4e24\u79cd\u90fd\u4f1a\uff1f\u6709\u51e0\u4e2a\u5b66\u751f\u53ea\u4f1a\u6ed1\u51b0\uff1f",
      "figure_ids": []
    },
    {
      "number": "316",
      "text": "\u4e00\u4e2a\u5c0f\u7ec4\u6709 $25$ \u540d\u5927\u5b66\u751f\uff0c\u6bcf\u4e00\u4e2a\u5b66\u751f\u81f3\u5c11\u5b66\u4e00\u79cd\u5916\u8bed\uff08\u82f1\u8bed\u6216\u5fb7\u8bed\uff09\uff0c\u6709\u51e0\u4e2a\u5b66\u751f\u4e24\u79cd\u5916\u8bed\u90fd\u5b66\u3002\u5b66\u5fb7\u8bed\u7684\u4eba\u6570\u548c\u5b66\u82f1\u8bed\u7684\u4eba\u6570\u662f $3:5$\uff0c\u800c\u4e14\u5b66\u5fb7\u8bed\u7684\u6bd4\u5b66\u82f1\u8bed\u7684\u5c11$8$ \u4eba\u3002\u51e0\u4e2a\u5927\u5b66\u751f\u4e24\u79cd\u90fd\u5b66\uff1f\u51e0\u4e2a\u5927\u5b66\u751f\u53ea\u5b66\u5fb7\u8bed\uff1f\u51e0\u4e2a\u5927\u5b66\u751f\u53ea\u5b66\u82f1\u8bed\uff1f",
      "figure_ids": []
    }
  ],
