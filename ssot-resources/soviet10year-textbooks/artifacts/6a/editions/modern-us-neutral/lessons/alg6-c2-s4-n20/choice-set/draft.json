            "observation": "Opened complete PNG: rising full line crosses y=-4 and x=5, extends past x=10 with arrows at clipping edges; all scales and lower border visible."
          }
        ]
      },
      "key": {
        "correct": [
          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "前两值正确，反求时漏移-4，用x=4/.8=5。",
            "misconception": "反向求值省略截距。"
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "误用y=.8x+4，得8、5.2及反求x=0。",
            "misconception": "常数项符号反转。"
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "正向代入得0,-2.8；反求(4+4)/.8=10。",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "误用y=.8x，得4、1.2及x=4/.8=5。",
            "misconception": "全部忽略截距。"
          }
        ]
      }
    },
