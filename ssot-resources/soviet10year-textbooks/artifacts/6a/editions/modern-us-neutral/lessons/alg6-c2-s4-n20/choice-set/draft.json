      ],
      "view": {
        "mode": "single",
        "stem": "图中的直线表示 $y=-3x$。$y=-3x+1$ 和 $y=-3x-4$ 的图像，相对它应当怎样移动？",
        "figure_ids": [
          "fig-77"
        ],
        "options": [
          {
            "id": "A",
            "text": "分别向下移动 $1$ 个单位、向上移动 $4$ 个单位。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "分别向上移动 $1$ 个单位、向下移动 $4$ 个单位。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "分别向右移动 $1$ 个单位、向左移动 $4$ 个单位。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "分别绕原点转动，使斜率变成 $-2$ 和 $-7$。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "在共同横坐标处比较纵坐标，区分截距平移和斜率改变。",
        "source_solution": "同一x下相对-3x增加1、减少4，两线与原直线平行，竖直平移上1、下4。",
        "unit_reason": "两条比较使用同一基线及同一机制，合成一个位置判断。",
        "concept_blocks": [
          11
        ],
        "limitations": [
          "不要求自主画出平移后的两条直线。"
        ],
        "figure_observations": [
          {
            "figure_id": "fig-77",
            "observation": "完整渲染显示一条下降直线过原点，单位网格及x/y轴清楚，右边界和底边均可见；图内题给标注y=-3x。"
          }
        ]
      },
      "key": {
        "correct": [
          "B"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "将+1和-4的竖直方向分别颠倒。",
            "misconception": "把截距增加理解为下降。"
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "新纵坐标分别是旧纵坐标+1及-4。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "误把外加常数当作横坐标移动量；右移1实际为-3(x-1)=-3x+3，左移4为-3x-12。",
            "misconception": "混淆纵向加常数与横向替换x。"
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "把常数并进系数，错误变成(-3+1)x和(-3-4)x。",
            "misconception": "把截距当斜率增量。"
          }
        ]
      }
    },
