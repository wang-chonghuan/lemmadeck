        {"option_id": "d", "truth": "incorrect", "derivation": "约去a-7后只见常数分母5，错误宣布全实数；原a=7无定义。", "misconception": "取消因子后丢掉限制。"},
        {"option_id": "e", "truth": "correct", "derivation": "4(b-10)/[(b-10)(b+10)]，保留两禁值。", "misconception": null},
        {"option_id": "f", "truth": "correct", "derivation": "分子(3y-1)(3y+1)，分母3(3y+1)，保留y≠-1/3。", "misconception": null},
        {"option_id": "g", "truth": "incorrect", "derivation": "取消c-7后仅据剩下c+7设域，遗漏c=7。", "misconception": "约分时遗忘原零因子。"},
