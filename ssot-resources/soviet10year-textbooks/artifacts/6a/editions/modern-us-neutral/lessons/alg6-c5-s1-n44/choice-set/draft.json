      "id": "q750",
      "source_numbers": ["750"],
      "view": {
        "mode": "multiple",
        "stem": "哪些化为标准形式的记录正确？\n\nA：$xxxxx-3xxxx+6xxx-12xx-7x+5$；B：$2yyy^2-24y^2y+7.8yy-1$；C：$5xx(-3xy)+6yyxy-8x+3$；D：$2a(-3b)-7a^2\\cdot5b+8b^2-12$。",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "A：$x^5-3x^4+6x^3-12x^2-7x+5$。", "figure_ids": []},
          {"id": "b", "text": "B：$-22y^3+7.8y^2-1$。", "figure_ids": []},
          {"id": "c", "text": "C：$-15x^3y+6xy^3-8x+3$。", "figure_ids": []},
          {"id": "d", "text": "D：$-35a^2b+6ab+8b^2-12$。", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "保留四个原多项式的全部项，逐个核对连写变量的幂、乘积系数及负号。",
        "source_solution": "A x^5-3x^4+6x^3-12x^2-7x+5；B 2y^4-24y^3+7.8y^2-1；C -15x^3y+6xy^3-8x+3；D -35a^2b-6ab+8b^2-12。",
        "unit_reason": "同一标准化任务用自然多选检查完整多项式，不把每个连写字母单独拆题。",
        "concept_blocks": [0, 3],
        "limitations": ["未测自行书写完整标准式和错误候选的改正式。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "c"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "各连写x因数分别有5、4、3、2个，原系数和常数项不变。", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "把yyy^2漏读一个y，误作y^3后与-24y^3合并成-22y^3；原第一项是2y^4。", "misconception": "漏数连写因数造成不同次数的项被误合并。"},
          {"option_id": "c", "truth": "correct", "derivation": "5xx(-3xy)=-15x^3y；6yyxy=6xy^3；线性与常数项保留。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "把2a(-3b)的负号漏掉得到+6ab，其他项保持原式；正确该项为-6ab。", "misconception": "遗漏括号内的负因数。"}
        ]
      }
    },
    {
