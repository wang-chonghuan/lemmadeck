          {"option_id": "b", "truth": "incorrect", "derivation": "把a^2系数1-3反向相减为3-1=2；正确为-2，其他系数保持正确。", "misconception": "合并负系数时倒置减法顺序。"},
          {"option_id": "c", "truth": "correct", "derivation": "ab^2系数12-6-5=1；b^3系数-1+2=1；3a^2b与ab^2不是同类项。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "把-3/25误作+0.12后得0.24y^4；实际0.12-3/25=0。其余项分别-5y^3、8y^2、1。", "misconception": "把负分数系数转小数时丢失负号。"},
          {"option_id": "e", "truth": "correct", "derivation": "a^2x^3系数2-1=1；ax^3系数-1+1=0；a^4系数-1+2=1；3x^4保留。", "misconception": null}
        ]
      }
