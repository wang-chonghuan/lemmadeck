  "exercises": [
    {
      "number": "49",
      "text": "\u4e0b\u5217\u5404\u6570\u662f\u65b9\u7a0b $x^2-5x=6$ \u7684\u89e3\u5417\uff1f\na) 1\uff1b\nb) $-1$\uff1b\nc) 6\uff1b\nd) $-6$\u3002",
      "figure_ids": []
    },
    {
      "number": "50",
      "text": "\u8bc1\u660e\uff1a3.4 \u548c $-3.4$ \u90fd\u662f\u65b9\u7a0b $x^2=11.56$ \u7684\u6839\u3002",
      "figure_ids": []
    },
    {
      "number": "51",
      "text": "\u6c42\u65b9\u7a0b\u7684\u89e3\u96c6\u5408\uff1a\na) $|x|=9$\uff1b\nb) $|x|=0$\uff1b\nc) $|x|=-7$\uff1b\nd) $|x|=1.5$\u3002",
      "figure_ids": []
    },
    {
      "number": "52",
      "text": "\u89e3\u7ebf\u6027\u65b9\u7a0b\uff1a\na) $5x=-60$\uff1b\nb) $7x=8$\uff1b\nc) $0.5y=1.2$\uff1b\nd) $0.06y=0.5$\uff1b\ne) $0x=3$\uff1b\nf) $0.7z=0$\uff1b\ng) $0x=0$\uff1b\nh) $0x=-4$\u3002",
      "figure_ids": []
    },
    {
      "number": "53",
      "text": "\u89e3\u65b9\u7a0b\uff1a\na) $2x+9=13-x$\uff1b\nb) $17-0.3m=2+1.7m$\uff1b\nc) $0.5y+11=4-3y$\uff1b\nd) $1.2n+1=1-n$\uff1b\ne) $15-p=\\frac13p-1$\uff1b\nf) $1\\frac13x+4=\\frac13x+1$\uff1b\ng) $x=-x$\uff1b\nh) $5y=6y$\u3002",
      "figure_ids": []
    },
    {
      "number": "54",
      "text": "\u6c42\u65b9\u7a0b\u7684\u89e3\u96c6\u5408\uff1a\na) $5x+3(x-1)=6x+11$\uff1b\nb) $3a-5(2-a)=54$\uff1b\nc) $8(x-7)-3(2x+9)=15$\uff1b\nd) $0.6-0.5(y-1)=y+0.5$\uff1b\ne) $6+(2-4z)+5z=3(1-3z)$\uff1b\nf) $0.4(2z-1)-(3-0.2z)+1=0$\u3002",
      "figure_ids": []
    },
    {
      "number": "55",
      "text": "a) \u5f53 $a$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u5f0f $6a-3$ \u7684\u503c\u7b49\u4e8e $-39$\uff1f\nb) \u5f53 $m$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c$2m-13$ \u548c $m+3$ \u4e24\u5f0f\u76f8\u7b49\uff1f",
      "figure_ids": []
    },
    {
      "number": "56",
      "text": "a) \u5f53 $b$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u5f0f $2b-17$ \u7684\u503c\u6bd4\u5f0f $12-b$ \u5927 4\uff1f\nb) \u5f53 $a$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u5f0f $2(3-5a)$ \u7684\u503c\u6bd4\u5f0f $4(1-a)$ \u7684\u503c\u5c0f 1\uff1f",
      "figure_ids": []
    },
    {
      "number": "57",
      "text": "\u89e3\u65b9\u7a0b\uff1a\na) $y:71=11:56$\uff1b\nb) $24:x=36:5$\uff1b\nc) $10.8:1.2=x:13.6$\uff1b\nd) $6\\frac12:3\\frac14=x:2\\frac13$\uff1b\ne) $30.6:y=5.4:1.8$\uff1b\nf) $8.5:0.5=6.8:a$\uff1b\ng) $3.12:0.26=m:1.5$\uff1b\nh) $\\frac57:1\\frac1{14}=\\frac38:p$\u3002",
      "figure_ids": []
    },
    {
      "number": "58",
      "text": "\u6c42\u65b9\u7a0b\u7684\u89e3\u96c6\u5408\uff1a\na) $x+4=x+7$\uff1b\nb) $2x+78=78+2x$\uff1b\nc) $17(2x+1)=34x+17$\uff1b\nd) $3(x+1)=3x+4$\u3002",
      "figure_ids": []
    },
    {
      "number": "59",
      "text": "\u4e00\u5ea7\u57ce\u5e02\u8ba1\u5212\u65b0\u589e 4700 \u8f86\u516c\u4ea4\u8f66\uff0c\u5176\u4e2d\u666e\u901a\u516c\u4ea4\u8f66\u6bd4\u7535\u52a8\u516c\u4ea4\u8f66\u591a 300\u8f86\u3002\u8ba1\u5212\u65b0\u589e\u591a\u5c11\u8f86\u7535\u52a8\u516c\u4ea4\u8f66\u548c\u591a\u5c11\u8f86\u666e\u901a\u516c\u4ea4\u8f66\uff1f",
      "figure_ids": []
    },
    {
      "number": "60",
      "text": "\u7b49\u8170\u4e09\u89d2\u5f62\u7684\u5468\u957f\u7b49\u4e8e $16\\text{ cm}$\uff0c\u8170\u6bd4\u5e95\u957f $2.9\\text{ cm}$\u3002\u4e09\u89d2\u5f62\u7684\u8fb9\u957f\u600e\u6837\uff1f",
      "figure_ids": []
    },
    {
      "number": "61",
      "text": "\u5de5\u5382\u7684\u4e09\u4e2a\u8f66\u95f4\u6709 2740 \u4e2a\u5de5\u4eba\u3002\u7b2c\u4e8c\u8f66\u95f4\u6bd4\u7b2c\u4e00\u8f66\u95f4\u591a 140 \u4eba\uff0c\u7b2c\u4e09\u8f66\u95f4\u662f\u7b2c\u4e8c\u8f66\u95f4\u7684 1.2 \u500d\u3002\u6c42\u6bcf\u4e2a\u8f66\u95f4\u7684\u4eba\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "62",
      "text": "\u5236\u4f5c\u6bdb\u8863\u3001\u5e3d\u5b50\u548c\u56f4\u5dfe\u603b\u5171\u7528\u4e86 555 \u514b\u7f8a\u6bdb\uff0c\u5176\u4e2d\u7528\u4e8e\u5e3d\u5b50\u7684\u7f8a\u6bdb\u662f\u7528\u4e8e\u6bdb\u8863\u7684\u4e94\u5206\u4e4b\u4e00\uff0c\u4f46\u6bd4\u7528\u4e8e\u56f4\u5dfe\u7684\u7f8a\u6bdb\u8981\u591a 5 \u514b\u3002\u6c42\u6bcf\u4ef6\u5236\u54c1\u7528\u4e86\u591a\u5c11\u7f8a\u6bdb\u3002",
      "figure_ids": []
    },
    {
      "number": "63",
      "text": "\u516c\u56ed\u91cc\uff0c\u4e00\u5757\u5730\u4e0a\u79cd\u7684\u8986\u76c6\u5b50\u6811\u662f\u53e6\u4e00\u5757\u5730\u4e0a\u7684\u4e94\u500d\u3002\u4ece\u524d\u4e00\u5757\u5730\u79fb\u690d 22 \u68f5\u5230\u540e\u4e00\u5757\u5730\u4e0a\uff0c\u4e24\u5757\u5730\u4e0a\u68f5\u6570\u53d8\u6210\u4e00\u6837\u591a\u4e86\u3002\u79fb\u690d\u4ee5\u524d\u6bcf\u5757\u5730\u5404\u6709\u6811\u591a\u5c11\u68f5\uff1f",
      "figure_ids": []
    },
    {
      "number": "64",
      "text": "\u4e00\u4e2a\u8d2e\u6c34\u6c60\u5185\u6709\u6c34 $380\\text{ m}^3$\uff0c\u53e6\u4e00\u4e2a\u6709\u6c34 $1500\\text{ m}^3$\u3002\u7b2c\u4e00\u4e2a\u8d2e\u6c34\u6c60\u6bcf\u5c0f\u65f6\u8fdb\u6c34 $80\\text{ m}^3$\uff0c\u7b2c\u4e8c\u4e2a\u6bcf\u5c0f\u65f6\u62bd\u51fa $60\\text{ m}^3$\u3002\u7ecf\u8fc7\u51e0\u5c0f\u65f6\u4ee5\u540e\uff0c\u4e24\u4e2a\u8d2e\u6c34\u6c60\u5185\u6c34\u4e00\u6837\u591a\uff1f",
      "figure_ids": []
    },
    {
      "number": "65",
      "text": "\u6c42\u5f0f\u7684\u5b9a\u4e49\u57df\uff1a\na) $\\frac{14}{5x-3}$\uff1b\nb) $\\frac{24y}{117-10y}$\uff1b\nc) $\\frac{3a+7}{5a+1}$\uff1b\nd) $\\frac{7x^2}{18+21x}$\uff1b\ne) $\\frac y7$\uff1b\nf) $\\frac{32}{y}$\u3002",
      "figure_ids": []
    },
    {
      "number": "66",
      "text": "\u4ee5 $O(3,-4)$ \u4e3a\u5706\u5fc3\u4f5c\u534a\u5f84\u7b49\u4e8e 5 \u7684\u5706\u3002\u6c42\u5706\u548c $x$ \u8f74\u4e0e$y$ \u8f74\u4ea4\u70b9\u7684\u5750\u6807\u3002",
      "figure_ids": []
    },
    {
      "number": "67",
      "text": "\u4efb\u610f\u6307\u51fa\u53d8\u91cf $m$ \u548c $n$ \u7684\u4e24\u5bf9\u503c $(m,n)$\uff0c\u4f7f\u542b\u4e24\u4e2a\u53d8\u91cf\u7684\u8bed\u53e5\u2014\u2014\u201c\u6570 $m$ \u6bd4\u6570 $n$ \u5927 4\u201d\u2014\u2014\u53d8\u6210\u771f\u547d\u9898\u3002",
      "figure_ids": []
    },
    {
      "number": "68",
      "text": "\u5df2\u77e5\u4e24\u4e2a\u96c6\u5408\uff1a$A=\\{1,3,4,5\\}$\uff0c$B=\\{2,3\\}$\u3002\u7528\u96c6\u5408 $A$\u91cc\u7684\u5143\u7d20\u4f5c\u4e3a\u5341\u4f4d\u4e0a\u7684\u6570\u5b57\uff0c\u7528\u96c6\u5408 $B$ \u91cc\u7684\u5143\u7d20\u4f5c\u4e3a\u4e2a\u4f4d\u4e0a\u7684\u6570\u5b57\uff0c\u7ec4\u6210\u4e24\u4f4d\u6570\uff0c\u628a\u8fd9\u6837\u7684\u4e24\u4f4d\u6570\u90fd\u5199\u51fa\u6765\u3002",
      "figure_ids": []
