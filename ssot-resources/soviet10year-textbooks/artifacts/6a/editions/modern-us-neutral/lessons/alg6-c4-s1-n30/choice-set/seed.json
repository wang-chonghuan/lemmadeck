  "concepts": [
    {
      "block": 2,
      "text": "定义 1．$n$ 个相同因数 $a$ 的乘积，叫做数 $a$ 的 $n$ 次幂（$n$是自然数，且 $n>1$）．"
    },
    {
      "block": 3,
      "text": "数 $a$ 的 $n$ 次幂通常记作：\n$a^n$．"
    },
    {
      "block": 4,
      "text": "根据定义，$a^n=\\underbrace{a\\cdot a\\cdots a}_{n\\text{ 个}}$．"
    },
    {
      "block": 6,
      "text": "定义 2．$a$ 的 1 次幂就是数 $a$ 本身：\n$a^1=a$．"
    }
  ],
