  "exercises": [
    {
      "number": "317",
      "text": "\u5728\u540c\u4e00\u5750\u6807\u7cfb\u91cc\u4f5c\u51fa\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u7ebf\u6027\u51fd\u6570\u7684\u56fe\u8c61\uff1a\na) $y=2x,$ $y=2x-3,$ $y=2x+4$\nb) $y=-0.5x,$ $y=-0.5x-2,$ $y=-0.5x+3$\u3002\u6307\u51fa\u6bcf\u4e00\u6761\u76f4\u7ebf\u7684\u7cfb\u6570 $k$ \u548c $l$ \u7684\u503c\u3002\u56fe\u8c61\u7684\u76f8\u4e92\u4f4d\u7f6e\u600e\u6837\uff1f",
      "figure_ids": []
    },
    {
      "number": "318",
      "text": "\u5728\u540c\u4e00\u5750\u6807\u7cfb\u91cc\u4f5c\u51fa\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u7ebf\u6027\u51fd\u6570\u7684\u56fe\u8c61\uff1a\na) $y=0.5x-2,$ $y=3x-2,$ $y=-2x-2$\nb) $y=-4x+1,$ $y=3x+1,$ $y=0x+1$\u3002\u6307\u51fa\u6bcf\u4e00\u6761\u76f4\u7ebf\u7684\u7cfb\u6570 $k$ \u548c $l$ \u7684\u503c\u3002\u8bf4\u51fa\u6bcf\u4e2a\u56fe\u8c61\u548c $y$\u8f74\u4ea4\u70b9\u7684\u5750\u6807\u3002",
      "figure_ids": []
    },
    {
      "number": "319",
      "text": "\u4e0b\u9762\u7528\u5f0f\u5b50\u7ed9\u51fa\u7684\u51fd\u6570\uff0c\u4e0d\u4f5c\u5b83\u4eec\u7684\u56fe\u8c61\uff0c\u8bf4\u51fa\u56fe\u8c61\u548c$x$ \u8f74\u7684\u503e\u659c\u89d2\u662f\u9510\u89d2\u8fd8\u662f\u949d\u89d2\uff0c\u4ee5\u53ca\u56fe\u8c61\u548c $y$ \u8f74\u7684\u4ea4\u70b9\uff1a\na) $y=4.3x-7$\uff1b\nb) $y=-2.4x+9.6$\uff1b\nc) $y=-0.7x-28$\uff1b\nd) $y=1.2x+6$\uff1b\ne) $y=-5x+2$\uff1b\nf) $y=0.4x-12$\u3002",
      "figure_ids": []
    },
    {
      "number": "320",
      "text": "\u5728\u56fe\u4e0a\u753b\u51fa\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u7684\u5927\u81f4\u4f4d\u7f6e\uff1a\na) $y=7x-1$\uff1b\nb) $y=-3x+2$\uff1b\nc) $y=21x-5$\uff1b\nd) $y=0x+3$\u3002",
      "figure_ids": []
    },
    {
      "number": "321",
      "text": "\u5f0f $y=kx+6$ \u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u3002\u5f53 $k$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u8fd9\u4e2a\u51fd\u6570\u7684\u56fe\u8c61\u548c\u4e0b\u5217\u5404\u5f0f\u7ed9\u51fa\u7684\u51fd\u6570\u7684\u56fe\u8c61\u5e73\u884c\uff1f\na) $y=-3x+7$\uff1b\nb) $y=100x-1$\uff1b\nc) $y=x+3.7$\uff1b\nd) $y=-8.2x$\u3002",
      "figure_ids": []
    },
    {
      "number": "322",
      "text": "\u5f0f $y=kx-10$ \u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\u3002\u5f53 $k$ \u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u8fd9\u4e2a\u51fd\u6570\u7684\u56fe\u8c61\u7ecf\u8fc7\uff1a\na) \u70b9 $M(20,0)$\uff1b\nb) $P(-4,14)$\uff1f",
      "figure_ids": []
    },
    {
      "number": "323",
      "text": "\u56fe $81$ \u4e0a\u753b\u51fa\u4e86\u4e24\u4e2a\u7ebf\u6027\u51fd\u6570\u7684\u56fe\u8c61\u3002\u5bf9\u4e8e\u6bcf\u4e00\u4e2a\u56fe\u8c61\uff1a\na) \u7ed9\u51fa\u7ebf\u6027\u51fd\u6570\u7684\u5f0f\u662f $y=kx+l$\uff0c\u6c42 $l$ \u7684\u503c\uff1b\nb) \u6c42\u51fa $l$ \u7684\u503c\u4ee5\u540e\uff0c\u4ece\u56fe\u8c61\u4e0a\u4efb\u9009\u4e00\u70b9\uff0c\u6c42\u51fa\u5b83\u7684\u5750\u6807\uff0c\u7136\u540e\u6c42\u51fa\u659c\u7387 $k$\u3002",
      "figure_ids": [
        "fig-81"
      ]
    },
    {
      "number": "324",
      "text": "\u56fe $82$ \u4e0a\u753b\u51fa\u4e86\u51e0\u4e2a\u7ebf\u6027\u51fd\u6570\u7684\u56fe\u8c61\u3002\u7528\u5f0f\u8868\u793a\u5176\u4e2d\u6bcf\u4e00\u4e2a\u51fd\u6570\u3002",
      "figure_ids": [
        "fig-82"
      ]
    },
    {
      "number": "325",
      "text": "\u7ecf\u8fc7\u79f0\u91cd\u4ee5\u540e\uff0c\u5f97\u5230\u7164\u6cb9\u7f50\u8fde\u540c\u7164\u6cb9\u7684\u8d28\u91cf $m$\uff08\u516c\u65a4\uff09\u548c\u7164\u6cb9\u5bb9\u79ef $V$\uff08\u5347\uff09\u4e4b\u95f4\u7684\u5173\u7cfb\u8868\uff1a\u4f5c\u51fa\u56fe\u8c61\uff0c\u8bf4\u660e $m$ \u5bf9 $V$ \u7684\u4f9d\u8d56\u5173\u7cfb\u662f\u7ebf\u6027\u51fd\u6570\u3002\u6c42\u7a7a\u7f50\u7684\u8d28\u91cf\u3002$1$ \u5347\u7164\u6cb9\u7684\u8d28\u91cf\u662f\u591a\u5c11\u516c\u65a4\uff1f",
      "figure_ids": [
        "tbl-p0100-03"
      ]
    },
    {
      "number": "326",
      "text": "\u5df2\u77e5\u51e0\u4e2a\u5c0f\u6570\u7684\u96c6\u5408 $A=\\{0.05,0.2,0.25,0.3\\}$ \u548c\u51e0\u4e2a\u5206\u6570\u7684\u96c6\u5408 $B=\\{\\frac{1}{3},\\frac{3}{15},\\frac{1}{20},\\frac{7}{28},\\frac{9}{45}\\}$\u3002\u7528\u8bed\u53e5\u201c$a$ \u7b49\u4e8e $b$\u201d\uff08\u5176\u4e2d $a\\in A,b\\in B$\uff09\u7ed9\u51fa\u96c6\u5408 $A$ \u548c $B$ \u7684\u5143\u7d20\u7684\u5173\u7cfb\u3002\u7528\u5217\u6570\u5bf9\u6cd5\u7ed9\u51fa\u8fd9\u79cd\u5173\u7cfb\u3002",
      "figure_ids": []
    },
    {
      "number": "327",
      "text": "\u6469\u6258\u8247\u987a\u6c34\u800c\u4e0b\uff0c\u884c\u9a76 $2$ \u5c0f\u65f6 $15$ \u5206\u949f\u3002\u5982\u679c\u6469\u6258\u8247\u5728\u9759\u6c34\u4e2d\u7684\u901f\u5ea6\u662f $14$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u6c34\u6d41\u901f\u5ea6\u662f $2$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u8fd4\u7a0b\u65f6\u6469\u6258\u8247\u9700\u884c\u9a76\u51e0\u5c0f\u65f6\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5f0f $y=kx+l$ \u7ed9\u51fa\u7684\u51fd\u6570\uff0c\u5b83\u7684\u56fe\u8c61\u7684\u4f4d\u7f6e\u51b3\u5b9a\u4e8e $k$ \u548c $l$\u7684\u503c\u7684\u5927\u5c0f\u3002"
    },
    {
      "block": 6,
      "text": "\u7cfb\u6570 $k$ \u51b3\u5b9a\u7ebf\u6027\u51fd\u6570\u7684\u56fe\u8c61\u5bf9 $x$ \u8f74\u7684\u503e\u659c\u89d2\u7684\u5927\u5c0f\u3002\n\u5982\u679c $k$ \u662f\u6b63\u6570\uff0c\u90a3\u4e48\u503e\u659c\u89d2\u662f\u9510\u89d2\uff08\u56fe $79$a\uff09\uff1b\n\u5982\u679c $k$ \u662f\u8d1f\u6570\uff0c\u90a3\u4e48\u503e\u659c\u89d2\u662f\u949d\u89d2\uff08\u56fe $79$b\uff09\u3002\n\n\u6570 $k$ \u53eb\u505a\u76f4\u7ebf\u7684\u659c\u7387\u3002"
    },
    {
      "block": 8,
      "text": "\u5982\u679c $x=0$\uff0c\u90a3\u4e48 $y=l$\u3002\n\u5c31\u662f\u8bf4\uff0c\u7ebf\u6027\u51fd\u6570\u7684\u56fe\u8c61\u548c $y$ \u8f74\u7684\u4ea4\u70b9\uff0c\u7eb5\u5750\u6807\u7b49\u4e8e $l$\u3002"
    }
  ],
