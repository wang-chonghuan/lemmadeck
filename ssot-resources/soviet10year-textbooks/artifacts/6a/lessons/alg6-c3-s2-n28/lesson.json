  "chapter": "第三章　方程组",
  "section": "§9. 线性方程组",
  "number": "28",
  "title": "加减消元法",
  "printed_title": "28. 加减消元法",
  "start_page": 138,
  "start_printed": 132,
  "figures": [
    {
      "id": "fig-104",
      "label": "图 104",
      "page": 139
    },
    {
      "id": "fig-105",
      "label": "图 105",
      "page": 139
    },
    {
      "id": "tbl-p0144-01",
