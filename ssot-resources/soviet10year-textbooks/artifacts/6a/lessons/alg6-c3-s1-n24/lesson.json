  "chapter": "第三章　方程组",
  "section": "§8．二元方程组的概念",
  "number": "24",
  "title": "二元线性方程",
  "printed_title": "24．二元线性方程",
  "start_page": 126,
  "start_printed": 120,
  "figures": [
    {
