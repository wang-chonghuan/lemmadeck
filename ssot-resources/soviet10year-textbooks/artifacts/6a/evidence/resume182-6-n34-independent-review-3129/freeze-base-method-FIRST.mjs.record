import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import { execFileSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
assert.equal(process.cwd(), repo);
const startedAt = new Date().toISOString();
const base = '.tmp/ld-s10y-lesson/resume182-6-3129/N1-independent-review-20261122-FIRST';
const source = 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c1-s1-n1/choice-set';
const bytes = Object.fromEntries(['seed.json', 'draft.json', 'review.json']
  .map(name => [name, fs.readFileSync(`${source}/${name}`)]));
const seed = JSON.parse(bytes['seed.json']);
const draft = JSON.parse(bytes['draft.json']);
const review = JSON.parse(bytes['review.json']);
assert.equal(seed.source.book, '8a');
assert.equal(seed.source.lesson, 'alg8-c1-s1-n1');
assert.equal(seed.exercises.length, 6);
assert.equal(seed.figures.length, 0);
assert.equal(draft.new_figures.length, 0);
assert.equal(draft.questions.length, 6);
assert.equal(draft.questions.reduce((sum, question) => sum + question.view.options.length, 0), 21);
assert.equal(review.reviewer.kind, 'self_review');
const digest = name => execFileSync('python3',
  ['.agents/skills/ld-s10y-choice/scripts/prepare.py', 'digest', `${source}/${name}`],
  { cwd: repo, encoding: 'utf8', env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1' } }).trim();
const seedDigest = digest('seed.json');
const draftDigest = digest('draft.json');
assert.equal(draft.seed_sha256, seedDigest);
assert.equal(review.seed_sha256, seedDigest);
assert.equal(review.draft_sha256, draftDigest);
const output = `${base}/author`;
assert.ok(!fs.existsSync(output), 'Preserve earlier snapshots');
fs.mkdirSync(output, { recursive: true });
const hash = value => crypto.createHash('sha256').update(value).digest('hex');
const save = (file, value) => {
  fs.writeFileSync(file, value, { flag: 'wx', mode: 0o444 });
  return { path: file, sha256: hash(value), bytes: value.length };
};
const inputs = [
  save(`${output}/seed.json`, bytes['seed.json']),
  save(`${output}/draft.json`, bytes['draft.json']),
  save(`${output}/prior-self-review.json.record`, bytes['review.json']),
];
const visible = {
  seed_sha256: seedDigest,
  draft_sha256: draftDigest,
  questions: draft.questions.map(question => ({
    id: question.id,
    source_numbers: question.source_numbers,
    view: question.view,
  })),
};
assert.ok(!JSON.stringify(visible).includes('"correct"'));
const view = save(`${base}/view-only-FIRST.json`, Buffer.from(`${JSON.stringify(visible, null, 2)}\n`));
const record = {
  status: 'EXISTING_N1_SNAPSHOT_FROZEN_NO_REAUTHORING',
  workdir: repo, startedAt, endedAt: new Date().toISOString(),
  seed_sha256: seedDigest, draft_sha256: draftDigest,
  inputs, view,
  originalCanonicalOutputsUnchanged: true,
  previousSelfReviewNotAC3Approval: true,
  independentReviewerPhase1MayNotReadAuthorOrViewPacket: true,
  noNewFiguresOrImageReads: true,
  nativeDigestCommands: 2,
  validatorsAuthorsRenderersBrowsersDatabaseCalls: 0,
  fees: 'UNKNOWN',
};
save(`${base}/freeze-FIRST.record`, Buffer.from(`${JSON.stringify(record, null, 2)}\n`));
console.log(JSON.stringify(record));
