import assert from 'node:assert/strict';
import fs from 'node:fs';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/ld-s10y-lesson/resume182-6-3129';
let code = fs.readFileSync(`${base}/freeze-N1-existing-snapshot-FIRST.mjs`, 'utf8');
for (const [before, after] of [
  ['N1-independent-review-20261122-FIRST', 'N34-independent-review-20261122-FIRST'],
  ['/artifacts/8a/', '/artifacts/6a/'],
  ['alg8-c1-s1-n1', 'alg6-c4-s1-n34'],
  ["assert.equal(seed.source.book, '8a');", "assert.equal(seed.source.book, '6a');"],
  ['assert.equal(seed.exercises.length, 6);', 'assert.equal(seed.exercises.length, 9);'],
  ['assert.equal(draft.questions.length, 6);', 'assert.equal(draft.questions.length, 9);'],
  ['question.view.options.length, 0), 21);', 'question.view.options.length, 0), 31);'],
  ['EXISTING_N1_SNAPSHOT_FROZEN_NO_REAUTHORING', 'EXISTING_N34_SNAPSHOT_FROZEN_NO_REAUTHORING'],
]) {
  assert.ok(code.includes(before), before);
  code = code.replaceAll(before, after);
}
await import(`data:text/javascript;base64,${Buffer.from(code).toString('base64')}`);
