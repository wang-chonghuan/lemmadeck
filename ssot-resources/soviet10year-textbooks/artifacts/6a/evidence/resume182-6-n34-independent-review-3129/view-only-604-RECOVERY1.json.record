  "questions": [
    {
      "id": "parameter-quotients-including-possible-zero-input",
      "source_numbers": [
        "604"
      ],
      "view": {
        "mode": "single",
        "stem": "考察 $3^n:3$（$n\\in N$）及 $3^k:3$（$k\\in N,\\ k\\ge5$）。只使用本课已定义的非负整数幂：分别记录第一式在 $n\\ge1$ 时的幂、若 $0\\in N$ 时 $n=0$ 的商及其能否写成这种3的幂，再记录第二式的幂。原书的 $N$ 是否含0未指定，本题不替它选取约定。哪份完整记录正确？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "当 $n\\ge1$ 时第一式为 $3^{n+1}$；若 $n=0$，商为 $3$，可写为 $3^1$；第二式为 $3^{k+1}$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "当 $n\\ge1$ 时第一式为 $3^{n-1}$；若 $n=0$，商为 $1/3$，不能写成底数为3的非负整数幂；第二式为 $3^{k-1}$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "当 $n\\ge1$ 时第一式为 $3^n$；若 $n=0$，商为 $1$，可写为 $3^0$；第二式为 $3^k$。",
            "figure_ids": []
          }
        ]
      }
    }
  ]
}
