import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import { execFileSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/ld-s10y-lesson/resume182-6-3129';
const working = `${base}/N34-independent-review-20261122-FIRST`;
const originalBytes = fs.readFileSync(`${working}/author/draft.json`);
const original = JSON.parse(originalBytes);
const draft = structuredClone(original);
const id = 'parameter-quotients-including-possible-zero-input';
const question = draft.questions.find(item => item.id === id);
assert.equal(question.source_numbers.join(), '604');
question.view.stem = '考察 $3^n:3$（$n\\in N$）及 $3^k:3$（$k\\in N,\\ k\\ge5$）。只使用本课已定义的非负整数幂：分别记录第一式在 $n\\ge1$ 时的幂、若 $0\\in N$ 时 $n=0$ 的商及其能否写成这种3的幂，再记录第二式的幂。原书的 $N$ 是否含0未指定，本题不替它选取约定。哪份完整记录正确？';
const options = {
  A: '当 $n\\ge1$ 时第一式为 $3^{n+1}$；若 $n=0$，商为 $3$，可写为 $3^1$；第二式为 $3^{k+1}$。',
  B: '当 $n\\ge1$ 时第一式为 $3^{n-1}$；若 $n=0$，商为 $1/3$，不能写成底数为3的非负整数幂；第二式为 $3^{k-1}$。',
  C: '当 $n\\ge1$ 时第一式为 $3^n$；若 $n=0$，商为 $1$，可写为 $3^0$；第二式为 $3^k$。',
};
for (const option of question.view.options) option.text = options[option.id];
question.intent.task = '完整表示两个参数商，保留n=1产生零指数，以及若N含0时商为1/3但不能在本课非负整数幂范围内写成3的幂的边界；不猜N的零约定。';
question.intent.unit_reason = '两个符号商组成同一完整条件记录；n的可能边界与k>=5的保证范围分别保留。只使用原课的正整数幂和非零底数零次幂，不引入负指数定义。';
question.intent.limitations = [
  '识别完整条件记录不能证明自主推导两个参数商。',
  '原书N是否含0仍未知；本题条件处理两种可能域，不声称恢复原书约定。若n=0，则记录已知商值1/3以及本课已定义幂范围内不能表示这一事实，不教负指数，也不把额外倒数幂记号当源方法。',
];
question.intent.source_solution = 'For n>=2, cancel one factor 3 to obtain 3^(n-1). For n=1, 3/3=1=3^0 by the original zero-power definition. If the original N includes0, n=0 gives the known numerical quotient3^0/3=1/3. Every3^m with a nonnegative integer m is at least1: m=0 gives1, and m>=1 is a product of positive factors3 and is at least3. Therefore1/3 cannot be written as a power of3 in the original lesson-defined nonnegative-integer range. This is the smaller-numerator-exponent boundary described by the original lesson, not a negative-power extension. The original N membership remains UNKNOWN. For k>=5,3^k/3=3^(k-1), with k-1>=4; no zero-domain decision is needed. All quotients have nonzero denominator3.';
const rationale = question.key.rationales.find(item => item.option_id === 'B');
rationale.derivation = 'n>=1时指数减1，n=1结果3^0=1。若n=0，原商为1/3；对任意非负整数m，3^m>=1，故在本课定义范围内不能把1/3写成3的幂。k>=5时指数k-1至少为4。各分支完整且不假定原书N的零约定，不使用负幂定义。';
question.key.rationales.find(item => item.option_id === 'A').derivation = '误把除以3当乘以3，生成3^(n+1)及3^(k+1)；若n=0，这个错误程序给3=3^1。其表示形式内部一致，但原商此时是1/3。对正n、k，该候选均为实际商的九倍。';
question.key.rationales.find(item => item.option_id === 'C').derivation = '丢掉除数3，保留分子3^n与3^k；若n=0，错误程序保留3^0=1。其表示形式内部一致，但实际商是1/3；正n、k时该候选均为实际商的三倍。';
draft.coverage.find(item => item.source_number === '604').reason = '两个源参数形式、n=1零幂和k>=5完整保留。原书N含0约定仍未知；若n=0，条件记录商1/3及其不能在本课已定义非负整数幂范围内表示，不引入负指数、不假定N从1开始。条件记录没有解决原书域约定，但避免丢掉可能域，并保留原课较小分子指数不能按已定义幂表示的边界。识别仍不能证明独立书面推导。';
for (const item of draft.questions.filter(item => item.id !== id))
  assert.deepEqual(item, original.questions.find(previous => previous.id === item.id));
for (const item of draft.coverage.filter(item => item.source_number !== '604'))
  assert.deepEqual(item, original.coverage.find(previous => previous.source_number === item.source_number));
assert.equal(draft.questions.length, 9);
assert.equal(draft.questions.reduce((sum, item) => sum + item.view.options.length, 0), 31);
assert.deepEqual(question.key.correct, original.questions.find(item => item.id === id).key.correct);
const output = `${working}/repair604-RECOVERY1`;
assert.ok(!fs.existsSync(output));
fs.mkdirSync(output, { recursive: true });
const save = (file, bytes) => {
  fs.writeFileSync(file, bytes, { flag: 'wx', mode: 0o444 });
  return { path: file, sha256: crypto.createHash('sha256').update(bytes).digest('hex'), bytes: bytes.length };
};
const snapshot = save(`${output}/draft.json`, Buffer.from(`${JSON.stringify(draft, null, 2)}\n`));
const digest = execFileSync('python3',
  ['.agents/skills/ld-s10y-choice/scripts/prepare.py', 'digest', snapshot.path],
  { cwd: repo, encoding: 'utf8', env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1' } }).trim();
const view = save(`${output}/view-only-604.json`, Buffer.from(`${JSON.stringify({
  seed_sha256: draft.seed_sha256, draft_sha256: digest,
  questions: [{ id: question.id, source_numbers: question.source_numbers, view: question.view }],
}, null, 2)}\n`));
const record = {
  status: 'N34_604_LOCAL_POWER_BOUNDARY_REPAIRED_REVIEW_PENDING',
  workdir: repo, date: new Date().toISOString(),
  snapshot, view, seed_sha256: draft.seed_sha256, draft_sha256: digest,
  affectedSources: ['604'], affectedQuestions: [id], affectedOptions: 3,
  unchangedQuestions: 8, unchangedOptions: 28,
  source604NMembership: 'UNKNOWN preserved',
  newNegativeExponentDefinition: false,
  oldBlockedSnapshotAndReportsPreserved: true,
  nativeValidatorsRun: 0, contentRevisionsThisRecovery: 1,
  authorSourceAnswerFigureRendererBrowserCalls: 0, newImagesOpened: 0,
  fees: 'UNKNOWN',
};
save(`${output}/repair.record`, Buffer.from(`${JSON.stringify(record, null, 2)}\n`));
console.log(JSON.stringify(record));
