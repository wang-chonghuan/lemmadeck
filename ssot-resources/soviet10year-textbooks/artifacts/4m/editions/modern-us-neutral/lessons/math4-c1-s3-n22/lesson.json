  "section": "§3. 方程和不等式",
  "number": "22",
  "title": "符号$\\le$和$\\ge$",
  "printed_title": "22. 符号$\\le$和$\\ge$",
  "start_page": 78,
  "start_printed": 69,
  "figures": [],
