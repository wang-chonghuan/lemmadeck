  "exercises": [
    {
      "number": "259",
      "text": "6\u662f\u4e0d\u662f\u65b9\u7a0b$36-a=24+a$\u7684\u6839\uff1f",
      "figure_ids": []
    },
    {
      "number": "260",
      "text": "\u8bd5\u4e00\u8bd5\u75280\uff0c1\uff0c2\u548c3\u4ee3\u5165\u65b9\u7a0b$y+y=y\\cdot y$\u3002\u4e0a\u5217\u5404\u6570\u4e2d\u6709\u6ca1\u6709\u65b9\u7a0b\u7684\u6839\uff1f",
      "figure_ids": []
    },
    {
      "number": "261",
      "text": "\u89e3\u65b9\u7a0b\uff1a\na) $(c-111)\\cdot59=11\\,918$\uff1b\nb) $975\\cdot(a-459)=12\\,675$\uff1b\nc) $(30\\,901-b):605=51$\uff1b\nd) $39\\,765:(c-893)=1205$\u3002",
      "figure_ids": []
    },
    {
      "number": "262",
      "text": "\u57282\uff0c3\uff0c4\uff0c5\uff0c6\u5404\u6570\u4e2d\u627e\u51fa\u4e0b\u5217\u65b9\u7a0b\u7684\u6839\uff1a$(6-x)\\cdot(x-2)=0$\u3002",
      "figure_ids": []
    },
    {
      "number": "263",
      "text": "\u4efb\u4f55\u6570\u90fd\u662f\u4e0b\u5217\u65b9\u7a0b\u7684\u6839\u5417\uff1f\na) $0\\cdot y=0$\uff1b\nb) $7\\cdot x=7$\uff1b\nc) $8\\cdot a=a\\cdot8$\uff1b\nd) $9+k-k=9$\u3002",
      "figure_ids": []
    },
    {
      "number": "264",
      "text": "\u4e0b\u5217\u65b9\u7a0b\u6709\u6ca1\u6709\u4e00\u4e2a\u6839\uff1f\na) $x+16=12$\uff1b\nb) $x+12=16$\uff1b\nc) $x+2=4$\uff1b\nd) $x\\cdot x+3=0$\u3002",
      "figure_ids": []
    },
    {
      "number": "265",
      "text": "\u516b\u8fb9\u5f62\u7684\u5468\u957f\u4e3a24\u5398\u7c73\uff08\u56fe79\uff09\u3002\u5217\u65b9\u7a0b\u5e76\u6c42\u89e3\u3002\u8fd9\u4e2a\u65b9\u7a0b\u7684\u6839\u8868\u793a\u4ec0\u4e48\uff1f",
      "figure_ids": [
        "fig-79"
      ]
    },
    {
      "number": "266",
      "text": "\u6839\u636e\u56fe80\u5217\u65b9\u7a0b\u5e76\u6c42\u51fa\u6bcf\u76d2\u9762\u7c89\u7684\u8d28\u91cf\u3002",
      "figure_ids": [
        "fig-80"
      ]
    },
    {
      "number": "267",
      "text": "\u5217\u65b9\u7a0b\u89e3\u4e0b\u5217\u5404\u5e94\u7528\u9898\uff1a\na) \u7bee\u5b50\u91cc\u6709\u4e00\u4e9b\u8611\u83c7\u3002\u4ece\u7bee\u5b50\u91cc\u5148\u62ff\u8d7010\u4e2a\u8611\u83c7\uff0c\u7136\u540e\u53c8\u653e\u8fdb14\u4e2a\uff0c\u8fd9\u65f6\u7bee\u5b50\u91cc\u670985\u4e2a\u8611\u83c7\u3002\u7bee\u5b50\u91cc\u539f\u6765\u6709\u591a\u5c11\u4e2a\u8611\u83c7\uff1f\nb) \u4e00\u4e2a\u7537\u5b69\u539f\u6765\u670916\u7f8e\u5206\u3002\u7ed9\u4e86\u4ed6\u4e00\u4e9b\u7f8e\u5206\u4ee5\u540e\uff0c\u4ed6\u82b1\u4e8623\u7f8e\u5206\uff0c\u7ed3\u679c\u8fd8\u5269\u4e0b19\u7f8e\u5206\u3002\u7ed9\u4e86\u4ed6\u591a\u5c11\u7f8e\u5206\uff1f\nc) \u4e24\u4e2a\u6b65\u884c\u7684\u4eba\u4ece\u4e24\u4e2a\u6751\u5b50\u51fa\u53d1\u76f8\u5411\u800c\u884c\uff0c\u4ed6\u4eec\u8d70\u4e864\u5c0f\u65f6\u540e\u76f8\u9047\u3002\u4e24\u4e2a\u6751\u5b50\u7684\u8ddd\u79bb\u662f36\u516c\u91cc\u3002\u5176\u4e2d\u4e00\u4e2a\u4eba\u7684\u901f\u5ea6\u4e3a4\u516c\u91cc/\u5c0f\u65f6\u3002\u6c42\u53e6\u4e00\u4e2a\u4eba\u7684\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "268",
      "text": "\u82f9\u679c\u7684\u6536\u83b7\u91cf\u4e3a$n$\u5428\uff0c\u68a8\u7684\u6536\u83b7\u91cf\u4e3a8\u5428\u3002\u5982\u679c$n=16$\uff0c24\uff0c\u82f9\u679c\u7684\u6536\u83b7\u91cf\u6bd4\u68a8\u591a\u51e0\u5428\uff1f",
      "figure_ids": []
    },
    {
      "number": "269",
      "text": "Alex\u670940\u672c\u4e66\uff0cEmma\u6709$x$\u672c\u4e66\u3002Alex\u6bd4Emma\u591a\u51e0\u672c\u4e66\uff1fAlex\u7684\u4e66\u662fEmma\u7684\u4e66\u7684\u51e0\u500d\uff1f\u5982\u679c$x=20$\uff0c$x=10$\uff0c$x=5$\uff0c\u6c42\u51fa\u5f0f\u5b50\u7684\u503c\u3002",
      "figure_ids": []
    },
    {
      "number": "270",
      "text": "\u5728\u4e00\u4e2a\u865a\u6784\u7684\u793e\u533a\u8d44\u52a9\u8ba1\u5212\u4e2d\uff0c\u4e00\u4e2a\u5c0f\u5b69\u4e00\u5e74\u7684\u5e7c\u513f\u56ed\u4fdd\u80b2\u8d39\u662f474\u7f8e\u5143\u3002\u5176\u4e2d\u5bb6\u957f\u4ed8108\u7f8e\u5143\uff0c\u5176\u4f59\u7531\u793e\u533a\u57fa\u91d1\u8865\u8d34\u30023\u5e74\u5185\u57fa\u91d1\u5bf925\u540d\u5c0f\u5b69\u9700\u8981\u8865\u8d34\u591a\u5c11\u7f8e\u5143\uff1f",
      "figure_ids": []
    },
    {
      "number": "271",
      "text": "\u4e00\u4efd\u865a\u6784\u7684\u91c7\u7164\u91cf\u6570\u636e\u8bb0\u5f55\uff1a1970\u5e74\u7532\u5730\u533a\u91c7\u7164$62\\,400$\u4e07\u5428\uff0c\u4e59\u5730\u533a\u91c7\u7164$55\\,600$\u4e07\u5428\uff1b1974\u5e74\u7532\u5730\u533a\u91c7\u7164$68\\,400$\u4e07\u5428\uff0c\u800c\u4e59\u5730\u533a\u91c7\u7164$54\\,100$\u4e07\u5428\u3002\u6c42\u6bcf\u4e2a\u5730\u533a\u91c7\u7164\u91cf\u7684\u53d8\u5316\u3002",
      "figure_ids": []
    },
    {
      "number": "272",
      "text": "\u6c42\u51fa\u56fe81\u4e2d\u7684$x$\u503c\u3002",
      "figure_ids": [
        "fig-81"
      ]
    },
    {
      "number": "273",
      "text": "\u8ba1\u7b97\uff1a\n1) $299\\,880:(195+435):17$\uff1b\n2) $162\\,540:(100\\,236-99\\,978):63$\u3002",
      "figure_ids": []
    },
    {
      "number": "274",
      "text": "\u57280\uff0c1\uff0c2\uff0c3\uff0c4\uff0c5\u548c6\u5404\u6570\u4e2d\uff0c\u6709\u6ca1\u6709\u65b9\u7a0b$y\\cdot3+80=92$\u7684\u6839\uff1f",
      "figure_ids": []
    },
    {
      "number": "275",
      "text": "\u5982\u679c$y=5719$\uff0c\u6c42\u5f0f$y:19-95$\u7684\u503c\u30025719\u662f\u4e0d\u662f\u65b9\u7a0b$y:19-95=206$\u7684\u6839\uff1f",
      "figure_ids": []
    },
    {
      "number": "276",
      "text": "\u6c7d\u8f66\u4ee560\u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u8d70\u4e86$x$\u5c0f\u65f6\uff0c\u53c8\u4ee550\u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u8d70\u4e862\u5c0f\u65f6\u3002\u6c7d\u8f66\u5171\u8d70\u4e86\u591a\u5c11\u516c\u91cc\uff1f\u5217\u51fa\u5f0f\u5b50\u3002\u5982\u679c$x=4$\uff0c5\uff0c\u6c42\u51fa\u5b83\u7684\u503c\u3002",
      "figure_ids": []
    },
    {
      "number": "277",
      "text": "\u8ba1\u7b97\uff1a\na) $362\\,978+409\\cdot(75+1236)$\uff1b\nb) $90\\,002-(7207-6902)\\cdot209$\u3002",
      "figure_ids": []
    },
    {
      "number": "278",
      "text": "\u89e3\u4e0b\u5217\u65b9\u7a0b\uff1a\na) $22\\,374:(x-125)=1243$\uff1b\nb) $38\\,007:(4223-y)=9$\u3002",
      "figure_ids": []
    },
    {
      "number": "279",
      "text": "\u4e09\u89d2\u5f62$ABC$\u7684\u5468\u957f\u7b49\u4e8e62\u5398\u7c73\uff0c$|BC|=12$\u5398\u7c73\uff1b$|AB|=|CA|$\u3002\u6c42\u8fb9$AB$\u7684\u957f\u3002",
