    {
      "number": "130",
      "text": "130. \u89e3\u4e0b\u5217\u65b9\u7a0b\uff1a\n1) $69\\cdot k=14\\,076$\uff1b\n2) $b\\cdot74=22\\,348$\uff1b\n3) $(7001+c)\\cdot42=441\\,000$\uff1b\n4) $(8001+y)\\cdot32=656\\,000$\u3002",
