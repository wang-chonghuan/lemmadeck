        "requires": ["pointRelationships"]
      },
      {
        "id": "extra-decimals",
        "description": "Frozen source pixels: two extra downward marks on that same line, just right of 14.4 and 14.5, labelled below as 14,407 and 14,513. The modern x positions remain exactly 14.407 and 14.513 in the common scale; separate lower label lanes and longer neutral label stems are declared readability changes, not rounding arrows. The 14 anchor is mapped here so both source points have within-group executable relationships.",
        "objects": ["scale-14", "extra-14-407", "extra-14-513", "extra-14-407-stem", "extra-14-513-stem", "extra-14-407-label", "extra-14-513-label"],
        "assertions": ["extra-position-407", "extra-position-513", "extra-stem-407", "extra-stem-513", "extra-label-407-in-lane", "extra-label-513-in-lane"],
        "requires": ["pointRelationships"]
      }
    ]
  },
