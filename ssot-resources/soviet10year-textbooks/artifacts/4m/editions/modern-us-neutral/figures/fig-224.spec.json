        "objects": ["scale-14", "scale-14-1", "scale-14-2", "scale-14-3", "scale-14-4", "scale-14-5", "scale-14-6", "scale-14-7", "scale-14-8", "scale-14-9", "scale-15", "scale-14-1-label", "scale-14-2-label", "scale-14-3-label", "scale-14-4-label", "scale-14-5-label", "scale-14-6-label", "scale-14-7-label", "scale-14-8-label", "scale-14-9-label"],
