    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/4m/figures/fig-42.png",
      "sha256": "7e1d31a818b560d6b117eb972aac83956ad90952ffd4cc808b4f2c831eba5504"
    },
    "authoritativeText": [
      {
        "lesson": "math4-c1-s1-n9",
        "exercise": "129",
        "text": "129. 从商店里取得的一张发票给弄坏了一角（参看图42）。请把发票复原。"
      },
      {
        "lesson": "math4-c1-s1-n9",
        "text": "Authorized currency adaptation: English invoice labels; unit-price givens 30 and 4 are cents. The surviving grand total is 2 dollars 62 cents, with the same source numbers. Keep all torn/unknown regions and intact blanks. Do not insert computed entries."
      }
    ],
    "inventory": [
      {
        "id": "source-table-lattice",
        "description": "Source four columns (item, quantity, unit price, amount), one header, three item rows, one total row. Modern additions: regularized equal column widths and complete outside table frame; damaged source rules remain masked.",
        "objects": [
          "invoice-grid",
          "invoice-title",
          "header-item",
          "header-quantity",
          "header-unit",
          "header-unit-cents",
          "header-amount"
        ],
        "assertions": [
          "invoice-dimensions"
        ],
        "requires": [
          "gridDimensions"
        ]
      },
      {
        "id": "source-row-pens",
        "description": "Source Pens row: quantity 7; complete unit-price given 30; amount hidden. English/cents labels are modern additions. No reconstructed value is present.",
        "objects": [
          "pens-item",
          "pens-quantity",
          "pens-unit"
        ],
        "assertions": [
          "tear-covers-pens-amount"
        ]
      },
      {
        "id": "source-row-pencils",
        "description": "Source Pencils row: quantity 10; complete unit-price given 4; amount hidden. English/cents labels are modern additions. No reconstructed value is present.",
        "objects": [
          "pencils-item",
          "pencils-quantity",
          "pencils-unit"
        ],
        "assertions": [
          "tear-covers-pencils-amount"
        ]
      },
      {
        "id": "source-row-notebooks",
        "description": "Source Notebooks row: quantity 6; unit-price glyph is incomplete and unreadable as a whole numeral; amount hidden. English/cents labels are modern additions. No reconstructed value is present.",
        "objects": [
          "notebooks-item",
          "notebooks-quantity"
        ],
        "assertions": [
          "tear-covers-notebooks-amount",
          "tear-covers-notebooks-unit"
        ]
      },
      {
        "id": "source-total-and-blanks",
        "description": "Source total amount 2 rubles 62 kopecks becomes the same 2 dollars 62 cents. Source total quantity and intact unit-price regions are blank, not unknown numeric entries to fabricate.",
        "objects": [
          "total-item",
          "total-dollars",
          "total-cents"
        ],
        "assertions": [
          "invoice-text-count"
        ]
      },
      {
        "id": "source-tear",
        "description": "Original irregular missing-corner region covers all three item amounts and the incomplete notebook unit-price numeral; tapered lower-left tail enters the total row, leaving the grand total readable. Modern contour is geometric; the unreadable numeral fragment is not assigned a digit.",
        "objects": [
          "invoice-tear"
        ],
        "assertions": [
          "tear-covers-pens-amount",
          "tear-covers-pencils-amount",
          "tear-covers-notebooks-amount",
          "tear-covers-notebooks-unit"
        ]
      }
    ]
  },
