  "section": "§1. 数和集合",
  "number": "10",
  "title": "符号$\\in$和$\\notin$",
  "printed_title": "10. 符号$\\in$和$\\notin$",
  "start_page": 40,
  "start_printed": 31,
  "figures": [
    {
      "id": "fig-44",
      "label": "图 44",
