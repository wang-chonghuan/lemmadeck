  "number": "58",
  "title": "小数的加法",
  "printed_title": "58. 小数的加法",
  "start_page": 213,
  "start_printed": 204,
  "figures": [
    {
      "id": "fig-222",
      "label": "图 222",
      "page": 214
    },
    {
      "id": "tbl-p0216-01",
