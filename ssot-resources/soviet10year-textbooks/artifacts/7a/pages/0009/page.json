        "а）$(x+10)(x-10)$；　б）$(y-5b)(y+5b)$；",
        "в）$(2a+3)(3-2a)$；　г）$(4-0.5b)(0.5b+4)$；",
        "д）$(x+7)^2$；　　　　е）$(a-2x)^2$；",
        "ж）$(-3+q)^2$；　　　з）$(0.2y+0.5x)^2$．"
      ]
