  "chapter": "第二章 不等式",
  "section": "§5. “小于”和“大于”关系及其性质",
  "number": "15",
  "title": "“小于”和“大于”关系的性质",
  "printed_title": "15. “小于”和“大于”关系的性质",
  "start_page": 95,
  "start_printed": 89,
  "figures": [
