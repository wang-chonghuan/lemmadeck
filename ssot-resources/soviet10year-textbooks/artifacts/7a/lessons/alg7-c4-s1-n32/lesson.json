  "title": "平方根的近似值",
  "printed_title": "32. 平方根的近似值",
  "start_page": 207,
  "start_printed": 201,
  "figures": [
    {
      "id": "fig-44",
      "label": "图 44",
      "page": 208
    },
    {
      "id": "fig-45",
      "label": "图 45",
      "page": 209
    },
    {
      "id": "tbl-p0209-02",
