import fs from 'node:fs';
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const root = 'ssot-resources/soviet10year-textbooks/artifacts/7a';
const lesson = 'alg7-c4-s1-n29';
const scope = JSON.parse(fs.readFileSync('.tmp/resume182-6-7a-n29-stage3695-recovery-selected1/staged-scope.record'));
assert.equal(scope.status, 'N29_ONLY_STAGED_WITH_REQUIRED_EVIDENCE_BYTES');
const run = args => {
  const result = spawnSync('git', args, { maxBuffer: 32 * 1024 * 1024 });
  assert.equal(result.status, 0, result.stderr.toString());
  return result.stdout;
};
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const expected = [...scope.files, ...scope.indexes.map(item => item.path)].sort();
const staged = run(['diff', '--cached', '--name-only', '-z']).toString().split('\0').filter(Boolean).sort();
assert.deepEqual(staged, expected);
assert.ok(staged.length);
const forbidden = [
  /-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/,
  /postgres(?:ql)?:\/\/[^\s"'<>]+:[^\s"'<>]+@/i,
  /\b(?:gh[pousr]_[A-Za-z0-9]{24,}|github_pat_[A-Za-z0-9_]{24,})\b/,
  /\bsk-(?:proj-)?[A-Za-z0-9_-]{24,}\b/,
  /(?:api[_-]?key|access[_-]?token|client[_-]?secret)\s*["']?\s*[:=]\s*["'][A-Za-z0-9/+_-]{24,}["']/i,
];
let bytes = 0;
for (const file of staged) {
  assert.ok(file.startsWith(`${root}/`) || file === '.intentfold/tickets/STEMROBIN-182/progress.md');
  assert.ok(!file.split('/').some(segment => /^(?:\.env(?:\..*)?|node_modules|\.venv)$/.test(segment)));
  assert.ok(!run(['ls-files', '--stage', '--', file]).toString().startsWith('120000'), file);
  const blob = run(['show', `:${file}`]);
  bytes += blob.length;
  if (!blob.includes(0)) {
    for (const pattern of forbidden) assert.ok(!pattern.test(blob.toString()), `Potential secret: ${file}`);
  }
}
for (const index of scope.indexes) {
  const blob = run(['show', `:${index.path}`]);
  assert.equal(sha(blob), index.stagedSha256);
  assert.equal(sha(fs.readFileSync(index.path)), index.workingSha256);
  const previous = JSON.parse(run(['show', `HEAD:${index.path}`]));
  const next = JSON.parse(blob);
  assert.deepEqual(next.lessons.filter(item => item.id !== lesson), previous.lessons);
  assert.equal(next.lessons.filter(item => item.id === lesson).length, 1);
  assert.ok(!next.lessons.some(item => item.id === 'alg7-c4-s1-n30'));
}
console.log(JSON.stringify({ status: 'STAGED_SCOPE_AND_SECRET_PASS', files: staged.length,
  bytes, oldIndexEntriesUnchanged: true, n30WorkingBytesPreserved: true }));
