      {
        "id": "source-axes-and-labels",
        "description": "Horizontal time axis has a right arrow and labels 0,10,...,150 below it; vertical speed axis has an up arrow and 4,8,12,16,20 left of it. The source's seconds and meters/second become English-compatible t (s) and v (m/s). No extra tick values or explanatory interval labels.",
        "objects": [
          "time-axis",
          "speed-axis",
          "time-arrow",
          "speed-arrow",
          "time-unit",
          "speed-unit"
        ],
        "assertions": [
