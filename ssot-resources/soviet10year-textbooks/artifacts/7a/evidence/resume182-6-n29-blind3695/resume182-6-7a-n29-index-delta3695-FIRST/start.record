    "const fs=require(\"fs\"),assert=require(\"assert/strict\"),crypto=require(\"crypto\");const beforePath=\".tmp/resume182-6-7a-n29-source3695-FIRST/book-before-reindex.record\",afterPath=\"ssot-resources/soviet10year-textbooks/artifacts/7a/book.json\";const b=JSON.parse(fs.readFileSync(beforePath)),a=JSON.parse(fs.readFileSync(afterPath));assert.equal(a.lessons.length,b.lessons.length+1);for(const l of b.lessons)assert.deepEqual(a.lessons.find(x=>x.id===l.id),l);const n=a.lessons.filter(l=>!b.lessons.some(x=>x.id===l.id));assert.deepEqual(n.map(l=>l.id),[\"alg7-c4-s1-n29\"]);console.log(JSON.stringify({status:\"PASS\",before:b.lessons.length,after:a.lessons.length,allPriorLessonRowsUnchanged:true,added:n.map(l=>l.id),beforeSha256:crypto.createHash(\"sha256\").update(fs.readFileSync(beforePath)).digest(\"hex\"),afterSha256:crypto.createHash(\"sha256\").update(fs.readFileSync(afterPath)).digest(\"hex\"),sourceOrMathReviewRuns:0}))"
