const fs = require("node:fs");
const crypto = require("node:crypto");

const ledgerPath = ".tmp/resume182-4-supplement-solutions-author/0909-0916.json";
const ledgerBytes = fs.readFileSync(ledgerPath);
const ledger = JSON.parse(ledgerBytes);
const sha256 = (bytes) => crypto.createHash("sha256").update(bytes).digest("hex");
let assertions = 0;
const check = (condition, message) => {
  assertions += 1;
  if (!condition) throw new Error(message);
};

const taskIds = ledger.exercises.flatMap((exercise) =>
  exercise.tasks.map((task) => task.id)
);
check(ledger.exercises.length === 8, "Exercise count");
check(taskIds.length === 21, "Clarified parent task count");
check(new Set(taskIds).size === taskIds.length, "Unique task IDs");
check(ledger.task_count === taskIds.length, "Reported task count");
for (const exercise of ledger.exercises) {
  check(
    exercise.tasks.length === ledger.counting.by_exercise[exercise.number],
    `Task mapping ${exercise.number}`
  );
}

const integers = Array.from({ length: 49 }, (_, index) => index - 24);
for (const n of integers) {
  check(n % 4 !== 0 || n % 2 === 0, `4Z subset 2Z at ${n}`);
  check(n % 6 !== 0 || n % 3 === 0, `6Z subset 3Z at ${n}`);
  const evenNotFour = n % 2 === 0 && n % 4 !== 0;
  check(
    evenNotFour === (Number.isInteger((n - 2) / 4)),
    `910 shaded congruence at ${n}`
  );
}
check(2 % 2 === 0 && 2 % 4 !== 0, "910 false-direction witness");
check(3 % 3 === 0 && 3 % 6 !== 0, "911 proper-inclusion witness");
check(1 % 3 !== 0, "912 outer-layer witness");

const task = (id) => ledger.exercises.flatMap((ex) => ex.tasks).find((t) => t.id === id);
check(task("909-c").truth === false, "909 proposition");
check(
  ["910-a", "910-b", "910-c", "910-d"].map((id) => task(id).truth).join(",") ===
    "true,false,false,true",
  "910 directions"
);
check(task("911-a").truth === false && task("911-b").truth === true, "911 directions");
for (const n of [1, 2, 3]) check(Number.isInteger(n) && n > 0, `913-a example ${n}`);
for (const n of [1 / 2, 3 / 2, 5 / 2]) check(n > 0 && !Number.isInteger(n), `913-b example ${n}`);
for (const n of [0, -1, -2]) check(Number.isInteger(n) && n <= 0, `913-c example ${n}`);

const probes = [2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10];
const inUniverse = (x) => 3 <= x && x <= 9;
const removed = {
  a: (x) => 3 <= x && x <= 6,
  b: (x) => 5 <= x && x <= 6,
  c: (x) => 3 < x && x < 9,
  d: (x) => 3 <= x && x < 9
};
const remaining = {
  a: (x) => 6 < x && x <= 9,
  b: (x) => (3 <= x && x < 5) || (6 < x && x <= 9),
  c: (x) => x === 3 || x === 9,
  d: (x) => x === 9
};
for (const part of ["a", "b", "c", "d"]) {
  for (const x of probes) {
    check(
      (inUniverse(x) && !removed[part](x)) === remaining[part](x),
      `915-${part} membership at ${x}`
    );
  }
}
check(task("915-a").answer === "(6,9]", "915-a recorded interval");
check(task("915-b").answer === "[3,5) | (6,9]", "915-b recorded interval");
check(task("915-c").answer === "{3,9}", "915-c recorded endpoints");
check(task("915-d").answer === "{9}", "915-d recorded endpoint");

const triangleCases = [
  { sides: [3, 3, 3], equilateral: true, inclusive: true, exclusive: false },
  { sides: [5, 5, 6], equilateral: false, inclusive: true, exclusive: true }
];
for (const sample of triangleCases) {
  const [a, b, c] = sample.sides;
  check(a + b > c && a + c > b && b + c > a, `Triangle validity ${sample.sides}`);
  const equalPairs = Number(a === b) + Number(a === c) + Number(b === c);
  check((equalPairs === 3) === sample.equilateral, "Equilateral membership");
  check((equalPairs >= 1) === sample.inclusive, "Inclusive isosceles membership");
  check((equalPairs === 1) === sample.exclusive, "Exclusive isosceles membership");
}

const endpointMembership = Object.fromEntries(
  ["a", "b", "c", "d"].map((part) => [
    `915-${part}`,
    Object.fromEntries([3, 5, 6, 9].map((x) => [String(x), remaining[part](x)]))
  ])
);
console.log(JSON.stringify({
  status: "pass",
  kind: "One small finite-set and endpoint check; not a proof or a source/visual review",
  ledger_path: ledgerPath,
  ledger_sha256: sha256(ledgerBytes),
  checker_sha256: sha256(fs.readFileSync(__filename)),
  exercise_count: ledger.exercises.length,
  parent_task_count: taskIds.length,
  assertion_count: assertions,
  integer_probe_range: [-24, 24],
  integer_probe_count: integers.length,
  interval_probe_count_per_part: probes.length,
  interval_membership_comparisons: probes.length * 4,
  triangle_witness_count: triangleCases.length,
  endpoint_membership: endpointMembership,
  limitations: [
    "Finite probes supplement the analytic derivations in the ledger; they do not prove infinite-set inclusions.",
    "No image is loaded and no drawing is checked.",
    "909 zero convention, 914 ambient domain, and 916 isosceles definition remain source caveats, not human decisions.",
    "No modern wording, historical answer, reviewer root, network, DB, or external dependency is accessed."
  ]
}, null, 2));
