          "conclusion": "两地距离可以为 48 千米或 60 千米，两者均满足原题。",
          "substitution_receipt": "v=12：30/12+18/9=5/2+2=9/2 小时，计划 48/12=4 小时。v=15：30/15+30/12=2+5/2=9/2 小时，计划 60/15=4 小时。"
        },
        {
          "id": "1025b",
          "source_label": "б",
          "source_excerpt": "摩托车手用$5$小时行驶从$M$地到$N$地的距离。在返回的路程上，前$36$公里用同样的速度行驶，行驶剩下的路程时，他把速度增加$3$公里/小时。如果他在返回的路程上比在从$M$到$N$的路程上少用$15$分钟，求摩托车手行驶的速度。",
          "variables": "设去程速度为 v 千米/小时，全程 D=5v 千米。返程先走 36 千米，之后的加速段为 5v-36 千米。",
          "unit_conversions": ["15 分钟 = 1/4 小时", "返程时间 = 5-1/4 = 19/4 小时"],
          "domain": ["v>0", "v+3>0", "5v-36>0", "v>36/5"],
          "model": "36/v + (5v-36)/(v+3) = 19/4",
          "derivation": [
            "加速段节省时间为 3(5v-36)/(v(v+3))=1/4。",
            "乘以正数 4v(v+3)：12(5v-36)=v(v+3)。",
            "整理得 v^2-57v+432=0，即 (v-9)(v-48)=0。"
          ],
          "branches": [
            {"candidate": "9", "admissible": true, "reason": "全程 45 千米，加速段 9 千米，加速后速度 12。"},
