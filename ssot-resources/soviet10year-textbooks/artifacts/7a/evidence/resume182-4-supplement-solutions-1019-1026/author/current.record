  "exercises": [
    {
      "number": "1019",
      "tasks": [
        {
          "id": "1019a",
          "source_label": "а",
          "source_excerpt": "汽艇在静水里的速度等于$15$公里/小时，由河港码头沿河顺流往下行驶$36$公里后，赶上木排。木排是在汽艇开出前$10$小时由同一码头开出的。求河水的流速。",
          "variables": "设河水流速为 c 千米/小时。木排速度为 c，汽艇顺流速度为 15+c。",
          "domain": ["c>0", "15+c>0"],
          "model": "36/c = 10 + 36/(15+c)",
          "derivation": [
            "木排从同一码头提前 10 小时出发，相遇时两者各走 36 千米；木排的累计时间比汽艇多 10 小时。",
            "乘以原本为正的 c(15+c)：36(15+c)=10c(15+c)+36c。",
            "整理得 c^2+15c-54=0，即 (c-3)(c+18)=0。"
          ],
          "branches": [
            {"candidate": "3", "admissible": true, "reason": "流速与顺流速度均为正。"},
            {"candidate": "-18", "admissible": false, "reason": "河水流速为负，且顺流速度 15+c=-3，不符合原模型。"}
          ],
          "conclusion": "河水流速为 3 千米/小时。",
          "substitution_receipt": "汽艇 36/18=2 小时；木排 36/3=12 小时；12-2=10 小时。"
        },
        {
          "id": "1019b",
          "source_label": "б",
          "source_excerpt": "游览者沿河坐木排走$12$公里，返回时坐船，船在静水里的速度是$5$公里/小时。已知游览者往返途中共用了$10$小时，求河水的流速。",
          "variables": "设河水流速为 c 千米/小时；返程船的逆流速度为 5-c。",
          "domain": ["c>0", "5-c>0", "0<c<5"],
          "model": "12/c + 12/(5-c) = 10",
          "derivation": [
            "木排顺流走 12 千米，返程船逆流走同样的 12 千米。",
            "乘以正数 c(5-c)：12(5-c)+12c=10c(5-c)。",
            "整理得 c^2-5c+6=0，即 (c-2)(c-3)=0。"
          ],
          "branches": [
            {"candidate": "2", "admissible": true, "reason": "0<2<5；木排 6 小时，逆流船 4 小时。"},
            {"candidate": "3", "admissible": true, "reason": "0<3<5；木排 4 小时，逆流船 6 小时。"}
          ],
          "conclusion": "河水流速可以为 2 千米/小时或 3 千米/小时。原题不能排除其中任何一个。",
          "substitution_receipt": "c=2：12/2+12/3=6+4=10；c=3：12/3+12/2=4+6=10。"
        }
      ]
    },
    {
      "number": "1020",
      "tasks": [
        {
          "id": "1020a",
          "source_label": "а",
          "source_excerpt": "摩托艇沿河顺流行驶$39$公里，再逆流行驶$28$公里，所用的时间和它在静水里行驶$70$公里所用的时间相同。如果河水的流速等于$3$公里/小时，摩托艇在静水里具有多大的速度？",
          "variables": "设静水速度为 v 千米/小时。顺流速度 v+3，逆流速度 v-3。",
          "domain": ["v>0", "v+3>0", "v-3>0", "v>3"],
          "model": "39/(v+3) + 28/(v-3) = 70/v",
          "derivation": [
            "乘以正数 v(v+3)(v-3)：39v(v-3)+28v(v+3)=70(v^2-9)。",
            "左边为 67v^2-33v；整理得 v^2+11v-210=0。",
            "因式分解为 (v-10)(v+21)=0。"
          ],
          "branches": [
            {"candidate": "10", "admissible": true, "reason": "静水速度大于水流速度 3。"},
            {"candidate": "-21", "admissible": false, "reason": "静水速度及顺逆流速度均为负。"}
          ],
          "conclusion": "摩托艇的静水速度为 10 千米/小时。",
          "substitution_receipt": "顺流 39/13=3 小时，逆流 28/7=4 小时；合计 7 小时，等于静水航行 70/10=7 小时。"
        },
        {
          "id": "1020b",
          "source_label": "б",
          "source_excerpt": "游览者坐小船沿湖行驶$25$公里，再沿河逆流行驶$9$公里，所用的时间和沿河顺流行驶$56$公里所用的时间相同。已知河水的流速等于$2$公里/小时，求小船在静水里的速度。",
          "variables": "设小船静水速度为 v 千米/小时。沿湖速度 v，逆流速度 v-2，顺流速度 v+2。",
          "domain": ["v>0", "v-2>0", "v+2>0", "v>2"],
          "model": "25/v + 9/(v-2) = 56/(v+2)",
          "derivation": [
            "乘以正数 v(v-2)(v+2)：25(v^2-4)+9v(v+2)=56v(v-2)。",
            "整理得 11v^2-65v+50=0，即 (v-5)(11v-10)=0。"
          ],
          "branches": [
            {"candidate": "5", "admissible": true, "reason": "5>2，逆流速度为 3。"},
            {"candidate": "10/11", "admissible": false, "reason": "10/11<2，逆流速度为 -12/11，不能完成逆流行程。"}
          ],
          "conclusion": "小船静水速度为 5 千米/小时。",
          "substitution_receipt": "沿湖 25/5=5 小时，逆流 9/3=3 小时；共 8 小时，等于顺流 56/7=8 小时。"
        }
      ]
    },
    {
      "number": "1021",
      "tasks": [
        {
          "id": "1021a",
          "source_label": "а",
          "source_excerpt": "渔民坐船从$N$地出发，逆流而上。他划行$6$公里后停桨，于是按照从$N$地出发的时间起算，经过$4$小时$30$分钟后，船随着河水又回到$N$地。已知小船在静水里的速度是$90$米/分，求河水的流速。",
          "variables": "设水流速度为 c 千米/小时。划桨逆流速度为 27/5-c；停桨后漂流速度为 c。",
          "unit_conversions": ["90 米/分 = 90*60/1000 = 27/5 千米/小时", "4 小时 30 分钟 = 4+30/60 = 9/2 小时"],
          "domain": ["c>0", "27/5-c>0", "0<c<27/5"],
          "model": "6/(27/5-c) + 6/c = 9/2",
          "derivation": [
            "逆流划行与漂流返回各走 6 千米，总时间从最初出发时算起。",
            "乘以正数 c(27/5-c)：162/5=(9/2)c(27/5-c)。",
            "整理得 5c^2-27c+36=0，即 (c-3)(5c-12)=0。"
          ],
          "branches": [
            {"candidate": "3", "admissible": true, "reason": "水流 3、逆流划行速度 12/5 均为正。"},
            {"candidate": "12/5", "admissible": true, "reason": "水流 12/5、逆流划行速度 3 均为正。"}
          ],
          "conclusion": "水流速度为 3 千米/小时或 12/5 千米/小时，即 50 米/分或 40 米/分。两种情况都符合原题。",
          "substitution_receipt": "c=3：划行 6/(12/5)=5/2 小时，漂流 6/3=2 小时；c=12/5：划行 6/3=2 小时，漂流 6/(12/5)=5/2 小时。两者均合计 9/2 小时。"
        },
        {
          "id": "1021b",
          "source_label": "б",
          "source_excerpt": "木排由码头$A$朝离$A$ $40$公里的码头$B$的方向行驶，木排开出经过$3$小时$20$分钟后，摩托艇由码头$B$逆流而上和它对开，摩托艇和木排在离$A$ $16$公里处相遇。已知摩托艇在静水里的速度等于$15$公里/小时，求河水的流速。",
          "variables": "设水流速度为 c 千米/小时。木排从 A 顺流，摩托艇从 B 逆流，速度为 15-c。",
          "unit_conversions": ["3 小时 20 分钟 = 3+20/60 = 10/3 小时"],
          "domain": ["c>0", "15-c>0", "0<c<15", "16/c-10/3>0"],
          "model": "16/c = 10/3 + (40-16)/(15-c) = 10/3 + 24/(15-c)",
          "derivation": [
            "相遇点距 A 为 16 千米，故木排走 16 千米、摩托艇走 24 千米，不能调换这两段距离。",
            "木排的累计时间比摩托艇的航行时间多 10/3 小时。",
            "乘以正数 3c(15-c)：48(15-c)=10c(15-c)+72c。",
            "整理得 c^2-27c+72=0，即 (c-3)(c-24)=0。"
          ],
          "branches": [
            {"candidate": "3", "admissible": true, "reason": "逆流速度为 12；木排累计时间 16/3 大于摩托艇出发延迟 10/3。"},
            {"candidate": "24", "admissible": false, "reason": "逆流速度 15-24=-9；木排到相遇点的时间 2/3 还早于摩托艇出发，不符合迎面相遇。"}
          ],
          "conclusion": "水流速度为 3 千米/小时。摩托艇航行 2 小时后相遇；从木排出发算起为 16/3 小时，即 5 小时 20 分钟。",
          "substitution_receipt": "摩托艇出发时木排在距 A 3*(10/3)=10 千米处，距相遇点尚有 6 千米，两者相距 40-10=30 千米。迎面相对速度 3+12=15，30/15=2 小时；木排再走 6 千米到 A 下游 16 千米处，艇逆流走 24 千米。"
        }
      ]
    },
    {
      "number": "1022",
      "tasks": [
        {
          "id": "1022a",
          "source_label": "а",
          "source_excerpt": "$A$城和$B$城中间的距离等于$260$公里。公共汽车由$A$城向$B$城开出$2$小时后，停车$30$分钟，因此为了要按时刻表到达$B$城，必须把速度增加$5$公里/小时。求公共汽车原来的速度。",
          "variables": "设原速度为 v 千米/小时，原计划全程时间为 260/v 小时。行驶 2 小时后剩余 260-2v 千米。",
          "unit_conversions": ["30 分钟 = 1/2 小时"],
          "domain": ["v>0", "v+5>0", "260-2v>0", "0<v<130"],
          "model": "2 + 1/2 + (260-2v)/(v+5) = 260/v",
          "derivation": [
            "停车后的加速只用于剩余的 260-2v 千米，不用于整段 260 千米。",
            "乘以正数 2v(v+5)：5v(v+5)+2v(260-2v)=520(v+5)。",
            "整理得 v^2+25v-2600=0，即 (v-40)(v+65)=0。"
          ],
          "branches": [
            {"candidate": "40", "admissible": true, "reason": "剩余 180 千米，原速度与加速后速度均为正。"},
            {"candidate": "-65", "admissible": false, "reason": "原速度 -65、加速后速度 -60 均为负。"}
          ],
          "conclusion": "公共汽车原速度为 40 千米/小时。",
          "substitution_receipt": "先走 80 千米用 2 小时，停车 1/2 小时；剩余 180 千米以 45 千米/小时行驶 4 小时。总时间 13/2 小时，等于 260/40。"
        },
        {
          "id": "1022b",
          "source_label": "б",
          "source_excerpt": "一人骑自行车由城市到旅行基地，行驶$40$公里。返回时，他用同样的速度行驶$2$小时，然后停车$20$分钟，重新开始行驶后，他把速度增加$4$公里/小时，因此在回来的路上用的时间和由城市到旅行基地的路上用的时间相同。由城市到旅行基地的路上用了多少时间？",
          "variables": "设去程速度为 v 千米/小时，去程时间为 40/v 小时；返程行驶 2 小时后剩余 40-2v 千米。",
          "unit_conversions": ["20 分钟 = 1/3 小时"],
          "domain": ["v>0", "v+4>0", "40-2v>0", "0<v<20"],
          "model": "2 + 1/3 + (40-2v)/(v+4) = 40/v",
          "derivation": [
            "返程总时间包含停车，加速段距离为 40-2v。",
            "乘以正数 3v(v+4)：7v(v+4)+3v(40-2v)=120(v+4)。",
            "整理得 v^2+28v-480=0，即 (v-12)(v+40)=0。"
          ],
          "branches": [
            {"candidate": "12", "admissible": true, "reason": "行驶 2 小时后仍剩 16 千米；加速后速度为 16。"},
            {"candidate": "-40", "admissible": false, "reason": "原速度与加速后速度均为负。"}
          ],
          "conclusion": "去程用了 40/12=10/3 小时，即 3 小时 20 分钟。",
          "substitution_receipt": "返程先走 24 千米用 2 小时，停车 1/3 小时，再走 16 千米用 16/16=1 小时；合计 10/3 小时。"
        },
        {
          "id": "1022c",
          "source_label": "в",
          "source_excerpt": "游览者用某一平均速度驾驶汽车，由$A$地到$B$地，距离为$400$公里。返回时，他用同样的速度行驶$2$小时，然后把速度增加$10$公里/小时回到$A$地。在返回的路程上比由$A$到$B$的路程上少用$40$分钟，游览者在返回的路程上用了多少时间？",
          "variables": "设去程平均速度为 v 千米/小时；返程先走 2v 千米，加速段为 400-2v 千米。",
          "unit_conversions": ["40 分钟 = 2/3 小时"],
          "domain": ["v>0", "v+10>0", "400-2v>0", "0<v<200"],
          "model": "2 + (400-2v)/(v+10) = 400/v - 2/3",
          "derivation": [
            "仅加速段节省时间：(400-2v)(1/v-1/(v+10))=2/3。",
            "乘以正数 3v(v+10)：30(400-2v)=2v(v+10)。",
            "整理得 v^2+40v-6000=0，即 (v-60)(v+100)=0。"
          ],
          "branches": [
            {"candidate": "60", "admissible": true, "reason": "剩余 280 千米，返程加速后速度为 70。"},
            {"candidate": "-100", "admissible": false, "reason": "原速度与加速后速度均为负。"}
          ],
          "conclusion": "返回的路程用了 6 小时。",
          "substitution_receipt": "去程 400/60=20/3 小时，即 6 小时 40 分钟；返程 2+280/70=6 小时，节省 2/3 小时。"
        }
      ]
    },
    {
      "number": "1023",
      "tasks": [
        {
          "id": "1023a",
          "source_label": "а",
          "source_excerpt": "一人骑自行车用$3$小时走完$A$地和$B$地中间的路程。返回时，他用同样的速度行驶前$24$公里，然后把速度增加$2$公里/小时到达$A$地。在返回的路程上比由$A$到$B$的路程上少用$10$分钟，求$A$地和$B$地中间的距离。",
          "variables": "设去程速度为 v 千米/小时，两地距离 D=3v 千米；加速段为 3v-24 千米。",
          "unit_conversions": ["10 分钟 = 1/6 小时", "返程时间 = 3-1/6 = 17/6 小时"],
          "domain": ["v>0", "v+2>0", "3v-24>0", "v>8"],
          "model": "24/v + (3v-24)/(v+2) = 17/6",
          "derivation": [
            "加速段节省时间为 2(3v-24)/(v(v+2))=1/6。",
            "乘以正数 6v(v+2)：12(3v-24)=v(v+2)。",
            "整理得 v^2-34v+288=0，即 (v-16)(v-18)=0。"
          ],
          "branches": [
            {"candidate": "16", "admissible": true, "reason": "全程 48 千米，加速段 24 千米，速度均为正。"},
            {"candidate": "18", "admissible": true, "reason": "全程 54 千米，加速段 30 千米，速度均为正。"}
          ],
          "conclusion": "两地距离可以为 48 千米或 54 千米，两种情况都符合原题。",
          "substitution_receipt": "v=16：去程 48/16=3，返程 24/16+24/18=3/2+4/3=17/6 小时。v=18：去程 54/18=3，返程 24/18+30/20=4/3+3/2=17/6 小时。"
        },
        {
          "id": "1023b",
          "source_label": "б",
          "source_excerpt": "根据时刻表，公共汽车在$5$小时内行驶$M$城和$N$城中间的路程。有一次，公共汽车由$M$向$N$开出后，在离$M$ $56$公里处停车$10$分钟，为了按照时刻表到达$N$城，必须用比原来速度大$2$公里/小时的速度行驶剩下的大部分路程。按照时刻表公共汽车的速度应当是多少公里/小时？",
          "status": "source-wording-ambiguous",
          "variables": "设时刻表速度为 v 千米/小时，计划距离为 5v 千米。停车时剩余 R=5v-56 千米；加速行驶的距离记为 L。",
          "unit_conversions": ["10 分钟 = 1/6 小时"],
          "domain": ["v>0", "v+2>0", "R=5v-56>0", "v>56/5"],
          "source_caveat": "原文确为“剩下的大部分路程”，而非“全部剩余路程”。它没有给出加速距离 L，也没有说明其余路程的速度。因此不能把 L 静默替换成 R，不能据此给出唯一确定的时刻表速度。",
          "literal_model_limit": "56/v + 1/6 + L/(v+2) + T_other = 5；原文未确定 L 与 T_other。若把“大部分”按严格多数理解，则 R/2<L<R，但这仍不足以唯一确定 v。",
          "illustrative_model": {
            "assumption": "仅用于展示不唯一性，明确另设其余 R-L 千米仍按时刻表速度 v 行驶；这不是补修原文。",
            "equation": "56/v + 1/6 + L/(v+2) + (5v-56-L)/v = 5",
            "derivation": [
              "相对于原计划，停车损失 1/6 小时，而加速 L 千米节省 2L/(v(v+2)) 小时。",
              "故 L=v(v+2)/12。",
              "严格多数且非全部的条件为 (5v-56)/2<L<5v-56。",
              "多数条件等价于 v^2-28v+336=(v-14)^2+140>0，恒成立；非全部条件等价于 (v-16)(v-42)<0。",
              "因此该明确增设的模型下，16<v<42 的连续多个速度都可满足原文的大部分条件。"
            ],
            "witnesses": [
              {
                "v": "20 千米/小时",
                "remaining": "44 千米",
                "accelerated_distance": "110/3 千米",
                "ordinary_distance": "22/3 千米",
                "substitution": "56/20+1/6+(110/3)/22+(22/3)/20=14/5+1/6+5/3+11/30=5 小时；110/3>44/2，且 110/3<44。"
              },
              {
                "v": "28 千米/小时",
                "remaining": "84 千米",
                "accelerated_distance": "70 千米",
                "ordinary_distance": "14 千米",
