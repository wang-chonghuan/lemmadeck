          "id": "1026a",
          "source_label": "а",
          "source_excerpt": "卡车车轮的周长比自行车车轮的周长大$50\\mathrm{cm}$。在$450\\mathrm{m}$的距离上，自行车的车轮比卡车的车轮多转$75$周，求自行车和卡车的车轮的周长。",
          "variables": "设自行车车轮周长为 x 厘米，则卡车车轮周长为 x+50 厘米。按题意滚动距离等于周长乘转数。",
          "unit_conversions": ["450 米 = 450*100 = 45000 厘米", "50 厘米 = 1/2 米"],
          "domain": ["x>0", "x+50>0"],
          "model": "45000/x - 45000/(x+50) = 75",
          "derivation": [
            "两车轮走相同距离，自行车周长较小，所以转数更多。",
            "乘以正数 x(x+50)：45000(x+50)-45000x=75x(x+50)。",
            "除以 75 得 x^2+50x-30000=0，即 (x-150)(x+200)=0。"
          ],
          "branches": [
            {"candidate": "150", "admissible": true, "reason": "自行车周长 150 厘米、卡车周长 200 厘米均为正。"},
            {"candidate": "-200", "admissible": false, "reason": "自行车周长 -200 厘米、卡车周长 -150 厘米均为负。"}
          ],
          "conclusion": "自行车车轮周长为 150 厘米，即 3/2 米；卡车车轮周长为 200 厘米，即 2 米。",
          "substitution_receipt": "自行车车轮转 45000/150=300 周，卡车车轮转 45000/200=225 周；相差 75 周，周长相差 50 厘米。"
        },
        {
          "id": "1026b",
          "source_label": "б",
          "source_excerpt": "有两个旋转轴，其中一个具有较小的直径，在$1$分钟内比另一个轴多转$400$周，并且每转一周比第二个轴快$0.2$秒。在$1$分钟内每个轴转多少周？",
          "variables": "设较大直径、较慢的轴每分钟转 n 周，较小直径、较快的轴每分钟转 n+400 周。两轴每周用时分别为 60/n 秒和 60/(n+400) 秒。",
          "unit_conversions": ["1 分钟 = 60 秒", "0.2 秒 = 1/5 秒"],
          "domain": ["n>0", "n+400>0"],
          "model": "60/n - 60/(n+400) = 1/5",
          "derivation": [
            "每周快 0.2 秒表示慢轴的周期减去快轴的周期为 1/5 秒，不能直接把每分钟转数差当成周期差。",
            "乘以正数 5n(n+400)：300(n+400)-300n=n(n+400)。",
            "整理得 n^2+400n-120000=0，即 (n-200)(n+600)=0。"
          ],
          "branches": [
            {"candidate": "200", "admissible": true, "reason": "慢轴每分钟 200 周，快轴每分钟 600 周，周期均为正。"},
            {"candidate": "-600", "admissible": false, "reason": "慢轴每分钟 -600 周，快轴每分钟 -200 周，与正转数和正周期不符。"}
          ],
          "conclusion": "较小直径的轴每分钟转 600 周；另一个较大直径的轴每分钟转 200 周。",
          "substitution_receipt": "600-200=400 周/分；慢轴每周 60/200=3/10 秒，快轴每周 60/600=1/10 秒，周期差 3/10-1/10=1/5 秒。"
        }
