      "-e",
      "\nconst fs=require(\"node:fs\"), crypto=require(\"node:crypto\");\nconst started=new Date(), cwd=\"/Users/yong/.codex/worktrees/stemrobin-182-resume/lemmadeck\";\nif(process.cwd()!==cwd)throw Error(\"wrong cwd\");\nconst root=\".tmp/resume182-4-supplement-source-review-1019-1026/FIRST\";\nconst authored=[\"solutions.md\",\"solutions.json\",\"execution-notes.md\"];\nif(JSON.stringify(fs.readdirSync(root).sort())!==JSON.stringify([...authored].sort()))throw Error(\"unexpected existing owned files; preserve and stop\");\nconst hash=b=>crypto.createHash(\"sha256\").update(b).digest(\"hex\");\nconst ledger=JSON.parse(fs.readFileSync(root+\"/solutions.json\",\"utf8\"));\nconst raw=fs.readFileSync(ledger.raw_source.path), modern=fs.readFileSync(ledger.modern_identity_only.path);\nif(hash(raw)!==ledger.raw_source.sha256||hash(modern)!==ledger.modern_identity_only.sha256)throw Error(\"freeze input hash mismatch\");\nconst source=JSON.parse(raw);\nconst wanted=ledger.exercise_numbers;\nconst selected=source.exercises.filter(e=>wanted.includes(String(e.number))).map(e=>({number:String(e.number),text:e.text}));\nif(selected.length!==8||new Set(selected.map(e=>e.number)).size!==8)throw Error(\"source selection mismatch\");\nconst ids=[\"1019a\",\"1019b\",\"1020a\",\"1020b\",\"1021a\",\"1021b\",\"1022a\",\"1022b\",\"1022c\",\"1023a\",\"1023b\",\"1024\",\"1025a\",\"1025b\",\"1026a\",\"1026b\"];\nconst checks=[];\nfunction ok(condition,label){if(!condition)throw Error(label);checks.push({check:label,passed:true});}\nok(JSON.stringify(ledger.tasks.map(t=>t.id))===JSON.stringify(ids),\"exact 16-task ordered scope\");\nok(ledger.task_count===16&&ledger.exercise_count===8,\"ledger scope counters\");\nfor(const e of selected){const labels=[...e.text.matchAll(/([абв])\\)/gu)].map(m=>m[1]);const actual=ledger.tasks.filter(t=>t.id.startsWith(e.number)).map(t=>t.source_label).filter(Boolean);ok(JSON.stringify(labels)===JSON.stringify(actual),\"source task labels \"+e.number);}\nok(selected.find(e=>e.number===\"1023\").text.includes(ledger.tasks.find(t=>t.id===\"1023b\").preserved_source_clause),\"1023b literal majority clause preserved\");\nfunction gcd(a,b){a=a<0n?-a:a;while(b){const t=a%b;a=b;b=t;}return a;}\nfunction norm(n,d){if(!d)throw Error(\"zero denominator\");if(d<0n){n=-n;d=-d;}const g=gcd(n,d);return [n/g,d/g];}\nfunction q(s){if(Array.isArray(s))return s;s=String(s);if(!/^-?\\d+(\\/\\d+)?$/.test(s))throw Error(\"not exact rational: \"+s);const a=s.split(\"/\");return norm(BigInt(a[0]),BigInt(a[1]||\"1\"));}\nfunction add(a,b){a=q(a);b=q(b);return norm(a[0]*b[1]+b[0]*a[1],a[1]*b[1]);}\nfunction sub(a,b){a=q(a);b=q(b);return norm(a[0]*b[1]-b[0]*a[1],a[1]*b[1]);}\nfunction mul(a,b){a=q(a);b=q(b);return norm(a[0]*b[0],a[1]*b[1]);}\nfunction div(a,b){a=q(a);b=q(b);return norm(a[0]*b[1],a[1]*b[0]);}\nfunction gt(a,b){a=q(a);b=q(b);return a[0]*b[1]>b[0]*a[1];}\nfunction same(a,b){a=q(a);b=q(b);return a[0]===b[0]&&a[1]===b[1];}\nfunction eq(a,b,label){ok(same(a,b),label);}\nfunction sum(...a){return a.reduce(add,q(0));}\nfunction fields(b,expected,label){for(const [k,v] of Object.entries(expected)){ok(Object.hasOwn(b,k),label+\" has \"+k);eq(b[k],v,label+\" \"+k);}}\nfunction domain(id,x){switch(id){case \"1019a\":return gt(x,0);case \"1019b\":return gt(x,0)&&gt(5,x);case \"1020a\":return gt(x,3);case \"1020b\":return gt(x,2);case \"1021a\":return gt(x,0)&&gt(\"27/5\",x);case \"1021b\":return gt(x,0)&&gt(15,x);case \"1022a\":return gt(x,0)&&gt(130,x);case \"1022b\":return gt(x,0)&&gt(20,x);case \"1022c\":return gt(x,0)&&gt(200,x);case \"1023a\":return gt(x,8);case \"1024\":return gt(x,\"14/3\");case \"1025a\":return gt(x,\"15/2\");case \"1025b\":return gt(x,\"36/5\");case \"1026a\":return gt(x,0);case \"1026b\":return gt(x,400);default:throw Error(\"unknown domain\");}}\nlet physical=0,rejected=0;\nfor(const t of ledger.tasks){if(t.id===\"1023b\")continue;\nconst roots=[...t.physical_roots,...t.rejected_roots.map(r=>r.value)];\nok(roots.length===2&&!same(roots[0],roots[1]),t.id+\" two distinct algebraic roots\");\nconst [a,b,c]=t.polynomial;\nfor(const r of roots){const x=q(r);eq(sum(mul(a,mul(x,x)),mul(b,x),c),0,t.id+\" polynomial at \"+r);}\neq(add(roots[0],roots[1]),div(sub(0,b),a),t.id+\" root sum completeness\");\neq(mul(roots[0],roots[1]),div(c,a),t.id+\" root product completeness\");\nfor(const r of t.rejected_roots){ok(!domain(t.id,q(r.value)),t.id+\" rejected physical domain \"+r.value);rejected++;}\nok(t.branches.length===t.physical_roots.length,t.id+\" branch count\");\nconst answers=[];\nfor(let i=0;i<t.physical_roots.length;i++){\nconst x=q(t.physical_roots[i]), branch=t.branches[i], label=t.id+\"@\"+t.physical_roots[i];\nok(domain(t.id,x),label+\" physical domain\");eq(branch.root,x,label+\" root binding\");\nlet expected={},ans=x;\nswitch(t.id){\ncase \"1019a\":{const boat=div(36,add(15,x)),raft=div(36,x);eq(raft,add(10,boat),label+\" original equation\");expected={boat_ground_speed:add(15,x),boat_time:boat,raft_total_time:raft,distance_each:36};break;}\ncase \"1019b\":{const up=sub(5,x),out=div(12,x),back=div(12,up);eq(add(out,back),10,label+\" original equation\");expected={upstream_speed:up,outward_raft_time:out,return_time:back,full_time:add(out,back)};break;}\ncase \"1020a\":{const down=add(x,3),up=sub(x,3),td=div(39,down),tu=div(28,up),comp=div(70,x);eq(add(td,tu),comp,label+\" original equation\");expected={downstream_speed:down,upstream_speed:up,downstream_time:td,upstream_time:tu,full_time:add(td,tu),comparison_time:comp};break;}\ncase \"1020b\":{const up=sub(x,2),down=add(x,2),lake=div(25,x),tu=div(9,up),comp=div(56,down);eq(add(lake,tu),comp,label+\" original equation\");expected={upstream_speed:up,downstream_speed:down,lake_time:lake,upstream_time:tu,full_time:add(lake,tu),comparison_time:comp};break;}\ncase \"1021a\":{const up=sub(\"27/5\",x),tu=div(6,up),td=div(6,x);eq(add(tu,td),\"9/2\",label+\" original equation\");expected={upstream_speed:up,upstream_time:tu,drift_retu