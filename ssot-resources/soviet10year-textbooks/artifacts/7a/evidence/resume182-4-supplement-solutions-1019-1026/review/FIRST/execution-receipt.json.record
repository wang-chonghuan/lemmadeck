add(x,2),up=sub(x,2),td=div(L,down),tu=div(L,up);eq(add(td,tu),9,label+\" actual turn original equation\");expected={full_M_N_distance:D,turn_distance_from_M:L,turn_short_of_N:sub(D,L),actual_round_trip_distance:mul(2,L),downstream_speed:down,upstream_speed:up,actual_downstream_time:td,actual_upstream_time:tu,actual_full_time:add(td,tu),hypothetical_full_downstream_time:div(D,down)};break;}\ncase \"1025a\":{const D=mul(4,x),rem=sub(D,30),slow=sub(x,3),t1=div(30,x),t2=div(rem,slow),full=add(t1,t2);eq(full,\"9/2\",label+\" original equation\");expected={distance:D,remaining_distance:rem,slower_speed:slow,first_time:t1,remaining_time:t2,planned_full_time:4,actual_full_time:full};ans=D;break;}\ncase \"1025b\":{const D=mul(5,x),rem=sub(D,36),fast=add(x,3),t1=div(36,x),t2=div(rem,fast),full=add(t1,t2);eq(full,\"19/4\",label+\" original equation\");expected={distance:D,remaining_distance:rem,faster_speed:fast,return_first_time:t1,return_remaining_time:t2,outward_full_time:5,return_full_time:full};break;}\ncase \"1026a\":{const truck=add(x,\"1/2\"),bikeTurns=div(450,x),truckTurns=div(450,truck);eq(sub(bikeTurns,truckTurns),75,label+\" original equation\");expected={bicycle_circumference_m:x,truck_circumference_m:truck,bicycle_turns:bikeTurns,truck_turns:truckTurns,turn_difference:sub(bikeTurns,truckTurns)};answers.push(x,truck);for(let j=0;j<2;j++)eq(t.requested.equivalent_cm[j],mul(j?truck:x,100),label+\" requested cm conversion \"+j);ans=null;break;}\ncase \"1026b\":{const other=sub(x,400),tf=div(60,x),to=div(60,other);eq(sub(to,tf),\"1/5\",label+\" original equation in seconds\");expected={faster_rpm:x,other_rpm:other,faster_period_seconds:tf,other_period_seconds:to,period_difference_seconds:sub(to,tf),one_minute_count_difference:sub(x,other)};answers.push(x,other);ans=null;break;}\n}\nfields(branch,expected,label);if(ans!==null)answers.push(ans);physical++;\n}\nok(t.requested.values.length===answers.length,t.id+\" requested result count\");answers.forEach((a,i)=>eq(t.re