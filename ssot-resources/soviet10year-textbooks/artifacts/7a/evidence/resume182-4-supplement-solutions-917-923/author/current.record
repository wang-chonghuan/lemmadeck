      "tasks": [
        {
          "task_id": "918",
          "source_excerpt": "对于矩形集合$C$和菱形集合$D$作出“欧拉圆”。把图形上对应于正方形集合的部分画上细线条。",
          "answer": "The square set is exactly C intersect D. Draw overlapping, non-nested regions C and D and hatch the entire overlap.",
          "set_relationships": ["Squares = C intersect D", "C is not a subset of D", "D is not a subset of C"],
          "reasoning": [
            "A square has four right angles and four equal sides, so it is both a rectangle and a rhombus.",
            "A quadrilateral that is both a rectangle and a rhombus has four right angles and four equal sides, so it is a square.",
            "A 2-by-1 rectangle is in C minus D.",
            "A non-square rhombus with adjacent vectors (1,2) and (2,1) is in D minus C: both side lengths are sqrt(5), but their dot product is 4, not 0."
          ],
          "semantic_diagram": {
            "description": "Draw two partially overlapping closed regions labeled C and D. Neither contains the other. Identify the entire intersection lens with the square set.",
            "region_membership": ["C minus D: non-square rectangles", "C intersect D: all squares", "D minus C: non-square rhombi"],
            "shading_obligation": "Cover the full intersection C intersect D with fine hatch lines. Do not hatch only a small example or a separate square-shaped inset. Do not hatch C minus D, D minus C or the exterior. Every square belongs to the hatched set and no nonsquare does.",
            "ambient_set": "The excerpt does not name an ambient universe; an optional quadrilateral universe is only a drawing convention and is not another source task.",
            "task_boundary": "Producing the relationship diagram and hatching its square region are obligations of this same single task.",
            "new_media": false
          },
          "proof_domain": "All ordinary Euclidean rectangles and rhombi, with squares included in both definitions."
        }
      ]
    },
    {
      "number": "919",
      "source_number": "919",
      "actual_task_count": 1,
      "tasks": [
        {
          "task_id": "919",
          "source_excerpt": "$A$是凸四角形的集合；$B$是平行四边形的集合；$C$是矩形的集合；$D$是菱形的集合；$F$是正方形的集合。",
          "answer": "B is a proper subset of A; C and D are overlapping proper subsets of B; F = C intersect D.",
          "set_relationships": [
            "B proper-subset A",
            "C proper-subset B",
            "D proper-subset B",
            "F = C intersect D",
            "F proper-subset C",
            "F proper-subset D",
            "C is not a subset of D",
            "D is not a subset of C"
          ],
          "reasoning": [
            "Every nondegenerate parallelogram is convex. Not every convex quadrilateral is a parallelogram.",
            "Rectangles and rhombi are parallelograms, and neither class contains the other.",
            "A square satisfies both definitions. Conversely, being both a rectangle and a rhombus means having four right angles and four equal sides, hence being a square.",
            "There are parallelograms that are neither rectangles nor rhombi, so B minus (C union D) must remain nonempty."
          ],
          "semantic_diagram": {
            "description": "Draw A as the outer region and B strictly inside A. Inside B draw partially overlapping non-nested C and D. Label their entire overlap F. Leave nonempty A-minus-B, B-minus-(C-union-D), C-minus-D and D-minus-C regions.",
            "region_witnesses": [
              {"region": "A minus B", "witness": "Convex quadrilateral with cyclic vertices (0,0),(3,0),(2,1),(0,1); one opposite pair is not parallel."},
              {"region": "B minus (C union D)", "witness": "Parallelogram generated by adjacent vectors (2,0),(1,1); squared side lengths 4 and 2 differ and the dot product 2 is nonzero."},
              {"region": "C minus D", "witness": "Rectangle generated by (2,0),(0,1)."},
              {"region": "D minus C", "witness": "Rhombus generated by (1,2),(2,1)."},
              {"region": "F = C intersect D", "witness": "Square generated by (1,0),(0,1)."}
            ],
            "intersection_obligation": "F occupies all of C intersect D, not just a smaller nested subregion of that intersection.",
            "shading_obligation": "None requested in 919. The F label must identify the full overlap; no shading requirement is imported from 918.",
            "new_media": false
          },
          "proof_domain": "All nondegenerate convex Euclidean quadrilaterals and the named subclasses."
        }
      ]
    },
