    "counting": "918 diagram and shading jointly form one task. Each of the three lettered sets in 923 has four operation tasks."
  },
  "definitions": {
    "triangles": "Nondegenerate Euclidean triangles.",
    "quadrilaterals": "Ordinary nondegenerate convex Euclidean quadrilaterals; rectangles include squares and rhombi include squares.",
    "closure": "A binary operation is closed on S when every required ordered pair of elements has a defined result in S. For division restricted to nonzero divisors, quantify over (a,b) in S x S with b != 0.",
    "integers": "Z includes zero and negative integers.",
    "even": "E = {2m : m in Z}, including zero and negative even integers.",
    "odd": "O = {2m+1 : m in Z}, including negative odd integers.",
    "rationals": "Q = {a/b : a,b in Z, b != 0}."
  },
  "source_ambiguities": [
    {
      "exercise": 917,
      "issue": "The source names isosceles triangles without specifying whether at least two or exactly two equal sides are required.",
      "resolution": "Preserve both conventions. Under the inclusive convention A is a proper subset of B; under the strict convention A and B are disjoint. Do not silently collapse the alternatives."
    },
    {
      "exercise": 922,
      "issue": "Division is named without excluding zero divisors, while 921 quantifies over any two elements.",
      "resolution": "Under literal total-operation closure, division is undefined for divisor zero. Even under the charitable restriction to nonzero divisors, integers are not closed because 1/2 is not an integer. These are distinct reasons, not interchangeable."
    },
    {
      "exercise": 923,
      "issue": "The source explicitly excludes zero divisors.",
      "resolution": "Use only nonzero divisors for all three division tasks, including Q. Do not reject Q division because of division by zero."
    }
  ],
  "exercises": [
    {
      "number": 917,
      "tasks": [
        {
          "id": "917",
          "answer": "Inclusive isosceles convention: A proper-subset B proper-subset C. Strict isosceles convention: A intersect B = empty, and A and B are proper subsets of C.",
          "diagram": {
            "universe": "C, all nondegenerate triangles.",
            "inclusive_description": "Draw C as an outer region, B as a region wholly inside C, and A as a region wholly inside B. Leave nonempty B\\A and C\\B regions.",
            "strict_description": "Draw C as an outer region containing two disjoint regions A and B. Leave a nonempty part of C outside A union B for scalene triangles.",
            "shading": "None requested; region placement alone encodes membership.",
            "inclusive_relations": ["A proper-subset B", "B proper-subset C", "A intersect B = A"],
            "strict_relations": ["A intersect B = empty", "A union B proper-subset C"],
            "region_witnesses": {
              "A": "Side lengths (3,3,3).",
              "inclusive_B_minus_A_or_strict_B": "Side lengths (5,5,6), exactly two equal sides.",
              "outside_isosceles_and_equilateral": "Side lengths (3,4,5), all distinct."
            }
          },
          "proof": "Every equilateral triangle has at least two equal sides, establishing A subset B only for the inclusive definition. Every such triangle is a triangle. (5,5,6) and (3,4,5) establish strictness. If isosceles means exactly two equal sides, an equilateral triangle has three equal sides and cannot belong to B, establishing disjointness. All witnesses satisfy the strict triangle inequalities.",
          "definition_dependency": "Both definitions are retained; the source alone does not select one."
        }
      ]
    },
    {
      "number": 918,
      "tasks": [
        {
          "id": "918",
          "answer": "The square set is exactly C intersect D.",
          "diagram": {
            "universe": "Ordinary convex quadrilaterals.",
            "description": "Draw overlapping regions C (rectangles) and D (rhombi), with nonempty C\\D, C intersect D, and D\\C regions. Neither region contains the other.",
            "shading": "Hatch exactly the whole overlap C intersect D, and no part of either exclusive region or the exterior.",
            "relations": ["C intersect D = squares", "C not-subset D", "D not-subset C"],
            "region_witnesses": {
              "C_minus_D": "Rectangle with adjacent sides 3 and 2.",
              "C_intersect_D": "Square with side 2.",
              "D_minus_C": "Rhombus spanned by vectors (5,0) and (3,4); both lengths are 5, and their dot product is 15 rather than 0."
            }
          },
          "proof": "A square has four right angles and four equal sides, so is both a rectangle and a rhombus. Conversely, a member of C intersect D has both properties and is a square. A 3-by-2 rectangle and the non-right rhombus show that the exclusive regions are nonempty.",
          "task_count_note": "Diagram placement and shading are the two required parts of this one task, not two tasks."
        }
      ]
    },
    {
      "number": 919,
      "tasks": [
        {
          "id": "919",
          "answer": "B proper-subset A; C and D are overlapping proper subsets of B; F = C intersect D is the square set.",
          "diagram": {
            "universe": "A, all convex quadrilaterals.",
            "description": "Draw A as an outer region. Put B wholly inside A. Put overlapping regions C and D wholly inside B. Label their entire overlap F; F is not an unrelated third region. Leave nonempty A\\B and B\\(C union D), and both exclusive parts C\\D and D\\C.",
            "shading": "None requested. F is identified by its label, not by an additional prescribed hatch.",
            "relations": ["F = C intersect D", "F proper-subset C", "F proper-subset D", "C proper-subset B", "D proper-subset B", "B proper-subset A"],
            "region_witnesses": {
              "F": "Square with vertices (0,0),(2,0),(2,2),(0,2).",
              "C_minus_D": "Rectangle with vertices (0,0),(3,0),(3,2),(0,2).",
              "D_minus_C": "Rhombus with vertices (0,0),(5,0),(8,4),(3,4).",
              "B_minus_C_union_D": "Parallelogram with vertices (0,0),(4,0),(5,2),(1,2).",
              "A_minus_B": "Convex trapezoid with vertices (0,0),(4,0),(3,2),(0,2)."
            }
          },
          "proof": "All parallelograms are convex quadrilaterals. Rectangles have opposite sides parallel. Rhombi are parallelograms with equal sides. A square is exactly a rectangle that is a rhombus. The listed shapes witness every nonempty region and every proper inclusion. In particular, not all parallelograms are rectangles or rhombi, and neither rectangles nor rhombi contain the other.",
          "counterclaims_refuted": ["C subset D", "D subset C", "B = C union D", "A = B"]
        }
      ]
    },
    {
      "number": 920,
      "tasks": [
        {
          "id": "920.a",
          "part": "a",
          "answer": "Rectangles that are not squares.",
          "set_expression": "Rectangles \\ Squares.",
          "proof": "A relative complement keeps precisely the members of the stated ambient set that are absent from the specified subset. Within rectangles, being a non-square is equivalent to unequal adjacent side lengths.",
          "membership_witness": "A 3-by-2 rectangle is included.",
          "exclusion_witness": "A 2-by-2 square is excluded; a non-right rhombus is outside the ambient rectangle set."
        },
        {
          "id": "920.b",
          "part": "b",
          "answer": "All non-equilateral triangles: scalene triangles and triangles with exactly two equal sides.",
          "set_expression": "Triangles \\ Equilateral.",
          "proof": "A triangle not having all three side lengths equal has either exactly two equal lengths or three distinct lengths. These exhaust the complement without excluding non-equilateral isosceles triangles.",
          "membership_witness": "Both (5,5,6) and (3,4,5) side-length triangles are included.",
          "exclusion_witness": "The equilateral triangle (3,3,3) is excluded.",
          "definition_note": "This answer is independent of which isosceles naming convention is used in 917."
        },
        {
          "id": "920.c",
          "part": "c",
          "answer": "Rhombi that are not squares.",
          "set_expression": "Rhombi \\ Squares.",
          "proof": "Within rhombi, the square subset consists of those with right angles. The complement consists of the non-right rhombi.",
          "membership_witness": "The rhombus spanned by (5,0) and (3,4) is included.",
          "exclusion_witness": "The side-2 square is excluded; a 3-by-2 rectangle is outside the ambient rhombus set."
        },
        {
          "id": "920.d",
          "part": "d",
          "answer": "{3k+1 : k in Z} union {3k+2 : k in Z}.",
          "set_expression": "Z \\ 3Z.",
          "proof": "Integer division by positive 3 gives n = 3q+r with q in Z and r in {0,1,2}. The r=0 case is exactly the removed subset. The other two cases are all integers not divisible by 3, including negative ones.",
          "membership_witness": "1,2,-1,-2 are included; -1 = 3(-1)+2 and -2 = 3(-1)+1.",
          "exclusion_witness": "0,3,-3 are excluded."
        }
      ]
    },
    {
      "number": 921,
      "tasks": [
        {
          "id": "921.a",
          "part": "a",
          "operation": "addition",
          "set": "{-1,0,1}",
          "closed": false,
          "answer": "False.",
          "counterexample": {"left": "1", "right": "1", "result": "2", "reason": "2 is not in {-1,0,1}."},
          "proof": "Both operands belong to the set and their sum does not. One ordered pair refutes the universal closure condition."
        },
        {
          "id": "921.b",
          "part": "b",
          "operation": "multiplication",
          "set": "{-1,0,1}",
          "closed": true,
          "answer": "True.",
          "proof": "If either factor is 0 the product is 0. Otherwise each factor is 1 or -1, so the product is 1 or -1. These cases exhaust all ordered pairs.",
          "exhaustive_table": {
            "operand_order": [-1, 0, 1],
            "rows": [[1, 0, -1], [0, 0, 0], [-1, 0, 1]]
          }
        },
        {
          "id": "921.c",
          "part": "c",
          "operation": "subtraction",
          "set": "{-1,0,1}",
          "closed": false,
          "answer": "False.",
          "counterexample": {"left": "1", "right": "-1", "result": "2", "reason": "2 is not in {-1,0,1}."},
          "proof": "Both operands belong to the set and their difference does not. Closure is about all ordered pairs, not merely equal operands."
        }
      ]
    },
    {
      "number": 922,
      "tasks": [
        {
          "id": "922.a",
          "part": "a",
          "operation": "addition",
          "set": "Z",
          "closed": true,
          "answer": "Closed.",
          "proof": "For arbitrary m,n in Z, their sum m+n is an integer. Integer addition is defined for every ordered pair."
        },
        {
          "id": "922.b",
          "part": "b",
          "operation": "subtraction",
          "set": "Z",
          "closed": true,
          "answer": "Closed.",
          "proof": "For arbitrary m,n in Z, -n is an integer and m-n = m+(-n) is an integer. Integer subtraction is defined for every ordered pair."
        },
        {
          "id": "922.c",
          "part": "c",
          "operation": "multiplication",
          "set": "Z",
          "closed": true,
          "answer": "Closed.",
          "proof": "For arbitrary integers m,n, the product of their nonnegative magnitudes is an integer and attaching the product sign still gives an integer. Multiplication is defined for every ordered pair."
        },
        {
          "id": "922.d",
          "part": "d",
          "operation": "division",
          "set": "Z",
          "closed": false,
          "answer": "Not closed, even if division is restricted to nonzero divisors.",
          "counterexample": {"left": "1", "right": "2", "result": "1/2", "reason": "The divisor is nonzero, both operands are integers, and 1/2 is not an integer."},
          "proof": "The defined noninteger quotient already refutes closure on nonzero divisors. Under the literal 921 definition requiring an operation on any two integers, (1,0) separately prevents division from being a total operation.",
          "zero_divisor_ambiguity": {
            "explicit_exclusion_in_source": false,
            "literal_total_operation_obstruction": "1/0 is undefined, not an element outside Z.",
            "nonzero_divisor_interpretation": "Still not closed, witnessed by 1/2.",
            "not_integer_division": "Do not reinterpret division as a rounded quotient or quotient-and-remainder operation."
          }
        }
      ]
    },
    {
      "number": 923,
      "tasks": [
        {
          "id": "923.a.add",
          "part": "a",
          "operation": "addition",
          "set": "E",
          "closed": true,
          "answer": "Closed.",
          "proof": "Write arbitrary even integers as 2m and 2n with m,n in Z. Their sum is 2(m+n), an even integer."
        },
        {
          "id": "923.a.subtract",
          "part": "a",
          "operation": "subtraction",
          "set": "E",
          "closed": true,
          "answer": "Closed.",
          "proof": "For arbitrary m,n in Z, 2m-2n = 2(m-n), an even integer, including when the difference is negative or zero."
        },
        {
          "id": "923.a.multiply",
          "part": "a",
          "operation": "multiplication",
          "set": "E",
          "closed": true,
          "answer": "Closed.",
          "proof": "For arbitrary m,n in Z, (2m)(2n) = 4mn = 2(2mn), an even integer."
        },
        {
          "id": "923.a.divide",
          "part": "a",
          "operation": "division",
          "set": "E",
          "closed": false,
          "answer": "Not closed.",
          "nonzero_divisor_required": true,
          "counterexample": {"left": "2", "right": "4", "result": "1/2", "reason": "Both operands are even, the divisor is nonzero, and 1/2 is not an even integer."},
          "proof": "One admissible quotient outside E refutes closure. The alternative 2/2=1 also shows that even an integer quotient need not be even."
        },
        {
          "id": "923.b.add",
          "part": "b",
          "operation": "addition",
          "set": "O",
          "closed": false,
          "answer": "Not closed.",
          "counterexample": {"left": "1", "right": "1", "result": "2", "reason": "2 is even, not odd."},
          "proof": "For arbitrary m,n in Z, (2m+1)+(2n+1) = 2(m+n+1), always even. In particular the stated ordered pair leaves O."
        },
        {
          "id": "923.b.subtract",
          "part": "b",
          "operation": "subtraction",
          "set": "O",
          "closed": false,
          "answer": "Not closed.",
          "counterexample": {"left": "1", "right": "1", "result": "0", "reason": "0 is even, not odd."},
          "proof": "For arbitrary m,n in Z, (2m+1)-(2n+1) = 2(m-n), always even. Zero is not an odd integer."
        },
        {
          "id": "923.b.multiply",
          "part": "b",
          "operation": "multiplication",
          "set": "O",
          "closed": true,
          "answer": "Closed.",
          "proof": "For arbitrary m,n in Z, (2m+1)(2n+1) = 4mn+2m+2n+1 = 2(2mn+m+n)+1, an odd integer."
        },
        {
          "id": "923.b.divide",
          "part": "b",
          "operation": "division",
          "set": "O",
          "closed": false,
          "answer": "Not closed.",
          "nonzero_divisor_required": true,
          "counterexample": {"left": "1", "right": "3", "result": "1/3", "reason": "Both operands are odd, the divisor is nonzero, and 1/3 is not an odd integer."},
          "proof": "Odd integers never include zero, so this task has no zero-divisor obstruction. The admissible noninteger quotient refutes closure."
        },
        {
          "id": "923.c.add",
          "part": "c",
          "operation": "addition",
          "set": "Q",
          "closed": true,
          "answer": "Closed.",
          "proof": "Let x=a/b and y=c/d with a,b,c,d in Z and b,d != 0. Then x+y = (ad+bc)/(bd). The numerator and denominator are integers and bd != 0, so the sum is rational."
        },
        {
          "id": "923.c.subtract",
          "part": "c",
          "operation": "subtraction",
          "set": "Q",
          "closed": true,
          "answer": "Closed.",
          "proof": "For x=a/b and y=c/d with integer numerators and nonzero integer denominators, x-y = (ad-bc)/(bd), again a ratio of integers with nonzero denominator."
        },
