      "counts": {"original_exercises": 7, "exercise_tasks": 24, "raw_prose_blocks": 17, "prose_mathematics_checks": 4},
      "prose_mathematics": [
        {
          "id": "n47-prose-1",
          "source_refs": ["p0278#8", "p0278#9", "p0278#10", "p0279#1", "p0279#2", "p0279#3"],
          "derivation": "x^3-9x=x(x^2-9)=x(x+3)(x-3). The zero-product property gives exactly {0,-3,3}.",
          "conclusion": "The factorization example and method introduction are correct."
        },
        {
          "id": "n47-prose-2",
          "source_refs": ["p0279#4", "p0279#5", "p0279#6", "p0279#7", "p0279#8", "p0279#9", "p0280#1", "p0280#2"],
          "derivation": "Let y=x^2-5x. Then y^2-30y-216=(y+6)(y-36)=0, so y=-6 or 36. Back-substitution gives (x-2)(x-3)=0 or (x+4)(x-9)=0. Their union is {2,3,-4,9}. Direct expansion gives x^4-10x^3-5x^2+150x-216.",
          "conclusion": "Both substitution branches, equivalence/union statements, and every expanded coefficient are correct."
        },
        {
          "id": "n47-prose-3",
          "source_refs": ["p0280#3", "p0280#4", "p0280#5", "p0280#6"],
          "derivation": "Let y=x^2>=0. Then 4y^2-5y+1=(4y-1)(y-1)=0, giving y=1/4 or 1. Back-substitution gives x=+-1/2 or +-1; union {-1/2,1/2,-1,1}.",
          "conclusion": "Both square-root signs and the union of both branches are correct."
        },
        {
          "id": "n47-prose-4",
          "source_refs": ["p0280#7"],
          "derivation": "ax^4+bx^2+c=0 with a!=0 reduces to ay^2+by+c=0 using y=x^2>=0. Each positive y gives two real x, zero gives one distinct x, and a negative y gives no real x.",
          "conclusion": "The biquadratic definition and nonzero-leading-coefficient condition are correct."
        }
      ],
      "exercises": [
        {
          "number": "902",
          "source_refs": ["p0280#8", "p0281#1"],
          "task_count": 4,
          "tasks": [
            {"label": "a", "source_label": "а", "derivation": "Let t=5x-1; importantly 5x+1=t+2. Then t^2+6(t+2)-7=t^2+6t+5=(t+1)(t+5)=0. t=-1,-5 gives x=0,-4/5. Direct expansion is 25x^2+20x=5x(5x+4).", "branches": [{"t": "-1", "x": ["0"]}, {"t": "-5", "x": ["-4/5"]}], "roots": ["-4/5", "0"]},
            {"label": "b", "source_label": "б", "derivation": "t=x^2-9; (t-1)(t-7)=0. x^2=10 or 16.", "branches": [{"t": "1", "x": ["-sqrt(10)", "sqrt(10)"]}, {"t": "7", "x": ["-4", "4"]}], "roots": ["-4", "-sqrt(10)", "sqrt(10)", "4"]},
            {"label": "c", "source_label": "в", "derivation": "t=2a^2+3a; t^2-7t+10=(t-2)(t-5)=0. For t=2: (2a-1)(a+2)=0. For t=5: (2a+5)(a-1)=0.", "branches": [{"t": "2", "a": ["-2", "1/2"]}, {"t": "5", "a": ["-5/2", "1"]}], "roots": ["-5/2", "-2", "1/2", "1"]},
            {"label": "d", "source_label": "г", "derivation": "t=y^2+2y+4=(y+1)^2+3>=3; (t-3)(t-4)=0. t=3 gives (y+1)^2=0; t=4 gives (y+1)^2=1.", "branches": [{"t": "3", "y": ["-1"], "multiplicity": 2}, {"t": "4", "y": ["-2", "0"]}], "roots": ["-2", "-1", "0"]}
          ]
        },
        {
