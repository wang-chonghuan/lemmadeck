          "tasks": [
            {"label": "a", "source_label": "а", "derivation": "D=53>0, P=-1<0.", "answer": "One negative and one positive root."},
            {"label": "b", "source_label": "б", "derivation": "D=45>0, P=1>0, S=7>0.", "answer": "Both roots positive."},
            {"label": "c", "source_label": "в", "derivation": "D=17^2-4*5*16=-31.", "answer": "No real roots."},
            {"label": "d", "source_label": "г", "derivation": "D=149>0, P=5/19>0, S=23/19>0.", "answer": "Both roots positive."},
            {"label": "e", "source_label": "д", "derivation": "D=(5sqrt(3))^2-4*2*11=75-88=-13.", "answer": "No real roots."},
            {"label": "f", "source_label": "е", "derivation": "5sqrt(2)>7 since 50>49. Thus c=7-5sqrt(2)<0, P=c/11<0 and D=81-44c=220sqrt(2)-227>0.", "answer": "One negative and one positive root."}
          ]
        },
        {
          "number": "899",
          "source_refs": ["p0278#2"],
          "task_count": 8,
          "method": "Construct (x-r)(x-s)=0 and solve/factor to recover both supplied roots. Any nonzero scalar multiple is equivalent.",
