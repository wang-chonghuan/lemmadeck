    {
      "id": "alg7-c4-s3-n46",
      "source_hashes": {
        "lesson.json": "67f6fe7f0b2f7760078e280dc609b20435a6398e8dd71845870b93cef2026dfe",
        "exercises.json": "874391e41994970753bcb249b67b1a51b25d78fd8b16c7124b53b86fdc099305"
