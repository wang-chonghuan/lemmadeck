      ],
      "title": "Book answer lookup accepts missing or forged numbering evidence",
      "impact": "An edition 786/source736 without its record resolves to the earlier unrelated answer 736. A self-consistent forged number+corrected787/source736 resolves to answer787. The book prepare path does not compare against authoritative source records.",
      "required_fix": "Before book lookup, reject numeric logical/printed mismatches with missing/null records, validate the entire record, and compare the exact start-block registration against authoritative page/source identity at the caller boundary. Reject self-consistent forged/stale records including continuation rebinding. Preserve legacy same-number and lesson-group behavior. Add these negative cases; do not change faithful text or the approved 736->786 ledger."
    },
    {
      "id": "numbering-only-edition-gate-skipped",
      "priority": 2,
      "file": ".claude/skills/ld-s10y-lesson/tools/edition.py",
      "line": 221,
      "related": [
        {
          "file": ".claude/skills/ld-s10y-lesson/tools/edition.py",
          "line": 202
        }
      ],
      "title": "Numbering-only sources never enter the new authoritative binding check",
      "impact": "source_errata returns [] before _authoritative_source_targets when a page set has numbering errata but no mathematical errata. Stale or forged raw/modern metadata can agree with each other and their own snapshots while never being compared to the page ledger.",
      "required_fix": "Run numbering authority validation independently of mathematical errata presence during preparation and validation; test missing/stale/forged raw+modern bindings when math errata are absent.",
      "current_candidate_limit": "The current n37 stage includes a separate page229 mathematical erratum, so that stage enters the gate. The defect affects the new numbering-only contract, not the reviewed source-body fidelity."
    }
  ],
