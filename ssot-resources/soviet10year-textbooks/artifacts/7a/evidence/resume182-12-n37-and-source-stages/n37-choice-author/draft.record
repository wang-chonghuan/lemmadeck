            "truth": "incorrect",
            "derivation": "Simplify correctly but reverse the reciprocal comparison: a larger positive denominator actually gives 5/x<1.",
            "misconception": "Reversing reciprocal order for positive numbers."
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "Verify one permitted input and incorrectly generalize it to all inputs.",
            "misconception": "Replacing a universal proof with one example."
          },
          {
