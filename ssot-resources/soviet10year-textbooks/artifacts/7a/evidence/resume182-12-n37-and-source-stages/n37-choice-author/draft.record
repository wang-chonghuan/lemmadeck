      "view": {
        "mode": "single",
        "stem": "Write each expression as a monomial: $\\sqrt{9a^2}$ with $a\\ge0$; $\\sqrt{25b^2}$ with $b>0$; $\\sqrt{0.36x^2}$ with $x<0$; $\\sqrt{81y^6}$ with $y\\le0$. Choose the ordered list.",
        "figure_ids": [],
        "options": [
