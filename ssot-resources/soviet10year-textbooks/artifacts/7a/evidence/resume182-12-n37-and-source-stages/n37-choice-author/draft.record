  "questions": [
    {
      "id": "q01",
      "source_numbers": [
        "777"
      ],
      "view": {
        "mode": "single",
        "stem": "Evaluate $\\sqrt{100\\times49}$, $\\sqrt{121\\times64}$ and $\\sqrt{81\\times400}$. Which ordered list gives their arithmetic square roots?",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$(70,88,180)$",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$(700,968,1620)$",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$(17,19,29)$",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$(490,704,3600)$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "Evaluate the three integer-factor roots together.",
        "source_solution": "Task: evaluate nine products under an arithmetic square root.\nThe root is the nonnegative product of the individual nonnegative roots.\na: 10*7=70.\nb: 11*8=88.\nc: 9*20=180.\nd: 0.6*7=4.2.\ne: 12*0.5=6.\nf: 1.5*0.2=0.3.\ng: 3*8*5=120.\nh: 0.4*0.05*30=0.6.\ni: 1.1*0.3*0.1=0.033.\nDistinction: extracting every factor, including decimal scales, not distributing\nover addition or retaining squared factors.",
        "unit_reason": "A complete ordered integer-product result compares extraction of every factor; it is not three isolated value clicks.",
        "concept_blocks": [
          2
        ],
        "limitations": [
          "Recognition of results does not demonstrate writing the calculations independently."
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "A"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "10*7=70; 11*8=88; 9*20=180.",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "Leaving the first factor outside the radical unchanged gives 100*7, 121*8, 81*20.",
            "misconception": "Extracting a factor without taking its square root."
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "Replacing multiplication by addition after extracting gives 10+7, 11+8, 9+20.",
            "misconception": "Confusing a product of roots with their sum."
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "Extracting only the first factor gives 10*49, 11*64, 9*400.",
            "misconception": "Leaving the second factor squared after removing the radical."
          }
        ]
      }
    },
    {
      "id": "q02",
      "source_numbers": [
        "777"
      ],
      "view": {
        "mode": "single",
        "stem": "Evaluate $\\sqrt{0.36\\times49}$, $\\sqrt{144\\times0.25}$ and $\\sqrt{2.25\\times0.04}$, in that order.",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$(2.52,3,0.06)$",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$(42,60,3)$",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$(4.2,6,0.3)$",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$(7.6,12.5,1.7)$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "Evaluate products with decimal square factors.",
        "source_solution": "Task: evaluate nine products under an arithmetic square root.\nThe root is the nonnegative product of the individual nonnegative roots.\na: 10*7=70.\nb: 11*8=88.\nc: 9*20=180.\nd: 0.6*7=4.2.\ne: 12*0.5=6.\nf: 1.5*0.2=0.3.\ng: 3*8*5=120.\nh: 0.4*0.05*30=0.6.\ni: 1.1*0.3*0.1=0.033.\nDistinction: extracting every factor, including decimal scales, not distributing\nover addition or retaining squared factors.",
        "unit_reason": "The three decimal-factor cases form one scale-sensitive ordered result.",
        "concept_blocks": [
          2
        ],
        "limitations": [
          "Selecting a complete result does not demonstrate written extraction of decimal roots."
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "Use 0.36*7, 12*0.25, 1.5*0.04, leaving the smaller radicand factor unchanged.",
            "misconception": "Failing to take the root of the decimal factor."
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "Write 0.6 as 6 in the first, 0.5 as 5 in the second, and 0.2 as 2 in the third; products are ten times too large.",
            "misconception": "Dropping one decimal place when extracting a square root."
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "0.6*7=4.2, 12*0.5=6, 1.5*0.2=0.3.",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "Add the extracted roots: 0.6+7, 12+0.5, 1.5+0.2.",
            "misconception": "Replacing the product theorem by addition."
          }
        ]
      }
    },
    {
      "id": "q03",
      "source_numbers": [
