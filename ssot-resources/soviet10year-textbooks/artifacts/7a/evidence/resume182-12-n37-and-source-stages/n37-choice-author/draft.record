    {
      "id": "q11",
      "source_numbers": [
        "783"
      ],
      "view": {
        "mode": "single",
        "stem": "Over the real numbers, rewrite $\\sqrt{15}$, $\\sqrt{21}$, $\\sqrt{7a}$ and $\\sqrt{-3c}$ as products of square roots, wherever the original expressions are defined. Which complete list is valid?",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$\\sqrt3\\sqrt5$; $\\sqrt3\\sqrt7$; $\\sqrt7\\sqrt a$ for $a\\ge0$; $\\sqrt3\\sqrt{-c}$ for $c\\le0$.",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$\\sqrt3+\\sqrt5$; $\\sqrt3+\\sqrt7$; $\\sqrt7+\\sqrt a$ for $a\\ge0$; $\\sqrt3+\\sqrt{-c}$ for $c\\le0$.",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$\\sqrt3\\sqrt5$; $\\sqrt3\\sqrt7$; $\\sqrt7\\sqrt a$ for $a\\ge0$; $\\sqrt{-3}\\sqrt c$ for $c\\le0$.",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$\\sqrt3\\sqrt5$; $\\sqrt3\\sqrt7$; $\\sqrt7\\sqrt a$ for $a\\le0$; $\\sqrt3\\sqrt{-c}$ for $c\\ge0$.",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "Find a real-domain product representation of all four radicals.",
        "source_solution": "Task: express four radicals as products of square roots in the real domain.\na: sqrt(15)=sqrt(3)*sqrt(5).\nb: sqrt(21)=sqrt(3)*sqrt(7).\nc: sqrt(7a)=sqrt(7)*sqrt(a), with a>=0.\nd: sqrt(-3c)=sqrt(3)*sqrt(-c), with c<=0.\nEach factor used under a real square root is nonnegative. Splitting as\nsqrt(-3)*sqrt(c) is not a real-domain representation, even when -3c>=0.\nDistinction: the sign must remain with the variable in a permissible split.",
        "unit_reason": "The full transformation compares numerical splitting with sign-sensitive variable splitting under one theorem.",
        "concept_blocks": [
          2
        ],
        "limitations": [
          "Recognition of transformations does not demonstrate independently writing equivalent products."
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "A"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "15=3*5,21=3*7,7a=7*a, -3c=3*(-c); every extracted radicand is nonnegative on the original real domain.",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "Replace every required product by a sum; for example (sqrt3+sqrt5)^2=8+2sqrt15, not 15.",
            "misconception": "Using addition in the product rule."
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "Split -3c as (-3)*c, introducing sqrt(-3), which is never a real number.",
            "misconception": "Ignoring the nonnegative-factor hypothesis."
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "Reverse the variable domain signs, making the factors undefined for strictly negative a or strictly positive c.",
            "misconception": "Reversing the inequalities required by nonnegative radicands."
          }
        ]
      }
    },
