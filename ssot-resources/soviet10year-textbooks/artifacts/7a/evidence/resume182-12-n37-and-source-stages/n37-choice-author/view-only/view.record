            "figure_ids": []
          },
          {
            "id": "B",
            "text": "(i) $x<7/5$, integers $\\{\\ldots,-2,-1,0,1\\}$. (ii) $x<25/3$, integers $\\{\\ldots,-2,-1,0,1,2,3,4,5,6,7,8\\}$.",
            "figure_ids": []
          },
          {
            "id": "C",
