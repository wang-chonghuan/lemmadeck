      "id": "q29",
      "view": {
        "mode": "single",
        "stem": "Find the integer solutions of both systems: (i) $(5x-1)/3<2$ and $3x-0.8>0.2$; (ii) $1>(3-x)/4$ and $0.6x-3<2$. Choose the complete solution study.",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
