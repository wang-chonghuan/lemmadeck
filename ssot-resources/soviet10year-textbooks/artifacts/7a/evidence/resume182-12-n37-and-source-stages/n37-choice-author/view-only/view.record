    {
      "id": "q08",
      "view": {
        "mode": "multiple",
        "stem": "Select every valid argument establishing either $\\sqrt{3^2+4^2}<3+4$ or $\\sqrt{10^2-6^2}>10-6$.",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$\\sqrt{3^2+4^2}=\\sqrt{25}=5$, while $3+4=7$; therefore $5<7$.",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$\\sqrt{3^2+4^2}=3+4=7$; therefore the first comparison is an equality.",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$\\sqrt{10^2-6^2}=10-6=4$; therefore the second comparison is an equality.",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$\\sqrt{10^2-6^2}=\\sqrt{64}=8$, while $10-6=4$; therefore $8>4$.",
            "figure_ids": []
          }
        ]
      }
    },
