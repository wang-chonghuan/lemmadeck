    {
      "id": "q22",
      "view": {
        "mode": "single",
        "stem": "Evaluate $\\sqrt{448900}$, $\\sqrt{115600}$ and $\\sqrt{7840000}$ using square factors. Which complete set of derivations is correct?",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$\\sqrt{67^2 10^2}=67\\times100=6700$; $\\sqrt{34^2 10^2}=34\\times100=3400$; $\\sqrt{28^2 100^2}=28\\times10000=280000$.",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$\\sqrt{67^2 10^2}=67\\times1=67$; $\\sqrt{34^2 10^2}=34\\times1=34$; $\\sqrt{28^2 100^2}=28\\times1=28$.",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$\\sqrt{67^2 10^2}=67\\times10=670$; $\\sqrt{34^2 10^2}=34\\times10=340$; $\\sqrt{28^2 100^2}=28\\times100=2800$.",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$\\sqrt{67^2 10^2}=67+10=77$; $\\sqrt{34^2 10^2}=34+10=44$; $\\sqrt{28^2 100^2}=28+100=128$.",
            "figure_ids": []
          }
        ]
      }
    },
    {
      "id": "q23",
      "view": {
        "mode": "single",
        "stem": "Evaluate $\\sqrt{51.84}$, $\\sqrt{62.41}$ and $\\sqrt{0.7744}$ using squared numerators and denominators. Which complete set of derivations is correct?",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$\\sqrt{72^2/10^2}=72/100=0.72$; $\\sqrt{79^2/10^2}=79/100=0.79$; $\\sqrt{88^2/100^2}=88/10000=0.0088$.",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$\\sqrt{72^2/10^2}=72/10=7.2$; $\\sqrt{79^2/10^2}=79/10=7.9$; $\\sqrt{88^2/100^2}=88/100=0.88$.",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$\\sqrt{72^2/10^2}=72/1=72$; $\\sqrt{79^2/10^2}=79/1=79$; $\\sqrt{88^2/100^2}=88/1=88$.",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$\\sqrt{72^2/10^2}=72-10=62$; $\\sqrt{79^2/10^2}=79-10=69$; $\\sqrt{88^2/100^2}=88-100=-12$.",
            "figure_ids": []
          }
        ]
      }
    },
