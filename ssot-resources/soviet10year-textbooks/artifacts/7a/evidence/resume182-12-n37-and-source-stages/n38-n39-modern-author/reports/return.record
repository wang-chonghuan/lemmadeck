        "snapshot": "/Users/yong/.codex/worktrees/d9b1/lemmadeck/.intentfold/tickets/STEMROBIN-182/tmp/resume182-12/n38-n39-modern-author/snapshots/FINALIZED-n38/edition-book.json"
