        "correct": ["d"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "移项后未经非负检查将 sqrt(x^2)=-1 平方，得x^2=1而取±1；代入两根原左边都为2。", "misconception": "把平方后的候选全部认作原根，不验证负右边。"},
          {"option_id": "b", "truth": "incorrect", "derivation": "x=0 时左边1，不是0。", "misconception": "遗漏原式的+1，解成sqrt(x^2)=0。"},
          {"option_id": "c", "truth": "incorrect", "derivation": "错误把sqrt(x^2)写成x，解x+1=0得-1；代入不成立。", "misconception": "无条件取消平方与平方根，允许根式值为负。"},
          {"option_id": "d", "truth": "correct", "derivation": "左边 |x|+1>=1>0，故没有任何实数根。", "misconception": null}
        ]
      }
    },
    {
