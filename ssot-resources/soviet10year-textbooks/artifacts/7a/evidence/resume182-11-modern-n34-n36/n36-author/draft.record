          {"option_id": "b", "truth": "incorrect", "derivation": "只解 x-1=1 得2，漏负分支根0。", "misconception": "把sqrt((x-1)^2)直接写成x-1，仅保留正分支。"},
          {"option_id": "c", "truth": "incorrect", "derivation": "所得±1是内变量x-1的值，不是x的值。", "misconception": "解出x-1=±1后忘记加1完成平移。"},
          {"option_id": "d", "truth": "incorrect", "derivation": "只解x-1=-1得0，漏正分支根2。", "misconception": "把内二项式一律视为负，仅用|x-1|=1-x。"}
