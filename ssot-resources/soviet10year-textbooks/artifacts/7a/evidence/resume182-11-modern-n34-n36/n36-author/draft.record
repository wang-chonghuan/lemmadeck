          {"id": "b", "text": "$y=\\begin{cases}x,&x\\leq0\\\\-x,&x\\geq0\\end{cases}$；最大递增区间为 $(-\\infty,0]$。", "figure_ids": []},
          {"id": "c", "text": "$y=\\begin{cases}-x,&x\\leq0\\\\x,&x\\geq0\\end{cases}$；最大递增区间为 $[0,\\infty)$。", "figure_ids": []},
          {"id": "d", "text": "$y=\\begin{cases}-x,&x\\leq0\\\\x,&x\\geq0\\end{cases}$；最大递增区间为 $\\mathbb R$。", "figure_ids": []}
        ]
