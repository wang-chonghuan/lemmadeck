  "questions": [
    {
      "id": "q761-nonnegative",
      "source_numbers": ["761"],
      "view": {
        "mode": "multiple",
        "stem": "在集合 $\\{3,-4,0,10,-5\\}$ 中，哪些数作为 $x$ 的值时满足 $\\sqrt{x^2}=x$？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$3$", "figure_ids": []},
          {"id": "b", "text": "$-4$", "figure_ids": []},
          {"id": "c", "text": "$0$", "figure_ids": []},
          {"id": "d", "text": "$10$", "figure_ids": []},
          {"id": "e", "text": "$-5$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "找出第一个有限集合内满足主平方根恒等于自身的所有成员。",
        "source_solution": "sqrt(x^2)=|x|，|x|=x 当且仅当 x>=0。因此在 {3,-4,0,10,-5} 中恰为 {3,0,10}，包括零。原题另一集合的结论为 {-6,-8}，由配套独立问题覆盖。",
        "unit_reason": "一个集合上的完整筛选是一个原生多选任务。两个集合采用相反的等式分支，分别整体筛选，不拆成逐数是非题或组合编码。",
        "concept_blocks": [1, 5],
        "limitations": ["识别集合成员，不观察学习者自由书写完整集合或推导符号条件。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "c", "d"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "|3|=3，代入两边相等。", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "|-4|=4，不等于 -4。", "misconception": "错误消去平方和平方根而保留负号，得到 sqrt((-4)^2)=-4。"},
          {"option_id": "c", "truth": "correct", "derivation": "|0|=0，零属于非负分支。", "misconception": null},
          {"option_id": "d", "truth": "correct", "derivation": "|10|=10，代入成立。", "misconception": null},
          {"option_id": "e", "truth": "incorrect", "derivation": "|-5|=5，不等于 -5。", "misconception": "把 sqrt(u^2)=u 当作不受符号限制的恒等式，得到负的主平方根。"}
        ]
      }
    },
    {
      "id": "q761-nonpositive",
      "source_numbers": ["761"],
      "view": {
        "mode": "multiple",
        "stem": "在集合 $\\{2,9,-6,1,-8\\}$ 中，哪些数作为 $a$ 的值时满足 $\\sqrt{a^2}=-a$？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$2$", "figure_ids": []},
          {"id": "b", "text": "$9$", "figure_ids": []},
          {"id": "c", "text": "$-6$", "figure_ids": []},
          {"id": "d", "text": "$1$", "figure_ids": []},
          {"id": "e", "text": "$-8$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "完整筛选另一集合内使主平方根等于变量相反数的成员。",
        "source_solution": "|a|=-a 当且仅当 a<=0；集合 {2,9,-6,1,-8} 内的完整结果为 {-6,-8}。集合没有零，但一般判据包含零。",
        "unit_reason": "保留与第一集合不同的负数分支；整体多选不要求先知道或引用另一题的答案。",
        "concept_blocks": [3, 5],
        "limitations": ["选择给定成员不能证明学习者能独立写出符号条件或整个集合。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["c", "e"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "|2|=2 而 -a=-2，两边不等。", "misconception": "看到根式就筛选正数，忽略等式右边的相反数，错误采用 a>=0。"},
          {"option_id": "b", "truth": "incorrect", "derivation": "|9|=9 而 -9<0，不能相等。", "misconception": "把本题的 |a|=-a 错换成 |a|=a，选入正数 9。"},
          {"option_id": "c", "truth": "correct", "derivation": "|-6|=6=-(-6)。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "|1|=1 不等于 -1。", "misconception": "仅检查被开方数为正就认定原等式成立，没有比较等式两边。"},
          {"option_id": "e", "truth": "correct", "derivation": "|-8|=8=-(-8)。", "misconception": null}
        ]
      }
    },
    {
      "id": "q762-values",
      "source_numbers": ["762"],
      "view": {
        "mode": "single",
        "stem": "依次计算 $\\sqrt{(0.1)^2}$、$\\sqrt{(-0.4)^2}$、$\\sqrt{(-0.8)^2}$、$\\sqrt{(1.7)^2}$、$\\sqrt{(-1.9)^2}$、$\\sqrt{(2.4)^2}$、$\\sqrt{(-23)^2}$、$\\sqrt{52^2}$、$\\sqrt{(-61)^2}$。哪一列是按此顺序排列的全部结果？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$(0.1,-0.4,-0.8,1.7,-1.9,2.4,-23,52,-61)$", "figure_ids": []},
          {"id": "b", "text": "$(0.01,0.16,0.64,2.89,3.61,5.76,529,2704,3721)$", "figure_ids": []},
          {"id": "c", "text": "$(0.1,0.4,0.8,1.7,1.9,2.4,23,52,61)$", "figure_ids": []},
          {"id": "d", "text": "$(-0.1,-0.4,-0.8,-1.7,-1.9,-2.4,-23,-52,-61)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "完成全部九个平方的主平方根计算，并保持顺序。",
        "source_solution": "对每个基数取绝对值，完整结果为 (0.1,0.4,0.8,1.7,1.9,2.4,23,52,61)。",
        "unit_reason": "九个数共同检验主平方根的统一非负规则，整列是有意义的完整结果；不用九次算术点击。各列不存在所有选项共享的正确结果位置。",
        "concept_blocks": [1, 3, 5],
        "limitations": ["辨认整列计算结果，不能证明九步自由计算的过程。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["c"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "该列保留每个原基数符号，负基数位置不满足主平方根非负性。", "misconception": "逐项应用错误规则 sqrt(u^2)=u，直接消去平方和根号。"},
          {"option_id": "b", "truth": "incorrect", "derivation": "逐项平方得到 0.01,0.16,0.64,2.89,3.61,5.76,529,2704,3721，但这些是被开方数，不是根式值。", "misconception": "完成括号内平方以后停止，遗漏外层平方根。"},
          {"option_id": "c", "truth": "correct", "derivation": "按顺序取 |0.1|,|-0.4|,|-0.8|,|1.7|,|-1.9|,|2.4|,|-23|,|52|,|-61| 即得此列。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "此列等于每个绝对值的相反数，所有非零项均为负。", "misconception": "把平方的两个方根混同于主平方根，统一选择负的方根 -|u|。"}
        ]
      }
    },
    {
      "id": "q763-table",
      "source_numbers": ["763"],
      "view": {
        "mode": "single",
        "stem": "分别求三组值，每行保持所给变量值的顺序：$\\sqrt{x^2}$，$x=22,-35,-1\\frac23,0$；$2\\sqrt{a^2}$，$a=-7,12$；$0.1\\sqrt{y^2}$，$y=-15,37$。哪张结果表正确？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "| 式子 | 依次所得的值 |\n| --- | --- |\n| $\\sqrt{x^2}$ | $22,35,\\frac53,0$ |\n| $2\\sqrt{a^2}$ | $14,24$ |\n| $0.1\\sqrt{y^2}$ | $1.5,3.7$ |", "figure_ids": []},
          {"id": "b", "text": "| 式子 | 依次所得的值 |\n| --- | --- |\n| $\\sqrt{x^2}$ | $22,-35,-\\frac53,0$ |\n| $2\\sqrt{a^2}$ | $-14,24$ |\n| $0.1\\sqrt{y^2}$ | $-1.5,3.7$ |", "figure_ids": []},
          {"id": "c", "text": "| 式子 | 依次所得的值 |\n| --- | --- |\n| $\\sqrt{x^2}$ | $484,1225,\\frac{25}{9},0$ |\n| $2\\sqrt{a^2}$ | $98,288$ |\n| $0.1\\sqrt{y^2}$ | $22.5,136.9$ |", "figure_ids": []},
          {"id": "d", "text": "| 式子 | 依次所得的值 |\n| --- | --- |\n| $\\sqrt{x^2}$ | $22$、$35$、$\\frac53$、无实数值 |\n| $2\\sqrt{a^2}$ | $7\\sqrt2,12\\sqrt2$ |\n| $0.1\\sqrt{y^2}$ | $1.5\\sqrt{10},3.7\\sqrt{10}$ |", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "完成全部三组变量代入与根式外系数相乘，保留负混合数和零。",
        "source_solution": "sqrt(x^2)=|x| 给 22,35,5/3,0；2|a| 给 14,24；0.1|y| 给 1.5,3.7。-1又2/3 表示 -5/3。",
        "unit_reason": "三组共享绝对值及外部系数的对应规律，完整结果表覆盖全部八次代入；不逐格作题。错误表包含把零排除的定义域误判，没有所有选项共同供应的正确结果位置。",
        "concept_blocks": [5],
        "limitations": ["表格识别不证明逐个代入和自由计算。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["a"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "对每个变量值先取绝对值，再乘 2 或 0.1；负混合数绝对值为 5/3。", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "把 sqrt(u^2) 写成 u 后乘外部系数，得到此表中的所有负输入输出。", "misconception": "未经符号判断便取消平方和平方根，保留原负值。"},
          {"option_id": "c", "truth": "incorrect", "derivation": "遗漏外层根号后，直接计算 x^2、2a^2、0.1y^2，依次为该表。", "misconception": "把被开方数当根式值；例如 0.1乘37平方为136.9。"},
          {"option_id": "d", "truth": "incorrect", "derivation": "误把平方根定义域限定为被开方数严格正而拒绝sqrt0；另将 k sqrt(u^2) 换成 sqrt(k u^2)，得到 |a|sqrt2 和 |y|sqrt10/10。实际sqrt0=0，外系数应直接乘绝对值。", "misconception": "把主根非负误作严格正从而排除零；外系数移入根号时又未平方，直接移入2或0.1。"}
        ]
      }
    },
    {
      "id": "q764-identities",
      "source_numbers": ["764"],
      "view": {
        "mode": "single",
        "stem": "变量均为实数。依次用不含根号的恒等式替换 $\\sqrt{p^2}$、$\\sqrt{y^2}$、$3\\sqrt{b^2}$、$-0.2\\sqrt{x^2}$。哪组替换在所有实数取值下成立？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$(p,y,3b,-0.2x)$", "figure_ids": []},
          {"id": "b", "text": "$(|p|,|y|,3|b|,0.2|x|)$", "figure_ids": []},
          {"id": "c", "text": "$(-|p|,-|y|,-3|b|,0.2|x|)$", "figure_ids": []},
          {"id": "d", "text": "$(|p|,|y|,3|b|,-0.2|x|)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "建立四个无变量符号限制的根式恒等变形，保留外部负系数。",
        "source_solution": "完整恒等替换是 |p|,|y|,3|b|,-0.2|x|。根式非负不意味着外部负系数变正。",
        "unit_reason": "同一无条件恒等式规则的完整四项结果，避免四个重复的局部根号点击。所有列并未共同给出任何一个正确非零表达式。",
        "concept_blocks": [5],
        "limitations": ["识别恒等式，不观察学习者独立写出或证明这些恒等式。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["d"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "错误使用 sqrt(u^2)=u 后保留外系数，负变量可立即反驳。", "misconception": "忽略绝对值和变量符号限制，直接消平方根。"},
          {"option_id": "b", "truth": "incorrect", "derivation": "前三式正确，但最后变为 0.2|x|，与原式 -0.2|x| 在 x非零时符号相反。", "misconception": "将根式非负性错误推广到整个表达式，删除根号外负号。"},
          {"option_id": "c", "truth": "incorrect", "derivation": "先对每个根式选择 -|u|，再乘原系数，正系数项错误变负，末项错误变正。", "misconception": "把主平方根统一取为负的平方根。"},
          {"option_id": "d", "truth": "correct", "derivation": "逐项运用 sqrt(u^2)=|u|，原来的 3 和 -0.2 都仍在根号外。", "misconception": null}
        ]
      }
    },
    {
      "id": "q765-signs",
      "source_numbers": ["765"],
      "view": {
        "mode": "multiple",
        "stem": "下列等式中，哪些在各自所给条件下恒成立？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$c\\geq0$ 时，$\\sqrt{c^2}=c$。", "figure_ids": []},
          {"id": "b", "text": "$a>0$ 时，$\\sqrt{a^2}=-a$。", "figure_ids": []},
          {"id": "c", "text": "$x<0$ 时，$\\sqrt{x^2}=-x$。", "figure_ids": []},
          {"id": "d", "text": "$a\\geq0$ 时，$4\\sqrt{a^2}=2a$。", "figure_ids": []},
          {"id": "e", "text": "$b<0$ 时，$2\\sqrt{b^2}=-2b$。", "figure_ids": []},
          {"id": "f", "text": "$x<0$ 时，$-1.5\\sqrt{x^2}=1.5x$。", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "依据全部六个源条件判断完整恒等变形，包括外部负系数；源765b的 a>0 不变。",
        "source_solution": "原六项正确化简依次是 c,a,-x,4a,-2b,1.5x。a>0 是充分条件；f中 -1.5乘(-x)=1.5x，不将外负系数改正。",
        "unit_reason": "一次原生多选判断一组同类但有正负与系数区别的条件恒等式，覆盖每项原表达式；错误备选仍需推导源项正确变形才能判定，而不是每字母一个是非题。",
        "concept_blocks": [1, 3, 5],
        "limitations": ["选择条件恒等式不证明独立生成全部六个化简式。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "c", "e", "f"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "c>=0，因此 |c|=c，零也成立。", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "a>0 给 |a|=a>0，-a<0，不可能等于主平方根。", "misconception": "颠倒绝对值的正分支，误写 |a|=-a。"},
          {"option_id": "c", "truth": "correct", "derivation": "x<0 给 |x|=-x，右边非负。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "正确值为 4|a|=4a，而不是 2a；例如 a=1 时为4。", "misconception": "把外系数4未经平方直接移入根号，错误算成 sqrt(4a^2)=2a。"},
          {"option_id": "e", "truth": "correct", "derivation": "b<0 给 |b|=-b，乘2得到 -2b。", "misconception": null},
          {"option_id": "f", "truth": "correct", "derivation": "|x|=-x，所以 -1.5|x|=-1.5(-x)=1.5x。", "misconception": null}
        ]
      }
    },
    {
      "id": "q766-factorization",
      "source_numbers": ["766"],
      "view": {
        "mode": "single",
        "stem": "变量均为实数。依次化简 $\\sqrt{(a-1)^2}$、$\\sqrt{(c+2)^2}$、$\\sqrt{x^2+2x+1}$、$\\sqrt{4y^2-4y+1}$。哪组是不含根号的完整恒等替换？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$(a-1,c+2,x+1,2y-1)$", "figure_ids": []},
          {"id": "b", "text": "$(|a-1|,|c+2|,|x+1|,|2y-1|)$", "figure_ids": []},
          {"id": "c", "text": "$(|a|-1,|c|+2,|x|+1,2|y|-1)$", "figure_ids": []},
          {"id": "d", "text": "$(|a+1|,|c-2|,|x-1|,|2y+1|)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "对两种已成平方的二项式和两种完全平方三项式统一作全实数恒等变形。",
        "source_solution": "原四项为 |a-1|,|c+2|,|x+1|,|2y-1|。第三被开方数=(x+1)^2；第四=(2y-1)^2。",
        "unit_reason": "完整四项恒等替换需要同时识别平方结构及绝对值范围，不能由只选某个系数完成；没有全选项共用的正确中间化简式。",
        "concept_blocks": [5],
        "limitations": ["辨认给定表达式，不观察独立因式分解或恒等式书写。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["b"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "即使两项因式分解正确，仍错误把 sqrt(u^2) 写成 u。负的二项式使对应结果为负。", "misconception": "省略绝对值而对所有变量使用同一个正分支。"},
          {"option_id": "b", "truth": "correct", "derivation": "第三第四项分别识别 (x+1)^2 与 (2y-1)^2，再对四个完整二项式取绝对值。", "misconception": null},
          {"option_id": "c", "truth": "incorrect", "derivation": "将 |a-1| 拆作 |a|-1、|c+2| 拆作 |c|+2 等，绝对值不对加减法分配。例如 a=0 时第一项应1，不是-1。", "misconception": "把绝对值分配到变量并把常数留在外面。"},
          {"option_id": "d", "truth": "incorrect", "derivation": "反转四个二项式的常数符号；第三的 (x-1)^2 中项为-2x，第四的 (2y+1)^2 中项为+4y，与原被开方数不同。", "misconception": "将二项式加减号及完全平方中项符号统一反写。"}
        ]
      }
    },
    {
      "id": "q767-thresholds",
      "source_numbers": ["767"],
      "view": {
        "mode": "multiple",
        "stem": "下列等式中，哪些在各自所给的取值范围内恒成立？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$x\\geq4$ 时，$\\sqrt{(x-4)^2}=x-4$。", "figure_ids": []},
          {"id": "b", "text": "$a<2$ 时，$\\sqrt{(a-2)^2}=a-2$。", "figure_ids": []},
          {"id": "c", "text": "$m\\geq3$ 时，$\\sqrt{(3-m)^2}=m-3$。", "figure_ids": []},
          {"id": "d", "text": "$y<-7$ 时，$\\sqrt{(7+y)^2}=-7+y$。", "figure_ids": []},
          {"id": "e", "text": "$c\\geq-10$ 时，$\\sqrt{(10+c)^2}=-10-c$。", "figure_ids": []},
          {"id": "f", "text": "$n<-4$ 时，$\\sqrt{(n+4)^2}=-n-4$。", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "判断全部六个平移平方根在指定阈值两侧的分支，保留非严格边界。",
        "source_solution": "按内二项式符号化简，完整源结果为 x-4,2-a,m-3,-7-y,10+c,-n-4。m=3 与 c=-10 允许零值。",
        "unit_reason": "同组阈值依赖的恒等式适合一次多选，考查整个二项式符号及整体取相反数，不是六个互不相干的机械数字点击。",
        "concept_blocks": [1, 3, 5],
        "limitations": ["检查备选分支，不观察独立书写全部条件化简。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "c", "f"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "x-4>=0，故 |x-4|=x-4；x=4 时零值成立。", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "a-2<0，故应为 -(a-2)=2-a，而 a-2 为负。", "misconception": "不判断二项式符号，直接取消平方根与平方。"},
          {"option_id": "c", "truth": "correct", "derivation": "3-m<=0，所以 |3-m|=-(3-m)=m-3；边界 m=3 成立。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "7+y<0，完整取相反数得到 -7-y，不是 -7+y。", "misconception": "计算 -(7+y) 时只给常数7变号，没有给 y 变号。"},
          {"option_id": "e", "truth": "incorrect", "derivation": "c>=-10 保证 10+c>=0，应为10+c；取c=0时原式10而备选-10。", "misconception": "看到阈值 -10 便选负分支，没有计算整个10+c的符号。"},
          {"option_id": "f", "truth": "correct", "derivation": "n+4<0，故 |n+4|=-(n+4)=-n-4。", "misconception": null}
        ]
      }
    },
    {
      "id": "q768-squares-values",
      "source_numbers": ["768"],
      "view": {
        "mode": "multiple",
        "stem": "下列各项都给出了被开方数的平方表示及整个根式的值。哪些项的两部分都正确？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$2^4=(2^2)^2$；$\\sqrt{2^4}=4$。", "figure_ids": []},
          {"id": "b", "text": "$3^6=(3^2)^2$；$\\sqrt{3^6}=9$。", "figure_ids": []},
          {"id": "c", "text": "$(-5)^4=((-5)^2)^2$；$\\sqrt{(-5)^4}=25$。", "figure_ids": []},
          {"id": "d", "text": "$(-2)^8=((-2)^4)^2$；$\\sqrt{(-2)^8}=-16$。", "figure_ids": []},
          {"id": "e", "text": "$(-2)^8=((-2)^2)^2$；$3\\sqrt{(-2)^8}=12$。", "figure_ids": []},
          {"id": "f", "text": "$(-10)^4=((-10)^2)^2$；$-2\\sqrt{(-10)^4}=-200$。", "figure_ids": []},
          {"id": "g", "text": "$(-3)^8=((-3)^4)^2$；$0.1\\sqrt{(-3)^8}=810$。", "figure_ids": []},
          {"id": "h", "text": "$(0.1)^{10}=((0.1)^5)^2$；$100\\sqrt{(0.1)^{10}}=0.001$。", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "对全部八个源式同时核对平方分解、主根值和外系数，不能仅识别最终数值。",
        "source_solution": "被开方数依次为 (2^2)^2,(3^3)^2,((-5)^2)^2,((-2)^4)^2,((-2)^4)^2,((-10)^2)^2,((-3)^4)^2,((0.1)^5)^2。整个表达式值依次为4,27,25,16,48,-200,8.1,0.001。",
        "unit_reason": "八个完整双阶段数学断言形成原生多选；包含错误平方表示，不能由所有选项共同供应正确中间分解。保留源题明确要求的先写平方再求值。",
        "concept_blocks": [5],
        "limitations": ["辨认平方表示与值的联合断言，不观察学习者独立产生单项式平方分解及逐步计算。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "c", "f", "h"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "2^4=(2^2)^2，主根=|2^2|=4。", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "(3^2)^2=3^4，不是3^6；正确平方表示为(3^3)^2且值27。", "misconception": "将指数6除以底数3而非外平方指数2，得到内指数2，再用3^2=9作根式值。"},
          {"option_id": "c", "truth": "correct", "derivation": "内单项式(-5)^2=25 非负，外平方的主根为25。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "平方表示正确，但(-2)^4=16非负，所以主根16而非-16。", "misconception": "忘记内指数4为偶数，把原负底数的符号直接带到取根后的16前。"},
          {"option_id": "e", "truth": "incorrect", "derivation": "备选平方表示只等于(-2)^4；正确内单项式是(-2)^4=16，外乘3给48。", "misconception": "将8连续减半两次得到内指数2，误写平方表示，再取4并乘3得到12。"},
          {"option_id": "f", "truth": "correct", "derivation": "(-10)^4=100^2，其主根100，再乘外部-2得-200。", "misconception": null},
          {"option_id": "g", "truth": "incorrect", "derivation": "平方表示正确，主根81；外乘0.1应8.1，而810=81除以0.1。", "misconception": "把根号外乘系数0.1错误改作除以0.1。"},
          {"option_id": "h", "truth": "correct", "derivation": "主根=(0.1)^5=0.00001，乘100得到0.001。", "misconception": null}
        ]
      }
    },
    {
      "id": "q769-parity",
      "source_numbers": ["769"],
      "view": {
        "mode": "multiple",
        "stem": "下列幂的根式化简中，哪些在各自条件下恒成立？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$y\\geq0$ 时，$\\sqrt{y^6}=y^3$。", "figure_ids": []},
          {"id": "b", "text": "对任意实数 $m$，$\\sqrt{m^4}=m^2$。", "figure_ids": []},
          {"id": "c", "text": "$x<0$ 时，$\\sqrt{x^{10}}=x^5$。", "figure_ids": []},
          {"id": "d", "text": "$a<0$ 时，$5\\sqrt{a^8}=-5a^4$。", "figure_ids": []},
          {"id": "e", "text": "$c\\geq0$ 时，$\\frac13\\sqrt{c^{12}}=\\frac13c^3$。", "figure_ids": []},
          {"id": "f", "text": "$z<0$ 时，$1.5\\sqrt{z^{18}}=-1.5z^9$。", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "依据减半指数的奇偶性与变量条件化简全部六个幂根式。",
        "source_solution": "正确源结果为 y^3,m^2,-x^5,5a^4,c^6/3,-1.5z^9。sqrt(v^(2k))=|v^k|；偶次幂在负底数时仍非负，奇次幂才依条件变号。",
        "unit_reason": "联合判断减半指数与符号，六项共同形成奇偶及条件比较任务，不按每个指数槽位分题。",
        "concept_blocks": [5],
        "limitations": ["选择正确化简，不能观察独立写出全部幂的平方表示和变形。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "b", "f"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "y^6=(y^3)^2 且 y>=0 给 y^3>=0，故根式y^3。", "misconception": null},
          {"option_id": "b", "truth": "correct", "derivation": "m^2 对任意实数均非负，所以 sqrt((m^2)^2)=m^2。", "misconception": null},
          {"option_id": "c", "truth": "incorrect", "derivation": "x<0 导致 x^5<0，主根应 |x^5|=-x^5。", "misconception": "将指数减半后直接去掉绝对值，保留负的奇次幂。"},
          {"option_id": "d", "truth": "incorrect", "derivation": "a^4>0 对 a<0 仍成立，故5|a^4|=5a^4，而-5a^4为负。", "misconception": "仅因原变量负就给取根后表达式添负号，忽视减半指数4为偶数。"},
          {"option_id": "e", "truth": "incorrect", "derivation": "sqrt(c^12)=|c^6|=c^6，正确结果c^6/3；取c=2时不同于c^3/3。", "misconception": "对指数12连续减半两次12到6到3，相当于取了四次根。"},
          {"option_id": "f", "truth": "correct", "derivation": "z^9<0，所以 sqrt(z^18)=|z^9|=-z^9，再乘1.5。", "misconception": null}
        ]
      }
    },
    {
      "id": "q770-ordering",
      "source_numbers": ["770"],
      "view": {
        "mode": "single",
        "stem": "依次化简 $\\sqrt{(\\sqrt2-1)^2}$、$\\sqrt{(1-\\sqrt3)^2}$、$\\sqrt{(\\sqrt{11}-\\sqrt{10})^2}$、$\\sqrt{(\\sqrt5-\\sqrt8)^2}$。哪组结果正确？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$(\\sqrt2-1,1-\\sqrt3,\\sqrt{11}-\\sqrt{10},\\sqrt5-\\sqrt8)$", "figure_ids": []},
          {"id": "b", "text": "$(1-\\sqrt2,1-\\sqrt3,\\sqrt{10}-\\sqrt{11},\\sqrt5-\\sqrt8)$", "figure_ids": []},
          {"id": "c", "text": "$(\\sqrt2-1,\\sqrt3-1,\\sqrt{11}-\\sqrt{10},\\sqrt8-\\sqrt5)$", "figure_ids": []},
          {"id": "d", "text": "$(\\sqrt2+1,1+\\sqrt3,\\sqrt{11}+\\sqrt{10},\\sqrt5+\\sqrt8)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "比较无理数差的正负，再对全部四个内二项式取绝对值。",
        "source_solution": "sqrt2>1, sqrt3>1, sqrt11>sqrt10, sqrt8>sqrt5；完整结果为 sqrt2-1,sqrt3-1,sqrt11-sqrt10,sqrt8-sqrt5。",
        "unit_reason": "完整四项比较覆盖正负交错的内差，防止把逐字消根号当作四题；各列没有全部共用的正确分支。",
        "concept_blocks": [5],
        "limitations": ["识别整组化简，不观察独立比较大小和书写相反数。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["c"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "直接保留全部内差，第二第四项为负，违反主平方根非负性。", "misconception": "无条件运用 sqrt(u^2)=u。"},
          {"option_id": "b", "truth": "incorrect", "derivation": "每项均等于正确绝对值的相反数，即选了所有负方根。", "misconception": "每个平方根统一取负支 -|u|，包括原先为正的内差。"},
          {"option_id": "c", "truth": "correct", "derivation": "第一第三内差正，保持；第二第四内差负，整体变号。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "把四个绝对值差一律替换为两项大小的和，例如 |sqrt2-1| 误为 sqrt2+1。", "misconception": "错误应用 |u-v|=|u|+|v|，把差的绝对值分配为两个绝对值之和。"}
        ]
      }
    },
    {
      "id": "q771-centered",
      "source_numbers": ["771"],
      "view": {
        "mode": "single",
        "stem": "方程 $\\sqrt{x^2}=4$ 的全部实数解组成哪个集合？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$\\{4\\}$", "figure_ids": []},
          {"id": "b", "text": "$\\{-4,4\\}$", "figure_ids": []},
          {"id": "c", "text": "$\\{-4\\}$", "figure_ids": []},
          {"id": "d", "text": "$\\{16\\}$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "完整求解以零为中心的绝对值方程，不能只交一个根。",
        "source_solution": "|x|=4 当且仅当 x=4 或 x=-4，完整解集 {-4,4}。原组另外三方程分别为无解、{0,2}、{-10,-4}，由独立方程问题覆盖。",
        "unit_reason": "该方程的完整双根集为响应单位。源组各方程的中心或可解性不同，独立求解有数学理由；不按根或操作步骤拆分。",
        "concept_blocks": [5],
        "limitations": ["识别完整解集，不能证明独立书写两条分支及验证。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["b"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "4确为根，但-4同样满足 sqrt(16)=4，集合不完整。", "misconception": "错误把 sqrt(x^2) 当x，仅保留正分支。"},
          {"option_id": "b", "truth": "correct", "derivation": "|x|=4 给双分支 x=±4，逐一代入均成立。", "misconception": null},
          {"option_id": "c", "truth": "incorrect", "derivation": "-4是根，但遗漏4。", "misconception": "只写 |x|=-x 这一负变量分支，解得-4就停止。"},
          {"option_id": "d", "truth": "incorrect", "derivation": "x=16 时 sqrt(16^2)=16，不是4。", "misconception": "误读原式为 sqrt(x)=4，平方后得到x=16，遗漏被开方数中的平方。"}
        ]
      }
    },
    {
      "id": "q771-impossible",
