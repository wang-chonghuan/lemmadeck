        "figure_observations": []
      },
      "key": {
        "correct": ["c"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "x<0 时原函数=-x而非x，例如x=-1给1，不是-1。", "misconception": "把sqrt(x^2)=x错误推广到负半轴，得到整条递增直线。"},
          {"option_id": "b", "truth": "incorrect", "derivation": "该分段式是-|x|，负半轴y=x，正半轴y=-x，主根却必须非负。", "misconception": "统一取负平方根，镜像到x轴下方，因此错误地选择负半轴递增。"},
          {"option_id": "c", "truth": "correct", "derivation": "按绝对值分支给左射线-x、右射线x；任意0<=x1<x2均有y1=x1<x2=y2，故[0,infty)为最大递增区间。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "分段式正确，但如x从-2增到-1，y从2减到1，所以不能在全实数集递增。", "misconception": "把右侧分支的递增性推广到整个函数，忽略左侧负斜率。"}
