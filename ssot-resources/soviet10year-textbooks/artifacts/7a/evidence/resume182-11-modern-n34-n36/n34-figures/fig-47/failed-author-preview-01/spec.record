          "y-value-2",
          "y-value-4",
          "origin-label"
        ],
        "assertions": []
      },
      {
        "id": "source-curve-inventory",
        "description": "start [-3,-4]; left-zero [-2,0]; y-intercept [0,3]; maximum [2,4]; right-three [4,3]; right-zero [6,0]; end [7,-3]. Increasing on the portion from -3 to 2, decreasing from 2 to 7. The source has unequal endpoint heights, -4 and -3; do not replace it with a symmetric parabola. Closed domain [-3,7]; do not extend the curve beyond these endpoints. No formula, named point, separate endpoint circle, dashed curve, or projection guide is supplied. The continuous source curve is solid; assertion anchors are not named source points.",
        "objects": [
          "source-curve",
          "source-start",
          "source-left-zero",
          "source-y-intercept",
          "source-maximum",
          "source-right-three",
          "source-right-zero",
          "source-end"
        ],
        "assertions": [
          "source-relation-start-to-left-zero",
          "source-relation-left-zero-to-y-intercept",
          "source-relation-y-intercept-to-maximum",
          "source-relation-maximum-to-right-three",
          "source-relation-right-three-to-right-zero",
          "source-relation-right-zero-to-end"
        ],
        "requires": [
          "pointRelationships"
        ]
      }
    ]
  },
