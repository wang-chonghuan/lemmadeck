{
  "schema": "ld-s10y-image/figure-spec@2",
  "id": "fig-choice-n36-774-line",
  "mode": "deterministic",
  "description": "Shared coordinate frame for inspecting y=sqrt(x) and y=6-x from written exercise 774, without marked solutions.",
  "source": {
    "authoredBasis": "New authored deterministic choice support graph, independently derived only from original written exercise 774. No intentional false curve, no answer key, no guessed source coordinates and no original PNG. The display window is x=[-1,11], y=[-5,7], not a domain restriction. Square-root domain is x>=0; visible square-root segment is x=[0,11]. sqrt-curve uses the exact quadratic parametric Bezier x=11*t^2, y=sqrt(11)*t, 0<=t<=1. RHS is the full affine line y=6-x, clipped only by the coordinate frame; the x=9 tick remains visible without highlighting. Numeric unit labels; the reciprocal grid has half-unit cells. All learner-facing text is ASCII, 20 px at width 640. No intersection point, solution coordinate, projected intersection guide or answer-bearing annotation. The supported assertion vocabulary does not prove arbitrary svgPath identities; exact construction and sampling checks are in the separately hash-bound mathematical receipt, not misrepresented as validator proof.",
    "authoritativeText": [
      {
        "lesson": "alg7-c4-s2-n36",
        "exercise": "774",
        "text": "774. \u7528\u56fe\u89e3\u6cd5\u89e3\u65b9\u7a0b\uff1a\u0430) $\\sqrt{x}=6-x$\uff1b\u3000\u3000\u0431) $\\sqrt{x}=\\frac{6}{x}$."
      }
    ],
    "inventory": [
      {
        "id": "authored-shared-frame",
        "description": "Modern authored numeric coordinate frame and regular grid; not original pixel evidence.",
        "objects": [
          "instructional-grid",
          "coordinate-frame",
          "x-axis",
          "y-axis",
          "origin-label",
          "x-axis-label",
          "y-axis-label"
        ],
        "assertions": [
          "grid-cell-count",
          "orthogonal-axes",
          "x-frame-extent",
          "y-frame-extent"
        ],
        "requires": [
          "gridDimensions"
        ]
      },
      {
        "id": "authored-sqrt",
        "description": "The actual positive square-root curve from the written left-hand side, with solid stroke and formula label.",
        "objects": [
          "sqrt-curve",
          "sqrt-formula",
          "sqrt-legend-stroke"
        ],
        "assertions": [
          "curve-representation-count",
          "no-point-markers"
        ]
      },
      {
        "id": "authored-rhs",
        "description": "The affine right-hand side y=6-x, drawn across the whole coordinate frame with a dashed stroke.",
        "objects": [
          "rhs-curve",
          "rhs-formula",
          "rhs-legend-stroke"
        ],
        "assertions": [
          "rhs-slope",
          "rhs-intercept",
          "no-point-markers"
        ]
      }
    ]
  },
