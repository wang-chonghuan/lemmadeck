        "757"
      ],
      "view": {
        "mode": "single",
        "stem": "\u8bbe $y=\\sqrt{x}$\u3002\u5148\u786e\u5b9a $0\\leq x\\leq4$ \u65f6 $y$ \u7684\u53d6\u503c\u8303\u56f4\uff0c\u518d\u4f9d\u6b21\u6c42\u533a\u95f4 $[0,9]$\u3001$[100,400]$\u3001$]0.01,1[$ \u7684\u50cf\u3002\u4e0b\u5217\u54ea\u7ec4\u7ed3\u679c\u5168\u90e8\u6b63\u786e\uff1f\u6bcf\u4e2a\u9009\u9879\u7684\u7b2c\u4e00\u9879\u662f $y$ \u7684\u8303\u56f4\uff0c\u540e\u4e09\u9879\u662f\u4f9d\u6b21\u5bf9\u5e94\u7684\u50cf\u3002",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$0\\leq y\\leq4$\uff1b$[0,9]$\uff1b$[100,400]$\uff1b$]0.01,1[$\u3002",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$0\\leq y\\leq2$\uff1b$[0,3]$\uff1b$[10,20]$\uff1b$[0.1,1]$\u3002",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$0\\leq y\\leq2$\uff1b$[0,3]$\uff1b$[10,20]$\uff1b$]0.1,1[$\u3002",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$0<y<2$\uff1b$]0,3[$\uff1b$]10,20[$\uff1b$]0.1,1[$\u3002",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "Retain all four source requests: bound sqrt(x) on [0,4], then determine the full images of the three specified closed/open intervals.",
        "source_solution": "On [0,4], 0<=y<=2. The interval images are [0,3], [10,20], and ]0.1,1[. Strict increase orders endpoint images, and x=y^2 establishes that every value inside each proposed image is attained. Included endpoints stay included, excluded endpoints stay excluded.",
        "unit_reason": "All four requests apply the same monotone mapping to intervals. A complete coherent result distinguishes transformation of endpoint values and endpoint inclusion without four separate endpoint-slot questions.",
        "concept_blocks": [
          0,
          6,
          15,
          16
        ],
        "limitations": [
          "Recognition of the complete bound/image result does not demonstrate independently constructing the interval images or proving that all intermediate values are attained."
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "This copies the input bounds and the three input intervals without applying the function. In particular sqrt(4)=2, not 4, and sqrt(100)=10, not 100.",
            "misconception": "Treat the image of each interval as the interval itself, replacing the nonidentity mapping by y=x."
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "All endpoint values are transformed correctly, but 0.01 and 1 are excluded in the last input interval. Their images 0.1 and 1 cannot be included.",
            "misconception": "Compute endpoint square roots and automatically place closed brackets around the image, forgetting the last interval's strict endpoint exclusions."
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "Take square roots of the nonnegative endpoints: 0,4 -> 0,2; 0,9 -> 0,3; 100,400 -> 10,20; 0.01,1 -> 0.1,1. Preserve their inclusion and use x=y^2 to obtain each entire image.",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "The first three input intervals contain their endpoints, which attain y=0,2; y=0,3; and y=10,20 respectively. Excluding those attained values makes the first three results incomplete.",
            "misconception": "Confuse strict increase with strictly open output bounds, and replace all closed endpoint conditions by strict inequalities."
          }
        ]
      }
    },
