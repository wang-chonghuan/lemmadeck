    {
      "id": "n35-q03",
      "source_numbers": [
        "755"
      ],
      "view": {
        "mode": "multiple",
        "stem": "\u4e0b\u5217\u54ea\u4e9b\u70b9\u5c5e\u4e8e\u51fd\u6570 $y=\\sqrt{x}$ \u7684\u56fe\u8c61\uff1f\u9009\u62e9\u6240\u6709\u7b26\u5408\u6761\u4ef6\u7684\u70b9\u3002",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$A(64,\\ 8)$",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$B(10000,\\ 100)$",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$C(-81,\\ 9)$",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$D(25,\\ -5)$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "Judge all four original points using the real domain, the principal-root sign and the equation relating the coordinates.",
        "source_solution": "A and B belong because their coordinates are nonnegative and 8^2=64,100^2=10000. C fails the real domain x>=0. D fails y>=0, since sqrt(25)=5 rather than -5. The equivalent membership test needs x>=0,y>=0,y^2=x, not squaring alone.",
        "unit_reason": "The four given points form one collection judged by one definition. Native multiple selection preserves that collection without four independent yes/no items or combination codes.",
        "concept_blocks": [
          0,
          15
        ],
        "limitations": [
          "Selecting points does not demonstrate independently writing the domain and principal-root justification for every rejected or accepted point."
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "A",
          "B"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "64 is in the real square-root domain and its unique nonnegative square root is 8, so the coordinates satisfy y=sqrt(x).",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "100^2=10000 and 100 is nonnegative, so sqrt(10000)=100.",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "The first coordinate -81 is negative; sqrt(-81) has no real value. The positive second coordinate does not remedy that.",
            "misconception": "Replace the negative radicand by its absolute value and use sqrt(|-81|)=9, thereby discarding the function's real-domain condition."
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "Although (-5)^2=25, the principal square root of 25 is +5. A negative second coordinate is outside the function's range.",
            "misconception": "Test only y^2=x after squaring, and accept both signs of y without restoring the nonnegative principal-root condition."
          }
        ]
      }
    },
    {
      "id": "n35-q04",
      "source_numbers": [
        "756"
      ],
      "view": {
        "mode": "multiple",
        "stem": "\u6bd4\u8f83 $\\sqrt{68}$ \u4e0e $\\sqrt{72}$\u3001$\\sqrt{0.12}$ \u4e0e $\\sqrt{0.015}$\u3001$\\sqrt{24.7}$ \u4e0e $5$\u3001$8$ \u4e0e $\\sqrt{60}$\u3002\u9009\u62e9\u6240\u6709\u4e24\u4e2a\u6bd4\u8f83\u90fd\u6b63\u786e\u7684\u9009\u9879\u3002",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$\\sqrt{68}<\\sqrt{72}$\uff0c\u4e14 $\\sqrt{0.12}>\\sqrt{0.015}$\u3002",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$\\sqrt{68}>\\sqrt{72}$\uff0c\u4e14 $\\sqrt{0.12}<\\sqrt{0.015}$\u3002",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$\\sqrt{24.7}<5$\uff0c\u4e14 $8>\\sqrt{60}$\u3002",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$\\sqrt{24.7}>5$\uff0c\u4e14 $8<\\sqrt{60}$\u3002",
            "figure_ids": []
          },
          {
            "id": "E",
            "text": "$\\sqrt{0.12}>\\sqrt{0.015}$\uff0c\u4e14 $\\sqrt{24.7}>5$\u3002",
            "figure_ids": []
          },
          {
            "id": "F",
            "text": "$\\sqrt{68}<\\sqrt{72}$\uff0c\u4e14 $8<\\sqrt{60}$\u3002",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "Determine all four original comparisons, using strict increase on nonnegative radicands and converting 5 and 8 to sqrt(25) and sqrt(64).",
        "source_solution": "The four relations are sqrt(68)<sqrt(72), sqrt(0.12)>sqrt(0.015), sqrt(24.7)<5, and 8>sqrt(60). Compare 68<72 and 0.120>0.015 directly; for the mixed forms compare 24.7<25 and 64>60.",
        "unit_reason": "A common monotonicity criterion governs all four comparisons. Two-expression propositions group its direct and mixed-form applications; judging each conjunction avoids a separate response for every printed subpart.",
        "concept_blocks": [
          0,
          6
        ],
        "limitations": [
          "Selection of comparison propositions does not demonstrate producing all four inequality signs and their monotonicity justifications without alternatives."
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "A",
          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "68<72 implies sqrt(68)<sqrt(72). Also 0.12=0.120>0.015 implies sqrt(0.12)>sqrt(0.015). Both comparisons hold.",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "Both radicand orders are reversed: the square-root function is increasing, not decreasing. The actual comparisons are the opposite of each displayed relation.",
            "misconception": "Assume taking a square root reverses numerical order, applying 68<72 -> sqrt(68)>sqrt(72) and 0.12>0.015 -> sqrt(0.12)<sqrt(0.015)."
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "5=sqrt(25) with 24.7<25, so sqrt(24.7)<5. Likewise 8=sqrt(64) with 64>60, so 8>sqrt(60).",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "Comparing the bare numbers 24.7>5 and 8<60 produces these two wrong claims. The correct matched comparisons are 24.7<5^2 and 8^2>60.",
            "misconception": "Remove only the radical sign when comparing a radical to an integer, without squaring the integer: compare 24.7 to 5 and 8 to 60."
          },
          {
            "option_id": "E",
            "truth": "incorrect",
            "derivation": "The decimal comparison is true because 0.120>0.015. The second comparison is false because 24.7<25=5^2, so the conjunction is false.",
            "misconception": "Correctly compare decimal radicands but then compare 24.7 directly with 5 in the mixed radical/integer comparison."
          },
          {
            "option_id": "F",
            "truth": "incorrect",
            "derivation": "The first comparison follows from 68<72. The second fails: 8^2=64>60 implies 8>sqrt(60), not 8<sqrt(60).",
            "misconception": "Correctly compare two radicals but in the second comparison compare the unsquared 8 directly with the radicand 60."
          }
        ]
      }
    },
    {
