[
  {
    "id": "q774-line-graphical",
    "view": {
      "mode": "single",
      "stem": "\u56fe\u4e2d\u4e24\u6761\u66f2\u7ebf\u5206\u522b\u8868\u793a\u65b9\u7a0b $\\sqrt{x}=6-x$ \u7684\u5de6\u8fb9\u548c\u53f3\u8fb9\u3002\u89c2\u5bdf\u5b83\u4eec\u7684\u4ea4\u70b9\u5e76\u8bfb\u53d6\u6a2a\u5750\u6807\uff0c\u54ea\u9879\u6b63\u786e\u63cf\u8ff0\u66f2\u7ebf\u914d\u5bf9\u3001\u5171\u540c\u5b9a\u4e49\u57df\u548c\u56fe\u89e3\u7ed3\u679c\uff1f",
      "figure_ids": [
        "fig-choice-n36-774-line"
      ],
      "options": [
        {
          "id": "a",
          "text": "\u66f2\u7ebf\u4e3a $y=\\sqrt{x}$ \u4e0e $y=6-x$\uff1b\u5171\u540c\u5b9a\u4e49\u57df\u4e3a $[0,\\infty)$\uff1b\u552f\u4e00\u4ea4\u70b9\u6a2a\u5750\u6807\u7ea6\u4e3a $4$\u3002",
          "figure_ids": []
        },
        {
          "id": "b",
          "text": "\u66f2\u7ebf\u4e3a $y=\\sqrt{x}$ \u4e0e $y=6+x$\uff1b\u5171\u540c\u5b9a\u4e49\u57df\u4e3a $[0,\\infty)$\uff1b\u6ca1\u6709\u4ea4\u70b9\u3002",
          "figure_ids": []
        },
        {
          "id": "c",
          "text": "\u66f2\u7ebf\u4e3a $y=x$ \u4e0e $y=(6-x)^2$\uff1b\u5171\u540c\u5b9a\u4e49\u57df\u4e3a $\\mathbb R$\uff1b\u4ea4\u70b9\u6a2a\u5750\u6807\u7ea6\u4e3a $4$ \u548c $9$\u3002",
          "figure_ids": []
        },
        {
          "id": "d",
          "text": "\u66f2\u7ebf\u4e3a $y=\\sqrt{x}$ \u4e0e $y=6-x$\uff1b\u5171\u540c\u5b9a\u4e49\u57df\u4e3a $[0,\\infty)$\uff1b\u552f\u4e00\u4ea4\u70b9\u6a2a\u5750\u6807\u7ea6\u4e3a $9$\u3002",
          "figure_ids": []
        }
      ]
    }
  },
  {
    "id": "q774-reciprocal-graphical",
    "view": {
      "mode": "single",
      "stem": "\u56fe\u4e2d\u4e24\u6761\u66f2\u7ebf\u5206\u522b\u8868\u793a\u65b9\u7a0b $\\sqrt{x}=\\frac6x$ \u7684\u5de6\u8fb9\u548c\u53f3\u8fb9\u3002\u89c2\u5bdf\u5b83\u4eec\u7684\u4ea4\u70b9\uff0c\u5e76\u7528\u7f51\u683c\u4f30\u8bfb\u6a2a\u5750\u6807\uff0c\u54ea\u9879\u6b63\u786e\u63cf\u8ff0\u66f2\u7ebf\u914d\u5bf9\u3001\u5171\u540c\u5b9a\u4e49\u57df\u548c\u56fe\u89e3\u8fd1\u4f3c\u503c\uff1f",
      "figure_ids": [
        "fig-choice-n36-774-reciprocal"
      ],
      "options": [
        {
          "id": "a",
          "text": "\u66f2\u7ebf\u4e3a $y=\\sqrt{x}$ \u4e0e $y=6x$\uff1b\u5171\u540c\u5b9a\u4e49\u57df\u4e3a $[0,\\infty)$\uff1b\u4ea4\u70b9\u6a2a\u5750\u6807\u7ea6\u4e3a $0$ \u548c $0.03$\u3002",
          "figure_ids": []
        },
        {
          "id": "b",
          "text": "\u66f2\u7ebf\u4e3a $y=\\sqrt{x}$ \u4e0e $y=\\frac6x$\uff1b\u5171\u540c\u5b9a\u4e49\u57df\u4e3a $(0,\\infty)$\uff1b\u552f\u4e00\u4ea4\u70b9\u6a2a\u5750\u6807\u7ea6\u4e3a $2.4$\u3002",
          "figure_ids": []
        },
        {
          "id": "c",
          "text": "\u66f2\u7ebf\u4e3a $y=x^3$ \u4e0e $y=36$\uff1b\u5171\u540c\u5b9a\u4e49\u57df\u4e3a $\\mathbb R$\uff1b\u552f\u4e00\u4ea4\u70b9\u6a2a\u5750\u6807\u7ea6\u4e3a $3.3$\u3002",
          "figure_ids": []
        },
        {
          "id": "d",
          "text": "\u66f2\u7ebf\u4e3a $y=\\sqrt{x}$ \u4e0e $y=\\frac6x$\uff1b\u5171\u540c\u5b9a\u4e49\u57df\u4e3a $(0,\\infty)$\uff1b\u552f\u4e00\u4ea4\u70b9\u6a2a\u5750\u6807\u7ea6\u4e3a $3.3$\u3002",
