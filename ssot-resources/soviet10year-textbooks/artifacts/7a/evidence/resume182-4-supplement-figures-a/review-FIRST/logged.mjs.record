import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import { spawnSync } from 'node:child_process';

const cwd = '/Users/yong/.codex/worktrees/stemrobin-182-resume/lemmadeck';
const root = path.join(cwd, '.tmp/resume182-4-supplement-figures-a/review-FIRST');
if (process.cwd() !== cwd) throw new Error(`Wrong cwd: ${process.cwd()}`);
const [name, command, ...args] = process.argv.slice(2);
if (!name || !command || !/^[a-z0-9-]+$/.test(name)) throw new Error('name command args required');
const dir = path.join(root, 'commands', name);
fs.mkdirSync(dir, { recursive: true });
if (fs.existsSync(path.join(dir, 'receipt.json'))) throw new Error('Receipt already exists');
const start = new Date().toISOString();
const result = spawnSync(command, args, {
  cwd, encoding: 'utf8', maxBuffer: 32 * 1024 * 1024,
  env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1' },
});
const stdout = result.stdout || '';
const stderr = (result.stderr || '') + (result.error ? `${result.error.stack}\n` : '');
const hash = value => crypto.createHash('sha256').update(value).digest('hex');
fs.writeFileSync(path.join(dir, 'stdout.txt'), stdout, { flag: 'wx' });
fs.writeFileSync(path.join(dir, 'stderr.txt'), stderr, { flag: 'wx' });
fs.writeFileSync(path.join(dir, 'receipt.json'), JSON.stringify({
  cwd, argv: [command, ...args], start, end: new Date().toISOString(),
  exit: result.status, signal: result.signal,
  stdout: { path: path.join(dir, 'stdout.txt'), sha256: hash(stdout) },
  stderr: { path: path.join(dir, 'stderr.txt'), sha256: hash(stderr) },
}, null, 2) + '\n', { flag: 'wx' });
process.stdout.write(stdout);
process.stderr.write(stderr);
console.log(`RECEIPT ${path.join(dir, 'receipt.json')} exit=${result.status}`);
process.exitCode = result.status ?? 1;
