const root = path.join(cwd, '.tmp/resume182-4-supplement-figures-a/review-FIRST');
const load = p => JSON.parse(fs.readFileSync(path.join(root, p), 'utf8'));
const record = p => {
  const absolute = path.isAbsolute(p) ? p : path.join(root, p);
  return { path: absolute, sha256: crypto.createHash('sha256').update(fs.readFileSync(absolute)).digest('hex') };
};
const before = load('hashes-before.json');
const after = load('hashes-after-preview.json');
const browser = load('browser-preview.json');
const inputs = load('inputs-inspection.json');
const native = load('source-pixels.json');
const traces = load('trace-pixels.json');
