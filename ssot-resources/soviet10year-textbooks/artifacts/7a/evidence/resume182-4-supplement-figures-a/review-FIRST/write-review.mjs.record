function contrast(a, b) {
  const rgb = color => color.match(/[\d.]+/g).slice(0, 3).map(Number);
  const lum = color => rgb(color).map(n => {
    const v = n / 255;
    return v <= .04045 ? v / 12.92 : ((v + .055) / 1.055) ** 2.4;
  }).reduce((sum, n, i) => sum + n * [.2126, .7152, .0722][i], 0);
  const l1 = lum(a), l2 = lum(b);
  return (Math.max(l1, l2) + .05) / (Math.min(l1, l2) + .05);
}

const figures = inputs.figures.map(input => {
  const actual = browser.figures.find(f => f.id === input.id);
  const spec = JSON.parse(fs.readFileSync(path.join(cwd, input.specPath), 'utf8'));
  const objectIds = new Set(spec.objects.map(o => o.id));
  const assertionIds = new Set(spec.assertions.map(a => a.id));
  const inventory = spec.source.inventory.map(group => ({
    id: group.id, objects: group.objects, assertions: group.assertions, requires: group.requires ?? [],
    objectIdsResolve: group.objects.every(id => objectIds.has(id)),
    assertionIdsResolve: group.assertions.every(id => assertionIds.has(id)),
    renderedObjectPresence: group.objects.map(id => {
      const object = spec.objects.find(o => o.id === id);
      const dom = actual.themes[0].dom;
      const present = object.type === 'text'
        ? dom.labels.some(l => l.text === object.text)
        : dom.geometry.some(g => g.id === `ld-${input.id}_ld-${id}` || g.id.startsWith(`ld-${input.id}_ld-${id}-`));
      return { id, present };
    }),
  }));
  assert(inventory.every(g => g.objectIdsResolve && g.assertionIdsResolve && g.renderedObjectPresence.every(o => o.present)));
  const expectedText = inputs.template.matches.find(m => String(m.value.number) === input.text[0].exercise).value.text;
  assert.equal(expectedText, input.text[0].text);
  return {
    id: input.id, status: input.id === 'fig-62' ? 'PASS' : 'REVISE',
    source: record(path.join(cwd, input.source.path)),
    spec: record(path.join(cwd, input.specPath)), render: record(path.join(cwd, input.renderPath)), svg: record(path.join(cwd, input.svgPath)),
    retainedRenderStatus: 'pass', renderOrValidateReruns: 0,
    authoritativeText: input.text, currentFullTextExactlyMatchesDraft: true,
    inventoryCoverage: inventory,
    sourceCompleteness: input.id === 'fig-62' ? 'pass' : 'fail: omitted source dashed endpoint guide',
    sourceChecks: input.id === 'fig-62' ? {
      sharedFrame: true, circles: 2, crossings: 2, mutualNonContainment: true,
      logicalHorizontalHatches: 13, logicalVerticalHatches: 14,
      horizontalSegments: 15, verticalSegments: 16,
      hatchingContinuesAcrossIntersection: true, namesOnly: ['Z', 'P'],
      namesInsideOwnNonOverlapLobes: true, noPhysicalUnitsOrMathematicalScale: true,
      modernRegularizations: ['circle rectification/equal radii', 'regular hatch spacing', 'font/label clearance'],
      noElementsAnswersOrExtraFrame: true,
    } : {
      gridColumns: 18, gridRows: 12, verticalLines: 19, horizontalLines: 13,
      xStep: .5, yStep: .5, sourceBounds: spec.objects.find(o => o.type === 'grid').bounds,
      axes: 2, positiveArrows: 2, printedZeroCount: 1,
      labelTexts: actual.themes[0].dom.labels.map(l => l.text),
      noPhysicalUnits: true, noAddedPrintedHalfUnitLabels: true,
      noPointDotsOrQueryAnswerAnnotations: true,
      trace: traces.figures.find(f => f.id === input.id),
    },
    browserChecks: actual.themes.map(theme => ({
      theme: theme.theme, humanViewed: theme.theme === 'neutral',
      claim: theme.theme === 'neutral' ? 'observed actual 640 preview; numeric checks' : 'numeric screenshot pixel visibility only, not perceptual/print acceptance',
      screenshot: theme.screenshot, mediaSize: [theme.dom.width, theme.dom.height],
      minimumTextPx: Math.min(...theme.dom.labels.map(l => l.fontPx)),
      labelVsPaperMinContrast: Math.min(...theme.dom.labels.map(l => contrast(l.fill, theme.dom.paper))),
      geometryCounts: theme.dom.geometry.length,
      minGeometryProbeHitFraction: Math.min(...theme.pixels.probes.map(p => p.fraction)),
      pixels: {
        nonPaper: theme.pixels.nonPaper, nonText: theme.pixels.nonText,
        darkNonText: theme.pixels.darkNonText, assertions: theme.pixels.assertions,
      },
      computedVisibleStrokes: [...new Set(theme.dom.geometry.map(g => g.computedStroke))],
      computedVisibleDashes: [...new Set(theme.dom.geometry.map(g => g.computedDash))],
    })),
    canvas736MinimumTextPx: Math.min(...actual.canvasWidthLabels.map(l => l.fontPx)),
    localWrapperScroll: actual.localMobileScroll,
    findings: findings.filter(f => f.figure === input.id),
  };
});

