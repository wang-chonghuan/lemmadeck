      "inventory": [
        {
          "id": "single-source-grid",
          "description": "One shared rectangular lattice with 19 vertical lines and 13 horizontal lines: 18 columns by 12 rows, step 0.5 on both axes, zero phase; x runs -1.5..7.5, y runs -2..4. Grid line gaps around printed axis values and small scan breaks are typography/damage, not missing cells. Rectification of scanning skew is modern.",
          "objects": [
            "source-half-unit-grid"
          ],
          "assertions": [
            "source-grid-18-by-12"
          ],
          "requires": [
            "gridDimensions"
          ]
        },
        {
          "id": "source-axes-and-labels",
          "description": "Horizontal x and vertical y cross at the sole printed origin 0 and point in the positive directions. Printed x values: [-1, 0, 1, 2, 3, 4, 5, 6]; printed y values: -1, 1, 2, 3. There are no printed half-unit values, curve-name labels, point letters or units. Modern labels are offset to keep clear of strokes. The x=-1 label moves above its unchanged tick position after the first renderer reported a curve collision. This side change is modern, not a source label-placement fact.",
          "objects": [
            "source-x-axis",
            "source-y-axis",
            "source-x-direction",
            "source-y-direction",
            "source-x-value-minus-1",
            "source-x-value-0",
            "source-x-value-1",
            "source-x-value-2",
            "source-x-value-3",
            "source-x-value-4",
