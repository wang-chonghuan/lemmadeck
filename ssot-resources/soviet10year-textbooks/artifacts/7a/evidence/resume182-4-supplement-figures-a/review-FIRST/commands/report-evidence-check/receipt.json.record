    "const fs=require(\"fs\"),crypto=require(\"crypto\"),assert=require(\"assert/strict\"),path=require(\"path\");const cwd=\"/Users/yong/.codex/worktrees/stemrobin-182-resume/lemmadeck\";assert.equal(process.cwd(),cwd);const root=path.join(cwd,\".tmp/resume182-4-supplement-figures-a/review-FIRST\");const hash=p=>crypto.createHash(\"sha256\").update(fs.readFileSync(p)).digest(\"hex\");const r=JSON.parse(fs.readFileSync(path.join(root,\"review.json\")));const b=JSON.parse(fs.readFileSync(path.join(root,\"browser-preview.json\")));const h=JSON.parse(fs.readFileSync(path.join(root,\"hashes-final.json\")));assert.equal(r.status,\"REVISE\");assert.equal(r.imageCounter.batch,8);assert.equal(r.imageCounter.observations.length,8);assert(h.unchanged);assert.equal(h.records.length,18);for(const e of r.evidence)assert.equal(hash(e.path),e.sha256);for(const f of b.figures)for(const t of f.themes){assert.equal(hash(t.screenshot.path),t.screenshot.sha256);assert(Object.values(t.pixels.assertions).every(Boolean));}for(const e of h.records)assert.equal(hash(e.path),e.sha256);assert(b.headedAvailable&&b.browserClosed);for(const name of [\"review.md\",\"review.json\",\"browser-preview.json\",\"hashes-final.json\"]){const p=path.join(root,name);console.log(JSON.stringify({path:p,sha256:hash(p)}));}console.log(\"PASS: review evidence hashes, 9 numerical theme screenshots, 8 bounded image observations, and 18 unchanged protected inputs; aggregate content review remains REVISE.\");"
