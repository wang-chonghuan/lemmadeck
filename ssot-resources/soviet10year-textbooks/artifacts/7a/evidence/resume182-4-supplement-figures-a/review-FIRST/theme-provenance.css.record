:root {--sr-white: #FFFFFF;
--sr-panel: #F5F9F9;
--sr-card: #FFFFFF;
--sr-blue: #0E7C9B;
--sr-blue-deep: #0A5E76;
--sr-blue-tint: #E1F1F5;
--sr-green: #15A06A;
--sr-green-deep: #0F7D52;
--sr-green-tint: #E4F6EE;
--sr-ink: #15201F;
--sr-ink-soft: #4C5A58;
--sr-ink-dim: #8A9795;
--sr-line: #E3EAE9;
--sr-line-soft: #EEF3F2;
--sr-radius: 10px;
--sr-radius-sm: 8px;
--sr-font: "Inter", system-ui, sans-serif;
--sr-display: var(--sr-font);
--sr-body: var(--sr-font);
--sr-mono: var(--sr-font);}
.sr-figure-media {--ld-figure-ink: var(--sr-ink);
--ld-figure-muted: var(--sr-ink-soft);
--ld-figure-accent: var(--sr-ink);
--ld-figure-accent-soft: var(--sr-ink-dim);
--ld-figure-grid: var(--sr-line);
--ld-figure-paper: var(--sr-white);}
.sr-figure-media[data-figure-theme="accent"] {--ld-figure-accent: var(--sr-blue);
--ld-figure-accent-soft: var(--sr-green);
--ld-figure-grid: var(--sr-blue-tint);}
@media print {.sr-figure-media {--ld-figure-ink: var(--sr-ink);
--ld-figure-muted: var(--sr-ink-soft);
--ld-figure-accent: var(--sr-ink);
--ld-figure-accent-soft: var(--sr-ink-dim);
--ld-figure-grid: var(--sr-line);}}
