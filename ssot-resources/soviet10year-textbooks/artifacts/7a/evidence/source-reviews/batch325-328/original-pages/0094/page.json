      "open": false,
      "samerow": false,
      "lines": [
        "317. 求值（答案写成标准形式）：",
        "а) $\\frac{6.2\\cdot 10^9\\cdot 3.6\\cdot 10^{-2}}{7.2\\cdot 10^3}$；",
        "б) $7.5\\cdot 10^2\\cdot\\frac{4.6}{2.5\\cdot 10^6}$。"
      ]
    },
