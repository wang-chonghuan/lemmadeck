import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-resume/lemmadeck';
assert.equal(process.cwd(), repo);
const source = 'ssot-resources/soviet10year-textbooks/artifacts/7a';
const target = '.tmp/resume182-4-postaccount/n13-source-affected1/7a';
const work = '.tmp/resume182-4-postaccount/n13-source/7a';
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const entries = [];
for (const [page, kind] of [['0007', 'h1'], ['0052', 'h2'], ['0061', null]]) {
  const input = `${source}/pages/${page}/page.json`;
  const bytes = fs.readFileSync(input);
  const original = JSON.parse(bytes);
  const blocks = kind ? original.blocks.filter(block => block.kind === kind) : original.blocks;
  if (kind) assert.equal(blocks.length, 1);
  const output = `${target}/pages/${page}/page.json`;
  assert.ok(!fs.existsSync(output));
  fs.mkdirSync(path.dirname(output), { recursive: true });
  fs.writeFileSync(output, kind ? `${JSON.stringify({ meta: original.meta, blocks }, null, 2)}\n` : bytes,
    { flag: 'wx', mode: 0o444 });
  entries.push({ source: input, sha256: hash(bytes), path: output,
    role: kind ? 'ancestor-heading-only' : 'unchanged-approved-predecessor',
    source_refs: blocks.map(block => `p${page}#${original.blocks.indexOf(block) + 1}`) });
}
for (const suffix of ['png', 'svg']) {
  const input = `${source}/figures/fig-05.${suffix}`;
  const output = `${work}/pages/0061/figures/fig-05.${suffix}`;
  assert.ok(!fs.existsSync(output));
  fs.mkdirSync(path.dirname(output), { recursive: true });
  fs.symlinkSync(path.resolve(input), output);
  entries.push({ source: input, sha256: hash(fs.readFileSync(input)), path: output,
    role: 'existing-carry-over-figure-not-n13-not-revalidated' });
}
const record = {
  schema: 'stemrobin-182/isolated-assembly-context@1', book: '7a', lesson: 'alg7-c1-s4-n13',
  entries, images_loaded: 0, source_or_figure_checks: 0,
  context_pages_promoted: false, incomplete_supplement_promoted: false,
  durable_sources_changed: false,
};
fs.writeFileSync(`${target}/context-binding.record`, `${JSON.stringify(record, null, 2)}\n`,
  { flag: 'wx' });
console.log(JSON.stringify({ context_entries: entries.length, record: `${target}/context-binding.record` }));
