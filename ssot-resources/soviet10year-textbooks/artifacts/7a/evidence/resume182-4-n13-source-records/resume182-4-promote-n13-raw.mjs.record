import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-resume/lemmadeck';
assert.equal(process.cwd(), repo);
const source = '.tmp/resume182-4-postaccount/n13-source-affected1/7a';
const target = 'ssot-resources/soviet10year-textbooks/artifacts/7a';
const id = 'alg7-c1-s4-n13';
const hash = bytes => createHash('sha256').update(bytes).digest('hex');
const read = file => JSON.parse(fs.readFileSync(file));
const reviewPath = '.tmp/resume182-4-postaccount/n13-source-review-FIRST/affected-punctuation1/result.json';
assert.equal(hash(fs.readFileSync(reviewPath)),
  '350be3595e02479400a89fa4be37a82e50d08c6019d86111e60dd05d88519c60');
const lesson = read(`${source}/lessons/${id}/lesson.json`);
const exercises = read(`${source}/lessons/${id}/exercises.json`);
assert.equal(lesson.id, id);
assert.equal(lesson.chapter, '第一章　有理分式');
assert.equal(lesson.section, '§4. 整数指数幂');
assert.equal(lesson.prose.length, 9);
assert.deepEqual(exercises.exercises.map(item => Number(item.number)),
  Array.from({ length: 17 }, (_, index) => 168 + index));
const relativeFiles = [];
for (const [page, count] of [[62, 25], [63, 27], [64, 22], [65, 25]]) {
  const prefix = `pages/${String(page).padStart(4, '0')}`;
  const audit = read(`${source}/${prefix}/audit.json`);
  assert.deepEqual(audit.errors, []);
  assert.equal(audit.lines_printed, count);
  assert.equal(audit.lines_md, count);
  relativeFiles.push(...['page.md', 'page.json', 'audit.json'].map(file => `${prefix}/${file}`));
}
relativeFiles.push(...['lesson.json', 'lesson.md', 'exercises.json'].map(file => `lessons/${id}/${file}`),
  'figures/tbl-p0064-01.png', 'figures/tbl-p0064-01.svg');
function inventory(root) {
  return fs.readdirSync(root, { withFileTypes: true }).flatMap(entry => {
    const file = path.join(root, entry.name);
    return entry.isDirectory() ? inventory(file) :
      entry.isFile() ? [{ path: file, sha256: hash(fs.readFileSync(file)) }] : [];
  });
}
const unchanged = [...inventory(`${target}/lessons`),
  ...inventory(`${target}/editions/modern-us-neutral/lessons`)];
const recordRoot = `${source}/promotion`;
assert.ok(!fs.existsSync(recordRoot));
fs.mkdirSync(recordRoot);
fs.writeFileSync(`${recordRoot}/book-before.json.record`, fs.readFileSync(`${target}/book.json`),
  { flag: 'wx' });
const retained = [];
for (const relative of relativeFiles) {
  const file = `${target}/${relative}`;
  const bytes = fs.readFileSync(`${source}/${relative}`);
  assert.ok(!fs.existsSync(file), `existing product artifact: ${file}`);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, bytes, { flag: 'wx' });
  retained.push({ source: `${source}/${relative}`, path: file, sha256: hash(bytes) });
}
for (const file of unchanged) assert.equal(hash(fs.readFileSync(file.path)), file.sha256);
const record = {
  schema: 'stemrobin-182/raw-lesson-promotion@1', book: '7a', lesson: id,
  source_review: { historical_path: reviewPath, sha256: hash(fs.readFileSync(reviewPath)) },
  retained, unchanged, counts: { prose: 9, exercises: 17, figures: 1, new_source_pages: 4 },
  context_only_pages_promoted: false, incomplete_supplement_promoted: false,
  source_rechecks: 0, image_views: 0, modern_answers_choices_app_approved: false,
};
fs.writeFileSync(`${recordRoot}/promotion.record`, `${JSON.stringify(record, null, 2)}\n`,
  { flag: 'wx' });
console.log(JSON.stringify({ retained: retained.length, unchanged: unchanged.length,
  record: `${recordRoot}/promotion.record`, counts: record.counts }));
