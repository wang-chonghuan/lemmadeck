    const theoremMatches = [...textWindow.seen_scope.join(' ').matchAll(/Theorem (\d+) statement/gu)];
    const lastTheorem = theoremMatches.at(-1)?.[1];
    const theoremIndex = prose.findIndex((item) => item.text.includes(`定理 $${lastTheorem}$`));
    assert.ok(theoremIndex >= 0, 'Old visible theorem boundary must bind unambiguously');
    const firstParagraph = theoremIndex + 1;
