    const partialPromptSeen = /Question 544 prompt/u.test(writtenWindow.seen_scope.join(' '));
    result.inheritedWritten = { reviewSeenScope: writtenWindow.seen_scope, lastComplete: lastWritten };
    await page.goto(`${origin}/exercises.html`, { waitUntil: 'load' });
    await page.evaluate(() => document.fonts.ready);
    for (const item of exercises.exercises) {
      const body = page.locator(`#ex-${item.number} .body`);
      await bind(body, projection(writtenText(item)), `${viewport.name} written ${item.number} binding-only`);
      if (Number(item.number) > lastWritten) {
        const startLine = partialPromptSeen && String(item.number) === '544' ? 1 : 0;
        result.missingWritten.push({ id: item.number, ...await inspect(body,
          `${viewport.name}: newly missing written ${item.number} from line ${startLine}`, startLine) });
      }
    }
    const writtenIds = viewport.name === 'desktop' ? ['544', '545', '546', '547'] : ['545', '546', '547'];
    await screenshot(page, viewport.name === 'desktop' ? '02-desktop-written-tail' : '06-mobile-written-tail',
      writtenIds.map((id) => ({ selector: `#ex-${id}`, writtenId: id })));
    const choiceWindow = oldChoiceReview.windows.find((item) => item.viewport.width === viewport.width);
    const approvedOptions = choiceWindow.visible_scope.complete_visible_option_rows;
    let consumed = 0;
    let firstChoice = 0;
    while (firstChoice < views.length
      && consumed + views[firstChoice].view.options.length <= approvedOptions) {
      consumed += views[firstChoice].view.options.length;
      firstChoice += 1;
    }
    assert.equal(consumed, approvedOptions, 'Old option boundary must align to frozen current payload');
    result.inheritedChoices = {
      oldCompleteVisibleOptions: approvedOptions, firstMissingQuestionIndex: firstChoice,
      visibleScope: choiceWindow.visible_scope.content,
    };
    await page.goto(`${origin}/choices.html`, { waitUntil: 'load' });
    await page.evaluate(() => document.fonts.ready);
    for (const [index, item] of views.entries()) {
      const section = page.locator('section.choice').nth(index);
      await bind(section.locator('.choice-stem'), projection(item.view.stem),
        `${viewport.name} root ${index + 1} stem binding-only`);
      const letters = await section.locator('.option-id').allTextContents();
      await need(`${viewport.name} root ${index + 1}: frozen A-H visible IDs bind current payload`,
        JSON.stringify(letters.map(norm)) === JSON.stringify(item.view.options.map((option) => option.id)));
      for (const [optionIndex, option] of item.view.options.entries()) {
        await bind(section.locator('.choice-option-body').nth(optionIndex), projection(option.text),
          `${viewport.name} root ${index + 1}${option.id} binding-only`);
      }
      if (index >= firstChoice) {
        const stem = await inspect(section.locator('.choice-stem'),
          `${viewport.name}: newly missing root ${index + 1} stem`);
        const options = [];
        for (const [optionIndex, option] of item.view.options.entries()) {
          const body = section.locator('.choice-option-body').nth(optionIndex);
          options.push({ id: option.id, ...await inspect(body,
            `${viewport.name}: newly missing root ${index + 1}${option.id}`) });
        }
        const order = await section.locator('.choice-options>li').evaluateAll((nodes) =>
          nodes.map((node) => ({ top: node.getBoundingClientRect().top, bottom: node.getBoundingClientRect().bottom })));
        await check(`${viewport.name}: newly missing root ${index + 1} option rows ordered/no overlap`,
          order.every((row, rowIndex) => !rowIndex || row.top >= order[rowIndex - 1].bottom - 1), { order });
        result.missingChoices.push({ index, id: item.id, stem, options });
      }
    }
    if (viewport.name === 'desktop') {
      await screenshot(page, '03-desktop-root-choice-tail', [5, 6].map((index) => ({
        selector: `section.choice:nth-of-type(${index + 1})`, choiceIndex: index,
      })));
    } else {
      await screenshot(page, '07-mobile-product-fractions', [{
        selector: 'section.choice:nth-of-type(5)', choiceIndex: 4,
      }]);
      await screenshot(page, '08-mobile-root-final-options', [{
        selector: 'section.choice:nth-of-type(7)', choiceIndex: 6,
      }]);
    }
    await check(`${viewport.name}: own run no external requests/browser faults`,
      result.pageerrors.length === 0 && result.consoleErrors.length === 0
      && result.requestFailures.length === 0 && result.blockedRequests.length === 0,
      { pageerrors: result.pageerrors, consoleErrors: result.consoleErrors,
        requestFailures: result.requestFailures, blockedRequests: result.blockedRequests });
    await context.close();
    contexts.splice(contexts.indexOf(context), 1);
  }
  await need('exactly eight new focused screenshots, zero old image opens',
    report.screenshots.length === 8, { images: report.screenshots.length, oldImagesOpened: 0 });
  for (const binding of report.inputs) {
    await check(`input remained unchanged: ${binding.path}`,
      sha(await readFile(path.join(R, binding.path))) === binding.sha256);
  }
} catch (error) {
  report.failure = { type: error.name, message: error.message, stack: error.stack };
  await event({ stage: 'FIRST-failure-retained', failure: report.failure });
  console.error(JSON.stringify(report.failure));
} finally {
  for (const context of contexts) {
    try { await context.close(); } catch (error) {
      report.cleanup.contextsClosed = false;
      await event({ cleanupFailure: { target: 'context', message: error.message } });
    }
  }
  try {
    if (browser) await browser.close();
    report.cleanup.browserClosed = true;
  } catch (error) {
    await event({ cleanupFailure: { target: 'browser', message: error.message } });
  }
  try {
    if (server?.listening) {
      server.closeIdleConnections();
      await new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
    }
    report.cleanup.serverClosed = true;
  } catch (error) {
    await event({ cleanupFailure: { target: 'server', message: error.message } });
  }
  report.finished = new Date().toISOString();
  report.servedRequests = served;
  report.passCount = report.checks.filter((item) => item.status === 'PASS').length;
  report.failCount = report.checks.filter((item) => item.status === 'FAIL').length;
  report.status = report.failure || report.failCount || Object.values(report.cleanup).some((closed) => !closed)
    ? 'FAIL_FIRST_PRESERVED' : 'DOM_MISSING_RANGES_PASS_VISUAL_PENDING';
  report.stillUnobserved = [
    'Pixels outside the exact old approved windows and eight selected new image regions',
    'Supplement visuals inherited, not re-opened or re-tested',
    'Source/math/key/figure correctness, independent production, APP/DB and real gestures',
    'Whole course and 881 approval',
  ];
  const filename = path.join(RUN, 'receipt.record');
  const serialized = `${JSON.stringify(report, null, 2)}\n`;
  await writeFile(filename, serialized, { flag: 'wx' });
  console.log(JSON.stringify({
    status: report.status, receipt: filename, sha256: sha(serialized),
    pass: report.passCount, fail: report.failCount, failure: report.failure?.message ?? null,
    screenshots: report.screenshots.map((item) => ({
      path: path.join(R, item.path), sha256: item.sha256, targets: item.targets,
    })), cleanup: report.cleanup,
  }, null, 2));
  if (report.status === 'FAIL_FIRST_PRESERVED') process.exitCode = 1;
}
