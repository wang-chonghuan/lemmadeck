    && oldText.checks.every((item) => item.status === 'pass')
    && oldChoices.checks.every((item) => item.status === 'pass')
    && textRender.actual_exit === 0 && choiceRender.actual_exit === 0
    && sha(await readFile(path.join(TEXT, 'first-display-check.json'))) === textRetention.parent_DOM_receipt.raw_sha256
    && sha(await readFile(path.join(TEXT, 'first-display-review.json'))) === textRetention.observer_report.raw_sha256
    && sha(await readFile(path.join(CHOICE, 'first-display-check.json'))) === choiceRetention.parent_DOM_receipt.raw_sha256
    && sha(await readFile(path.join(CHOICE, 'first-display-review.json'))) === choiceRetention.observer_report.raw_sha256);
  const lesson = await json(path.join(L, 'lesson.json'));
  const exercises = await json(path.join(L, 'exercises.json'));
  const draft = await json(path.join(L, 'choice-set/draft.json'));
  const requireApp = createRequire(path.join(R, 'app/package.json'));
  const { chromium } = requireApp('@playwright/test');
  const coreRoot = path.dirname(requireApp.resolve('playwright-core/package.json'));
  ({ PNG } = requireApp(path.join(coreRoot, 'lib/utilsBundle.js')));
  const requireSkill = createRequire(path.join(R, '.claude/skills/ld-s10y-lesson/tools/htmlfrag.js'));
  const { proseFlow } = requireSkill('./htmlfrag.js');
  const prose = proseFlow(lesson.prose, lesson.section_breaks).filter((item) => item.kind === 'p');
  const views = draft.questions.map((question) => ({ id: question.id, view: question.view }));
  report.currentPayloadCounts = {
    kind: 'binding-only, not repeated global acceptance check',
    proseBlocks: lesson.prose.length, proseParagraphs: prose.length,
    writtenObjects: exercises.exercises.length, writtenIds: exercises.exercises.map((item) => item.number),
    rootQuestions: views.length, rootOptions: views.reduce((sum, item) => sum + item.view.options.length, 0),
    rootSources: ['539', '540', '542', '543', '544', '545', '546'],
