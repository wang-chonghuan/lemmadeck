async function event(value) {
  await appendFile(path.join(RUN, 'events.ndjson'),
    `${JSON.stringify({ time: new Date().toISOString(), ...value })}\n`);
}
async function check(name, ok, facts = {}) {
  const item = { name, status: ok ? 'PASS' : 'FAIL', ...facts };
  report.checks.push(item);
  await event({ check: item });
  if (!ok) console.error(JSON.stringify(item));
  return ok;
}
async function need(name, ok, facts = {}) {
  assert.ok(await check(name, ok, facts), name);
}
async function input(filename) {
  assert.ok(filename.startsWith(`${L}${path.sep}`) || filename === fileURLToPath(import.meta.url));
  assert.ok(!filename.endsWith('.png'), 'No old/source/supplement image reads');
  const bytes = await readFile(filename);
  report.inputs.push({ path: rel(filename), sha256: sha(bytes), bytes: bytes.length });
  return bytes;
}
async function json(filename) { return JSON.parse(await input(filename)); }
function projection(text) {
  const formulas = [];
  const serialized = text.replace(/\$\$(.+?)\$\$|\$([^$]+?)\$/gs, (_, block, inline) => {
    const index = formulas.length;
    formulas.push(norm(block ?? inline));
    return `[[MATH:${index}]]`;
  }).replace(/\*\*([^*]+)\*\*/gu, '$1');
  return { text: norm(serialized), lines: serialized.split('\n').map(norm), formulas };
}
function writtenText(item) {
  const printed = Object.hasOwn(item, 'source_number') ? item.source_number : item.number;
  const prefix = printed == null ? '' : String(printed);
  const suffix = item.text.slice(prefix.length);
  return prefix && item.text.startsWith(prefix)
    && (/^\.\s/u.test(suffix) || /^\uFF0E(?![0-9\uFF10-\uFF19])/u.test(suffix))
    ? item.text.slice(prefix.length + 1).trimStart() : item.text;
}

// Payload-only binding is allowed for the full documents. It does not repeat old
// global count, math-validity, no-private-field, or first-window geometry checks.
function payload(element) {
  let text = '';
  const formulas = [];
  function walk(node) {
    if (node.nodeType === Node.TEXT_NODE) { text += node.data; return; }
    if (node.nodeType !== Node.ELEMENT_NODE || node.matches('figure')) return;
    if (node.matches('br')) { text += '\n'; return; }
    if (node.matches('.katex')) {
      const index = formulas.length;
      formulas.push(node.querySelector('annotation[encoding="application/x-tex"]')?.textContent
        ?.trim().replace(/\s+/gu, ' ') ?? null);
      text += `[[MATH:${index}]]`;
      return;
    }
    for (const child of node.childNodes) walk(child);
  }
  walk(element);
  const normalize = (value) => value.normalize('NFC').replace(/\s+/gu, ' ').trim();
  return { text: normalize(text), lines: text.split('\n').map(normalize), formulas };
}

// Only newly unapproved logical lines are visited, not the already-passed ranges.
async function missingGlyphs(element, startLine) {
  const targets = [];
  const failures = [];
  const formulas = [];
  const lineRects = [];
  let logicalLine = 0;
  let selectedGlyphs = 0;
  const styleVisible = (target) => {
    for (let current = target; current; current = current.parentElement) {
      const style = getComputedStyle(current);
      if (style.display === 'none' || style.visibility !== 'visible'
        || Number(style.opacity) === 0 || style.contentVisibility === 'hidden') return false;
    }
    return true;
  };
  function addText(node, formulaIndex) {
    if (logicalLine < startLine) return;
    for (let offset = 0; offset < node.data.length; offset += 1) {
      if (/[\s\u200b\u200c\u200d\u2060\ufeff]/u.test(node.data[offset])) continue;
      selectedGlyphs += 1;
      const range = document.createRange();
      range.setStart(node, offset);
      range.setEnd(node, offset + 1);
      const rect = range.getBoundingClientRect();
      (lineRects[logicalLine] ??= []).push({ top: rect.top, bottom: rect.bottom });
      targets.push({ range, element: node.parentElement, formulaIndex, logicalLine });
    }
  }
  function walk(node) {
    if (node.nodeType === Node.TEXT_NODE) { addText(node, null); return; }
    if (node.nodeType !== Node.ELEMENT_NODE || node.matches('figure, .katex-mathml')) return;
    if (node.matches('br')) { logicalLine += 1; return; }
    if (node.matches('.katex')) {
      const index = formulas.length;
      if (logicalLine >= startLine) {
        const visual = node.querySelector('.katex-html');
        formulas.push({
          tex: node.querySelector('annotation[encoding="application/x-tex"]')?.textContent?.trim(),
          nonempty: Boolean(visual?.textContent?.trim()), visible: Boolean(visual && styleVisible(visual)),
        });
        if (visual) {
          const walker = document.createTreeWalker(visual, NodeFilter.SHOW_TEXT);
          for (let text = walker.nextNode(); text; text = walker.nextNode()) addText(text, index);
        }
      }
      return;
    }
    for (const child of node.childNodes) walk(child);
  }
  walk(element);
  const geometry = lineRects.map((rects, line) => rects?.length ? {
    line, top: Math.min(...rects.map((rect) => rect.top)),
    bottom: Math.max(...rects.map((rect) => rect.bottom)),
  } : null).filter(Boolean);
  let reached = 0;
  let formulaGlyphs = 0;
  const touchedScrollers = new Set();
  for (const target of targets) {
    let rect = target.range.getBoundingClientRect();
    window.scrollBy({ top: rect.top + rect.height / 2 - innerHeight / 2, behavior: 'instant' });
    for (let ancestor = target.element; ancestor; ancestor = ancestor.parentElement) {
      if (ancestor === document.body || ancestor === document.documentElement) continue;
      const style = getComputedStyle(ancestor);
      if (!['auto', 'scroll'].includes(style.overflowX)
        || ancestor.scrollWidth <= ancestor.clientWidth + 1) continue;
      touchedScrollers.add(ancestor);
      rect = target.range.getBoundingClientRect();
      const box = ancestor.getBoundingClientRect();
      const left = box.left + ancestor.clientLeft;
      const right = left + ancestor.clientWidth;
      let delta = 0;
      if (rect.left < left) delta = rect.left - left;
      if (rect.right > right) delta = rect.right - right;
      ancestor.scrollTo({ left: ancestor.scrollLeft + delta, behavior: 'instant' });
    }
    rect = target.range.getBoundingClientRect();
    let reason = null;
    if (rect.width <= 0 || rect.height <= 0 || !styleVisible(target.element)) reason = 'hidden-glyph';
    if (!reason && (rect.left < -2 || rect.right > innerWidth + 2
      || rect.top < -2 || rect.bottom > innerHeight + 2)) reason = 'unreachable-viewport';
    for (let ancestor = target.element; !reason && ancestor; ancestor = ancestor.parentElement) {
      if (ancestor === document.body || ancestor === document.documentElement) continue;
      const style = getComputedStyle(ancestor);
      const box = ancestor.getBoundingClientRect();
      if (['auto', 'scroll', 'hidden', 'clip'].includes(style.overflowX)
        && (rect.left < box.left + ancestor.clientLeft - 2
          || rect.right > box.left + ancestor.clientLeft + ancestor.clientWidth + 2)) reason = 'x-clipping';
      if (['auto', 'scroll', 'hidden', 'clip'].includes(style.overflowY)
        && (rect.top < box.top + ancestor.clientTop - 2
          || rect.bottom > box.top + ancestor.clientTop + ancestor.clientHeight + 2)) reason = 'y-clipping';
    }
    if (reason) {
      if (failures.length < 20) failures.push({
        line: target.logicalLine, formulaIndex: target.formulaIndex, reason,
        rect: { x: rect.x, y: rect.y, width: rect.width, height: rect.height },
      });
    } else {
      reached += 1;
      if (target.formulaIndex !== null) formulaGlyphs += 1;
    }
  }
  const ends = [];
  for (const scroller of touchedScrollers) {
    scroller.scrollTo({ left: scroller.scrollWidth - scroller.clientWidth, behavior: 'instant' });
    ends.push({
      clientWidth: scroller.clientWidth, scrollWidth: scroller.scrollWidth,
      scrollLeft: scroller.scrollLeft, maximum: scroller.scrollWidth - scroller.clientWidth,
    });
    scroller.scrollTo({ left: 0, behavior: 'instant' });
  }
  return {
    startLine, selectedGlyphs, reached, clippedOrHidden: selectedGlyphs - reached,
    formulaGlyphs, formulas: formulas.length,
    nonemptyVisibleMath: formulas.every((formula) => formula.nonempty && formula.visible),
    logicalLineGeometry: geometry,
    lineOrder: geometry.every((line, index) => !index || line.top > geometry[index - 1].top + 0.5),
    ends, failures, tablesInMissingRange: element.querySelectorAll('table').length,
  };
}

let server;
let browser;
let origin;
let PNG;
const contexts = [];
const served = [];
async function bind(locator, expected, label) {
  const actual = await locator.evaluate(payload);
  await need(`${label}: current visible payload equals frozen HTML`,
    JSON.stringify(actual) === JSON.stringify(expected),
    { expectedSha256: sha(JSON.stringify(expected)), actualSha256: sha(JSON.stringify(actual)),
      regenerated: false });
}
async function inspect(locator, name, startLine = 0) {
  const actual = await locator.evaluate(missingGlyphs, startLine);
  await check(name, actual.selectedGlyphs > 0 && actual.clippedOrHidden === 0
    && actual.nonemptyVisibleMath && actual.lineOrder
    && actual.ends.every((end) => Math.abs(end.maximum - end.scrollLeft) < 1.1), actual);
  return actual;
}
async function screenshot(page, name, targets) {
  assert.ok(report.screenshots.length < 8, 'Eight-image cap');
  const locators = targets.map((target) => page.locator(target.selector));
  for (const locator of locators) {
    await locator.scrollIntoViewIfNeeded();
  }
  const rectangles = [];
  for (const locator of locators) {
    rectangles.push(await locator.evaluate((element) => {
      const rect = element.getBoundingClientRect();
      const bad = [element, ...element.querySelectorAll('*')].filter((item) =>
        !item.closest('.katex-mathml')).some((item) => item.clientWidth > 0
          && item.scrollWidth > item.clientWidth + 1);
      return { x: rect.left, right: rect.right, top: rect.top + scrollY,
        bottom: rect.bottom + scrollY, bad };
    }));
  }
  const width = page.viewportSize().width;
  const top = Math.max(0, Math.floor(Math.min(...rectangles.map((rect) => rect.top)) - 4));
  const bottom = Math.ceil(Math.max(...rectangles.map((rect) => rect.bottom)) + 4);
  await need(`${name}: complete element focus, not a full-page dump`,
    rectangles.every((rect) => rect.x >= 0 && rect.right <= width && !rect.bad)
    && bottom - top <= page.viewportSize().height * 1.8,
    { targets, height: bottom - top, viewport: page.viewportSize() });
  const filename = path.join(RUN, `${name}.png`);
  const bytes = await page.screenshot({
    path: filename, type: 'png', animations: 'disabled', fullPage: true,
    clip: { x: 0, y: top, width, height: bottom - top },
  });
  const decoded = PNG.sync.read(bytes);
  let ink = 0;
  for (let offset = 0; offset < decoded.data.length; offset += 4) {
    if (decoded.data[offset + 3] && Math.max(...decoded.data.subarray(offset, offset + 3)) < 160) ink += 1;
  }
  const entry = {
    path: rel(filename), sha256: sha(bytes), width: decoded.width, height: decoded.height,
    targets, ink, opens: 0, visualStatus: 'PENDING one view after runtime',
  };
  report.screenshots.push(entry);
  await check(`${name}: nonblank selected image`, ink > 200, entry);
}

