  "exercises": [
    {
      "number": "987",
      "source_binding": "source-read.receipt.json#/bindings/0",
      "subparts": [
        {
          "label": "a",
          "expression_latex": "\\frac{1}{11-2\\sqrt{30}}-\\frac{1}{11+2\\sqrt{30}}",
          "domain": "Constant real expression; both original denominators are nonzero.",
          "result_latex": "4\\sqrt{30}",
          "proof": [
            "(11-2sqrt(30))(11+2sqrt(30)) = 121-120 = 1, so neither factor is zero.",
            "Combining the fractions gives [(11+2sqrt(30))-(11-2sqrt(30))]/1 = 4sqrt(30)."
          ]
        },
        {
          "label": "b",
          "expression_latex": "\\frac{5}{3+2\\sqrt{2}}+\\frac{5}{3-2\\sqrt{2}}",
          "domain": "Constant real expression; both original denominators are nonzero.",
          "result_latex": "30",
          "proof": [
            "(3+2sqrt(2))(3-2sqrt(2)) = 9-8 = 1.",
            "The combined numerator is 5[(3-2sqrt(2))+(3+2sqrt(2))] = 30."
          ]
        },
        {
          "label": "c",
          "expression_latex": "\\frac{\\sqrt{5}-\\sqrt{3}}{\\sqrt{5}+\\sqrt{3}}+\\frac{\\sqrt{5}+\\sqrt{3}}{\\sqrt{5}-\\sqrt{3}}",
          "domain": "Constant real expression; the original denominator product is 2, hence neither denominator is zero.",
          "result_latex": "8",
          "proof": [
            "(sqrt(5)+sqrt(3))(sqrt(5)-sqrt(3)) = 5-3 = 2.",
            "The combined numerator is (sqrt(5)-sqrt(3))^2+(sqrt(5)+sqrt(3))^2 = 2(5+3) = 16.",
            "The value is 16/2 = 8."
          ]
        },
        {
          "label": "d",
          "expression_latex": "\\frac{11+\\sqrt{21}}{11-\\sqrt{21}}+\\frac{11-\\sqrt{21}}{11+\\sqrt{21}}",
          "domain": "Constant real expression; the original denominator product is 100, hence neither denominator is zero.",
          "result_latex": "\\frac{71}{25}",
          "proof": [
            "(11-sqrt(21))(11+sqrt(21)) = 121-21 = 100.",
            "The combined numerator is (11+sqrt(21))^2+(11-sqrt(21))^2 = 2(121+21) = 284.",
            "284/100 = 71/25."
          ]
        }
      ]
    },
    {
      "number": "988",
      "source_binding": "source-read.receipt.json#/bindings/1",
      "subparts": [
        {
          "label": "a",
          "statement_latex": "\\frac{(2+\\sqrt{3})^2-1}{(\\sqrt{3}+1)^2}=\\sqrt{3}",
          "domain": "Constant real identity; (sqrt(3)+1)^2 > 0.",
          "result_latex": "\\sqrt{3}",
          "proof": [
            "(2+sqrt(3))^2-1 = 6+4sqrt(3).",
            "sqrt(3)(sqrt(3)+1)^2 = sqrt(3)(4+2sqrt(3)) = 6+4sqrt(3).",
            "Divide by the strictly positive denominator to obtain the identity."
          ]
        },
        {
          "label": "b",
          "statement_latex": "\\frac{(3+\\sqrt{5})^2-4}{(\\sqrt{5}+1)^2}=\\sqrt{5}",
          "domain": "Constant real identity; (sqrt(5)+1)^2 > 0.",
          "result_latex": "\\sqrt{5}",
          "proof": [
            "(3+sqrt(5))^2-4 = 10+6sqrt(5).",
            "sqrt(5)(sqrt(5)+1)^2 = sqrt(5)(6+2sqrt(5)) = 10+6sqrt(5).",
            "Divide by the strictly positive denominator to obtain the identity."
          ]
        }
      ]
    },
    {
      "number": "989",
      "source_binding": "source-read.receipt.json#/bindings/2",
      "subparts": [
        {
          "label": "a",
          "expression_latex": "\\frac{(\\sqrt{a}+\\sqrt{b})^2-b}{\\sqrt{ab}+2b}",
          "natural_domain_latex": "a\\ge0,\\quad b>0",
          "domain_proof": "Individual roots require a,b >= 0. The denominator sqrt(ab)+2b is zero exactly when b=0 and is strictly positive for b>0.",
          "simplified_latex": "\\sqrt{\\frac{a}{b}}",
          "evaluation": {
            "given": {"a": "5", "b": "2"},
            "exact_latex": "\\sqrt{\\frac52}=\\frac{\\sqrt{10}}2"
          },
          "proof": [
            "On the original domain sqrt(ab) = sqrt(a)sqrt(b).",
            "The numerator is a+2sqrt(ab) = sqrt(a)(sqrt(a)+2sqrt(b)).",
            "The denominator is sqrt(b)(sqrt(a)+2sqrt(b)).",
            "The common factor is strictly positive because b>0, so cancellation gives sqrt(a)/sqrt(b) = sqrt(a/b).",
            "Substitution a=5, b=2 gives sqrt(5/2) = sqrt(10)/2."
          ]
        },
        {
          "label": "b",
          "expression_latex": "\\frac{(\\sqrt{x}-\\sqrt{y})^2+4\\sqrt{xy}}{x+\\sqrt{xy}}",
          "natural_domain_latex": "x>0,\\quad y\\ge0",
          "domain_proof": "Individual roots require x,y >= 0. The denominator x+sqrt(xy) is zero exactly when x=0 and is strictly positive for x>0.",
          "simplified_latex": "1+\\sqrt{\\frac{y}{x}}",
          "evaluation": {
            "given": {"x": "0.4 = 2/5", "y": "0.6 = 3/5"},
            "exact_latex": "1+\\sqrt{\\frac32}=1+\\frac{\\sqrt6}{2}"
          },
          "proof": [
            "The numerator is x+y+2sqrt(xy) = (sqrt(x)+sqrt(y))^2.",
            "The denominator is sqrt(x)(sqrt(x)+sqrt(y)).",
            "Both sqrt(x) and sqrt(x)+sqrt(y) are strictly positive on the original domain.",
            "Cancellation gives (sqrt(x)+sqrt(y))/sqrt(x) = 1+sqrt(y/x).",
            "At x=2/5, y=3/5, y/x=3/2, giving 1+sqrt(6)/2."
          ]
        }
      ]
    },
    {
      "number": "990",
      "source_binding": "source-read.receipt.json#/bindings/3",
      "subparts": [
        {
          "label": "a",
          "expression_latex": "\\sqrt{\\frac{a+\\sqrt{a^2-1}}{a-\\sqrt{a^2-1}}}",
          "stipulated_domain_latex": "a\\ge1",
          "result_latex": "a+\\sqrt{a^2-1}",
          "proof": [
            "Let s=sqrt(a^2-1). On a>=1, s>=0 and a+s>0.",
            "(a-s)(a+s) = 1, so the original denominator a-s = 1/(a+s) is strictly positive.",
            "(a+s)/(a-s) = (a+s)^2.",
            "The principal root is |a+s| = a+s, including a=1."
          ],
          "unstipulated_natural_domain_latex": "a\\in(-\\infty,-1]\\cup[1,\\infty)",
          "unstipulated_result_latex": "\\left|a+\\sqrt{a^2-1}\\right|",
          "unstipulated_domain_proof": "The inner root requires a^2>=1. On that set the conjugate product is 1, both factors are nonzero, and the quotient equals a positive square. For a<=-1, a+sqrt(a^2-1)<0, so its absolute value cannot be dropped."
        },
        {
          "label": "b",
          "expression_latex": "\\sqrt{\\frac{\\sqrt{b^2+1}-b}{\\sqrt{b^2+1}+b}}",
          "natural_domain_latex": "b\\in\\mathbb R",
          "result_latex": "\\sqrt{b^2+1}-b",
          "proof": [
            "Let s=sqrt(b^2+1); s>|b| for every real b.",
            "Thus both s-b and the original denominator s+b are strictly positive.",
            "(s-b)(s+b) = 1, hence (s-b)/(s+b) = (s-b)^2.",
            "The principal root is |s-b| = s-b."
          ]
        }
      ]
    },
    {
      "number": "991",
      "source_binding": "source-read.receipt.json#/bindings/4",
      "subparts": [
        {
          "label": "a",
          "statement_latex": "\\sqrt{13-4\\sqrt3}=2\\sqrt3-1",
          "domain": "Constant real identity; no denominators; the radicand is a positive square.",
          "result_latex": "2\\sqrt3-1",
          "proof": [
            "(2sqrt(3)-1)^2 = 13-4sqrt(3).",
            "sqrt(3)>1 implies 2sqrt(3)-1>0.",
            "The principal root is |2sqrt(3)-1| = 2sqrt(3)-1."
          ]
        },
        {
          "label": "b",
          "statement_latex": "\\sqrt{13+4\\sqrt3}\\sqrt{13-4\\sqrt3}=11",
          "domain": "Constant real identity; no denominators; both radicands are positive squares.",
          "result_latex": "11",
          "proof": [
            "13+4sqrt(3) = (2sqrt(3)+1)^2 with positive 2sqrt(3)+1.",
            "13-4sqrt(3) = (2sqrt(3)-1)^2 with positive 2sqrt(3)-1.",
            "The product of the principal roots is (2sqrt(3)+1)(2sqrt(3)-1) = 12-1 = 11."
          ]
        }
      ]
    },
    {
      "number": "992",
      "source_binding": "source-read.receipt.json#/bindings/5",
      "method": "Exact comparison of positive quantities by squaring; no root tables, decimals, or computation calls.",
      "subparts": [
        {
          "label": "a",
          "comparison_latex": "\\sqrt7<1+\\sqrt3",
          "domain": "Both constants are positive and real; no denominators.",
          "proof": [
            "3>9/4 implies sqrt(3)>3/2.",
            "(1+sqrt(3))^2 = 4+2sqrt(3)>7.",
            "Both compared quantities are positive, hence sqrt(7)<1+sqrt(3)."
          ]
        },
        {
          "label": "b",
          "comparison_latex": "\\sqrt{19}>6-\\sqrt3",
          "domain": "Both constants are positive and real; 6-sqrt(3)>0 because 36>3; no denominators.",
          "proof": [
            "27>25 implies 3sqrt(3)>5.",
            "(6-sqrt(3))^2-19 = 20-12sqrt(3) = 4(5-3sqrt(3))<0.",
            "Both compared quantities are positive, hence sqrt(19)>6-sqrt(3)."
          ]
        },
        {
          "label": "c",
          "comparison_latex": "\\frac{\\sqrt{10}+\\sqrt{14}}2<\\sqrt{12}",
          "domain": "Both constants are positive and real; the denominator 2 is nonzero.",
          "proof": [
            "[(sqrt(10)+sqrt(14))/2]^2 = (24+2sqrt(140))/4 = 6+sqrt(35).",
            "35<36 implies sqrt(35)<6, so the squared left side is less than 12.",
            "Both compared quantities are positive, hence the stated strict inequality."
          ]
        },
        {
          "label": "d",
          "comparison_latex": "2\\sqrt2+3\\sqrt3>8",
          "domain": "Both constants are positive and real; no denominators.",
          "proof": [
            "(2sqrt(2)+3sqrt(3))^2 = 35+12sqrt(6).",
            "(12sqrt(6))^2 = 864>841 = 29^2 and both terms are positive, so 12sqrt(6)>29.",
            "The squared left side exceeds 64, hence 2sqrt(2)+3sqrt(3)>8."
          ]
        }
      ]
    },
    {
      "number": "993",
      "source_binding": "source-read.receipt.json#/bindings/6",
      "stipulated_domain_latex": "a>0,\\quad b>0",
      "domain_note": "All roots are real and positive; denominators 2, a+b, a, b, sqrt(a), and sqrt(b) are nonzero on the stipulated domain.",
      "subparts": [
        {
          "label": "a",
          "statement_latex": "\\sqrt{\\frac{a^2+b^2}2}\\ge\\frac{a+b}2",
          "proof": [
            "Both sides are positive.",
            "(a^2+b^2)/2-((a+b)/2)^2 = (a-b)^2/4 >= 0.",
            "Taking principal roots proves the inequality, with equality exactly when a-b=0."
          ],
          "equality_iff_latex": "a=b"
        },
        {
          "label": "b",
          "statement_latex": "\\sqrt{\\frac{a^2+b^2}2}\\ge\\sqrt{ab}",
          "proof": [
            "Both sides are positive.",
            "(a^2+b^2)/2-ab = (a-b)^2/2 >= 0.",
            "Taking principal roots proves the inequality, with equality exactly when a-b=0."
          ],
          "equality_iff_latex": "a=b"
        },
        {
          "label": "c",
          "statement_latex": "\\sqrt{ab}\\ge\\frac{2ab}{a+b}",
          "proof": [
            "a+b>0 and sqrt(ab)>0.",
            "sqrt(ab)-2ab/(a+b) = sqrt(ab)/(a+b) * (a+b-2sqrt(ab)).",
            "This equals sqrt(ab)/(a+b) * (sqrt(a)-sqrt(b))^2 >= 0.",
            "The prefactor is strictly positive, so equality holds exactly when sqrt(a)=sqrt(b), equivalently a=b."
          ],
          "equality_iff_latex": "a=b"
        },
        {
          "label": "d",
          "statement_latex": "\\sqrt{\\frac{a^2}{b}}+\\sqrt{\\frac{b^2}{a}}\\ge\\sqrt a+\\sqrt b",
          "proof": [
            "Since a,b>0, sqrt(a^2/b)=a/sqrt(b) and sqrt(b^2/a)=b/sqrt(a).",
            "Let u=sqrt(a)>0 and v=sqrt(b)>0.",
            "The left side minus the right side is u^2/v+v^2/u-u-v.",
            "With nonzero denominator uv this is (u^3+v^3-u^2v-uv^2)/(uv) = (u+v)(u-v)^2/(uv) >= 0.",
            "(u+v)/(uv)>0, so equality holds exactly when u=v, equivalently a=b."
          ],
          "equality_iff_latex": "a=b"
        }
      ]
    },
    {
      "number": "994",
      "source_binding": "source-read.receipt.json#/bindings/7",
      "natural_domain_latex": "x\\in\\mathbb R",
      "domain_note": "Both original radicands are squares and are nonnegative for every real x; no denominators.",
      "subparts": [
        {
          "label": "a",
          "statement_latex": "\\sqrt{(x-5)^2}-x=25",
          "exists": true,
          "solution_set_latex": "\\{-10\\}",
          "proof": [
            "sqrt((x-5)^2) = |x-5|.",
            "For x>=5 the left side is -5, so this branch yields no solution.",
            "For x<5 the equation is 5-2x=25, giving x=-10, which satisfies x<5.",
            "Exact substitution gives sqrt((-15)^2)-(-10)=15+10=25.",
            "These two branches cover all real x, so the solution is unique."
          ]
        },
        {
          "label": "b",
          "statement_latex": "x-\\sqrt{(x-1)^2}=9",
          "exists": false,
          "solution_set_latex": "\\varnothing",
          "left_side_range_latex": "(-\\infty,1]",
          "proof": [
            "sqrt((x-1)^2) = |x-1|.",
            "For x>=1 the left side x-|x-1| is 1.",
            "For x<1 the left side is 2x-1<1 and has range (-infinity,1).",
            "The full range is (-infinity,1], which excludes 9, so no real solution exists."
          ]
        }
      ]
    }
  ],
