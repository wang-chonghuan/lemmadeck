    {
      "id": "q873a",
      "source_numbers": [
        "873"
      ],
      "view": {
        "mode": "single",
        "stem": "Two natural numbers have product 187 and differ by 6. Which unordered pair satisfies both conditions?",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$\\{1,187\\}$",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$\\{11,17\\}$",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$\\{-17,-11\\}$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "Find both natural numbers from their product and difference.",
        "source_solution": "n(n+6)=187 gives (n-11)(n+17)=0; n is natural, so the numbers are 11 and 17. The zero convention cannot affect this result.",
        "unit_reason": "One pair must satisfy both relationships; the other printed subpart has a different domain and is independent.",
        "concept_blocks": [],
        "limitations": [
          "Recognition of a complete result does not demonstrate independently setting up and writing the solution."
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "B"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "Factor 187 as 1*187 and stop without checking the difference; 187-1=186, not 6.",
            "misconception": "Factor 187 as 1*187 and stop without checking the difference; 187-1=186, not 6."
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "11*17=187 and 17-11=6; the other quadratic root -17 is not natural.",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "Keep n=-17 from the quadratic because the product and difference work, but omit the natural-number condition.",
            "misconception": "Keep n=-17 from the quadratic because the product and difference work, but omit the natural-number condition."
          }
        ]
      }
    },
