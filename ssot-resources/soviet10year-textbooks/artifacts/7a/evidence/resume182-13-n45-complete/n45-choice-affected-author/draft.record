        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "Omit the factor 2 in the cross term and solve n(n+1)=112. Its positive solution (-1+sqrt(449))/2 is not natural, so incorrectly conclude the original problem has no natural solution.",
            "misconception": "Omit the factor 2 in the cross term and solve n(n+1)=112. Its positive solution (-1+sqrt(449))/2 is not natural, so incorrectly conclude the original problem has no natural solution."
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "Solve n(n+1)=56 correctly as n=7 but then increment both numbers once more as though n were the predecessor.",
            "misconception": "Solve n(n+1)=56 correctly as n=7 but then increment both numbers once more as though n were the predecessor."
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "15^2-(49+64)=225-113=112.",
            "misconception": null
          }
        ]
      }
    },
