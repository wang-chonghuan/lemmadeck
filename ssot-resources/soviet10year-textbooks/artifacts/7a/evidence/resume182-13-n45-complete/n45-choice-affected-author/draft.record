        ]
      },
      "intent": {
        "task": "Distinguish (a+b)^2 from a^2+b^2 and solve the resulting product equation.",
        "source_solution": "(2n+1)^2-[n^2+(n+1)^2]=2n(n+1)=112, so n(n+1)=56; natural n=7, pair 7,8.",
        "unit_reason": "The whole pair tests the cross term rather than separate calculations.",
        "concept_blocks": [],
        "limitations": [
          "Recognition of a complete result does not demonstrate independently setting up and writing the solution."
