    {
      "id": "q886a",
      "view": {
        "mode": "single",
        "stem": "Each argument below claims to prove $\\frac1{11+2\\sqrt{30}}+\\frac1{11-2\\sqrt{30}}=22$. Which proposed common-denominator step is valid?",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "Put the sum over the product of the two denominators:\n$\\frac{(11-2\\sqrt{30})+(11+2\\sqrt{30})}{121-120}$.\nThis establishes the stated equality.",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "Add the original numerators and denominators separately:\n$\\frac{1+1}{(11+2\\sqrt{30})+(11-2\\sqrt{30})}$.\nThis establishes the stated equality.",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "Use the cross-multiplied numerator and add the squares in the denominator:\n$\\frac{(11-2\\sqrt{30})+(11+2\\sqrt{30})}{121+120}$.\nThis establishes the stated equality.",
            "figure_ids": []
          }
        ]
      }
    },
    {
      "id": "q886b",
      "view": {
        "mode": "single",
        "stem": "Each argument below claims to prove $\\frac{\\sqrt5+2}{\\sqrt5-2}+\\frac{\\sqrt5-2}{\\sqrt5+2}=18$. Which proposed common-denominator step is valid?",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "Multiply each numerator by its missing denominator factor:\n$\\frac{(\\sqrt5+2)^2+(\\sqrt5-2)^2}{5-4}$.\nThis establishes the stated equality.",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "Multiply the denominators but keep the original numerators:\n$\\frac{(\\sqrt5+2)+(\\sqrt5-2)}{5-4}$.\nThis establishes the stated equality.",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "Multiply each numerator by its missing factor, and add the denominator squares:\n$\\frac{(\\sqrt5+2)^2+(\\sqrt5-2)^2}{5+4}$.\nThis establishes the stated equality.",
            "figure_ids": []
          }
        ]
      }
    },
