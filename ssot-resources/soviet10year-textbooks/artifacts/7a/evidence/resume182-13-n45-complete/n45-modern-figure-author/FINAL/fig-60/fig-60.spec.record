    "authoritativeText": [
      {
        "lesson": "alg7-c4-s3-n45",
        "exercise": "889",
        "text": "889. 利用函数 $f$ 的图象（图 60）解方程 $f(x)=3$ 和不等式 $f(x)>3$，$f(x)<3$. 函数$f$ 的定义域是区间$[-1.5,6]$."
      }
    ],
    "inventory": [
      {
        "id": "f60-source-grid",
        "description": "Grid: 19 vertical boundaries, 13 horizontal boundaries, hence 18 columns x 12 rows. Minor intervals x=0.5,y=0.5; bounds x=-2..7,y=-1..5, offsets 0,0. Origin is 4 columns from the left, 2 rows above the bottom.",
        "objects": [
          "f60-grid"
        ],
        "assertions": [
          "f60-grid-dimensions"
        ],
        "requires": [
          "gridDimensions"
