{
  "exercises": [
    {
      "number": "737",
      "text": "737. \u6bd4\u8f83\u4e24\u4e2a\u6570\u7684\u5927\u5c0f\uff1a\na) $\\sqrt{7}$ \u548c $3$\uff1b\nb) $7$ \u548c $\\sqrt{50}$\uff1b\nc) $\\sqrt{5}$ \u548c $2.2$\uff1b\nd) $3.3$ \u548c $\\sqrt{11}$\uff1b\ne) $\\sqrt{6.25}$ \u548c $2.5$\uff1b\nf) $\\sqrt{4.21}$ \u548c $2.1$.",
      "figure_ids": []
    },
    {
      "number": "738",
      "text": "738. \u8bc1\u660e\uff1a\na) $3<\\sqrt{12}<4$\uff1b\nb) $7.1<\\sqrt{51}<7.2$.",
      "figure_ids": []
    },
    {
      "number": "739",
      "text": "739. \u6c42\u51fa\u4e24\u4e2a\u8fde\u7eed\u7684\u6574\u6570\uff0c\u4f7f\u4e0b\u5217\u5404\u6570\u754c\u4e8e\u8fd9\u4e24\u4e2a\u6570\u4e4b\u95f4\uff0c\na) $\\sqrt{27}$\uff1b\nb) $\\sqrt{9.2}$\uff1b\nc) $\\sqrt{0.4}$\uff1b\nd) $\\sqrt{35.4}$\uff1b\ne) $\\sqrt{120}$\uff1b\nf) $\\sqrt{148}$.\u6c42\u51fa\u6bcf\u4e00\u4e2a\u6570\u51c6\u786e\u5230 $0.5$ \u7684\u8fd1\u4f3c\u503c.",
      "figure_ids": []
    },
    {
      "number": "740",
      "text": "740. \u5206\u522b\u6c42\u51fa\u5c0f\u6570\u70b9\u540e\u6709\u4e00\u4e2a\u6570\u5b57\u7684\u4e24\u4e2a\u8fde\u7eed\u7684\u5c0f\u6570\uff0c\u4f7f\u4e0b\u5217\u5404\u6570\u754c\u4e8e\u8fd9\u4e24\u4e2a\u6570\u4e2d\u95f4\uff1a\na) $\\sqrt{3}$\uff1b\nb) $-\\sqrt{3}$\uff1b\nc) $\\sqrt{18}$\uff1b\nd) $-\\sqrt{18}$.",
      "figure_ids": []
    },
    {
      "number": "741",
      "text": "741. \u5229\u7528\u56fe45\u8bf4\u660e\u4e0b\u9762\u5404\u9898\u91cc\u7684\u4e24\u4e2a\u6570\u4e2d\u54ea\u4e00\u4e2a\u662f $\\sqrt{5}$ \u8f83\u597d\u7684\u8fd1\u4f3c\u503c\uff1a\na) $2$ \u6216 $3$\uff1b\nb) $2.2$ \u6216 $2.3$.",
      "figure_ids": [
        "fig-45"
      ]
    },
    {
      "number": "742",
      "text": "742. \u6c42\u51fa\u5c0f\u6570\u70b9\u540e\u6709\u4e00\u4e2a\u6570\u5b57\u7684\u4e24\u4e2a\u8fde\u7eed\u7684\u5c0f\u6570\uff0c\u4f7f $\\sqrt{2}$ \u754c\u4e8e\u8fd9\u4e24\u4e2a\u6570\u4e4b\u95f4. \u6240\u6c42\u51fa\u7684\u4e24\u4e2a\u5c0f\u6570\u4e2d\u54ea\u4e00\u4e2a\u662f $\\sqrt{2}$ \u8f83\u597d\u7684\u8fd1\u4f3c\u503c\uff1f",
      "figure_ids": []
    },
    {
      "number": "743",
      "text": "743. \u4e0b\u9762\u5404\u9898\u91cc\u54ea\u4e00\u4e2a\u6570\u5927\uff1f\na) $\\sqrt{29}$ \u6216 $\\sqrt{10}+\\sqrt{19}$\uff1b\nb) $\\sqrt{27}$ \u6216 $\\sqrt{20}+\\sqrt{7}$.",
      "figure_ids": []
    },
    {
      "number": "744",
      "text": "744. \u5df2\u77e5\u51fd\u6570\u7684\u8868\u793a\u5f0f $y=kx+l$. \u5982\u679c\u8fd9\u4e2a\u51fd\u6570\u7684\u56fe\u8c61\u901a\u8fc7\u70b9 $A(12,2)$ \u548c $B(-6,-4)$\uff0c\u6c42\u7cfb\u6570 $k$ \u548c $l$.",
      "figure_ids": []
    }
  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "\u6211\u4eec\u77e5\u9053\uff0c\u5bf9\u4e8e\u4efb\u4f55\u4e00\u4e2a\u6709\u7406\u6570\u6765\u8bf4\uff0c\u6570\u8f74\u4e0a\u603b\u6709\u4e00\u70b9\u548c\u5b83\u5bf9\u5e94. \u4f46\u662f\u53cd\u8fc7\u6765\u8bf4\u4e0d\u5bf9\uff1a\u6570\u8f74\u4e0a\u5e76\u4e0d\u662f\u6bcf\u4e00\u4e2a\u70b9\u90fd\u53ef\u4ee5\u548c\u4e00\u4e2a\u6709\u7406\u6570\u5bf9\u5e94. \u4f8b\u5982\uff0c\u629b\u7269\u7ebf$y=x^2$\u548c\u76f4\u7ebf$y=2$\u7684\u4ea4\u70b9\u7684\u6a2a\u5750\u6807\u5c31\u662f\u65e0\u7406\u6570."
    },
    {
      "block": 1,
      "text": "\u6bcf\u4e00\u4e2a\u5b9e\u6570\u90fd\u548c\u6570\u8f74\u4e0a\u7684\u4e00\u4e2a\u70b9\u5bf9\u5e94. \u4f46\u662f\uff0c\u5bf9\u4e8e\u5b9e\u6570\u6765\u8bf4\uff0c\u9006\u547d\u9898\u4e5f\u662f\u5bf9\u7684\uff1a\u6570\u8f74\u4e0a\u6bcf\u4e00\u4e2a\u70b9\u90fd\u548c\u67d0\u4e00\u4e2a\u5b9e\u6570\u5bf9\u5e94. \u56e0\u6b64\uff0c\u53ef\u4ee5\u5c06\u5b9e\u6570\u96c6\u6620\u5c04\u5230\u6570\u8f74\u4e0a\u7684\u70b9\u96c6\uff0c\u800c\u4e14\u8fd9\u4e2a\u6620\u5c04\u662f\u53ef\u9006\u7684."
    },
    {
      "block": 4,
      "text": "\u5728\u56fe44\u91cc\uff0c\u6570\u8f74\u4e0a\u6307\u51fa\u7684\u70b9\u7684\u5750\u6807\u5206\u522b\u7b49\u4e8e$-\\sqrt{7}$\uff0c$\\sqrt{5}$\uff0c$\\frac{32}{7}$. \u5728\u5b9e\u9645\u5e94\u7528\u65f6\uff0c\u4e00\u822c\u90fd\u628a\u5b9e\u6570\u8868\u793a\u6210\u5c0f\u6570\uff0c\u51c6\u786e\u5230\u6240\u8981\u6c42\u7684\u51c6\u786e\u5ea6. \u4f8b\u5982\uff0c$\\frac{32}{7}\\approx4.571$\uff08\u51c6\u786e\u52300.001\uff09."
    },
    {
      "block": 5,
      "text": "\u4e0b\u9762\u6211\u4eec\u6765\u8ba8\u8bba\u6c42$\\sqrt{5}$\u7684\u5c0f\u6570\u8fd1\u4f3c\u503c\uff08\u51c6\u786e\u5230\u4efb\u610f\u51c6\u786e\u5ea6\uff09\u7684\u65b9\u6cd5."
    },
    {
      "block": 6,
      "text": "5\u53ef\u4ee5\u770b\u4f5c\u662f$\\sqrt{5}$\u7684\u5e73\u65b9\uff1a"
    },
    {
      "block": 7,
      "text": "$5=(\\sqrt{5})^2$."
    },
    {
      "block": 8,
      "text": "\u56e0\u4e3a"
    },
    {
      "block": 9,
      "text": "$2^2<5<3^2$\uff0c"
    },
    {
      "block": 10,
      "text": "\u5373 $2^2<(\\sqrt{5})^2<3^2$\uff0c"
    },
    {
      "block": 11,
      "text": "\u6240\u4ee5"
    },
    {
      "block": 12,
      "text": "$2<\\sqrt{5}<3$."
    },
    {
      "block": 13,
      "text": "\uff08\u8fd9\u91cc\uff0c\u6211\u4eec\u5229\u7528\u4e86\u6027\u8d28\uff1a\u5982\u679c$a$\u548c$b$\u662f\u6b63\u6570\uff0c\u800c\u4e14$a^2<b^2$\uff0c\u90a3\u4e48$a<b$.\uff09"
    },
    {
      "block": 14,
      "text": "\u6211\u4eec\u627e\u5230\u4e86\u4e24\u4e2a\u8fde\u7eed\u7684\u6574\u6570\uff0c\u800c$\\sqrt{5}$\u5728\u8fd9\u4e24\u4e2a\u6574\u6570\u4e4b\u95f4\uff08\u56fe45\uff0ca\uff09. 2\u662f$\\sqrt{5}$\u7684\u4e0d\u8db3\u8fd1\u4f3c\u503c\uff0c\u800c3\u662f$\\sqrt{5}$\u7684\u8fc7\u5269\u8fd1\u4f3c\u503c."
    },
    {
      "block": 15,
      "text": "\u5c06\u6570\u8f74\u4e0a\u5750\u6807\u4e3a2\u548c3\u7684\u4e24\u70b9\u95f4\u7684\u533a\u95f4\u5206\u621010\u7b49\u5206\uff0c\u518d\u4ece\u8fd9\u4e9b\u957f\u5ea6\u4e3a0.1\u7684\u533a\u95f4\u4e2d\u6311\u51fa\u5305\u542b\u5750\u6807\u4e3a$\\sqrt{5}$\u7684\u70b9\u7684\u4e00\u4e2a."
    },
    {
      "block": 18,
      "text": "\u4e3a\u6b64\uff0c\u6211\u4eec\u4f9d\u6b21\u5c06\u5404\u5206\u70b9\u7684\u5750\u68072.0\uff0c2.1\uff0c2.2\uff0c\u2026\uff0c2.9\uff0c3.0\u5e73\u65b9\uff0c\u76f4\u5230\u5f97\u5230\u5927\u4e8e5\u7684\u6570\u4e3a\u6b62."
    },
    {
      "block": 20,
      "text": "\u4ece\u4e0a\u8868\u53ef\u4ee5\u770b\u51fa\uff0c"
    },
    {
      "block": 21,
      "text": "$2.2^2<5<2.3^2$\uff0c"
    },
    {
      "block": 22,
      "text": "\u5373 $2.2^2<(\\sqrt{5})^2<2.3^2$."
    },
    {
      "block": 23,
      "text": "\u56e0\u6b64\uff0c"
    },
    {
      "block": 24,
      "text": "$2.2<\\sqrt{5}<2.3$."
    },
    {
      "block": 25,
      "text": "\u6211\u4eec\u627e\u5230\u4e86\u5c0f\u6570\u70b9\u540e\u6709\u4e00\u4e2a\u6570\u5b57\u7684\u4e24\u4e2a\u8fde\u7eed\u7684\u5c0f\u6570\uff0c\u800c$\\sqrt{5}$\u5728\u8fd9\u4e24\u4e2a\u5c0f\u6570\u4e4b\u95f4\uff08\u56fe45\uff0cb\uff09. 2.2\u662f$\\sqrt{5}$\u7684\u4e0d\u8db3\u8fd1\u4f3c\u503c\uff0c\u800c2.3\u662f$\\sqrt{5}$\u7684\u8fc7\u5269\u8fd1\u4f3c\u503c."
    },
    {
      "block": 26,
      "text": "\u7136\u540e\u518d\u628a\u6570\u8f74\u4e0a\u5750\u6807\u4e3a2.2\u548c2.3\u7684\u4e24\u70b9\u95f4\u7684\u533a\u95f4\u5206\u621010\u7b49\u5206\uff0c\u518d\u7528\u540c\u6837\u65b9\u6cd5\u4ece\u8fd9\u4e9b\u957f\u5ea6\u4e3a0.01\u7684\u533a\u95f4\u4e2d\u6311\u51fa\u5305\u542b\u5750\u6807\u4e3a$\\sqrt{5}$\u7684\u70b9\u7684\u4e00\u4e2a."
    },
    {
      "block": 27,
      "text": "\u4ece\u4e0b\u8868\u53ef\u4ee5\u770b\u51fa\uff0c$2.23^2\\leq5<2.24^2$\uff0c\u5373 $2.23^2<(\\sqrt{5})^2<2.24^2$."
    },
    {
      "block": 29,
      "text": "\u56e0\u6b64\uff0c$2.23<\\sqrt{5}<2.24$."
    },
    {
      "block": 30,
      "text": "\u8fd9\u6837\u4e00\u6765\uff0c\u6211\u4eec\u53c8\u627e\u5230\u4e86\u5c0f\u6570\u70b9\u540e\u6709\u4e24\u4e2a\u6570\u5b57\u7684\u4e24\u4e2a\u8fde\u7eed\u7684\u5c0f\u6570\uff0c\u800c $\\sqrt{5}$ \u5728\u8fd9\u4e24\u4e2a\u5c0f\u6570\u4e4b\u95f4\uff08\u56fe45\uff0cc\uff09. $2.23$ \u662f $\\sqrt{5}$ \u7684\u4e0d\u8db3\u8fd1\u4f3c\u503c\uff0c\u800c $2.24$ \u662f $\\sqrt{5}$ \u7684\u8fc7\u5269\u8fd1\u4f3c\u503c."
    },
    {
      "block": 31,
      "text": "\u540c\u6837\u53ef\u4ee5\u627e\u5230\u4e00\u4e2a\u957f\u5ea6\u4e3a $0.001$ \u4e14\u5305\u542b\u5750\u6807\u4e3a $\\sqrt{5}$ \u7684\u70b9\u7684\u533a\u95f4\uff1a\n$2.236<\\sqrt{5}<2.237$."
    },
    {
      "block": 32,
      "text": "$2.236$ \u548c $2.237$ \u5206\u522b\u662f $\\sqrt{5}$ \u7684\u4e0d\u8db3\u548c\u8fc7\u5269\u8fd1\u4f3c\u503c."
    },
    {
      "block": 33,
      "text": "\u8fd9\u79cd\u8ba1\u7b97\u53ef\u4ee5\u7ee7\u7eed\u8fdb\u884c\u4e0b\u53bb. \u5982\u679c\u8ba8\u8bba\u5230\u4e0a\u9762\u8fd9\u4e2a\u4e0d\u7b49\u5f0f\u4e3a\u6b62\uff0c\u90a3\u4e48\u6211\u4eec\u53ef\u4ee5\u53d6\u5de6\u53f3\u4e24\u4e2a\u6570\u7684\u7b97\u672f\u5e73\u5747\u6570\u4f5c\u4e3a $\\sqrt{5}$ \u7684\u8fd1\u4f3c\u503c\uff0c\u5f97\uff1a\n$\\sqrt{5}=2.2365\\pm0.0005$."
    }
  ],
