  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "\u6839\u636e\u7b97\u672f\u5e73\u65b9\u6839\u7684\u5b9a\u4e49\uff0c\u6839\u5f0f$\\sqrt{a}$\uff08$a>0$\uff09\u7684\u503c\u662f\u975e\u8d1f\u6570\uff0c\u5b83\u7684\u5e73\u65b9\u7b49\u4e8e$a$. \u56e0\u6b64\uff0c\u5bf9\u4e8e\u4efb\u4f55\u975e\u8d1f\u6570$a$\u6765\u8bf4\uff0c\u4e0b\u5217\u7b49\u5f0f\u6210\u7acb\uff1a"
    },
    {
      "block": 1,
      "text": "$(\\sqrt{a})^2=a$. \uff081\uff09"
    },
    {
      "block": 2,
      "text": "\u5728\u975e\u8d1f\u6570\u96c6\u4e0a\uff081\uff09\u5f0f\u662f\u4e00\u4e2a\u6052\u7b49\u5f0f."
    },
    {
      "block": 3,
      "text": "\u5229\u7528\u6052\u7b49\u5f0f\uff081\uff09\uff0c\u53ef\u4ee5\u628a\u4efb\u4f55\u4e00\u4e2a\u975e\u8d1f\u6570\u5199\u6210\u67d0\u4e2a\u6570\u7684\u5e73\u65b9\uff0c\u4f8b\u5982\uff1a"
    },
    {
      "block": 4,
      "text": "$2=(\\sqrt{2})^2$\uff0c\n$0.5=(\\sqrt{0.5})^2$\uff0c\n$\\frac{1}{7}=\\left(\\sqrt{\\frac{1}{7}}\\right)^2$."
    },
    {
      "block": 5,
      "text": "\u6211\u4eec\u4e3e\u4e24\u4e2a\u5e94\u7528\u6052\u7b49\u5f0f\uff081\uff09\u4f5c\u53d8\u5f62\u7684\u4f8b\u5b50."
    },
    {
      "block": 6,
      "text": "\u4f8b1 \u6c42$(0.1\\sqrt{18})^2$\u7684\u503c."
    },
    {
      "block": 7,
      "text": "\u6839\u636e\u79ef\u7684\u5e42\u7684\u6027\u8d28\uff0c\u5f97"
    },
    {
      "block": 8,
      "text": "$(0.1\\sqrt{18})^2=(0.1)^2\\cdot(\\sqrt{18})^2$."
    },
    {
      "block": 9,
      "text": "\u56e0\u4e3a$(\\sqrt{18})^2=18$\uff0c\u6240\u4ee5$(0.1)^2\\cdot(\\sqrt{18})^2=0.01\\times18=0.18$."
    },
    {
      "block": 10,
      "text": "\u6240\u4ee5\uff0c$(0.1\\sqrt{18})^2=0.18$."
    },
    {
      "block": 11,
      "text": "\u4f8b2 \u5316\u7b80\u5206\u5f0f$\\frac{x^2-3}{x+\\sqrt{3}}$."
    },
    {
      "block": 12,
      "text": "\u5c06\u5206\u5f0f\u7684\u5206\u5b50\u5199\u6210\u5e73\u65b9\u5dee\u7684\u5f62\u5f0f\uff1a"
    },
    {
      "block": 13,
      "text": "$x^2-3=x^2-(\\sqrt{3})^2$."
    },
    {
      "block": 14,
      "text": "\u4e8e\u662f"
    },
    {
      "block": 15,
      "text": "$\\frac{x^2-3}{x+\\sqrt{3}}=\\frac{x^2-(\\sqrt{3})^2}{x+\\sqrt{3}}=\\frac{(x+\\sqrt{3})(x-\\sqrt{3})}{x+\\sqrt{3}}=x-\\sqrt{3}$."
    }
  ],
  "figures": []
}
