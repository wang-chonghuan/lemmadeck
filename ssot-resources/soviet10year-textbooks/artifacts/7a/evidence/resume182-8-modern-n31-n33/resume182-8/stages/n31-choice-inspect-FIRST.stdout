    {
      "number": "736",
      "text": "736. \u4e702\u516c\u65a4\u5927\u7c73\u548c3\u516c\u65a4\u5c0f\u9ea6\uff0c\u5171\u4ed8\u6b3e2\u7f8e\u514366\u7f8e\u5206.\u5df2\u77e5\u4e00\u516c\u65a4\u5927\u7c73\u6bd4\u4e00\u516c\u65a4\u5c0f\u9ea6\u8d3558\u7f8e\u5206\uff0c\u5927\u7c73\u548c\u5c0f\u9ea6\u6bcf\u516c\u65a4\u503c\u591a\u5c11\u94b1\uff1f",
