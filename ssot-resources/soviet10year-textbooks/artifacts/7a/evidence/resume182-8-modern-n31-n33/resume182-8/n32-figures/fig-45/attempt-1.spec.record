        "id": "whole-composition",
        "description": "Three separate right-directed horizontal number lines, vertically stacked and aligned at the same 2 and 3 endpoints. All show sqrt(5) at the same coordinate between 2 and 3. Source subfigure letters are Cyrillic a/be/ve, mapped to the current edition a/b/c. No answer-choice preference or decimal expansion of sqrt(5) is printed.",
        "objects": [
          "a-part-label",
          "b-part-label",
          "c-part-label"
        ],
        "assertions": [
          "all-scale-and-root-points",
          "three-number-lines",
          "all-source-labels"
        ]
      }
    ]
