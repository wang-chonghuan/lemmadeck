          "domain_latex": "x\\in(-\\infty,0]\\cup(3,\\infty)",
          "nonzero_denominators": ["x-3 != 0"],
          "solution_set": [0],
          "result_latex": "\\{0\\}",
          "rejected_candidates": [{"x": 1, "reason": "Radicand equals -1/2, so the original expression is not real-defined."}],
          "derivation": "The denominator excludes 3 and the radicand inequality gives the stated domain. The root zero 0 is admissible; the linear zero 1 is not."
        },
        {
          "label": "d",
