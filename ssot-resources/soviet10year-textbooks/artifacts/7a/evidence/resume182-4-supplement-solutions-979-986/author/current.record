      "task": "Reduce the fractions, cancelling only established nonzero factors.",
      "parts": [
        {
          "label": "a", "source_label": "а", "answer": "\\sqrt{3}",
          "domain": "Real constant; original denominator sqrt(7)>0.",
          "derivation": "sqrt(21)=sqrt(7)sqrt(3); cancel the nonzero sqrt(7)."
        },
        {
          "label": "b", "source_label": "б", "answer": "2\\sqrt{6}",
          "domain": "Real constant; original denominator sqrt(6)>0.",
          "derivation": "12/sqrt(6)=12sqrt(6)/6=2sqrt(6). Equivalently 12=2sqrt(6)*sqrt(6)."
        },
        {
          "label": "c", "source_label": "в", "answer": "\\frac{2\\sqrt{2}}{3}",
          "domain": "Real constant; original denominator sqrt(18)=3sqrt(2)>0; result denominator 3 is nonzero.",
          "derivation": "4/(3sqrt(2))=4sqrt(2)/6=2sqrt(2)/3."
        },
        {
          "label": "d", "source_label": "г", "answer": "\\frac{2\\sqrt{11}}{3}",
          "domain": "Real constant; original denominator sqrt(99)=3sqrt(11)>0; result denominator 3 is nonzero.",
          "derivation": "22/(3sqrt(11))=22sqrt(11)/33=2sqrt(11)/3."
        },
        {
          "label": "e", "source_label": "д", "answer": "\\sqrt{2}-1",
          "domain": "Real constant; original denominator sqrt(5)>0.",
          "derivation": "sqrt(10)-sqrt(5)=sqrt(5)(sqrt(2)-1); expand to confirm and cancel sqrt(5)."
        },
        {
          "label": "f", "source_label": "е", "answer": "\\sqrt{2}+1",
          "domain": "Real constant; original denominator sqrt(3)>0.",
          "derivation": "sqrt(6)+sqrt(3)=sqrt(3)(sqrt(2)+1); expand to confirm and cancel sqrt(3)."
        },
        {
          "label": "g", "source_label": "ж", "answer": "\\sqrt{2}",
          "domain": "Real constant; original denominator sqrt(35)-sqrt(15)>0 because 35>15.",
          "derivation": "The numerator equals sqrt(2)(sqrt(35)-sqrt(15)); expansion gives sqrt(70)-sqrt(30). Cancel the nonzero denominator."
        },
        {
          "label": "h", "source_label": "з", "answer": "\\frac{\\sqrt{10}}{2}",
          "domain": "Real constant; original denominator sqrt(6)-sqrt(10)<0, hence nonzero. The cancelled factor sqrt(3)-sqrt(5)<0 is also nonzero.",
          "derivation": "The numerator is sqrt(5)(sqrt(3)-sqrt(5)); the denominator is sqrt(2)(sqrt(3)-sqrt(5)). Expansion recovers both. Cancel the common nonzero factor to obtain sqrt(5)/sqrt(2)=sqrt(10)/2."
        },
        {
          "label": "i", "source_label": "и", "answer": "\\frac{\\sqrt{10}}{2}",
          "domain": "Real constant; original denominator 4-sqrt(10)>0 because 16>10.",
          "derivation": "2sqrt(10)-5=(sqrt(10)/2)(4-sqrt(10)), since expansion gives 2sqrt(10)-10/2. Cancel the nonzero factor 4-sqrt(10)."
        },
        {
          "label": "j", "source_label": "к", "answer": "\\frac{\\sqrt{6}}{2}",
          "domain": "Real constant; denominator sqrt(2)(3sqrt(3)-2)>0 since 27>4, so both cancelled factors are nonzero.",
          "derivation": "9-2sqrt(3)=sqrt(3)(3sqrt(3)-2); 3sqrt(6)-2sqrt(2)=sqrt(2)(3sqrt(3)-2). Expansion confirms equality. Cancel the common factor and rationalize sqrt(3)/sqrt(2)=sqrt(6)/2."
        },
        {
          "label": "k", "source_label": "л", "answer": "\\sqrt{3}",
          "domain": "Real constant; original denominator 2+sqrt(6)-sqrt(2)>2>0.",
          "derivation": "The numerator is sqrt(3)(2+sqrt(6)-sqrt(2)): expansion gives 2sqrt(3)+sqrt(18)-sqrt(6)=2sqrt(3)+3sqrt(2)-sqrt(6). Cancel the nonzero denominator."
        },
        {
          "label": "l", "source_label": "м", "answer": "\\sqrt{10}-1-\\sqrt{3}",
          "domain": "Real constant; original denominator sqrt(10)+sqrt(3)-1>0, since sqrt(10)>1.",
          "derivation": "Set u=sqrt(10)-1. The numerator u^2-3=(u-sqrt(3))(u+sqrt(3)); expansion is u^2-3. The denominator is u+sqrt(3), known nonzero, so the reduced result is u-sqrt(3)."
        }
      ],
      "uncertainties": []
    },
