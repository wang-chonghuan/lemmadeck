  "solutions": [
    {
      "exercise": "924",
      "task": "Evaluate all ten given expressions.",
      "parts": [
        {"label": "a", "answer": "5.1", "derivation": "sqrt(289)=17, so 0.3*17=5.1."},
        {"label": "b", "answer": "-3.6", "derivation": "sqrt(0.81)=0.9, so -4*0.9=-3.6."},
        {"label": "c", "answer": "-\\frac{4}{7}", "derivation": "sqrt(9/49)-1=3/7-1=-4/7."},
        {"label": "d", "answer": "\\frac{1}{8}", "derivation": "4/16-1/8=1/4-1/8=1/8."},
        {"label": "e", "answer": "10.22", "derivation": "sqrt(0.0121)=0.11, giving 2*0.11+10=10.22."},
        {"label": "f", "answer": "1", "derivation": "sqrt(0.16)/(2*sqrt(0.04))=0.4/0.4=1."},
        {"label": "g", "answer": "25", "derivation": "sqrt(2500)-sqrt(625)=50-25=25."},
        {"label": "h", "answer": "\\frac{5}{9}", "derivation": "8/9-1/3=5/9."},
        {"label": "i", "answer": "1", "derivation": "-0.03*100+4=1."},
        {"label": "j", "answer": "\\frac{21}{38}", "derivation": "1/19+1/2=(2+19)/38=21/38."}
      ]
    },
    {
      "exercise": "925",
      "task": "Prove each of the four stated equalities by evaluating its left side.",
      "parts": [
        {"label": "a", "answer": "2.5", "derivation": "5-(3*(2/3)+0.5)=5-2.5=2.5, equal to the stated right side."},
        {"label": "b", "answer": "55", "derivation": "11/(0.15*40-0.29*20)=11/(6-5.8)=11/0.2=55; the divisor is nonzero."},
        {"label": "c", "answer": "6", "derivation": "(15+3*11)/((2/3)*0.3+0.78*10)=48/(0.2+7.8)=48/8=6."},
        {"label": "d", "answer": "3", "derivation": "(-6*(1/2)+(18/2)*(0.4/0.2))/5=(-3+18)/5=3."}
      ],
      "production_task_note": "A final result alone does not replace the original equality-proof task."
    },
    {
      "exercise": "926",
      "task": "Solve each radical equation over the reals and check by substitution.",
      "parts": [
        {"label": "a", "answer": "x=9", "derivation": "sqrt(x)=3 implies x=9; sqrt(9)=3."},
        {"label": "b", "answer": "y=81", "derivation": "sqrt(y)=9 implies y=81; sqrt(81)=9."},
        {"label": "c", "answer": "z=1", "derivation": "sqrt(z)=1 implies z=1; sqrt(1)=1."},
        {"label": "d", "answer": "a=0.01", "derivation": "sqrt(a)=0.1 implies a=0.01, nonnegative and valid."},
        {"label": "e", "answer": "b=0.09", "derivation": "10sqrt(b)=3 implies sqrt(b)=0.3, hence b=0.09."},
        {"label": "f", "answer": "e=0", "derivation": "2sqrt(e)=0 implies sqrt(e)=0, hence e=0."}
      ]
    },
    {
      "exercise": "927",
      "task": "Explain why each of the four radical equations has no real root.",
      "parts": [
        {"label": "a", "answer": "\\varnothing", "derivation": "On x>=0, sqrt(x)>=0 cannot equal -4."},
        {"label": "b", "answer": "\\varnothing", "derivation": "On x>=0, sqrt(x)+1>=1 cannot equal 0."},
        {"label": "c", "answer": "\\varnothing", "derivation": "On x>=0, -sqrt(x)<=0 cannot equal 2."},
        {"label": "d", "answer": "\\varnothing", "derivation": "On x>=0, 5sqrt(x)>=0 cannot equal -15."}
      ],
      "production_task_note": "The nonnegativity or sign reason is required, not merely four empty sets."
    },
    {
      "exercise": "928",
      "task": "Determine each real domain, including nonzero radical denominators.",
      "parts": [
        {"label": "a", "answer": "\\mathbb{R}", "derivation": "|x|>=0 for every real x."},
        {"label": "b", "answer": "\\mathbb{R}", "derivation": "|x|+1>=1 for every real x."},
        {"label": "c", "answer": "(-\\infty,-1]\\cup[1,\\infty)", "derivation": "|x|-1>=0 is equivalent to |x|>=1."},
        {"label": "d", "answer": "\\mathbb{R}", "derivation": "x^2+9>=9 for every real x."},
        {"label": "e", "answer": "(-\\infty,-3]\\cup[3,\\infty)", "derivation": "x^2-9>=0 is equivalent to |x|>=3; the endpoints are allowed."},
        {"label": "f", "answer": "[-2,2]", "derivation": "4-x^2>=0 is equivalent to |x|<=2."},
        {"label": "g", "answer": "\\varnothing", "derivation": "-x^2-5<=-5<0 for every real x."},
        {"label": "h", "answer": "(0,\\infty)", "derivation": "sqrt(x) must exist and be nonzero, so x>0."},
        {"label": "i", "answer": "(-\\infty,-4)\\cup(4,\\infty)", "derivation": "The denominator sqrt(x^2-16) must be positive, requiring x^2-16>0."}
      ]
    },
    {
      "exercise": "929",
      "task": "Determine the real variable values for which each expression exists.",
      "parts": [
        {"label": "a", "answer": "(2,\\infty)", "derivation": "The radical denominator requires x-2>0."},
        {"label": "b", "answer": "[0,4)\\cup(4,\\infty)", "derivation": "sqrt(x) requires x>=0; sqrt(x)-2!=0 excludes x=4."},
        {"label": "c", "answer": "(-2,\\infty)", "derivation": "sqrt(x+2) is a denominator, so x+2>0 rather than merely >=0."},
        {"label": "d", "answer": "[0,\\infty)", "derivation": "x>=0 ensures sqrt(x)+2>=2, so the denominator cannot vanish."},
        {"label": "e", "answer": "[-2,15]", "derivation": "Both radicals require 2x+4>=0 and 15-x>=0."},
        {"label": "f", "answer": "[3,\\infty)", "derivation": "9+3x>=0 requires x>=-3; 4x-12>=0 requires x>=3; intersect the conditions."}
      ]
    },
    {
      "exercise": "930",
      "task": "Find all admissible real pairs (a,b), retaining zero-factor cases.",
      "parts": [
        {"label": "a", "answer": "ab\\geq0", "derivation": "A real square root exists exactly when its radicand ab is nonnegative, including either factor zero."},
        {"label": "b", "answer": "a=0\\ \\text{or}\\ b\\geq0", "derivation": "a^2b>=0. For a!=0, a^2>0 requires b>=0; for a=0 every real b is allowed."},
        {"label": "c", "answer": "(a,b)\\in\\mathbb{R}^2", "derivation": "a^2b^2=(ab)^2>=0 for every real pair."},
        {"label": "d", "answer": "b=0\\ \\text{or}\\ a\\leq0", "derivation": "-ab^2>=0. For b!=0 this requires a<=0; for b=0 every real a is allowed."},
        {"label": "e", "answer": "(a,b)\\in\\mathbb{R}^2", "derivation": "(a+b)^2>=0 for every real pair."},
        {"label": "f", "answer": "a\\ne b", "derivation": "1/(a-b)^2 exists exactly when a!=b and is then positive, so its square root exists."}
      ]
    },
    {
      "exercise": "931",
      "task": "Solve both rational equations without admitting excluded denominators.",
      "parts": [
        {"label": "a", "answer": "\\{-\\sqrt{51},\\sqrt{51}\\}", "derivation": "Require x!=3,-3. Combine the left side as (2x^2+24)/(x^2-9). Equating to 3 gives 2x^2+24=3x^2-27, hence x^2=51. Both roots satisfy the original restrictions."},
        {"label": "b", "answer": "\\{-2\\sqrt5,2\\sqrt5\\}", "derivation": "Require x!=5,-5. Since 5-x=-(x-5), the left side is (x-5)/(x+5)+(x+5)/(x-5)=(2x^2+50)/(x^2-25). Equating to -18 gives 20x^2=400, hence x^2=20. Both roots are admissible."}
      ]
    },
    {
      "exercise": "932",
      "task": "Reduce each radical fraction.",
      "parts": [
        {"label": "a", "answer": "2\\sqrt{11}", "derivation": "22/sqrt(11)=22sqrt(11)/11=2sqrt(11)."},
        {"label": "b", "answer": "2\\sqrt7", "derivation": "14/sqrt(7)=14sqrt(7)/7=2sqrt(7)."},
        {"label": "c", "answer": "2\\sqrt3+1", "derivation": "(6+sqrt(3))/sqrt(3)=6sqrt(3)/3+1=2sqrt(3)+1."},
        {"label": "d", "answer": "\\frac{3\\sqrt5-1}{2}", "derivation": "(15-sqrt(5))/(2sqrt(5))=15sqrt(5)/10-1/2=(3sqrt(5)-1)/2."}
      ]
    },
    {
      "exercise": "933",
      "task": "First express each item as a difference of squares, then factor it.",
      "parts": [
        {"label": "a", "answer": "(a-\\sqrt3)(a+\\sqrt3)", "derivation": "a^2-3=a^2-(sqrt(3))^2; apply u^2-v^2=(u-v)(u+v)."},
        {"label": "b", "answer": "(\\sqrt c-2)(\\sqrt c+2)", "derivation": "For the given c>0, c-4=(sqrt(c))^2-2^2."},
        {"label": "c", "answer": "(3a-\\sqrt b)(3a+\\sqrt b)", "derivation": "For the given b>0, 9a^2-b=(3a)^2-(sqrt(b))^2."},
        {"label": "d", "answer": "(\\sqrt a-2\\sqrt b)(\\sqrt a+2\\sqrt b)", "derivation": "For the given a>0,b>0, a-4b=(sqrt(a))^2-(2sqrt(b))^2."}
      ],
      "production_task_note": "Preserve both requested transformations rather than only the factored output."
    },
    {
      "exercise": "934",
      "task": "Solve the radical-denominator equations and exclude any cancelled hole.",
      "parts": [
        {"label": "a", "answer": "\\{100\\}", "derivation": "Require x>=0; sqrt(x)+5 never vanishes. Factor x-25=(sqrt(x)-5)(sqrt(x)+5), so sqrt(x)-5=5, giving x=100. Substitute: (100-25)/(10+5)=5."},
        {"label": "b", "answer": "\\varnothing", "derivation": "Require x>=0 and x!=4. Factoring x-4=(sqrt(x)-2)(sqrt(x)+2) gives sqrt(x)+2=4 only on that domain. Its sole candidate x=4 is excluded by the original zero denominator."}
      ]
    },
    {
      "exercise": "935",
      "task": "Prove each strict double inequality.",
      "parts": [
        {"label": "a", "answer": "2<\\sqrt8<3", "derivation": "All quantities are positive and 2^2=4<8<9=3^2; monotonicity of the positive square root gives the claim."},
        {"label": "b", "answer": "5<\\sqrt{30}<6", "derivation": "25<30<36 and both bounds are positive."},
        {"label": "c", "answer": "3.8<\\sqrt{15}<3.9", "derivation": "3.8^2=14.44<15<15.21=3.9^2."},
        {"label": "d", "answer": "7.2<\\sqrt{52}<7.3", "derivation": "7.2^2=51.84<52<53.29=7.3^2."}
      ]
    },
    {
      "exercise": "936",
      "task": "Compare each signed radical with -2.4.",
      "parts": [
        {"label": "a", "answer": "\\sqrt7>-2.4", "derivation": "sqrt(7)>0 while -2.4<0."},
        {"label": "b", "answer": "-\\sqrt7<-2.4", "derivation": "7>2.4^2=5.76, so sqrt(7)>2.4. Multiplication by -1 reverses the inequality."}
      ]
    },
    {
      "exercise": "937",
      "task": "Identify the larger number in each of the six comparisons.",
      "parts": [
        {"label": "a", "answer": "\\sqrt3+\\sqrt{10}", "derivation": "Both numbers are positive. (sqrt(3)+sqrt(10))^2=13+2sqrt(30)>13, the square of sqrt(13)."},
        {"label": "b", "answer": "\\sqrt{10}", "derivation": "sqrt(20)-sqrt(5)=2sqrt(5)-sqrt(5)=sqrt(5)<sqrt(10)."},
        {"label": "c", "answer": "\\sqrt3+2", "derivation": "sqrt(15)<4, so sqrt(15)-2<2; sqrt(3)+2>2."},
        {"label": "d", "answer": "5+\\sqrt2", "derivation": "(7-sqrt(2))-(5+sqrt(2))=2-2sqrt(2)<0 because sqrt(2)>1."},
        {"label": "e", "answer": "2\\sqrt8", "derivation": "Both are nonnegative; (2sqrt(8))^2=32>15=(sqrt(15))^2."},
        {"label": "f", "answer": "\\sqrt{14}", "derivation": "Both are nonnegative; (0.5sqrt(24))^2=6<14=(sqrt(14))^2."}
      ]
    }
  ],
  "remaining": "All other supplement exercises, original/modern diagram source solving, independent comparison, complete answer keys and choices remain pending."
}
