        {"part": "e", "equation": "10*sqrt(b)=3", "domain": "b>=0", "solution_set": ["9/100"], "result": "b=9/100", "derivation": "Divide by 10 to obtain sqrt(b)=3/10>=0; square equivalently to obtain b=9/100."},
        {"part": "f", "equation": "2*sqrt(e)=0", "domain": "e>=0", "solution_set": ["0"], "result": "e=0", "derivation": "Divide by 2: sqrt(e)=0 iff e=0. The symbol e is the source's variable, not a mathematical constant."}
