        {"part": "b", "equation": "sqrt(y)=9", "domain": "y>=0", "solution_set": ["81"], "result": "y=81", "derivation": "Both sides are nonnegative, so sqrt(y)=9 iff y=81; the principal root of 81 is 9."},
        {"part": "c", "equation": "sqrt(z)=1", "domain": "z>=0", "solution_set": ["1"], "result": "z=1", "derivation": "Both sides are nonnegative, so sqrt(z)=1 iff z=1."},
