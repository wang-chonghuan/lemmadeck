      "number": 924,
      "source_refs": ["p0284#5"],
      "original_task": "Evaluate all ten expressions exactly.",
      "common_domain": "All fixed radicands are nonnegative and all fixed denominators are nonzero.",
      "parts": [
        {"part": "a", "expression": "0.3*sqrt(289)", "result": "51/10 = 5.1", "derivation": "sqrt(289)=17, so (3/10)*17=51/10."},
        {"part": "b", "expression": "-4*sqrt(0.81)", "result": "-18/5 = -3.6", "derivation": "sqrt(81/100)=9/10, so -4*(9/10)=-18/5."},
        {"part": "c", "expression": "sqrt(9/49)-1", "result": "-4/7", "derivation": "sqrt(9/49)=3/7, and 3/7-1=-4/7."},
        {"part": "d", "expression": "4/sqrt(256)-1/sqrt(64)", "result": "1/8", "derivation": "The roots are 16 and 8, so 4/16-1/8=1/8."},
        {"part": "e", "expression": "2*sqrt(0.0121)+sqrt(100)", "result": "511/50 = 10.22", "derivation": "sqrt(121/10000)=11/100 and sqrt(100)=10; 22/100+10=511/50."},
        {"part": "f", "expression": "sqrt(0.16)/(2*sqrt(0.04))", "result": "1", "derivation": "The numerator is 2/5 and the denominator is 2*(1/5)=2/5, which is nonzero."},
        {"part": "g", "expression": "sqrt(2500)-sqrt(625)", "result": "25", "derivation": "50-25=25."},
        {"part": "h", "expression": "sqrt(64/81)-1/sqrt(9)", "result": "5/9", "derivation": "8/9-1/3=5/9."},
        {"part": "i", "expression": "-0.03*sqrt(10000)+sqrt(16)", "result": "1", "derivation": "-(3/100)*100+4=-3+4=1."},
        {"part": "j", "expression": "1/sqrt(361)+sqrt(1/4)", "result": "21/38", "derivation": "1/19+1/2=(2+19)/38=21/38."}
      ],
      "coverage": {"completed": "a-j", "count": 10, "omitted_tasks": []}
    },
    {
      "number": 925,
      "source_refs": ["p0284#6", "p0285#1"],
      "original_task": "Prove each of the four stated equalities, preserving the proof goal.",
      "parts": [
        {
          "part": "a",
          "statement": "5-(3*sqrt(4/9)+sqrt(0.25))=2.5",
          "domain": "Both fixed radicands are nonnegative.",
          "result": "Equality proved.",
          "derivation": "sqrt(4/9)=2/3 and sqrt(0.25)=1/2. The left side becomes 5-(3*(2/3)+1/2)=5-5/2=5/2=2.5."
        },
        {
          "part": "b",
          "statement": "11:(0.15*sqrt(1600)-0.29*sqrt(400))=55",
          "domain": "The fixed roots exist; the divisor equals 1/5, not zero.",
          "result": "Equality proved.",
          "derivation": "sqrt(1600)=40 and sqrt(400)=20. The divisor is (3/20)*40-(29/100)*20=6-29/5=1/5. Thus the left side is 11/(1/5)=55."
        },
        {
          "part": "c",
          "statement": "(sqrt(225)+3*sqrt(121)):((2/3)*sqrt(0.09)+0.78*sqrt(100))=6",
          "domain": "All fixed roots exist; the divisor equals 8, not zero.",
          "result": "Equality proved.",
          "derivation": "The numerator is 15+3*11=48. The divisor is (2/3)*(3/10)+(39/50)*10=1/5+39/5=8. Therefore the left side is 48/8=6."
        },
        {
          "part": "d",
          "statement": "(-6*sqrt(1/4)+(sqrt(324)/2)*(sqrt(0.16)/0.2)):sqrt(25)=3",
          "domain": "All fixed roots exist; the divisors 2, 0.2=1/5, and sqrt(25)=5 are nonzero.",
          "result": "Equality proved.",
          "derivation": "Substitute sqrt(1/4)=1/2, sqrt(324)=18, sqrt(0.16)=2/5, and sqrt(25)=5. The left side is [-6*(1/2)+(18/2)*((2/5)/(1/5))]/5=(-3+18)/5=3."
        }
      ],
      "coverage": {"completed": "a-d", "count": 4, "omitted_tasks": []}
    },
