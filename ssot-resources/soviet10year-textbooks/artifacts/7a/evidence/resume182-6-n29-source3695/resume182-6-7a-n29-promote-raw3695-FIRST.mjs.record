import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const stage = '.tmp/resume182-6-7a-n29-source3695-FIRST';
const source = `${stage}/artifacts/7a`;
const target = 'ssot-resources/soviet10year-textbooks/artifacts/7a';
const id = 'alg7-c4-s1-n29';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const lesson = JSON.parse(fs.readFileSync(`${source}/lessons/${id}/lesson.json`));
const exercises = JSON.parse(fs.readFileSync(`${source}/lessons/${id}/exercises.json`));
assert.equal(lesson.start_page, 195);
assert.equal(lesson.start_printed, 189);
assert.equal(lesson.prose.length, 11);
assert.equal(lesson.exercise_count, 14);
assert.deepEqual(exercises.exercises.map(e => e.number),
  Array.from({ length: 14 }, (_, i) => String(699 + i)));
assert.deepEqual(lesson.figures.map(f => f.id), ['fig-40', 'fig-41']);
assert.ok(!fs.existsSync(`${target}/lessons/${id}`));
assert.equal(JSON.parse(fs.readFileSync('.tmp/resume182-6-7a-n29-assemble3695-FIRST/receipt.record')).returncode, 0);
const outputs = [];
for (const relative of [
  ...['lesson.json', 'lesson.md', 'exercises.json'].map(name => `lessons/${id}/${name}`),
  ...['fig-40', 'fig-41'].flatMap(figure => ['png', 'svg'].map(ext => `figures/${figure}.${ext}`)),
]) {
  const input = `${source}/${relative}`, output = `${target}/${relative}`;
  const bytes = fs.readFileSync(input);
  if (fs.existsSync(output)) assert.equal(sha(fs.readFileSync(output)), sha(bytes));
  else {
    fs.mkdirSync(path.dirname(output), { recursive: true });
    fs.writeFileSync(output, bytes, { flag: 'wx' });
  }
  outputs.push({ input, output, sha256: sha(bytes), bytes: bytes.length });
}
fs.writeFileSync(`${stage}/book-before-reindex.record`, fs.readFileSync(`${target}/book.json`), { flag: 'wx' });
const record = { schema: 'stemrobin-182/n29-raw-promotion@1', status: 'RAW_N29_PROMOTED',
  ticket: 'STEMROBIN-182', book: '7a', lesson: id, outputs,
  sourcePagesUnchangedByPromotion: true, source196CounterRecoveryRetained: true,
  n30BoundaryWarningExpected: 'Page198 is deliberately projected before n30. No n30 was extracted or promoted.',
  sourceReviewReruns: 0, parentImagesObserved: 0, DBWrites: 0, fullModernLessonApproved: false,
  hostTokens: 'unknown', cost: 'unknown' };
fs.writeFileSync(`${stage}/raw-promotion.record`, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ status: record.status, prose: 11, exercises: 14, figures: 2,
  record: `${stage}/raw-promotion.record`, sha256: sha(fs.readFileSync(`${stage}/raw-promotion.record`)) }));
