      else { network.blocked.push({ method: request.method(), url: request.url() }); await route.abort('blockedbyclient'); }
    });
    await context.routeWebSocket(/.*/, async socket => { network.blocked.push({ kind: 'websocket' }); await socket.close(); });
    const page = await context.newPage();
    const nativeEvaluate = page.evaluate.bind(page);
    page.evaluate = (...args) => {
      usage.browserEvaluations += 1;
      return nativeEvaluate(...args);
    };
    currentPage = page;
    page.on('pageerror', error => network.pageErrors.push(error.message));
    page.on('console', message => {
