        await check(`${viewKey}:source-anchored-paragraph-rules`, JSON.stringify(actualBreaks) === JSON.stringify(boundaries));
        add('jump', '.jump', 0, projection(`\u53bb\u505a\u9898 \u00b7 ${exercises.count} \u9053 \u2192`));
        assert.equal(await page.getByRole('link').getAttribute('href'), 'exercises.html');
      } else {
