import assert from 'node:assert/strict';
import path from 'node:path';
import { createRequire } from 'node:module';
import { createHash } from 'node:crypto';
import { createServer } from 'node:http';
import { appendFile, mkdir, readFile, writeFile } from 'node:fs/promises';

const ROOT = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
const OUTPUT = path.join(ROOT, '.tmp/ld-s10y-lesson/resume182-6-3129/display-N4-FIRST');
const ID = 'alg7-c1-s1-n4';
const MODERN = path.join(ROOT, 'ssot-resources/soviet10year-textbooks/artifacts/7a/editions/modern-us-neutral');
const LESSON = path.join(MODERN, 'lessons', ID);
const RENDER = path.join(ROOT, '.tmp/ld-s10y-lesson/resume182-6-3129/render-7a-n4-FIRST', ID);
const HISTORY = path.join(ROOT, 'ssot-resources/soviet10year-textbooks/artifacts/8a/evidence');
const BASE = path.join(HISTORY, 'resume182-6-n6-display-runtime3695/resume182-6-8a-n6-display3695-FIRST/display-helper.mjs.record');
const EXTENSION = path.join(HISTORY, 'resume182-6-n11-display-runtime-recovery2-0789/display-FIRST/display-helper.mjs.record');
const STANDARD_METHOD = path.join(HISTORY, 'resume182-6-n11-display-runtime-recovery2-0789/display-FIRST/run.mjs.record');
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const norm = text => String(text).normalize('NFC').replace(/\s+/gu, ' ').trim();
const own = filename => {
  assert.ok(path.resolve(filename).startsWith(`${OUTPUT}/`), 'Write outside authorized directory');
  return filename;
};
assert.equal(process.cwd(), ROOT);
const options = process.argv.slice(2);
const recovery = ['--recover-formula-padding', '--recover-label-binding'].includes(options[0]);
const formulaRecovery = options[0] === '--recover-formula-padding';
assert.ok((!recovery && options.length === 0) || (recovery && options.length === 2));
const previousPath = recovery ? options[1] : null;
if (previousPath) own(previousPath);
const previous = previousPath ? JSON.parse(await readFile(previousPath, 'utf8')) : null;
const attemptNumber = previous ? previous.attemptNumber + 1 : 1;
const RUN = attemptNumber === 1 ? OUTPUT : path.join(OUTPUT, `recovery-${attemptNumber}`);
await mkdir(own(path.join(RUN, 'screenshots')), { recursive: true });
await mkdir(own(path.join(RUN, 'published')), { recursive: true });
await mkdir(own(path.join(RUN, 'browser-tmp')), { recursive: true });
const save = async (name, value) => writeFile(own(path.join(RUN, name)),
  `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
const event = value => appendFile(own(path.join(RUN, 'events.ndjson')),
  `${JSON.stringify({ time: new Date().toISOString(), ...value })}\n`);
const usage = { browserLaunches: 0, browserContexts: 0, pageNavigations: 0,
  browserEvaluations: 0, screenshotsCaptured: 0, screenshotsOpened: 0, imagesObserved: 0,
  rendererCalls: 0, paidCalls: 0, installs: 0, dbCalls: 0 };
const network = { served: [], blocked: [], failures: [], pageErrors: [], consoleErrors: [],
  warnings: [], badResponses: [] };
const report = {
  schema: 'resume182-6-n4-offline-display@1', lesson: ID, book: '7a', edition: 'modern-us-neutral',
  workdir: ROOT, writeRoot: OUTPUT, attemptNumber, startedAt: new Date().toISOString(),
  status: 'RUNNING', boundary: 'text/exercises offline runtime only; no human visual, mathematics, figure or APP acceptance',
  inputs: [], reports: [], checks: [], faults: [], completedViews: previous?.completedViews ?? [],
  screenshots: previous?.screenshots ?? [], coverage: previous?.coverage ?? [],
  viewEvidence: previous?.viewEvidence ?? [],
  priorAttempts: previous ? [...previous.priorAttempts, { path: previousPath, sha256: sha(await readFile(previousPath)),
    attemptNumber: previous.attemptNumber, status: previous.status, failure: previous.executionFailure }] : [],
  cleanup: { contextsCreated: 0, contextsClosedCount: 0, contextsClosed: true,
    browserClosed: true, browserConnectedAfterClose: false, serverClosed: true, serverListeningAfterClose: false },
  usage, network,
};
const assertOfflineRuntime = () => assert.ok(
  ['blocked', 'failures', 'pageErrors', 'consoleErrors', 'badResponses'].every(key => !network[key].length),
  'Actual console/page/network fault');
const check = async (name, success, facts = {}) => {
  const item = { name, status: success ? 'PASS' : 'FAIL', ...facts };
  report.checks.push(item);
  await event({ check: item });
  assertOfflineRuntime();
  assert.ok(success, name);
};
const record = async (filename, expected, input = true) => {
  const bytes = await readFile(filename);
  const entry = { path: filename, sha256: sha(bytes), bytes: bytes.length };
  if (expected) assert.equal(entry.sha256, expected, filename);
  (input ? report.inputs : report.reports).push(entry);
  return bytes;
};
const stage = async (filename, bytes) => {
  await writeFile(own(filename), bytes, { flag: 'wx' });
  await record(filename, sha(bytes), false);
  return { path: filename, sha256: sha(bytes), bytes: bytes.length };
};
const evaluate = async (page, fn, arg) => {
  return page.evaluate(fn, arg);
};
const contexts = new Set();
let browser, server, currentPage, currentView, helpers;
try {
  const pins = {
    'lesson.json': '0543d097083d01e2b4bdf55ec12411494ecec84fa01989f836a125a95fcaea85',
    'exercises.json': '6c43759ff57ca11ede9560d03d398ba9fff74f3176f4b80fbea3f97f39ea00e2',
    'figures.json': 'b974407836dd6b652c209d22322878220f9727df40fa4210e4e18fa1a0764125',
    'answer-keys.json': '6429e869968ae2ddbef61ec01080e1a1e009019293fd44140f6ea7e0fb07b5cc',
  };
  const loaded = {};
  for (const [name, expected] of Object.entries(pins))
    loaded[name] = JSON.parse(await record(path.join(LESSON, name), expected));
  const lesson = loaded['lesson.json'], exercises = loaded['exercises.json'], manifest = loaded['figures.json'];
  const standardDisplay = loaded['answer-keys.json'].answers.map(({ exercise, displayAnswer }) =>
    ({ exercise: String(exercise), text: displayAnswer }));
  delete loaded['answer-keys.json'];
  assert.equal(exercises.count, 15);
  assert.equal(standardDisplay.length, 15);
  assert.deepEqual(standardDisplay.map(item => item.exercise), exercises.exercises.map(item => String(item.number)));
  assert.ok(standardDisplay.every(item => typeof item.text === 'string' && item.text.trim()));
  const figureContracts = {};
  for (const figure of manifest.figures) {
    const spec = JSON.parse(await record(path.join(MODERN, figure.spec)));
    const svgMarkup = (await record(path.join(MODERN, figure.svg))).toString('utf8').replace(/<\?xml[^>]*\?>/u, '').trim();
    await record(path.join(MODERN, figure.render));
    await record(path.join(MODERN, figure.review));
    figureContracts[figure.id] = { svgMarkup, labels: spec.objects.filter(item => item.type === 'text')
      .map(({ id, text }) => ({ id: `${id}-label`, text })), minimumPx: spec.display.minTextPx,
      layout: spec.display.layout, maxWidthPx: spec.display.maxWidthPx };
  }
  assert.deepEqual(Object.keys(figureContracts), ['fig-01']);
  report.figureLabelBinding = {
    source: '.agents/skills/ld-s10y-image/scripts/render_spec.mjs', lines: [246, 247],
    rule: 'Approved spec text object id -> renderer data-label-id `${object.id}-label`',
    svgChanged: false,
  };
  const baseCode = (await record(BASE)).toString('utf8');
  let extensionCode = (await record(EXTENSION)).toString('utf8');
  await record(STANDARD_METHOD);
  const dataModule = code => `data:text/javascript;base64,${Buffer.from(code).toString('base64')}`;
  assert.equal(extensionCode.split("'./display-helper-base.mjs'").length, 2);
  extensionCode = extensionCode.replace("'./display-helper-base.mjs'", JSON.stringify(dataModule(baseCode)));
  const { createDisplayHelpers } = await import(dataModule(extensionCode));
  const requireApp = createRequire(path.join(ROOT, 'app/package.json'));
  const { chromium } = requireApp('playwright');
  const { PNG } = requireApp(path.join(ROOT, 'app/node_modules/playwright-core/lib/utilsBundle.js'));
  const { inline, proseFlow, proseOutline, sectionBreakIndices } = createRequire(
    path.join(ROOT, '.claude/skills/ld-s10y-lesson/tools/htmlfrag.js'))('./htmlfrag.js');
  await record(path.join(ROOT, '.claude/skills/ld-s10y-lesson/tools/htmlfrag.js'));
  helpers = createDisplayHelpers({ norm, own, RUN, assertOfflineRuntime, PNG,
    same: (a, b) => JSON.stringify(a) === JSON.stringify(b), sha, report, usage, event, save, check });
  const { projection, pageSafety, install, captureCoverage } = helpers;
  const flow = proseFlow(lesson.prose, lesson.section_breaks);
  const paragraphs = flow.filter(block => block.kind === 'p');
  const outline = proseOutline(lesson.prose);
  const boundaries = sectionBreakIndices(lesson.prose, lesson.section_breaks);
  report.projection = {
    modernBlocks: lesson.prose.length, paragraphs: paragraphs.length, boundaries,
    sourceProjectionReused: true, sourceReviewRepeated: false,
    sourceLesson: { path: lesson.source.path, sha256: lesson.source.sha256 },
    sourceBlocks: lesson.prose.map((block, index) => ({ index, refs: block.source_refs,
      sourceTextSha256: sha(block.source_text ?? ''), modernTextSha256: sha(block.text),
      paragraphIndices: outline.filter(item => item.blockIndex === index).map(item => item.index) })),
    originalExercises: exercises.exercises.map(item => ({ exercise: String(item.number),
      sourceNumber: item.source_number, pages: item.pages,
      sourceTextSha256: sha(item.source_text), modernTextSha256: sha(item.text) })),
    standardDisplayCount: standardDisplay.length, standardFields: ['exercise', 'displayAnswer'],
    gradingExpectedOrChoicePayloadProjected: false, figureIds: Object.keys(figureContracts),
  };
  const leakage = /\b(?:key|correct|accept|expected|seed_sha256|draft_sha256|source_numbers|source_solution|independent_solution|correct_index|correctIndex|answerKey|answer_key|rationales|misconception|omitted_tasks|api_key|password|postgres(?:ql)?|intent)\b/iu;
  const standardFragments = standardDisplay.map(item => ({ exercise: item.exercise, html: inline(item.text) }));
  assert.ok(standardFragments.every(item => !leakage.test(item.html)));
  report.standardDisplay = { source: path.join(LESSON, 'answer-keys.json'),
    sourceSha256: pins['answer-keys.json'], fields: ['exercise', 'displayAnswer'],
    fragmentSha256: sha(JSON.stringify(standardFragments)), method: { path: STANDARD_METHOD, lines: [274, 351] },
    staticHtmlPersisted: previous?.standardDisplay.staticHtmlPersisted ?? false,
    originalRendererBytesPreserved: true, staticHtml: previous?.standardDisplay.staticHtml ?? null };
  const html = new Map();
  report.originalRenderer = [];
  for (const surface of ['text', 'exercises']) {
    const filename = path.join(RENDER, `${surface}.html`);
    const bytes = await record(filename);
    if (previous) assert.equal(sha(bytes), previous.originalRenderer.find(item => item.surface === surface).sha256);
    assert.ok(!leakage.test(bytes.toString('utf8')));
    report.originalRenderer.push({ surface, path: filename, sha256: sha(bytes) });
    html.set(`/${surface}.html`, bytes);
  }
  if (previous?.standardDisplay.staticHtml) {
    const entry = previous.standardDisplay.staticHtml;
    html.set('/exercises.html', await record(entry.path, entry.sha256));
  }
  if (recovery) {
    assert.ok(previous.executionFailure && previous.failedView);
    assert.ok(!report.completedViews.includes(previous.failedView));
    if (!formulaRecovery) assert.match(previous.executionFailure.message, /approved-svg-on-page-media/u);
    report.recovery = { reason: formulaRecovery ? 'Actual failed formula clipping/reachability only'
      : 'Checker label identity projection corrected to the existing official renderer',
      view: previous.failedView, cssChanged: formulaRecovery,
      originalFailure: previous.executionFailure, priorFailurePreserved: true };
  }
  server = createServer((request, response) => {
    network.served.push({ method: request.method, path: request.url });
    if (request.method === 'GET' && request.url === '/favicon.ico') return void response.writeHead(204).end();
    const bytes = request.method === 'GET' ? html.get(request.url) : undefined;
    if (!bytes) {
      network.badResponses.push({ path: request.url, status: 404 });
      return void response.writeHead(404).end();
    }
    response.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store',
      'Content-Security-Policy': "default-src 'none'; style-src 'unsafe-inline'; font-src data:; img-src data:; script-src 'none'; connect-src 'none'; frame-src 'none'; form-action 'none';" }).end(bytes);
  });
  await new Promise((resolve, reject) => { server.once('error', reject); server.listen(0, '127.0.0.1', resolve); });
  report.cleanup.serverClosed = false;
  const origin = `http://127.0.0.1:${server.address().port}`;
  report.server = { origin, portRequested: 0, htmlOnly: true };
  for (const [route, bytes] of html) {
    const response = await fetch(`${origin}${route}`, { signal: AbortSignal.timeout(5000) });
    assert.equal(response.status, 200);
    assert.equal(sha(Buffer.from(await response.arrayBuffer())), sha(bytes));
  }
  usage.browserLaunches += 1;
  browser = await chromium.launch({ headless: true, timeout: 30000,
    downloadsPath: own(path.join(RUN, 'browser-tmp')),
    env: { PATH: '/usr/bin:/bin:/usr/sbin:/sbin', LANG: 'en_US.UTF-8', TMPDIR: path.join(RUN, 'browser-tmp') },
    args: ['--disable-background-networking', '--disable-component-update', '--disable-sync',
      '--no-first-run', '--disable-default-apps', '--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE 127.0.0.1'] });
  report.cleanup.browserClosed = false;
  report.browser = { version: browser.version(), headless: true, isolated: true, dependency: 'existing app Playwright' };
  for (const viewport of [{ width: 1440, height: 960 }, { width: 390, height: 844 }]) {
    const pending = ['text', 'exercises'].filter(surface => !report.completedViews.includes(`${viewport.width}:${surface}`));
    if (!pending.length) continue;
    const context = await browser.newContext({ viewport, deviceScaleFactor: 1, serviceWorkers: 'block', acceptDownloads: false });
    contexts.add(context);
    usage.browserContexts += 1;
    report.cleanup.contextsCreated += 1;
    report.cleanup.contextsClosed = false;
    context.setDefaultTimeout(20000);
    await context.route('**/*', async route => {
      const request = route.request(), url = new URL(request.url());
      if (request.method() === 'GET' && url.origin === origin && !url.search && !url.hash
