        for (const exercise of exercises.exercises) {
          const number = String(exercise.source_number ?? exercise.number), suffix = exercise.text.slice(number.length);
          const prefix = exercise.text.startsWith(number) && (/^\.\s/u.test(suffix) || /^\uFF0E(?![0-9\uFF10-\uFF19])/u.test(suffix));
          add(`exercise-${exercise.number}`, `#ex-${exercise.number} .body`, 0, projection(prefix ? suffix.slice(1).trimStart() : exercise.text));
          add(`number-${exercise.number}`, `#ex-${exercise.number} .no`, 0, projection(`${number}.`));
          const answer = standardDisplay.find(item => item.exercise === String(exercise.number));
          add(`standard-${exercise.number}`, `#ex-${exercise.number} .standard-text`, 0, projection(answer.text));
          add(`standard-label-${exercise.number}`, `#ex-${exercise.number} .standard-label`, 0, projection('\u6807\u51c6\u7b54\u6848'));
        }
        const groups = exercises.exercises.filter((item, index, all) => item.group !== (index ? all[index - 1].group : null));
        assert.equal(await page.locator('.exgroup').count(), groups.length);
        groups.forEach((group, index) => add(`group-${index}`, '.exgroup', index, projection(group.group || '\u7ec3\u4e60')));
        assert.deepEqual(await page.locator('figure').evaluateAll(nodes => nodes.map(node => node.id)),
          exercises.exercises.flatMap(item => (item.figures ?? []).map(figure => figure.id)));
        add('jump', '.jump', 0, projection('\u2190 \u56de\u8bfe\u6587'));
        assert.equal(await page.getByRole('link').getAttribute('href'), 'text.html');
      }
      const dom = await install(page, { materials: materials.map(({ expected, paragraph, ...descriptor }) => descriptor), figureContracts });
      await save(`${viewport.width}-${surface}-dom.json`, dom);
      await record(path.join(RUN, `${viewport.width}-${surface}-dom.json`), undefined, false);
      await check(`${viewKey}:glyph-rules-media-and-formula-boxes-reachable`, dom.targetCount > 0
        && !dom.hidden.length && !dom.failed.length && !dom.internalClips.length
        && dom.formulaGlyphFonts.every(font => /^KaTeX/u.test(font.family) && font.px > 0 && font.loaded && font.available)
        && dom.ends.every(end => Math.abs(end.actual - end.maximum) <= 1)
        && dom.horizontalEnds.every(end => end.left === 0 && Math.abs(end.right - end.maximum) <= 1),
      { targets: dom.targetCount, hidden: dom.hidden, failed: dom.failed,
        internalClips: dom.internalClips, horizontalEnds: dom.horizontalEnds,
        badFormulaGlyphFonts: dom.formulaGlyphFonts.filter(font => !/^KaTeX/u.test(font.family) || !font.loaded || !font.available) });
      for (const material of materials) {
        const name = `${viewKey}:${material.key}:text-formulas-and-rows`;
        const actual = dom.roots.find(root => root.key === material.key), expected = material.expected;
        assert.equal(actual.serialized, expected.serialized, name);
        assert.deepEqual(actual.formulas.map(formula => formula.tex), expected.formulas, name);
        assert.deepEqual(actual.lines, expected.lines, name);
        assert.deepEqual(actual.tables, [], name);
        const rowPairs = actual.lines.flatMap((line, index) => {
          if (!/^(?:[a-z]|\d+)\)\s/u.test(line)) return [];
          let previous = index - 1;
          while (previous >= 0 && !actual.lines[previous]) previous -= 1;
          return [{ index, previous, current: actual.lineGeometry[index], preceding: actual.lineGeometry[previous] }];
        });
        const typography = !material.paragraph || parseFloat(actual.textIndent) === 0
          && actual.mathTypography.every(font => /KaTeX_Main/u.test(font.family) && font.px >= actual.fontPx * 1.1 - 0.02);
        await check(name, typography && actual.formulas.every(formula => formula.visible && formula.nonempty)
          && rowPairs.every(pair => pair.previous < 0 || pair.current && pair.preceding && pair.current.top > pair.preceding.top + 0.5),
        { textSha256: sha(actual.serialized), formulas: expected.formulas.length, rowPairs, typography });
      }
      for (const figure of dom.figures)
        await check(`${viewKey}:${figure.key}:approved-svg-on-page-media`, figure.exactSvg && figure.labelBindings
          && figure.minimumPx >= 16 && figure.labels.every(label => label.insideSvg && label.px >= figure.minimumPx)
          && figure.layout === figure.expectedLayout && figure.mediaWidth > 0 && figure.mediaHeight > 0
          && figure.svgWidth === figure.mediaWidth && figure.mediaWidth <= figure.expectedWidth,
        { id: figure.id, labels: figure.labels, width: figure.mediaWidth, height: figure.mediaHeight,
          approvedMaxWidthPx: figure.expectedWidth, figureReviewRepeated: false });
      const safety = await evaluate(page, pageSafety);
      await check(`${viewKey}:readonly-contained-loaded-fonts`, safety.documentWidth <= viewport.width
        && safety.bodyWidth <= viewport.width && safety.scrollX === 0 && !safety.errors && !safety.widgets
        && !safety.scripts && !safety.dangerousAttributes.length && !safety.labelBodyCollisions.length
        && safety.sections.every((box, index, boxes) => box.left >= 0 && box.right <= viewport.width
          && box.height > 0 && (!index || box.top >= boxes[index - 1].bottom))
        && safety.fonts.some(font => font.family.startsWith('KaTeX') && font.status === 'loaded')
        && safety.fonts.every(font => font.status !== 'error'), safety);
      await captureCoverage(page, viewport, surface, dom);
      await record(path.join(RUN, `${viewport.width}-${surface}-coverage.json`), undefined, false);
      const after = await evaluate(page, pageSafety);
      await check(`${viewKey}:contained-after-native-scrolls`,
        after.documentWidth <= viewport.width && after.bodyWidth <= viewport.width && after.scrollX === 0);
      report.completedViews.push(viewKey);
      report.viewEvidence.push({ view: viewKey, surface, viewport, deliveredHtml: delivered,
        dom: report.reports.find(item => item.path === path.join(RUN, `${viewport.width}-${surface}-dom.json`)),
        coverage: report.reports.find(item => item.path === path.join(RUN, `${viewport.width}-${surface}-coverage.json`)) });
      await event({ completedView: viewKey, deliveredHtml: delivered });
      console.log(JSON.stringify({ completedView: viewKey, targets: dom.targetCount,
        screenshots: report.coverage.find(item => item.viewport.width === viewport.width && item.surface === surface).screenshotPaths.length }));
    }
    await context.close();
    contexts.delete(context);
    report.cleanup.contextsClosedCount += 1;
    currentPage = null;
  }
  await check('two-surfaces-four-combinations', new Set(report.completedViews).size === 4
    && new Set(report.coverage.map(item => `${item.viewport.width}:${item.surface}`)).size === 4
    && usage.rendererCalls === 0);
  await check('offline-html-only-no-runtime-errors', network.served.every(request => request.method === 'GET'
    && ['/text.html', '/exercises.html', '/favicon.ico'].includes(request.path)), network);
} catch (error) {
  report.executionFailure = { name: error.name, message: error.message, stack: error.stack };
  report.failedView = currentView ? `${currentView.viewport.width}:${currentView.surface}` : null;
  report.faults.push({ ...report.executionFailure, preserved: true });
  await event({ failure: report.executionFailure, failedView: report.failedView });
  if (currentPage && !currentPage.isClosed() && currentView) {
    try {
      const bytes = await currentPage.screenshot({ type: 'png', fullPage: false, animations: 'disabled' });
      usage.screenshotsCaptured += 1;
      const entry = await stage(path.join(RUN, 'screenshots/FAILURE-native.png'), bytes);
      report.screenshots.push({ ...entry, ...currentView, nativeSize: true, croppedOrResized: false,
        fullPage: false, visualObservation: 'UNOBSERVED', captureChecks: 'FAILURE_PRESERVED' });
    } catch (captureError) { report.faults.push({ stage: 'failure-capture', message: captureError.message }); }
  }
} finally {
  for (const context of contexts) {
    try { await context.close(); report.cleanup.contextsClosedCount += 1; contexts.delete(context); }
    catch (error) { report.faults.push({ stage: 'context-close', message: error.message }); }
  }
  report.cleanup.contextsClosed = contexts.size === 0
    && report.cleanup.contextsCreated === report.cleanup.contextsClosedCount;
  try {
    if (browser) await browser.close();
    report.cleanup.browserClosed = true;
    report.cleanup.browserConnectedAfterClose = browser?.isConnected() ?? false;
  } catch (error) { report.faults.push({ stage: 'browser-close', message: error.message }); }
  try {
    if (server?.listening) {
      server.closeAllConnections();
      await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
    }
    report.cleanup.serverClosed = true;
    report.cleanup.serverListeningAfterClose = server?.listening ?? false;
  } catch (error) { report.faults.push({ stage: 'server-close', message: error.message }); }
  for (const entry of [...report.inputs, ...report.reports, ...report.screenshots]) {
    try { assert.equal(sha(await readFile(entry.path)), entry.sha256); }
    catch (error) { report.faults.push({ stage: 'preservation', path: entry.path, message: error.message }); }
  }
  report.originalRendererUnchanged = report.originalRenderer?.every(entry =>
    report.inputs.some(input => input.path === entry.path && input.sha256 === entry.sha256)) ?? false;
  report.finishedAt = new Date().toISOString();
  report.cumulativeUsage = Object.fromEntries(Object.keys(usage).map(key =>
    [key, usage[key] + (previous?.cumulativeUsage[key] ?? 0)]));
  report.cumulativeUsage.fees = 'unknown';
  report.cumulativeUsage.imagesOpened = 0;
  report.cumulativeUsage.delegationCalls = 0;
  report.status = !report.faults.length && report.completedViews.length === 4
    && report.cleanup.contextsClosed && report.cleanup.browserClosed && report.cleanup.serverClosed
    ? 'RUNTIME_PASS_VISUAL_PENDING' : 'RUNTIME_FAILED_VISUAL_PENDING';
  await save('report-FIRST.json', report);
  console.log(JSON.stringify({ status: report.status, report: path.join(RUN, 'report-FIRST.json'),
    completedViews: report.completedViews, failure: report.executionFailure?.message, cleanup: report.cleanup }));
  process.exitCode = report.status === 'RUNTIME_PASS_VISUAL_PENDING' ? 0 : 1;
}
