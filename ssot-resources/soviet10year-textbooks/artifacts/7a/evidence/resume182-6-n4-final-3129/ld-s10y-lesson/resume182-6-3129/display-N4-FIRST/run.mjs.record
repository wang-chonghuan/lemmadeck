      if (surface === 'exercises' && !report.standardDisplay.staticHtmlPersisted) {
        await evaluate(page, fragments => {
          const style = document.createElement('style');
          style.textContent = '.standard-display{grid-column:2;min-width:0;line-height:1.9}'
            + '.standard-label{font-size:.85em;color:var(--sub);margin:.3em 0}'
            + '.standard-text{min-width:0;overflow-x:auto;overflow-y:hidden;padding-block:calc(.2em + 1px);margin-block:-.2em}';
          document.head.append(style);
          for (const fragment of fragments) {
            const exercise = document.getElementById(`ex-${fragment.exercise}`);
            if (!exercise || exercise.querySelector('.standard-display')) throw new Error('Missing or duplicate standard display');
            const container = document.createElement('div'); container.className = 'standard-display';
            const label = document.createElement('p'); label.className = 'standard-label'; label.textContent = '\u6807\u51c6\u7b54\u6848';
            const text = document.createElement('div'); text.className = 'standard-text'; text.innerHTML = fragment.html;
            container.append(label, text); exercise.append(container);
          }
        }, standardFragments);
        const serialized = Buffer.from(await page.content());
        assert.ok(!leakage.test(serialized.toString('utf8')));
        report.standardDisplay.staticHtml = await stage(path.join(RUN, 'published/exercises.html'), serialized);
        report.standardDisplay.staticHtmlPersisted = true;
        html.set('/exercises.html', serialized);
        usage.pageNavigations += 1;
        const response = await page.goto(`${origin}/exercises.html`, { waitUntil: 'load' });
        assert.equal(sha(await response.body()), sha(serialized));
        assert.equal(sha(Buffer.from(await page.content())), sha(serialized));
      }
      let delivered = surface === 'text' ? report.originalRenderer.find(item => item.surface === surface)
        : report.standardDisplay.staticHtml;
      if (formulaRecovery && viewKey === previous.failedView) {
        await evaluate(page, width => {
          const style = document.createElement('style'); style.id = 'formula-padding-final';
          style.textContent = `@media(min-width:${width}px) and (max-width:${width}px){`
            + '.nb,.sr-nb{padding:.3em .15em;margin-block:0;box-sizing:border-box;vertical-align:middle}'
            + '.nb:has(.delimsizing.mult),.sr-nb:has(.delimsizing.mult){padding-block:1.2em}}';
          document.head.append(style);
        }, viewport.width);
        const bytes = Buffer.from(await page.content());
        assert.ok(!leakage.test(bytes.toString('utf8')));
        delivered = await stage(path.join(RUN, `published/${viewport.width}-${surface}-formula-padding.html`), bytes);
        html.set(`/${surface}.html`, bytes);
        usage.pageNavigations += 1;
        const response = await page.goto(`${origin}/${surface}.html`, { waitUntil: 'load' });
        assert.equal(sha(await response.body()), delivered.sha256);
        assert.equal(sha(Buffer.from(await page.content())), delivered.sha256);
      }
      await evaluate(page, () => document.fonts.ready);
      assertOfflineRuntime();
      const materials = [];
      const add = (key, selector, index, expected, paragraph = false) =>
        materials.push({ key, selector, index, expected, paragraph });
      const title = lesson.printed_title || lesson.title;
      add('title', 'h1', 0, projection(surface === 'text' ? title : `${title} \u00b7 \u4e60\u9898`));
      add('crumb', '.crumb', 0, projection([lesson.chapter, lesson.section,
