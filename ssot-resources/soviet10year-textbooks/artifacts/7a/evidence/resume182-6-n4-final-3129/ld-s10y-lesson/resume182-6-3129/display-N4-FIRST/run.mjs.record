      if (surface === 'text') {
        assert.equal(await page.locator('p.para').count(), paragraphs.length);
        paragraphs.forEach((block, index) => add(`prose-${index}`, 'p.para', index, projection(block.text), true));
        const caps = flow.filter(block => block.kind === 'cap');
        assert.equal(await page.locator('.figcap').count(), caps.length);
