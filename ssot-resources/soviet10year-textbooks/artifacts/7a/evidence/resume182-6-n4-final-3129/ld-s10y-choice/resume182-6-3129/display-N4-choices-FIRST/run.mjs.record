  cleanup: { contextsCreated: 0, contextsClosedCount: 0, contextsClosed: true, browserClosed: true,
    browserConnectedAfterClose: false, serverClosed: true, serverListeningAfterClose: false },
  usage, network, visualObservation: 'PENDING', finalBindingOwner: 'parent',
