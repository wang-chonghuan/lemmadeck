  replaceOnce('    for (const node of [root, ...root.querySelectorAll(\'*\')]) {', `
    for (const [tableIndex, table] of [...root.querySelectorAll('table')].entries()) {
      for (const [rowIndex, row] of [...table.rows].entries()) {
