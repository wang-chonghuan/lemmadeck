  const { projection, pageSafety, install, captureCoverage } = helpers;
  const expectedChoice = text => {
    const tokens = marked.lexer(text), tables = [], pieces = [];
    if (!tokens.some(token => token.type === 'table')) return { ...projection(text), tables, literalLF: true };
    for (const token of tokens) {
      if (token.type !== 'table') { pieces.push(token.raw); continue; }
      const rows = [token.header, ...token.rows].map(row => row.map(cell => cell.text));
      tables.push(rows.map(row => row.map(projection)));
      pieces.push(...rows.map(row => row.join(' ')));
    }
    return { ...projection(pieces.join(' ')), tables, literalLF: false };
  };
