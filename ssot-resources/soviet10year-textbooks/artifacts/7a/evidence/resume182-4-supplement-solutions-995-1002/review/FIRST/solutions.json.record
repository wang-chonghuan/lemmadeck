  "exercises": [
    {
      "exercise_id": "alg7-c4-ex995", "number": "995", "raw_array_index": 86,
      "source_pages": ["p0299#4"],
      "source_text_sha256": "f93b4ff4a7d5080165634dc2d93fd22a0532116dff47e9b8f7d810ab32f07b21",
      "source_prose": "995. 求下列各式的值：а) $x^2-4x+3$，设$x=2+\\sqrt{3}$；б) $x^2-3x+5$，设$x=\\frac{3+\\sqrt{2}}{2}$。",
      "tasks": [
        {"task_id": "995-a", "source_label": "а", "kind": "evaluation", "prompt": "x^2-4x+3 at x=2+sqrt(3)", "polynomial": [1,-4,3], "given": {"u":2,"v":1,"d":3,"w":1}, "square_form": {"scale":"1","center":"2","offset":"-1"}, "value": "2", "derivation": ["x^2-4x+3=(x-2)^2-1", "x-2=sqrt(3)", "(sqrt(3))^2-1=2"]},
        {"task_id": "995-b", "source_label": "б", "kind": "evaluation", "prompt": "x^2-3x+5 at x=(3+sqrt(2))/2", "polynomial": [1,-3,5], "given": {"u":3,"v":1,"d":2,"w":2}, "square_form": {"scale":"1","center":"3/2","offset":"11/4"}, "value": "13/4", "derivation": ["x^2-3x+5=(x-3/2)^2+11/4", "x-3/2=sqrt(2)/2", "2/4+11/4=13/4"]}
      ]
    },
    {
      "exercise_id": "alg7-c4-ex996", "number": "996", "raw_array_index": 87,
      "source_pages": ["p0299#6"],
      "source_text_sha256": "615e3ecb18599b334f5dadbae644756f1eb326e43c27486b0853b632f9018532",
      "source_prose": "996. 用图解法解下列方程：а) $x^2=5x-8$； б) $x^2=\\frac{1}{2}x+5$；в) $2x^2-3x-10=0$； г) $x^2+2x-14=0$；д) $x^2-x+12=0$； е) $x^2+6x-16=0$。",
      "tasks": [
        {"task_id":"996-a", "source_label":"а", "kind":"graphical_equation", "prompt":"x^2=5x-8", "polynomial":[1,-5,8], "roots":[], "square_form":{"scale":"1","center":"5/2","offset":"7/4"}, "graph":{"curves":["y=x^2","y=5x-8"], "curve_polynomials":[[1,0,0],[0,5,-8]], "intersections":[], "above":"R", "below":"empty"}, "derivation":["Left curve minus right curve = (x-5/2)^2+7/4 > 0 for every real x.","The curves never meet; no real solution."]},
        {"task_id":"996-b", "source_label":"б", "kind":"graphical_equation", "prompt":"x^2=x/2+5", "polynomial":[1,"-1/2",-5], "roots":["-2","5/2"], "graph":{"curves":["y=x^2","y=x/2+5"], "curve_polynomials":[[1,0,0],[0,"1/2",5]], "intersections":[["-2","4"],["5/2","25/4"]], "below":[["-2","5/2"]], "above":[[null,"-2"],["5/2",null]]}, "derivation":["Vertical difference = (x+2)(x-5/2).","The two intersection abscissae are -2 and 5/2."]},
        {"task_id":"996-c", "source_label":"в", "kind":"graphical_equation", "prompt":"2x^2-3x-10=0", "polynomial":[2,-3,-10], "roots":["(3-sqrt(89))/4","(3+sqrt(89))/4"], "root_pair":{"u":3,"v":1,"d":89,"w":4}, "square_form":{"scale":"2","center":"3/4","offset":"-89/8"}, "graph":{"curves":["y=2x^2","y=3x+10"], "curve_polynomials":[[2,0,0],[0,3,10]], "intersections":[["(3-sqrt(89))/4","(49-3*sqrt(89))/4"],["(3+sqrt(89))/4","(49+3*sqrt(89))/4"]], "below":[["(3-sqrt(89))/4","(3+sqrt(89))/4"]], "above":[[null,"(3-sqrt(89))/4"],["(3+sqrt(89))/4",null]]}, "derivation":["Vertical difference = 2*(x-3/4)^2-89/8.","At intersections (x-3/4)^2=89/16, so x=(3 +/- sqrt(89))/4."]},
        {"task_id":"996-d", "source_label":"г", "kind":"graphical_equation", "prompt":"x^2+2x-14=0", "polynomial":[1,2,-14], "roots":["-1-sqrt(15)","-1+sqrt(15)"], "root_pair":{"u":-1,"v":1,"d":15,"w":1}, "square_form":{"scale":"1","center":"-1","offset":"-15"}, "graph":{"curves":["y=x^2","y=14-2x"], "curve_polynomials":[[1,0,0],[0,-2,14]], "intersections":[["-1-sqrt(15)","16+2*sqrt(15)"],["-1+sqrt(15)","16-2*sqrt(15)"]], "below":[["-1-sqrt(15)","-1+sqrt(15)"]], "above":[[null,"-1-sqrt(15)"],["-1+sqrt(15)",null]]}, "derivation":["Vertical difference = (x+1)^2-15.","At intersections x+1=+/-sqrt(15), giving x=-1 +/- sqrt(15)."]},
        {"task_id":"996-e", "source_label":"д", "kind":"graphical_equation", "prompt":"x^2-x+12=0", "polynomial":[1,-1,12], "roots":[], "square_form":{"scale":"1","center":"1/2","offset":"47/4"}, "graph":{"curves":["y=x^2","y=x-12"], "curve_polynomials":[[1,0,0],[0,1,-12]], "intersections":[], "above":"R", "below":"empty"}, "derivation":["Vertical difference = (x-1/2)^2+47/4 > 0.","The parabola is always above the line: no real intersections or solutions."]},
        {"task_id":"996-f", "source_label":"е", "kind":"graphical_equation", "prompt":"x^2+6x-16=0", "polynomial":[1,6,-16], "roots":["-8","2"], "graph":{"curves":["y=x^2","y=16-6x"], "curve_polynomials":[[1,0,0],[0,-6,16]], "intersections":[["-8","64"],["2","4"]], "below":[["-8","2"]], "above":[[null,"-8"],["2",null]]}, "derivation":["Vertical difference = (x+8)(x-2).","Intersections have x=-8 and x=2."]}
      ]
    },
    {
      "exercise_id": "alg7-c4-ex997", "number": "997", "raw_array_index": 88,
      "source_pages": ["p0299#7"],
      "source_text_sha256": "10f64287ccb18e6da53185442708a18e6294f8ee69b27a059639583278359f38",
      "source_prose": "997. 用图解法解方程$x^2=12-x$和不等式$x^2>12-x$，$x^2<12-x$。",
      "tasks": [
        {"task_id":"997-equation", "source_label":"equation", "kind":"graphical_equation", "prompt":"x^2=12-x", "polynomial":[1,1,-12], "roots":["-4","3"], "graph":{"curves":["y=x^2","y=12-x"], "curve_polynomials":[[1,0,0],[0,-1,12]], "intersections":[["-4","16"],["3","9"]], "below":[["-4","3"]], "above":[[null,"-4"],["3",null]]}, "derivation":["Vertical difference = x^2+x-12=(x+4)(x-3).","Intersection abscissae -4 and 3 solve the equation."]},
        {"task_id":"997-strict_greater", "source_label":"strict_greater", "kind":"graphical_inequality", "prompt":"x^2>12-x", "polynomial":[1,1,-12], "relation":">0", "boundary_roots":["-4","3"], "intervals":[[null,"-4"],["3",null]], "graph":{"curves":["y=x^2","y=12-x"], "curve_polynomials":[[1,0,0],[0,-1,12]], "intersections":[["-4","16"],["3","9"]], "selected_comparison":"above", "selected_intervals":[[null,"-4"],["3",null]]}, "derivation":["The upward parabola is above the line outside the two intersections, where (x+4)(x-3)>0.","Strictness excludes x=-4 and x=3."]},
        {"task_id":"997-strict_less", "source_label":"strict_less", "kind":"graphical_inequality", "prompt":"x^2<12-x", "polynomial":[1,1,-12], "relation":"<0", "boundary_roots":["-4","3"], "intervals":[["-4","3"]], "graph":{"curves":["y=x^2","y=12-x"], "curve_polynomials":[[1,0,0],[0,-1,12]], "intersections":[["-4","16"],["3","9"]], "selected_comparison":"below", "selected_intervals":[["-4","3"]]}, "derivation":["Between the intersections, (x+4)(x-3)<0, so the parabola is below the line.","Strictness excludes both endpoints."]}
      ]
    },
    {
      "exercise_id": "alg7-c4-ex998", "number": "998", "raw_array_index": 89,
      "source_pages": ["p0299#8"],
      "source_text_sha256": "7c8bfc4045084ecfbb49c7607a3704fc8df43590f49f3941af8c74d616fea5fa",
      "source_prose": "998. 用图解法解下列不等式：а) $x^2<5x+6$； б) $\\frac{1}{2}x^2<2x$；в) $x^2-x+4>0$； г) $2x^2+5x+3<0$。",
      "tasks": [
        {"task_id":"998-a", "source_label":"а", "kind":"graphical_inequality", "prompt":"x^2<5x+6", "polynomial":[1,-5,-6], "relation":"<0", "boundary_roots":["-1","6"], "intervals":[["-1","6"]], "graph":{"curves":["y=x^2","y=5x+6"], "curve_polynomials":[[1,0,0],[0,5,6]], "intersections":[["-1","1"],["6","36"]], "selected_comparison":"below", "selected_intervals":[["-1","6"]]}, "derivation":["Vertical difference = (x+1)(x-6).","The parabola is below the line exactly between the intersections; -1<x<6."]},
        {"task_id":"998-b", "source_label":"б", "kind":"graphical_inequality", "prompt":"x^2/2<2x", "polynomial":["1/2",-2,0], "relation":"<0", "boundary_roots":["0","4"], "intervals":[["0","4"]], "graph":{"curves":["y=x^2/2","y=2x"], "curve_polynomials":[["1/2",0,0],[0,2,0]], "intersections":[["0","0"],["4","8"]], "selected_comparison":"below", "selected_intervals":[["0","4"]]}, "derivation":["Vertical difference = x*(x-4)/2.","The parabola is below the line for 0<x<4; endpoints are excluded."]},
        {"task_id":"998-c", "source_label":"в", "kind":"graphical_inequality", "prompt":"x^2-x+4>0", "polynomial":[1,-1,4], "relation":">0", "boundary_roots":[], "intervals":[[null,null]], "square_form":{"scale":"1","center":"1/2","offset":"15/4"}, "graph":{"curves":["y=x^2","y=x-4"], "curve_polynomials":[[1,0,0],[0,1,-4]], "intersections":[], "selected_comparison":"above", "selected_intervals":[[null,null]]}, "derivation":["Vertical difference = (x-1/2)^2+15/4>0.","The parabola is above the line for all real x; no equality boundary exists."]},
        {"task_id":"998-d", "source_label":"г", "kind":"graphical_inequality", "prompt":"2x^2+5x+3<0", "polynomial":[2,5,3], "relation":"<0", "boundary_roots":["-3/2","-1"], "intervals":[["-3/2","-1"]], "graph":{"curves":["y=2x^2","y=-5x-3"], "curve_polynomials":[[2,0,0],[0,-5,-3]], "intersections":[["-3/2","9/2"],["-1","2"]], "selected_comparison":"below", "selected_intervals":[["-3/2","-1"]]}, "derivation":["Vertical difference = (2x+3)*(x+1).","The parabola is below the line between x=-3/2 and x=-1; strictness excludes both."]}
      ]
    },
    {
      "exercise_id": "alg7-c4-ex999", "number": "999", "raw_array_index": 90,
      "source_pages": ["p0300#2"],
      "source_text_sha256": "88c2adc782908fb5605c674c375ac2cae827c3075ab02d2bf2b41d7016a86fa3",
      "source_prose": "999. 用配方法解下列方程：а) $x^2-16x+48=0$； б) $x^2+12x+27=0$；в) $x^2+10x-39=0$； г) $x^2-6x-55=0$；д) $x^2+7x-18=0$； е) $x^2-11x+28=0$；ж) $2x^2-5x+2=0$； з) $3x^2-x-70=0$。",
      "tasks": [
        {"task_id":"999-a", "source_label":"а", "kind":"completing_square_equation", "prompt":"x^2-16x+48=0", "polynomial":[1,-16,48], "square_form":{"scale":"1","center":"8","offset":"-16"}, "square_rhs":"16", "roots":["4","12"], "derivation":["x^2-16x=-48", "Add 64: (x-8)^2=16", "x-8=+/-4", "x=4 or x=12"]},
        {"task_id":"999-b", "source_label":"б", "kind":"completing_square_equation", "prompt":"x^2+12x+27=0", "polynomial":[1,12,27], "square_form":{"scale":"1","center":"-6","offset":"-9"}, "square_rhs":"9", "roots":["-9","-3"], "derivation":["x^2+12x=-27", "Add 36: (x+6)^2=9", "x+6=+/-3", "x=-9 or x=-3"]},
        {"task_id":"999-c", "source_label":"в", "kind":"completing_square_equation", "prompt":"x^2+10x-39=0", "polynomial":[1,10,-39], "square_form":{"scale":"1","center":"-5","offset":"-64"}, "square_rhs":"64", "roots":["-13","3"], "derivation":["x^2+10x=39", "Add 25: (x+5)^2=64", "x+5=+/-8", "x=-13 or x=3"]},
        {"task_id":"999-d", "source_label":"г", "kind":"completing_square_equation", "prompt":"x^2-6x-55=0", "polynomial":[1,-6,-55], "square_form":{"scale":"1","center":"3","offset":"-64"}, "square_rhs":"64", "roots":["-5","11"], "derivation":["x^2-6x=55", "Add 9: (x-3)^2=64", "x-3=+/-8", "x=-5 or x=11"]},
        {"task_id":"999-e", "source_label":"д", "kind":"completing_square_equation", "prompt":"x^2+7x-18=0", "polynomial":[1,7,-18], "square_form":{"scale":"1","center":"-7/2","offset":"-121/4"}, "square_rhs":"121/4", "roots":["-9","2"], "derivation":["x^2+7x=18", "Add 49/4: (x+7/2)^2=121/4", "x+7/2=+/-11/2", "x=-9 or x=2"]},
        {"task_id":"999-f", "source_label":"е", "kind":"completing_square_equation", "prompt":"x^2-11x+28=0", "polynomial":[1,-11,28], "square_form":{"scale":"1","center":"11/2","offset":"-9/4"}, "square_rhs":"9/4", "roots":["4","7"], "derivation":["x^2-11x=-28", "Add 121/4: (x-11/2)^2=9/4", "x-11/2=+/-3/2", "x=4 or x=7"]},
        {"task_id":"999-g", "source_label":"ж", "kind":"completing_square_equation", "prompt":"2x^2-5x+2=0", "polynomial":[2,-5,2], "normalization":"Divide the equation by nonzero 2.", "square_form":{"scale":"2","center":"5/4","offset":"-9/8"}, "square_rhs":"9/16", "roots":["1/2","2"], "derivation":["x^2-(5/2)*x+1=0", "x^2-(5/2)*x=-1", "Add 25/16: (x-5/4)^2=9/16", "x-5/4=+/-3/4", "x=1/2 or x=2"]},
        {"task_id":"999-h", "source_label":"з", "kind":"completing_square_equation", "prompt":"3x^2-x-70=0", "polynomial":[3,-1,-70], "normalization":"Divide the equation by nonzero 3.", "square_form":{"scale":"3","center":"1/6","offset":"-841/12"}, "square_rhs":"841/36", "roots":["-14/3","5"], "derivation":["x^2-x/3-70/3=0", "x^2-x/3=70/3", "Add 1/36: (x-1/6)^2=841/36", "x-1/6=+/-29/6", "x=-14/3 or x=5"]}
      ]
    },
    {
      "exercise_id": "alg7-c4-ex1000", "number": "1000", "raw_array_index": 91,
      "source_pages": ["p0300#3"],
      "source_text_sha256": "0231e7ad6728cfd97aca230dc7ca139f78dd8b09b2cf9bc142232dac12246eb3",
      "source_prose": "1000. 证明：当变量取任何值时，下列各式取正值：а) $a^2+4a+11$； б) $\\frac{x^2-2x+7}{19}$；в) $m^2-4m+51$； г) $\\frac{p^2-6p+18}{p^2+1}$。",
      "tasks": [
        {"task_id":"1000-a", "source_label":"а", "kind":"strict_positivity", "variable":"a", "prompt":"a^2+4a+11 > 0 for every real a", "polynomial":[1,4,11], "square_form":{"scale":"1","center":"-2","offset":"7"}, "domain":"R", "strict_positive":true, "lower_bound":"7", "derivation":["a^2+4a+11=(a+2)^2+7 >= 7 > 0 for all real a."]},
        {"task_id":"1000-b", "source_label":"б", "kind":"strict_positivity", "variable":"x", "prompt":"(x^2-2x+7)/19 > 0 for every real x", "polynomial":[1,-2,7], "denominator_polynomial":[0,0,19], "square_form":{"scale":"1","center":"1","offset":"6"}, "domain":"R", "strict_positive":true, "lower_bound":"6/19", "derivation":["Numerator x^2-2x+7=(x-1)^2+6 >= 6 > 0.","Denominator 19 > 0, never zero, so the domain is all R.","Quotient >= 6/19 > 0."]},
        {"task_id":"1000-c", "source_label":"в", "kind":"strict_positivity", "variable":"m", "prompt":"m^2-4m+51 > 0 for every real m", "polynomial":[1,-4,51], "square_form":{"scale":"1","center":"2","offset":"47"}, "domain":"R", "strict_positive":true, "lower_bound":"47", "derivation":["m^2-4m+51=(m-2)^2+47 >= 47 > 0 for all real m."]},
        {"task_id":"1000-d", "source_label":"г", "kind":"strict_positivity", "variable":"p", "prompt":"(p^2-6p+18)/(p^2+1) > 0 for every real p", "polynomial":[1,-6,18], "denominator_polynomial":[1,0,1], "square_form":{"scale":"1","center":"3","offset":"9"}, "denominator_square_form":{"scale":"1","center":"0","offset":"1"}, "domain":"R", "strict_positive":true, "derivation":["Numerator p^2-6p+18=(p-3)^2+9 >= 9 > 0.","Denominator p^2+1 >= 1 > 0, hence nonzero for every real p.","A positive numerator divided by a positive denominator is positive; domain R.","Do not infer a quotient lower bound of 9 from these separate numerator and denominator lower bounds."]}
      ]
    },
    {
      "exercise_id": "alg7-c4-ex1001", "number": "1001", "raw_array_index": 92,
      "source_pages": ["p0300#4"],
      "source_text_sha256": "9eb62f70d62ad4f5ea5e02ac70841265d226ced0c7f932c5efe52d0a9dc3247f",
      "source_prose": "1001. 利用配出一个二项式的平方的方法：а) 证明$x^2-8x+27$的最小值是11；б) 求$a^2-4a+20$的最小值。",
      "tasks": [
        {"task_id":"1001-a", "source_label":"а", "kind":"minimum", "variable":"x", "prompt":"Prove the minimum of x^2-8x+27 is 11", "polynomial":[1,-8,27], "square_form":{"scale":"1","center":"4","offset":"11"}, "minimum":"11", "equality_at":"4", "domain":"R", "derivation":["x^2-8x+27=(x-4)^2+11 >= 11.","Equality holds iff x-4=0, that is x=4.","The lower bound is attained, so the minimum is exactly 11."]},
        {"task_id":"1001-b", "source_label":"б", "kind":"minimum", "variable":"a", "prompt":"Find the minimum of a^2-4a+20", "polynomial":[1,-4,20], "square_form":{"scale":"1","center":"2","offset":"16"}, "minimum":"16", "equality_at":"2", "domain":"R", "derivation":["a^2-4a+20=(a-2)^2+16 >= 16.","Equality holds iff a-2=0, that is a=2.","The minimum is 16, attained at a=2."]}
      ]
    },
    {
      "exercise_id": "alg7-c4-ex1002", "number": "1002", "raw_array_index": 93,
      "source_pages": ["p0300#6"],
      "source_text_sha256": "53db8a9a2d3441025a6ca88418b2f6636bb57d288fa6256e651f53456f5fc9c0",
      "source_prose": "1002. 解下列方程：а) $4x^2+7x+3=0$； б) $x^2+x-90=0$；в) $x^2-x-90=0$； г) $5x^2-18x+16=0$；д) $8x^2+x-75=0$； е) $3x^2-11x-14=0$；ж) $3x^2+11x-34=0$； з) $x^2-x-1=0$。",
      "tasks": [
        {"task_id":"1002-a", "source_label":"а", "kind":"exact_quadratic_roots", "prompt":"4x^2+7x+3=0", "polynomial":[4,7,3], "discriminant":1, "roots":["-1","-3/4"], "derivation":["D=7^2-4*4*3=1", "x=(-7 +/- 1)/8", "x=-1 or x=-3/4"]},
        {"task_id":"1002-b", "source_label":"б", "kind":"exact_quadratic_roots", "prompt":"x^2+x-90=0", "polynomial":[1,1,-90], "discriminant":361, "roots":["-10","9"], "derivation":["D=1+360=361=19^2", "x=(-1 +/- 19)/2", "x=-10 or x=9"]},
        {"task_id":"1002-c", "source_label":"в", "kind":"exact_quadratic_roots", "prompt":"x^2-x-90=0", "polynomial":[1,-1,-90], "discriminant":361, "roots":["-9","10"], "derivation":["D=1+360=361=19^2", "x=(1 +/- 19)/2", "x=-9 or x=10"]},
        {"task_id":"1002-d", "source_label":"г", "kind":"exact_quadratic_roots", "prompt":"5x^2-18x+16=0", "polynomial":[5,-18,16], "discriminant":4, "roots":["8/5","2"], "derivation":["D=324-320=4", "x=(18 +/- 2)/10", "x=8/5 or x=2"]},
        {"task_id":"1002-e", "source_label":"д", "kind":"exact_quadratic_roots", "prompt":"8x^2+x-75=0", "polynomial":[8,1,-75], "discriminant":2401, "roots":["-25/8","3"], "derivation":["D=1+2400=2401=49^2", "x=(-1 +/- 49)/16", "x=-25/8 or x=3"]},
        {"task_id":"1002-f", "source_label":"е", "kind":"exact_quadratic_roots", "prompt":"3x^2-11x-14=0", "polynomial":[3,-11,-14], "discriminant":289, "roots":["-1","14/3"], "derivation":["D=121+168=289=17^2", "x=(11 +/- 17)/6", "x=-1 or x=14/3"]},
