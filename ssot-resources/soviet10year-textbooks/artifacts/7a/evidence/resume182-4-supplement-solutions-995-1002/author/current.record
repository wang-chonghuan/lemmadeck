            "(x+5)^2=64",
            "x+5=+8 or x+5=-8",
            "x=3 or x=-13"
          ],
          "result": {"real_roots": ["-13", "3"]}
        },
        {
          "task_id": "999-d",
          "source_label": "г",
          "modern_label": "d",
          "statement": "x^2-6x-55=0",
          "method": "completing_square",
          "equivalence_chain": [
