      "original_text": "999. 用配方法解下列方程：а) $x^2-16x+48=0$； б) $x^2+12x+27=0$；в) $x^2+10x-39=0$； г) $x^2-6x-55=0$；д) $x^2+7x-18=0$； е) $x^2-11x+28=0$；ж) $2x^2-5x+2=0$； з) $3x^2-x-70=0$。",
      "task_count": 8,
      "tasks": [
        {
          "task_id": "999-a",
          "source_label": "а",
          "modern_label": "a",
          "statement": "x^2-16x+48=0",
          "method": "completing_square",
          "equivalence_chain": [
            "x^2-16x+48=0",
            "x^2-16x=-48",
            "x^2-16x+64=-48+64=16",
            "(x-8)^2=16",
            "x-8=+4 or x-8=-4",
            "x=12 or x=4"
          ],
          "result": {"real_roots": ["4", "12"]}
        },
        {
          "task_id": "999-b",
          "source_label": "б",
          "modern_label": "b",
          "statement": "x^2+12x+27=0",
          "method": "completing_square",
          "equivalence_chain": [
            "x^2+12x+27=0",
            "x^2+12x=-27",
            "x^2+12x+36=-27+36=9",
            "(x+6)^2=9",
            "x+6=+3 or x+6=-3",
            "x=-3 or x=-9"
          ],
          "result": {"real_roots": ["-9", "-3"]}
        },
        {
          "task_id": "999-c",
          "source_label": "в",
          "modern_label": "c",
          "statement": "x^2+10x-39=0",
          "method": "completing_square",
          "equivalence_chain": [
            "x^2+10x-39=0",
            "x^2+10x=39",
