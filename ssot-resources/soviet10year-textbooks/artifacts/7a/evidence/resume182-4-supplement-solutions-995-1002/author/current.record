    {
      "source_number": "1000",
      "modern_number": "1000",
      "group": "第43小节",
      "source_pages": ["p0300#3"],
      "original_text": "1000. 证明：当变量取任何值时，下列各式取正值：а) $a^2+4a+11$； б) $\\frac{x^2-2x+7}{19}$；в) $m^2-4m+51$； г) $\\frac{p^2-6p+18}{p^2+1}$。",
      "task_count": 4,
      "tasks": [
        {
          "task_id": "1000-a",
          "source_label": "а",
          "modern_label": "a",
          "statement": "a^2+4a+11>0 for every real a",
          "domain": "a in R",
          "derivation": [
            "a^2+4a+11=(a+2)^2+7.",
            "For every real a, (a+2)^2>=0.",
            "Therefore a^2+4a+11>=7>0."
          ],
          "result": "Strictly positive for every real a; there is no zero."
        },
        {
          "task_id": "1000-b",
          "source_label": "б",
          "modern_label": "b",
          "statement": "(x^2-2x+7)/19>0 for every real x",
          "domain": "x in R; the constant denominator 19 is nonzero and positive",
          "derivation": [
            "x^2-2x+7=(x-1)^2+6>=6>0.",
            "Since 19>0, division preserves positivity.",
            "(x^2-2x+7)/19=((x-1)^2+6)/19>=6/19>0."
          ],
          "result": "Defined and strictly positive for every real x."
        },
        {
          "task_id": "1000-c",
          "source_label": "в",
          "modern_label": "c",
          "statement": "m^2-4m+51>0 for every real m",
          "domain": "m in R",
          "derivation": [
            "m^2-4m+51=(m-2)^2+47.",
            "For every real m, (m-2)^2>=0.",
            "Therefore m^2-4m+51>=47>0."
          ],
          "result": "Strictly positive for every real m; there is no zero."
        },
        {
          "task_id": "1000-d",
          "source_label": "г",
          "modern_label": "d",
          "statement": "(p^2-6p+18)/(p^2+1)>0 for every real p",
