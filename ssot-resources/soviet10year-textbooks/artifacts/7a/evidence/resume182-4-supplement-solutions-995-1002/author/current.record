            "line_y_intercept": "5",
            "vertical_gap": "x^2-x/2-5=(x+2)(x-5/2)",
            "intersection_derivation": "4(x^2-x/2-5)=(2x)^2-2x-20=(2x-5)(2x+4), so the graphs meet at x=-2 and x=5/2.",
            "intersections": [
              {"x": "-2", "y": "4"},
