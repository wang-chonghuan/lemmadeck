import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

export const cwd = '/Users/yong/.codex/worktrees/stemrobin-182-resume/lemmadeck';
export const root = path.join(cwd, '.tmp/resume182-4-supplement-figure64-affected1');
export const hash = value => crypto.createHash('sha256').update(value).digest('hex');
export const file = p => ({ path: p, sha256: hash(fs.readFileSync(p)) });
export const save = (name, value) => {
  const target = path.join(root, name);
  assert(target.startsWith(root + '/'));
  fs.writeFileSync(target, JSON.stringify(value, null, 2) + '\n', { flag: 'wx' });
};

export function run(name, command, args = [], extraEnv = {}) {
  assert.equal(process.cwd(), cwd);
  assert(/^[a-z0-9-]+$/.test(name));
  const dir = path.join(root, 'commands', name);
  fs.mkdirSync(dir, { recursive: true });
  assert(!fs.existsSync(path.join(dir, 'receipt.json')), 'Never repeat a stage');
  const start = new Date().toISOString();
  const result = spawnSync(command, args, {
    cwd, encoding: 'utf8', maxBuffer: 32 * 1024 * 1024,
    env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1', ...extraEnv },
  });
  const stdout = result.stdout || '';
  const stderr = (result.stderr || '') + (result.error ? result.error.stack + '\n' : '');
  fs.writeFileSync(path.join(dir, 'stdout.txt'), stdout, { flag: 'wx' });
  fs.writeFileSync(path.join(dir, 'stderr.txt'), stderr, { flag: 'wx' });
  const receipt = {
    cwd, argv: [command, ...args], start, end: new Date().toISOString(),
    exit: result.status, signal: result.signal,
    stdout: file(path.join(dir, 'stdout.txt')),
    stderr: file(path.join(dir, 'stderr.txt')),
  };
  fs.writeFileSync(path.join(dir, 'receipt.json'), JSON.stringify(receipt, null, 2) + '\n', { flag: 'wx' });
  process.stdout.write(stdout);
  process.stderr.write(stderr);
  return receipt;
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const [name, command, ...args] = process.argv.slice(2);
  const receipt = run(name, command, args);
  console.log(`RECEIPT ${path.join(root, 'commands', name, 'receipt.json')} exit=${receipt.exit}`);
  process.exitCode = receipt.exit ?? 1;
}
