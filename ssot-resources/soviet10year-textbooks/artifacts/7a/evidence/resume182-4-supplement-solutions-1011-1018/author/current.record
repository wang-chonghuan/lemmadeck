  "exercises": [
    {
      "number": "1011",
      "tasks": [
        {
          "id": "1011-a",
          "label": "a",
          "question": "Find a such that a^2+7a+6 and a+1 are equal, and give each common value.",
          "domain": "a in R",
          "derivation": [
            "a^2+7a+6=a+1 gives a^2+6a+5=0.",
            "(a+1)(a+5)=0, so a=-1 or a=-5."
          ],
          "candidate_checks": [
            "a=-1: (-1)^2+7(-1)+6=0=(-1)+1.",
            "a=-5: (-5)^2+7(-5)+6=-4=(-5)+1."
          ],
          "result": {"variable_common_value_pairs": [["-1", "0"], ["-5", "-4"]]}
        },
        {
          "id": "1011-b",
          "label": "b",
          "question": "Find x such that 3x^2-x+1 and 2x^2+5x-4 are equal, and give each common value.",
          "domain": "x in R",
          "derivation": [
            "3x^2-x+1=2x^2+5x-4 gives x^2-6x+5=0.",
            "(x-1)(x-5)=0, so x=1 or x=5."
          ],
          "candidate_checks": [
            "x=1: 3-1+1=3=2+5-4.",
            "x=5: 75-5+1=71=50+25-4."
          ],
          "result": {"variable_common_value_pairs": [["1", "3"], ["5", "71"]]}
        }
      ]
    },
    {
      "number": "1012",
      "tasks": [
        {
          "id": "1012-a",
          "label": "a",
          "question": "Find all five consecutive integers whose first three squares sum to the sum of the last two squares.",
          "domain": "n in Z; consecutive means n,n+1,n+2,n+3,n+4. Positivity is not stated.",
          "derivation": [
            "n^2+(n+1)^2+(n+2)^2=(n+3)^2+(n+4)^2.",
            "3n^2+6n+5=2n^2+14n+25 gives n^2-8n-20=0.",
            "(n-10)(n+2)=0, so n=10 or n=-2; both are integers."
          ],
          "candidate_checks": [
            "10,11,12,13,14: 100+121+144=365=169+196.",
            "-2,-1,0,1,2: 4+1+0=5=1+4."
          ],
          "result": {"sequences": [["10", "11", "12", "13", "14"], ["-2", "-1", "0", "1", "2"]]}
        },
        {
          "id": "1012-b",
          "label": "b",
          "question": "Find all three consecutive even integers whose first two squares sum to the third square.",
          "domain": "n in 2Z; consecutive even integers are n,n+2,n+4. Positivity is not stated.",
          "derivation": [
            "n^2+(n+2)^2=(n+4)^2.",
            "n^2-4n-12=0 gives (n-6)(n+2)=0.",
            "n=6 or n=-2; both are even integers."
          ],
          "candidate_checks": [
            "6,8,10: 36+64=100.",
            "-2,0,2: 4+0=4."
          ],
          "result": {"sequences": [["6", "8", "10"], ["-2", "0", "2"]]}
        }
      ]
    },
    {
      "number": "1013",
      "tasks": [
        {
          "id": "1013-a",
          "label": "a",
          "question": "Solve (2y+1)^2/8-(4y-1)/5=1.",
          "domain": "y in R",
          "original_denominators": ["8", "5"],
          "excluded_values": [],
          "derivation": [
            "Both original denominators are nonzero constants.",
            "Multiply by 40: 5(2y+1)^2-8(4y-1)=40.",
            "20y^2-12y-27=(2y-3)(10y+9)=0."
          ],
          "candidates": ["3/2", "-9/10"],
          "candidate_checks": [
            "y=3/2: 16/8-5/5=2-1=1.",
            "y=-9/10: (16/25)/8-(-23/5)/5=2/25+23/25=1."
          ],
          "result": {"real_solutions": ["3/2", "-9/10"]}
        },
        {
          "id": "1013-b",
          "label": "b",
          "question": "Solve (y-3)^2/20-(1-y)/2=1.",
          "domain": "y in R",
          "original_denominators": ["20", "2"],
          "excluded_values": [],
          "derivation": [
            "Both original denominators are nonzero constants.",
            "Multiply by 20: (y-3)^2-10(1-y)=20.",
            "y^2+4y-21=(y+7)(y-3)=0."
          ],
          "candidates": ["-7", "3"],
          "candidate_checks": [
            "y=-7: 100/20-8/2=5-4=1.",
            "y=3: 0-(-2)/2=1."
          ],
          "result": {"real_solutions": ["-7", "3"]}
        },
        {
          "id": "1013-c",
          "label": "c",
          "question": "Solve (x+1)/6+26/(x-1)=4.",
          "domain": "x in R except 1",
          "original_denominators": ["6", "x-1"],
          "excluded_values": ["1"],
          "derivation": [
            "For x!=1, multiply by 6(x-1): (x+1)(x-1)+156=24(x-1).",
            "x^2-24x+179=(x-12)^2+35=0.",
            "The discriminant is -140; the polynomial is at least 35 for every real x."
          ],
          "candidates": [],
          "candidate_checks": [
            "There are no real polynomial candidates, so none can satisfy the original equation.",
            "x=1 remains forbidden; no division by x-1 is valid there."
          ],
          "result": {"real_solutions": [], "conclusion": "No real solution."}
        },
        {
          "id": "1013-d",
          "label": "d",
          "question": "Solve (x+15)/4-21/(x-2)=2.",
          "domain": "x in R except 2",
          "original_denominators": ["4", "x-2"],
          "excluded_values": ["2"],
          "derivation": [
            "For x!=2, multiply by 4(x-2): (x+15)(x-2)-84=8(x-2).",
            "P(x)=x^2+5x-98=0; its discriminant is 417.",
            "The two real candidates are (-5+sqrt(417))/2 and (-5-sqrt(417))/2."
          ],
          "candidates": ["(-5+sqrt(417))/2", "(-5-sqrt(417))/2"],
          "candidate_checks": [
            "P(2)=-84, so neither root is the forbidden value 2.",
            "For either r=(-5+s)/2 with s=+sqrt(417) or -sqrt(417), P(r)=(s^2-417)/4=0.",
            "Original LHS minus 2 is P(r)/(4(r-2))=0 for each of the two candidates; hence both satisfy the original equation."
          ],
          "result": {"real_solutions": ["(-5+sqrt(417))/2", "(-5-sqrt(417))/2"]}
        },
        {
          "id": "1013-e",
          "label": "e",
          "question": "Solve 12/(x-1)-8/(x+1)=1.",
          "domain": "x in R except -1,1",
          "original_denominators": ["x-1", "x+1"],
          "excluded_values": ["-1", "1"],
          "derivation": [
            "For x!=-1,1, multiply by (x-1)(x+1): 12(x+1)-8(x-1)=x^2-1.",
            "x^2-4x-21=(x-7)(x+3)=0."
          ],
          "candidates": ["7", "-3"],
          "candidate_checks": [
            "x=7 is admissible: 12/6-8/8=2-1=1.",
            "x=-3 is admissible: 12/(-4)-8/(-2)=-3+4=1."
          ],
          "result": {"real_solutions": ["7", "-3"]}
        },
        {
          "id": "1013-f",
          "label": "f",
          "question": "Solve 16/(x-3)+30/(1-x)=3.",
          "domain": "x in R except 1,3",
          "original_denominators": ["x-3", "1-x"],
          "excluded_values": ["1", "3"],
          "derivation": [
            "30/(1-x)=-30/(x-1); retain the exclusions 1 and 3.",
            "Multiply by (x-3)(x-1): 16(x-1)-30(x-3)=3(x-3)(x-1).",
            "3x^2+2x-65=(3x-13)(x+5)=0."
          ],
          "candidates": ["13/3", "-5"],
          "candidate_checks": [
            "x=13/3 is admissible: 16/(4/3)+30/(-10/3)=12-9=3.",
            "x=-5 is admissible: 16/(-8)+30/6=-2+5=3."
          ],
          "result": {"real_solutions": ["13/3", "-5"]}
        }
      ]
    },
    {
      "number": "1014",
      "tasks": [
        {
          "id": "1014-a",
          "label": "a",
          "question": "Find y such that the sum of 6/(y+1) and y/(y-2) equals their product.",
          "domain": "y in R except -1,2",
          "original_denominators": ["y+1", "y-2"],
          "excluded_values": ["-1", "2"],
          "derivation": [
            "6/(y+1)+y/(y-2)=6y/((y+1)(y-2)).",
            "On the original domain, multiply by (y+1)(y-2): 6(y-2)+y(y+1)=6y.",
            "y^2+y-12=(y+4)(y-3)=0."
          ],
          "candidates": ["-4", "3"],
          "candidate_checks": [
            "y=-4 is admissible: the fractions are -2 and 2/3; both sum and product are -4/3.",
            "y=3 is admissible: the fractions are 3/2 and 3; both sum and product are 9/2."
          ],
          "result": {"real_solutions": ["-4", "3"]}
        },
        {
          "id": "1014-b",
          "label": "b",
          "question": "Find y such that the sum of y/(y-3) and 6/(y+3) equals their product.",
          "domain": "y in R except -3,3",
          "original_denominators": ["y-3", "y+3"],
          "excluded_values": ["-3", "3"],
          "derivation": [
            "On the original domain, multiply the sum=product equation by (y-3)(y+3).",
            "y(y+3)+6(y-3)=6y.",
            "y^2+3y-18=(y+6)(y-3)=0."
          ],
          "candidates": ["-6", "3"],
          "candidate_checks": [
            "Reject y=3 because the original denominator y-3 is zero.",
            "y=-6 is admissible: the fractions are 2/3 and -2; both sum and product are -4/3."
          ],
          "result": {"real_solutions": ["-6"], "rejected_candidates": ["3"]}
        },
        {
          "id": "1014-c",
          "label": "c",
          "question": "Find y such that (y+12)/(y-4) minus y/(y+4) equals their product.",
          "domain": "y in R except -4,4; take the difference in the stated order.",
          "original_denominators": ["y-4", "y+4"],
          "excluded_values": ["-4", "4"],
          "derivation": [
            "On the original domain, multiply by (y-4)(y+4).",
            "(y+12)(y+4)-y(y-4)=y(y+12).",
            "20y+48=y^2+12y gives y^2-8y-48=(y-12)(y+4)=0."
          ],
          "candidates": ["12", "-4"],
          "candidate_checks": [
            "Reject y=-4 because the original denominator y+4 is zero.",
            "y=12 is admissible: the fractions are 3 and 3/4; their difference and product are both 9/4."
          ],
          "result": {"real_solutions": ["12"], "rejected_candidates": ["-4"]}
        }
      ]
    },
    {
