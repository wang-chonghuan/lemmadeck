    {
      "number": "1016",
      "tasks": [
        {
          "id": "1016-a",
          "label": "a",
          "question": "Two cars travel 72 km to the community summer camp. The first is 4 km/h faster and arrives 15 minutes earlier. Find both speeds.",
          "domain": "v>0 is the second car's speed; v+4>0 is the first car's speed.",
          "unit_conversion": "15 min=15/60 h=1/4 h",
          "equation": "72/v-72/(v+4)=1/4",
          "derivation": [
            "The slower second car takes longer; their departure times and distances agree.",
            "288/(v(v+4))=1/4 gives v^2+4v-1152=0.",
            "(v-32)(v+36)=0."
          ],
          "candidates": ["32", "-36"],
          "candidate_checks": [
            "Reject v=-36: the second and first speeds would be -36 and -32 km/h.",
            "For v=32, the speeds 32 and 36 km/h are positive.",
            "The second car takes 72/32=9/4 h; the first takes 72/36=2 h. The difference is 1/4 h=15 min."
          ],
          "result": {"first_car_speed_km_per_h": "36", "second_car_speed_km_per_h": "32"}
        },
        {
          "id": "1016-b",
          "label": "b",
          "question": "A motorcyclist plans 90 km, stops 5 minutes after 45 km, then increases speed by 6 km/h and arrives at the planned time. Find the original speed.",
          "domain": "v>0 is the original speed; v+6>0 after the stop.",
          "unit_conversion": "5 min=5/60 h=1/12 h",
          "equation": "45/v+1/12+45/(v+6)=90/v",
          "derivation": [
            "The two distance segments are 45 km each.",
            "45/v-45/(v+6)=1/12 gives 270/(v(v+6))=1/12.",
            "v^2+6v-3240=(v-54)(v+60)=0."
          ],
          "candidates": ["54", "-60"],
          "candidate_checks": [
            "Reject v=-60: the two speeds would be -60 and -54 km/h.",
            "v=54 and v+6=60 are positive.",
            "45/54+1/12+45/60=5/6+1/12+3/4=5/3 h=90/54; the planned arrival is met."
          ],
          "result": {"original_speed_km_per_h": "54", "increased_speed_km_per_h": "60", "elapsed_time_h": "5/3", "elapsed_time_text": "1 h 40 min"}
        }
      ]
    },
    {
      "number": "1017",
      "tasks": [
        {
          "id": "1017-a",
          "label": "a",
          "question": "A train travels 420 km, stops 15 minutes after 4/7 of the distance, then increases speed by 10 km/h and arrives on time. Find the full journey duration.",
          "domain": "v>0 is the scheduled/original speed; v+10>0 after the stop.",
          "unit_conversion": "15 min=1/4 h",
          "distances_km": {"first": "240", "remaining": "180", "total": "420"},
          "equation": "240/v+1/4+180/(v+10)=420/v",
          "derivation": [
            "420*(4/7)=240 km, leaving 180 km.",
            "180/v-180/(v+10)=1/4 gives 1800/(v(v+10))=1/4.",
            "v^2+10v-7200=(v-80)(v+90)=0."
          ],
          "candidates": ["80", "-90"],
          "candidate_checks": [
            "Reject v=-90: the speeds would be -90 and -80 km/h.",
            "The accepted speeds are 80 and 90 km/h.",
            "240/80+1/4+180/90=3+1/4+2=21/4 h=420/80."
          ],
          "result": {
            "original_speed_km_per_h": "80",
            "increased_speed_km_per_h": "90",
            "full_elapsed_time_h": "21/4",
            "full_elapsed_time_text": "5 h 15 min",
            "moving_only_time_h": "5",
            "duration_convention": "The requested full journey includes the 15-minute stop; 5 h is only moving time."
          }
        },
        {
          "id": "1017-b",
          "label": "b",
          "question": "A motorcyclist travels 180 km from M to N at speed v. On return, the first 2/3 is at v and the last part at v+5 km/h, saving 8 minutes. Find the entire round-trip duration.",
          "domain": "v>0; v+5>0. Both legs have distance 180 km.",
          "unit_conversion": "8 min=8/60 h=2/15 h",
          "distances_km": {"outbound": "180", "return_first": "120", "return_last": "60", "round_trip": "360"},
          "equation": "180/v-(120/v+60/(v+5))=2/15",
          "derivation": [
            "Return first segment: 180*(2/3)=120 km; final segment: 60 km.",
            "60/v-60/(v+5)=2/15 gives 300/(v(v+5))=2/15.",
            "v^2+5v-2250=(v-45)(v+50)=0."
          ],
          "candidates": ["45", "-50"],
          "candidate_checks": [
            "Reject v=-50: the speeds would be -50 and -45 km/h.",
            "The accepted speeds 45 and 50 km/h are positive.",
            "Outbound: 180/45=4 h. Return: 120/45+60/50=8/3+6/5=58/15 h=3 h 52 min.",
            "Saving: 4-58/15=2/15 h=8 min.",
            "Full round trip: 4+58/15=118/15 h=7 h 52 min."
          ],
          "result": {
            "original_speed_km_per_h": "45",
            "increased_speed_km_per_h": "50",
            "outbound_time_h": "4",
            "return_time_h": "58/15",
            "full_round_trip_time_h": "118/15",
            "full_round_trip_time_text": "7 h 52 min"
          }
        }
      ]
    },
    {
      "number": "1018",
      "tasks": [
        {
          "id": "1018-a",
          "label": "a",
          "question": "A train from A to B is half an hour late after 450 km, which is 75% of the route. It increases speed by 15 km/h and arrives on time. Find the original speed.",
          "domain": "v>0; v+15>0. The stated half-hour delay is cumulative lateness, not necessarily a separate stop.",
          "unit_conversion": "Half an hour=30/60 h=1/2 h; 75%=3/4.",
          "distances_km": {"completed": "450", "remaining": "150", "total": "600"},
          "equation": "150/v-150/(v+15)=1/2",
          "derivation": [
            "Total distance=450/(3/4)=600 km; remaining distance=150 km.",
            "Saving half an hour on the remaining 150 km compensates for the stated lateness.",
            "2250/(v(v+15))=1/2 gives v^2+15v-4500=(v-60)(v+75)=0."
          ],
          "candidates": ["60", "-75"],
          "candidate_checks": [
            "Reject v=-75: the speeds would be -75 and -60 km/h.",
            "The accepted speeds are 60 and 75 km/h.",
            "Remaining scheduled time=150/60=5/2 h; actual remaining time=150/75=2 h; saving=1/2 h.",
            "Scheduled full time=600/60=10 h. Elapsed time at 450 km is 450/60+1/2=8 h; then 2 h more gives the same 10 h arrival."
          ],
          "result": {"original_speed_km_per_h": "60", "increased_speed_km_per_h": "75", "scheduled_full_time_h": "10"}
        },
        {
          "id": "1018-b",
          "label": "b",
          "question": "A train is scheduled for 450 km, stops 18 minutes after 40% of the distance, then increases speed by 10 km/h and arrives on time. Find the scheduled speed.",
          "domain": "v>0 is the scheduled speed; v+10>0 after the stop.",
