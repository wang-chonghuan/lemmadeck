      "view": {
        "mode": "single",
        "stem": "函数 $y=\\frac{3x-1}{x+3}$ 分别取 $0$、$5$、$3$ 时，$x$ 的取值集合是什么？哪张表完整正确？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "| $y$ | $x$的集合 |\n|---|---|\n| $0$ | $\\{3\\}$ |\n| $5$ | $\\{-8\\}$ |\n| $3$ | $\\varnothing$ |",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "| $y$ | $x$的集合 |\n|---|---|\n| $0$ | $\\{1/3\\}$ |\n| $5$ | $\\{-2\\}$ |\n| $3$ | $\\varnothing$ |",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "| $y$ | $x$的集合 |\n|---|---|\n| $0$ | $\\{1/3\\}$ |\n| $5$ | $\\{-8\\}$ |\n| $3$ | $\\varnothing$ |",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "| $y$ | $x$的集合 |\n|---|---|\n| $0$ | $\\{1/3\\}$ |\n| $5$ | $\\{-8\\}$ |\n| $3$ | $\\mathbb R\\setminus\\{-3\\}$ |",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "求三个目标函数值的完整原像，识别目标3不可达而不是分母零的特例。",
        "source_solution": "x≠-3。y=0要求3x-1=0得1/3；y=5要求3x-1=5x+15得-8；y=3要求3x-1=3x+9，出现-1=9，所以无解。亦可写y=3-10/(x+3)。",
        "unit_reason": "同一函数的三值原像表为一个规则任务，保留两个可达值和一个不可达值。",
        "concept_blocks": [
          7
        ],
        "limitations": [
          "选择结果表不能证明独立写出三个方程及矛盾推导。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "从3x=1错误反除成x=3/1，可生成3；正确为1/3。",
            "misconception": "把系数与常数的除法方向颠倒。"
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "把5(x+3)错误展开为5x+3，得到3x-1=5x+3、x=-2。",
            "misconception": "乘法只分配到括号的第一项。"
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "依次得到3x=1、-2x=16、-1=9；前两根合法，第三集合空。",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "忽略低次项，把(3x-1)/(x+3)当成3x/x=3，再仅保留x≠-3，会错误认定全部定义域都取得3。",
            "misconception": "用最高次项之比替代整个有理函数的精确值。"
          }
        ]
      }
    },
    {
      "id": "n9-113-sets",
      "source_numbers": [
