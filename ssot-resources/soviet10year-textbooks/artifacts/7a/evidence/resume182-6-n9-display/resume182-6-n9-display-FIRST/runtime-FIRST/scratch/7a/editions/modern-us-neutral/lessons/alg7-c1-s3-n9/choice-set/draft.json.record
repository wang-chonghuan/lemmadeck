  "questions": [
    {
      "id": "n9-109-sets",
      "source_numbers": [
        "109"
      ],
      "view": {
        "mode": "single",
        "stem": "求下列方程在实数范围内的解集合。哪张表的四行都正确？\n\na) $\\frac{2x-5}{x+5}-4=0$；\nb) $2-\\frac{x^2+3}{x^2+1}=0$；\nc) $\\frac{3}{2x-1}-\\frac{4}{x+1}=0$；\nd) $\\frac{x-9}{x-4}+\\frac{x+9}{x+4}=0$。",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "| 方程 | 解集合 |\n|---|---|\n| a | $\\{5/2\\}$ |\n| b | $\\{-1,1\\}$ |\n| c | $\\{7/5\\}$ |\n| d | $\\{-6,6\\}$ |",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "| 方程 | 解集合 |\n|---|---|\n| a | $\\{-25/2\\}$ |\n| b | $\\{-1,1\\}$ |\n| c | $\\{7/5\\}$ |\n| d | $\\{-6,6\\}$ |",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "| 方程 | 解集合 |\n|---|---|\n| a | $\\{-25/2\\}$ |\n| b | $\\{1\\}$ |\n| c | $\\{7/5\\}$ |\n| d | $\\{6\\}$ |",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "| 方程 | 解集合 |\n|---|---|\n| a | $\\{-25/2\\}$ |\n| b | $\\{-1,1\\}$ |\n| c | $\\{7/2\\}$ |\n| d | $\\{-6,6\\}$ |",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "给出四个有理方程的完整解集合，保留双根与分母非零条件。",
        "source_solution": "a排除-5，2x-5=4x+20得-25/2；b分母恒正，x²=1得±1；c排除1/2,-1，3(x+1)=4(2x-1)得7/5；d排除±4，合并分子2x²-72=0得±6。所有根均可代回。",
        "unit_reason": "完整四行解表是一个连贯的有理方程解集合判断，不按四个字母分成找单根的点击；同时保留去分母、双根和域约束。",
        "concept_blocks": [
          7
        ],
        "limitations": [
          "选择完整解表不能检验自行书写去分母与验根过程。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "B"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "其余三行正确，但a若漏掉外面的-4，只解2x-5=0，会得到5/2；原式在此为-4。",
            "misconception": "漏掉整项常数-4，把原方程当作分式等于0。"
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "依次得-2x=25、x²=1、5x=7、2x²=72；排除分母零点后四行恰为完整解集合。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "b由x²=1、d由x²=36；只取正平方根会写出{1}和{6}，但-1与-6也满足各自原式。",
            "misconception": "把解二次等式当作取主平方根，遗漏负根。"
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "c错误同侧相乘得到3(2x-1)=4(x+1)，即2x=7，生成7/2；正确交叉相乘给7/5。",
            "misconception": "把交叉乘法误成各分子的同侧分母相乘。"
          }
        ]
      }
    },
    {
      "id": "n9-110-sets",
      "source_numbers": [
        "110"
      ],
      "view": {
        "mode": "single",
        "stem": "解下列方程。哪张表列出了每个方程的完整实数解集合？\n\na) $\\frac{x^2-4}{x}=\\frac{3+2x}{2}$；\nb) $\\frac{x^2+5}{2x}=\\frac{3x+10}{6}$；\nc) $\\frac{2x^2}{3x-5}=x$；\nd) $\\frac{1+x-6x^2}{3x+1}=x$；\ne) $\\frac{2x+3}{2x-1}=\\frac{x-5}{x+3}$；\nf) $\\frac{1+3x}{1-3x}=\\frac{5-2x}{1+2x}$。",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "| 方程 | 解集合 |\n|---|---|\n| a | $\\{8/3\\}$ |\n| b | $\\{3/2\\}$ |\n| c | $\\{5\\}$ |\n| d | $\\{1/3\\}$ |\n| e | $\\{-1/5\\}$ |\n| f | $\\{2/11\\}$ |",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "| 方程 | 解集合 |\n|---|---|\n| a | $\\{-8/3\\}$ |\n| b | $\\{2/3\\}$ |\n| c | $\\{0,5\\}$ |\n| d | $\\{1/3\\}$ |\n| e | $\\{-1/5\\}$ |\n| f | $\\{11/2\\}$ |",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "| 方程 | 解集合 |\n|---|---|\n| a | $\\{-8/3\\}$ |\n| b | $\\{3/2\\}$ |\n| c | $\\{0,5\\}$ |\n| d | $\\{-1/3,1/3\\}$ |\n| e | $\\{1/5\\}$ |\n| f | $\\{2/11\\}$ |",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "| 方程 | 解集合 |\n|---|---|\n| a | $\\{-8/3\\}$ |\n| b | $\\{3/2\\}$ |\n| c | $\\{0,5\\}$ |\n| d | $\\{1/3\\}$ |\n| e | $\\{-1/5\\}$ |\n| f | $\\{2/11\\}$ |",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "完整解六个有理方程，特别区分合法零根与分母零的伪根。",
        "source_solution": "a x≠0，-8=3x得-8/3；b x≠0，15=10x得3/2；c x≠5/3，x(x-5)=0得0,5；d x≠-1/3，9x²=1只留1/3；e x≠1/2,-3，20x=-4得-1/5；f x≠1/3,-1/2，22x=4得2/11。",
        "unit_reason": "完整六行结果表保留同组去分母的不同数学边界，尤其零根保留和伪根排除；不把每个代数步骤做成独立题。",
        "concept_blocks": [
          7
        ],
        "limitations": [
          "选择表不能证明自行展开交叉乘积和验根的书写能力。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "D"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "a把-8=3x的负号丢失得到8/3；c先除以x会只剩2x=3x-5得5，却漏掉原式合法的x=0。",
            "misconception": "丢失常数负号，并在未知量可能为零时直接除以未知量。"
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "b的10x=15应得15/10=3/2，反除生成2/3；f的22x=4应得4/22=2/11，反除生成11/2。",
            "misconception": "解Ax=B时把B/A颠倒成A/B。"
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "d的-1/3使3x+1=0，不能保留；e由20x=-4应得-1/5，丢去负号得到1/5。",
            "misconception": "不检查原分母限制，并把负常数商错写为正数。"
          },
          {
            "option_id": "D",
            "truth": "correct",
            "derivation": "六式化为-8=3x、15=10x、x(x-5)=0、9x²=1、20x=-4、22x=4；分别在原定义域筛选后恰为这六行。",
            "misconception": null
          }
        ]
      }
    },
    {
      "id": "n9-111-equality",
      "source_numbers": [
        "111"
      ],
      "view": {
        "mode": "single",
        "stem": "在两个表达式都定义的条件下，分别求使它们值相等的 $y$：\n\na) $\\frac{1}{10y-1}$ 与 $\\frac{1}{2-5y}$；\nb) $\\frac{3}{8-5y}$ 与 $\\frac{5}{7y-2}$。\n\n哪一组依次给出 a、b 的全部解？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "a：$y=1/5$；b：$y=1$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "a：$y=1/15$；b：$y=1$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "a：$y=1/5$；b：$y=17/23$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "a：$y=1/5$；b：$y=5/6$。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "在共同定义域内分别解两个分式值相等的条件。",
        "source_solution": "a排除1/10,2/5，10y-1=2-5y得15y=3，即1/5；b排除8/5,2/7，21y-6=40-25y得46y=46，即1。两值合法且都是各自唯一解。",
        "unit_reason": "一个完整解对同时体现同分子与不同分子两种相等条件，作为共同的公式值相等任务。",
        "concept_blocks": [
          7
        ],
        "limitations": [
          "不检验自行写出交叉相乘和共同定义域。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "A"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "a解15y=3，b解46y=46；两组分母均非零。",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "a把10y-1=2-5y的移项写成15y=2-1，得到1/15，而不是15y=2+1。",
            "misconception": "移项常数-1时未改变符号。"
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "b把21y-6=40-25y写成46y=40-6，得到34/46=17/23。",
            "misconception": "移项-6仍作减6。"
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "b若把不同分子3和5当成相同，直接令8-5y=7y-2，可得12y=10，即5/6；此时原两个分式值不等。",
            "misconception": "不同分子的分数相等也被错误简化为分母相等。"
          }
        ]
      }
    },
    {
