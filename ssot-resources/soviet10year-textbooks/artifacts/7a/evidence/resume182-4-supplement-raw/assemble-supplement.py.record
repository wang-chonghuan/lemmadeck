import hashlib
import json
import sys
from pathlib import Path

REPO = Path("/Users/yong/.codex/worktrees/stemrobin-182-resume/lemmadeck")
assert Path.cwd() == REPO
TOOLS = REPO / ".claude/skills/ld-s10y-lesson/tools"
sys.path.insert(0, str(TOOLS))

import assemble
import blocks

BOOK = Path("ssot-resources/soviet10year-textbooks/artifacts/7a")
TOC = Path("ssot-resources/soviet10year-textbooks/toc/7a/zh.json")
PROFILE = TOOLS.parent / "profiles/soviet-cn.json"
OUTPUT = Path(".tmp/resume182-4-supplement-raw/artifacts/7a")
CARD = "alg7-c4-ex"
ATTEMPT = sys.argv[1] if len(sys.argv) > 1 else "FIRST"
assert ATTEMPT in ("FIRST", "RECOVERY1")


def dump(filename, document):
    filename.parent.mkdir(parents=True, exist_ok=True)
    with filename.open("x", encoding="utf-8") as handle:
        json.dump(document, handle, ensure_ascii=False, indent=2)
        handle.write("\n")


bindings = []
for page in range(281, 315):
    directory = BOOK / "pages" / f"{page:04d}"
    audit = json.loads((directory / "audit.json").read_text())
    assert audit["errors"] == [], f"Unresolved source audit: {page}"
    bindings.append({
        "physical_page": page,
        "files": [
            {"path": str(directory / name),
             "sha256": hashlib.sha256((directory / name).read_bytes()).hexdigest()}
            for name in ("page.md", "page.json", "audit.json")
        ],
    })
stream = assemble.load_stream(BOOK)
start = next(index for index, item in enumerate(stream)
             if item["kind"] == "h3" and item["page"] == 281
             and blocks.text_of(item) == "第四章补充习题")
context = {}
for item in stream[:start]:
    if item["kind"] in ("h1", "h2"):
        context[item["kind"]] = item
        if item["kind"] == "h1":
            context.pop("h2", None)
selected = list(context.values()) + [
    item for item in stream[start:] if 281 <= item["page"] <= 314
]
merged, merge_warnings = assemble.merge_across_pages(selected)
lessons = assemble.cut_lessons(merged)
assert len(lessons) == 1
lesson = lessons[0]
lesson["prose"], lesson["exercises"] = assemble.split_lesson(lesson, "book")
figure_errors, figure_warnings = assemble.claim_figures(lessons, merged)
report = assemble.audit(lessons, merged, PROFILE, "book")
report["errors"] = figure_errors + report["errors"]
report["warnings"] = merge_warnings + figure_warnings + report["warnings"]
report["warnings"] += assemble.check_toc(
    lessons, TOC, "7a",
    {item["printed_page"] for item in selected
     if 281 <= item["page"] <= 314 and item["printed_page"] is not None},
)
assert lesson.get("card_id") == CARD
dump(OUTPUT / f"assembly-{ATTEMPT}.record", {
    "scope": "Only the raw fourth-chapter supplement; no modern/math/choice/display approval.",
    "source_bindings": bindings,
    "context_refs": [item["ref"] for item in context.values()],
    "report": report,
    "exercise_numbers": [item["number"] for item in lesson["exercises"]],
})
print(json.dumps(report, ensure_ascii=False))
if report["errors"] or report["warnings"]:
    sys.exit(1)
assert report["exercise_range"] == [909, 1061]
assert report["exercise_count"] == 153
assert report["figure_numbers"] == [62, 63, 64, 65, 66]
assert [int(item["number"]) for item in lesson["exercises"]] == list(range(909, 1062))
assert len(lesson["figures"]) == 6
directory = OUTPUT / "lessons" / CARD
dump(directory / "exercises.json", {
    "lesson": CARD, "count": len(lesson["exercises"]), "exercises": lesson["exercises"],
})
dump(directory / "lesson.json", {
    "id": CARD, "card_id": CARD, "chapter": lesson["chapter"], "section": lesson["section"],
    "number": lesson["number"], "title": lesson["title"],
    "printed_title": lesson["printed_title"], "start_page": lesson["start_page"],
    "start_printed": lesson["start_printed"], "figures": lesson["figures"],
    "exercise_count": len(lesson["exercises"]),
    "prose": [
        {"kind": item["kind"], "text": blocks.text_of(item), "id": item.get("id"),
         "label": item.get("label"), "printed_page": item.get("printed_page"),
         "source_refs": item.get("spans") or [item["ref"]]}
        for item in lesson["prose"]
    ],
})
assert lesson["prose"] == []
head = " · ".join(item for item in (lesson["chapter"], lesson["section"]) if item)
with (directory / "lesson.md").open("x", encoding="utf-8") as handle:
    handle.write(f"# {lesson['printed_title'] or lesson['title']}\n\n")
    if head:
        handle.write(f"> {head}\n")
print(json.dumps({"status": "PASS", "card": CARD, "exercises": 153, "figures": 6}))
