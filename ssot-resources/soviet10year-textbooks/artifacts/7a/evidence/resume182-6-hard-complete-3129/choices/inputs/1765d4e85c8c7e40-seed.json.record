  },
  "exercises": [
    {
      "number": "1070",
      "text": "1070. \u6709 $6$ \u628a\u9501\u548c $6$ \u4e2a\u94a5\u5319\uff0c\u901a\u8fc7\u51e0\u6b21\u5c1d\u8bd5\u5c31\u80fd\u5efa\u7acb\u94a5\u5319\u548c\u9501\u4e4b\u95f4\u7684\u5bf9\u5e94\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "1071",
      "text": "1071. \u6709\u56db\u4e2a\u8d28\u91cf\u4e0d\u540c\u7684\u5c0f\u7403\u3002\u5728\u6ca1\u6709\u781d\u7801\u7684\u6760\u6746\u5f0f\u5929\u5e73\u4e0a\u79e4\u91cf\u51e0\u6b21\uff0c\u5c31\u80fd\u6309\u7167\u8d28\u91cf\u9012\u51cf\u7684\u987a\u5e8f\u628a\u8fd9\u4e9b\u5c0f\u7403\u6392\u5217\u8d77\u6765\u3002",
      "figure_ids": []
    },
    {
      "number": "1072",
      "text": "1072. Alex\u3001Sam \u548c Ben \u4e09\u4e2a\u5b66\u751f\uff0c\u8003\u8bd5\u4e00\u7ed3\u675f\u5c31\u544a\u8bc9\u5bb6\u91cc\uff1aAlex\uff1a\u201c\u6211\u4f1a\u5f97 $5$ \u5206\u3002\u201dSam\uff1a\u201c\u6211\u4f1a\u5f97 $3$ \u5206\u3002\u201dBen\uff1a\u201c\u6211\u4e0d\u4f1a\u5f97 $5$ \u5206\u3002\u201d\u5224\u5377\u4ee5\u540e\uff0c\u4e00\u4e2a\u5b66\u751f\u5f97 $3$ \u5206\uff0c\u4e00\u4e2a\u5f97 $4$ \u5206\uff0c\u4e00\u4e2a\u5f97 $5$ \u5206\u3002\u5982\u679c\u4e09\u4e2a\u5b66\u751f\u4e2d\u53ea\u6709\u4e00\u4eba\u9884\u5148\u4f30\u8ba1\u9519\u4e86\uff0c\u53e6\u4e24\u4eba\u4f30\u8ba1\u90fd\u5bf9\u4e86\uff0c\u4f60\u80fd\u8bf4\u51fa\u6bcf\u4eba\u5f97\u7684\u5206\u6570\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "1073",
      "text": "1073. \u4e24\u4e2a\u4eba\u73a9\u6e38\u620f\uff1a\u7b2c\u4e00\u4eba\u8bf4\u51fa\u4ece $1$ \u5230 $10$ \u4ee5\u5185\u7684\u4efb\u4f55\u4e00\u4e2a\u6570\uff0c\u7b2c\u4e8c\u4eba\u6697\u81ea\u5730\u628a\u8fd9\u4e2a\u6570\u518d\u52a0\u4e0a\u524d\u5341\u4e2a\u6570\u4e2d\u7684\u4efb\u4f55\u4e00\u4e2a\u6570\uff0c\u5e76\u4e14\u8bf4\u51fa\u548c\u6570\u3002\u7b2c\u4e00\u4eba\u518d\u628a\u8fd9\u4e2a\u548c\u6570\u52a0\u4e0a\u524d\u5341\u4e2a\u6570\u4e2d\u7684\u4efb\u4f55\u4e00\u4e2a\u6570\uff0c\u53c8\u8bf4\u51fa\u548c\u6570\u7b49\u7b49\u3002\u8bf4\u51fa $100$ \u8fd9\u4e2a\u6570\u7684\u4eba\u5f97\u80dc\u3002\u5e94\u5f53\u600e\u6837\u73a9\u624d\u80fd\u5f97\u80dc\uff1f\u5728\u6e38\u620f\u6b63\u786e\u8fdb\u884c\u7684\u60c5\u51b5\u4e0b\uff0c\u662f\u5148\u8bf4\u7684\u4eba\u5f97\u80dc\u8fd8\u662f\u4ed6\u7684\u5bf9\u624b\u5f97\u80dc\uff1f",
      "figure_ids": []
    },
    {
      "number": "1074",
      "text": "1074. \u5728\u8c61\u68cb\u76d8\u7684\u5de6\u4e0b\u89d2\u6709\u4e00\u4e2a\u68cb\u5b50\uff0c\u5141\u8bb8\u5b83\u5728\u4e09\u4e2a\u76f8\u90bb\u65b9\u5411\u4e2d\u7684\u4e00\u4e2a\u65b9\u9762\u79fb\u52a8\u4e00\u6b65\uff1a\u5411\u53f3\u3001\u5411\u4e0a\u6216\u6cbf\u5bf9\u89d2\u7ebf\u5411\u53f3\u4e0a\u65b9\u3002\u4e24\u4e2a\u4e0b\u68cb\u7684\u4eba\u5f53\u4e2d\u5360\u636e\u53f3\u4e0a\u89d2\u7684\u4eba\u5f97\u80dc\uff08\u4e24\u4eba\u8f6e\u6d41\u8d70\u6b65\uff09\u3002\u5728\u6e38\u620f\u6b63\u786e\u8fdb\u884c\u7684\u60c5\u51b5\u4e0b\uff0c\u662f\u5148\u5f00\u59cb\u8d70\u7684\u4eba\u5f97\u80dc\u8fd8\u662f\u4ed6\u7684\u5bf9\u624b\u5f97\u80dc\uff1f",
      "figure_ids": []
    },
    {
      "number": "1078",
      "text": "1078. \u53c2\u52a0\u8c61\u68cb\u6bd4\u8d5b\u7684\u90fd\u662f\u4e00\u7ea7\u9009\u624b\u548c\u540d\u624b\uff0c\u591a\u4e8e $9$ \u4e2a\u4f46\u5c11\u4e8e $25$ \u4e2a\u3002\u6839\u636e\u6bd4\u8d5b\u7ed3\u679c\u8bf4\u660e\uff0c\u6bcf\u4e00\u4e2a\u53c2\u52a0\u8005\u5bf9\u4e00\u7ea7\u9009\u624b\u8d62\u5f97\u4e86\u81ea\u5df1\u5f97\u5206\u7684\u4e00\u534a\u3002\u6709\u591a\u5c11\u4eba\u53c2\u52a0\u6bd4\u8d5b\uff1f\u4ed6\u4eec\u5f53\u4e2d\u6709\u51e0\u4e2a\u662f\u8c61\u68cb\u540d\u624b\uff1f",
      "figure_ids": []
    },
    {
      "number": "1086",
      "text": "1086. \u628a\u8868\u793a\u5f0f $x^8+x^4-1$ \u5206\u89e3\u6210 $4$ \u4e2a\u56e0\u5f0f\uff0c\u4f7f\u5176\u4e2d\u6bcf\u4e00\u4e2a\u56e0\u5f0f\u90fd\u542b\u6709\u53d8\u91cf\u3002",
      "figure_ids": []
    },
    {
      "number": "1088",
      "text": "1088. $a$ \u662f\u4ec0\u4e48\u6570\u65f6\uff0c\u65b9\u7a0b $x^2+(a-1)x-2a=0$ \u7684\u6839\u7684\u5e73\u65b9\u548c\u7b49\u4e8e $9$\uff1f",
      "figure_ids": []
    }
  ],
