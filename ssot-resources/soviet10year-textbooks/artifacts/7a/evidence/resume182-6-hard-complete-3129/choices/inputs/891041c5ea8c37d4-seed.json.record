    "book": "7a",
    "lesson": "alg7-hard",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1095",
      "text": "1095. \u65c5\u884c\u8005\u4ee5 $4$ \u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u4ece $A$ \u5230 $B$\u3002\u8fc7\u4e86 $1$ \u5c0f\u65f6\u4ee5\u540e\uff0c\u7b2c\u4e8c\u4e2a\u65c5\u884c\u8005\u4ee5\u6bcf\u5c0f\u65f6\u8d70 $5$ \u516c\u91cc\u7684\u901f\u5ea6\u4ece $A$ \u51fa\u53d1\u5230 $B$\u3002\u518d\u7ecf\u8fc7 $1$ \u5c0f\u65f6\u4ee5\u540e\uff0c\u4e00\u4eba\u9a91\u81ea\u884c\u8f66\u4ece $A$ \u51fa\u53d1\uff0c\u4ed6\u8d85\u8fc7\u4e00\u4e2a\u65c5\u884c\u8005\u4ee5\u540e\uff0c\u7ecf\u8fc7 $10$ \u5206\u949f\u53c8\u8d85\u8fc7\u53e6\u4e00\u4e2a\u65c5\u884c\u8005\u3002\u6c42\u9a91\u81ea\u884c\u8f66\u7684\u4eba\u7684\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "1096",
      "text": "1096. \u5728\u8ddd\u79bb\u4e3a $10000$ \u7c73\u7684\u901f\u5ea6\u6ed1\u51b0\u8bad\u7ec3\u4e2d\uff0c\u4e24\u4e2a\u8fd0\u52a8\u5458\u540c\u65f6\u51fa\u53d1\uff0c\u7b2c\u4e00\u4eba\u7684\u901f\u5ea6\u6bd4\u7b2c\u4e8c\u4eba\u7684\u901f\u5ea6\u5feb $\\frac{1}{3}$ \u7c73/\u79d2\uff0c\u4ed6\u6ed1\u6bcf\u4e00\u5708\u6bd4\u7b2c\u4e8c\u4eba\u5feb $2$ \u79d2\uff0c\u7ecf\u8fc7 $10$ \u5206\u949f\u4ee5\u540e\uff0c\u4ed6\u8d85\u8fc7\u7b2c\u4e8c\u4eba\u534a\u5708\u3002\u6c42\u4e24\u4e2a\u8fd0\u52a8\u5458\u7684\u901f\u5ea6\uff0c\u5e76\u6c42\u5176\u4e2d\u6bcf\u4e00\u4e2a\u4eba\u6ed1\u5b8c\u6574\u4e2a\u8ddd\u79bb\u6240\u7528\u7684\u65f6\u95f4\u3002",
      "figure_ids": []
    },
    {
      "number": "1097",
      "text": "1097. \u9a91\u81ea\u884c\u8f66\u7684\u4eba\u548c\u6469\u6258\u8f66\u624b\u6cbf\u7740\u4e24\u6761\u4e92\u76f8\u5782\u76f4\u7684\u9053\u8def\u671d\u4ea4\u53c9\u8def\u53e3\u7684\u65b9\u5411\u884c\u9a76\u3002\u5728\u67d0\u4e00\u65f6\u523b\uff0c\u9a91\u81ea\u884c\u8f66\u7684\u4eba\u79bb\u4ea4\u53c9\u8def\u53e3\u7684\u8ddd\u79bb\u662f $8$ \u516c\u91cc\uff0c\u800c\u6469\u6258\u8f66\u624b\u79bb\u4ea4\u53c9\u8def\u53e3\u7684\u8ddd\u79bb\u662f $15$ \u516c\u91cc\u3002\u5982\u679c\u9a91\u81ea\u884c\u8f66\u7684\u4eba\u7684\u901f\u5ea6\u662f $\\frac{1}{3}$ \u516c\u91cc/\u5206\uff0c\u800c\u6469\u6258\u8f66\u624b\u7684\u901f\u5ea6\u662f $1$ \u516c\u91cc/\u5206\uff0c\u7ecf\u8fc7\u51e0\u5206\u949f\u4ee5\u540e\uff0c\u4ed6\u4eec\u4e4b\u95f4\u7684\u8ddd\u79bb\u5c06\u7b49\u4e8e $5$ \u516c\u91cc\u3002",
      "figure_ids": []
    },
    {
      "number": "1098",
      "text": "1098. \u4e24\u4e2a\u65c5\u884c\u8005\u5206\u522b\u540c\u65f6\u4ece\u4e24\u4e2a\u5c45\u6c11\u70b9 $A$ \u548c $B$ \u51fa\u53d1\uff0c\u76f8\u5411\u800c\u884c\u3002\u76f8\u9047\u65f6\uff0c\u4ece $A$ \u51fa\u53d1\u7684\u65c5\u884c\u8005\u6bd4\u7b2c\u4e8c\u4e2a\u65c5\u884c\u8005\u591a\u8d70$2$ \u516c\u91cc\u3002\u76f8\u9047\u4ee5\u540e\uff0c\u4ed6\u4eec\u4ee5\u540c\u6837\u7684\u901f\u5ea6\u7ee7\u7eed\u524d\u8fdb\uff0c\u7b2c\u4e00\u4e2a\u65c5\u884c\u8005\u7ecf\u8fc7 $1$ \u5c0f\u65f6 $36$ \u5206\u5230\u8fbe $B$\uff0c\u800c\u7b2c\u4e8c\u4e2a\u65c5\u884c\u8005\u7ecf\u8fc7 $2$\u5c0f\u65f6 $30$ \u5206\u5230\u8fbe $A$\u3002\u6c42 $AB$ \u4e4b\u95f4\u7684\u8ddd\u79bb\u548c\u6bcf\u4e00\u4e2a\u65c5\u884c\u8005\u7684\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "1099",
      "text": "1099. \u4e24\u4eba\u5206\u522b\u540c\u65f6\u4ece $A$ \u5730\u548c $B$ \u5730\u6b65\u884c\u51fa\u53d1\uff0c\u76f8\u5411\u800c\u884c\uff0c\u7ecf\u8fc7 $2$ \u5c0f\u65f6\u540e\u76f8\u9047\u3002\u5982\u679c\u4ece $A$ \u5730\u51fa\u53d1\u7684\u7b2c\u4e00\u4eba\u5230\u8fbe $B$ \u5730\u6bd4\u7b2c\u4e8c\u4eba\u5230\u8fbe $A$ \u5730\u8fdf $1$ \u5c0f\u65f6 $40$ \u5206\u949f\uff0c\u6bcf\u4e00\u4e2a\u65c5\u884c\u8005\u5728\u8def\u7a0b$AB$ \u4e0a\u8981\u7528\u591a\u5c11\u65f6\u95f4\uff1f",
      "figure_ids": []
    },
    {
      "number": "1100",
      "text": "1100. \u6728\u6392\u4ece\u7801\u5934 $N$ \u5f00\u51fa\uff0c\u6cbf\u6cb3\u987a\u6d41\u800c\u4e0b\u3002\u7ecf\u8fc7 $3$ \u5c0f\u65f6\u4ee5\u540e\uff0c\u8f6e\u8239\u4ece\u8ddd\u79bb $N$ $60$ \u516c\u91cc\u7684\u7801\u5934 $M$ \u5f00\u51fa\uff0c\u9006\u6d41\u800c\u4e0a\uff0c\u5b83\u548c\u6728\u6392\u76f8\u9047\u540e\u7ecf\u8fc7 $1$ \u5c0f\u65f6\u5230\u8fbe $N$\u3002\u5df2\u77e5\u8f6e\u8239\u5728\u9759\u6c34\u91cc\u7684\u901f\u5ea6\u7b49\u4e8e $24$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u6c42\u6cb3\u6c34\u7684\u6d41\u901f\u3002",
      "figure_ids": []
    },
    {
      "number": "1101",
      "text": "1101. \u5de5\u4eba\u5e08\u5085\u548c\u4ed6\u7684\u5b66\u5f92\u5e94\u5f53\u5728\u89c4\u5b9a\u671f\u9650\u5185\u5b8c\u6210\u4e00\u9879\u4efb\u52a1\u3002\u4f46\u662f\uff0c\u5f53\u4ea7\u54c1\u5b8c\u6210\u4e00\u534a\u65f6\uff0c\u5b66\u5f92\u751f\u75c5\u4e86\uff0c\u5269\u4e0b\u5e08\u5085\u4e00\u4eba\u5de5\u4f5c\uff0c\u7ed3\u679c\u5b8c\u6210\u4efb\u52a1\u665a\u4e86\u4e24\u5929\u3002\u5047\u8bbe\u4e00\u4eba\u5355\u72ec\u5de5\u4f5c\uff0c\u5e08\u5085\u6bd4\u5b66\u5f92\u8981\u5c11\u7528 $5$ \u5929\u3002\u4ed6\u4eec\u6bcf\u4e00\u4e2a\u4eba\u7528\u51e0\u5929\u53ef\u4ee5\u5b8c\u6210\u5168\u90e8\u4efb\u52a1\u3002",
      "figure_ids": []
    },
    {
      "number": "1102",
      "text": "1102. \u65c5\u884c\u8005\u4ece $A$ \u5230 $B$\uff0c\u4ee5 $v_1$ \u7684\u901f\u5ea6\u8d70\u5b8c\u4e00\u534a\u8def\u7a0b\uff0c\u800c\u4ee5 $v_2$\uff08$v_1\\ne v_2$\uff09\u7684\u901f\u5ea6\u8d70\u5b8c\u53e6\u4e00\u534a\u8def\u7a0b\u3002\u8fd4\u56de\u65f6\uff0c\u5728\u7528\u4e8e\u8fd4\u56de\u7684\u8def\u7a0b\u4e0a\u5168\u90e8\u65f6\u95f4\u7684\u4e00\u534a\u65f6\u95f4\u5185\uff0c\u4ed6\u4ee5 $v_1$ \u7684\u901f\u5ea6\u884c\u8d70\uff0c\u800c\u5728\u53e6\u4e00\u534a\u65f6\u95f4\u5185\uff0c\u4ed6\u4ee5 $v_2$ \u7684\u901f\u5ea6\u884c\u8d70\u3002\u65c5\u884c\u8005\u4ece $A$ \u5230 $B$ \u8fd8\u662f\u4ece $B$ \u5230 $A$ \u6240\u7528\u7684\u65f6\u95f4\u591a\uff1f",
      "figure_ids": []
    }
  ],
