  "exercises": [
    {
      "number": "1085",
      "text": "1085. \u5df2\u77e5\u65b9\u7a0b $(x+y\\sqrt{2})(x-y\\sqrt{2})=1$ \u7684\u89e3\u662f\uff1a $x=3$\uff0c$y=2$\u3002\u8bc1\u660e\u5b58\u5728\u4efb\u610f\u591a\u4e2a\u6ee1\u8db3\u8fd9\u4e2a\u65b9\u7a0b\u7684\u5176\u5b83\u81ea\u7136\u6570\u5bf9\u3002",
      "figure_ids": []
    },
    {
      "number": "1087",
      "text": "1087. \u65b9\u7a0b $x^2+px+1=0$ \u7684\u6839\u7684\u5e73\u65b9\u548c\u7b49\u4e8e $254$\u3002\u6c42\u7cfb\u6570$P$\u3002",
      "figure_ids": []
    },
    {
      "number": "1089",
      "text": "1089. \u8bc1\u660e\uff1a\u5728\u5468\u957f\u4e00\u5b9a\u7684\u6240\u6709\u77e9\u5f62\u5f53\u4e2d\uff0c\u6b63\u65b9\u5f62\u5177\u6709\u6700\u5927\u7684\u9762\u79ef\u3002",
      "figure_ids": []
    },
    {
      "number": "1090",
      "text": "1030. \u8bc1\u660e\uff1a\u5f53\u7528 $30$ \u53bb\u9664\u8d28\u6570\u65f6\uff0c\u5728\u4f59\u6570\u91cc\u5f97\u5230\u8d28\u6570\u6216 $1$\u3002",
      "figure_ids": []
    },
    {
      "number": "1091",
      "text": "1091. \u6c7d\u8247\u987a\u6d41\u884c\u9a76\uff0c\u4ece\u7801\u5934 $A$ \u5230 $B$ \u9700\u7528 $8$ \u5c0f\u65f6\uff0c\u800c\u4ece $B$ \u5230$A$ \u9006\u6d41\u884c\u9a76\u9700\u7528 $10$ \u5c0f\u65f6\u3002\u4e58\u5750\u6728\u6392\u4ece $A$ \u5230 $B$ \u9700\u8981\u591a\u5c11\u5c0f\u65f6\uff1f",
      "figure_ids": []
    },
    {
      "number": "1092",
      "text": "1092. \u4e00\u79cd\u5408\u91d1\u7531\u950c\u548c\u94dc\u7ec4\u6210\uff0c\u5176\u4e2d\u542b\u950c\u548c\u94dc\u7684\u6bd4\u4f8b\u4e3a $1:2$\uff1b\u53e6\u4e00\u79cd\u542b\u540c\u6837\u91d1\u5c5e\u5143\u7d20\u7684\u5408\u91d1\uff0c\u6bd4\u4f8b\u4e3a $2:3$\u3002\u8fd9\u4e24\u79cd\u5408\u91d1\u5404\u7528\u51e0\u4efd\u53ef\u4ee5\u5f97\u5230\u542b\u540c\u6837\u91d1\u5c5e\u5143\u7d20\u3001\u6bd4\u4f8b\u4e3a $17:27$ \u7684\u7b2c\u4e09\u79cd\u5408\u91d1\uff1f",
      "figure_ids": []
    },
    {
      "number": "1093",
      "text": "1093. \u4e24\u4e2a\u6469\u6258\u8f66\u624b\u5206\u522b\u4ece $A$ \u5730\u548c $B$ \u5730\u540c\u65f6\u51fa\u53d1\uff0c\u76f8\u5411\u800c\u884c\uff0c\u5e76\u4e14\u5728\u79bb $B$ \u5730 $50$ \u516c\u91cc\u5904\u76f8\u9047\u3002\u6469\u6258\u8f66\u624b\u5206\u522b\u5230\u8fbe $A$\u5730\u548c $B$ \u5730\u540e\uff0c\u9a6c\u4e0a\u6389\u8f6c\u56de\u6765\u518d\u5728\u79bb $A$ \u5730 $25$ \u516c\u91cc\u5904\u76f8\u9047\u3002$A$ \u5730\u548c $B$ \u5730\u4e4b\u95f4\u7684\u8ddd\u79bb\u662f\u591a\u5c11\u516c\u91cc\uff1f",
      "figure_ids": []
    },
    {
      "number": "1094",
      "text": "1094. \u65c5\u884c\u8005\u4ee5\u6bcf\u5c0f\u65f6\u8d70 $5$ \u516c\u91cc\u7684\u901f\u5ea6\u4ece $M$ \u5230 $N$\uff0c\u5b83\u4eec\u4e4b\u95f4\u7684\u8ddd\u79bb\u662f $41$ \u516c\u91cc\u3002\u7ecf\u8fc7 $2$ \u5c0f\u65f6\u4ee5\u540e\uff0c\u4e00\u4eba\u9a91\u9a6c\u4ece $M$ \u51fa\u53d1\u5411 $N$ \u884c\u8fdb\uff0c\u4ed6\u8d85\u8fc7\u65c5\u884c\u8005\u540e\u5230\u8fbe $N$\uff0c\u7136\u540e\u9a6c\u4e0a\u8fd4\u56de\u3002\u5982\u679c\u9a91\u9a6c\u7684\u4eba\u8d85\u8fc7\u65c5\u884c\u8005\u540e\u7ecf\u8fc7 $2$ \u5c0f\u65f6 $45$ \u5206\u949f\u548c\u65c5\u884c\u8005\u76f8\u9047\uff0c\u6c42\u9a91\u9a6c\u7684\u4eba\u7684\u884c\u8d70\u901f\u5ea6\u3002",
      "figure_ids": []
    }
  ],
