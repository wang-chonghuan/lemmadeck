  "exercises": [
    {
      "number": "1062",
      "text": "1062. \u8bc1\u660e\uff1a\u4e3a\u4e86\u6c42\u51fa\u4e2a\u4f4d\u6570\u4e3a $5$\u3001\u5341\u4f4d\u6570\u4e3a $n$ \u7684\u4e24\u4f4d\u6570\u7684\u5e73\u65b9\uff0c\u53ea\u8981\u628a\u5341\u4f4d\u6570 $n$ \u4e58\u4e0a $n+1$ \u5e76\u5728\u7ed3\u679c\u540e\u9762\u6dfb\u5199 $25$ \u5c31\u884c\u4e86\u3002",
      "figure_ids": []
    },
    {
      "number": "1063",
      "text": "1063. \u4e00\u4e2a\u4e24\u4f4d\u6570\u7684\u5e73\u65b9\u53ef\u4ee5\u7528\u6570\u5b57 $0$\uff0c$2$\uff0c$3$\uff0c\u548c $5$ \u5217\u51fa\uff0c\u6c42\u8fd9\u4e2a\u4e24\u4f4d\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "1064",
      "text": "1064. \u4e00\u4e2a\u4e24\u4f4d\u6570\uff0c\u5c06\u5b83\u7684\u6570\u5b57\u6309\u76f8\u53cd\u7684\u987a\u5e8f\u6392\u5217\u53c8\u5f97\u51fa\u4e00\u4e2a\u4e24\u4f4d\u6570\uff0c\u5b83\u4eec\u7684\u548c\u7b49\u4e8e\u4e00\u4e2a\u81ea\u7136\u6570\u7684\u5e73\u65b9\u3002\u6c42\u6240\u6709\u8fd9\u79cd\u4e24\u4f4d\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "1065",
      "text": "1065. \u8bc1\u660e\uff1a\u628a\u56db\u4e2a\u8fde\u7eed\u7684\u81ea\u7136\u6570\u7684\u79ef\u52a0\u4e0a $1$\uff0c\u6240\u5f97\u7684\u548c\u7b49\u4e8e\u67d0\u4e00\u4e2a\u81ea\u7136\u6570\u7684\u5e73\u65b9\u3002",
      "figure_ids": []
    },
    {
      "number": "1066",
      "text": "1066. \u4e00\u4e2a $60$ \u4f4d\u6570\u6709 $30$ \u4e2a\u6570\u4f4d\u4e0a\u662f\u96f6\uff0c\u53e6 $30$ \u4e2a\u6570\u4f4d\u4e0a\u662f $1$\u3002\u8bc1\u660e\u5b83\u4e0d\u53ef\u80fd\u662f\u81ea\u7136\u6570\u7684\u5e73\u65b9\u3002",
      "figure_ids": []
    },
    {
      "number": "1067",
      "text": "1067. \u5dee $43^{43}-17^{17}$ \u7684\u672b\u4f4d\u6570\u5b57\u662f\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "1068",
      "text": "1068. \u4e00\u4e2a\u4e24\u4f4d\u6570\u7684\u6570\u5b57\u7684\u548c\u7684\u4e24\u500d\u7b49\u4e8e\u5b83\u7684\u6570\u5b57\u7684\u79ef\u3002\u6c42\u8fd9\u4e2a\u4e24\u4f4d\u6570\u3002",
