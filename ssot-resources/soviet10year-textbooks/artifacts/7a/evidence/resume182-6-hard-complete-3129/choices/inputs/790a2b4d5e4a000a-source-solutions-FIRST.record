          "boundary": "No leading-zero adjustment is needed because0 is not an odd digit."
        },
        {
          "subpart": "a)2)",
          "answer": 500,
          "exact_derivation": "The first position has4 nonzero even choices; each later position has5 even choices including0. Hence4*5*5*5=500.",
          "boundary": "Counting5^4 would incorrectly include leading-zero strings that are not four-digit numbers."
        },
        {
          "subpart": "b)",
          "answer": 7875,
          "exact_derivation": "Total9*10*10*10=9000. Subtract the disjoint all-odd625 and all-even500 classes:9000-1125=7875.",
          "boundary": "Both parities means at least one digit of each parity, not exactly one odd or exactly one even digit."
        }
