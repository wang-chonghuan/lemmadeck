          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "Dropping the absolute value gives y=1/x. At x=-1 this produces -1 instead of the source value1, yielding the false negative left branch.",
            "misconception": "Replace |x| by x for negative as well as positive inputs."
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "Dropping the reciprocal graphs y=|x|, which includes the origin and increases on the right; at x=2 it gives2 rather than1/2.",
            "misconception": "Graph the denominator itself instead of its reciprocal."
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "The even graph has positive branches through both (+/-1,1) and (+/-2,1/2), excludes x=0 and never meets either axis.",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "Assigning the undefined quotient1/0 the value0 adds exactly the filled origin to the otherwise matching reciprocal graph; the original formula has no value there.",
            "misconception": "Define division by zero to be zero and extend the graph with (0,0)."
          }
        ]
