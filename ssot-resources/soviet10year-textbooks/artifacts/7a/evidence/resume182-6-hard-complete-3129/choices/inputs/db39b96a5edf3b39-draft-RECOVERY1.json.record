          {"id": "B", "text": "$\\left\\{\\dfrac{99}{5}\\right\\}$ 分钟", "figure_ids": []},
          {"id": "C", "text": "$\\left\\{12,\\dfrac{99}{5}\\right\\}$ 分钟", "figure_ids": []},
