        "rationales": [
          {"option_id": "A", "truth": "incorrect", "derivation": "It reverses the correct positive times and makes the master5 days slower rather than faster.", "misconception": "Solve the two positive durations but exchange master and apprentice identities."},
          {"option_id": "B", "truth": "correct", "derivation": "Jointtime1/(1/10+1/15)=6;first half takes3,master's last half5,total8 and delay2. Master's10 is5 less than apprentice15.", "misconception": null},
          {"option_id": "C", "truth": "incorrect", "derivation": "For4,9,jointT36/13 andactualT/2+2=44/13,delay8/13,not2.", "misconception": "Froma-T=4 discard the jointtimeT and identify4 directly with master's solo time,then add5 for apprentice."},
          {"option_id": "D", "truth": "incorrect", "derivation": "-2 is an algebraic quadratic root but a solo completion duration must be positive. Its negative work rate cannot represent this task.", "misconception": "Keep the minus root ofa^2-8a-20=0 without applyinga>0."}
        ]
