    {
      "id": "q1100-current-physical-root",
      "source_numbers": ["1100"],
      "view": {
        "mode": "single",
        "stem": "木排从 $N$ 随水流顺流漂行。$3$ 小时后，轮船从下游 $60$ 千米处的 $M$ 逆流开出，与木排相遇后再用 $1$ 小时到达 $N$。轮船静水速度为 $24$ 千米/小时，水流和船速保持不变。河水流速是多少？",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "$4$ 千米/小时", "figure_ids": []},
          {"id": "B", "text": "$48$ 千米/小时", "figure_ids": []},
          {"id": "C", "text": "$20$ 千米/小时", "figure_ids": []},
          {"id": "D", "text": "$8$ 千米/小时", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Determine the physical current rate with the3h delay and1h final upstream segment.",
        "source_solution": "For0<w<24,boat-to-meeting time t=(60-3w)/24=5/2-w/8. Meeting-toN distance equals24-w and also raft distancew(3+t). Thusw^2-52w+192=0. Roots4,48;only4 meets upstream positive speed and t>=0. Then t2 and meeting distance20km.",
        "unit_reason": "One current-speed response requires the entire delayed-start motion and rejection of an algebraic but physically impossible root.",
