import fs from 'node:fs';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const records = [];
for (const [source, target] of [
  ['.tmp/resume182-6-8a-n6-select3695.mjs', '.tmp/resume182-6-7a-n29-select3695.mjs'],
  ['.tmp/resume182-6-8a-n6-bind3695.mjs', '.tmp/resume182-6-7a-n29-bind3695.mjs'],
]) {
  const bytes = fs.readFileSync(source);
  const replacements = [
    ['8a-n6', '7a-n29'],
    ['alg8-c1-s2-n6', 'alg7-c4-s1-n29'],
    ['artifacts/8a', 'artifacts/7a'],
    ["report.scope.book, '8a'", "report.scope.book, '7a'"],
    ["book: '8a'", "book: '7a'"],
    ['resume182-6-n6-', 'resume182-6-n29-'],
    ['bounded-n6-display-selection', 'bounded-n29-display-selection'],
  ];
  let output = bytes.toString('utf8');
  const changes = [];
  for (const [before, after] of replacements) {
    const count = output.split(before).length - 1;
    output = output.replaceAll(before, after);
    if (count) changes.push({ before, after, count });
  }
  assert.ok(!output.includes('alg8-c1-s2-n6'));
  assert.ok(!output.includes('artifacts/8a'));
  assert.ok(!output.includes('8a-n6'));
  fs.writeFileSync(target, output, { flag: 'wx' });
  records.push({ source, sourceSha256: sha(bytes), target,
    sha256: sha(Buffer.from(output)), replacements: changes });
}
fs.writeFileSync('.tmp/resume182-6-7a-n29-binding-preparation.record',
  `${JSON.stringify({ status: 'MECHANICALLY_ADAPTED_NOT_EXECUTED', records,
    newRendererBrowserOrImageRuns: 0, mathematicalOrSourceChanges: false,
    evidenceSelectionNotExecuted: true, bindingNotExecuted: true,
  }, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ status: 'N29_SELECTION_AND_BINDING_PREPARED',
  paths: records.map(item => item.target), executed: false }));
