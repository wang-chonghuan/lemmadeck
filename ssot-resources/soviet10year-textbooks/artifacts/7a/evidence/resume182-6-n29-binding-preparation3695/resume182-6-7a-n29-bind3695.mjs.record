import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const [selectionPath] = process.argv.slice(2);
assert.ok(selectionPath);
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const bindings = [];
function read(file, digest, parse = true) {
  const bytes = fs.readFileSync(file);
  const hash = sha(bytes);
  if (digest) assert.equal(hash, digest, `Changed bound input: ${file}`);
  bindings.push({ path: file, sha256: hash, bytes: bytes.length });
  return parse ? JSON.parse(bytes) : bytes;
}
const selection = read(selectionPath);
assert.equal(selection.counts.missing, 0);
const runtime = read(selection.authority.path, selection.authority.sha256);
assert.equal(runtime.status, 'RUNTIME_PASS_VISUAL_PENDING');
assert.ok(runtime.checks.every(item => item.status === 'PASS'));
assert.ok(Object.values(runtime.cleanup).every(Boolean));
for (const input of runtime.inputs) read(input.path, input.sha256, false);
const observed = new Map();
for (const batch of selection.batches) {
  const resultPath = `.tmp/resume182-6-7a-n29-observe3695-${batch.id}/result.json`;
  const result = read(resultPath);
  assert.equal(result.status, 'DISPLAY_PASS');
  assert.equal(result.blockers.length, 0);
  assert.equal(result.images.length, batch.images.length);
  assert.equal(result.imageAccounting.views, batch.images.length);
  assert.equal(result.imageAccounting.uniqueImages, batch.images.length);
  for (const key of ['reopens', 'crops', 'resizes', 'rerenders']) {
    assert.equal(result.imageAccounting[key], 0);
  }
  for (const assigned of batch.images) {
    const item = result.images.find(image => image.path === assigned.path);
    assert.ok(item);
    assert.equal(item.sha256, assigned.sha256);
    assert.equal(item.blockers.length, 0);
    assert.ok(item.observations.length);
    assert.ok(!observed.has(item.path));
    observed.set(item.path, { ...item, batch: batch.id });
    read(item.path, item.sha256, false);
  }
}
assert.equal(observed.size, selection.counts.selected);
const root = 'ssot-resources/soviet10year-textbooks/artifacts/7a';
const durableByHash = new Map();
for (const name of fs.readdirSync(`${root}/evidence`).sort()) {
  if (!name.startsWith('resume182-6-n29-')) continue;
  const file = `${root}/evidence/${name}/retention.record`;
  if (!fs.existsSync(file)) continue;
  const record = read(file);
  for (const entry of record.entries ?? []) {
    if (!durableByHash.has(entry.sha256)) durableByHash.set(entry.sha256, entry.path);
  }
}
function durable(binding) {
  const absolute = path.resolve(binding.path);
  if (absolute.startsWith(`${repo}/${root}/`)) return {
    ...binding, path: path.relative(repo, absolute),
  };
  const relative = path.relative(repo, absolute);
  if (relative.includes('/node_modules/')) {
    const owner = relative.split('/node_modules/')[0];
    const lock = `${owner}/package-lock.json`;
    assert.ok(fs.existsSync(lock), `Missing existing dependency lock: ${lock}`);
    return {
      sha256: binding.sha256, bytes: binding.bytes,
      historical_path: binding.path, kind: 'existing-dependency-provenance-only',
      dependencyLock: { path: lock, sha256: sha(fs.readFileSync(lock)) },
      dependencyBytesCopied: false, activeRuntimeDependency: false,
    };
  }
  if (!relative.startsWith('../') && ['.claude/', '.agents/', 'app/']
    .some(prefix => relative.startsWith(prefix))) {
    return { ...binding, path: relative };
  }
  const target = durableByHash.get(binding.sha256);
  assert.ok(target, `Evidence has not been retained: ${binding.path}`);
  assert.equal(sha(fs.readFileSync(target)), binding.sha256);
  return { ...binding, path: target, historical_path: binding.path };
}
const lesson = `${root}/editions/modern-us-neutral/lessons/alg7-c4-s1-n29`;
const output = `${lesson}/offline`;
assert.ok(!fs.existsSync(output));
const htmls = runtime.inputs.filter(item => ['text.html', 'exercises.html', 'choices.html']
  .includes(path.basename(item.path)));
const byName = new Map(htmls.map(item => [path.basename(item.path), item]));
assert.deepEqual([...byName.keys()].sort(), ['choices.html', 'exercises.html', 'text.html']);
fs.mkdirSync(output);
const surfaces = [];
for (const [name, input] of byName) {
  const bytes = read(input.path, input.sha256, false);
  const target = `${output}/${name}`;
  fs.writeFileSync(target, bytes, { flag: 'wx' });
  assert.equal(sha(fs.readFileSync(target)), input.sha256);
  surfaces.push({ path: target, sha256: input.sha256, bytes: bytes.length });
}
const images = selection.selected.map(assigned => {
  const observation = observed.get(assigned.path);
  return {
    ...durable({ path: assigned.path, sha256: assigned.sha256,
      bytes: fs.statSync(assigned.path).size }),
    viewport: assigned.viewport, surface: assigned.surface,
    batch: observation.batch, verdict: 'PASS',
  };
});
const record = {
  schema: 'stemrobin-182/offline-display-binding@1',
  ticket: 'STEMROBIN-182', book: '7a', lesson: 'alg7-c4-s1-n29',
  date: '2026-11-20', status: 'OFFLINE_DISPLAY_PASS',
  surfaces, images,
  runtime: { ...durable({ path: selection.authority.path,
    sha256: selection.authority.sha256, bytes: fs.statSync(selection.authority.path).size }),
    checks: runtime.checks.length, status: runtime.status },
  coverage: { ...selection.counts, pending: 0, newlyObserved: observed.size,
    method: selection.method, surfaces: selection.surfaces },
  inputsAndObserverReports: [...new Map(bindings.map(binding =>
    [binding.path, durable(binding)])).values()],
  parentImageViews: 0, bindingRendererBrowserOrValidatorRuns: 0,
  historicalFailuresAndUnknownCountsPreserved: true,
  unknownHistoricalBytesRecovered: false, hostTokens: 'unknown', totalCost: 'unknown',
  boundary: 'Complete offline lesson only. No application/DB acceptance, whole-ticket approval, handoff, merge, deployment or ticket closure.',
};
const bytes = Buffer.from(`${JSON.stringify(record, null, 2)}\n`);
fs.writeFileSync(`${lesson}/offline-display.json`, bytes, { flag: 'wx' });
console.log(JSON.stringify({ path: `${lesson}/offline-display.json`, sha256: sha(bytes),
  status: record.status, observations: observed.size, checks: runtime.checks.length }));
