      "printed_footer_observed": 85,
      "locator": "Third paragraph defining table step; final paragraph defining tabular difference.",
      "paraphrase": "The table step is the difference between neighboring arguments. III has step 0.01; IV has step 0.01 first and 0.1 later. A tabular difference is the difference between neighboring function values, not the argument step.",
      "applicability": ["normalization", "interpolation_units", "do_not_confuse_function_and_argument_units"]
    },
    {
      "id": "I-linear-correction-and-route",
      "status": "supported",
      "tier": "first_hand",
      "images": ["../bradis-source/page-87.png", "../bradis-source/page-88.png"],
      "printed_footers_observed": [86, 87],
      "locator": "Printed86 paragraph introducing linear interpolation through the bottom paragraph; printed87 first two lines continue its last sentence.",
      "direct_translation": "For uniform or nearly uniform change, with table step h, tabular difference d and excess u, the correction is v=du/h. Add it to the nearest lower function value. Alternatively subtract a deficit correction from the nearest upper value. The excess route is more advantageous when the excess does not exceed half the step; otherwise the deficit route is more advantageous.",
      "advice_not_universal_mandate": true,
      "applicability": ["table_first_lookup", "n38_route_context", "n39_additive_route_context"],
      "does_not_establish": ["two_rounded_routes_always_equal", "override_of_current_modern_additive_examples"]
    },
    {
      "id": "I-interpolation-error-and-admissibility",
      "status": "supported_with_conditions_and_exception",
      "tier": "first_hand",
      "images": ["../bradis-source/page-88.png", "../bradis-source/page-89.png"],
      "printed_footers_observed": [87, 88],
      "locator": "Printed87 paragraph starting with the accuracy question above the explanatory grid; printed88 paragraph warning against sharply nonuniform changes.",
      "paraphrase": "Three errors arise from the nearest main value, the correction's tabular/rounding uncertainty, and nonuniform function change. If neighboring tabular differences differ by no more than four last-place units, the third source has no appreciable influence; the total error can slightly exceed one last-place unit only in exceptionally rare cases. Where ready corrections are absent, check neighboring differences and use linear interpolation only if they differ by at most four units; otherwise use another method.",
      "bounded_quote_ru": "не превосходящей 4 единиц",
      "absolute_unconditional_one_unit_bound": false,
      "half_unit_bound_for_corrected_result": false,
      "applicability": ["n39_corrected_results", "n39_813b", "n39_modern_prose_indices_10_and_16"]
    },
