  "instructions_visible_now": {
    "evidence_pdf_page": 4,
    "printed_footer": 3,
    "kind": "General calculation and precision guidance only.",
    "paraphrase": [
      "Distinguish exact data from approximate data; round approximate data to reliable digits with no more than one incompletely reliable digit.",
      "Avoid writing placeholder zeroes in approximate integers as if they were known digits.",
      "For addition and subtraction, retain decimal places according to the least precise approximate datum.",
      "For multiplication and division, retain significant digits according to the approximate datum with the fewest significant digits.",
      "For squares and cubes, retain as many significant digits as the approximate base; the last result digit is less reliable.",
      "For square and cube roots, retain as many significant digits as the approximate radicand; the last root digit is more reliable.",
      "Keep an extra digit for intermediate results and discard it at the end; the text recommends underlining that reserve digit."
    ],
    "precision_preface_paraphrase": "Direct tabulated entries are described as rounded with error no greater than half a unit in the last place. Interpolated results may have greater error, usually no greater than a unit in that place. This is a statement in this candidate, not verification of any lesson answer.",
