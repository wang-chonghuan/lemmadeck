{
  "schema": "n39-affected-authored-replacements@1",
  "questions": [
    {
      "id": "q01",
      "stem_prefix": "Find the arithmetic square roots of $4.3,6.2,8.9,10,50,75$ using the supplied table. Supplementary reporting condition for this question: retain the full table approximations and also report each to the nearest $0.1$, not by truncation. This added display condition is not a historical table rule. Which complete record is correct, in the listed radicand order?",
      "reuse_literal_table_suffix": true,
      "options": [
        {
          "id": "rounded",
          "text": "Root approximations: $(2.074,2.490,2.983,3.162,7.071,8.660)$; reports to $0.1$: $(2.1,2.5,3.0,3.2,7.1,8.7)$.",
          "figure_ids": []
        },
        {
          "id": "negative",
          "text": "Root approximations: $(-2.074,-2.490,-2.983,-3.162,-7.071,-8.660)$; reports to $0.1$: $(-2.1,-2.5,-3.0,-3.2,-7.1,-8.7)$.",
          "figure_ids": []
        },
        {
          "id": "truncated",
          "text": "Root approximations: $(2.074,2.490,2.983,3.162,7.071,8.660)$; reports to $0.1$: $(2.0,2.4,2.9,3.1,7.0,8.6)$.",
          "figure_ids": []
        }
      ],
      "intent_updates": {
        "task": "Determine all six original arithmetic roots from the actual direct-main cells, retain their four-figure table approximations, and distinguish the nonnegative root and nearest-tenth reporting from a negative solution of the squared equation or truncation.",
        "unit_reason": "One complete six-root record retains the original inputs and all full table values. Matching the shared printed vector cannot choose between the rounded and truncated records; the extra reporting stage requires precision judgment, while the negative record tests arithmetic-root meaning. This is recognition with explicit supplementary reporting, not six isolated cell clicks.",
        "limitations": [
          "Recognition of a complete record does not demonstrate independently producing the six root lookups or searching the full table.",
          "Nearest-0.1 reporting is a supplementary display condition, not a source requirement. Full original table approximations remain in each record; the coarser report alone would lose their original displayed precision."
        ]
      },
      "key": {
        "correct": ["rounded"],
        "rationales": [
          {
            "option_id": "rounded",
            "truth": "correct",
            "derivation": "Reuse the pre-options six direct-main results 2.074,2.490,2.983,3.162,7.071,8.660. The arithmetic roots are nonnegative. Rounding their displayed table numbers to tenths gives 2.1,2.5,3.0,3.2,7.1,8.7 because the hundredths digits are 7,9,8,6,7,6.",
            "misconception": null
          },
          {
            "option_id": "negative",
            "truth": "incorrect",
            "derivation": "Negate each of the six captured root approximations and then round each negative table number correctly to tenths. These are negative candidates for t^2=N, not the arithmetic square roots of the six positive inputs.",
            "misconception": "Choose the negative solution of t^2=N in place of the nonnegative arithmetic square root."
          },
          {
            "option_id": "truncated",
            "truth": "incorrect",
            "derivation": "Keep the six correct full table numbers but discard every digit after the tenths place: 2.074->2.0,2.490->2.4,2.983->2.9,3.162->3.1,7.071->7.0,8.660->8.6. All six reports fail nearest-tenth rounding.",
            "misconception": "Treat nearest-place reporting as cutting off digits, without examining the first discarded digit."
          }
        ]
      },
      "repair_reason": "The former alternatives only permuted the same six prompt-ordered printed outputs. The new complete records retain those outputs but cannot be selected by copying them alone.",
      "supplementary_conditions": ["Retain the full table approximations and additionally round their displayed numbers to the nearest 0.1."]
    },
    {
      "id": "q02",
      "stem_prefix": "Find the arithmetic square roots of $1.25,14.7,20.8,40.1,83.2$ by the supplied table. A complete record must decode the used row/main-column addresses to these radicands, give their full table root approximations, and report those table numbers to the nearest $0.01$. Nearest-$0.01$ reporting is a supplementary condition for this question, not a historical table rule. Which record is correct, in the listed radicand order?",
      "reuse_literal_table_suffix": true,
      "options": [
        {
          "id": "decoded-rounded",
          "text": "Addressed radicands: $(1.25,14.7,20.8,40.1,83.2)$; root approximations: $(1.118,3.834,4.561,6.332,9.121)$; reports to $0.01$: $(1.12,3.83,4.56,6.33,9.12)$.",
          "figure_ids": []
        },
        {
          "id": "swapped-step",
          "text": "Addressed radicands: $(1.70,14.07,20.08,40.01,83.02)$; root approximations: $(1.118,3.834,4.561,6.332,9.121)$; reports to $0.01$: $(1.12,3.83,4.56,6.33,9.12)$.",
          "figure_ids": []
        },
        {
          "id": "truncated",
          "text": "Addressed radicands: $(1.25,14.7,20.8,40.1,83.2)$; root approximations: $(1.118,3.834,4.561,6.332,9.121)$; reports to $0.01$: $(1.11,3.83,4.56,6.33,9.12)$.",
          "figure_ids": []
        }
      ],
      "intent_updates": {
        "task": "Retain all five original radicands and root lookups, interpret the change in main-column argument step at 10, and apply explicitly supplementary nearest-hundredth reporting to the full table approximations.",
        "unit_reason": "One complete five-root address/result/report record retains both main-column step regimes. The shared printed root vector does not settle the addressed radicands or the extra reporting stage: one candidate reverses the two step regimes, another truncates rather than rounds. Complete-record recognition and ordinary mathematical elimination remain legitimate.",
        "limitations": [
          "Selecting an address/result/report record does not demonstrate independent full-table navigation or production of the five original lookup answers.",
          "Nearest-0.01 reporting is supplementary. Full four-figure table approximations remain visible in the candidate record; reporting only the shorter values would lose original displayed precision."
        ]
      },
      "key": {
        "correct": ["decoded-rounded"],
        "rationales": [
          {
            "option_id": "decoded-rounded",
            "truth": "correct",
            "derivation": "Reuse addresses (1.2,5),(14,7),(20,8),(40,1),(83,2). Decode 1.2+5*.01=1.25, then 14+7*.1=14.7,20+8*.1=20.8,40+1*.1=40.1,83+2*.1=83.2. The pre-options roots are 1.118,3.834,4.561,6.332,9.121; nearest hundredths are 1.12,3.83,4.56,6.33,9.12.",
            "misconception": null
          },
          {
            "option_id": "swapped-step",
            "truth": "incorrect",
            "derivation": "Reverse the two supplied main-column steps: use .1 below10 and .01 at/above10. The same actual addresses then wrongly decode to 1.2+5*.1=1.70,14+7*.01=14.07,20+8*.01=20.08,40+1*.01=40.01,83+2*.01=83.02. Copying each actual cell's entry does not make that decoded address record correct for the requested inputs. These are mistaken interpretations, not claims of new captured cells at those radicands.",
            "misconception": "Interchange the low-row and high-row argument increments when interpreting main-column digits."
          },
          {
            "option_id": "truncated",
            "truth": "incorrect",
            "derivation": "Decode every address correctly and keep the original five root approximations, but discard digits after the hundredths place. This gives 1.11,3.83,4.56,6.33,9.12; the first must round upward from1.118 to1.12.",
            "misconception": "Truncate all five table numbers to two decimal places instead of nearest-hundredth rounding."
          }
        ]
      },
      "repair_reason": "The former three alternatives only permuted five disclosed outputs. Address interpretation and reporting now distinguish complete records even when their printed root vector agrees.",
      "supplementary_conditions": ["Retain the full table approximations and additionally round their displayed numbers to the nearest 0.01."]
    },
    {
      "id": "q04",
      "stem_prefix": "Find the arithmetic square roots of $1.0058,6.83251,20.156$ under this explicitly authored supplementary convention: first round each original radicand to four significant figures, then use lower-main addition with the supplied fourth-digit corrections. This preprocessing choice is not asserted to be the unique historical solution. Which complete argument/root record follows it?",
      "reuse_literal_table_suffix": true,
      "options": [
        {
          "id": "four-figure",
          "text": "Arguments: $(1.006,6.833,20.16)$; roots: $(1.003,2.614,4.490)$.",
          "figure_ids": []
        },
        {
          "id": "three-figure-truncation",
          "text": "Arguments: $(1.00,6.83,20.1)$; roots: $(1.000,2.613,4.483)$.",
          "figure_ids": []
        },
        {
          "id": "double-correction",
          "text": "Arguments: $(1.006,6.833,20.16)$; roots: $(1.006,2.615,4.497)$.",
          "figure_ids": []
        }
      ],
      "intent_updates": {
        "task": "Apply the explicit four-significant-figure preprocessing to all three unchanged original higher-resolution inputs, then apply the actual lower-main correction cells. Distinguish premature lower-main preprocessing from correct input rounding, and single from double correction.",
        "unit_reason": "The complete paired record now includes genuinely different preprocessed arguments: truncating all three originals to three significant figures lands on the supplied lower-main arguments, while four-figure rounding retains the fourth-digit corrections. Both full paths use captured cells; no alternate unseen correction is inferred. The third record isolates a correction-arithmetic error after correct preprocessing.",
        "limitations": [
          "The explicitly authored four-significant-figure preprocessing remains conditional and does not assess extended corrections for the original unrounded arguments.",
