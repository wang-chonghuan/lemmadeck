  "exercises": [
    {
      "number": "799",
      "text": "799. \u67e5\u8868\u6c42\u4e0b\u5217\u5404\u6570\u7684\u5e73\u65b9\uff1a\na) 1.3\uff0c4.7\uff0c2.8\uff0c5.7\uff0c8.3\uff0c7.2\uff0c9.6\uff1b\nb) 2.34\uff0c5.12\uff0c8.37\uff0c9.56\uff0c3.04\uff0c6.19\uff1b\nc) 1.243\uff0c4.325\uff0c7.239\uff0c8.127\uff0c6.571\uff0c9.044.",
      "figure_ids": []
    },
    {
      "number": "800",
      "text": "800. \u67e5\u8868\u6c42\u4e0b\u5217\u5404\u6570\u7684\u5e73\u65b9\uff1a\na) 5.243\uff0c52.43\uff0c5243\uff0c0.5243\uff1b\nb) 1.315\uff0c0.1315\uff0c131.5\uff0c13150.",
      "figure_ids": []
    },
    {
      "number": "801",
      "text": "801. \u67e5\u8868\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\na) $0.254^2$\uff1b\nb) $0.716^2$\uff1b\nc) $934^2$\uff1b\nd) $61.7^2$\uff1b\ne) $0.5892^2$\uff1b\nf) $23.41^2$\uff1b\ng) $0.06789^2$\uff1b\nh) $987600^2$\u3002",
      "figure_ids": []
    },
    {
      "number": "802",
      "text": "802. \u5148\u628a\u4e0b\u5217\u5404\u6570\u56db\u820d\u4e94\u5165\u5230\u56db\u4e2a\u6709\u6548\u6570\u5b57\uff0c\u518d\u6c42\u5b83\u4eec\u7684\u5e73\u65b9\uff1a\na) 3.1238\uff1b\nb) 0.10058\uff1b\nc) 41.405\uff1b\nd) 67752.",
      "figure_ids": []
    },
    {
      "number": "803",
      "text": "803. \u8ba1\u7b97\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\na) $17.3^2+1.64^2$\uff1b\nb) $8.14^2-3.265^2$\u3002",
      "figure_ids": []
    },
    {
      "number": "804",
      "text": "804. \u5df2\u77e5$x$\u7684\u8fd1\u4f3c\u503c\uff0c\u4e14\u5176\u4e2d\u6240\u6709\u6570\u5b57\u90fd\u662f\u6709\u6548\u6570\u5b57\uff0c\u6c42$x^2$\u7684\u503c\uff1a\na) $x\\approx3.26$\uff1b\nb) $x\\approx0.516$\uff1b\nc) $x\\approx47.8$\uff1b\nd) $x\\approx812$\uff1b\ne) $x\\approx4.82\\times10^5$\uff1b\nf) $x\\approx1.6\\times10^{-4}$\u3002",
      "figure_ids": []
    },
    {
      "number": "805",
      "text": "805. \u89e3\u4e0b\u5217\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}\\frac{x+y}{4}-\\frac{y}{3}=2,\\\\\\frac{x+y}{5}+x=15\\end{cases}$\uff1b\nb) $\\begin{cases}\\frac{x-y}{3}+\\frac{x}{5}=8,\\\\\\frac{x}{10}-\\frac{y}{32}=2\\end{cases}$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u5728\u4ece10\u523099\u5404\u4e2a\u81ea\u7136\u6570\u7684\u5e73\u65b9\u8868\u4e2d\uff0c\u5de6\u4fa7\u4e00\u5217\u5217\u51fa\u5341\u4f4d\u6570\u5b57\uff0c\u9876\u90e8\u4e00\u884c\u5217\u51fa\u4e2a\u4f4d\u6570\u5b57\u3002\n\u627e\u5230\u5bf9\u5e94\u884c\u4e0e\u5217\u7684\u4ea4\u53c9\u4f4d\u7f6e\uff0c\u5c31\u80fd\u8bfb\u51fa\u8fd9\u4e2a\u4e24\u4f4d\u6570\u7684\u5e73\u65b9\u3002"
    },
    {
      "block": 2,
      "text": "\u56db\u4f4d\u6709\u6548\u6570\u5b57\u6570\u5b66\u7528\u8868\u4e2d\u7684\u5e73\u65b9\u8868\uff0c\u4e5f\u91c7\u7528\u7c7b\u4f3c\u7684\u6392\u5217\u65b9\u5f0f\u3002\n\u8868\u4e2d\u5217\u51fa\u4fdd\u75594\u4e2a\u6709\u6548\u6570\u5b57\u7684\u5e73\u65b9\u503c\u3002"
    },
    {
      "block": 3,
      "text": "\u8868\u7684\u7b2c\u4e00\u5217\u4ece1\u523010\uff0c\u6bcf\u96940.1\u5217\u51fa\u4e00\u4e2a\u6570\u3002"
    },
    {
      "block": 5,
      "text": "\u9664\u4e86\u8fd9\u4e24\u5217\uff0c\u8868\u4e2d\u8fd8\u6709\u4e5d\u5217\uff0c\u5728\u9876\u90e8\u548c\u5e95\u90e8\u5206\u522b\u75281\u52309\u7f16\u53f7\u3002\n\u8fd9\u4e9b\u5217\u7528\u4e8e\u67e5\u627e\u4ece1\u523010\u3001\u6bcf\u96940.01\u53d6\u4e00\u4e2a\u6570\u7684\u5e73\u65b9\uff0c\u4e5f\u5c31\u662f\u6240\u5217\u6570\u4e0d\u8d85\u8fc7\u4e09\u4e2a\u6570\u5b57\u7684\u60c5\u51b5\u3002"
    },
    {
      "block": 10,
      "text": "\u4e00\u822c\u6765\u8bf4\uff0c\u8868\u4e2d\u4ece1\u523010\u3001\u6bcf\u96940.01\u53d6\u4e00\u4e2a\u6570\u7684\u5e73\u65b9\u8fd1\u4f3c\u503c\uff0c\u90fd\u662f\u7531\u51c6\u786e\u503c\u56db\u820d\u4e94\u5165\u5f97\u5230\u7684\u3002\n\u5b83\u4e0e\u51c6\u786e\u503c\u7684\u5dee\u522b\uff0c\u4e0d\u8d85\u8fc7\u6240\u4fdd\u7559\u7684\u6700\u540e\u4e00\u4f4d\u7684\u534a\u4e2a\u5355\u4f4d\u3002\n\u6240\u4ee5\uff0c\u8fd9\u4e9b\u8fd1\u4f3c\u503c\u4e2d\u7684\u6240\u6709\u6570\u5b57\u90fd\u662f\u6709\u6548\u6570\u5b57\u3002"
    },
    {
      "block": 11,
      "text": "\u8981\u67e5\u627e\u4ece1\u523010\u3001\u6bcf\u96940.001\u53d6\u4e00\u4e2a\u6570\u7684\u5e73\u65b9\uff0c\u8fd8\u9700\u8981\u8868\u53f3\u4fa7\u76849\u5217\u3002\n\u8fd9\u90e8\u5206\u53eb\u4f5c\u4fee\u6b63\u503c\u8868\u3002"
    },
    {
      "block": 15,
      "text": "\u4e0a\u9762\u7684\u4f8b\u5b50\u8bf4\u660e\u4e86\u600e\u6837\u67e5\u627e\u4ece1\u523010\u3001\u95f4\u9694\u4e3a0.1\u30010.01\u62160.001\u7684\u5404\u4e2a\u6570\u7684\u5e73\u65b9\u3002\n\u540c\u4e00\u5f20\u8868\u4e5f\u80fd\u7528\u4e8e\u6c42\u5c0f\u4e8e1\u6216\u5927\u4e8e10\u7684\u6b63\u6570\u7684\u5e73\u65b9\u3002\n\u53ea\u8981\u5148\u628a\u7ed9\u5b9a\u7684\u6570\u5199\u6210\u6807\u51c6\u5f62\u5f0f\uff0c\u5c31\u53ef\u4ee5\u67e5\u8868\u8ba1\u7b97\u3002"
    }
  ],
