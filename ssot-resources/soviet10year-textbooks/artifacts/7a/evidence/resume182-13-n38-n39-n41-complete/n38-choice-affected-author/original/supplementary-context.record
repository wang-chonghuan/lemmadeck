  "selected_III_method_definitions": [
    {
      "id": "III-main",
      "source": "PDF35 / printed34, first two instruction paragraphs",
      "rule": "For a three-digit number between 1 and 10: row matches the first two digits, square column the third; read the square rounded to four digits."
    },
    {
      "id": "III-correction-unit",
      "source": "PDF35 / printed34, first instruction paragraph",
      "rule": "Corrections are expressed in units of the place of the last printed result digit and printed in italics. Never interpret the integer as a fixed decimal independent of the main result."
    },
    {
      "id": "III-low-fourth-digit",
      "source": "PDF35 / printed34, four-digit paragraph",
      "rule": "For fourth digit <=5, take the square of the first three digits and ADD the correction on the fourth digit."
    },
    {
      "id": "III-high-fourth-digit",
      "source": "PDF35 / printed34, same paragraph",
      "rule": "For fourth digit >5, take the NEXT main-table square and SUBTRACT the correction for the complement of the fourth digit to 10. Do not replace this instruction with unconditional addition."
    },
    {
      "id": "III-scale",
      "source": "PDF33-34 / printed32-33 footers; PDF35 / printed34 final instruction paragraphs",
      "rule": "Moving the decimal in N one place moves the decimal in N^2 two places. Normalize an out-of-range number to a number between 1 and 10 times an integer power of 10; square both factors, using the table for the first and mental exponent arithmetic for the second."
    },
    {
      "id": "III-over-resolution",
      "source": "Entire allowed III instruction page",
      "rule": "NO explicit rule for an input with more than four significant digits, including a rounding tie, appears here. The lesson's 8.4372 -> 8.437 preprocessing is not independently specified by this instruction page."
    }
  ],
  "selected_general_method_definitions": [
    {
      "id": "G-warning-last-digit",
      "locator": "First paragraph below the horizontal separator.",
      "paraphrase": null,
      "direct_translation": "These rules give no guarantee of accuracy for the last digit of the result; its error may in individual cases reach several units, though smaller errors are more probable than larger ones.",
      "provenance_tier": "Source-only direct translation; no solution example selected."
    },
    {
      "id": "G3-G7-earlier-page-context",
      "locator": "instructions_visible_now.paraphrase, based on the previously inspected PDF4 / printed3.",
      "paraphrase": [
        "Addition/subtraction precision follows the least precise approximate datum's decimal place.",
        "Multiplication/division significant figures follow the approximate datum with the fewest significant figures.",
        "Squares/cubes retain the approximate base's significant-figure count; the last digit is less reliable.",
        "Square/cube roots retain the approximate radicand's significant-figure count; the last digit is more reliable.",
        "Intermediate results retain one extra reserve digit, dropped at the end; the reserve digit is recommended to be underlined."
      ],
      "direct_translation": null,
      "provenance_tier": "Secondary source-only method paraphrase; no original page read in this job."
    }
  ],
  "authored_main_table": {
    "provenance": "NEW mathematical reference grid. No claim of transcribing uncaptured Bradis cells. At row N and column c, square N + 0.01c exactly, then round once to four significant digits, half upward. The integer numerator and denominator bind each value to exact arithmetic.",
    "rounding": "Positive half-up; powers of ten and trailing zeros are retained in displayed entries.",
    "row_3_1_boundary": "Cells 0-6 use thousandth units; cells 7-9 use hundredth units. The rows are a new reference grid, not an image of either printed physical line.",
