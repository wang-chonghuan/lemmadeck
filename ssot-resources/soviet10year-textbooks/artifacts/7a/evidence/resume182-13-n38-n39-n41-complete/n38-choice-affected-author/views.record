  {
    "question_id": "n38-estimate-error-distinction",
    "view": {
      "mode": "multiple",
      "stem": "另设一个新的近似数据 $6.42$。对这个新数据明确误差模型：正数 $x$ 按正数四舍五入取到百分位后得到 $6.42$，恰好半个单位时进一。把给出的近似数平方并按三个有效数字报告，得到平方估计 $41.2$。哪些关于未知数和误差的数学断言成立？",
      "figure_ids": [],
      "options": [
        {
          "id": "A",
          "text": "$6.415\\le x<6.425$。",
          "figure_ids": []
        },
        {
          "id": "B",
          "text": "$41.152225\\le x^2<41.280625$。",
          "figure_ids": []
        },
        {
          "id": "C",
          "text": "对所有这样的 $x$，都有 $|x^2-41.2|\\le0.05$。",
          "figure_ids": []
        },
        {
          "id": "D",
          "text": "对所有这样的 $x$，都有 $x^2=41.2$。",
          "figure_ids": []
        },
        {
          "id": "E",
          "text": "$x=6.424$ 符合条件，此时 $|x^2-41.2|=0.067776>0.05$。",
          "figure_ids": []
        }
      ]
    }
  },
