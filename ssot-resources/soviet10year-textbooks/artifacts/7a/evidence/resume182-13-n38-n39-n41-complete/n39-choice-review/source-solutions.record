    {
      "source_number": "817",
      "independent_solution": "A squared real factor is positive away from its zero, and zero at its zero. Solve the remaining linear sign condition, then exclude both zero-product points.",
      "tasks": [
        {"id":"817.a","kind":"exact","bindings":[],"result":"x in (2,5) union (5,+infinity)","derivation":"For x!=5, (x-5)^2>0, so the strict product inequality requires x>2. x=2 and x=5 both give product 0 and are excluded."},
        {"id":"817.b","kind":"exact","bindings":[],"result":"y in (-infinity,-0.3) union (-0.3,-0.2)","derivation":"For y!=-0.3, (y+0.3)^2>0, so y+0.2<0 gives y<-0.2. Exclude y=-0.3 where the product is zero, and y=-0.2 at the strict endpoint."}
      ]
    },
    {
      "source_number": "818",
      "independent_solution": "Impose the real-root radicand condition and independently remove every zero denominator. A root in the denominator can strengthen >= to >; a root elsewhere does not.",
      "tasks": [
        {"id":"818.a","kind":"exact","bindings":[],"result":"z in (5,+infinity)","derivation":"z-5>=0 for the root, but sqrt(z-5)!=0 for division, hence z>5."},
        {"id":"818.b","kind":"exact","bindings":[],"result":"z in [0,+infinity)","derivation":"z>=0, and sqrt(z)+5>=5 never vanishes."},
        {"id":"818.c","kind":"exact","bindings":[],"result":"z in [0,25) union (25,+infinity)","derivation":"z>=0 and sqrt(z)-5!=0 exclude z=25, not z=5."},
        {"id":"818.d","kind":"exact","bindings":[],"result":"z in [0,5) union (5,+infinity)","derivation":"z>=0 from the numerator root; z-5!=0 excludes z=5. z=0 is allowed."}
      ]
    },
