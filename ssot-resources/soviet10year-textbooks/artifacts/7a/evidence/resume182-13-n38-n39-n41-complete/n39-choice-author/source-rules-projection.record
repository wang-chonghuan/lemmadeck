        "corrected_argument_step": "0.001",
        "main_argument_formula": "N + 0.01 * main-column digit",
        "main_argument_domain_visible": "[1.00, 9.99]",
        "corrected_argument_domain_representable": "[1.000, 9.999]; upper end is derived from the correction scheme, not a printed main cell",
        "no_endpoint_10_main_cell": true,
        "grouping": "Vertical main/correction separators; repeated top/bottom headers; larger gaps between five-row groups. Correction integers italic, main values upright.",
        "precision_boundary": "Row 3,1 is printed twice. Upper line has main columns 0-6 (9,610 through 9,986) and corresponding thousandth-unit corrections. Lower line has main columns 7-9 (10,05; 10,11; 10,18) and hundredth-unit corrections. Preserve the correct physical line.",
        "instruction_grid_discrepancy": "FIRST author misread corrected from frozen independent pixels: printed prose and grid both state nine correction columns, 1-9; no source discrepancy."
      },
      "rules": [
        {
          "id": "III-main",
          "source": "PDF35 / printed34, first two instruction paragraphs",
          "rule": "For a three-digit number between 1 and 10: row matches the first two digits, square column the third; read the square rounded to four digits."
        },
        {
          "id": "III-correction-unit",
          "source": "PDF35 / printed34, first instruction paragraph",
          "rule": "Corrections are expressed in units of the place of the last printed result digit and printed in italics. Never interpret the integer as a fixed decimal independent of the main result."
        },
        {
          "id": "III-low-fourth-digit",
          "source": "PDF35 / printed34, four-digit paragraph",
          "rule": "For fourth digit <=5, take the square of the first three digits and ADD the correction on the fourth digit."
        },
        {
          "id": "III-high-fourth-digit",
          "source": "PDF35 / printed34, same paragraph",
          "rule": "For fourth digit >5, take the NEXT main-table square and SUBTRACT the correction for the complement of the fourth digit to 10. Do not replace this instruction with unconditional addition."
        },
        {
          "id": "III-scale",
          "source": "PDF33-34 / printed32-33 footers; PDF35 / printed34 final instruction paragraphs",
          "rule": "Moving the decimal in N one place moves the decimal in N^2 two places. Normalize an out-of-range number to a number between 1 and 10 times an integer power of 10; square both factors, using the table for the first and mental exponent arithmetic for the second."
        },
        {
          "id": "III-output-writing",
          "source": "PDF35 / printed34 final sentence",
          "rule": "With practice, writing intermediate results becomes unnecessary; this is a notation recommendation, not a rounding rule."
        },
        {
          "id": "III-over-resolution",
          "source": "Entire allowed III instruction page",
          "rule": "NO explicit rule for an input with more than four significant digits, including a rounding tie, appears here. The lesson's 8.4372 -> 8.437 preprocessing is not independently specified by this instruction page."
        }
      ]
    },
