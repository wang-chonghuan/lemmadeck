  {
    "id":"q08","source_number":"808","task_ids":["d","e","f"],
    "mode":"single","concepts":[27],
    "stem":"Write $0.03,0.007,0.00059$, in that order, as $a\\times10^{2k}$ with $1\\leq a<100$ and integer $k$. Which complete record is valid?",
    "table_ids":[],
    "unit_reason":"A three-entry subunit normalization record retains negative powers and the coefficient boundary that forces0.007 to use70 rather than0.7.",
