      {"id":"A","text":"$(5.92,\\ 3.73)$","truth":"incorrect","derivation":"Use the true high-precision sqrt13.95=3.734969... and round it directly rather than rounding the required table number3.735; alternatively resolve the positive table-number halfway case downward.","misconception":"Substituting direct-root final rounding or a downward tie convention for the stated table-number half-up procedure."},
      {"id":"B","text":"$(5.92,\\ 3.74)$","truth":"correct","derivation":"sqrt35 table5.916->5.92; sqrt13.95 table3.728+.007=3.735->half-up3.74.","misconception":null},
