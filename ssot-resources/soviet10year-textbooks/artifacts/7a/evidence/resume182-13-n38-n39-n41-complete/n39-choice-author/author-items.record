    "options":[
      {"id":"A","text":"$3\\times10^{-2},\\quad7\\times10^{-3},\\quad5.9\\times10^{-4}$.","truth":"incorrect","derivation":"Use ordinary scientific notation7*10^-3 for0.007, obtaining the right value but an odd exponent.","misconception":"Failing the even-exponent condition while satisfying ordinary scientific notation."},
      {"id":"B","text":"$3\\times10^{-2},\\quad70\\times10^{-4},\\quad5.9\\times10^{-4}$.","truth":"correct","derivation":"Scale by100,10000,10000 respectively;3,70,5.9 are in[1,100) andk=-1,-2,-2.","misconception":null},
      {"id":"C","text":"$3\\times10^{-2},\\quad0.7\\times10^{-2},\\quad0.059\\times10^{-2}$.","truth":"incorrect","derivation":"Use10^-2 for all three numbers, preserving equality but leaving0.7 and0.059 below1.","misconception":"Using one fixed even exponent without checking the coefficient lower bound."}
    ]
