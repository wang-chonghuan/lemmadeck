  {
    "id":"q13","source_number":"811","task_ids":["a"],
    "mode":"single","concepts":[16,27],
    "stem":"Find $\\sqrt{376.8}+\\sqrt{37.68}$ by table lookup. Use lower-main addition for each root, keep the table numbers through the addition, and round the final total to four significant figures. Which record is correct?",
    "table_ids":["r3.768","r37.68"],
    "unit_reason":"A complete two-component calculation record preserves normalization, corrections, actual addition and the selected final reporting step.",
    "losses":["Selecting a worked numeric record does not establish independent written calculation.","Four-significant-figure final reporting is a new explicit condition, not a digit count imposed by the original prose."],
    "options":[
      {"id":"A","text":"Table components $19.41,6.139$; total $25.549$; final $25.55$.","truth":"correct","derivation":"sqrt376.8=10*(1.939+.002)=19.41;sqrt37.68=6.132+.007=6.139; sum25.549 rounds25.55.","misconception":null},
      {"id":"B","text":"Table components $19.39,6.132$; total $25.522$; final $25.52$.","truth":"incorrect","derivation":"Ignore both correction columns, scale main1.939 by10 and add main6.132.","misconception":"Treating the uncorrected lower-main roots as results for four-significant-figure arguments."},
      {"id":"C","text":"Table components $19.41,6.133$; total $25.543$; final $25.54$.","truth":"incorrect","derivation":"Use next main6.140 minus correction on8=.007 for37.68 rather than using its complement2=.002, or selected lower addition.","misconception":"Using the excess digit rather than its complement in an upper-main deficit subtraction."}
    ]
