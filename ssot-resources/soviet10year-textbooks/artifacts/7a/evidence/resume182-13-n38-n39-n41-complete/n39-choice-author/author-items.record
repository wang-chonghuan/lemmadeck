    ]
  },
  {
    "id":"q17","source_number":"814","task_ids":["root18","root2","approximate-product","exact-product"],
    "mode":"multiple","concepts":[0,10],
    "stem":"Obtain the table approximations to $\\sqrt{18}$ and $\\sqrt2$, multiply the obtained numbers without further rounding, and also determine the exact product $\\sqrt{18}\\,\\sqrt2$. Select every true statement.",
    "table_ids":["r18","r2"],
    "unit_reason":"Native multiple statements keep table-number arithmetic and the exact symbolic result distinct, while covering the two lookups as one paired component task.",
    "losses":["Selecting claims does not show independently writing the two lookup values or performing multiplication.","The raw product carries arithmetic digits, not seven justified significant figures about the exact irrational factors."],
    "options":[
      {"id":"A","text":"The table roots are $4.243$ and $1.414$.","truth":"correct","derivation":"Read the literal main IV entries at18 and2.","misconception":null},
      {"id":"B","text":"The product of the obtained table numbers is $5.999602$.","truth":"correct","derivation":"Multiply4.243*1.414=5.999602 exactly as decimal numbers.","misconception":null},
      {"id":"C","text":"The exact radical product is $5.999602$.","truth":"incorrect","derivation":"Replace irrationalsqrt18 andsqrt2 by rounded4.243 and1.414 in an equality, then multiply.","misconception":"Treating rounded table factors as the exact roots."},
      {"id":"D","text":"The exact radical product is $6$.","truth":"correct","derivation":"sqrt18*sqrt2=sqrt36=6 for nonnegative radicands.","misconception":null},
      {"id":"E","text":"The exact radical product is $\\sqrt{20}$.","truth":"incorrect","derivation":"Apply the erroneous identitysqrt18*sqrt2=sqrt(18+2).","misconception":"Adding rather than multiplying radicands."}
    ]
  },
  {
    "id":"q18","source_number":"815","task_ids":["a","b"],
    "mode":"single","concepts":[0],
    "stem":"When a radicand is approximate, report its root with the same number of significant figures as that radicand, not counting leading zeros. For $x\\approx6.24$ and $x\\approx71$, which ordered pair of reported roots follows this rule?",
    "table_ids":["r6.24","r71"],
    "unit_reason":"One paired reporting record directly contrasts three- and two-significant-figure approximate inputs and preserves the meaningful trailing zero.",
    "losses":["Recognition does not demonstrate independent significant-figure counting and rounding.","The source's heuristic reporting rule gives no guaranteed interval for an unknown true radicand."],
