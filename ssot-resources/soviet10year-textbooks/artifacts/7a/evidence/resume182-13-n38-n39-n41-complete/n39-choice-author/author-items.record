      {"id":"B","text":"$(2.553,\\ 25.53,\\ 255.3,\\ 0.2553)$","truth":"incorrect","derivation":"Use2.553 fromsqrt6.52 for every target and multiply by10,100,0.1; this silently treats6520 as6.52*10^4 and0.652 as6.52*10^-2.","misconception":"Ignoring the coefficient change needed for odd decimal shifts."},
      {"id":"C","text":"$(2.553,\\ 25.53,\\ 80.75,\\ 0.8075)$","truth":"correct","derivation":"Use6.52 directly and6.52*100, then65.2*100 and65.2*.01; root factors1,10,10,.1.","misconception":null}
