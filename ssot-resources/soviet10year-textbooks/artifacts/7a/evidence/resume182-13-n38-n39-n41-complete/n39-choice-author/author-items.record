      {"id":"B","text":"$(x-5)^2(x-2)>0$: $(2,\\infty)$.","truth":"incorrect","derivation":"Divide by(x-5)^2 as though it were positive for everyx and solveonlyx>2.","misconception":"Cancelling a squared factor without excluding its zero."},
      {"id":"C","text":"$(y+0.3)^2(y+0.2)<0$: $(-\\infty,-0.3)\\cup(-0.3,-0.2)$.","truth":"correct","derivation":"Square ispositive except at-.3; linear factornegative requiresy<-.2 with-.3 excluded.","misconception":null},
      {"id":"D","text":"$(y+0.3)^2(y+0.2)<0$: $(-0.3,-0.2)$.","truth":"incorrect","derivation":"Solve the extra conditiony+.3>0 as if the squared factor had to arise from a positive unsquared base, then intersectwithy<-.2.","misconception":"Confusing positivity of a square with positivity of its base."}
