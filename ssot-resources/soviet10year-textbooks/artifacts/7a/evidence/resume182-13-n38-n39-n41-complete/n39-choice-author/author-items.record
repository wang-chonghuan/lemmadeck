      {"id":"B","text":"$(1.067,\\ 2.197,\\ 7.761,\\ 9.049)$","truth":"incorrect","derivation":"Subtract1,1,4,1 thousandths from the lower main roots1.068,2.198,7.765,9.050.","misconception":"Using a deficit subtraction on a lower rather than an upper main entry."},
      {"id":"C","text":"$(1.069,\\ 2.199,\\ 7.769,\\ 9.051)$","truth":"correct","derivation":"Add0.001,0.001,0.004,0.001 to the four literal lower-main values.","misconception":null}
