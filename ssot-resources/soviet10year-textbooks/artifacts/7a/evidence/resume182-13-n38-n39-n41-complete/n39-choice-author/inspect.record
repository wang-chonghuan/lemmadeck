{
  "exercises": [
    {
      "number": "806",
      "text": "806. \u67e5\u8868\u6c42\u4e0b\u5217\u5404\u6570\u7684\u5e73\u65b9\u6839\uff1a\na) 4.3\uff0c6.2\uff0c8.9\uff0c10\uff0c50\uff0c75\uff1b\nb) 1.25\uff0c14.7\uff0c20.8\uff0c40.1\uff0c83.2\uff1b\nc) 1.143\uff0c4.835\uff0c60.37\uff0c81.92\uff1b\nd) 1.0058\uff0c6.83251\uff0c20.156.",
      "figure_ids": []
    },
    {
      "number": "807",
      "text": "807. \u67e5\u8868\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u8fd1\u4f3c\u503c\uff1a\na) $\\sqrt{5.1}$\uff1b\nb) $\\sqrt{6}$\uff1b\nc) $\\sqrt{48}$\uff1b\nd) $\\sqrt{2.07}$\uff1b\ne) $\\sqrt{31.5}$\uff1b\nf) $\\sqrt{54.8}$\uff1b\ng) $\\sqrt{7.153}$\uff1b\nh) $\\sqrt{28.04}$\uff1b\ni) $\\sqrt{66.38}$\uff1b\nj) $\\sqrt{37.21}$\uff1b\nk) $\\sqrt{53.49}$\uff1b\nl) $\\sqrt{87.25}$\u3002",
      "figure_ids": []
    },
    {
      "number": "808",
      "text": "808. \u628a\u4e0b\u5217\u5404\u6570\u5199\u6210$a\\times10^{2k}$\u7684\u5f62\u5f0f\uff0c\u5176\u4e2d$1\\leq a<100$\uff0c$k\\in Z$\uff1a\na) 115\uff1b\nb) 692\uff1b\nc) 1230\uff1b\nd) 0.03\uff1b\ne) 0.007\uff1b\nf) 0.00059.",
      "figure_ids": []
    },
    {
      "number": "809",
      "text": "809. \u67e5\u8868\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\na) $\\sqrt{6.52}$\uff1b$\\sqrt{652}$\uff1b$\\sqrt{6520}$\uff1b$\\sqrt{0.652}$\uff1b\nb) $\\sqrt{3.278}$\uff1b$\\sqrt{3278}$\uff1b$\\sqrt{0.03278}$\uff1b$\\sqrt{327800}$\u3002",
      "figure_ids": []
    },
    {
      "number": "810",
      "text": "810. \u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\na) $\\sqrt{345}$\uff1b\nb) $\\sqrt{290}$\uff1b\nc) $\\sqrt{1281}$\uff1b\nd) $\\sqrt{3720}$\uff1b\ne) $\\sqrt{25740}$\uff1b\nf) $\\sqrt{0.351}$\uff1b\ng) $\\sqrt{0.0724}$\uff1b\nh) $\\sqrt{0.00425}$\u3002",
      "figure_ids": []
    },
    {
      "number": "811",
      "text": "811. \u8ba1\u7b97\uff1a\na) $\\sqrt{376.8}+\\sqrt{37.68}$\uff1b\nb) $\\sqrt{82340}-\\sqrt{8234}$\u3002",
      "figure_ids": []
    },
    {
      "number": "812",
      "text": "812. $\\sqrt{2}\\times\\sqrt{3}$\u7684\u503c\u53ef\u4ee5\u7528\u4ee5\u4e0b\u4e24\u79cd\u65b9\u6cd5\u8ba1\u7b97\uff1a\n1) \u5206\u522b\u67e5\u8868\u6c42\u51fa\u5e73\u65b9\u6839\u7684\u503c\uff0c\u518d\u76f8\u4e58\uff1b\n2) \u5148\u53d8\u6362\u4e3a$\\sqrt{2}\\times\\sqrt{3}=\\sqrt{6}$\uff0c\u518d\u67e5\u8868\u6c42$\\sqrt{6}$\u7684\u503c\u3002 \u8fd9\u4e24\u79cd\u65b9\u6cd5\u4e2d\uff0c\u54ea\u4e00\u79cd\u66f4\u65b9\u4fbf\uff1f",
      "figure_ids": []
    },
    {
      "number": "813",
      "text": "813. \u67e5\u8868\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff0c\u51c6\u786e\u52300.01\uff1a\na) $\\sqrt{7}\\times\\sqrt{5}$\uff1b\nb) $\\sqrt{3.1}\\times\\sqrt{4.5}$\u3002",
      "figure_ids": []
    },
    {
      "number": "814",
      "text": "814. \u67e5\u8868\u6c42$\\sqrt{18}$\u548c$\\sqrt{2}$\u7684\u503c\u3002\n\u628a\u6240\u5f97\u7ed3\u679c\u76f8\u4e58\uff0c\u6c42\u79ef$\\sqrt{18}\\times\\sqrt{2}$\u7684\u8fd1\u4f3c\u503c\u3002\n\u79ef$\\sqrt{18}\\times\\sqrt{2}$\u7684\u51c6\u786e\u503c\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "815",
      "text": "815. \u6c42$\\sqrt{x}$\u7684\u503c\uff0c\u5df2\u77e5\uff1a\na) $x\\approx6.24$\uff1b\nb) $x\\approx71$\u3002 \u63d0\u793a\uff1a\u6839\u636e\u4e00\u4e2a\u6570\u7684\u8fd1\u4f3c\u503c\u67e5\u8868\u6c42\u5e73\u65b9\u6839\u65f6\uff0c\u88ab\u5f00\u65b9\u6570\u6709\u51e0\u4e2a\u6709\u6548\u6570\u5b57\uff0c\u7ed3\u679c\u5c31\u4fdd\u7559\u51e0\u4e2a\u6570\u5b57\uff0c\u524d\u9762\u7684\u96f6\u9664\u5916\u3002",
      "figure_ids": []
    },
    {
      "number": "816",
      "text": "816. \u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\na) $\\sqrt{a^2+b^2}$\uff0c\u5176\u4e2d$a\\approx31.4$\uff0c$b\\approx27.1$\uff1b\nb) $\\sqrt{a^2-b^2}$\uff0c\u5176\u4e2d$a\\approx43.7$\uff0c$b\\approx21.6$\u3002",
      "figure_ids": []
    },
    {
      "number": "817",
      "text": "817. \u89e3\u4e0b\u5217\u4e0d\u7b49\u5f0f\uff1a\na) $(x-5)^2(x-2)>0$\uff1b\nb) $(y+0.3)^2(y+0.2)<0$\u3002",
      "figure_ids": []
    },
    {
      "number": "818",
      "text": "818. \u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u5b9a\u4e49\u57df\uff1a\na) $\\frac{1}{\\sqrt{z-5}}$\uff1b\nb) $\\frac{1}{\\sqrt{z}+5}$\uff1b\nc) $\\frac{1}{\\sqrt{z}-5}$\uff1b\nd) $\\frac{\\sqrt{z}}{z-5}$\u3002",
      "figure_ids": []
    },
    {
      "number": "819",
      "text": "819. \u56fe55\u7ed9\u51fa\u4e86\u51fd\u6570$f$\u7684\u56fe\u50cf\uff0c\u5b83\u7684\u5b9a\u4e49\u57df\u662f$[-6,8]$\u3002\na) \u5206\u522b\u6307\u51fa\u4f7f$f(x)=0$\u3001$f(x)<0$\u3001$f(x)>0$\u6210\u7acb\u7684$x$\u7684\u53d6\u503c\u96c6\u5408\u3002\nb) \u5206\u522b\u6307\u51fa\u51fd\u6570$f$\u9012\u589e\u548c\u9012\u51cf\u7684\u533a\u95f4\u3002",
      "figure_ids": [
        "fig-55"
      ]
    }
  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "\u56db\u4f4d\u6709\u6548\u6570\u5b57\u6570\u5b66\u7528\u8868\u4e2d\uff0c\u4e5f\u5217\u6709\u7b97\u672f\u5e73\u65b9\u6839\u8868\u3002\n\u5b83\u7684\u6392\u5217\u65b9\u5f0f\u4e0e\u5e73\u65b9\u8868\u76f8\u4f3c\u3002"
    },
    {
      "block": 1,
      "text": "\u5e73\u65b9\u6839\u8868\u7ed9\u51fa\u4ece1\u5230100\u5404\u4e2a\u6570\u7684\u5e73\u65b9\u6839\u7684\u8fd1\u4f3c\u503c\u3002\n\u4ece1\u523010\uff0c\u6bcf\u96940.001\u5217\u51fa\u4e00\u4e2a\u6570\uff1b\n\u4ece10\u5230100\uff0c\u6bcf\u96940.01\u5217\u51fa\u4e00\u4e2a\u6570\u3002"
    },
    {
      "block": 2,
      "text": "\u4e0b\u9762\u7528\u51e0\u4e2a\u4f8b\u5b50\u8bf4\u660e\u600e\u6837\u67e5\u8868\u6c42\u5e73\u65b9\u6839\u7684\u8fd1\u4f3c\u503c\u3002"
    },
    {
      "block": 3,
      "text": "1. \u6c42$\\sqrt{5.6}$\u7684\u503c\u3002"
    },
    {
      "block": 4,
      "text": "\u5728\u7b2c\u4e00\u5217\u627e\u52305.6.\n\u4ece\u76f8\u90bb\u4e00\u5217\u7684\u540c\u4e00\u884c\u8bfb\u51fa$\\sqrt{5.6}$\u7684\u8fd1\u4f3c\u503c\uff1a\n$\\sqrt{5.6}\\approx2.366$\u3002"
    },
    {
      "block": 5,
      "text": "2. \u6c42$\\sqrt{23.5}$\u7684\u503c\u3002"
    },
    {
      "block": 6,
      "text": "\u5728\u7b2c\u4e00\u5217\u627e\u523023\u3002\n\u4ece\u8fd9\u4e00\u884c\u4e0e\u7f16\u53f7\u4e3a5\u7684\u5217\u7684\u4ea4\u53c9\u4f4d\u7f6e\u8bfb\u51fa\uff1a\n$\\sqrt{23.5}\\approx4.848$\u3002"
    },
    {
      "block": 7,
      "text": "3. \u6c42$\\sqrt{45.34}$\u7684\u503c\u3002"
    },
    {
      "block": 8,
      "text": "\u5728\u7b2c\u4e00\u5217\u627e\u523045\u3002\n\u5148\u4ece\u8fd9\u4e00\u884c\u4e0e\u7f16\u53f7\u4e3a3\u7684\u5217\u7684\u4ea4\u53c9\u4f4d\u7f6e\u8bfb\u51fa$\\sqrt{45.3}$\u7684\u8fd1\u4f3c\u503c\uff1a\n$\\sqrt{45.3}\\approx6.731$\u3002"
    },
    {
      "block": 9,
      "text": "\u518d\u5728\u4fee\u6b63\u503c\u8868\u7684\u540c\u4e00\u884c\u3001\u7f16\u53f7\u4e3a4\u7684\u5217\u4e2d\u627e\u52303.\n\u63096.731\u6700\u540e\u4e00\u4f4d\u7684\u5355\u4f4d\u52a0\u4e0a\u8fd9\u4e2a\u4fee\u6b63\u503c\uff0c\u5f97\u5230\uff1a\n$\\sqrt{45.34}\\approx6.734$\u3002"
    },
    {
      "block": 10,
      "text": "\u4e3b\u8868\u4e2d\u7531\u51c6\u786e\u503c\u76f4\u63a5\u56db\u820d\u4e94\u5165\u5f97\u5230\u7684\u5e73\u65b9\u6839\u8fd1\u4f3c\u503c\uff0c\u5176\u7edd\u5bf9\u8bef\u5dee\u4e0d\u8d85\u8fc7\u6240\u4fdd\u7559\u7684\u6700\u540e\u4e00\u4f4d\u7684\u534a\u4e2a\u5355\u4f4d\u3002"
    },
    {
      "block": 11,
      "text": "\u4f8b\u5982\uff0c2.796\u662f$\\sqrt{7.82}$\u7684\u8fd1\u4f3c\u503c\uff0c\u51c6\u786e\u52300.001\u7684\u4e00\u534a\uff0c\u4e5f\u5c31\u662f0.0005.\n\u56e0\u6b64\uff0c2.796\u4e2d\u7684\u6240\u6709\u6570\u5b57\u90fd\u662f\u6709\u6548\u6570\u5b57\u3002"
    },
    {
      "block": 12,
      "text": "\u540c\u4e00\u5f20\u8868\u4e5f\u80fd\u7528\u4e8e\u6c42\u5c0f\u4e8e1\u6216\u5927\u4e8e100\u7684\u6b63\u6570\u7684\u5e73\u65b9\u6839\u3002\n\u4e0b\u9762\u7ee7\u7eed\u770b\u51e0\u4e2a\u4f8b\u5b50\u3002"
    },
    {
      "block": 13,
      "text": "4. \u6c42$\\sqrt{245}$\u7684\u503c\u3002"
    },
    {
      "block": 14,
      "text": "245\u662f2.45\u7684100\u500d\uff0c\u800c2.45\u7684\u5e73\u65b9\u6839\u53ef\u4ee5\u67e5\u8868\u5f97\u5230\u3002\n\u56e0\u6b64\uff1a\n$\\sqrt{245}=\\sqrt{2.45\\times10^2}$\u3002"
    },
    {
      "block": 15,
      "text": "\u6839\u636e\u79ef\u7684\u5e73\u65b9\u6839\u5b9a\u7406\uff0c\u5f97\u5230\uff1a\n$\\sqrt{2.45\\times10^2}=\\sqrt{2.45}\\times10$\u3002"
    },
    {
      "block": 16,
      "text": "\u6ce8\uff1a\u8fd9\u91cc\u7684\u4fee\u6b63\u503c\u8ba1\u7b97\u4ee5\u56db\u4e2a\u6709\u6548\u6570\u5b57\u4e3a\u76ee\u6807\uff0c\u4f46\u5e76\u4e0d\u7b49\u4e8e\u5bf9\u4fee\u6b63\u540e\u7684\u7ed3\u679c\u7ed9\u51fa\u4e0a\u9762\u7684\u534a\u5355\u4f4d\u8bef\u5dee\u4fdd\u8bc1\u3002"
    },
    {
      "block": 17,
      "text": "\u67e5\u8868\u6c42\u51fa$\\sqrt{2.45}$\u7684\u8fd1\u4f3c\u503c\uff1a\n$\\sqrt{2.45}\\approx1.565$\u3002"
    },
    {
      "block": 18,
      "text": "\u4e8e\u662f\uff1a\n$\\sqrt{245}=\\sqrt{2.45}\\times10\\approx1.565\\times10=15.65$\u3002"
    },
    {
      "block": 19,
      "text": "5. \u6c42$\\sqrt{5634}$\u7684\u503c\u3002"
    },
    {
      "block": 20,
      "text": "\u628a5634\u5199\u6210$56.34\\times10^2$\uff0c\u5f97\u5230\uff1a\n$\\sqrt{56.34\\times10^2}=\\sqrt{56.34}\\times10$\u3002"
    },
    {
      "block": 21,
      "text": "\u5148\u67e5\u8868\u5f97\u5230$\\sqrt{56.3}\\approx7.503$\u3002\n\u518d\u5728\u4fee\u6b63\u503c\u8868\u7f16\u53f7\u4e3a4\u7684\u5217\u4e2d\u627e\u5230\u4fee\u6b63\u503c3\uff0c\u63097.503\u6700\u540e\u4e00\u4f4d\u7684\u5355\u4f4d\u52a0\u4e0a\u8fd9\u4e2a\u4fee\u6b63\u503c\uff0c\u5f97\u5230\uff1a\n$\\sqrt{56.34}\\approx7.506$\u3002"
    },
    {
      "block": 22,
      "text": "\u4e8e\u662f\uff1a\n$\\sqrt{5634}=10\\sqrt{56.34}\\approx75.06$\u3002"
    },
    {
      "block": 23,
      "text": "6. \u6c42$\\sqrt{0.235}$\u7684\u503c\u3002"
    },
    {
      "block": 24,
      "text": "0.235\u662f\u628a23.5\u7f29\u5c0f100\u500d\u5f97\u5230\u7684\u3002\n23.5\u7684\u5e73\u65b9\u6839\u53ef\u4ee5\u67e5\u8868\u5f97\u5230\uff0c\u56e0\u6b64\uff1a\n$\\sqrt{0.235}=\\sqrt{23.5\\times10^{-2}}$\u3002"
    },
    {
      "block": 25,
      "text": "\u56e0\u4e3a\uff1a\n$\\sqrt{23.5\\times10^{-2}}=\\sqrt{23.5}\\times10^{-1}$\u3002"
    },
    {
      "block": 26,
      "text": "\u6240\u4ee5\uff1a\n$\\sqrt{0.235}=\\sqrt{23.5}\\times10^{-1}\\approx4.848\\times10^{-1}=0.4848$\u3002"
    },
    {
      "block": 27,
      "text": "\u4e00\u822c\u6765\u8bf4\uff0c\u8981\u6c42\u5c0f\u4e8e1\u6216\u5927\u4e8e100\u7684\u6b63\u6570\u7684\u5e73\u65b9\u6839\uff0c\u53ef\u4ee5\u5148\u628a\u8fd9\u4e2a\u6570\u5199\u6210$a\\times10^{2k}$\uff0c\u5176\u4e2d$1\\leq a<100$\uff0c$k$\u662f\u6574\u6570\u3002\n\u518d\u5229\u7528\u79ef\u7684\u5e73\u65b9\u6839\u5b9a\u7406\uff0c\u5c31\u80fd\u67e5\u8868\u6c42\u5f97\u7ed3\u679c\u3002"
    }
  ],
