const sha = (bytes) => createHash('sha256').update(bytes).digest('hex');
const canonical = (value) => {
  const ordered = (item) => Array.isArray(item) ? item.map(ordered)
    : item && typeof item === 'object'
      ? Object.fromEntries(Object.keys(item).sort().map((key) => [key, ordered(item[key])]))
      : item;
  return sha(JSON.stringify(ordered(value)).replace(/[\u007f-\uffff]/gu,
    (character) => '\\u' + character.charCodeAt(0).toString(16).padStart(4, '0')));
};
const norm = (text) => String(text).normalize('NFC').replace(/\s+/gu, ' ').trim();
