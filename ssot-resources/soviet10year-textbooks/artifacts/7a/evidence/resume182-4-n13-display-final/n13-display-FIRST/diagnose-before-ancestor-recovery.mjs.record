import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { createHash } from 'node:crypto';

const R = '/Users/yong/.codex/worktrees/stemrobin-182-resume/lemmadeck';
assert.equal(process.cwd(), R);
const root = '.tmp/resume182-4-postaccount/n13-display-FIRST';
const surface = process.argv[2] ?? 'text';
assert.ok(['text', 'exercises'].includes(surface));
const runtime = `${root}/${surface === 'text' ? 'runtime-render-recovery1' : 'runtime-svg-recovery3'}`;
const htmlPath = `${runtime}/render/alg7-c1-s4-n13/${surface}.html`;
const code = fs.readFileSync(`${root}/run.mjs`, 'utf8');
const start = code.indexOf('async function installDisplayTools(');
const end = code.indexOf('async function pageSafety()', start);
assert.ok(start > 0 && end > start);
const hook = 'window.__n13Display = { bring, reset, snapshot,';
const source = code.slice(start, end);
assert.equal(source.split(hook).length, 2);
const instrumented = source.replace(hook, `${hook}
    debug: (ids) => ids.map(id => {
      const target = targets[id];
      const rect = rectFor(target);
      const frame = frameFor(target.element);
      return { id, key: target.key, rect, frame, zero: contained(target),
        halfPixel: contained(target, 0.5), onePixel: contained(target, 1),
        overflow: { left: frame.left - rect.left, right: rect.right - frame.right,
          top: frame.top - rect.top, bottom: rect.bottom - frame.bottom },
        tag: target.element.tagName, text: target.element.textContent };
    }),
`);
const install = new Function(`return (${instrumented.trim()});`)();
const { chromium } = createRequire(path.join(R, 'app/package.json'))('@playwright/test');
const inventory = JSON.parse(fs.readFileSync(`${runtime}/1440-${surface}-coverage.json`));
const html = fs.readFileSync(htmlPath);
const browser = await chromium.launch({ headless: true });
let result;
try {
  const page = await browser.newPage({ viewport: { width: 1440, height: 960 } });
  await page.route('**/*', route => route.abort());
  await page.setContent(html.toString('utf8'));
  await page.evaluate(() => document.fonts.ready);
  const materials = [{ key: 'title', selector: 'h1', index: 0 }];
  const figureContracts = {};
  if (surface === 'text') {
    const count = await page.locator('p.para').count();
    materials.push(...Array.from({ length: count }, (_, index) => ({
      key: `prose-${index}`, selector: 'p.para', index,
    })));
  } else {
    const ids = await page.locator('li.ex').evaluateAll(nodes => nodes.map(node => node.id));
    for (const id of ids) {
      materials.push({ key: `exercise-${id.slice(3)}`, selector: `#${id} .body`, index: 0 },
        { key: `number-${id.slice(3)}`, selector: `#${id} .no`, index: 0 });
    }
    const spec = JSON.parse(fs.readFileSync(
      'ssot-resources/soviet10year-textbooks/artifacts/7a/editions/modern-us-neutral/figures/tbl-p0064-01.spec.json'));
    figureContracts[spec.id] = { minimumPx: 16,
      labels: spec.objects.filter(object => object.type === 'text')
        .map(object => ({ id: `${object.id}-label`, text: object.text.trim() })) };
  }
  const dom = await page.evaluate(install, { materials, figureContracts });
  assert.equal(dom.targetCount, inventory.domTargets);
  result = await page.evaluate(ids => ids.map(id => {
    window.__n13Display.bring(id);
    return window.__n13Display.debug([id])[0];
  }),
    inventory.missingTargets.map(target => target.id));
} finally {
  await browser.close();
}
const record = {
  status: 'NUMERIC_DIAGNOSIS_ONLY', html: htmlPath,
  html_sha256: createHash('sha256').update(html).digest('hex'),
  targets: result, browserLaunches: 1, screenshots: 0, imagesObserved: 0,
  source_math_or_passed_checks_repeated: false, browserClosed: true,
};
fs.writeFileSync(`${root}/pixel-numeric-diagnosis${surface === 'text' ? '1' : '2'}.record`,
  `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ ...record, targets: result.map(target => ({
  id: target.id, key: target.key, zero: target.zero, halfPixel: target.halfPixel,
  onePixel: target.onePixel, overflow: target.overflow, text: target.text,
})) }, null, 2));
