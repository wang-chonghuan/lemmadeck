  "solutions": [
    {
      "number": "940",
      "source_number": "940",
      "tasks_covered": ["All six universal implications", "Extra positivity conditions in d/e/f", "Proofs and counterexamples"],
      "subparts": [
        {"id":"a","task":"Does x2>x1 imply 5x2>5x1?","result":true,"derivation":"5x2-5x1=5(x2-x1)>0."},
        {"id":"b","task":"Does x2>x1 imply -8x2>-8x1?","result":false,"derivation":"-8(x2-x1)<0, so the required order is reversed.","counterexample":"x1=0,x2=1 gives -8>0, which is false."},
        {"id":"c","task":"Does x2>x1 imply x2^3>x1^3?","result":true,"derivation":"x2^3-x1^3=(x2-x1)(x2^2+x1*x2+x1^2). The second factor=(x1+x2/2)^2+3*x2^2/4>0 for distinct real numbers."},
        {"id":"d","task":"For x2>x1>0, is 1/x2>1/x1?","result":false,"derivation":"1/x2-1/x1=(x1-x2)/(x1*x2)<0.","counterexample":"x1=1,x2=2 gives 1/2>1, which is false."},
        {"id":"e","task":"For x2>x1>0, is 1/x2<1/x1?","result":true,"derivation":"The reciprocal difference (x1-x2)/(x1*x2) is negative."},
        {"id":"f","task":"For x2>x1>0, is x2^2>x1^2?","result":true,"derivation":"(x2-x1)(x2+x1)>0."}
      ],
      "omitted_tasks": []
    },
    {
      "number": "941",
      "source_number": "941",
      "tasks_covered": ["Four reverse-order implications", "Two strict difference quotients", "Strict whole-domain source definitions"],
      "definition_blocks": ["alg7-c4-s1-n34:12", "alg7-c4-s1-n34:14", "alg7-c4-s1-n34:15"],
      "subparts": [
        {"id":"a","task":"f(a)>f(b) implies a>b.","result":true,"derivation":"a=b would give equal values; a<b would give f(a)<f(b) by strict increase. Trichotomy leaves a>b."},
        {"id":"b","task":"g(a)>g(b) implies a<b.","result":true,"derivation":"a=b gives equal values, and a>b gives g(a)<g(b). Thus a<b."},
        {"id":"c","task":"f(a)<f(b) implies a<b.","result":true,"derivation":"a=b gives equality and a>b gives f(a)>f(b); only a<b remains."},
        {"id":"d","task":"g(a)<g(b) implies a<b.","result":false,"derivation":"Strict decrease instead forces a>b. The assertion is not a universal consequence of the hypotheses, even though it may be vacuous on a degenerate domain.","counterexample":"M=R, f(t)=t, g(t)=-t, a=2, b=1. Then g(a)=-2<-1=g(b), but 2<1 is false."},
        {"id":"e","task":"For a!=b, (f(a)-f(b))/(a-b)>0.","result":true,"derivation":"For a>b both numerator and denominator are positive; for a<b both are negative. The nonzero denominator gives a strictly positive quotient."},
        {"id":"f","task":"For a!=b, (g(a)-g(b))/(a-b)<0.","result":true,"derivation":"For a>b the signs are negative/positive; for a<b they are positive/negative. The quotient exists and is strictly negative."}
      ],
      "omitted_tasks": []
    },
