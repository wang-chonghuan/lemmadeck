  "chapter": null,
  "section": null,
  "number": "41",
  "title": "含二次根式的代数式的变形",
  "printed_title": "41. 含二次根式的代数式的变形",
  "start_page": 246,
  "start_printed": 240,
  "figures": [
    {
      "id": "fig-56",
      "label": "图 56",
