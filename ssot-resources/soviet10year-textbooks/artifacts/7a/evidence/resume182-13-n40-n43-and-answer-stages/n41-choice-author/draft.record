      ]},
      "intent": {"task": "Preserve full distribution and squared-binomial cross terms in 836.d,e,f.", "source_solution": "d=24-12sqrt2-2sqrt3; e=6+5+2sqrt30-2sqrt30=11; f=14+18-6sqrt28+6sqrt28=32.", "unit_reason": "One expansion-judgment unit contrasts a missing distributed factor with missing squared cross terms.", "concept_blocks": [], "limitations": ["Validating expansions is not independent written expansion."], "figure_observations": []},
      "key": {"correct": ["B"], "rationales": [
        {"option_id": "A", "truth": "incorrect", "derivation": "The last product is -1*2sqrt3=-2sqrt3, not -1.", "misconception": "Distribute2sqrt3 to the first two terms only and carry -1 through unchanged."},
        {"option_id": "B", "truth": "correct", "derivation": "Square gives11+2sqrt30; sqrt120=2sqrt30, so result11.", "misconception": null},
        {"option_id": "C", "truth": "incorrect", "derivation": "The square contains -6sqrt28, cancelling the added +6sqrt28, so result32.", "misconception": "Use the invalid (u-v)^2=u^2+v^2: 14+18+6sqrt28=32+12sqrt7."}
      ]}
