    {
      "id": "q07",
      "source_numbers": ["837"],
      "view": {"mode": "multiple", "stem": "选择所有正确的因式分解。", "figure_ids": [], "options": [
        {"id": "A", "text": "$\\sqrt{14}-\\sqrt7=\\sqrt7(\\sqrt2-1)$", "figure_ids": []},
        {"id": "B", "text": "$\\sqrt{33}+\\sqrt{22}=\\sqrt{11}\\sqrt5$", "figure_ids": []},
