          {"option_id": "b", "truth": "incorrect", "derivation": "The original expressions are strictly negative, whereas sqrt50 and sqrt108 are strictly positive.", "misconception": "Square the signed coefficient and then discard the minus sign that must remain outside an arithmetic square root."},
          {"option_id": "c", "truth": "incorrect", "derivation": "15 and 14 result from multiplying by 3 and 2, not their squares; the required radicands are 45 and 28.", "misconception": "Use the outside coefficient only once in the new radicand."},
          {"option_id": "d", "truth": "correct", "derivation": "-5sqrt2=-sqrt(25*2) and -6sqrt3=-sqrt(36*3).", "misconception": null}
