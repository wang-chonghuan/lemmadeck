          {"id": "c", "text": "$6\\sqrt{\\frac23}=\\sqrt{24}$ and $2\\sqrt{\\frac32}=\\sqrt6$.", "figure_ids": []},
          {"id": "d", "text": "$7\\sqrt{10}=\\sqrt{70}$ and $5\\sqrt3=\\sqrt{15}$.", "figure_ids": []},
          {"id": "e", "text": "$5\\sqrt6=\\sqrt{150}$ and $10\\sqrt5=\\sqrt{500}$.", "figure_ids": []},
          {"id": "f", "text": "$6\\sqrt{\\frac23}=\\sqrt4$ and $2\\sqrt{\\frac32}=\\sqrt3$.", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Move all six positive coefficients into the radicand, simplifying integer and fractional radicands.",
        "source_solution": "Full 822 a-f: sqrt490,sqrt75,sqrt150,sqrt500,sqrt24,sqrt6. Their radicands are respectively 49*10,25*3,25*6,100*5,36*(2/3),4*(3/2).",
        "unit_reason": "All six source expressions participate in paired identities within one coherent multiple task. The response concerns the coefficient-squaring rule, not six isolated computations.",
        "concept_blocks": [7],
        "limitations": ["Judging identities does not prove unprompted production of all six rewrites."],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "c", "e"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "7^2*10=490 and 5^2*3=75; both outside factors are positive.", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "5*6=30 and 10*5=50 omit squaring the coefficients; correct radicands are 150 and 500.", "misconception": "Use k*u instead of k^2*u as the new radicand."},
          {"option_id": "c", "truth": "correct", "derivation": "6^2*(2/3)=24 and 2^2*(3/2)=6.", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "7*10=70 and 5*3=15 are the products without coefficient squaring.", "misconception": "Move the positive coefficient under the root unchanged, replacing ksqrt(u) by sqrt(ku)."},
          {"option_id": "e", "truth": "correct", "derivation": "5^2*6=150 and 10^2*5=500, which preserve the squares of the original positive expressions.", "misconception": null},
          {"option_id": "f", "truth": "incorrect", "derivation": "6*(2/3)=4 and 2*(3/2)=3; the original squares are 24 and 6.", "misconception": "Cancel the unsquared coefficient against the fractional radicand instead of squaring it first."}
        ]
      }
    },
    {
