  "exitCode": 0,
  "stdout": "{\n  \"exercises\": [\n    {\n      \"number\": \"820\",\n      \"text\": \"820. \\u4ece\\u6839\\u53f7\\u4e0b\\u9762\\u63d0\\u51fa\\u56e0\\u6570\\uff1a\\na) $\\\\sqrt{12}$\\uff1b\\nb) $\\\\sqrt{18}$\\uff1b\\nc) $\\\\sqrt{50}$\\uff1b\\nd) $\\\\sqrt{48}$\\uff1b\\ne) $\\\\sqrt{125}$\\uff1b\\nf) $\\\\sqrt{108}$\\uff1b\\ng) $\\\\sqrt{363}$\\uff1b\\nh) $\\\\sqrt{845}$\\u3002\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"821\",\n      \"text\": \"821. \\u4ece\\u6839\\u53f7\\u4e0b\\u9762\\u63d0\\u51fa\\u56e0\\u6570\\u5e76\\u5316\\u7b80\\u6240\\u5f97\\u5404\\u5f0f\\uff1a\\na) $\\\\frac{1}{2}\\\\sqrt{24}$\\uff1b\\nb) $\\\\frac{2}{3}\\\\sqrt{45}$\\uff1b\\nc) $-\\\\frac{1}{7}\\\\sqrt{147}$\\uff1b\\nd) $-\\\\frac{1}{5}\\\\sqrt{275}$\\uff1b\\ne) $0.1\\\\sqrt{20000}$\\uff1b\\nf) $-0.05\\\\sqrt{28800}$\\u3002\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"822\",\n      \"text\": \"822. \\u628a\\u56e0\\u6570\\u79fb\\u5230\\u6839\\u53f7\\u4e0b\\u9762\\u5e76\\u5316\\u7b80\\uff1a\\na) $7\\\\sqrt{10}$\\uff1b\\nb) $5\\\\sqrt{3}$\\uff1b\\nc) $5\\\\sqrt{6}$\\uff1b\\nd) $10\\\\sqrt{5}$\\uff1b\\ne) $6\\\\sqrt{\\\\frac{2}{3}}$\\uff1b\\nf) $2\\\\sqrt{\\\\frac{3}{2}}$\\u3002\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"823\",\n      \"text\": \"823. \\u628a\\u56e0\\u6570\\u79fb\\u5230\\u6839\\u53f7\\u4e0b\\u9762\\u5e76\\u5316\\u7b80\\u88ab\\u5f00\\u65b9\\u5f0f\\uff1a\\na) $3\\\\sqrt{5}$\\uff1b\\nb) $-5\\\\sqrt{2}$\\uff1b\\nc) $2\\\\sqrt{7}$\\uff1b\\nd) $-6\\\\sqrt{3}$\\uff1b\\ne) $5\\\\sqrt{\\\\frac{a}{5}}$\\uff1b\\nf) $-12\\\\sqrt{\\\\frac{c}{2}}$\\uff1b\\ng) $\\\\frac{1}{2}\\\\sqrt{6x}$\\uff1b\\nh) $-\\\\frac{2}{3}\\\\sqrt{3y}$\\u3002\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"824\",\n      \"text\": \"824. \\u6bd4\\u8f83\\u4e0b\\u5217\\u5404\\u9898\\u91cc\\u4e24\\u5f0f\\u7684\\u5927\\u5c0f\\uff1a\\na) $3\\\\sqrt{3}$\\u548c$\\\\sqrt{12}$\\uff1b\\nb) $\\\\sqrt{20}$\\u548c$3\\\\sqrt{5}$\\uff1b\\nc) $2\\\\sqrt{3}$\\u548c$3\\\\sqrt{2}$\\uff1b\\nd) $5\\\\sqrt{4}$\\u548c$4\\\\sqrt{5}$\\uff1b\\ne) $\\\\frac{1}{3}\\\\sqrt{54}$\\u548c$\\\\frac{1}{5}\\\\sqrt{150}$\\uff1b\\nf) $3\\\\sqrt{120}$\\u548c$2\\\\sqrt{270}$\\uff1b\\ng) $\\\\sqrt{72}$\\u548c$0.5\\\\sqrt{162}$\\uff1b\\nh) $\\\\sqrt{24}$\\u548c$\\\\frac{1}{3}\\\\sqrt{216}$\\uff1b\\ni) $\\\\frac{1}{2}\\\\sqrt{6}$\\u548c$6\\\\sqrt{\\\\frac{1}{2}}$\\uff1b\\nj) $\\\\frac{2}{3}\\\\sqrt{72}$\\u548c$7\\\\sqrt{\\\\frac{2}{3}}$\\u3002\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"825\",\n      \"text\": \"825. \\u6309\\u7167\\u9012\\u589e\\u7684\\u987a\\u5e8f\\u6392\\u5217\\u4e0b\\u5217\\u5404\\u6570\\uff1a\\na) $3\\\\sqrt{3}$\\uff1b$2\\\\sqrt{6}$\\uff1b$\\\\sqrt{29}$\\uff1b$4\\\\sqrt{2}$\\uff1b\\nb) $6\\\\sqrt{2}$\\uff1b$\\\\sqrt{58}$\\uff1b$3\\\\sqrt{7}$\\uff1b$2\\\\sqrt{14}$\\u3002\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"826\",\n      \"text\": \"826. \\u4ece\\u6839\\u53f7\\u4e0b\\u9762\\u63d0\\u51fa\\u56e0\\u5f0f\\uff1a\\na) $\\\\sqrt{7a^2}$\\uff0c\\u5176\\u4e2d$a\\\\geq0$\\uff1b\\nb) $\\\\sqrt{10y^2}$\\uff0c\\u5176\\u4e2d$y<0$\\uff1b\\nc) $\\\\sqrt{16x^3}$\\uff0c\\u5176\\u4e2d$x>0$\\uff1b\\nd) $\\\\sqrt{0.01b^5}$\\uff0c\\u5176\\u4e2d$b\\\\geq0$\\uff1b\\ne) $\\\\sqrt{50a^7}$\\uff0c\\u5176\\u4e2d$a>0$\\uff1b\\nf) $\\\\sqrt{27c^6}$\\uff0c\\u5176\\u4e2d$c<0$\\u3002\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"827\",\n      \"text\": \"827.\\na) \\u53d8\\u91cf$x$\\u662f\\u96c6\\u5408 {2, 3, -5, -10} \\u91cc\\u7684\\u4ec0\\u4e48\\u6570\\u65f6\\uff0c\\u7b49\\u5f0f$x\\\\sqrt{3}=\\\\sqrt{3x^2}$\\u6210\\u7acb\\uff1f\\nb) \\u53d8\\u91cf$c$\\u662f\\u96c6\\u5408 {-3, 1, 4, 10, -10} \\u91cc\\u7684\\u4ec0\\u4e48\\u6570\\u65f6\\uff0c\\u7b49\\u5f0f$c\\\\sqrt{5}=-\\\\sqrt{5c^2}$\\u6210\\u7acb\\uff1f\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"828\",\n      \"text\": \"828. \\u628a\\u56e0\\u5f0f\\u79fb\\u5230\\u6839\\u53f7\\u4e0b\\u9762\\uff1a\\na) $a\\\\sqrt{3}$\\uff0c\\u5176\\u4e2d$a\\\\geq0$\\uff1b\\nb) $a\\\\sqrt{3}$\\uff0c\\u5176\\u4e2d$a<0$\\uff1b\\nc) $x\\\\sqrt{\\\\frac{2}{x}}$\\uff1b\\nd) $x\\\\sqrt{-\\\\frac{2}{x}}$\\u3002\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"829\",\n      \"text\": \"829. \\u7528\\u4e24\\u79cd\\u65b9\\u6cd5\\u6c42\\u8868\\u793a\\u5f0f$6\\\\sqrt{\\\\frac{1}{3}}$\\u7684\\u503c\\uff1a\\n1) \\u4ece\\u5e73\\u65b9\\u6839\\u8868\\u91cc\\u627e\\u51fa$\\\\sqrt{0.3333}$\\u7684\\u503c\\u4ee5\\u540e\\uff0c\\u628a\\u7ed3\\u679c\\u4e58\\u4ee56\\uff1b\\n2) \\u628a$6\\\\sqrt{\\\\frac{1}{3}}$\\u5199\\u6210$\\\\sqrt{12}$\\uff0c\\u518d\\u4ece\\u5e73\\u65b9\\u6839\\u8868\\u91cc\\u627e\\u51fa\\u8fd9\\u4e2a\\u5f0f\\u5b50\\u7684\\u503c\\u3002 \\u8fd9\\u4e24\\u79cd\\u65b9\\u6cd5\\u5f53\\u4e2d\\uff0c\\u7528\\u54ea\\u4e00\\u79cd\\u65b9\\u6cd5\\u66f4\\u65b9\\u4fbf\\uff1f\\n\\nSupplementary context for this offline choice adaptation (not original exercise prose):\\nFor these items, use the following transcribed Table IV cells from Bradis's Four-figure Mathematical Tables (2010). Decimal commas are written as decimal points. A row N below 10 uses main-column digit j for argument N+j/100 and correction-column digit k for the extra argument k/1000. A row N at least 10 uses j/10 and k/100 instead. Add 0.001 times the correction-cell integer to the main root entry. A dash means no correction is needed. Normalize any out-of-range positive argument as a*10^(2m), with 1 <= a < 100, and scale the table root by 10^m.\\n\\n| Row N | Main column j | Main root entry | Correction column k | Correction integer |\\n| --- | --- | --- | --- | --- |\\n| 12 | 0 | 3.464 | - | - |\\n| 33 | 3 | 5.771 | 3 | 3 |\\n\\nCompute both routes using these cells. Keep the first route's product before any final rounding; then compare both reports at three decimal places. Judge convenience by the number of required table/correction/rescaling operations.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"830\",\n      \"text\": \"830. \\u67e5\\u5e73\\u65b9\\u6839\\u8868\\u6c42\\u4e0b\\u5217\\u5404\\u5f0f\\u7684\\u503c\\uff1a\\na) $4\\\\sqrt{5}$\\uff1b\\nb) $15\\\\sqrt{2}$\\uff1b\\nc) $14\\\\sqrt{\\\\frac{1}{7}}$\\uff1b\\nd) $12\\\\sqrt{\\\\frac{5}{6}}$\\u3002\\n\\nSupplementary context for this offline choice adaptation (not original exercise prose):\\nFor these items, use the following transcribed Table IV cells from Bradis's Four-figure Mathematical Tables (2010). Decimal commas are written as decimal points. A row N below 10 uses main-column digit j for argument N+j/100 and correction-column digit k for the extra argument k/1000. A row N at least 10 uses j/10 and k/100 instead. Add 0.001 times the correction-cell integer to the main root entry. A dash means no correction is needed. Normalize any out-of-range positive argument as a*10^(2m), with 1 <= a < 100, and scale the table root by 10^m.\\n\\n| Row N | Main column j | Main root entry |\\n| --- | --- | --- |\\n| 1.2 | 0 | 1.095 |\\n| 4.5 | 0 | 2.121 |\\n| 28 | 0 | 5.292 |\\n| 80 | 0 | 8.944 |\\n\\nFirst absorb each positive outside coefficient into its square root, then normalize the radicand to 1 <= a < 100. Use these main entries and report the scaled products without further rounding.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"831\",\n      \"text\": \"831. \\u8ba1\\u7b97\\u5706\\u7684\\u9762\\u79ef\\u7684\\u516c\\u5f0f\\u662f$S=\\\\pi r^2$\\uff0c\\u5176\\u4e2d$r$\\u662f\\u5706\\u7684\\u534a\\u5f84\\u3002\\n\\u7528$S$\\u8868\\u793a\\u53d8\\u91cf$r$\\uff0c\\u518d\\u67e5\\u8868\\u6c42\\u5706\\u7684\\u534a\\u5f84\\u3002\\u8bbe\\uff1a\\na) $S\\\\approx12.5\\\\mathrm{cm}^2$\\uff1b\\nb) $S\\\\approx8.24\\\\mathrm{cm}^2$\\u3002 \\u53d6$\\\\pi\\\\approx3.14$\\u3002 \\u5982\\u679c\\u5706\\u7684\\u9762\\u79ef\\u589e\\u52a0\\u5230$4$\\u500d\\u6216\\u51cf\\u5c0f\\u5230$1/25$\\uff0c\\u534a\\u5f84$r$\\u600e\\u6837\\u53d8\\u5316\\uff1f\\n\\nSupplementary context for this offline choice adaptation (not original exercise prose):\\nFor these items, use the following transcribed Table IV cells from Bradis's Four-figure Mathematical Tables (2010). Decimal commas are written as decimal points. A row N below 10 uses main-column digit j for argument N+j/100 and correction-column digit k for the extra argument k/1000. A row N at least 10 uses j/10 and k/100 instead. Add 0.001 times the correction-cell integer to the main root entry. A dash means no correction is needed. Normalize any out-of-range positive argument as a*10^(2m), with 1 <= a < 100, and scale the table root by 10^m.\\n\\n| Row N | Main column j | Main root entry | Correction column k | Correction integer |\\n| --- | --- | --- | --- | --- |\\n| 2.6 | 2 | 1.619 | 4 | 1 |\\n| 3.9 | 8 | 1.995 | 1 | 0 |\\n\\nFor this item, round S/3.14 to four significant figures before addressing the table. Apply the captured correction and report the returned positive radius to three decimal places in cm. This input-rounding policy is a condition of this item.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"832\",\n      \"text\": \"832. \\u6c42\\u4e0b\\u5217\\u51fd\\u6570\\u7684\\u5b9a\\u4e49\\u57df\\uff1a\\na) $y=\\\\sqrt{\\\\frac{2x-6}{5}}$\\uff1b\\nb) $y=\\\\sqrt{\\\\frac{x-2}{x-1}}$\\u3002\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"833\",\n      \"text\": \"833. \\u51fd\\u6570\\u7528\\u516c\\u5f0f$y=\\\\frac{1}{3}x^2$\\u7ed9\\u51fa\\u3002\\n\\u5982\\u679c$x\\\\in[0,10]$\\uff0c\\u8fd9\\u4e2a\\u51fd\\u6570\\u53d6\\u51e0\\u4e2a\\u6574\\u6570\\u503c\\uff1f\",\n      \"figure_ids\": []\n    }\n  ],\n  \"concept_candidates\": [\n    {\n      \"block\": 0,\n      \"text\": \"\\u5047\\u8bbe\\u9700\\u8981\\u6bd4\\u8f83$\\\\sqrt{50}$\\u548c$4\\\\sqrt{2}$\\u7684\\u5927\\u5c0f\\u3002\\n\\u53ef\\u4ee5\\u7528\\u4e0d\\u540c\\u7684\\u65b9\\u6cd5\\u89e3\\u8fd9\\u4e2a\\u9898\\u3002\"\n    },\n    {\n      \"block\": 1,\n      \"text\": \"1. \\u6211\\u4eec\\u628a\\u6839\\u5f0f$\\\\sqrt{50}$\\u53d8\\u5f62\\uff1a\\n$\\\\sqrt{50}=\\\\sqrt{25\\\\times2}=\\\\sqrt{25}\\\\times\\\\sqrt{2}=5\\\\sqrt{2}$\\u3002\"\n    },\n    {\n      \"block\": 2,\n      \"text\": \"\\u5f88\\u660e\\u663e\\uff0c$5\\\\sqrt{2}>4\\\\sqrt{2}$\\u3002\\n\\u56e0\\u6b64$\\\\sqrt{50}>4\\\\sqrt{2}$\\u3002\"\n    },\n    {\n      \"block\": 3,\n      \"text\": \"2. \\u628a\\u79ef$4\\\\sqrt{2}$\\u5199\\u6210\\u5e73\\u65b9\\u6839\\u7684\\u5f62\\u5f0f\\u3002\\n\\u4e3a\\u6b64\\u752816\\u7684\\u5e73\\u65b9\\u6839\\u4ee3\\u66ff\\u6b63\\u56e0\\u65704.\\n\\u90a3\\u4e48\\n$4\\\\sqrt{2}=\\\\sqrt{16}\\\\times\\\\sqrt{2}=\\\\sqrt{32}$\\u3002\"\n    },\n    {\n      \"block\": 4,\n      \"text\": \"\\u73b0\\u5728\\u5bb9\\u6613\\u6bd4\\u8f83$\\\\sqrt{50}$\\u548c$\\\\sqrt{32}$\\u7684\\u5927\\u5c0f\\u3002\\n\\u56e0\\u4e3a$50>32$\\uff0c\\u6240\\u4ee5$\\\\sqrt{50}>\\\\sqrt{32}$\\uff08\\u56e0\\u4e3a\\u51fd\\u6570$y=\\\\sqrt{x}$\\u662f\\u589e\\u51fd\\u6570\\uff09\\u3002\"\n    },\n    {\n      \"block\": 5,\n      \"text\": \"\\u56e0\\u6b64\\uff0c$\\\\sqrt{50}>4\\\\sqrt{2}$\\u3002\"\n    },\n    {\n      \"block\": 6,\n      \"text\": \"\\u5f53\\u7528\\u7b2c\\u4e00\\u79cd\\u65b9\\u6cd5\\u89e3\\u9898\\u65f6\\uff0c\\u6211\\u4eec\\u75285\\u548c$\\\\sqrt{2}$\\u7684\\u79ef\\u4ee3\\u66ff$\\\\sqrt{50}$\\u3002\\n\\u8fd9\\u65f6\\u5c31\\u8bf4\\uff0c\\u4ece\\u6839\\u53f7\\u4e0b\\u9762\\u63d0\\u51fa\\u4e86\\u56e0\\u65705.\"\n    },\n    {\n      \"block\": 7,\n      \"text\": \"\\u5f53\\u7528\\u7b2c\\u4e8c\\u79cd\\u65b9\\u6cd5\\u89e3\\u9898\\u65f6\\uff0c\\u6211\\u4eec\\u752832\\u7684\\u5e73\\u65b9\\u6839\\u4ee3\\u66ff$4\\\\sqrt{2}$\\u3002\\n\\u8fd9\\u65f6\\u5c31\\u8bf4\\uff0c\\u628a\\u56e0\\u65704\\u79fb\\u5230\\u4e86\\u6839\\u53f7\\u4e0b\\u9762\\u3002\"\n    },\n    {\n      \"block\": 8,\n      \"text\": \"\\u6211\\u4eec\\u6765\\u770b\\u5176\\u4ed6\\u7684\\u4f8b\\u5b50\\u3002\"\n    },\n    {\n      \"block\": 9,\n      \"text\": \"\\u4f8b 1 \\u4ece$\\\\sqrt{9a^7}$\\u7684\\u6839\\u53f7\\u4e0b\\u9762\\u63d0\\u51fa\\u56e0\\u5f0f\\u3002\"\n    },\n    {\n      \"block\": 10,\n      \"text\": \"\\u5f53$a\\\\geq0$\\u65f6\\uff0c\\u6839\\u5f0f$\\\\sqrt{9a^7}$\\u662f\\u6709\\u610f\\u4e49\\u7684\\u3002\\n\\u628a\\u88ab\\u5f00\\u65b9\\u5f0f$9a^7$\\u5199\\u6210\\u4e24\\u4e2a\\u56e0\\u5f0f\\u7684\\u79ef\\uff0c\\u5176\\u4e2d\\u4e00\\u4e2a\\u56e0\\u5b50\\u6052\\u7b49\\u4e8e\\u4e00\\u4e2a\\u5355\\u9879\\u5f0f\\u7684\\u5e73\\u65b9\\uff1a\\n$9a^7=9a^6\\\\times a=(3a^3)^2\\\\times a$\\u3002\"\n    },\n    {\n      \"block\": 11,\n      \"text\": \"\\u90a3\\u4e48\\uff0c\\u6839\\u636e\\u975e\\u8d1f\\u7684\\u56e0\\u5f0f\\u7684\\u79ef\\u7684\\u5e73\\u65b9\\u6839\\u7684\\u5b9a\\u7406\\uff0c\\u5f97\\uff1a\\n$\\\\sqrt{9a^7}=\\\\sqrt{(3a^3)^2a}=\\\\sqrt{(3a^3)^2}\\\\cdot\\\\sqrt{a}=|3a^3|\\\\cdot\\\\sqrt{a}=3a^3\\\\sqrt{a}$\\u3002\"\n    },\n    {\n      \"block\": 12,\n      \"text\": \"\\u4f8b 2 \\u5728$-4\\\\sqrt{3}$\\u7684\\u8868\\u793a\\u5f0f\\u91cc\\uff0c\\u628a\\u56e0\\u6570\\u79fb\\u5230\\u6839\\u53f7\\u4e0b\\u9762\\u3002\"\n    },\n    {\n      \"block\": 13,\n      \"text\": \"$-4\\\\sqrt{3}$\\u7684\\u503c\\u662f\\u8d1f\\u7684\\u3002\\n\\u56e0\\u6b64\\u4e0d\\u80fd\\u628a$-4\\\\sqrt{3}$\\u5199\\u6210\\u7b97\\u672f\\u5e73\\u65b9\\u6839\\u3002\\n\\u4f46\\u662f\\u8fd9\\u4e2a\\u5f0f\\u5b50\\u53ef\\u4ee5\\u53d8\\u5f62\\u4e3a\\uff1a\\n$-4\\\\sqrt{3}=-1\\\\times4\\\\sqrt{3}=-1\\\\times\\\\sqrt{16}\\\\times\\\\sqrt{3}=-\\\\sqrt{48}$\\u3002\"\n    },\n    {\n      \"block\": 14,\n      \"text\": \"\\u628a\\u6b63\\u56e0\\u6570$4$\\u79fb\\u5230\\u6839\\u53f7\\u4e0b\\u9762\\u4ee5\\u540e\\uff0c\\u6211\\u4eec\\u628a$-4\\\\sqrt{3}$\\u5199\\u6210\\u4e86\\u548c\\u7b97\\u672f\\u5e73\\u65b9\\u6839\\u76f8\\u53cd\\u7684\\u8868\\u793a\\u5f0f\\u3002\"\n    },\n    {\n      \"block\": 15,\n      \"text\": \"\\u4f8b 3 \\u5728$a\\\\sqrt{2}$\\u7684\\u8868\\u793a\\u5f0f\\u91cc\\uff0c\\u628a\\u56e0\\u6570\\u79fb\\u5230\\u6839\\u53f7\\u4e0b\\u9762\\u3002\"\n    },\n    {\n      \"block\": 16,\n      \"text\": \"\\u5728\\u5f0f$a\\\\sqrt{2}$\\u91cc\\uff0c\\u56e0\\u6570$a$\\u53ef\\u4ee5\\u662f\\u975e\\u8d1f\\u6570\\uff0c\\u4e5f\\u53ef\\u4ee5\\u662f\\u8d1f\\u6570\\u3002\"\n    },\n    {\n      \"block\": 17,\n      \"text\": \"\\u5982\\u679c$a\\\\geq0$\\uff0c\\u90a3\\u4e48\\n$a\\\\sqrt{2}=\\\\sqrt{a^2}\\\\cdot\\\\sqrt{2}=\\\\sqrt{2a^2}$\\u3002\"\n    },\n    {\n      \"block\": 18,\n      \"text\": \"\\u5982\\u679c$a<0$\\uff0c\\u90a3\\u4e48$-a>0$\\uff0c\\n$a\\\\sqrt{2}=-(-a)\\\\sqrt{2}=-\\\\sqrt{(-a)^2}\\\\cdot\\\\sqrt{2}=-\\\\sqrt{a^2}\\\\cdot\\\\sqrt{2}=-\\\\sqrt{2a^2}$\\u3002\"\n    }\n  ],\n  \"figures\": []\n}\n",
  "stderr": ""
}
