    {
      "exercise": "857",
      "grading": "ungraded",
      "source": "derived",
      "parts": [],
      "displayAnswer": "设这两个数为 $u,v$，并取差的次序使 $u-v=\\sqrt6$，题目给出 $u+v=\\sqrt{10}$。由平方恒等式\n$4uv=(u+v)^2-(u-v)^2=10-6=4$，\n两边除以 4，得到 $uv=1$，证毕。即使交换两数，差的符号改变而差的平方不变，乘积结论仍相同。还可由和、差得 $u=\\frac{\\sqrt{10}+\\sqrt6}{2}$，$v=\\frac{\\sqrt{10}-\\sqrt6}{2}$；相乘按平方差得 $uv=\\frac{10-6}{4}=1$，与证明一致。",
      "tasks": [
        {
          "label": "product proof",
          "kind": "proof",
          "givens": {"sum": "$\\sqrt{10}$", "difference": "$\\sqrt6$"},
          "sumSquared": 10,
          "differenceSquared": 6,
          "expandedSumSquared": {"u2": 1, "uv": 2, "v2": 1},
          "expandedDifferenceSquared": {"u2": 1, "uv": -2, "v2": 1},
          "identity": "$4uv=(u+v)^2-(u-v)^2$",
          "result": "1/1",
          "explicitNumbers": ["$\\frac{\\sqrt{10}+\\sqrt6}{2}$", "$\\frac{\\sqrt{10}-\\sqrt6}{2}$"],
          "orderIndependence": "Swapping u and v negates their difference but leaves its square and their product unchanged."
        }
      ]
    }
  ]
