        "identity": "$4uv=(u+v)^2-(u-v)^2$",
        "result": "1/1",
        "explicitNumbers": [
          "$\\frac{\\sqrt{10}+\\sqrt6}{2}$",
          "$\\frac{\\sqrt{10}-\\sqrt6}{2}$"
