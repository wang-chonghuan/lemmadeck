          "x": "42/5",
          "y": "-3/5",
          "originalDenominators": {"x+y": "39/5", "y-x": "-9/1", "y^2-x^2": "-351/5"},
          "signedBracketTerms": ["28/195", "14/13", "-1/15"],
          "bracket": "15/13",
          "outerFraction": "135/13",
          "result": "9/1",
          "domain": "x+y != 0 and y-x != 0; the simplified divisor is then nonzero",
          "identity": "$\\frac{(y-x)^2}{x+y}\\div\\left(\\frac{2xy}{y^2-x^2}+\\frac{x}{x+y}-\\frac{y}{y-x}\\right)=x-y$ on the original domain"
        }
