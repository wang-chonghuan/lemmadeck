  "questions": [
    {
      "id": "n40-extract-small",
      "source_numbers": ["820"],
      "view": {
        "mode": "multiple",
        "stem": "Select all statements in which both radical identities are correct.",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$\\sqrt{12}=2\\sqrt3$ and $\\sqrt{48}=4\\sqrt3$.", "figure_ids": []},
          {"id": "b", "text": "$\\sqrt{18}=9\\sqrt2$ and $\\sqrt{50}=25\\sqrt2$.", "figure_ids": []},
          {"id": "c", "text": "$\\sqrt{18}=3\\sqrt2$ and $\\sqrt{50}=5\\sqrt2$.", "figure_ids": []},
          {"id": "d", "text": "$\\sqrt{12}=6\\sqrt2$ and $\\sqrt{48}=12\\sqrt4$.", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Extract square factors, retaining the value of each of the first four radicals.",
        "source_solution": "Full 820 solution before options: 12=4*3,18=9*2,50=25*2,48=16*3,125=25*5,108=36*3,363=121*3,845=169*5. Results in original order are 2sqrt3,3sqrt2,5sqrt2,4sqrt3,5sqrt5,6sqrt3,11sqrt3,13sqrt5.",
        "unit_reason": "Two related radical families form paired identities in one native multiple response; this is not four separate answer-slot items.",
        "concept_blocks": [6],
        "limitations": ["Selecting valid identities does not demonstrate unprompted factorization or written simplification."],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "c"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "sqrt(4*3)=2sqrt3 and sqrt(16*3)=4sqrt3; squaring the positive results gives 12 and 48.", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "The proposed results square to 162 and 1250, not 18 and 50. The square factors 9 and 25 must leave the radical as 3 and 5.", "misconception": "Factor 18=9*2 and 50=25*2, then move 9 and 25 outside unchanged instead of taking their square roots."},
          {"option_id": "c", "truth": "correct", "derivation": "18=3^2*2 and 50=5^2*2; the nonnegative roots are 3sqrt2 and 5sqrt2.", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "The proposed results square to 72 and 576, not 12 and 48.", "misconception": "Use decompositions 12=6*2 and 48=12*4, then incorrectly apply sqrt(mn)=m sqrt(n), omitting the square root on the first factor."}
        ]
      }
    },
    {
      "id": "n40-extract-large",
      "source_numbers": ["820"],
      "view": {
        "mode": "multiple",
        "stem": "Select all statements in which both radical identities are correct.",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$\\sqrt{363}=121\\sqrt3$ and $\\sqrt{845}=169\\sqrt5$.", "figure_ids": []},
          {"id": "b", "text": "$\\sqrt{125}=5\\sqrt5$ and $\\sqrt{108}=6\\sqrt3$.", "figure_ids": []},
          {"id": "c", "text": "$\\sqrt{125}=25\\sqrt5$ and $\\sqrt{108}=36\\sqrt3$.", "figure_ids": []},
          {"id": "d", "text": "$\\sqrt{363}=11\\sqrt3$ and $\\sqrt{845}=13\\sqrt5$.", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Extract the maximal square factors from the four larger radicands.",
        "source_solution": "Full 820 results a-h: 2sqrt3,3sqrt2,5sqrt2,4sqrt3,5sqrt5,6sqrt3,11sqrt3,13sqrt5. The last four factorizations are 125=25*5,108=36*3,363=121*3,845=169*5.",
        "unit_reason": "Larger square-factor recognition is grouped separately from the small-radicand families; all four values remain substantive rather than becoming isolated clicks.",
        "concept_blocks": [6],
        "limitations": ["Recognition of paired results does not prove the learner can discover and write the maximal square factor."],
        "figure_observations": []
      },
      "key": {
        "correct": ["b", "d"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "sqrt(121)=11 and sqrt(169)=13; the coefficients 121 and 169 are too large by factors 11 and 13.", "misconception": "After factoring 363=121*3 and 845=169*5, copy the square factor itself outside the root."},
          {"option_id": "b", "truth": "correct", "derivation": "sqrt(25*5)=5sqrt5 and sqrt(36*3)=6sqrt3.", "misconception": null},
          {"option_id": "c", "truth": "incorrect", "derivation": "25sqrt5 and 36sqrt3 square to 3125 and 3888; the original radicands are 125 and 108.", "misconception": "Factor out 25 and 36, but do not take their square roots before moving them outside."},
          {"option_id": "d", "truth": "correct", "derivation": "363=11^2*3 and 845=13^2*5, so the nonnegative roots are 11sqrt3 and 13sqrt5.", "misconception": null}
        ]
      }
    },
    {
      "id": "n40-fraction-coefficients",
      "source_numbers": ["821"],
      "view": {
        "mode": "multiple",
        "stem": "Select all statements in which both expressions have been simplified correctly.",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$\\frac12\\sqrt{24}=\\sqrt6$ and $\\frac23\\sqrt{45}=2\\sqrt5$.", "figure_ids": []},
          {"id": "b", "text": "$-\\frac17\\sqrt{147}=-\\frac{\\sqrt3}{7}$ and $-\\frac15\\sqrt{275}=-\\frac{\\sqrt{11}}5$.", "figure_ids": []},
          {"id": "c", "text": "$\\frac12\\sqrt{24}=2\\sqrt6$ and $\\frac23\\sqrt{45}=3\\sqrt5$.", "figure_ids": []},
          {"id": "d", "text": "$-\\frac17\\sqrt{147}=-\\sqrt3$ and $-\\frac15\\sqrt{275}=-\\sqrt{11}$.", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Combine square-factor extraction with the original fractional coefficients and signs.",
        "source_solution": "Full 821 solution a-f: sqrt6,2sqrt5,-sqrt3,-sqrt11,10sqrt2,-6sqrt2. For a-d the extracted coefficients are 2,3,7,5 and multiply the outside coefficients 1/2,2/3,-1/7,-1/5.",
        "unit_reason": "Positive and negative fraction cancellations are paired in one multiple question. The decimal scale cases have a different numerical issue and are grouped separately.",
        "concept_blocks": [6],
        "limitations": ["Recognizing cancellation is not evidence of producing the complete simplification without alternatives."],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "d"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "sqrt24=2sqrt6, so half gives sqrt6; sqrt45=3sqrt5, so multiplying by 2/3 gives 2sqrt5.", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "147=49*3 and 275=25*11; extracting produces factors 7 and 5, which cancel the original denominators, not the displayed extra denominators.", "misconception": "Delete the square factors 49 and 25 from the radicands but omit their extracted roots 7 and 5, leaving the outside fractions unchanged."},
          {"option_id": "c", "truth": "incorrect", "derivation": "The proposed outputs are the simplified bare roots, not the expressions multiplied by 1/2 and 2/3.", "misconception": "Simplify sqrt24 and sqrt45 but discard their original external coefficients."},
          {"option_id": "d", "truth": "correct", "derivation": "(-1/7)*7sqrt3=-sqrt3 and (-1/5)*5sqrt11=-sqrt11; both original signs are retained.", "misconception": null}
        ]
      }
    },
    {
      "id": "n40-decimal-scale",
      "source_numbers": ["821"],
      "view": {
        "mode": "single",
        "stem": "Simplify $0.1\\sqrt{20000}$ and $-0.05\\sqrt{28800}$, in that order. Which pair gives both results?",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$(100\\sqrt2,\\,-120\\sqrt2)$", "figure_ids": []},
          {"id": "b", "text": "$(10\\sqrt2,\\,6\\sqrt2)$", "figure_ids": []},
          {"id": "c", "text": "$(10\\sqrt2,\\,-6\\sqrt2)$", "figure_ids": []},
          {"id": "d", "text": "$(20\\sqrt5,\\,-12\\sqrt{10})$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Handle decimal multiplication and the negative sign after extracting large squares.",
        "source_solution": "Full 821 a-f: sqrt6,2sqrt5,-sqrt3,-sqrt11,10sqrt2,-6sqrt2. 20000=100^2*2 and 28800=120^2*2, hence 0.1*100sqrt2=10sqrt2 and -0.05*120sqrt2=-6sqrt2.",
        "unit_reason": "One complete pair tests decimal scaling and sign preservation together; neither value is a separate answer slot.",
        "concept_blocks": [6, 7],
        "limitations": ["Pair recognition does not demonstrate independent written extraction and decimal arithmetic."],
        "figure_observations": []
      },
      "key": {
        "correct": ["c"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "100sqrt2 and -120sqrt2 are obtained before multiplying by 0.1 and 0.05.", "misconception": "Extract the square factors but omit multiplication by the magnitudes of the original decimal coefficients."},
          {"option_id": "b", "truth": "incorrect", "derivation": "The first magnitude is right, but the second expression is negative, not positive.", "misconception": "Replace -0.05 by its magnitude 0.05 while simplifying the second expression."},
          {"option_id": "c", "truth": "correct", "derivation": "0.1*100=10 and -0.05*120=-6, with the shared remaining radicand 2.", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "sqrt(0.1*20000)=sqrt2000=20sqrt5 and -sqrt(0.05*28800)=-sqrt1440=-12sqrt10, but moving a coefficient inside requires its square.", "misconception": "Multiply the radicand by the outside coefficient magnitude once, rather than by its square, retaining the minus sign separately."}
        ]
      }
    },
    {
      "id": "n40-positive-absorption",
      "source_numbers": ["822"],
      "view": {
        "mode": "multiple",
        "stem": "Move the positive outside factors under the radical. Select all statements in which both resulting radicands preserve the original values.",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$7\\sqrt{10}=\\sqrt{490}$ and $5\\sqrt3=\\sqrt{75}$.", "figure_ids": []},
