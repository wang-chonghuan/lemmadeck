    {
      "id": "n40-radius-and-area",
      "source_numbers": ["831"],
      "view": {
        "mode": "multiple",
        "stem": "A circle has area $S=\\pi r^2$ and positive radius $r$. Use $\\pi\\approx3.14$ when $S\\approx12.5\\,\\mathrm{cm}^2$ or $S\\approx8.24\\,\\mathrm{cm}^2$. Without supplying rounded table entries, select all correct radius formulas or area-scaling statements.",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$r=\\frac{\\sqrt S}{\\pi}$; the two radii are approximately $\\frac{\\sqrt{12.5}}{3.14}\\,\\mathrm{cm}$ and $\\frac{\\sqrt{8.24}}{3.14}\\,\\mathrm{cm}$.", "figure_ids": []},
          {"id": "b", "text": "$r=\\sqrt{\\frac S\\pi}$; the two radii are approximately $\\sqrt{\\frac{625}{157}}\\,\\mathrm{cm}$ and $\\sqrt{\\frac{412}{157}}\\,\\mathrm{cm}$.", "figure_ids": []},
          {"id": "c", "text": "Multiplying the area by $4$ multiplies the radius by $4$.", "figure_ids": []},
          {"id": "d", "text": "Multiplying the area by $4$ multiplies the radius by $2$.", "figure_ids": []},
          {"id": "e", "text": "Multiplying the area by $\\frac1{25}$ multiplies the radius by $\\frac15$.", "figure_ids": []},
          {"id": "f", "text": "Multiplying the area by $\\frac1{25}$ multiplies the radius by $\\frac1{25}$.", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Solve the inverse radius formula with units, prepare both source-data radicands, and determine both area-to-radius scale factors.",
        "source_solution": "r=sqrt(S/pi) is the positive-length solution. With pi~=3.14 and approximate seed areas, 12.5/3.14=625/157 and 8.24/3.14=412/157, so radii are approximately their square roots in cm. For area multipliers 4 and 1/25 the radius multipliers are 2 and 1/5. Actual table procedures for the two non-grid quotients, including input rounding and cell/correction observations, remain deferred.",
        "unit_reason": "Formula, two source areas, and both scaling deductions remain in one coherent multiple task. Neither radius becomes an invented numerical cell-answer question.",
        "concept_blocks": [6, 7],
        "limitations": [
          "831.a: actual source-table procedure and approximate numerical radius for S~=12.5 cm^2, pi~=3.14, are deferred; quotient 625/157 is solved exactly.",
          "831.b: actual source-table procedure and approximate numerical radius for S~=8.24 cm^2, pi~=3.14, are deferred; quotient 412/157 is solved exactly.",
          "Selection does not demonstrate the numerical lookups, their rounding/correction convention, or an independently written inverse/scaling derivation."
        ],
        "figure_observations": []
      },
      "key": {
        "correct": ["b", "d", "e"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "S/pi=r^2, hence r=sqrt(S)/sqrt(pi), not sqrt(S)/pi. Squaring the proposed formula gives S/pi^2.", "misconception": "Divide the area by pi after taking its square root rather than before, failing to take the square root of the denominator."},
          {"option_id": "b", "truth": "correct", "derivation": "Divide S=pi*r^2 by pi and take the nonnegative root. 12.5/3.14=1250/314=625/157 and 8.24/3.14=824/314=412/157, and a length is measured in cm.", "misconception": null},
          {"option_id": "c", "truth": "incorrect", "derivation": "A radius multiplier 4 would produce area multiplier 16, not 4.", "misconception": "Assume radius is directly proportional to area, assigning the same multiplier to both."},
          {"option_id": "d", "truth": "correct", "derivation": "r'=sqrt(4S/pi)=2sqrt(S/pi)=2r.", "misconception": null},
          {"option_id": "e", "truth": "correct", "derivation": "r'=sqrt(S/(25pi))=r/5.", "misconception": null},
          {"option_id": "f", "truth": "incorrect", "derivation": "A radius multiplier 1/25 would produce area multiplier 1/625, not 1/25.", "misconception": "Apply the area multiplier directly to the radius instead of taking its positive square root."}
        ]
      }
