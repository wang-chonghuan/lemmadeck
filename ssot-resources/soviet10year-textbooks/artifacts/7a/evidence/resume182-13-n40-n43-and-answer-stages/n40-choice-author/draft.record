          {"option_id": "b", "truth": "incorrect", "derivation": "For any a<0 the original is negative and the proposed arithmetic square root positive.", "misconception": "Square a inside the root and assume that removes the need to preserve its original negative sign."},
          {"option_id": "c", "truth": "correct", "derivation": "2/x>=0 with x!=0 gives x>0; -2/x>=0 gives x<0. The absorbed radicands are 2x and -2x, with a minus outside for negative x.", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "On x<0 the second original is strictly negative, but sqrt(-2x) is strictly positive.", "misconception": "Determine x<0 correctly from the radicand, then square the coefficient without keeping the outside minus."}
