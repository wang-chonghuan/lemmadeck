      ],
      "construction": [
        "Draw y=-1 only for x<0, extending left without bound.",
        "Draw y=1 only for x>0, extending right without bound.",
        "Mark open circles at (0,-1) and (0,1). Do not draw a connecting segment or any filled point on x=0."
      ],
      "axis_intersections": {"x_axis": [], "y_axis": []}
    },
