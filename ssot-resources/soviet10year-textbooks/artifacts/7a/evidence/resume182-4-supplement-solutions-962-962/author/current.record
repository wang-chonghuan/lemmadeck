  "exercises": [
    {
      "number": "962",
      "source_excerpt": "962. 作出由下列公式给出的函数的图象：а) $y=\\frac{\\sqrt{x^2}}{x}$； б) $y=\\frac{-2\\sqrt{x^2}}{x}$；в) $y=x\\sqrt{x^2}$； г) $y=-x\\sqrt{x^2}$。",
      "shared_derivation": "For every real x, the principal square root sqrt(x^2)=|x|. It equals -x on x<0 and x on x>=0. Division by x additionally excludes x=0.",
      "tasks": [
        {
          "id": "962a",
          "source_label": "а",
          "original_formula": "sqrt(x^2)/x",
          "domain": "R excluding 0",
          "piecewise": [
            {"condition": "x<0", "y": "-1"},
            {"condition": "x>0", "y": "1"}
          ],
          "graph_construction": "Draw the horizontal ray y=-1 strictly left of the y axis, with an open endpoint at (0,-1). Draw the horizontal ray y=1 strictly right of the y axis, with an open endpoint at (0,1). There is no point at x=0.",
          "plot_points": [[-2, -1], [-1, -1], [1, 1], [2, 1]],
          "range": "{-1,1}",
          "zero_boundary": "Undefined, not zero and not an arbitrarily filled jump."
        },
        {
          "id": "962b",
          "source_label": "б",
          "original_formula": "-2sqrt(x^2)/x",
          "domain": "R excluding 0",
          "piecewise": [
            {"condition": "x<0", "y": "2"},
            {"condition": "x>0", "y": "-2"}
          ],
          "graph_construction": "Draw the horizontal ray y=2 strictly left of the y axis with an open endpoint at (0,2). Draw the horizontal ray y=-2 strictly right of the y axis with an open endpoint at (0,-2). Do not add a point at x=0.",
          "plot_points": [[-2, 2], [-1, 2], [1, -2], [2, -2]],
          "range": "{-2,2}",
          "zero_boundary": "Undefined."
        },
        {
          "id": "962c",
          "source_label": "в",
          "original_formula": "xsqrt(x^2)",
          "domain": "R",
          "piecewise": [
            {"condition": "x<0", "y": "-x^2"},
            {"condition": "x>=0", "y": "x^2"}
          ],
          "graph_construction": "Use the left half of y=-x^2 on x<0 and the right half of y=x^2 on x>=0. They meet at the included origin (0,0); do not draw either parabola's unused half. The curve is odd and strictly increasing.",
          "plot_points": [[-2, -4], [-1, -1], [0, 0], [1, 1], [2, 4]],
          "range": "R",
          "zero_boundary": "Defined and equal to 0; both one-sided expressions agree."
        },
        {
          "id": "962d",
          "source_label": "г",
          "original_formula": "-xsqrt(x^2)",
          "domain": "R",
          "piecewise": [
            {"condition": "x<0", "y": "x^2"},
            {"condition": "x>=0", "y": "-x^2"}
          ],
          "graph_construction": "Use the left half of y=x^2 on x<0 and the right half of y=-x^2 on x>=0. Include the origin once. This is the reflection of task c in the x axis, an odd strictly decreasing curve.",
          "plot_points": [[-2, 4], [-1, 1], [0, 0], [1, -1], [2, -4]],
          "range": "R",
          "zero_boundary": "Defined and equal to 0."
        }
      ]
    }
  ],
