  "exercises": [
    {
      "number": 963,
      "source_number": "963",
      "source_text_hashes": {
        "modern_text_sha256": "68d2e579457c1ec06ac461c86d1a39fa771d9ab1a7579703b303c7500acd3f43",
        "modern_source_text_sha256": "55020fc752af5ae3bd18b198dc240689167422dd7d15353e48eb546bd15fe7a4",
        "raw_text_sha256": "55020fc752af5ae3bd18b198dc240689167422dd7d15353e48eb546bd15fe7a4"
      },
      "tasks": [
        {
          "id": "963.a",
          "label": "a",
          "modern_task_text_sha256": "d0a7256823dfea0f222892d6467a2f3db416650d34d747282a1df97726865958",
          "problem_latex": "\\sqrt{196\\cdot0.81\\cdot0.36}",
          "requested_domain": "No variables; all three factors and the radicand are positive.",
          "derivation": [
            "196=14^2, 0.81=(9/10)^2, 0.36=(3/5)^2.",
            "The principal square root is 14*(9/10)*(3/5)=189/25."
          ],
          "answer_latex": "\\frac{189}{25}",
          "exact_rational": [189, 25],
          "exact_decimal": "7.56"
        },
        {
          "id": "963.b",
          "label": "b",
          "modern_task_text_sha256": "ba20396dd546a12db99f67f58cbc35c9a904456d4be79dd92585f10e3ef607c4",
          "problem_latex": "\\sqrt{1\\frac{9}{16}\\cdot5\\frac{4}{9}\\cdot0.01}",
          "requested_domain": "No variables; the radicand is positive.",
          "derivation": [
            "Read the two mixed numbers as 1+9/16=25/16 and 5+4/9=49/9.",
            "The radicand is (25/16)*(49/9)*(1/100).",
            "Its principal square root is (5/4)*(7/3)*(1/10)=7/24."
          ],
          "answer_latex": "\\frac{7}{24}",
          "exact_rational": [7, 24]
        },
        {
          "id": "963.c",
          "label": "c",
          "modern_task_text_sha256": "944ca41bcc679868a1cc1d1f2d6ad105ae34a387f7437bf9961de96d8265d997",
          "problem_latex": "\\sqrt{0.87\\cdot49+0.82\\cdot49}",
          "requested_domain": "No variables; the radicand is positive.",
          "derivation": [
            "Factor 49: 0.87*49+0.82*49=49*(0.87+0.82)=49*1.69.",
            "Since 1.69=(13/10)^2, the root is 7*(13/10)=91/10."
          ],
          "answer_latex": "\\frac{91}{10}",
          "exact_rational": [91, 10],
          "exact_decimal": "9.1"
        },
        {
          "id": "963.d",
          "label": "d",
          "modern_task_text_sha256": "7e8b7f4a0568b1f326b265a11775e0f253b635bcbfd6ee785fdf2aa9427e8874",
          "problem_latex": "\\sqrt{1.44\\cdot1.21-1.44\\cdot0.4}",
          "requested_domain": "No variables; the radicand is positive.",
          "derivation": [
            "Factor 1.44: the radicand is 1.44*(1.21-0.4)=1.44*0.81.",
            "The root is (6/5)*(9/10)=27/25."
          ],
          "answer_latex": "\\frac{27}{25}",
          "exact_rational": [27, 25],
          "exact_decimal": "1.08"
        },
        {
          "id": "963.e",
          "label": "e",
          "modern_task_text_sha256": "8b64971ca66293a49598ae8b1df6e33edb7c3ab118ce13e90d45e80627745e42",
          "problem_latex": "\\sqrt{146.5^2-109.5^2+27\\cdot256}",
          "requested_domain": "No variables; the radicand is positive.",
          "derivation": [
            "146.5^2-109.5^2=(146.5-109.5)*(146.5+109.5)=37*256.",
            "The full radicand is (37+27)*256=64*256=(8*16)^2=16384.",
            "The principal square root is 128."
          ],
          "answer_latex": "128",
          "exact_rational": [128, 1]
        },
        {
          "id": "963.f",
          "label": "f",
          "modern_task_text_sha256": "bf089ce1dab0f62e33834cad0b43d98b2d912bb15b3969080b69baa47dbf83b8",
          "problem_latex": "\\sqrt{117.5^2-26.5^2-1440}",
          "requested_domain": "No variables; the radicand is positive.",
          "derivation": [
            "117.5^2-26.5^2=(117.5-26.5)*(117.5+26.5)=91*144.",
            "Since 1440=10*144, the full radicand is (91-10)*144=81*144=(9*12)^2=11664.",
            "The principal square root is 108."
          ],
          "answer_latex": "108",
          "exact_rational": [108, 1]
        }
      ]
    },
    {
      "number": 964,
      "source_number": "964",
      "source_text_hashes": {
        "modern_text_sha256": "48c440ab2dd4efafa984fc427483e160d22f1e52e47f83aef82e423e3d4ef05e",
        "modern_source_text_sha256": "a8f0dc5ba352bbbebad36d42804987b29589dcec25dfb0663195149d2b98ece6",
        "raw_text_sha256": "a8f0dc5ba352bbbebad36d42804987b29589dcec25dfb0663195149d2b98ece6"
      },
      "tasks": [
        {
          "id": "964.a",
          "label": "a",
          "modern_task_text_sha256": "cb4bf2af468370c5db1aa589e39d41b2c14542434ff3e5e77b3139883f03462f",
          "problem_latex": "\\sqrt{\\frac{165^2-124^2}{164}}",
          "requested_domain": "No variables; denominator 164>0 and radicand>0.",
          "derivation": [
            "165^2-124^2=(165-124)*(165+124)=41*289.",
            "The radicand is (41*289)/(4*41)=289/4=(17/2)^2.",
            "The principal square root is 17/2."
          ],
          "answer_latex": "\\frac{17}{2}",
          "exact_rational": [17, 2]
        },
        {
          "id": "964.b",
          "label": "b",
          "modern_task_text_sha256": "1a41b614bcff93e6970d9170d716248f49ef6cbde232db8a5bf70fb3ecb93a1d",
          "problem_latex": "\\sqrt{\\frac{98}{176^2-112^2}}",
          "requested_domain": "No variables; denominator 64*288=18432>0 and radicand>0.",
          "derivation": [
            "176^2-112^2=(176-112)*(176+112)=64*288=18432.",
            "98/18432=49/9216=7^2/96^2.",
            "The principal square root is 7/96."
          ],
          "answer_latex": "\\frac{7}{96}",
          "exact_rational": [7, 96]
        },
        {
          "id": "964.c",
          "label": "c",
          "modern_task_text_sha256": "966aaf6244f95aab23d036f1c6ecc028aa72a5bd9c48e9a095f76862a0c56df1",
          "problem_latex": "\\sqrt{\\frac{149^2-76^2}{457^2-384^2}}",
          "requested_domain": "No variables; denominator 73*841=61393>0 and radicand>0.",
          "derivation": [
            "149^2-76^2=73*225 and 457^2-384^2=73*841.",
            "The radicand is 225/841=15^2/29^2.",
            "The principal square root is 15/29."
          ],
          "answer_latex": "\\frac{15}{29}",
          "exact_rational": [15, 29]
        },
        {
          "id": "964.d",
          "label": "d",
          "modern_task_text_sha256": "419ca8f74a60a95023a773b577f7989d0658bb0b97cd7df892dbbae192b05501",
          "problem_latex": "\\sqrt{\\frac{145.5^2-96.5^2}{193.5^2-31.5^2}}",
          "requested_domain": "No variables; denominator 162*225=36450>0 and radicand>0.",
          "derivation": [
            "145.5^2-96.5^2=49*242; 193.5^2-31.5^2=162*225.",
            "Cancel the common factor 2: (49*242)/(162*225)=(49*121)/(81*225).",
            "The radicand is ((7*11)/(9*15))^2=(77/135)^2.",
            "The principal square root is 77/135."
          ],
          "answer_latex": "\\frac{77}{135}",
          "exact_rational": [77, 135]
        }
      ]
    },
    {
      "number": 965,
      "source_number": "965",
      "source_text_hashes": {
        "modern_text_sha256": "7bc118cf642c40dac877a8b4002aa35968c2023c69e117933a0ec96f0f315190",
        "modern_source_text_sha256": "0935a4e92c638b20ad995323967edf3bf407d6a5341b55e47be08f7383f29219",
        "raw_text_sha256": "0935a4e92c638b20ad995323967edf3bf407d6a5341b55e47be08f7383f29219"
      },
      "tasks": [
        {
          "id": "965.a",
          "label": "a",
          "modern_task_text_sha256": "0eac9f87731a60c617584d8419de187b88dcaada7f2ae8fbca3fd1be4611eb61",
          "problem_latex": "\\sqrt{64a^{10}b^6}",
          "natural_domain": "a,b in R",
          "requested_domain": "a>0, b>0",
          "derivation": [
            "64a^10b^6=(8a^5b^3)^2, so the root is |8a^5b^3|.",
            "Both a^5 and b^3 are positive under the stated strict conditions.",
            "Therefore the root is 8a^5b^3; zero values of either variable are not part of the requested domain."
          ],
          "answer_latex": "8a^5b^3"
        },
        {
          "id": "965.b",
          "label": "b",
          "modern_task_text_sha256": "2a7b6453a2a0701a8d6cfb00a5932baa3cee72eeefd89a60f3c12b7438405658",
          "problem_latex": "\\sqrt{36x^8y^{36}}",
          "natural_domain": "x,y in R",
          "requested_domain": "x>0, y>0",
          "derivation": [
            "36x^8y^36=(6x^4y^18)^2, so the root is |6x^4y^18|.",
            "Even powers x^4 and y^18 are positive on the requested domain.",
            "Therefore the root is 6x^4y^18; both strict signs are retained."
          ],
          "answer_latex": "6x^4y^{18}"
        },
        {
          "id": "965.c",
          "label": "c",
          "modern_task_text_sha256": "ef29e6b29c5243c35f5db911eb169828df7105fbc727a3a7168e0d9f0d9eaca7",
          "problem_latex": "\\sqrt{25a^{16}x^4}",
          "natural_domain": "a,x in R",
          "requested_domain": "a<0, x>0",
          "derivation": [
            "25a^16x^4=(5a^8x^2)^2, so the root is |5a^8x^2|.",
            "a^8>0 despite a<0, and x^2>0.",
            "Therefore the root is 5a^8x^2 without a minus sign; both zero endpoints stay excluded."
          ],
          "answer_latex": "5a^8x^2"
        },
        {
          "id": "965.d",
          "label": "d",
          "modern_task_text_sha256": "7c5debcaf2967ee02cb02a84d4a25e6590d00964beb03caede0b948b740e5f48",
          "problem_latex": "\\sqrt{81c^{16}x^{10}}",
          "natural_domain": "c,x in R",
          "requested_domain": "c>0, x<0",
          "derivation": [
            "81c^16x^10=(9c^8x^5)^2, so the root is 9c^8|x^5|.",
            "c^8>0 and x^5<0. Thus |x^5|=-x^5.",
            "The root is -9c^8x^5, which is positive; neither strict condition is weakened."
          ],
          "answer_latex": "-9c^8x^5"
        },
        {
          "id": "965.e",
          "label": "e",
          "modern_task_text_sha256": "7040be013d7be214ee1a583f58526df0a6da40d10998047a4b94595805783e8f",
          "problem_latex": "\\sqrt{0.01a^{40}b^{12}}",
          "natural_domain": "a,b in R",
          "requested_domain": "a>0, b<0",
          "derivation": [
            "0.01=1/100, and the radicand is (a^20b^6/10)^2.",
            "The root is |a^20b^6/10|. Both powers are even and positive on the requested domain.",
            "The result is a^20b^6/10, with no minus sign from b<0; both zero endpoints remain excluded."
          ],
          "answer_latex": "\\frac{a^{20}b^6}{10}"
        },
        {
          "id": "965.f",
          "label": "f",
          "modern_task_text_sha256": "d8f5996825a07304659d23d65a4a53bee1a6888793fdc190918aaa8512bdf64c",
          "problem_latex": "\\frac25\\sqrt{6.25x^{14}b^{14}}",
          "natural_domain": "x,b in R",
          "requested_domain": "x<0, b<0",
          "derivation": [
            "6.25=(5/2)^2, so the full expression is (2/5)*(5/2)*|x^7b^7|=|x^7b^7|.",
            "x^7<0 and b^7<0, so their product is positive.",
            "The result is x^7b^7; both strict negative conditions are retained."
          ],
          "answer_latex": "x^7b^7"
        }
      ]
    },
    {
      "number": 966,
      "source_number": "966",
      "source_text_hashes": {
        "modern_text_sha256": "4d04276e138c0f3e867c14648ff34fa1b5eac0a6a525f7bd7bb233575b0e12d6",
        "modern_source_text_sha256": "730eb69a10f67685457ad420268576e74615fe7c0e3bead230159b3775901a60",
        "raw_text_sha256": "730eb69a10f67685457ad420268576e74615fe7c0e3bead230159b3775901a60"
      },
      "tasks": [
        {
          "id": "966.a",
          "label": "a",
          "modern_task_text_sha256": "d825106ada11d99e91c24b6379f6ea29f45f4179fa1b28e269c0c274d6359d55",
          "problem_latex": "\\sqrt{\\frac1{9x^6}}",
          "natural_domain": "x!=0",
          "requested_domain": "x<0",
          "derivation": [
            "The denominator 9x^6 is positive when x!=0.",
            "The root is 1/(3|x^3|). Since x<0, x^3<0 and |x^3|=-x^3.",
            "The result is -1/(3x^3)>0. The zero endpoint is undefined and excluded."
          ],
          "answer_latex": "-\\frac1{3x^3}"
        },
        {
          "id": "966.b",
          "label": "b",
          "modern_task_text_sha256": "37e6d354520e9ac75855665d1cfd975aa619baa069902b319e5733eea91848dc",
          "problem_latex": "\\sqrt{\\frac{a^2}{b^4}}",
          "natural_domain": "a in R, b!=0",
          "requested_domain": "a>0, b<0",
          "derivation": [
            "Because b!=0, the positive denominator permits the quotient rule.",
            "The root is |a|/|b^2|. Under a>0 and b<0, |a|=a and |b^2|=b^2>0.",
            "The result is a/b^2, retaining both strict conditions."
          ],
          "answer_latex": "\\frac{a}{b^2}"
        },
        {
          "id": "966.c",
          "label": "c",
          "modern_task_text_sha256": "60f5ec049647022afdd09bb36843320efca794eff04af931c10854d92a9738a5",
          "problem_latex": "0.2\\sqrt{\\frac{16}{a^4b^8}}",
          "natural_domain": "a!=0, b!=0",
          "requested_domain": "a>0, b>0",
          "derivation": [
            "a^4b^8=(a^2b^4)^2 and a^2b^4>0 on the requested domain.",
            "The full expression is (1/5)*4/|a^2b^4|=4/(5a^2b^4).",
            "Both zero endpoints are excluded; all displayed denominators are nonzero."
          ],
          "answer_latex": "\\frac4{5a^2b^4}"
        },
        {
          "id": "966.d",
          "label": "d",
          "modern_task_text_sha256": "e8fad52dc008ab4ff8f244a9bf93ff46e3eea336b4ce225a9caa0fb96ada628d",
          "problem_latex": "4\\sqrt{\\frac{x^{10}}{36y^6}}",
          "natural_domain": "x in R, y!=0",
          "requested_domain": "x<0, y<0",
          "derivation": [
            "The full expression is 4*|x^5|/(6|y^3|)=(2/3)*|x^5|/|y^3|.",
            "The stated signs give |x^5|=-x^5 and |y^3|=-y^3.",
            "The result is 2x^5/(3y^3)>0, retaining x<0 and y<0."
          ],
          "answer_latex": "\\frac{2x^5}{3y^3}"
        }
      ]
    },
    {
      "number": 967,
      "source_number": "967",
      "source_text_hashes": {
        "modern_text_sha256": "8fcb4c88350a61308e371b6aa1385805f89ecd5c1658b217f2fba52da7a85c77",
        "modern_source_text_sha256": "8fcb4c88350a61308e371b6aa1385805f89ecd5c1658b217f2fba52da7a85c77",
        "raw_text_sha256": "8fcb4c88350a61308e371b6aa1385805f89ecd5c1658b217f2fba52da7a85c77"
      },
      "tasks": [
        {
          "id": "967.whole",
          "label": "whole",
          "modern_task_text_sha256": "8fcb4c88350a61308e371b6aa1385805f89ecd5c1658b217f2fba52da7a85c77",
          "problem_latex": "\\sqrt{ab}",
          "requested_form": "Product of two real radical expressions",
          "natural_domain": "a,b in R, ab>=0",
          "requested_domain": "a>0, b>0",
          "derivation": [
            "Both a and b are positive, so sqrt(a) and sqrt(b) are positive real numbers.",
            "Let s=sqrt(a)*sqrt(b). Then s>0 and s^2=ab.",
            "By uniqueness of the nonnegative square root, s=sqrt(ab).",
            "Thus sqrt(ab)=sqrt(a)*sqrt(b). The original strictly positive conditions are retained."
          ],
          "answer_latex": "\\sqrt a\\cdot\\sqrt b",
          "proof_complete": true
        }
      ]
    },
    {
      "number": 968,
      "source_number": "968",
      "source_text_hashes": {
        "modern_text_sha256": "782cd00e96a8aec754bfbc0a9c7fa600e5eb0ed0adf1b2e2c3edf9980bdb08d6",
        "modern_source_text_sha256": "782cd00e96a8aec754bfbc0a9c7fa600e5eb0ed0adf1b2e2c3edf9980bdb08d6",
        "raw_text_sha256": "782cd00e96a8aec754bfbc0a9c7fa600e5eb0ed0adf1b2e2c3edf9980bdb08d6"
      },
      "tasks": [
        {
          "id": "968.whole",
          "label": "whole",
          "modern_task_text_sha256": "782cd00e96a8aec754bfbc0a9c7fa600e5eb0ed0adf1b2e2c3edf9980bdb08d6",
          "problem_latex": "\\sqrt{\\frac ab}",
          "requested_form": "Quotient of two real radical expressions",
          "natural_domain": "b!=0, a/b>=0",
          "requested_domain": "a<0, b<0",
          "derivation": [
            "Since a<0 and b<0, -a>0 and -b>0, and a/b=(-a)/(-b)>0.",
            "Let s=sqrt(-a)/sqrt(-b). Its denominator is positive and nonzero, and s>0.",
            "Its square is (-a)/(-b)=a/b, so uniqueness of the principal square root proves s=sqrt(a/b).",
            "The real radical quotient is sqrt(-a)/sqrt(-b), not sqrt(a)/sqrt(b).",
            "Both strict negative conditions and the exclusion of zero endpoints are retained."
          ],
          "answer_latex": "\\frac{\\sqrt{-a}}{\\sqrt{-b}}",
          "proof_complete": true
        }
      ]
    },
    {
      "number": 969,
      "source_number": "969",
      "source_text_hashes": {
        "modern_text_sha256": "2516e6c56bf3c7c30f2f83a9cc4eccd624474975a438b23fc3479be1cffd5108",
        "modern_source_text_sha256": "ccee29bcef1a2c6a1de5b316726a9d70e9a28e8917f06194d085b8d31a13a1d8",
        "raw_text_sha256": "ccee29bcef1a2c6a1de5b316726a9d70e9a28e8917f06194d085b8d31a13a1d8"
      },
      "tasks": [
        {
          "id": "969.a",
          "label": "a",
          "modern_task_text_sha256": "5a6715ceddf6de605749e9bd9d4d7ddccec2f489be7bb056994b05eb2a4b585b",
          "problem_latex": "\\sqrt{9(x-2)^2}",
          "requested_form": "Expanded polynomial",
          "natural_domain": "x in R",
          "requested_domain": "x>=2",
          "derivation": [
            "The root is 3|x-2|.",
            "Since x>=2, x-2>=0 and |x-2|=x-2.",
            "Expand: 3(x-2)=3x-6.",
            "The endpoint x=2 is included and both sides equal 0 there."
          ],
          "answer_latex": "3x-6"
