  "solutions": [
    {
      "exercise": "963",
      "answers": {"a": "7.56", "b": "\\frac7{24}", "c": "9.1", "d": "1.08", "e": "128", "f": "108"},
      "derivations": {
        "a": "sqrt(196*0.81*0.36)=14*0.9*0.6=7.56.",
        "b": "The mixed numbers are 25/16 and 49/9. Their product times 1/100 is 1225/14400=(35/120)^2, so the root is 7/24.",
        "c": "sqrt((0.87+0.82)*49)=sqrt(1.69*49)=1.3*7=9.1.",
        "d": "sqrt(1.44*(1.21-0.4))=sqrt(1.44*0.81)=1.2*0.9=1.08.",
        "e": "146.5^2-109.5^2=(146.5-109.5)(146.5+109.5)=37*256. Adding 27*256 gives 64*256=128^2.",
        "f": "117.5^2-26.5^2=(117.5-26.5)(117.5+26.5)=91*144. Subtracting 1440=10*144 leaves 81*144=108^2."
      }
    },
    {
      "exercise": "964",
      "answers": {"a": "\\frac{17}{2}", "b": "\\frac7{96}", "c": "\\frac{15}{29}", "d": "\\frac{77}{135}"},
      "derivations": {
        "a": "(165^2-124^2)/164=(41*289)/(4*41)=289/4, whose principal root is 17/2.",
        "b": "176^2-112^2=64*288=18432, so 98/18432=49/9216=(7/96)^2.",
        "c": "(149^2-76^2)/(457^2-384^2)=(73*225)/(73*841)=225/841=(15/29)^2.",
        "d": "(145.5^2-96.5^2)/(193.5^2-31.5^2)=(49*242)/(162*225)=5929/18225=(77/135)^2."
      },
      "denominator_check": "All four fixed denominators are strictly positive."
    },
    {
      "exercise": "965",
      "answers": {
        "a": "8a^5b^3",
        "b": "6x^4y^{18}",
        "c": "5a^8x^2",
        "d": "-9c^8x^5",
        "e": "0.1a^{20}b^6",
        "f": "x^7b^7"
      },
      "derivations": {
        "a": "sqrt(64a^10b^6)=8|a^5b^3|; a>0,b>0 make the inside product positive.",
        "b": "sqrt(36x^8y^36)=6|x^4y^18|=6x^4y^18, since both powers are even.",
        "c": "sqrt(25a^16x^4)=5|a^8x^2|=5a^8x^2 even though the given a is negative.",
        "d": "sqrt(81c^16x^10)=9|c^8x^5|. With c>0,x<0, c^8x^5 is negative, giving -9c^8x^5.",
        "e": "sqrt(0.01a^40b^12)=0.1|a^20b^6|=0.1a^20b^6.",
        "f": "(2/5)sqrt(6.25x^14b^14)=(2/5)*(5/2)|x^7b^7|. Both x and b are negative, so x^7b^7>0 and the result is x^7b^7."
      }
    },
    {
      "exercise": "966",
      "answers": {"a": "-\\frac1{3x^3}", "b": "\\frac a{b^2}", "c": "\\frac{0.8}{a^2b^4}", "d": "\\frac{2x^5}{3y^3}"},
      "derivations": {
        "a": "sqrt(1/(9x^6))=1/(3|x^3|). The given x<0 gives |x^3|=-x^3.",
        "b": "sqrt(a^2/b^4)=|a|/b^2=a/b^2 because a>0; b<0 guarantees a nonzero denominator.",
        "c": "0.2sqrt(16/(a^4b^8))=0.2*4/(a^2b^4)=0.8/(a^2b^4). Given a>0,b>0 keep the denominator positive.",
        "d": "4sqrt(x^10/(36y^6))=2|x^5|/(3|y^3|). With x<0,y<0, both odd powers are negative, and the two sign changes cancel."
      }
    },
    {
      "exercise": "967",
      "answers": {"main": "\\sqrt a\\sqrt b"},
      "derivation": "For the stated a>0,b>0, both real roots exist and their nonnegative product has square ab. Thus sqrt(ab)=sqrt(a)sqrt(b), the requested product of two roots."
    },
    {
      "exercise": "968",
      "answers": {"main": "\\frac{\\sqrt{-a}}{\\sqrt{-b}}"},
      "derivation": "The given a<0,b<0 make -a,-b positive and a/b=(-a)/(-b)>0. The nonnegative quotient sqrt(-a)/sqrt(-b) is defined and its square equals a/b. Using sqrt(a)/sqrt(b) would be invalid over the reals."
    },
    {
      "exercise": "969",
      "answers": {"a": "3x-6", "b": "6-2y", "c": "a^3+2a^2+a", "d": "-b^3+2b^2-b"},
      "derivations": {
        "a": "sqrt(9(x-2)^2)=3|x-2|=3(x-2) because x>=2.",
        "b": "sqrt(4(y-3)^2)=2|y-3|=2(3-y) because y<3.",
        "c": "sqrt(a^2(a+1)^4)=|a|(a+1)^2=a(a+1)^2 because a>0; expand to the requested polynomial.",
        "d": "sqrt(b^2(b-1)^4)=|b|(b-1)^2=-b(b-1)^2 because b<0; expand to the requested polynomial."
      }
    },
    {
      "exercise": "970",
      "answers": {"a": "\\frac1{x-3}", "b": "-\\frac3{y+7}", "c": "\\frac p{p-4}", "d": "\\frac q{q+5}"},
      "derivations": {
        "a": "sqrt(1/(x-3)^2)=1/|x-3|=1/(x-3) under x>3.",
        "b": "sqrt(9/(y+7)^2)=3/|y+7|=-3/(y+7) under y<-7.",
        "c": "sqrt(p^2/(p-4)^2)=|p|/|p-4|. Under p<0, both p and p-4 are negative, so the signs cancel.",
        "d": "sqrt(q^2/(q+5)^2)=|q|/|q+5|. Under q<-5, both q and q+5 are negative, so the signs cancel."
      },
      "production_task_note": "Every result is a fraction whose numerator and denominator are polynomials; the source strict domains prevent zero denominators."
    }
  ]
}
