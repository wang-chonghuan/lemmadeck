    "-B",
    "-c",
    "import json, sys\nsys.path.insert(0, \".claude/skills/ld-s10y-lesson/tools\")\nimport edition\npayload = json.load(sys.stdin)\nedition.normalize_lesson_layout(payload[\"lesson\"])\nedition.normalize_exercise_layout(payload[\"exercises\"])\nchecks = []\nfor kind, key in [(\"lesson\", \"prose\"), (\"exercises\", \"exercises\")]:\n    for index, item in enumerate(payload[kind][key]):\n        if kind == \"lesson\" and item[\"kind\"] != \"p\":\n            continue\n        errors = edition.validate_text(item[\"source_text\"], item[\"text\"], item[\"changes\"], item[\"numeric_changes\"], f\"{kind}[{index}]\", [], item[\"historical_entities\"])\n        if kind == \"exercises\":\n            errors += edition.validate_numbered_subpart_layout(item[\"text\"])\n        checks.append({\"target\": f\"{kind}[{index}]\", \"errors\": errors, \"mathSignaturePreserved\": edition.math_signature(item[\"source_text\"]) == edition.math_signature(item[\"text\"]), \"numberSignaturePreserved\": edition.number_signature(item[\"source_text\"]) == edition.number_signature(item[\"text\"])})\nprint(json.dumps({\"lesson\": payload[\"lesson\"], \"exercises\": payload[\"exercises\"], \"checks\": checks, \"module\": edition.__file__, \"python\": sys.executable}, ensure_ascii=False, indent=2))"
  ],
