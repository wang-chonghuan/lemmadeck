  "chapter": "第四章 二次根式和二次方程",
  "section": "§10. 二次根式",
  "number": "29",
  "title": "有理数",
  "printed_title": "29. 有理数",
  "start_page": 195,
  "start_printed": 189,
  "figures": [
    {
      "id": "fig-40",
      "label": "图 40",
      "page": 195
