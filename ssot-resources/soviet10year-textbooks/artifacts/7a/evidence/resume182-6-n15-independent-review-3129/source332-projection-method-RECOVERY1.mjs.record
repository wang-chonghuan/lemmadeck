import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/ld-s10y-lesson/resume182-6-3129/N15-independent-review-20261122-FIRST';
const input = `${base}/author/seed.json`;
const bytes = fs.readFileSync(input);
const hash = value => crypto.createHash('sha256').update(value).digest('hex');
assert.equal(hash(bytes), 'ed018c67b3a17f8ba95ee97f33e531a23af609a2c6dd6b55493560ffd6e707b0');
const seed = JSON.parse(bytes);
const exercise = seed.exercises.find(item => item.number === '332');
assert.ok(exercise);
const output = `${base}/source332-qualification-RECOVERY1`;
assert.ok(!fs.existsSync(output), 'Preserve earlier findings and projections');
fs.mkdirSync(output, { recursive: true });
const projection = {
  schema: 'stemrobin-182/actual-single-source-projection@1',
  book: '7a', lesson: 'alg7-c2-s1-n15',
  seedCanonicalSha256: '7b2d73ad2e10625c103400d9b7bcb902f64ddb56fbcc95d49222c08b280c71cd',
  actualSeedFileSha256: hash(bytes),
  exercise,
  projectionMethod: 'Exact unchanged source332 fields from the originally frozen seed; no mathematical reconstruction or source rewrite.',
  sourceAuthority: 'Original exercise prose, not the predecessor source-solving task summary.',
  qualificationNeeded: 'The predecessor added equality identification to its task list; the actual source prose must govern whether that is a required target.',
  earlierFidelityRevisePreserved: true,
  originalDraftChanged: false,
  authorKeyDisclosed: false,
  otherSourcesProjected: 0,
  newSourceSolves: 0,
  newImageReads: 0,
  nativeValidateRenderBrowserDbCalls: 0,
  fees: 'UNKNOWN', tokens: 'UNKNOWN', finish: 'review',
};
const projected = Buffer.from(`${JSON.stringify(projection, null, 2)}\n`);
const file = `${output}/source332-only.json`;
fs.writeFileSync(file, projected, { flag: 'wx', mode: 0o444 });
console.log(JSON.stringify({ path: file, sha256: hash(projected), bytes: projected.length }));
