"""Stage only N15 genuine independent review, current binding and checkpoint."""

from pathlib import Path

repo = Path("/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck")
assert Path.cwd() == repo
base = repo / ".tmp/ld-s10y-lesson/resume182-6-3129"
original = base / "stage-and-check-N1-FIRST.py"
code = original.read_text()
for before, after in [
    ("/artifacts/8a/", "/artifacts/7a/"),
    ("alg8-c1-s1-n1", "alg7-c2-s1-n15"),
    ("resume182-6-n1-independent-review-3129", "resume182-6-n15-independent-review-3129"),
    ('assert binding["options"] == 21', 'assert binding["options"] == 78'),
    ("N1_NARROW_STAGED_RESOURCE_RULES_PASS", "N15_NARROW_STAGED_RESOURCE_RULES_PASS"),
    (
        'allowed = [f"{TARGET}/review.json", f"{TARGET}/independent-review-binding.json", EVIDENCE, PROGRESS]',
        'allowed = [f"{TARGET}/review.json", f"{TARGET}/retention.json", '
        'f"{TARGET}/independent-review-binding.json", EVIDENCE, PROGRESS]',
    ),
]:
    assert before in code, before
    code = code.replace(before, after)
evidence = repo / "ssot-resources/soviet10year-textbooks/artifacts/7a/evidence/resume182-6-n15-independent-review-3129"
for source, name in [
    (original, "stage-base-method-FIRST.py.record"),
    (Path(__file__), "stage-owner-method-FIRST.py.record"),
]:
    with (evidence / name).open("xb") as output:
        output.write(source.read_bytes())
    (evidence / name).chmod(0o444)
exec(compile(code, str(Path(__file__)), "exec"), globals())
