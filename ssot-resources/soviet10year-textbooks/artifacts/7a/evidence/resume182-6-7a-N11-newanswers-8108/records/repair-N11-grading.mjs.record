import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-8108/lemmadeck';
assert.equal(process.cwd(), repo);
const work = path.join(repo, '.tmp/ld-s10y-lesson/resume182-6-8108');
const file = path.join(repo, 'ssot-resources/soviet10year-textbooks/artifacts/7a/editions/modern-us-neutral/lessons/alg7-c1-s4-n11/answer-keys.json');
const original = fs.readFileSync(file);
assert.equal(crypto.createHash('sha256').update(original).digest('hex'), '94c59181ad779b72ce00cdbc6fae41bca683e3f02606b18b79b7cc5d1c2fbe68');
const data = JSON.parse(original);
const affected = new Set(['135', '136', '137', '138', '139', '147']);
for (const answer of data.answers) {
  if (!affected.has(answer.exercise)) continue;
  assert.equal(answer.grading, 'auto');
  answer.grading = 'ungraded';
  answer.parts = [];
}
assert.equal(data.answers.filter(a => a.grading === 'auto').length, 8);
assert.equal(data.answers.filter(a => a.grading === 'ungraded').length, 8);
const bytes = Buffer.from(`${JSON.stringify(data, null, 2)}\n`);
const candidate = path.join(work, 'answers-7a-N11-candidate-GRADING-RECOVERY1.json');
fs.writeFileSync(candidate, bytes, { flag: 'wx' });
fs.chmodSync(candidate, 0o444);
fs.writeFileSync(file, bytes);
const record = {
  at: new Date().toISOString(),
  scope: [...affected],
  reason: 'Open transformation tasks require a mathematical output form. Finite exact keys reject legitimate equivalent forms, while expression equality cannot enforce the requested fraction/product/power form. Keep complete standard answers but do not auto-grade those tasks.',
  originalCandidate: 'answers-7a-N11-candidate-FIRST.json',
  originalReview: 'answers-7a-N11-review-FIRST/review-FIRST.record',
  candidate: { path: candidate, bytes: bytes.length, sha256: crypto.createHash('sha256').update(bytes).digest('hex') },
  unchangedDisplayAnswers: data.answers.every((a, i) => a.displayAnswer === JSON.parse(original).answers[i].displayAnswer),
  mathematicalRevisions: 0,
  newImages: 0,
  auto: 8,
  ungraded: 8,
  parts: data.answers.reduce((n, a) => n + a.parts.length, 0),
  nativeFinalizeCalls: 0,
  hostTokenUsageAndCost: null,
};
assert.equal(record.unchangedDisplayAnswers, true);
const output = path.join(work, 'answers-7a-N11-grading-GRADING-RECOVERY1.record');
fs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(record));
