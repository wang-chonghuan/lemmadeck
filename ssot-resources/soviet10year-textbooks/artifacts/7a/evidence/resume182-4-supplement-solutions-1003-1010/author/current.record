            "Since 2 is nonzero, the roots are x=8/3 and x=4."
          ]
        },
        {
          "id": "alg7-c4-ex1003-d",
          "part": "d",
          "equation": "(4x+5)^2=5x^2+4x",
          "domain": "x in R; no excluded values.",
