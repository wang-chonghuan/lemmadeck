  "exercises": [
    {
      "number": 1003,
      "source_pages": ["p0300#7", "p0301#1"],
      "request": "Find all real x for which each equality holds.",
      "tasks": [
        {
          "id": "alg7-c4-ex1003-a",
          "part": "a",
          "equation": "(5x+3)^2=5(x+3)",
          "domain": "x in R; both sides are polynomials with no excluded values.",
          "exact_result": "x in {-6/5,1/5}",
          "derivation": [
            "Move the right side to the left: 25x^2+30x+9-5x-15=25x^2+25x-6.",
            "Factor: (5x-1)(5x+6)=0.",
            "The two factors give x=1/5 or x=-6/5. The polynomial transformations are equivalences, so both and only these values satisfy the original equality."
          ]
        },
        {
          "id": "alg7-c4-ex1003-b",
          "part": "b",
          "equation": "(3x+10)^2=3(x+10)",
          "domain": "x in R; no excluded values.",
          "exact_result": "x in {-14/3,-5/3}",
          "derivation": [
            "Subtract the right side: 9x^2+60x+100-3x-30=9x^2+57x+70.",
            "Factor: (3x+5)(3x+14)=0.",
            "Thus x=-5/3 or x=-14/3, with no extra or lost solutions."
          ]
        },
        {
          "id": "alg7-c4-ex1003-c",
          "part": "c",
          "equation": "(3x-8)^2=3x^2-8x",
          "domain": "x in R; no excluded values.",
          "exact_result": "x in {8/3,4}",
          "derivation": [
            "Subtract: 9x^2-48x+64-3x^2+8x=6x^2-40x+64.",
