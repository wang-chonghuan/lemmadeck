    {
      "id": "alg7-c4-ex1010", "exercise": 1010, "source_part": null,
      "statement": "Prove that the roots of cx^2+bx+a=0, c!=0, are the reciprocals of the roots of ax^2+bx+c=0, a!=0.",
      "domain": "a,b,c in R; a!=0 and c!=0 simultaneously; roots are nonzero real numbers.",
      "method": "Establish g(x)=x^2*f(1/x), exclude zero roots, and prove both directions.",
      "polynomials": {"f": "at^2+bt+c", "g": "cx^2+bx+a"},
      "zero_root_exclusions": ["f(0)=c!=0", "g(0)=a!=0"],
      "identity": "For x!=0, x^2*f(1/x)=a+bx+cx^2=g(x).",
      "correspondence": "r in roots(f) iff 1/r in roots(g); taking reciprocals twice is the identity.",
      "shared_discriminant": "b^2-4ac",
      "real_root_branches": [
        "D<0: both real root sets are empty, and the correspondence holds.",
        "D=0: both have one repeated nonzero real root; these roots are reciprocal.",
        "D>0: both have two distinct nonzero real roots; reciprocation pairs them bijectively."
      ],
      "multiplicity_certificate": "If f(t)=a(t-r1)(t-r2), then r1*r2=c/a and g(x)=a(1-r1*x)(1-r2*x)=c(x-1/r1)(x-1/r2).",
