import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const root = 'ssot-resources/soviet10year-textbooks/artifacts/7a';
const edition = `${root}/editions/modern-us-neutral`;
const lesson = 'alg7-c4-s1-n29';
const own = '.tmp/resume182-6-7a-n29-stage3695-FIRST';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const run = (args, input) => {
  const result = spawnSync('git', args, { input, encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });
  assert.equal(result.status, 0, result.stderr);
  return result.stdout;
};
const json = file => JSON.parse(fs.readFileSync(file));
const save = (name, value) => fs.writeFileSync(`${own}/${name}`,
  `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
assert.equal(json(`${edition}/lessons/${lesson}/offline-display.json`).status, 'OFFLINE_DISPLAY_PASS');
assert.equal(run(['diff', '--cached', '--name-only']), '', 'Preserve any previously staged work');
fs.mkdirSync(own);
const selected = new Set(['.intentfold/tickets/STEMROBIN-182/progress.md', `${root}/pages/0196/audit.json`]);
const addTree = directory => {
  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
    const file = path.join(directory, entry.name);
    if (entry.isDirectory()) addTree(file);
    else {
      assert.ok(entry.isFile(), `Not an actual regular file: ${file}`);
      selected.add(file);
    }
  }
};
for (const base of [root, edition]) addTree(`${base}/lessons/${lesson}`);
for (const id of ['fig-40', 'fig-41']) {
  for (const suffix of ['png', 'svg']) selected.add(`${root}/figures/${id}.${suffix}`);
  for (const suffix of ['svg', 'spec.json', 'render.json', 'review.json'])
    selected.add(`${edition}/figures/${id}.${suffix}`);
}
for (const name of fs.readdirSync(`${root}/evidence`).sort()) {
  if (!name.startsWith('resume182-6-n29-')) continue;
  const directory = `${root}/evidence/${name}`;
  addTree(directory);
  const retention = `${directory}/retention.record`;
  if (!fs.existsSync(retention)) continue;
  for (const entry of json(retention).entries) {
    assert.ok(/^ssot-resources\/soviet10year-textbooks\/artifacts\/(?:6a|7a|8a)\//.test(entry.path));
    assert.equal(sha(fs.readFileSync(entry.path)), entry.sha256);
    if (run(['ls-files', '--', entry.path]).trim()) continue;
    assert.ok(entry.path.startsWith(`${root}/evidence/`), `Uncommitted other-lesson content: ${entry.path}`);
    selected.add(entry.path);
  }
}
const indexes = [];
for (const file of [`${root}/book.json`, `${edition}/book.json`]) {
  const workingBytes = fs.readFileSync(file);
  const current = JSON.parse(workingBytes);
  const oldBytes = run(['show', `HEAD:${file}`]);
  const previous = JSON.parse(oldBytes);
  assert.equal(previous.lessons.filter(item => item.id === lesson).length, 0);
  const target = current.lessons.filter(item => item.id === lesson);
  assert.equal(target.length, 1);
  for (const entry of previous.lessons) assert.deepEqual(
    current.lessons.find(item => item.id === entry.id), entry, `Changed old index entry: ${entry.id}`);
  const staged = structuredClone(previous);
  staged.lessons = current.lessons.filter(item => item.id === lesson
    || previous.lessons.some(old => old.id === item.id));
  const bytes = Buffer.from(`${JSON.stringify(staged, null, 2)}\n`);
  const label = file === `${root}/book.json` ? 'raw' : 'modern';
  fs.writeFileSync(`${own}/${label}-working-before.record`, workingBytes, { flag: 'wx' });
  fs.writeFileSync(`${own}/${label}-staged.record`, bytes, { flag: 'wx' });
  const oid = run(['hash-object', '-w', '--stdin'], bytes).trim();
  run(['update-index', '--cacheinfo', `100644,${oid},${file}`]);
  assert.equal(sha(fs.readFileSync(file)), sha(workingBytes), 'Working index must remain untouched');
  indexes.push({ path: file, oid, workingSha256: sha(workingBytes), stagedSha256: sha(bytes),
    previousLessons: previous.lessons.length, stagedLessons: staged.lessons.length,
    excludedWorkingEntries: current.lessons.filter(item => !staged.lessons.some(row => row.id === item.id)).map(item => item.id) });
}
run(['add', '--', ...[...selected].sort()]);
save('staged-scope.record', { status: 'N29_ONLY_STAGED_WITH_REQUIRED_EVIDENCE_BYTES',
  files: [...selected].sort(), indexes, n30WorkingBytesPreserved: true,
  newContentReviews: 0, DBWrites: 0, merge: false, deployment: false, commitPending: true });
console.log(JSON.stringify({ status: 'N29_STAGED', files: selected.size + indexes.length, indexes }));
