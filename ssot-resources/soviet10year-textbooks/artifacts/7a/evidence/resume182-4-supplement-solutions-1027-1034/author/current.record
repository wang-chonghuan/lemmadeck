          "id": "1028a",
          "status": "multiple_physical_solutions",
          "source_quote": "甲队比乙队每天少耕地$3$公顷，但仍甲比乙队提前 $2$ 天完成生产任务。",
          "variables": "x 为甲每天耕地公顷数，乙为 x+3。",
          "domain": "x > 0; both durations positive.",
          "timeline": [
            "乙的总任务以甲的 240 公顷为百分比基数，为 240(1+35%)=324 公顷。",
            "共同从 t=0 开始，甲完成时刻为 240/x，乙为 324/(x+3)。",
            "乙完成时刻减甲完成时刻为 2 天。"
          ],
          "equations": ["324/(x+3)-240/x=2", "x^2-39x+360=0"],
          "steps": [
            "消去正分母，得 (x-15)(x-24)=0。",
            "x=15 时，乙每天 18 公顷，甲乙分别用 16、18 天。",
            "x=24 时，乙每天 27 公顷，甲乙分别用 10、12 天。",
            "两组均满足原数值、正数定义域和提前 2 天条件，无据删除其中一组。"
          ],
          "polynomial": {"variable": "x", "coefficients": [1, -39, 360]},
          "cases": [
            {"x": 15, "rate_a": 15, "rate_b": 18, "area_a": 240, "area_b": 324, "time_a": 16, "time_b": 18},
            {"x": 24, "rate_a": 24, "rate_b": 27, "area_a": 240, "area_b": 324, "time_a": 10, "time_b": 12}
          ],
          "rejected_roots": [],
          "requested": [
            {"name": "甲队每日耕地量", "unit": "公顷/天", "case_field": "rate_a"},
            {"name": "乙队每日耕地量", "unit": "公顷/天", "case_field": "rate_b"}
          ],
          "conclusion": "甲乙每日耕地量可以为 (15,18)，也可以为 (24,27) 公顷；条件不唯一。",
          "fault_ids": ["1028a-known-literal-risk"]
        },
        {
