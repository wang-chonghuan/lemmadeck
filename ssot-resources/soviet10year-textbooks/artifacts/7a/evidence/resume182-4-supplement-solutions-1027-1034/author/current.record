      "tasks": [
        {
          "id": "1027a",
          "status": "unique",
          "variables": "T 为共同计划期限，a、b 为甲乙日产量。",
          "domain": "T > 2; a > 0; b > 0.",
          "timeline": [
            "两厂从 t=0 开始。甲在 t=T-2 完成 720 台。",
            "乙在 t=T-1 已产 660+22=682 台；乙实际产量不是 660。",
            "两个工作区间同属一个计划时间轴，a-b=10。"
          ],
          "equations": ["a(T-2)=720", "b(T-1)=682", "a-b=10", "720/(T-2)-682/(T-1)=10"],
          "steps": [
            "在 T>2 内消去非零分母，得 5T^2-34T-312=0。",
            "(T-12)(5T+26)=0；负期限 -26/5 不可用。",
            "T=12，甲实际工作 10 天，乙实际工作 11 天；a=72，b=62。"
          ],
          "polynomial": {"variable": "T", "coefficients": [5, -34, -312]},
          "cases": [
            {"T": 12, "a": 72, "b": 62, "time_a": 10, "time_b": 11, "output_a": 720, "output_b": 682}
          ],
          "rejected_roots": [{"value": -5.2, "exact": "-26/5", "reason": "T<=2; nonphysical durations."}],
          "requested": [
            {"name": "甲厂日产量", "unit": "台/天", "case_field": "a"},
            {"name": "乙厂日产量", "unit": "台/天", "case_field": "b"}
          ],
          "conclusion": "甲厂每天 72 台，乙厂每天 62 台。",
          "fault_ids": []
        },
        {
          "id": "1027b",
          "status": "conditional",
          "variables": "T 为共同期限，a、b 为甲乙日产量。",
          "domain": "T > 3; a > 0; b > 0.",
          "assumption": "题中的 240 个按每组各 240 个理解，而不是两组合计 240 个。原句未明确写出每组。",
          "timeline": [
            "甲从 t=0 工作到 T-3。",
            "乙比甲晚 1 天完成，即从 t=0 工作到 T-2，而不是 T-4。",
            "在每组各 240 个这一假设下，两组分别完成相同数量。"
          ],
          "equations": ["a(T-3)=240", "b(T-2)=240", "a-b=8", "240/(T-3)-240/(T-2)=8"],
          "steps": [
            "(T-3)(T-2)=30，得 T^2-5T-24=0。",
            "(T-8)(T+3)=0，舍去负期限 -3。",
            "T=8，甲工作 5 天、乙工作 6 天，日产量分别为 48 和 40。"
          ],
          "polynomial": {"variable": "T", "coefficients": [1, -5, -24]},
          "cases": [{"T": 8, "a": 48, "b": 40, "time_a": 5, "time_b": 6, "output_a": 240, "output_b": 240}],
          "rejected_roots": [{"value": -3, "exact": "-3", "reason": "T<=3."}],
          "alternative_literal_model": {
            "interpretation": "两组合计生产 240 个。",
            "equations": ["a=b+8", "a(T-3)+b(T-2)=240"],
            "parameterization": "令 u=T-3，则 0<u<30，b=(240-8u)/(2u+1)，a=b+8；因此 3<T<33。",
            "examples": [
              {"T": 8, "a": 288, "b": 200, "rate_denominator": 11, "time_a": 5, "time_b": 6},
              {"T": 9, "a": 296, "b": 192, "rate_denominator": 13, "time_a": 6, "time_b": 7}
            ],
            "example_rate_note": "Examples store a and b as numerators divided by rate_denominator, not as integer rates.",
            "conclusion": "若 240 是合计数，期限不唯一；不能无条件给出 8 天。"
          },
          "requested": [{"name": "完成任务的规定期限", "unit": "天", "case_field": "T"}],
          "conclusion": "仅在每组各 240 个的解释下，规定期限为 8 天；合计 240 个的字面解释不确定。",
          "fault_ids": ["1027b-target-ambiguity"]
        }
      ]
    },
