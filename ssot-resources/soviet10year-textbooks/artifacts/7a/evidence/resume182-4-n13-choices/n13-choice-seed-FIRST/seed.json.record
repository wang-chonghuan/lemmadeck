  "exercises": [
    {
      "number": "168",
      "text": "168. \u4e0b\u5217\u5404\u6570\u662f\u5426\u5df2\u7ecf\u5199\u6210\u4e86\u6807\u51c6\u5f62\u5f0f\uff1f\u5982\u679c\u4e0d\u662f\uff0c\u5219\u628a\u5b83\u4eec\u6539\u5199\u6210\u6807\u51c6\u5f62\u5f0f\u3002\u6307\u51fa\u5404\u6570\u7684\u6570\u91cf\u7ea7\u3002\na) $3.4\\cdot10^8$\uff1b\nb) $7.51\\cdot10^5$\uff1b\nc) $10.6\\cdot10^9$\uff1b\nd) $5.2\\cdot10^{-4}$\uff1b\ne) $19\\cdot10^{-6}$\uff1b\nf) $0.4\\cdot10^{-8}$\u3002",
      "figure_ids": []
    },
    {
      "number": "169",
      "text": "169. \u628a\u4e0b\u5217\u5404\u6570\u5199\u6210\u6807\u51c6\u5f62\u5f0f\u5e76\u6307\u51fa\u5b83\u4eec\u7684\u6570\u91cf\u7ea7\uff1a\na) $7000000000$\uff1b\nb) $25860000000$\uff1b\nc) $307920000000$\uff1b\nd) $0.02$\uff1b\ne) $0.0013$\uff1b\nf) $0.000057$\uff1b\ng) $1\\frac{1}{40}\\cdot10^{-5}$\uff1b\nh) $\\frac{1}{6}\\cdot10^{-7}$\uff1b\ni) $\\frac{1}{700000}$\u3002",
      "figure_ids": []
    },
    {
      "number": "170",
      "text": "170. \u628a\u539f\u6559\u6750\u4e0b\u5217\u8bed\u53e5\u4e2d\u7ed9\u5b9a\u7684\u6570\u5199\u6210\u6807\u51c6\u5f62\u5f0f\uff1a\na) \u5730\u7403\u7684\u8868\u9762\u79ef\u4e3a $510083000$ \u5e73\u65b9\u516c\u91cc\uff1b\nb) \u5730\u7403\u7684\u8d28\u91cf\u7b49\u4e8e $6000000000000000000000$ \u5428\uff1b\nc) \u4e00\u4e2a\u4eba\u662f\u7531\u591a\u4e8e $100000000000000$ \u4e2a\u7ec6\u80de\u6784\u6210\u7684\uff1b\nd) \u6c22\u539f\u5b50\u7684\u8d28\u91cf\u4e3a $0.0000000000000000000000017$ \u514b\uff1b\ne) \u5149\u7ebf\u5728\u771f\u7a7a\u4e2d\u6bcf $\\frac{1}{300000}$ \u79d2\u7ecf\u8fc7\u7684\u8ddd\u79bb\u4e3a $1$ \u516c\u91cc\u3002",
      "figure_ids": []
    },
    {
      "number": "171",
      "text": "171. \u628a\u4e0b\u5217\u8d28\u91cf\u7528\u514b\u6765\u8868\u793a\u5e76\u628a\u6240\u5f97\u7684\u6570\u5199\u6210\u6807\u51c6\u5f62\u5f0f\uff1a\na) $969.5$ \u516c\u65a4\uff1b\nb) $43.2$ \u5428\uff1b\nc) $78$ \u6beb\u514b\u3002",
      "figure_ids": []
    },
    {
      "number": "172",
      "text": "172. \u628a\u4e24\u4e2a\u7b54\u6848\u90fd\u5199\u6210\u6807\u51c6\u5f62\u5f0f\u3002\na) \u7528\u5e73\u65b9\u6beb\u7c73\u8868\u793a $378$ \u5e73\u65b9\u7c73\u7684\u9762\u79ef\uff1b\nb) \u7528\u5e73\u65b9\u7c73\u8868\u793a$25$\u5e73\u65b9\u6beb\u7c73\u7684\u9762\u79ef\u3002",
      "figure_ids": []
    },
    {
      "number": "173",
      "text": "173. \u4e0b\u5217\u5404\u5f0f\u7684\u503c\u5728\u5c0f\u6570\u70b9\u540e\u6709\u591a\u5c11\u4f4d\uff1f\na) $3\\cdot10^{-2}$\uff1b\nb) $2.8\\cdot10^{-2}$\uff1b\nc) $1.31\\cdot10^{-6}$\uff1b\nd) $5.679\\cdot10^{-10}$\u3002",
      "figure_ids": []
    },
    {
      "number": "174",
      "text": "174. \u5b8c\u6210\u4e0b\u5217\u8fd0\u7b97\uff1a\na) $(1.25\\cdot10^6)\\cdot(4\\cdot10^{12})$\uff1b\nb) $(6.2\\cdot10^{-2}):(3.1\\cdot10^4)$\uff1b\nc) $(4.2\\cdot10^{-3})\\cdot(5.5\\cdot10^8)$\uff1b\nd) $10^5:(8\\cdot10^{-2})$\uff1b\ne) $(6.1\\cdot10^{10}):(2.7\\cdot10^{12})$\uff1b\nf) $(3\\cdot10^{-15}):(7\\cdot10^{-6})$\u3002",
      "figure_ids": []
    },
    {
      "number": "175",
      "text": "175. \u4e0d\u7b97\u51fa\u5177\u4f53\u6570\u76f4\u63a5\u8bf4\u51fa\u79ef $ab$ \u7684\u6570\u91cf\u7ea7\uff1a\na) $a=2\\cdot10^{-6}$\uff0c$b=3\\cdot10^{-5}$\uff1b\nb) $a=3.1\\cdot10^8$\uff0c$b=1.5\\cdot10^{-3}$\uff1b\nc) $a=6\\cdot10^{-3}$\uff0c$b=2\\cdot10^{10}$\uff1b\nd) $a=9.1\\cdot10^{12}$\uff0c$b=8\\cdot10^6$\u3002",
      "figure_ids": []
    },
    {
      "number": "176",
      "text": "176. \u6b63\u6570 $b$ \u7684\u6570\u91cf\u7ea7\u7b49\u4e8e $7$\u3002\u4e0b\u5217\u5404\u6570\u7684\u6570\u91cf\u7ea7\u662f\u591a\u5c11\uff1f\na) $100b$\uff1b\nb) $0.01b$\uff1b\nc) $b\\cdot10^6$\uff1b\nd) $b\\cdot10^{-7}$\u3002",
      "figure_ids": []
    },
    {
      "number": "177",
      "text": "177. \u5149\u7ebf\u5728\u771f\u7a7a\u4e2d\u7684\u4f20\u64ad\u901f\u5ea6\u4e3a $3\\cdot10^8$ \u7c73/\u79d2\u3002\u5149\u7ebf\u5728\u4e0b\u5217\u65f6\u95f4\u5185\u7ecf\u8fc7\u7684\u8ddd\u79bb\u662f\u591a\u5c11\uff1f\uff08\u4ee5\u7c73\u4e3a\u5355\u4f4d\uff09\u3002\na) $1000$ \u79d2\uff1b\nb) $0.01$ \u79d2\uff1b\nc) $1$ \u5c0f\u65f6\u3002",
      "figure_ids": []
    },
    {
      "number": "178",
      "text": "178. \u539f\u6559\u6750\u7ed9\u51fa\u4ee5\u4e0b\u4f30\u8ba1\u548c\u9884\u6d4b\uff1a\u516c\u5143\u521d\u5e74\u5730\u7403\u4e0a\u7684\u4eba\u53e3\u603b\u6570\u7ea6\u4e3a$2\\cdot10^8$\u4eba\u3002\u539f\u6559\u6750\u9884\u6d4b\uff0c\u5230 $2000$ \u5e74\uff0c\u5730\u7403\u4e0a\u7684\u4eba\u53e3\u5c06\u589e\u52a0\u5230\u516c\u5143\u521d\u5e74\u4eba\u53e3\u7684 $37$ \u500d\u3002\u9884\u8ba1 $2000$ \u5e74\u5730\u7403\u4e0a\u7684\u4eba\u53e3\u5c06\u4e3a\u591a\u5c11\u4eba\uff1f",
      "figure_ids": []
    },
    {
      "number": "179",
      "text": "179. \u6309\u539f\u6559\u6750\u7ed9\u5b9a\u7684\u5386\u53f2\u6570\u636e\uff1a\u82cf\u8054\u6700\u65e9\u7684\u7535\u5b50\u8ba1\u7b97\u673a\u4e4b\u4e00BESM-2\uff08\u516d\u5341\u5e74\u4ee3\u4e2d\u671f\uff09\u6bcf\u79d2\u949f\u80fd\u8fd0\u7b97$8\\cdot10^3$\u6b21\u3002\u7535\u5b50\u8ba1\u7b97\u673aEC-10-50\uff08$1975$\u5e74\uff09\uff0c\u6bcf\u79d2\u949f\u80fd\u8fd0\u7b97$1.5\\cdot10^6$\u6b21\u3002\u5728 $1975$ \u5e74\u82cf\u8054\u7535\u5b50\u8ba1\u7b97\u673a\u7684\u8fd0\u7b97\u901f\u5ea6\uff08\u6bcf\u79d2\u6240\u5b8c\u6210\u7684\u8fd0\u7b97\u6b21\u6570\uff09\u589e\u52a0\u5230\u591a\u5c11\u500d\uff1fBESM-2\u548cEC-10-50\u6bcf\u4f5c\u4e00\u6b21\u8fd0\u7b97\u5e73\u5747\u5404\u9700\u591a\u5c11\u65f6\u95f4\uff1f",
      "figure_ids": []
    },
    {
      "number": "180",
      "text": "180. \u6309\u539f\u6559\u6750\u7ed9\u5b9a\u7684\u8ddd\u79bb\u6570\u636e\u8ba1\u7b97\u3002\na) \u5df2\u77e5\uff0c\u592a\u9633\u5230\u51a5\u738b\u661f\u7684\u8ddd\u79bb\u7b49\u4e8e\u592a\u9633\u5230\u5730\u7403\u7684\u8ddd\u79bb\u7684 $40$ \u500d\uff0c\u800c\u592a\u9633\u5230\u5730\u7403\u7684\u8ddd\u79bb\u4e3a $1.495\\cdot10^8$ \u516c\u91cc\u3002\u592a\u9633\u5230\u51a5\u738b\u661f\u7684\u8ddd\u79bb\u4e3a\u591a\u5c11\u516c\u91cc\uff1f\nb) \u5df2\u77e5\uff0c\u592a\u9633\u5230\u6c34\u661f\u7684\u8ddd\u79bb\u662f\u592a\u9633\u5230\u5730\u7403\u7684\u8ddd\u79bb\u7684 $2.6$\u5206\u4e4b\u4e00\uff0c\u6c42\u592a\u9633\u5230\u6c34\u661f\u7684\u8ddd\u79bb\u3002",
      "figure_ids": []
    },
    {
      "number": "181",
      "text": "181. \u4e0b\u8868\u4fdd\u7559\u4e86\u539f\u6559\u6750\u5217\u51fa\u7684\u592a\u9633\u7cfb\u4e5d\u4e2a\u5929\u4f53\u7684\u8d28\u91cf\u6570\u636e\uff1a\na) \u628a\u8868\u4e2d\u7684\u4e5d\u4e2a\u5929\u4f53\u6309\u7167\u8d28\u91cf\u9012\u589e\u7684\u987a\u5e8f\u5199\u51fa\u6765\uff1b\nb) \u6728\u661f\u8d28\u91cf\u662f\u5730\u7403\u8d28\u91cf\u7684\u591a\u5c11\u500d\uff1f",
      "figure_ids": [
        "tbl-p0064-01"
      ]
    },
    {
      "number": "182",
      "text": "182. \u706b\u8f66\u56e0\u6545\u5ef6\u8bef\u4e86 $15$ \u5206\u949f\uff0c\u4e3a\u4e86\u6b63\u70b9\u5230\u7ad9\uff0c\u5fc5\u987b\u5728\u4f59\u4e0b\u7684$120$ \u516c\u91cc\u628a\u901f\u5ea6\u589e\u52a0\u5230\u65f6\u523b\u8868\u89c4\u5b9a\u901f\u5ea6\u7684 $1.2$ \u500d\u3002\u706b\u8f66\u5728\u8fd9 $120$ \u516c\u91cc\u7684\u8fd0\u884c\u901f\u5ea6\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "183",
      "text": "183. \u7528\u56fe\u89e3\u6cd5\u89e3\u65b9\u7a0b\uff1a\na) $6x^{-1}=x-1$\uff1b\nb) $6x^{-1}=x+3$\u3002",
      "figure_ids": []
    },
    {
      "number": "184",
      "text": "184. \u5316\u7b80\uff1a\na) $\\left(\\frac{8a^{-2}}{b^{-3}}\\right)^3\\cdot\\left(\\frac{b^{-2}}{16a^{-3}}\\right)^2$\uff1b\nb) $\\left(-\\frac{9x^4}{2y^3}\\right)^{-3}\\cdot\\left(\\frac{4y^4}{27x^6}\\right)^{-2}$\u3002",
