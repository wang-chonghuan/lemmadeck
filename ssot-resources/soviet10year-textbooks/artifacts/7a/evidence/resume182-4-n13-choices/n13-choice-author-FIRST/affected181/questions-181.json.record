    {
      "id": "historical-jupiter-earth-ratio",
      "source_numbers": ["181"],
      "view": {
        "mode": "single",
        "stem": "按表中给定的历史数据，木星（Jupiter）质量是地球（Earth）质量的多少倍？结果用精确分数表示。",
        "figure_ids": ["tbl-p0064-01"],
        "options": [
          {"id": "a", "text": "$\\frac{299}{95000}$ 倍。", "figure_ids": []},
          {"id": "b", "text": "$\\frac{95}{299}$ 倍。", "figure_ids": []},
          {"id": "c", "text": "$\\frac{95000}{299}$ 倍。", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Calculate the exact directed Jupiter/Earth mass ratio from the actual table, subtracting powers of ten and cancelling kilograms.",
        "source_solution": "All nine bodies in increasing historical mass order are Mercury,Mars,Venus,Pluto,Earth,Uranus,Neptune,Saturn,Jupiter. Jupiter and Earth masses from the actual white preview are 1.90*10^27 and 5.98*10^24 kg. Divide: (1.90/5.98)*10^(27-24)=(190/598)*1000=(95/299)*1000=95000/299 exactly. It lies between 317 and 318 because 94783<95000<95082. Both complete source conclusions were saved before options.",
        "unit_reason": "The whole directed two-body quotient is one complete numerical task distinct from ordering a nine-element mass set. It preserves both actual table values and their shared unit rather than asking for a minor coefficient or exponent blank.",
        "concept_blocks": [3],
        "limitations": ["Selecting an exact fraction does not demonstrate independently constructing or reducing the mass quotient.", "Exact fractional response avoids a hidden rounding choice; it does not require rewriting this ratio as a standard-form decimal."],
        "figure_observations": [
          {
            "figure_id": "tbl-p0064-01",
            "observation": "The same single complete white 640x320 preview view supplies this question; no reopening was performed. All nine names and masses are readable. Earth is 5.98*10^24 kg in the top block and Jupiter is 1.90*10^27 kg in the bottom block. Right and bottom borders and all superscript exponents are visible. Current declared SVG SHA-256 is 18d5481948b31819c9dc95abd53c2ad3230b5566062b9c26005bd7014d2b31e7; viewed bound preview SHA-256 is 35aaf83011c3e95dc669dd12883073db269acf8d3c3726b1277df392e0ecac9b. No FigureSpec, review or SVG text was used as table data."
          }
        ]
      },
      "key": {
        "correct": ["c"],
        "rationales": [
          {
            "option_id": "a",
            "truth": "incorrect",
            "derivation": "Reverse the requested quotient: Earth/Jupiter=(5.98/1.90)*10^(24-27)=(598/190)/1000=299/95000. This is the reciprocal of Jupiter/Earth.",
            "misconception": "Divides the reference Earth mass by the compared Jupiter mass instead of Jupiter by Earth."
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "Divide only the decimal coefficients: 1.90/5.98=190/598=95/299, omitting the factor 10^(27-24)=1000. The fraction therefore compares coefficients, not masses.",
            "misconception": "Discards the difference between the two scientific-notation exponents."
          },
          {
            "option_id": "c",
            "truth": "correct",
            "derivation": "Jupiter/Earth=(1.90*10^27)/(5.98*10^24)=(95/299)*10^3=95000/299. Kilograms cancel and 95000 is coprime to 299=13*23, so the exact fraction is reduced.",
            "misconception": null
          }
        ]
      }
