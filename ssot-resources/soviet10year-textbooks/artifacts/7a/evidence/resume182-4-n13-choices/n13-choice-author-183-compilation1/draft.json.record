          },
          {
            "id": "b",
            "text": "$9.695\\cdot10^{-1}$ 克；$4.32\\cdot10^{-5}$ 克；$7.8\\cdot10^4$ 克。",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$9.695\\cdot10^5$ 克；$4.32\\cdot10^7$ 克；$7.8\\cdot10^{-2}$ 克。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "Convert the complete large-/small-mass unit collection to grams and normalize each value.",
        "source_solution": "Use 1 kg=10^3 g, 1 tonne=10^6 g and 1 mg=10^-3 g. Results are 969500=9.695*10^5 g,43200000=4.32*10^7 g,0.078=7.8*10^-2 g.",
        "unit_reason": "One full conversion vector tests the consistent handling of multiple unit scales and both conversion directions, not three letter-based questions.",
