      ],
      "view": {
        "mode": "single",
        "stem": "将 $969.5$ 公斤、$43.2$ 吨、$78$ 毫克都换算成克，并把结果写成标准形式。哪组依次对应的完整结果正确？",
        "figure_ids": [],
        "options": [
