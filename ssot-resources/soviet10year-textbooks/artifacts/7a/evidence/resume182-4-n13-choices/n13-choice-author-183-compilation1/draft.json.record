        "rationales": [
          {
            "option_id": "a",
            "truth": "incorrect",
            "derivation": "Use 10^3 g per kg and 10^-3 g per mg correctly, but also use 10^3 g per tonne: 43.2*10^3=43200=4.32*10^4. This preserves the first and third correct results and produces the incorrect middle result.",
            "misconception": "Treats one tonne as one kilogram in the gram conversion."
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "Reverse every conversion factor: 969.5/1000=0.9695=9.695*10^-1; 43.2/1000000=0.0000432=4.32*10^-5; 78*1000=78000=7.8*10^4, then incorrectly label all as grams.",
            "misconception": "Divides when converting larger units into grams and multiplies when converting milligrams into grams."
          },
          {
            "option_id": "c",
            "truth": "correct",
            "derivation": "969.5*10^3=9.695*10^5; 43.2*10^6=4.32*10^7; 78*10^-3=7.8*10^-2. Each is in grams with normalized coefficient.",
            "misconception": null
          }
        ]
      }
    },
