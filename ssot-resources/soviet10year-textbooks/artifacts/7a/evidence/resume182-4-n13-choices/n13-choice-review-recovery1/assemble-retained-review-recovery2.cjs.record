const fs = require("node:fs");
const path = require("node:path");
const crypto = require("node:crypto");
const assert = require("node:assert/strict");
const root = "/Users/yong/.codex/worktrees/stemrobin-182-resume/lemmadeck";
const prefix = ".tmp/resume182-4-postaccount";
const own = prefix + "/n13-choice-review-recovery1";
const staging = prefix + "/n13-choice-retention-staging1";
const first = prefix + "/n13-choice-review-FIRST";
const hash = (value) => crypto.createHash("sha256").update(value).digest("hex");
const bindings = [];
function canonical(value) {
  if (Array.isArray(value)) return "[" + value.map(canonical).join(",") + "]";
  if (value && typeof value === "object") {
    return "{" + Object.keys(value).sort().map((key) =>
      canonical(key) + ":" + canonical(value[key])).join(",") + "}";
  }
  return JSON.stringify(value).replace(/[\u007f-\uffff]/g,
    (char) => "\\u" + char.charCodeAt(0).toString(16).padStart(4, "0"));
}
function bytes(relative) {
  return fs.readFileSync(path.join(root, relative));
}
function read(relative) {
  const buffer = bytes(relative);
  const value = JSON.parse(buffer);
  bindings.push({ path: relative, byte_sha256: hash(buffer), canonical_sha256: hash(canonical(value)) });
  return value;
}
function write(relative, value) {
  assert(relative === staging + "/review.json" || relative.startsWith(own + "/"));
  fs.writeFileSync(path.join(root, relative), JSON.stringify(value, null, 2) + "\n", { flag: "wx" });
}
const seed = read(staging + "/seed.json");
const draft = read(staging + "/draft.json");
const originalSeed = read(prefix + "/n13-choice-seed-FIRST/seed.json");
const compiled = read(prefix + "/n13-choice-author-183-compilation1/draft.json");
const retained = read(prefix + "/n13-choice-image-retention.record");
const compilationReceipt = read(prefix + "/n13-choice-author-183-compilation1/compilation.record");
const source = read(own + "/independent-source-solutions-recovery1.json");
const view = read(own + "/view-affected-results-recovery1.json");
const viewFreeze = read(own + "/view-freeze-recovery1.json");
const graphs = read(own + "/actual-graph-reviews-recovery1.json");
const comparison = read(own + "/author-comparison-recovery2.json");
const affectedCoverage = read(own + "/source-coverage-recovery2.json");
const firstSource = read(first + "/independent-source-solutions-FIRST.json");
const firstView = read(first + "/view-FIRST-results.json");
const firstComparison = read(first + "/author-comparison-FIRST.json");
const firstCoverage = read(first + "/source-coverage-FIRST.json");
const firstDraft = read(first + "/draft-snapshot-FIRST.json");
const base181 = read(prefix + "/n13-choice-author-FIRST/affected181/draft.json");
const seedDigest = hash(canonical(seed));
assert.equal(seedDigest, "91f4f50a1d6575319157af24b2789dad9b6c613985dbca0ac732e0e688bfacf6");
assert.deepEqual(seed, originalSeed);
assert.equal(draft.seed_sha256, seedDigest);
assert.equal(hash(canonical(compiled)), view.draft_sha256);
assert.equal(hash(bytes(own + "/independent-source-solutions-recovery1.json")),
  "5395a510611472b84a6eccab65262d089a94e48a667bc24d670427620b091881");
assert.equal(hash(bytes(own + "/view-affected-results-recovery1.json")),
  viewFreeze.view_results_byte_sha256);
assert.equal(hash(bytes(own + "/actual-graph-reviews-recovery1.json")),
  viewFreeze.actual_graph_review_byte_sha256);
assert.equal(hash(bytes(staging + "/draft.json")), retained.staged_draft.sha256);
assert.equal(hash(bytes(prefix + "/n13-choice-author-183-compilation1/draft.json")),
  retained.original_draft.sha256);
assert.equal(hash(bytes(own + "/actual-graph-reviews-recovery1.json")),
  retained.independent_actual_image_review.sha256);
assert.equal(hash(canonical(firstDraft)), firstView.draft_sha256);
assert.equal(hash(canonical(firstDraft)), firstComparison.draft_sha256);
assert.equal(firstSource.seed_sha256, seedDigest);
assert.equal(firstComparison.author_keys_agree_with_independent_complete_true_sets, true);
assert.equal(firstComparison.author_per_option_truths_agree, true);
assert.equal(comparison.outcome, "pass");
assert.equal(view.outcome, "pass");
assert.equal(graphs.outcome, "pass");
assert.deepEqual(draft.questions, compiled.questions);
assert.deepEqual(draft.coverage, compiled.coverage);
assert.deepEqual(base181.questions, compiled.questions.filter((question) =>
  !question.source_numbers.includes("183")));
assert.deepEqual(base181.coverage.filter((item) => item.source_number !== "183"),
  compiled.coverage.filter((item) => item.source_number !== "183"));
const normalizedStaged = structuredClone(draft);
normalizedStaged.new_figures.forEach((figure, index) => {
  assert.equal(figure.id, compiled.new_figures[index].id);
  figure.path = compiled.new_figures[index].path;
});
assert.deepEqual(normalizedStaged, compiled);
assert.equal(draft.questions.length, 20);
assert.equal(draft.questions.reduce((sum, question) => sum + question.view.options.length, 0), 60);
assert.equal(seed.exercises.length, 17);
assert.equal(firstView.question_reviews.length, 17);
const oldIds = new Set(firstView.question_reviews.map((review) => review.question_id));
const newIds = new Set(view.question_reviews.map((review) => review.question_id));
assert.deepEqual([...newIds].sort(), [
  "graphical-equation-pair", "historical-jupiter-earth-ratio", "historical-mass-global-order"
]);
assert.equal(draft.questions.filter((question) => oldIds.has(question.id)).length, 17);
for (const oldReview of firstView.question_reviews) {
  const oldQuestion = firstDraft.questions.find((question) => question.id === oldReview.question_id);
  const currentQuestion = draft.questions.find((question) => question.id === oldReview.question_id);
  assert.deepEqual(currentQuestion, oldQuestion);
  for (const gate of ["task_fidelity", "redundancy", "answer_leakage", "mathematics"]) {
    assert.equal(oldReview[gate].verdict, "pass");
  }
}
const independentSourceNumbers = new Set(source.source_reviews.map((item) => item.source_number));
assert.deepEqual([...independentSourceNumbers].sort(), ["181", "183"]);
const oldSourceNumbers = seed.exercises.map((exercise) => exercise.number)
  .filter((number) => !independentSourceNumbers.has(number));
assert.equal(oldSourceNumbers.length, 15);
for (const number of oldSourceNumbers) {
  assert.deepEqual(draft.coverage.find((item) => item.source_number === number),
    firstDraft.coverage.find((item) => item.source_number === number));
  assert.equal(firstCoverage.find((item) => item.source_number === number).verdict, "pass");
}
for (const reviewed of view.question_reviews) {
  const question = draft.questions.find((item) => item.id === reviewed.question_id);
  assert.deepEqual(reviewed.mathematics.correct, question.key.correct);
  for (const check of reviewed.mathematics.option_checks) {
    assert.equal(check.truth, question.key.rationales.find((item) => item.option_id === check.option_id).truth);
  }
}
const formalRebindings = [];
for (const figure of draft.new_figures) {
  const retentionAsset = retained.assets.find((item) => item.id === figure.id);
  const oldReview = read(retentionAsset.original_review);
  assert.equal(hash(bytes(retentionAsset.original_review)), retentionAsset.original_review_sha256);
  const durableStem = figure.path.slice(0, -4);
  const render = read(durableStem + ".render.json");
  const review = read(durableStem + ".review.json");
  const originalRenderPath = oldReview.render.path;
  const originalRender = read(originalRenderPath);
  const expectedRender = structuredClone(originalRender);
  expectedRender.spec.path = durableStem + ".spec.json";
  expectedRender.output.svg.path = figure.path;
  assert.deepEqual(render, expectedRender);
  const expectedReview = structuredClone(oldReview);
  expectedReview.spec.path = durableStem + ".spec.json";
  expectedReview.render.path = durableStem + ".render.json";
  expectedReview.render.sha256 = hash(bytes(durableStem + ".render.json"));
  expectedReview.outputs.svg.path = figure.path;
  assert.deepEqual(review, expectedReview);
  assert.equal(review.status, "pass");
  assert.equal(hash(bytes(figure.path)), figure.sha256);
  assert.equal(hash(bytes(durableStem + ".spec.json")), oldReview.spec.sha256);
  assert.equal(hash(bytes(oldReview.spec.path)), oldReview.spec.sha256);
  assert.equal(render.output.svg.sha256, figure.sha256);
  assert.equal(review.outputs.svg.sha256, figure.sha256);
  assert.equal(review.spec.sha256, hash(bytes(durableStem + ".spec.json")));
  for (const retainedFile of retentionAsset.files) {
    assert.equal(hash(bytes(retainedFile.path)), retainedFile.sha256);
  }
  const actualReview = graphs.new_figure_reviews.find((item) => item.figure_id === figure.id);
  assert.equal(actualReview.asset_sha256, figure.sha256);
  formalRebindings.push({
    figure_id: figure.id,
    original_review_path: retentionAsset.original_review,
    original_review_byte_sha256: hash(bytes(retentionAsset.original_review)),
    retained_review_path: durableStem + ".review.json",
    retained_review_byte_sha256: hash(bytes(durableStem + ".review.json")),
    output_sha256: figure.sha256,
    spec_byte_identical: true,
    svg_byte_identical: true,
    render_only_changed_fields: ["spec.path", "output.svg.path"],
    formal_review_only_changed_fields: ["spec.path", "render.path", "render.sha256", "outputs.svg.path"],
    original_reviewedAt_preserved: true,
    reopened: false,
    record_review_repeated: false
  });
}
const sourceReviews = seed.exercises.map((exercise) => {
  const isNew = independentSourceNumbers.has(exercise.number);
  const item = (isNew ? source.source_reviews : firstSource.source_reviews)
    .find((entry) => entry.source_number === exercise.number);
  const coverage = (isNew ? affectedCoverage : firstCoverage)
    .find((entry) => entry.source_number === exercise.number);
  return {
    source_number: exercise.number,
    independent_solution: item.independent_solution,
    coverage: { verdict: coverage.verdict, evidence: coverage.evidence }
  };
});
const questionReviews = draft.questions.map((question) =>
  (oldIds.has(question.id) ? firstView.question_reviews : view.question_reviews)
    .find((item) => item.question_id === question.id));
const table = source.figure_checks[0];
assert.equal(hash(bytes(table.asset_path)), table.asset_sha256);
const figureChecks = [{
  figure_id: table.figure_id,
