import assert from 'node:assert/strict';
import fs from 'node:fs';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
assert.equal(process.cwd(), root);
let code = fs.readFileSync('.tmp/ld-s10y-lesson/resume182-6-3129/display-N4-FIRST/select.mjs', 'utf8');
for (const [before, after] of [
  ['display-N4-FIRST', 'display-7a-N15-FIRST'],
  ["lesson: 'alg7-c1-s1-n4'", "lesson: 'alg7-c2-s1-n15'"],
  ["schema: 'bounded-n4-reused-n10-display-selection@1'", "schema: 'bounded-7a-n15-reused-n10-display-selection@1'"],
]) {
  assert.equal(code.split(before).length, 2, before);
  code = code.replace(before, after);
}
await import(`data:text/javascript;base64,${Buffer.from(code).toString('base64')}`);
