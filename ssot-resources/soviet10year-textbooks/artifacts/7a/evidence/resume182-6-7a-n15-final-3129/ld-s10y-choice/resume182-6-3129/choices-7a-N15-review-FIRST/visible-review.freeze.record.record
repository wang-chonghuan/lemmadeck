    {
      "id": "q332-square-proof",
      "view": {
        "mode": "single",
        "stem": "设 $c\\in\\mathbb R$，记 $D_1=\\frac{c^2+1}{2}-c$，$D_2=\\frac12-\\frac{c}{c^2+1}$。哪组恒等式及符号判断能证明 $\\frac{c^2+1}{2}\\ge c$ 和 $\\frac{c}{c^2+1}\\le\\frac12$ 对所有实数成立？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$D_1=\\frac{(c+1)^2}{2}\\ge0,\\quad D_2=\\frac{(c+1)^2}{2(c^2+1)}\\ge0$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$D_1=\\frac{(c-1)^2}{2}\\ge0,\\quad D_2=\\frac{(c-1)^2}{2(c^2+1)}\\ge0$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$D_1=\\frac{(c-1)^2}{2}\\ge0,\\quad D_2=-\\frac{(c-1)^2}{2(c^2+1)}\\le0$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$D_1=\\frac{(c-1)^2}{2}\\ge0,\\quad D_2=\\frac{(c-1)^2}{2}\\ge0$。",
            "figure_ids": []
          }
        ]
      },
      "source_numbers": [
        "332"
      ]
    },
    {
      "id": "q333-positive-proof",
      "view": {
        "mode": "single",
        "stem": "设 $a>0$。哪项恒等式及符号判断能证明 $9a+\\frac1a\\ge6$？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$9a+\\frac1a-6=\\frac{(3a-1)^2}{a}\\ge0$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$9a+\\frac1a-6=\\frac{(3a+1)^2}{a}\\ge0$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$9a+\\frac1a-6=\\frac{(3a-1)^2}{3a}\\ge0$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$9a+\\frac1a-6=-\\frac{(3a-1)^2}{a}\\le0$。",
            "figure_ids": []
          }
        ]
      },
      "source_numbers": [
        "333"
      ]
    },
    {
      "id": "q333-negative-proof",
      "view": {
        "mode": "single",
        "stem": "设 $x<0$。哪项恒等式及符号判断能证明 $\\frac{x}{5}+\\frac5x\\le-2$？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$\\frac{x}{5}+\\frac5x+2=\\frac{(x-5)^2}{5x}\\le0$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$\\frac{x}{5}+\\frac5x+2=\\frac{(x+5)^2}{5x}\\ge0$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$\\frac{x}{5}+\\frac5x+2=\\frac{(x+5)^2}{5x^2}\\le0$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$\\frac{x}{5}+\\frac5x+2=\\frac{(x+5)^2}{5x}\\le0$。",
            "figure_ids": []
          }
        ]
      },
      "source_numbers": [
        "333"
      ]
    },
    {
