import assert from 'node:assert/strict';
import fs from 'node:fs';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
assert.equal(process.cwd(), root);
let code = fs.readFileSync('.tmp/ld-s10y-choice/resume182-6-3129/display-N4-choices-FIRST/execute.mjs', 'utf8');
for (const [before, after] of [
  ["display-N4-choices-FIRST');", "display-7a-N15-choices-FIRST');"],
  ["schema: 'resume182-6-n4-choices-display-result@1'",
    "schema: 'resume182-6-7a-n15-choices-display-result@1'"],
  ["book: '7a', lesson: 'alg7-c1-s1-n4'", "book: '7a', lesson: 'alg7-c2-s1-n15'"],
]) {
  assert.equal(code.split(before).length, 2, before);
  code = code.replace(before, after);
}
await import(`data:text/javascript;base64,${Buffer.from(code).toString('base64')}`);
