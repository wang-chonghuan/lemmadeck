          "roots": ["-7", "0"],
          "sum": "-7",
          "product": "0",
          "equation": "y^2 + 7*y = 0",
          "coefficient_vector": ["1", "7", "0"],
          "degeneracy": "Zero constant term is required by the zero root; leading coefficient remains nonzero."
        },
        {
