          "sum": "-1/2",
          "product": "1/25",
          "equation": "50*y^2 + 25*y + 2 = 0",
          "coefficient_vector": ["50", "25", "2"],
          "note": "The source decimal -0.1 is exactly -1/10, not a floating-point approximation."
        },
        {
          "id": "1050-f",
          "source_label": "е",
          "roots": ["-sqrt(5)", "sqrt(5)"],
          "sum": "0",
          "product": "-5",
          "equation": "y^2 - 5 = 0",
          "coefficient_vector": ["1", "0", "-5"]
        },
        {
          "id": "1050-g",
          "source_label": "ж",
          "roots": ["2-sqrt(3)", "2+sqrt(3)"],
          "sum": "4",
          "product": "1",
          "equation": "y^2 - 4*y + 1 = 0",
          "coefficient_vector": ["1", "-4", "1"]
        },
        {
          "id": "1050-h",
          "source_label": "з",
          "roots": ["(11-2*sqrt(30))/5", "(11+2*sqrt(30))/5"],
          "sum": "22/5",
          "product": "1/25",
          "equation": "25*y^2 - 110*y + 1 = 0",
          "coefficient_vector": ["25", "-110", "1"]
        },
        {
          "id": "1050-i",
          "source_label": "и",
          "roots": ["(-10-7*sqrt(2))/3", "(-10+7*sqrt(2))/3"],
          "sum": "-20/3",
          "product": "2/9",
          "equation": "9*y^2 + 60*y + 2 = 0",
          "coefficient_vector": ["9", "60", "2"]
        }
      ],
      "domain": "All nine pairs are real and distinct. Scaling factor lambda must be nonzero; lambda = 0 would be the identically zero equation, not a quadratic."
    }
  ]
}
