        "stem": "把 $P=(x^2-x+1)(x-1)-x(x^2-4)$ 和 $Q=y^3(y-4)-(y^2+y-2)(y+2)$ 展开并合并同类项。哪一组同时正确？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$P=-2x^2-2x-1$；$Q=y^4-5y^3-3y^2+4$",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$P=-2x^2+6x-1$；$Q=y^4-5y^3-3y^2+4$",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$P=-2x^2+6x-1$；$Q=y^4-3y^3+3y^2-4$",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$P=2x^3-2x^2-2x-1$；$Q=y^4-3y^3+3y^2-4$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "完成两个含外层减号的多项式乘法。",
        "source_solution": "第一乘积x^3-2x^2+2x-1，减去x^3-4x得-2x^2+6x-1。第二乘积y^3+3y^2-4，y^4-4y^3减它得y^4-5y^3-3y^2+4。",
        "unit_reason": "以完整有序结果对检查两次展开中的外层减号，避免把各系数拆槽。",
        "concept_blocks": [
          6
        ],
        "limitations": [
          "完整结果识别不能证明独立写出展开过程。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "B"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "若把-x(x^2-4)写成-x^3-4x，P中2x-4x=-2x。",
            "misconception": "外层负号只变第一项，未把-4x变为+4x。"
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "P=-2x²+(2+4)x-1；Q=y⁴-(4+1)y³-3y²+4。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "把Q的第二乘积误相加，得到y^4-4y^3+y^3+3y^2-4。",
            "misconception": "漏掉第二乘积前的减号。"
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "两式均把待减乘积相加，P得2x^3-2x^2-2x-1，Q同C。",
            "misconception": "两次把减法都改成加法。"
          }
        ]
      }
    },
