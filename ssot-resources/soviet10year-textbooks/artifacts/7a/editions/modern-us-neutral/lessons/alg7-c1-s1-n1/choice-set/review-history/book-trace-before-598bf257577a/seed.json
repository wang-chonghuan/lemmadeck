  "exercises": [
    {
      "number": "1",
      "text": "1\uff0e\u4e0b\u5217\u5404\u5f0f\u662f\u4e0d\u662f\u6574\u5f0f\uff1f\na\uff09$\\frac{a^3}{1.25}$\uff1b\nb\uff09$12(x^2-1)$\uff1b\nc\uff09$36:x+1$\uff1b\nd\uff09$15.6:6-a$\uff1b\ne\uff09$15.6:(6-a)$\uff1b\nf\uff09$\\frac{y^2-1}{y-1}$\uff1b\ng\uff09$\\frac{b^2-ac}{b}$\uff1b\nh\uff09$\\frac{8x^2-12y^2}{7}$\uff1b\ni\uff09$\\left(\\frac{a}{3}-\\frac{b+c}{2}\\right)^2$\uff0e",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2\uff0e\u628a\u4e0b\u5217\u5f0f\u5b50\u8868\u793a\u6210\u591a\u9879\u5f0f\uff1a\na\uff09$(x^2-x+1)(x-1)-x(x^2-4)$\uff1b\nb\uff09$y^3(y-4)-(y^2+y-2)(y+2)$\uff0e",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3\uff0e\u628a\u4e0b\u5217\u5404\u5f0f\u53d8\u5f62\u6210\u6807\u51c6\u5f62\u5f0f\u7684\u591a\u9879\u5f0f\uff1a\na\uff09$(x+10)(x-10)$\uff1b\nb\uff09$(y-5b)(y+5b)$\uff1b\nc\uff09$(2a+3)(3-2a)$\uff1b\nd\uff09$(4-0.5b)(0.5b+4)$\uff1b\ne\uff09$(x+7)^2$\uff1b\nf\uff09$(a-2x)^2$\uff1b\ng\uff09$(-3+q)^2$\uff1b\nh\uff09$(0.2y+0.5x)^2$\uff0e",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4\uff0e\u5316\u7b80\uff1a\na\uff09$(2p-5)^2+(2p+5)^2$\uff1b\nb\uff09$\\left(2a+\\frac14\\right)^2-\\left(2a-\\frac14\\right)^2$\uff1b\nc\uff09$(6-y)^2-(y+6)(y-6)$\uff1b\nd\uff09$(x^2-4)^2-(x+2)(x-2)(x^2+4)$\uff0e",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5\uff0e\u5206\u89e3\u56e0\u5f0f\uff1a\na\uff09$8ab+12bc$\uff1b\nb\uff09$15ax-20ay$\uff1b\nc\uff09$x^2-x$\uff1b\nd\uff09$2y^3+y^2$\uff0e",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "6\uff0e\u8bbe $A=x-y$\uff0c$B=y-x$\uff0e\na\uff09\u8bc1\u660e\uff1a\u5f0f $A$ \u4e0e $B$ \u7b26\u53f7\u76f8\u53cd\uff0c\u5373\u5b83\u4eec\u7684\u548c\u6052\u7b49\u4e8e\u96f6\uff1b\nb\uff09\u8bc1\u660e\uff1a\u5f0f $A^2$ \u4e0e $B^2$ \u6052\u7b49\uff1b\nc\uff09\u8bc1\u660e\uff1a\u5f0f $A^3$ \u4e0e $B^3$ \u7b26\u53f7\u76f8\u53cd\uff0e",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "7\uff0e\u5f53\u53d8\u91cf\u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u4e0b\u5217\u5206\u5f0f\u6ca1\u6709\u610f\u4e49\uff1f\na\uff09$\\frac{2c}{c-14}$\uff1b\nb\uff09$\\frac{3x-1}{20x+10}$\uff1b\nc\uff09$\\frac{a^2-9}{3a-1}$\uff1b\nd\uff09$\\frac{x+10}{x(x-3)}$\uff1b\ne\uff09$\\frac{y+4}{y^2-6y}$\uff1b\nf\uff09$\\frac{b^2-1}{25b^2-4}$\uff0e",
      "figure_ids": []
    },
    {
      "number": "8",
      "text": "8\uff0e\u627e\u51fa\u4e0b\u5217\u5404\u5f0f\u7684\u5b9a\u4e49\u57df\uff1a\na\uff09$x^2-8x+9$\uff1b\nb\uff09$\\frac1{6x-3}$\uff1b\nc\uff09$\\frac{3x-6}{10}$\uff1b\nd\uff09$\\frac{x^3-8}{4x^2-1}$\uff1b\ne\uff09$\\frac{x-5}{x^2+25}$\uff1b\nf\uff09$\\frac{5x-1}{25x^2-5x}$\uff0e",
      "figure_ids": []
