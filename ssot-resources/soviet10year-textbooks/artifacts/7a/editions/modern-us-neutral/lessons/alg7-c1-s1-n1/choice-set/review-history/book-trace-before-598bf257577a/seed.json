    {
      "number": "9",
      "text": "9\uff0e\u7ea6\u5206\uff1a\na\uff09$\\frac{45a^3b^4}{54a^4b^3}$\uff1b\nb\uff09$\\frac{26a^2b^6}{65a^6b^2}$\uff1b\nc\uff09$\\frac{3x+9y}{x^2-9y^2}$\uff1b\nd\uff09$\\frac{2x-4y}{x^2-4y^2}$\uff1b\ne\uff09$\\frac{7a(a-b)}{14a^2(b-a)}$\uff1b\nf\uff09$\\frac{6x^2-3xy}{6y^2-12xy}$\uff1b\ng\uff09$\\frac{p^2-q(2p-q)}{pq-q(2p-q)}$\uff1b\nh\uff09$\\frac{a(a+b)-b(a-b)}{b(a+b)+a(a-b)}$\uff0e",
