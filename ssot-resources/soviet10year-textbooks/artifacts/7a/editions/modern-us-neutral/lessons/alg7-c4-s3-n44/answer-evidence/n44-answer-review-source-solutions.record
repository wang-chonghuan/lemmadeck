      "requested_method": "Proof for every real a != 0.",
      "recommended_grading": "ungraded",
      "parts": [
        {
          "label": "whole",
          "task_ids": ["872.whole.proof"],
          "identity": "(a+1/a)^2-a^2=2+1/a^2",
          "proof": [
            "For a != 0, (a+1/a)^2=a^2+2a*(1/a)+1/a^2=a^2+2+1/a^2.",
            "Subtracting a^2 gives 2+1/a^2.",
            "Since a is real and nonzero, a^2>0 and therefore 1/a^2>0.",
            "Thus (a+1/a)^2-a^2>2 for every permitted a. There is no equality case; a=0 is outside the domain."
          ],
          "status": "complete"
        }
      ]
    }
