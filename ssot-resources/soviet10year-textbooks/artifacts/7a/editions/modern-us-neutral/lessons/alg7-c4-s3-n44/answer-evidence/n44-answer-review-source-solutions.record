    {
      "id": "L44.half-formula-derivation",
      "prose_indices": [64, 65, 66, 67, 69, 70],
      "task_ids": ["L44.half-formula-derivation.proof"],
      "solution": [
        "For a != 0 and D>=0, (-b +/- sqrt(D))/(2a)=(-b/2 +/- sqrt(D)/2)/a.",
        "Because 1/2>0, sqrt(D)/2=sqrt(D/4); also D/4=(b/2)^2-ac.",
        "Thus x=(-b/2 +/- sqrt((b/2)^2-ac))/a. It is equivalent to the usual formula, including D=0.",
        "Even b simplifies the arithmetic but is not a mathematical requirement for this identity."
      ],
      "status": "complete"
    },
    {
      "id": "L44.half-formula-example",
      "prose_indices": [72, 73, 74, 75, 76, 77],
      "task_ids": ["L44.half-formula-example.solve"],
      "equation": "9x^2-14x+5=0",
      "coefficients": [9, -14, 5],
      "quarter_discriminant": 4,
      "formula": "x=(7 +/- sqrt(4))/9=(7 +/- 2)/9",
      "real_roots": ["5/9", "1"],
      "verification": "(9x-5)(x-1)=9x^2-14x+5.",
      "status": "complete"
    }
  ],
