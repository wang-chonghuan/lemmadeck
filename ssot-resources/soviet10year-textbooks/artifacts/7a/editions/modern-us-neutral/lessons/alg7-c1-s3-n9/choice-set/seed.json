    {
      "number": "116",
      "text": "116.\na) \u4e00\u4e2a\u5206\u6570\u7684\u5206\u5b50\u6bd4\u5206\u6bcd\u5c0f $2$\u3002\u5982\u679c\u8fd9\u4e2a\u5206\u6570\u7684\u5206\u5b50\u51cf $1$\uff0c\u800c\u5206\u6bcd\u52a0 $3$\uff0c\u90a3\u4e48\u5206\u6570\u503c\u7b49\u4e8e $0.25$\u3002\u6c42\u8fd9\u4e2a\u5206\u6570\u3002\nb) \u4e00\u4e2a\u5206\u6570\u7684\u5206\u6bcd\u6bd4\u5206\u5b50\u5927 $5$\u3002\u5982\u679c\u8fd9\u4e2a\u5206\u6570\u7684\u5206\u5b50\u52a0 $1$\uff0c\u800c\u5206\u6bcd\u4e0d\u53d8\uff0c\u90a3\u4e48\u5206\u6570\u503c\u7b49\u4e8e $\\frac{1}{3}$\u3002\u6c42\u8fd9\u4e2a\u5206\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "117",
      "text": "117.\na) \u4e00\u4eba\u9a91\u81ea\u884c\u8f66\u7531 $A$ \u5730\u5230 $B$ \u5730\uff0c\u884c\u7a0b $24$ \u516c\u91cc\u3002\u8fd4\u56de\u65f6\u8d70\u53e6\u4e00\u6761\u8def\uff0c\u884c\u7a0b $27$ \u516c\u91cc\u3002\u7531\u4e8e\u8fd4\u56de\u65f6\u901f\u5ea6\u662f\u7531 $A$ \u5230 $B$ \u7684\u901f\u5ea6\u7684 $1.2$ \u500d\uff0c\u6240\u4ee5\u8def\u4e0a\u82b1\u7684\u65f6\u95f4\u6bd4\u7531 $A$ \u5230 $B$ \u5c11 $6$ \u5206\u949f\u3002\u4ece $A$ \u5230 $B$ \u81ea\u884c\u8f66\u7684\u901f\u5ea6\u662f\u591a\u5c11\uff1f\nb) \u5728\u5efa\u8bbe\u6c34\u7535\u7ad9\u7684\u5de5\u5730\u4e0a\uff0c\u6398\u571f\u673a\u5c0f\u961f\u5728\u89c4\u5b9a\u671f\u9650\u5185\u5e94\u5f53\u6398\u571f $9600\\mathrm{m}^3$\u3002\u7531\u4e8e\u8fd9\u4e2a\u961f\u6bcf\u5929\u8d85\u8fc7\u5b9a\u989d $25\\%$\uff0c\u5728\u5230\u671f\u524d\u4e00\u5929\u5373\u5df2\u6398\u571f $11000\\mathrm{m}^3$\u3002\u6309\u539f\u5b9a\u8ba1\u5212\u8fd9\u4e2a\u961f\u6bcf\u5929\u5e94\u6398\u571f\u591a\u5c11\u7acb\u65b9\u7c73\uff1f",
      "figure_ids": []
    },
    {
      "number": "118",
      "text": "118.\na) \u6469\u6258\u8247\u9006\u6c34\u8d70 $16$ \u516c\u91cc\uff0c\u7136\u540e\u8fd4\u56de\u539f\u5904\u3002\u8fd4\u56de\u8d70\u8fc7\u7684\u8def\u7a0b\u6bd4\u9006\u6c34\u8d70\u8fc7\u7684\u8def\u7a0b\u5c11\u7528 $40$ \u5206\u949f\u3002\u5df2\u77e5\u6c34\u901f\u4e3a$2$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u6c42\u6469\u6258\u8247\u5728\u9759\u6c34\u4e2d\u7684\u901f\u5ea6\u3002\nb) \u65c5\u884c\u8005\u4e58\u5c0f\u8247\u987a\u6c34\u822a\u884c $24$ \u516c\u91cc\uff0c\u7136\u540e\u8fd4\u56de\u539f\u5904\u3002\u5168\u90e8\u8def\u7a0b\u7528\u4e86 $7$ \u5c0f\u65f6\u3002\u5982\u679c\u5c0f\u8247\u5728\u9759\u6c34\u4e2d\u7684\u901f\u5ea6\u662f $7$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u90a3\u4e48\u6c34\u901f\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "119",
      "text": "119.\na) \u706b\u8f66\u4ece $A$ \u57ce\u5f00\u5f80 $B$ \u57ce\uff0c\u5728\u524d $450$ \u516c\u91cc\uff0c\u5b83\u7684\u901f\u5ea6\u6bd4\u65f6\u523b\u8868\u7684\u8981\u6c42\u6162 $10$ \u516c\u91cc/\u5c0f\u65f6\u3002\u5728\u4f59\u4e0b\u7684\u957f\u8fbe $750$ \u516c\u91cc\u7684\u533a\u6bb5\uff0c\u706b\u8f66\u63d0\u9ad8\u4e86\u901f\u5ea6\uff0c\u6bd4\u65f6\u523b\u8868\u7684\u8981\u6c42\u5feb $8$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u7ed3\u679c\u6b63\u70b9\u5230\u8fbe $B$ \u57ce\u3002\u706b\u8f66\u6309\u7167\u65f6\u523b\u8868\u5e94\u8be5\u4ee5\u4ec0\u4e48\u901f\u5ea6\u8fd0\u884c\uff1f\nb) \u4ece A \u5730\u5230 B \u5730\u662f $6$ \u516c\u91cc\u3002\u4e00\u4e2a\u7537\u5b69\u5e73\u5e38\u53bb B \u5730\u7528\u591a\u5c11\u65f6\u95f4\uff0c\u56de\u6765\u4e5f\u7528\u591a\u5c11\u65f6\u95f4\u3002\u8fd9\u4e00\u6b21\u4ed6\u53bb\u90a3\u91cc\u7684\u901f\u5ea6\u6bd4\u5e73\u5e38\u7684\u901f\u5ea6\u5feb $1.5$ \u516c\u91cc/\u5c0f\u65f6\uff0c\u56de\u6765\u65f6\u7684\u901f\u5ea6\u6162 $1$ \u516c\u91cc/\u5c0f\u65f6\u3002\u7ed3\u679c\u6240\u7528\u7684\u65f6\u95f4\u548c\u5e73\u5e38\u4e00\u6837\u3002\u8fd9\u4e2a\u7537\u5b69\u5e73\u5e38\u4ece A \u5730\u5230 B \u5730\u548c\u8fd4\u56de\u65f6\u7528\u7684\u901f\u5ea6\u662f\u591a\u5c11\uff1f",
