        {"id": "849.a", "label": "line a", "answer": "y=\\frac{x}{5}-2", "derivation": "The shallow rising line crosses the y-axis at -2 and the x-axis at 10. Slope=(0-(-2))/(10-0)=1/5, so y=x/5-2. Also passes (20,2).", "domain": "Linear function for all real x; read values only from the source/current plotted frame.", "graph": {"figure": "fig-57", "coordinates": [[0, -2], [10, 0], [20, 2]], "line": "a", "equation": "y=x/5-2"}},
        {"id": "849.b", "label": "line b", "answer": "y=-2x+1", "derivation": "The steep falling line passes through (0,1), (1,-1), and (2,-3). One grid interval equals one unit, so the intercept is 1, not the printed y label 2. Slope=(-3-1)/(2-0)=-2; hence y=-2x+1.", "domain": "Linear function for all real x; source/current x-intercept is 1/2.", "graph": {"figure": "fig-57", "coordinates": [[0, 1], [1, -1], [2, -3]], "line": "b", "equation": "y=-2x+1"}}
      ]
    },
    {
      "exercise": "850",
      "grading": "ungraded",
      "tasks": [
        {"id": "850.a1", "label": "a: x^2+1", "answer": "\\min(x^2+1)=1\\quad\\text{at }x=0", "derivation": "x^2>=0 for all real x; equality exactly at zero.", "domain": "x real.", "extremum": {"kind": "minimum", "value": "1", "attainedAt": "x=0"}},
        {"id": "850.a2", "label": "a: x^2-5", "answer": "\\min(x^2-5)=-5\\quad\\text{at }x=0", "derivation": "x^2>=0 implies x^2-5>=-5, attained exactly at zero.", "domain": "x real.", "extremum": {"kind": "minimum", "value": "-5", "attainedAt": "x=0"}},
        {"id": "850.a3", "label": "a: sqrt(x)", "answer": "\\min\\sqrt{x}=0\\quad\\text{at }x=0", "derivation": "On x>=0 the principal root is nonnegative and equals zero only at zero.", "domain": "x>=0.", "extremum": {"kind": "minimum", "value": "0", "attainedAt": "x=0"}},
        {"id": "850.b1", "label": "b: -(x+4)^2", "answer": "\\max(-(x+4)^2)=0\\quad\\text{at }x=-4", "derivation": "A negative square is at most zero; it reaches zero exactly when x+4=0.", "domain": "x real.", "extremum": {"kind": "maximum", "value": "0", "attainedAt": "x=-4"}},
        {"id": "850.b2", "label": "b: 10/(sqrt(x)+2)", "answer": "\\max\\frac{10}{\\sqrt{x}+2}=5\\quad\\text{at }x=0", "derivation": "On x>=0 the denominator is at least 2 and positive, so the quotient is at most 10/2=5, with equality exactly at x=0.", "domain": "x>=0; the denominator is never zero.", "extremum": {"kind": "maximum", "value": "5", "attainedAt": "x=0"}},
        {"id": "850.b3", "label": "b: 1/(x^2+7)", "answer": "\\max\\frac{1}{x^2+7}=\\frac{1}{7}\\quad\\text{at }x=0", "derivation": "x^2+7>=7>0, so reciprocal order gives 1/(x^2+7)<=1/7; equality exactly at zero.", "domain": "x real; the denominator is always positive.", "extremum": {"kind": "maximum", "value": "1/7", "attainedAt": "x=0"}}
      ]
    }
