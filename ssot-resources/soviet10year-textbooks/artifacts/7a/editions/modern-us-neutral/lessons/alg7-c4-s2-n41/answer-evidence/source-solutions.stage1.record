        {"id": "838.b", "label": "b", "answer": "1+\\frac{\\sqrt{10}}{2}", "derivation": "5/sqrt10=sqrt10/2, so (5+sqrt10)/sqrt10=1+sqrt10/2.", "domain": "Constant denominator sqrt10 is nonzero."},
        {"id": "838.c", "label": "c", "answer": "\\frac{2-\\sqrt{3}}{5}", "derivation": "Factor numerator as sqrt3*(2-sqrt3), then cancel sqrt3 against 5sqrt3.", "domain": "Constant denominator 5sqrt3 is nonzero."},
        {"id": "838.d", "label": "d", "answer": "\\sqrt{a}+\\sqrt{b}", "derivation": "Numerator=sqrt(a)*sqrt(b)*(sqrt(a)+sqrt(b)); denominator=sqrt(a)*sqrt(b). Cancel only on the original nonzero-denominator domain.", "domain": "a>0 and b>0. The separate radicals require a,b>=0, and sqrt(ab)!=0 excludes either being zero."},
        {"id": "838.e", "label": "e", "answer": "\\frac{\\sqrt{x}-\\sqrt{a}}{a}", "derivation": "Numerator=sqrt(x)*(sqrt(x)-sqrt(a)); cancel nonzero sqrt(x), keeping a in the denominator.", "domain": "a>0 and x>0. sqrt(x) and sqrt(ax) must be real, and a*sqrt(x) must be nonzero."},
        {"id": "838.f", "label": "f", "answer": "1+\\frac{\\sqrt{y}}{b}", "derivation": "Numerator=sqrt(y)*(sqrt(y)+b); cancel sqrt(y) to obtain (sqrt(y)+b)/b.", "domain": "y>0 and b!=0; b may be negative."},
        {"id": "838.g", "label": "g", "answer": "\\sqrt{2}", "derivation": "2+sqrt2=sqrt2*(sqrt2+1); divide by the nonzero factor 1+sqrt2.", "domain": "Constant denominator 1+sqrt2>0."},
        {"id": "838.h", "label": "h", "answer": "-\\sqrt{5}", "derivation": "Numerator=sqrt5*(sqrt3-1); denominator=-(sqrt3-1), so the quotient is -sqrt5.", "domain": "Constant denominator 1-sqrt3 is nonzero."},
