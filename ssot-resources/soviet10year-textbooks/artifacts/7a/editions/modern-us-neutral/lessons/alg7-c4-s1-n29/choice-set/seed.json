  "concepts": [
    {
      "block": 1,
      "text": "\u8ba1\u6570\u65f6\u4f7f\u7528\u7684\u6b63\u6574\u6570\uff0c\u7ec4\u6210\u81ea\u7136\u6570\u96c6 $N$\u3002"
    },
    {
      "block": 5,
      "text": "\u4e00\u822c\u6765\u8bf4\uff0c\u5982\u679c\u6709\u4e24\u4e2a\u96c6\u5408 $A$ \u548c $U$\uff0c\u5e76\u4e14 $A\\subset U$\uff0c\u90a3\u4e48\u7531\u5c5e\u4e8e $U$ \u4f46\u4e0d\u5c5e\u4e8e $A$ \u7684\u5143\u7d20\u7ec4\u6210\u7684\u96c6\u5408\uff0c\u53eb\u505a\u96c6\u5408 $U$ \u5185\u96c6\u5408 $A$ \u7684\u4f59\u96c6\uff08\u6216\u8865\u96c6\uff09\u3002"
    },
    {
      "block": 6,
      "text": "\u6574\u6570\u96c6\u53c8\u662f\u66f4\u5927\u7684\u6709\u7406\u6570\u96c6 $Q$ \u7684\u5b50\u96c6\uff1a\n$Z\\subset Q$\u3002\n\u6709\u7406\u6570\u96c6\u5185\u6574\u6570\u96c6\u7684\u4f59\u96c6\u662f\u5206\u6570\u96c6\u3002\n\n\u56fe $41$ \u8868\u793a\u96c6\u5408 $N$\u3001$Z$ \u548c $Q$ \u4e4b\u95f4\u7684\u5173\u7cfb\uff1a\n$N\\subset Z\\subset Q$\u3002"
    },
    {
      "block": 10,
      "text": "\u6211\u4eec\u53d1\u73b0\uff0c\u5728\u8868\u793a\u540c\u4e00\u4e2a\u6709\u7406\u6570\u7684\u8bb8\u591a\u5206\u6570\u4e2d\uff0c\u603b\u6709\u4e00\u4e2a\u4e14\u53ea\u6709\u4e00\u4e2a\u662f\u4e0d\u53ef\u7ea6\u5206\u6570\u3002\n\u5bf9\u4e8e\u6574\u6570\u6765\u8bf4\uff0c\u8fd9\u4e2a\u5206\u6570\u7684\u5206\u6bcd\u7b49\u4e8e $1$\u3002"
