  "exercises": [
    {
      "number": "851",
      "text": "851. \u5728\u4e0b\u5217 $ax^2+bx+c=0$ \u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\u91cc\uff0c\u6307\u51fa $a$\u3001$b$ \u548c $c$ \u7684\u503c\uff1a\na) $2x^2+17x+3=0$\uff1b\nb) $5x^2-9x+4=0$\uff1b\nc) $x^2-12x-6=0$\uff1b\nd) $-x^2+x-2=0$\uff1b\ne) $8x^2-7x=0$\uff1b\nf) $x^2-81=0$\u3002 \u5176\u4e2d\u54ea\u51e0\u4e2a\u65b9\u7a0b\u662f\u7b80\u5316\u7684\u4e8c\u6b21\u65b9\u7a0b\uff1f",
      "figure_ids": []
    },
    {
      "number": "852",
      "text": "852. \u7528\u56fe\u89e3\u6cd5\u89e3\u65b9\u7a0b $x^2=x+2$ \u548c\u4e0d\u7b49\u5f0f $x^2<x+2$\uff0c$x^2>x+2$\u3002",
      "figure_ids": []
    },
    {
      "number": "853",
      "text": "853. \u7528\u56fe\u89e3\u6cd5\u89e3\u4e0b\u5217\u65b9\u7a0b\uff1a\na) $x^2+3x-4=0$\uff1b\nb) $x^2-2x-5=0$\uff1b\nc) $x^2+2x+5=0$\uff1b\nd) $2x^2-x-3=0$\uff1b\ne) $3x^2+2x-5=0$\uff1b\nf) $5x^2+12x-10=0$\u3002",
      "figure_ids": []
    },
    {
      "number": "854",
      "text": "854. \u6c42\u4e0b\u5f0f\u7684\u503c\uff1a\n$\\frac{(y-x)^2}{x+y}\\div\\left(\\frac{2xy}{y^2-x^2}+\\frac{x}{x+y}-\\frac{y}{y-x}\\right)$\n\u8bbe $x=8.4$\uff0c$y=-0.6$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 3,
      "text": "\u5b9a\u4e49 **$ax^2+bx+c=0$ \u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\u53eb\u505a\u4e8c\u6b21\u65b9\u7a0b\uff0c\u5176\u4e2d $x$ \u662f\u53d8\u91cf\uff0c$a$\u3001$b$ \u548c $c$ \u662f\u67d0\u4e00\u4e2a\u6570\uff0c\u5e76\u4e14 $a\\neq0$\u3002\n**"
    },
    {
      "block": 4,
      "text": "$x^2$ \u7684\u7cfb\u6570 $a$ \u901a\u5e38\u53eb\u505a\u9996\u9879\u7cfb\u6570\uff0c$x$ \u7684\u7cfb\u6570 $b$ \u53eb\u505a\u7b2c\u4e8c\u9879\u7cfb\u6570\uff0c\u800c $c$ \u53eb\u505a\u4e8c\u6b21\u65b9\u7a0b\u7684\u5e38\u6570\u9879\u3002"
    },
    {
      "block": 6,
      "text": "\u9996\u9879\u7cfb\u6570\u7b49\u4e8e 1 \u7684\u4e8c\u6b21\u65b9\u7a0b\u53eb\u505a\u7b80\u5316\u7684\u4e8c\u6b21\u65b9\u7a0b\u3002"
    },
    {
      "block": 9,
      "text": "\u6211\u4eec\u5df2\u7ecf\u5b66\u8fc7\u7528\u56fe\u89e3\u6cd5\u89e3\u4e8c\u6b21\u65b9\u7a0b\u3002\n\u7528\u56fe\u89e3\u6cd5\u89e3\u65b9\u7a0b $ax^2+bx+c=0$\uff08$a\\neq0$\uff09\u65f6\uff0c\u6700\u597d\u628a\u5b83\u5199\u6210 $ax^2=-bx-c$ \u7684\u5f62\u5f0f\u3002\n\u629b\u7269\u7ebf $y=ax^2$ \u548c\u76f4\u7ebf $y=-bx-c$ \u7684\u4ea4\u70b9\u7684\u6a2a\u5750\u6807\u5c31\u662f\u65b9\u7a0b\u7684\u6839\u3002"
    }
  ],
