    {
      "number": "313",
      "text": "313. \u6bd4\u8f83\u4e24\u4e2a\u4e0d\u76f8\u7b49\u7684\u6570 $a$ \u4e0e $b$ \u7684\u5e73\u65b9\u548c\u4e0e\u5b83\u4eec\u7684\u79ef\u7684\u4e8c\u500d\u7684\u5927\u5c0f\u3002",
      "figure_ids": []
    },
    {
      "number": "314",
      "text": "314. \u628a $0,\\ 1,\\ 2,\\ 3$ \u5404\u6570\u90fd\u52a0\u4e0a\u540c\u4e00\u4e2a\u6570 $k$\u3002\u7136\u540e\u6bd4\u8f83\u6240\u5f97\u6570\u5217\u9996\u5c3e\u4e24\u9879\u7684\u79ef\u4e0e\u4e2d\u95f4\u4e24\u9879\u7684\u79ef\u7684\u5927\u5c0f\u3002",
      "figure_ids": []
    },
    {
      "number": "315",
      "text": "315. \u8bc1\u660e\uff1a\u5f53 $c>0$ \u65f6\uff0c\u4e0d\u7b49\u5f0f $c+\\frac{1}{c}\\geqslant 2$ \u6210\u7acb\u3002\u8bf4\u51fa\u4e24\u4e2a\u4e92\u4e3a\u5012\u6570\u7684\u6b63\u6570\u4e4b\u548c\u7684\u6027\u8d28\uff0c\u5e76\u4e3e\u51fa\u4e00\u4e9b\u5177\u4f53\u6570\u7684\u4f8b\u5b50\u52a0\u4ee5\u8bf4\u660e\u3002",
      "figure_ids": []
