  "concepts": [
    {
      "block": 2,
      "text": "\u5b9a\u74061 \u5982\u679c $a\\geq 0$ \u548c $b\\geq 0$\uff0c\u90a3\u4e48\uff1a\n$\\sqrt{ab}=\\sqrt{a}\\cdot\\sqrt{b}$\u3002"
