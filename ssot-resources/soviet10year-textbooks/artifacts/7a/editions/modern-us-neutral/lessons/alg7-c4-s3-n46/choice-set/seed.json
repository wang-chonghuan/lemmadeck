  "exercises": [
    {
      "number": "892",
      "text": "892. \u4e0d\u89e3\u65b9\u7a0b\uff0c\u6c42\u65b9\u7a0b\u7684\u6839\uff08\u5982\u679c\u5b83\u4eec\u5b58\u5728\u7684\u8bdd\uff09\u7684\u548c\u4e0e\u79ef\uff1a\na) $2x^2-9x-10=0$\uff1b\nb) $5x^2+12x+7=0$\uff1b\nc) $x^2-37x+27=0$\uff1b\nd) $y^2+41y-371=0$\uff1b\ne) $\\frac{1}{2}z^2+z-7=0$\uff1b\nf) $3x^2-8x+10=0$\uff1b\ng) $4y^2-19=0$\uff1b\nh) $x^2-210x=0$.",
      "figure_ids": []
    },
    {
      "number": "893",
      "text": "893. \u89e3\u4e0b\u5217\u65b9\u7a0b\uff0c\u5e76\u6839\u636e\u97e6\u8fbe\u5b9a\u7406\u8fdb\u884c\u68c0\u9a8c\uff1a\na) $3x^2-4x-4=0$\uff1b\nb) $2x^2+7x+6=0$\uff1b\nc) $x^2-2x-9=0$\uff1b\nd) $2x^2+9x+8=0$.",
      "figure_ids": []
    },
    {
      "number": "894",
      "text": "894.\na) \u5df2\u77e5\u65b9\u7a0b $x^2+px-35=0$ \u4e00\u4e2a\u6839\u7b49\u4e8e $7$\uff0c\u6c42\u53e6\u4e00\u4e2a\u6839\u548c\u7cfb\u6570 $p$.\nb) \u5df2\u77e5\u65b9\u7a0b $x^2-13x+q=0$ \u4e00\u4e2a\u6839\u7b49\u4e8e $12.5$\uff0c\u6c42\u53e6\u4e00\u4e2a\u6839\u548c\u7cfb\u6570 $q$.",
      "figure_ids": []
    },
    {
      "number": "895",
      "text": "895.\na) \u5df2\u77e5\u65b9\u7a0b $5x^2+bx+24=0$ \u4e00\u4e2a\u6839\u7b49\u4e8e $8$\uff0c\u6c42\u53e6\u4e00\u4e2a\u6839\u548c\u7cfb\u6570 $b$.\nb) \u5df2\u77e5\u65b9\u7a0b $10x^2-33x+c=0$ \u4e00\u4e2a\u6839\u7b49\u4e8e $5.3$\uff0c\u6c42\u53e6\u4e00\u4e2a\u6839\u548c\u7cfb\u6570 $c$.",
      "figure_ids": []
    },
    {
      "number": "896",
      "text": "896.\na) \u4e8c\u6b21\u65b9\u7a0b $x^2-12x+q=0$ \u4e24\u6839\u7684\u5dee\u7b49\u4e8e $2$. \u6c42 $q$\uff1b\nb) \u4e8c\u6b21\u65b9\u7a0b $x^2+x+c=0$ \u4e24\u6839\u7684\u5dee\u7b49\u4e8e $6$. \u6c42 $c$.",
      "figure_ids": []
    },
    {
      "number": "897",
      "text": "897. \u8bc1\u660e\u4e0b\u5217\u65b9\u7a0b\u4e0d\u53ef\u80fd\u6709\u7b26\u53f7\u76f8\u540c\u7684\u6839\uff1a\na) $3x^2+113x-7=0$\uff1b\nb) $5x^2-291x-16=0$.",
      "figure_ids": []
    },
    {
      "number": "898",
      "text": "898. \u4e0d\u89e3\u4e8c\u6b21\u65b9\u7a0b\uff0c\u786e\u5b9a\u5b83\u4eec\u7684\u6839\u7684\u7b26\u53f7\uff08\u5982\u679c\u6709\u6839\u7684\u8bdd\uff09\uff1a\na) $x^2+7x-1=0$\uff1b\nb) $x^2-7x+1=0$\uff1b\nc) $5x^2+17x+16=0$\uff1b\nd) $19x^2-23x+5=0$\uff1b\ne) $2x^2+5\\sqrt{3}x+11=0$\uff1b\nf) $11x^2-9x+7-5\\sqrt{2}=0$.",
      "figure_ids": []
    },
    {
      "number": "899",
      "text": "899. \u6839\u636e\u4e0b\u9762\u5404\u9898\u91cc\u7ed9\u5b9a\u7684\u6839\u5217\u51fa\u4e8c\u6b21\u65b9\u7a0b\uff0c\u518d\u628a\u5b83\u4eec\u89e3\u51fa\u6765\u8fdb\u884c\u68c0\u9a8c\uff1a\na) $3$\uff0c$10$\uff1b\nb) $-7$\uff0c$-4$\uff1b\nc) $-\\frac{5}{8}$\uff0c$3$\uff1b\nd) $1.5$\uff0c$3.5$\uff1b\ne) $2-\\sqrt{3}$\uff0c $2+\\sqrt{3}$\uff1b\nf) $-\\sqrt{5}$\uff0c $\\sqrt{5}$\uff1b\ng) $5-3\\sqrt{2}$\uff0c $5+3\\sqrt{2}$\uff1b\nh) $-7-4\\sqrt{3}$\uff0c $-7+4\\sqrt{3}$.",
      "figure_ids": []
    },
    {
      "number": "900",
      "text": "900. $x$ \u662f\u4ec0\u4e48\u6570\u65f6\uff0c\u4e0b\u5217\u7b49\u5f0f\u6210\u7acb\uff1f\na) $(3x+1)^2=3x+1$\uff1b\nb) $(3x+1)^2=3(x+1)$\uff1b\nc) $(3x+4)^2=4(x+3)$\uff1b\nd) $4(x+3)^2=(2x+6)^2$.",
      "figure_ids": []
    },
    {
      "number": "901",
      "text": "901. \u8bc1\u660e\u4e0b\u5217\u4e0d\u7b49\u5f0f\u7ec4\u6ca1\u6709\u89e3\uff1a\na) $\\begin{cases}x+7<x+1,\\\\2-x>0;\\end{cases}$\nb) $\\begin{cases}(x-2)^2\\leqslant0,\\\\x<1;\\end{cases}$\nc) $\\begin{cases}|x|<3,\\\\x>12.\\end{cases}$",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 4,
      "text": "\u6211\u4eec\u77e5\u9053\uff0c\u5f53 $D>0$ \u65f6\uff0c\u4e8c\u6b21\u65b9\u7a0b $ax^2+bx+c=0$ \u6709\u4e24\u4e2a\u6839. \u6211\u4eec\u7528 $x_1$ \u548c $x_2$ \u6765\u8868\u793a\u8fd9\u4e24\u4e2a\u6839.$x_1=\\frac{-b-\\sqrt{D}}{2a}$\uff0c $x_2=\\frac{-b+\\sqrt{D}}{2a}$."
    },
    {
      "block": 7,
      "text": "\u5f53 $D=0$ \u65f6\uff0c\u4e8c\u6b21\u65b9\u7a0b $ax^2+bx+c=0$ \u6709\u552f\u4e00\u6839\uff0c\u8fd9\u4e2a\u6839\u53ef\u4ee5\u6839\u636e\u4e0b\u5217\u516c\u5f0f\u6c42\u51fa\uff1a\n$x=\\frac{-b\\pm\\sqrt{D}}{2a}$."
    },
    {
      "block": 8,
      "text": "\u5982\u679c\u7ea6\u5b9a\u5f53 $D=0$ \u65f6\uff0c\u628a\u4e8c\u6b21\u65b9\u7a0b\u770b\u4f5c\u6709\u4e24\u4e2a\u76f8\u7b49\u7684\u6839\uff0c\u90a3\u4e48\u53ef\u4ee5\u628a\u4e0a\u9762\u7684\u7ed3\u8bba\u63a8\u5e7f\u5230\u4efb\u4f55\u6709\u6839\u7684\u4e8c\u6b21\u65b9\u7a0b\u3002"
    },
    {
      "block": 10,
      "text": "**\u4e8c\u6b21\u65b9\u7a0b $ax^2+bx+c=0$ \u4e24\u6839\u7684\u548c\u7b49\u4e8e $-\\frac{b}{a}$\uff0c\u800c\u4e24\u6839\u7684\u79ef\u7b49\u4e8e $\\frac{c}{a}$.**"
    },
    {
      "block": 12,
      "text": "\u5bf9\u4e8e\u7b80\u5316\u7684\u4e8c\u6b21\u65b9\u7a0b\u6765\u8bf4\uff0c\u5b83\u7684\u6839\u4e0e\u7cfb\u6570\u4e4b\u95f4\u7684\u5173\u7cfb\u5177\u6709\u6bd4\u8f83\u7b80\u5355\u7684\u5f62\u5f0f\u3002\n\u4e8b\u5b9e\u4e0a\uff0c\u5982\u679c\u5728\u6709\u6839\u65b9\u7a0b $ax^2+bx+c=0$\u91cc\uff0c\u7cfb\u6570 $a=1$\uff0c\u90a3\u4e48\u4e24\u6839\u7684\u548c\u7b49\u4e8e $-b$\uff0c\u800c\u4e24\u6839\u7684\u79ef\u7b49\u4e8e $c$\uff0c\u5c31\u662f\u8bf4\uff1a**\u7b80\u5316\u7684\u4e8c\u6b21\u65b9\u7a0b\u4e24\u6839\u7684\u548c\u7b49\u4e8e\u7b2c\u4e8c\u4e2a\u7cfb\u6570\uff0c\u4f46\u53d6\u76f8\u53cd\u7684\u7b26\u53f7\uff0c\u800c\u4e24\u6839\u7684\u79ef\u7b49\u4e8e\u5e38\u6570\u9879\u3002\n**"
    },
    {
      "block": 15,
      "text": "**\u5982\u679c\u4e24\u4e2a\u6570 $m$ \u4e0e $n$ \u7684\u548c\u7b49\u4e8e $-\\frac{b}{a}$\uff0c\u800c\u5b83\u4eec\u7684\u79ef\u7b49\u4e8e $\\frac{c}{a}$\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u6570\u5c31\u662f\u4e8c\u6b21\u65b9\u7a0b $ax^2+bx+c=0$ \u7684\u6839\u3002\n**"
    },
    {
      "block": 21,
      "text": "**\u5bf9\u4e8e $a=1$ \u6765\u8bf4\uff0c\u5982\u679c\u4e24\u4e2a\u6570 $m$ \u4e0e $n$ \u7684\u548c\u7b49\u4e8e $-b$\uff0c\u800c\u5b83\u4eec\u7684\u79ef\u7b49\u4e8e $c$\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u6570\u5c31\u662f\u4e8c\u6b21\u65b9\u7a0b $x^2+bx+c=0$ \u7684\u6839\u3002\n**"
    }
  ],
