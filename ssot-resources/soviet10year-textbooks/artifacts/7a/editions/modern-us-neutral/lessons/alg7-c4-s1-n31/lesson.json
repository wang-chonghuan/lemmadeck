      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "$2=(\\sqrt{2})^2$，\n$0.5=(\\sqrt{0.5})^2$，\n$\\frac{1}{7}=\\left(\\sqrt{\\frac{1}{7}}\\right)^2$.",
      "id": null,
      "label": null,
      "printed_page": 199,
      "source_refs": [
        "p0205#8"
      ],
      "source_text": "$2=(\\sqrt{2})^2$，$0.5=(\\sqrt{0.5})^2$，$\\frac{1}{7}=\\left(\\sqrt{\\frac{1}{7}}\\right)^2$.",
      "changes": [
        "layout"
      ],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "我们举两个应用恒等式（1）作变形的例子.",
      "id": null,
      "label": null,
      "printed_page": 199,
      "source_refs": [
        "p0205#9"
      ],
      "source_text": "我们举两个应用恒等式（1）作变形的例子.",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "例1 求$(0.1\\sqrt{18})^2$的值.",
      "id": null,
      "label": null,
      "printed_page": 199,
      "source_refs": [
        "p0205#10"
      ],
      "source_text": "例1　求$(0.1\\sqrt{18})^2$的值.",
      "changes": [
        "layout"
      ],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "根据积的幂的性质，得",
      "id": null,
      "label": null,
      "printed_page": 199,
      "source_refs": [
        "p0205#11"
      ],
      "source_text": "根据积的幂的性质，得",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "$(0.1\\sqrt{18})^2=(0.1)^2\\cdot(\\sqrt{18})^2$.",
      "id": null,
      "label": null,
      "printed_page": 199,
      "source_refs": [
        "p0205#12"
      ],
      "source_text": "$(0.1\\sqrt{18})^2=(0.1)^2\\cdot(\\sqrt{18})^2$.",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "因为$(\\sqrt{18})^2=18$，所以$(0.1)^2\\cdot(\\sqrt{18})^2=0.01\\times18=0.18$.",
      "id": null,
      "label": null,
      "printed_page": 199,
      "source_refs": [
        "p0205#13"
      ],
      "source_text": "因为$(\\sqrt{18})^2=18$，所以$(0.1)^2\\cdot(\\sqrt{18})^2=0.01\\times18=0.18$.",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "所以，$(0.1\\sqrt{18})^2=0.18$.",
      "id": null,
      "label": null,
      "printed_page": 199,
      "source_refs": [
        "p0205#14"
      ],
      "source_text": "所以，$(0.1\\sqrt{18})^2=0.18$.",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "例2 化简分式$\\frac{x^2-3}{x+\\sqrt{3}}$.",
      "id": null,
      "label": null,
      "printed_page": 200,
      "source_refs": [
        "p0206#1"
      ],
      "source_text": "例2　化简分式$\\frac{x^2-3}{x+\\sqrt{3}}$.",
      "changes": [
        "layout"
      ],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "将分式的分子写成平方差的形式：",
      "id": null,
      "label": null,
      "printed_page": 200,
      "source_refs": [
        "p0206#2"
      ],
      "source_text": "将分式的分子写成平方差的形式：",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "$x^2-3=x^2-(\\sqrt{3})^2$.",
      "id": null,
      "label": null,
      "printed_page": 200,
      "source_refs": [
        "p0206#3"
      ],
      "source_text": "$x^2-3=x^2-(\\sqrt{3})^2$.",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "于是",
      "id": null,
      "label": null,
      "printed_page": 200,
      "source_refs": [
        "p0206#4"
      ],
      "source_text": "于是",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "$\\frac{x^2-3}{x+\\sqrt{3}}=\\frac{x^2-(\\sqrt{3})^2}{x+\\sqrt{3}}=\\frac{(x+\\sqrt{3})(x-\\sqrt{3})}{x+\\sqrt{3}}=x-\\sqrt{3}$.",
      "id": null,
      "label": null,
      "printed_page": 200,
      "source_refs": [
        "p0206#5"
      ],
      "source_text": "$\\frac{x^2-3}{x+\\sqrt{3}}=\\frac{x^2-(\\sqrt{3})^2}{x+\\sqrt{3}}=\\frac{(x+\\sqrt{3})(x-\\sqrt{3})}{x+\\sqrt{3}}=x-\\sqrt{3}$.",
      "changes": [],
