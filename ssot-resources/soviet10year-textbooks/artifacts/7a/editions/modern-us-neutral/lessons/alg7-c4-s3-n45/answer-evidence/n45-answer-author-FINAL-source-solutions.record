    {
      "exercise": "873",
      "tasks": [
        {
          "label": "a",
          "domain": "n is a natural number; both factors are positive because their product is 187.",
          "model": "n(n+6)=187",
          "factorization": "(n-11)(n+17)=0",
          "candidates": ["11", "-17"],
          "rejected": ["-17 is not natural."],
          "answer": "11 and 17",
          "verification": "11*17=187; 17-11=6."
        },
        {
          "label": "b",
          "domain": "The prompt says two numbers, not two natural numbers. Take the smaller real number to be n.",
          "model": "n(n+2)=120",
          "factorization": "(n-10)(n+12)=0",
          "candidates": ["10", "-12"],
          "rejected": [],
          "answer": "120=10*12=(-12)*(-10)",
          "verification": "Both products are 120 and the larger factor exceeds the smaller by 2."
        }
      ]
    },
    {
      "exercise": "874",
      "tasks": [
        {
          "label": "a",
          "domain": "Width w>0 cm; length w+4 cm.",
          "model": "w(w+4)=60",
          "factorization": "(w-6)(w+10)=0",
          "candidates": ["6", "-10"],
          "rejected": ["-10 is a negative width."],
          "answer": "Width 6 cm, length 10 cm; requested perimeter 32 cm.",
          "verification": "6*10=60 cm^2; 2*(6+10)=32 cm."
        },
        {
          "label": "b",
          "domain": "A side u lies in (0,31) m; the other side is 31-u.",
          "model": "u(31-u)=210",
          "factorization": "(u-10)(u-21)=0",
          "candidates": ["10", "21"],
          "rejected": [],
          "answer": "Sides 10 m and 21 m; the two roots exchange side names.",
          "verification": "2*(10+21)=62 m; 10*21=210 m^2."
        }
      ]
    },
    {
      "exercise": "875",
      "tasks": [
        {
          "label": "a",
          "domain": "n and n+1 are consecutive natural numbers.",
          "model": "n(n+1)-(2n+1)=109",
          "factorization": "(n-11)(n+10)=0",
          "candidates": ["11", "-10"],
          "rejected": ["-10 is not natural."],
          "answer": "11 and 12",
          "verification": "11*12-(11+12)=132-23=109."
        },
        {
          "label": "b",
          "domain": "n and n+1 are consecutive natural numbers.",
          "model": "(2n+1)^2-[n^2+(n+1)^2]=112",
          "factorization": "2n(n+1)=112; (n-7)(n+8)=0",
          "candidates": ["7", "-8"],
          "rejected": ["-8 is not natural."],
          "answer": "7 and 8",
          "verification": "15^2-(7^2+8^2)=225-113=112."
        }
      ]
    },
    {
      "exercise": "876",
      "tasks": [
        {
          "label": "a",
          "domain": "Scale k>0 m.",
