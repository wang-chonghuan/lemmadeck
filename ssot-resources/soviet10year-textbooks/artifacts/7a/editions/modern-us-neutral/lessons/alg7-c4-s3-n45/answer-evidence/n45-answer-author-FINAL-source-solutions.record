        {
          "label": "b",
          "domain": "Scale k>0 cm.",
          "model": "Hypotenuse 13k, given-ratio leg 12k, other leg sqrt(169k^2-144k^2)=5k=15.",
          "factorization": "25k^2=225",
          "candidates": ["3", "-3"],
          "rejected": ["-3 cannot be a positive length scale."],
          "answer": "Sides 15 cm,36 cm,39 cm; requested perimeter 90 cm.",
          "verification": "15^2+36^2=39^2; 39:36=13:12; 15+36+39=90."
        }
      ]
    },
    {
      "exercise": "877",
      "tasks": [
        {
          "label": "a",
          "domain": "x real; denominator 2 is nonzero.",
          "model": "(x^2+1)/2-x=2",
          "factorization": "x^2-2x-3=(x-3)(x+1)=0",
          "candidates": ["-1", "3"],
          "rejected": [],
          "answer": "x=-1 or x=3",
          "verification": "Multiply by 2; both roots satisfy the original equation."
        },
        {
          "label": "b",
          "domain": "x real; denominator 6 is nonzero.",
          "model": "x(x+1)/6-2x=2",
          "factorization": "x^2-11x-12=(x-12)(x+1)=0",
          "candidates": ["-1", "12"],
          "rejected": [],
          "answer": "x=-1 or x=12",
          "verification": "Multiply by 6; both roots satisfy the original equation."
        },
        {
          "label": "c",
          "domain": "x real; denominator 4 is nonzero.",
          "model": "3-x(x+2)/4=x+5",
          "factorization": "x^2+6x+8=(x+2)(x+4)=0",
          "candidates": ["-4", "-2"],
          "rejected": [],
          "answer": "x=-4 or x=-2",
          "verification": "Multiply by 4 and move all terms to one side."
        },
        {
          "label": "d",
          "domain": "x real; denominators 5 and 10 are nonzero.",
          "model": "(3x+4)/5-(x^2-4x-6)/10=-1",
          "factorization": "x^2-10x-24=(x-12)(x+2)=0",
          "candidates": ["-2", "12"],
          "rejected": [],
          "answer": "x=-2 or x=12",
          "verification": "Multiply by 10 and move all terms to one side."
        },
        {
          "label": "e",
          "domain": "y real; denominators 12,4,2 are nonzero.",
          "model": "(y+1)^2/12-(7-y)/4=y/2",
          "factorization": "y^2-y-20=(y-5)(y+4)=0",
          "candidates": ["-4", "5"],
          "rejected": [],
          "answer": "y=-4 or y=5",
          "verification": "Multiply by 12 and expand (y+1)^2."
        },
        {
          "label": "f",
          "domain": "y real; denominators 5,4,8 are nonzero.",
          "model": "(3-y)/5=(y-2)/4+(y-2)^2/8",
          "factorization": "5y^2-2y-24=(5y-12)(y+2)=0",
          "candidates": ["-2", "12/5"],
          "rejected": [],
          "answer": "y=-2 or y=12/5",
          "verification": "Multiply by 40; expand the squared binomial before collecting terms."
        }
      ]
    },
