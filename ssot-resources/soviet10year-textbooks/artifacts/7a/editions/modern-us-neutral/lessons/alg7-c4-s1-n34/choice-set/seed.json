  "exercises": [
    {
      "number": "746",
      "text": "746. \u51fd\u6570 $f$ \u7684\u5b9a\u4e49\u57df\u662f\u5b9e\u6570\u96c6. \u5229\u7528\u5b83\u7684\u56fe\u8c61\uff08\u56fe52\uff09\u6bd4\u8f83\u4e0b\u5217\u4e24\u4e2a\u51fd\u6570\u503c\u7684\u5927\u5c0f\uff1a\na) $f(-2.1)$ \u548c $f(-3.6)$\uff1b\nb) $f(1.3)$ \u548c $f(2.8)$\uff1b\nc) $f(x_1)$ \u548c $f(x_2)$\uff0c\u5176\u4e2d $x_1<0$\uff0c$x_2<0$\uff0c\u4e14 $x_2>x_1$\uff1b\nd) $f(x_1)$ \u548c $f(x_2)$\uff0c\u5176\u4e2d $x_1>0$\uff0c$x_2>0$\uff0c\u4e14 $x_2>x_1$.\u5206\u522b\u6307\u51fa\u51fd\u6570 $f$ \u51cf\u5c0f\u548c\u589e\u5927\u65f6\u81ea\u53d8\u91cf\u503c\u7684\u96c6\u5408.",
      "figure_ids": [
        "fig-52"
      ]
    },
    {
      "number": "747",
      "text": "747. \u5728\u56fe53\u91cc\u753b\u51fa\u7684\u662f\u4e00\u4eba\u9a91\u81ea\u884c\u8f66\u7684\u901f\u5ea6 $v$ \u5bf9\u4e8e\u65f6\u95f4 $t$\u7684\u56fe\u8c61. \u6307\u51fa\u5728\u54ea\u4e00\u6bb5\u65f6\u95f4\u5185\u9a91\u81ea\u884c\u8f66\u7684\u901f\u5ea6\uff1a\na) \u589e\u5927\uff1b\nb) \u51cf\u5c0f\uff1b\nc) \u4fdd\u6301\u4e0d\u53d8.",
      "figure_ids": [
        "fig-53"
      ]
    },
    {
      "number": "748",
      "text": "748. \u7528\u4f5c\u56fe\u7684\u65b9\u6cd5\u8868\u793a\u4e0b\u5217\u51fd\u6570\u56fe\u8c61\u7684\u4f4d\u7f6e\uff1a\na) $y=17x-2$\uff1b\nb) $y=-2.8x+1$.\u51fd\u6570\u662f\u589e\u51fd\u6570\u8fd8\u662f\u51cf\u51fd\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "749",
      "text": "749. \u4e0b\u5217\u51fd\u6570\u54ea\u4e9b\u662f\u589e\u51fd\u6570\uff0c\u54ea\u4e9b\u662f\u51cf\u51fd\u6570\uff1f$y=8x-5$\uff0c$y=0.01x$\uff0c$y=-3x+10$\uff0c$y=-49x+1000$\uff0c$y=-\\frac{1}{12}x$\uff0c$y=0x+5$.",
      "figure_ids": []
    },
    {
      "number": "750",
      "text": "750. \u7528\u4f5c\u56fe\u7684\u65b9\u6cd5\u8868\u793a\u4e0b\u5217\u51fd\u6570\u56fe\u8c61\u7684\u4f4d\u7f6e\uff1a\na) $y=x^2$\uff1b\nb) $y=-x^2$.\u5206\u522b\u6307\u51fa\u51fd\u6570\u589e\u5927\u548c\u51cf\u5c0f\u65f6\u81ea\u53d8\u91cf\u503c\u7684\u96c6\u5408.",
      "figure_ids": []
    },
    {
      "number": "751",
      "text": "751. \u7528\u4f5c\u56fe\u7684\u65b9\u6cd5\u8868\u793a\u4e0b\u5217\u51fd\u6570\u56fe\u8c61\u7684\u4f4d\u7f6e\uff1a\na) $y=-\\frac{6}{x}$\uff1b\nb) $y=\\frac{4}{x}$.\u5206\u522b\u6307\u51fa\u51fd\u6570\u589e\u5927\u548c\u51cf\u5c0f\u7684\u533a\u95f4.",
      "figure_ids": []
    },
    {
      "number": "752",
      "text": "752. \u4efb\u610f\u4f5c\u4e00\u4e2a\u51fd\u6570\u7684\u56fe\u8c61\uff0c\u5b83\u7684\u5b9a\u4e49\u57df\u662f\u95ed\u533a\u95f4 $[-5,7]$\uff0c\u5728\u533a\u95f4 $[-5,-2[$ \u5185\u51cf\u5c0f\uff0c\u5728\u533a\u95f4 $]-2,4[$ \u589e\u5927\uff0c\u5728\u533a\u95f4$]4,7]$ \u5185\u51cf\u5c0f.",
      "figure_ids": []
    },
    {
      "number": "753",
      "text": "753. \u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\na) $3\\sqrt{0.16}-0.1\\sqrt{225}$\uff1b\nb) $0.2\\sqrt{900}+1.8\\sqrt{\\frac{1}{9}}$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 8,
      "text": "\u6211\u4eec\u7ea6\u5b9a\uff0c\u4e00\u4e2a\u53d8\u91cf\u7684\u503c\u6784\u6210\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u65f6\uff0c\u8fd9\u4e2a\u53d8\u91cf\u53eb\u505a\u51fd\u6570\u7684\u81ea\u53d8\u91cf."
    },
    {
      "block": 12,
      "text": "\u4e00\u822c\u5730\uff0c\u5982\u679c\u51fd\u6570 $f$ \u7684\u81ea\u53d8\u91cf\u5728\u96c6\u5408 $M$ \u4e0a\u53d6\u8f83\u5927\u7684\u503c\u65f6\uff0c\u5bf9\u5e94\u7684\u51fd\u6570\u503c\u4e5f\u8f83\u5927\uff0c\u5c31\u8bf4\u51fd\u6570 $f$ \u5728\u96c6\u5408 $M$ \u4e0a\u662f\u589e\u51fd\u6570."
    },
    {
      "block": 14,
      "text": "\u4e00\u822c\u5730\uff0c\u5982\u679c\u51fd\u6570 $f$ \u7684\u81ea\u53d8\u91cf\u5728\u96c6\u5408 $M$ \u4e0a\u53d6\u8f83\u5927\u7684\u503c\u65f6\uff0c\u5bf9\u5e94\u7684\u51fd\u6570\u503c\u53cd\u800c\u8f83\u5c0f\uff0c\u5c31\u8bf4\u51fd\u6570 $f$ \u5728\u96c6\u5408 $M$ \u4e0a\u662f\u51cf\u51fd\u6570."
    },
    {
      "block": 15,
      "text": "\u5982\u679c\u5728\u6574\u4e2a\u5b9a\u4e49\u57df\u4e0a\u51fd\u6570 $f$ \u603b\u662f\u589e\u5927\uff08\u6216\u8005\u51cf\u5c0f\uff09\uff0c\u90a3\u4e48\u5c31\u8bf4\uff0c$f$ \u662f\u589e\u51fd\u6570\uff08\u6216\u8005\u51cf\u51fd\u6570\uff09."
    },
    {
      "block": 23,
      "text": "\u4e00\u822c\u5730\u8bf4\uff0c**\u7531\u5f0f $y=kx+l$ \u7ed9\u51fa\u7684\u51fd\u6570 $f$\uff0c\u5f53 $k>0$ \u65f6\uff0c$f$ \u662f\u589e\u51fd\u6570\uff1b\n\u5f53 $k<0$ \u65f6\uff0c$f$ \u662f\u51cf\u51fd\u6570.**"
    },
    {
      "block": 28,
      "text": "\u5f53 $k=0$ \u65f6\uff0c\u51fd\u6570 $f$ \u53ea\u53d6\u4e00\u4e2a\u503c. \u663e\u7136\uff0c\u8fd9\u65f6\u51fd\u6570 $f$ \u65e2\u4e0d\u662f\u589e\u51fd\u6570\uff0c\u4e5f\u4e0d\u662f\u51cf\u51fd\u6570."
    }
  ],
