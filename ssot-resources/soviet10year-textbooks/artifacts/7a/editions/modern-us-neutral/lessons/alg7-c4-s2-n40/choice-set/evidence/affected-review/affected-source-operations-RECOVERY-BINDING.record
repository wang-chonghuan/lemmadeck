  "operations": [
    {
      "id": "829-method-1",
      "originalTask": "Look up sqrt(0.3333), then multiply the table result by 6.",
      "independentAddressDerivation": "0.3333=33.33*10^-2. At N=33, main digit 3 addresses 33+3/10=33.3; correction digit 3 adds 3/100=0.03 to address 33.33.",
      "sourceCaptureIndex": 6,
      "independentTableArithmetic": "(5.771+3*0.001)*10^-1=0.5774; 6*0.5774=3.4644.",
      "unroundedProduct": "3.4644",
      "threeDecimalReport": "3.464",
      "rounding": "The fourth decimal is 4, so rounding to three decimal places is unambiguous; no tie policy is needed.",
      "operationProfile": {"mainCellRetrieval": 1, "correctionCellRetrieval": 1, "correctionAddition": 1, "rootRescaling": 1, "postLookupMultiplicationBy6": 1},
      "sourceApproximationDistinction": "0.3333 is not exactly 1/3. Its unrounded exact target is smaller than sqrt12; the two returned three-decimal reports can nevertheless coincide because these are rounded table outputs."
    },
    {
      "id": "829-method-2",
      "originalTask": "Rewrite the exact expression as sqrt12 and look it up.",
      "independentAddressDerivation": "6sqrt(1/3)=sqrt(36/3)=sqrt12. N=12, main digit 0 gives the exact in-range address 12.",
      "sourceCaptureIndex": 4,
      "independentTableArithmetic": "Direct captured main entry 3.464; no correction or root rescaling.",
      "threeDecimalReport": "3.464",
      "operationProfile": {"mainCellRetrieval": 1, "correctionCellRetrieval": 0, "correctionAddition": 0, "rootRescaling": 0, "postLookupMultiplicationBy6": 0},
      "comparison": "Route 2 requires fewer table/correction/rescaling operations even without counting route 1's extra multiplication. Numerical equality of the three-decimal reports does not imply equal exact inputs."
    },
    {
      "id": "830-a",
      "originalTask": "Evaluate 4sqrt5 from the table.",
      "independentAddressDerivation": "4sqrt5=sqrt(16*5)=sqrt80. N=80, main digit 0; no correction or rescaling.",
      "sourceCaptureIndex": 7,
      "independentTableArithmetic": "8.944*1=8.944.",
      "report": "8.944"
    },
    {
      "id": "830-b",
      "originalTask": "Evaluate 15sqrt2 from the table.",
      "independentAddressDerivation": "15sqrt2=sqrt450=sqrt(4.5*10^2)=10sqrt4.5. N=4.5, main digit 0.",
      "sourceCaptureIndex": 1,
      "independentTableArithmetic": "2.121*10=21.21.",
      "report": "21.21"
    },
    {
      "id": "830-c",
      "originalTask": "Evaluate 14sqrt(1/7) from the table.",
      "independentAddressDerivation": "14sqrt(1/7)=sqrt(196/7)=sqrt28. N=28, main digit 0; exact cancellation avoids approximating 1/7.",
      "sourceCaptureIndex": 5,
      "independentTableArithmetic": "5.292*1=5.292.",
      "report": "5.292"
    },
    {
      "id": "830-d",
      "originalTask": "Evaluate 12sqrt(5/6) from the table.",
      "independentAddressDerivation": "12sqrt(5/6)=sqrt(144*5/6)=sqrt120=sqrt(1.2*10^2)=10sqrt1.2. N=1.2, main digit 0.",
      "sourceCaptureIndex": 0,
      "independentTableArithmetic": "1.095*10=10.95.",
      "report": "10.95"
    },
    {
      "id": "831-a",
      "originalTask": "Use S approximately 12.5 cm^2 and pi approximately 3.14 to obtain the positive radius from the table.",
      "retainedExactFormula": "r=sqrt(S/pi), S>=0, pi>0; for this positive area take the positive root. Area units cm^2 give radius units cm.",
      "independentAddressDerivation": "12.5/3.14=625/157=3.980891719745... . The visible item's four-significant-figure policy gives 3.981. N=3.9, main digit 8 gives 3.98; correction digit 1 gives +0.001.",
      "sourceCaptureIndex": 3,
      "independentTableArithmetic": "1.995+0*0.001=1.995 cm.",
      "report": "1.995 cm",
      "precision": "A table-return report at three decimal places under an explicit authored input-rounding condition. Not an exact radius for true pi or an assertion of four significant figures of measured accuracy."
    },
