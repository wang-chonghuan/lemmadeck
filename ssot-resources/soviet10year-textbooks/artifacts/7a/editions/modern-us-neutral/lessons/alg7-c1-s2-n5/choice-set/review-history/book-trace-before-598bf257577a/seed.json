    {
      "number": "77",
      "text": "77. \u4e0b\u5217\u5404\u9898\u4e2d\u4e24\u4e2a\u8bed\u53e5\u662f\u5426\u7b49\u4ef7\uff1f\na) \u201c\u81ea\u7136\u6570 $x$ \u7684\u672b\u4f4d\u6570\u5b57\u662f $3$\u201d\uff0c\u201c\u81ea\u7136\u6570 $x$ \u7684\u5e73\u65b9\u7684\u672b\u4f4d\u6570\u5b57\u662f $9$\u201d\uff1b\nb) \u201c\u81ea\u7136\u6570 $a$ \u80fd\u88ab $8$ \u6574\u9664\u201d\uff0c\u201c\u81ea\u7136\u6570 $a$ \u662f\u5076\u6570\u201d\uff1b\nc) \u201c\u81ea\u7136\u6570 $y$ \u662f\u4e24\u4f4d\u6570\u201d\uff0c\u201c\u81ea\u7136\u6570 $y$ \u5c0f\u4e8e $100$\u201d\uff1b\nd) \u201c$a$ \u548c $19$ \u4e24\u6570\u7684\u79ef\u7b49\u4e8e\u96f6\u201d\uff0c\u201c$a$ \u7b49\u4e8e\u96f6\u201d\u3002",
      "figure_ids": []
    },
    {
      "number": "78",
      "text": "78. \u4e0b\u5217\u5404\u9898\u4e2d\u4e24\u4e2a\u65b9\u7a0b\u662f\u5426\u7b49\u4ef7\uff08\u80af\u5b9a\u56de\u7b54\u65f6\u7528\u7b26\u53f7 $\\Longleftrightarrow$ \u5199\u51fa\u7ed3\u8bba\uff09\uff1f\na) $x^2=25$\uff0c$x=-5$\uff1b\nb) $x^2-2x+1=100$\uff0c$(x-1)^2=100$\u3002",
      "figure_ids": []
