    {
      "number": "539",
      "text": "539. \u628a\u5173\u4e8e\u4e0d\u7b49\u5f0f\u4e24\u8fb9\u5206\u522b\u76f8\u52a0\u7684\u5b9a\u7406\u5e94\u7528\u4e8e\u4e0b\u5217\u5404\u7ec4\u4e0d\u7b49\u5f0f\uff1a\na) $12>-5$\uff0c$9>7$\uff1b\nb) $-28<0$\uff0c$-10<-6$\uff1b\nc) $-2.5<-0.7$\uff0c$-6.5<-1.3$\uff1b\nd) $11>7.4$\uff0c$0>-8$\u3002",
      "figure_ids": []
    },
    {
      "number": "540",
      "text": "540. \u4e3e\u4f8b\u8bf4\u660e\uff0c\u4e0d\u7b49\u53f7\u65b9\u5411\u4e0d\u540c\u7684\u4e24\u4e2a\u771f\u4e0d\u7b49\u5f0f\u9010\u9879\u76f8\u52a0\u65f6\uff0c\u53ef\u80fd\u5f97\u5230\u7531 $>$ \u53f7\u6784\u6210\u7684\u4e0d\u7b49\u5f0f\uff0c\u4e5f\u53ef\u80fd\u5f97\u5230\u7531 $<$ \u53f7\u6784\u6210\u7684\u4e0d\u7b49\u5f0f\u3002",
      "figure_ids": []
    },
    {
      "number": "541",
      "text": "541. \u628a\u5173\u4e8e\u4e0d\u7b49\u5f0f\u4e24\u8fb9\u5206\u522b\u76f8\u4e58\u7684\u5b9a\u7406\u5e94\u7528\u4e8e\u4e0b\u5217\u5404\u7ec4\u4e0d\u7b49\u5f0f\uff1a\na) $5>2$\uff0c$4>3$\uff1b\nb) $1<7$\uff1b$10<15$\uff1b\nc) $3>1$\uff0c$\\frac{1}{3}>\\frac{1}{5}$\uff1b\nd) $8<10$\uff1b$\\frac{1}{4}<\\frac{1}{2}$\u3002",
      "figure_ids": []
    },
    {
      "number": "542",
      "text": "542. \u4e3e\u4f8b\u8bf4\u660e\uff0c\u5982\u679c\u5728\u4e0d\u7b49\u5f0f $a<b$ \u548c $c<d$ \u4e2d\uff0c$a$\uff0c$b$\uff0c$c$\uff0c$d$ \u5404\u6570\u53ef\u4ee5\u4e3a\u8d1f\u6570\uff0c\u90a3\u4e48\u4e0d\u7b49\u5f0f $ac<bd$ \u53ef\u80fd\u4e3a\u5047\u4e0d\u7b49\u5f0f\u3002",
      "figure_ids": []
    },
    {
      "number": "543",
      "text": "543. \u5e94\u7528\u5173\u4e8e\u4e0d\u7b49\u5f0f\u4e24\u8fb9\u5206\u522b\u76f8\u52a0\u7684\u5b9a\u7406\uff0c\u5199\u51fa\u7531\u4e0b\u5217\u5404\u7ec4\u4e24\u4e2a\u4e0d\u7b49\u5f0f\u63a8\u51fa\u7684\u4e0d\u7b49\u5f0f\uff1a\na) $a>-10$\uff0c$b>2$\uff1b\nb) $x<5$\uff0c$y<-8$\uff1b\nc) $m\\geqslant7$\uff0c$n\\geqslant-7$\uff1b\nd) $c\\leqslant12$\uff0c$d\\leqslant-4$\u3002",
      "figure_ids": []
    },
    {
      "number": "544",
      "text": "544. \u5e94\u7528\u5173\u4e8e\u4e0d\u7b49\u5f0f\u4e24\u8fb9\u5206\u522b\u76f8\u4e58\u7684\u5b9a\u7406\uff0c\u5199\u51fa\u7531\u4e0b\u5217\u5404\u7ec4\u4e24\u4e2a\u4e0d\u7b49\u5f0f\u63a8\u51fa\u7684\u4e0d\u7b49\u5f0f\uff1a\na) $a\\geqslant12$\uff0c$b\\geqslant\\frac{1}{3}$\uff1b\nb) $0<a<0.5$\uff0c$0<b<2$\u3002",
      "figure_ids": []
    },
    {
      "number": "545",
      "text": "545. \u4e0b\u5217\u547d\u9898\u662f\u4e0d\u662f\u771f\u547d\u9898\uff1f\na) $(m>2$ \u548c $n>5)\\Longrightarrow(m+n>7)$\uff1b\nb) $(m>2$ \u548c $n>5)\\Longrightarrow(m+n>6)$\uff1b\nc) $(m>2$ \u548c $n>5)\\Longrightarrow(m+n>10)$\uff1b\nd) $(m>4$ \u548c $n>3)\\Longrightarrow(mn>12)$\uff1b\ne) $(m>4$ \u548c $n>3)\\Longrightarrow(mn>11)$\uff1b\nf) $(m>4$ \u548c $n>3)\\Longrightarrow(mn>22)$\u3002",
      "figure_ids": []
    },
    {
      "number": "546",
      "text": "546. \u4e0b\u5217\u547d\u9898\u662f\u4e0d\u662f\u771f\u547d\u9898\uff1f\na) $(a>b)\\Longrightarrow(a^2>b^2)$\uff1b\nb) $(a^2>b^2)\\Longrightarrow(a>b)$\u3002",
      "figure_ids": []
    },
    {
      "number": "547",
      "text": "547. \u4f5c\u51fa\u65b9\u7a0b $2x+3y=12$ \u7684\u56fe\u8c61\u3002\u5728\u4ec0\u4e48\u8c61\u9650\u5185\u6ca1\u6709\u8fd9\u4e2a\u56fe\u8c61\u4e0a\u7684\u70b9\uff1f",
      "figure_ids": []
    }
