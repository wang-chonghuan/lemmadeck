  "exercises": [
    {
      "number": "83",
      "text": "83. \u6307\u51fa\u4e0b\u5217\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\uff1a\na) \u81ea\u7136\u6570 $k$ \u662f $12$ \u7684\u7ea6\u6570\uff1b\nb) $m$ \u662f\u4e8c\u4f4d\u6570\uff0c\u6570\u5b57\u548c\u7b49\u4e8e $15$\uff1b\nc) \u81ea\u7136\u6570 $x$ \u548c $y$ \u7684\u548c\u7b49\u4e8e $10$\uff1b\nd) \u6574\u6570 $a$ \u548c $b$ \u7684\u79ef\u7b49\u4e8e $-6$\u3002",
      "figure_ids": []
    },
    {
      "number": "84",
      "text": "84. \u6c42\u4e0b\u5217\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\uff1a\na) $0.3x+4=0$\uff1b\nb) $6(10+x)(x-2.4)=0$\uff1b\nc) $x\\leqslant6$\uff1b\nd) $x\\geqslant3$\uff1b\ne) $|x|\\leqslant4$\uff1b\nf) $|x|>5$\u3002",
      "figure_ids": []
    },
    {
      "number": "85",
      "text": "85. \u8bf4\u660e\u4e0b\u5217\u5404\u9898\u4e2d\u4ece\u4e00\u4e2a\u547d\u9898\u80fd\u4e0d\u80fd\u63a8\u51fa\u53e6\u4e00\u4e2a\u547d\u9898\u3002\u4f5c\u56fe\u8868\u793a\u4e24\u4e2a\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u4e4b\u95f4\u7684\u5173\u7cfb\uff1a\na) \u201c$x$ \u662f\u5927\u4e8e $2$ \u7684\u8d28\u6570\u201d\uff0c\u201c$x$ \u662f\u5947\u6570\u201d\uff1b\nb) \u201c\u56db\u8fb9\u5f62 $F$ \u662f\u6b63\u65b9\u5f62\u201d\uff0c\u201c\u56db\u8fb9\u5f62 $F$ \u662f\u77e9\u5f62\u201d\uff1b\nd) \u201c$n$ \u662f\u6574\u6570\u201d\uff0c\u201c$n$ \u662f\u81ea\u7136\u6570\u201d\u3002",
      "figure_ids": []
    },
    {
      "number": "86",
      "text": "86. \u5728\u6570\u8f74\u4e0a\u8868\u793a\u6bcf\u4e00\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\uff0c\u5e76\u4e14\u8bf4\u660e\uff1a\na) \u4ece\u8bed\u53e5\u201c$x<3$\u201d\u80fd\u4e0d\u80fd\u63a8\u51fa\u8bed\u53e5\u201c$x<6$\u201d\uff1b\nb) \u4ece\u8bed\u53e5\u201c$x>10$\u201d\u80fd\u4e0d\u80fd\u63a8\u51fa\u8bed\u53e5\u201c$x>16$\u201d\uff1b\nc) \u4ece\u8bed\u53e5\u201c$x\\leqslant4$\u201d\u80fd\u4e0d\u80fd\u63a8\u51fa\u8bed\u53e5\u201c$|x|\\leqslant4$\u201d\uff1b\nd) \u4ece\u8bed\u53e5\u201c$|x|\\leqslant1$\u201d\u80fd\u4e0d\u80fd\u63a8\u51fa\u8bed\u53e5\u201c$x\\leqslant1$\u201d\u3002",
      "figure_ids": []
    },
    {
      "number": "87",
      "text": "87. \u6307\u51fa\u4e0b\u5217\u5404\u9898\u4e2d\u4e24\u4e2a\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u4e4b\u95f4\u7684\u5173\u7cfb\uff1a\na) $x=3$ \u548c $|x|=3$\uff1b\nb) $x^2=81$ \u548c $|x|=9$\uff1b\nc) $x^2=8x$ \u548c $x=8$\uff1b\nd) $(x^2+1)(x-5)=0$ \u548c $x-5=0$\uff1b\ne) $x+y=-20$ \u548c $(x+y)^2=400$\uff1b\nf) $xy=6$ \u548c $y=\\frac{6}{x}$\u3002",
      "figure_ids": []
    },
    {
      "number": "88",
      "text": "88. \u6307\u51fa\u4e0b\u5217\u5404\u5f0f\u7684\u6700\u5c0f\u503c\uff1a\na) $|x-10|$\uff1b\nb) $|x|-10$\u3002\u5f53\u53d8\u91cf\u53d6\u4ec0\u4e48\u503c\u65f6\uff0c\u4e0a\u5217\u5404\u5f0f\u5206\u522b\u53d6\u6700\u5c0f\u503c\uff1f",
      "figure_ids": []
    },
    {
      "number": "89",
      "text": "89. \u8bc1\u660e\uff1a\u5206\u5f0f$\\frac{2a-5x}{3a-3x}+\\frac{a-5x}{4x-4a}$\u7684\u503c\u4e0e\u53d8\u91cf\u7684\u503c\u65e0\u5173\uff08\u5bf9\u4e8e\u6240\u6709\u4f7f\u4e0a\u5f0f\u6709\u610f\u4e49\u7684\u53d8\u91cf\u503c\u800c\u8a00\uff09\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u4e00\u822c\u5730\uff0c**\u5bf9\u4e8e\u542b\u4e00\u4e2a\u53d8\u91cf\u7684\u8bed\u53e5\u6765\u8bf4\uff0c\u4f7f\u5f97\u8bed\u53e5\u6210\u4e3a\u771f\u547d\u9898\u7684\u53d8\u91cf\u503c\u96c6\u5408\uff0c\u53eb\u505a\u8fd9\u4e2a\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u3002\n**"
    },
    {
      "block": 2,
      "text": "\u7c7b\u4f3c\u5730\u53ef\u4ee5\u5b9a\u4e49\u542b\u4e24\u4e2a\u6216\u591a\u4e2a\u53d8\u91cf\u7684\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u3002"
    },
    {
      "block": 6,
      "text": "\u6211\u4eec\u77e5\u9053\uff0c\u542b\u672a\u77e5\u6570\u7684\u65b9\u7a0b\u548c\u4e0d\u7b49\u5f0f\u7684\u771f\u503c\u96c6\u5408\u6709\u4e00\u4e2a\u4e13\u95e8\u7684\u540d\u79f0\uff0c\u5373\u89e3\u96c6\u5408\uff08\u5bf9\u4e00\u5143\u65b9\u7a0b\u6765\u8bf4\uff0c\u53c8\u53eb\u505a\u6839\u7684\u96c6\u5408\uff09\u3002"
    },
    {
      "block": 12,
      "text": "\u4e00\u822c\u5730\uff0c\u8bbe\u4e24\u4e2a\u8bed\u53e5\u5305\u542b\u7684\u53d8\u91cf\u76f8\u540c\uff0c\u800c\u4e14\u4ece\u7b2c\u4e00\u4e2a\u8bed\u53e5\u53ef\u4ee5\u63a8\u51fa\u7b2c\u4e8c\u4e2a\u8bed\u53e5\u3002\n\u90a3\u4e48\uff0c\u53ea\u8981\u7b2c\u4e00\u4e2a\u8bed\u53e5\u662f\u771f\u8bed\u53e5\uff0c\u7b2c\u4e8c\u4e2a\u8bed\u53e5\u4e5f\u662f\u771f\u8bed\u53e5\u3002\n\u8fd9\u5c31\u662f\u8bf4\uff0c\u7b2c\u4e00\u4e2a\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u91cc\u7684\u6bcf\u4e00\u4e2a\u5143\u7d20\uff0c\u540c\u65f6\u53c8\u662f\u7b2c\u4e8c\u4e2a\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u91cc\u7684\u5143\u7d20\uff0c\u5373\u7b2c\u4e00\u4e2a\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u662f\u7b2c\u4e8c\u4e2a\u8bed\u53e5\u771f\u503c\u96c6\u5408\u7684\u5b50\u96c6\u3002"
    },
    {
      "block": 14,
      "text": "\u53cd\u8fc7\u6765\u663e\u7136\u4e5f\u5bf9\uff1a\u5982\u679c\u4e24\u4e2a\u8bed\u53e5\u5305\u542b\u7684\u53d8\u91cf\u76f8\u540c\uff0c\u800c\u4e14\u4e00\u4e2a\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u662f\u53e6\u4e00\u4e2a\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u7684\u5b50\u96c6\uff0c\u90a3\u4e48\u4ece\u524d\u4e00\u8bed\u53e5\u53ef\u4ee5\u63a8\u51fa\u540e\u4e00\u8bed\u53e5\u3002\n\uff08\u4f5c\u4e3a\u4e00\u79cd\u7279\u6b8a\u60c5\u5f62\uff0c\u5f53\u524d\u4e00\u8bed\u53e5\u7684\u771f\u503c\u96c6\u5408\u662f\u7a7a\u96c6\u65f6\uff0c\u8fd9\u4e00\u7ed3\u8bba\u4ecd\u7136\u6210\u7acb\u3002\uff09"
    },
    {
      "block": 15,
      "text": "\u4e0d\u96be\u7406\u89e3\uff0c\u5305\u542b\u76f8\u540c\u53d8\u91cf\u7684\u4e24\u4e2a\u8bed\u53e5\uff0c\u5f53\u4e14\u4ec5\u5f53\u5b83\u4eec\u7684\u771f\u503c\u96c6\u5408\u76f8\u540c\u65f6\uff0c\u8fd9\u4e24\u4e2a\u8bed\u53e5\u7b49\u4ef7\u3002\n\u4f5c\u4e3a\u7279\u6b8a\u60c5\u5f62\uff0c\u542b\u76f8\u540c\u53d8\u91cf\u7684\u4e24\u4e2a\u65b9\u7a0b\u6216\u4e0d\u7b49\u5f0f\uff0c\u5f53\u4e14\u4ec5\u5f53\u5b83\u4eec\u7684\u89e3\u96c6\u5408\u76f8\u540c\u65f6\uff0c\u8fd9\u4e24\u4e2a\u65b9\u7a0b\u6216\u4e0d\u7b49\u5f0f\u7b49\u4ef7\uff08\u5373\u540c\u89e3\uff09\u3002\n\uff08\u5f53\u4e24\u4e2a\u65b9\u7a0b\u6216\u4e0d\u7b49\u5f0f\u65e0\u89e3\u65f6\uff0c\u8fd9\u4e2a\u7ed3\u8bba\u4ecd\u7136\u6210\u7acb\u3002\uff09"
    }
  ],
