import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const prior = '.tmp/resume182-6-8a-n13-0789';
const base = '.tmp/resume182-6-8a-n14-0789';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bind = file => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), sha256: sha(bytes), bytes: bytes.length };
};
const outputs = [];
for (const name of ['promote-answers.mjs', 'prepare-choice-review.mjs', 'bind-choice-review.mjs', 'delivery.mjs']) {
  const source = `${prior}/${name}`;
  const target = `${base}/${name}`;
  assert.ok(!fs.existsSync(target));
  let code = fs.readFileSync(source, 'utf8')
    .replaceAll('resume182-6-8a-n13-0789', 'resume182-6-8a-n14-0789')
    .replaceAll('alg8-c3-s1-n13', 'alg8-c3-s2-n14')
    .replaceAll('resume182-6-n13-', 'resume182-6-n14-');
  if (name === 'promote-answers.mjs') {
    assert.ok(code.includes('assert.equal(data.answers.length, 5);'));
    code = code.replace('assert.equal(data.answers.length, 5);', 'assert.equal(data.answers.length, 9);');
  }
  if (name === 'bind-choice-review.mjs') {
    assert.ok(code.includes('assert.equal(review.source_reviews.length, 5);'));
    code = code.replace('assert.equal(review.source_reviews.length, 5);', 'assert.equal(review.source_reviews.length, 9);');
  }
  if (name === 'delivery.mjs') {
    assert.ok(code.includes("['0086', '0087', '0088']"));
    code = code.replace("['0086', '0087', '0088']", "['0089', '0090', '0091']")
      .replaceAll('N13_NARROW_STAGED', 'N14_NARROW_STAGED');
  }
  fs.writeFileSync(target, code, { flag: 'wx' });
  const syntax = spawnSync(process.execPath, ['--check', target], { encoding: 'utf8' });
  assert.equal(syntax.status, 0, syntax.stderr);
  outputs.push({ source: bind(source), output: bind(target), syntaxExit: syntax.status });
}
const file = `${base}/content-support.record`;
fs.writeFileSync(file, `${JSON.stringify({
  status: 'SCOPED_CONTENT_SUPPORT_PREPARED_NOT_EXECUTED',
  outputs, scope: { book: '8a', lesson: 'alg8-c3-s2-n14', workdir: repo },
  oldPassReruns: 0, imageViews: 0, databaseWrites: 0,
  hostTokens: 'unknown', totalCost: 'unknown', finish: 'review',
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(bind(file)));
