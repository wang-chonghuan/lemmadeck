import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const prior = '.tmp/resume182-6-8a-n13-0789';
const base = '.tmp/resume182-6-8a-n14-0789';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bind = file => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), sha256: sha(bytes), bytes: bytes.length, realpath: fs.realpathSync(file) };
};
const sourceReady = bind(`${prior}/display-FIRST/ready-headless1.record`);
assert.equal(sourceReady.sha256, '45b1d29fdf2c03a7d633ea5419bd9dc79b92068366a4741bfa30064b2b62abdd');
const originalReady = JSON.parse(fs.readFileSync(sourceReady.path));
const assembly = JSON.parse(fs.readFileSync(`${base}/assembly-FIRST/assembly.record`));
assert.equal(assembly.lesson, 'alg8-c3-s2-n14');
assert.equal(assembly.exercise_count, 9);
assert.deepEqual(assembly.figures, []);
const replacements = [
  ['resume182-6-8a-n13-0789', 'resume182-6-8a-n14-0789'],
  ['alg8-c3-s1-n13', 'alg8-c3-s2-n14'],
  ['n13-parent-display-ready@1', 'n14-parent-display-ready@1'],
  ['bounded-n13-offline-display@1', 'bounded-n14-offline-display@1'],
  ['resume182-6-n13-', 'resume182-6-n14-'],
  ['ready-headless1.record', 'ready-FIRST.record'],
];
const adapt = text => replacements.reduce((code, [from, to]) => code.replaceAll(from, to), text);
const names = ['prepare.mjs', 'run.mjs', 'display-helper.mjs', 'display-helper-base.mjs'];
const origins = [];
fs.mkdirSync(`${base}/display-FIRST`);
for (const name of names) {
  const source = bind(`${prior}/display-FIRST/${name}`);
  assert.equal(source.sha256, originalReady.files.find(item => item.path === source.path).sha256);
  const target = `${base}/display-FIRST/${name}`;
  fs.writeFileSync(target, adapt(fs.readFileSync(source.path, 'utf8')), { flag: 'wx' });
  origins.push({ source, output: bind(target) });
}
const observer = `${base}/observe-tools.mjs`;
assert.equal(bind(`${prior}/observe-tools.mjs`).sha256, originalReady.observer.output.sha256);
fs.writeFileSync(observer, adapt(fs.readFileSync(`${prior}/observe-tools.mjs`, 'utf8')), { flag: 'wx' });
const files = origins.map(item => item.output);
const pins = originalReady.pins.filter(item => !names.some(name => item.path === `${repo}/${prior}/display-FIRST/${name}`));
for (const item of pins) assert.equal(bind(item.path).sha256, item.sha256);
pins.push(...files);
const readyFile = `${base}/display-FIRST/ready-FIRST.record`;
fs.writeFileSync(readyFile, `${JSON.stringify({
  status: 'SCRIPTS_PREPARED_RUNTIME_NOT_EXECUTED', workdir: repo, files, pins, origins,
  figureIds: [], figures: [], exerciseCount: 9,
  parentGate: {
    schema: 'n14-parent-display-ready@1', statusRequired: 'parentREADY',
    textAnswerChoiceApprovalsMustBeIndependentlyPinned: true,
    noFigureReceipt: {
      kind: 'native-adaptation-audit',
      path: `${repo}/ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c3-s2-n14/adaptation.audit.json`,
      hashRequiredFromFutureParentReady: true, independentFigureReviewInvented: false,
    },
  },
  correctedPriorImplementation: sourceReady,
  observer: { source: bind(`${prior}/observe-tools.mjs`), output: bind(observer) },
  replacements, runtimeExecuted: false, rendererCalls: 0, browserLaunches: 0,
  screenshotsCaptured: 0, imagesObserved: 0, oldPassReruns: 0,
  databaseWrites: 0, hostTokens: 'unknown', totalCost: 'unknown', finish: 'review',
}, null, 2)}\n`, { flag: 'wx' });
let parentCode = adapt(fs.readFileSync(`${prior}/ready-display.mjs`, 'utf8'));
parentCode = parentCode
  .replace("'6500c58925bf5517340f7cc160330fb3aadd226bc9a7191359deab0c6ab4943b'", JSON.stringify(bind(readyFile).sha256))
  .replace("'2cb961385559347b5dd4f078a15d64785d0fe4f6ca1d2a75b8a6e41de59941d3'", JSON.stringify(bind(`${base}/display-FIRST/prepare.mjs`).sha256))
  .replace('assert.equal(displayRecord.exerciseCount, 5);', 'assert.equal(displayRecord.exerciseCount, 9);')
  .replace("'.tmp/resume182-6-8a-n12-0789/upstream-usage.record'", "'.tmp/resume182-6-8a-n14-0789/upstream-usage.record'")
  .replace("'927c6f55e4d8e929884297090d914199280b3c84bdcb6f700d12e5bfe96a49f6'", "'98a30074d15a01c9bbd15bb460b2f3564b1496a0e1c41bd1032a571ae4268546'");
fs.writeFileSync(`${base}/ready-display.mjs`, parentCode, { flag: 'wx' });
for (const item of [...files, bind(observer), bind(`${base}/ready-display.mjs`)]) {
  const check = spawnSync(process.execPath, ['--check', item.path], { encoding: 'utf8' });
  assert.equal(check.status, 0, check.stderr);
}
console.log(JSON.stringify({ ready: bind(readyFile), parent: bind(`${base}/ready-display.mjs`),
  observer: bind(observer), syntaxExit: 0, runtimeExecuted: false }));
