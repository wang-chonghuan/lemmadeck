import assert from 'node:assert/strict'
import fs from 'node:fs'
import path from 'node:path'

const root = process.cwd()
assert.equal(root, '/Users/yong/work/lemmadeck-ws/lemmadeck--STEMROBIN-182')
const owned = '.tmp/ld-s10y-lesson/resume182-7-N33/choices-author-FIRST'
const seed = JSON.parse(fs.readFileSync(path.join(owned, 'seed-FIRST.json'), 'utf8'))
const source = seed.exercises.find(exercise => exercise.number === '664')
assert(source)
assert.deepEqual(source.figure_ids, [])
const bases = [...new Set([...source.text.matchAll(/y=([0-9.]+)\^x/g)].map(match => Number(match[1])))]
assert.deepEqual(bases, [0.7, 0.4])

const id = 'fig-choice-n33-exponentials-r1'
const directory = path.join(owned, 'RECOVERY1', id)
const box = [-2.8, 7.75, 3.3, -0.7]
const curve = (base, left, right) => {
  const samples = []
  for (let hundredths = left; hundredths <= right; hundredths++) {
    const x = hundredths / 100
    samples.push([x - box[0], box[1] - base ** x])
  }
  return samples.map(([x, y], index) => `${index ? 'L' : 'M'}${x.toFixed(6)},${y.toFixed(6)}`).join(' ')
}

const objects = [
  {id: 'shared-grid', type: 'grid', bounds: [-2, 7, 2, 0], xStep: 1, yStep: 1, stroke: 'grid', strokeWidth: 1},
  {
    id: 'x-axis', type: 'axis', from: [-2.55, 0], to: [2.83, 0], stroke: 'ink', strokeWidth: 2,
    ticks: [-2, -1, 0, 1, 2].map(value => ({
      at: [value, 0], label: String(value), size: 0.055, fontSize: 30,
      labelPlacement: {position: 'S', offset: [0, 26]}
    }))
  },
  {
    id: 'y-axis', type: 'axis', from: [0, 0], to: [0, 7.35], stroke: 'ink', strokeWidth: 2,
    ticks: [1, 2, 3, 4, 5, 6, 7].map(value => ({
      at: [0, value], label: String(value), size: 0.045, fontSize: 30,
      labelPlacement: value === 1 ? {position: 'W', offset: [-40, 0]} : {position: 'E', offset: [16, 0]}
    }))
  },
  {id: 'x-axis-direction', type: 'arrow', from: [2.6, 0], to: [2.86, 0], stroke: 'ink', strokeWidth: 2},
  {id: 'y-axis-direction', type: 'arrow', from: [0, 7.1], to: [0, 7.48], stroke: 'ink', strokeWidth: 2},
  {id: 'x-label', type: 'text', at: [2.98, 0], text: 'x', fontSize: 30, labelPlacement: {position: 'CENTER'}},
  {id: 'y-label', type: 'text', at: [-0.18, 7.4], text: 'y', fontSize: 30, labelPlacement: {position: 'CENTER'}},
  {id: 'legend-c-line', type: 'segment', from: [0.65, 6.65], to: [1.1, 6.65], stroke: 'ink', strokeWidth: 4},
  {id: 'legend-c', type: 'text', at: [1.2, 6.65], text: 'C: y = 0.7^x', fontSize: 30, labelPlacement: {position: 'E', offset: [8, 0]}},
  {id: 'legend-d-line', type: 'segment', from: [0.65, 6.0], to: [1.1, 6.0], stroke: 'muted', strokeWidth: 4, dash: 2},
  {id: 'legend-d', type: 'text', at: [1.2, 6.0], text: 'D: y = 0.4^x', fontSize: 30, labelPlacement: {position: 'E', offset: [8, 0]}},
  {id: 'origin', type: 'point', at: [0, 0], size: 2, stroke: 'ink', fill: 'ink', strokeWidth: 1},
  {id: 'common-point', type: 'point', at: [0, 1], size: 3, stroke: 'ink', fill: 'ink', strokeWidth: 1}
]

const pointIds = ['origin', 'common-point']
const assertions = [
  {id: 'shared-grid-dimensions', type: 'gridDimensions', grid: 'shared-grid', columns: 4, rows: 7},
  {id: 'orthogonal-axes', type: 'perpendicular', a: [-2.55, 0], b: [2.83, 0], c: [0, 0], d: [0, 7.35]},
  {id: 'common-point-coordinate', type: 'displacement', from: 'origin', to: 'common-point', dx: 0, dy: 1},
  {id: 'x-direction-connects', type: 'connects', arrow: 'x-axis-direction', from: [2.6, 0], to: [2.86, 0]},
  {id: 'y-direction-connects', type: 'connects', arrow: 'y-axis-direction', from: [0, 7.1], to: [0, 7.48]}
]
const landmarkAssertions = ['common-point-coordinate']

for (const [index, base] of bases.entries()) {
  const letter = index === 0 ? 'c' : 'd'
  const role = index === 0 ? 'ink' : 'muted'
  for (const x of [-2, -1, 1, 2]) {
    const pointId = `${letter}-at-${x < 0 ? 'minus-' : ''}${Math.abs(x)}`
    const y = base ** x
    pointIds.push(pointId)
    objects.push({id: pointId, type: 'point', at: [x, y], size: 2, stroke: role, fill: 'paper', strokeWidth: 1})
    const assertionId = `${pointId}-coordinate`
    landmarkAssertions.push(assertionId)
    assertions.push({id: assertionId, type: 'displacement', from: 'origin', to: pointId, dx: x, dy: y})
  }
  const left = index === 0 ? -250 : -220
  objects.push({
    id: `${letter}-curve`, type: 'svgPath', d: curve(base, left, 240),
    stroke: role, strokeWidth: 4, ...(index === 1 ? {dash: 2} : {})
  })
  const continuations = [
    {name: 'left', fromX: index === 0 ? -2.35 : -2.05, toX: left / 100},
    {name: 'right', fromX: 2.2, toX: 2.4}
  ]
  for (const {name, fromX, toX} of continuations) {
    const arrowId = `${letter}-${name}-continuation`
    const from = [fromX, base ** fromX]
    const to = [toX, base ** toX]
    objects.push({id: arrowId, type: 'arrow', from, to, stroke: role, strokeWidth: 2})
    assertions.push({id: `${arrowId}-connects`, type: 'connects', arrow: arrowId, from, to})
  }
}

const spec = {
  schema: 'ld-s10y-image/figure-spec@2',
  id,
  mode: 'deterministic',
  description: 'Shared-coordinate exponential graph for reading the intersection and relative heights of C and D. Neither the graph nor its labels states the three solution sets.',
  source: {
    authoredBasis: 'New deterministic choice figure derived solely from the tool-prepared seed exercise 664, not an answer key or an original image. Evaluate the two source formulas C(x)=0.7^x and D(x)=0.4^x directly on a 0.01 x lattice and use the existing svgPath fallback for the sampled curves. Both formulas give y=1 at x=0. At x=-2, direct powers give C=100/49 and D=6.25; the shared canvas leaves both points visible. Axes, a unit grid, unlabeled landmark points, curve-continuation arrows, English C/D labels and solid/dashed distinction are authored instructional additions, not supplied source pixels. No false curve alternative or solution-set annotation is drawn. Bounding box [-2.8,7.75,3.3,-0.7] and unequal axis scaling are explicit; keepAspectRatio=false aligns the JSXGraph axes with the existing svgPath coordinate transform.',
    authoritativeText: [{lesson: seed.source.lesson, exercise: source.number, text: source.text}],
    inventory: [
      {
        id: 'authored-shared-frame',
        description: 'Authored shared Cartesian frame and positive axis directions; same coordinate transform for both source functions.',
        objects: ['shared-grid', 'x-axis', 'y-axis', 'x-axis-direction', 'y-axis-direction', 'x-label', 'y-label'],
        assertions: ['shared-grid-dimensions', 'orthogonal-axes', 'x-direction-connects', 'y-direction-connects'],
        requires: ['gridDimensions']
      },
      {
        id: 'direct-formula-landmarks',
        description: 'Direct source-formula landmarks, with origin as coordinate reference; includes both values at x=-2 and their common point at x=0. No coordinate callout labels are added.',
        objects: pointIds,
        assertions: landmarkAssertions,
        requires: ['pointRelationships']
      },
      {
        id: 'source-function-curves',
        description: 'Formula-sampled C and D in one frame, with solid/dashed legend and continuation arrows. Smoothness follows fine sampling, not hand-edited SVG paths.',
        objects: ['c-curve', 'd-curve', 'legend-c-line', 'legend-d-line', 'legend-c', 'legend-d', 'c-left-continuation', 'c-right-continuation', 'd-left-continuation', 'd-right-continuation'],
        assertions: ['c-left-continuation-connects', 'c-right-continuation-connects', 'd-left-continuation-connects', 'd-right-continuation-connects']
      }
    ]
  },
  canvas: {width: 960, height: 1080, boundingBox: box, background: 'paper', keepAspectRatio: false},
  display: {layout: 'scroll', purpose: 'instructional', minTextPx: 16, widths: [640]},
  objects,
  assertions,
  layout: {minLabelGap: 8}
}

fs.mkdirSync(directory, {recursive: true})
fs.writeFileSync(path.join(directory, 'spec.json'), `${JSON.stringify(spec, null, 2)}\n`, {flag: 'wx'})
console.log(JSON.stringify({id, spec: path.join(directory, 'spec.json'), basis_input: path.join(owned, 'seed-FIRST.json'), reads_answer_keys: false, x_minus_2: bases.map(base => ({base, value: base ** -2})), display: spec.display}, null, 2))
