## Actual comparison command

The following read-only command was executed once, exit 0. It generated
the actual input hashes, per-object comparisons, math counts and scans
used above. It neither writes files nor calls another process/API.
Its full-stop/whitespace comparison is only a mechanical aid: exact math
and manual reading separately protect decimals, negatives, task scope,
paragraph readability and conceptual transitions.

```sh
node --input-type=module -e '
import fs from "node:fs";
import crypto from "node:crypto";
import {isDeepStrictEqual as same} from "node:util";
const paths = ["ssot-resources/soviet10year-textbooks/artifacts/8a/lessons/alg8-c5-s2-n33/lesson.json", "ssot-resources/soviet10year-textbooks/artifacts/8a/lessons/alg8-c5-s2-n33/exercises.json", ".tmp/ld-s10y-lesson/resume182-7-N33/modern-author-FIRST/lesson.template.json", ".tmp/ld-s10y-lesson/resume182-7-N33/modern-author-FIRST/exercises.template.json"];
const inputs = paths.map(path => { const bytes = fs.readFileSync(path); return {path, sha256:crypto.createHash("sha256").update(bytes).digest("hex"), bytes:bytes.length, data:JSON.parse(bytes)}; });
const [rawLesson, rawExercises, modernLesson, modernExercises] = inputs.map(x => x.data);
const formulas = text => [...text.matchAll(/\$\$(.+?)\$\$|\$([^$]+?)\$/gs)].map(m => m[1] ?? m[2]);
const normalize = text => text.replace(/\s/g, "").replace(/[.。]/g, "");
const rows = (raw, modern, prefix, metadata) => raw.map((source, i) => {
 const item = modern[i]; const math = formulas(item.text);
 return {pointer:`/${prefix}/${i}`, source_refs:source.source_refs ?? source.pages, number:source.number, kind:source.kind, source_text_exact:source.text === item.source_text, metadata_preserved:metadata.every(key => same(source[key],item[key])), text_equal_except_layout_periods:normalize(source.text) === normalize(item.text), math_exact:same(formulas(source.text),math), formula_count:math.length, math_cjk_or_punctuation:math.filter(x => /[\p{Script=Han}、，；。？！：]/u.test(x)), cyrillic_markers:[...item.text.matchAll(/([а-я])[)）]/gu)].map(m => m[1]), authored_line_count:item.text.split("\n").length, fullwidth_space:item.text.includes("　"), manual_html:/<\/?[a-z][^>]*>/i.test(item.text)};
});
const prose = rows(rawLesson.prose,modernLesson.prose,"prose",["kind","id","label","printed_page","source_refs"]);
const exercises = rows(rawExercises.exercises,modernExercises.exercises,"exercises",["number","source_number","group","group_id","pages","figure_refs","figures"]);
const profile = JSON.parse(fs.readFileSync(".claude/skills/ld-s10y-lesson/profiles/modern-us-neutral.json"));
const tokens = [...profile.forbidden_terms,...profile.forbidden_person_names];
const all = [...modernLesson.prose.map(x=>x.text),...modernExercises.exercises.map(x=>x.text)];
console.log(JSON.stringify({inputs:inputs.map(({data,...x})=>x),source_hashes_match:[modernLesson.source.sha256===inputs[0].sha256,modernExercises.source.sha256===inputs[1].sha256],embedded_sources_match:[same(rawLesson,modernLesson.source.data),same(rawExercises,modernExercises.source.data)],object_counts:[rawLesson.prose.length,modernLesson.prose.length],exercise_counts:[rawExercises.count,rawExercises.exercises.length,modernExercises.count,modernExercises.exercises.length,modernLesson.exercise_count],kind_counts:rawLesson.prose.reduce((a,x)=>(a[x.kind]=(a[x.kind]??0)+1,a),{}),prose,exercises,formula_total:prose.concat(exercises).reduce((a,x)=>a+x.formula_count,0),forbidden_terms_found:tokens.filter(t=>all.some(x=>x.includes(t))),errata:modernLesson.errata,change_tags:[...new Set([...modernLesson.prose,...modernExercises.exercises].flatMap(x=>x.changes))],numeric_changes_count:[...modernLesson.prose,...modernExercises.exercises].flatMap(x=>x.numeric_changes).length},null,2));
'
```

