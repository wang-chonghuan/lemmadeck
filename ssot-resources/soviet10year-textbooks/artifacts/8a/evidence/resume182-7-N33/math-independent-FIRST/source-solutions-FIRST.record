| b | 0.57 in [0,1[ | [x]=0, {x}=0.57-0=0.57; 0.57=0+0.57 |
| c | 14.5 in [14,15[ | [x]=14, {x}=14.5-14=0.5; 14.5=14+0.5 |
| d | -14.5 in [-15,-14[ | [x]=-15, {x}=-14.5-(-15)=0.5; -14.5=-15+0.5 |
| e | -0.068 in [-1,0[ | [x]=-1, {x}=-0.068-(-1)=0.932; -0.068=-1+0.932 |
