import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const prior = '.tmp/resume182-6-8a-n13-0789';
const base = '.tmp/resume182-6-8a-n14-0789';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const entry = file => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), sha256: sha(bytes), bytes: bytes.length };
};
const transformations = [];
for (const name of ['snapshot-source-author.mjs', 'promote-source.mjs']) {
  const source = `${prior}/${name}`;
  const target = `${base}/${name}`;
  assert.ok(!fs.existsSync(target));
  let code = fs.readFileSync(source, 'utf8')
    .replaceAll('resume182-6-8a-n13-0789', 'resume182-6-8a-n14-0789')
    .replaceAll('alg8-c3-s1-n13', 'alg8-c3-s2-n14');
  if (name === 'snapshot-source-author.mjs') {
    assert.ok(code.includes('[86, 87, 88]'));
    code = code.replace('[86, 87, 88]', '[89, 90, 91]');
  } else {
    assert.equal(code.split('assembly-AFFECTED-glyph1').length - 1, 2);
    code = code.replaceAll('assembly-AFFECTED-glyph1', 'assembly-FIRST');
  }
  fs.writeFileSync(target, code, { flag: 'wx' });
  transformations.push({ source: entry(source), output: entry(target) });
}
const file = `${base}/source-support-code.record`;
fs.writeFileSync(file, `${JSON.stringify({
  status: 'SCOPED_SOURCE_HELPERS_PREPARED_NOT_EXECUTED',
  transformations, book: '8a', lesson: 'alg8-c3-s2-n14',
  imageViews: 0, oldPassReruns: 0, databaseWrites: 0,
  unknownHistoricalBytesRecovered: false, finish: 'review',
  hostTokens: 'unknown', totalCost: 'unknown',
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(entry(file)));
