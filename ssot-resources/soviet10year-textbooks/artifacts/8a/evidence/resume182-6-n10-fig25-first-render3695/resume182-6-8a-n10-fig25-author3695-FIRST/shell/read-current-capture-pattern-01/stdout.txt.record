246:async function capture() {
247-  const render = read(path.join(OWN, 'render', 'figure.render.json'));
248-  assert.equal(render.status, 'pass', 'native capture depends on successful official render');
249-  assert.equal(render.spec.sha256, bind(path.join(OWN, 'candidate.spec.json')).sha256);
250-  const svgPath = path.join(OWN, 'render', 'figure.svg');
251-  const svgBinding = bind(svgPath);
252-  assert.equal(render.output.svg.sha256, svgBinding.sha256);
253-  const req = createRequire(path.join(R, 'app', 'package.json'));
254-  const { chromium } = req('@playwright/test');
255-  const executablePath = chromium.executablePath();
256-  assert.ok(fs.existsSync(executablePath));
257-  const outputPath = path.join(OWN, 'native640.png');
258-  assert.ok(!fs.existsSync(outputPath), 'only one native raster is authorized');
259-  const record = {
260-    schema: 'bounded-author-native-capture@1', role: 'AUTHOR_NOT_REVIEWER',
261-    sourceSvg: svgBinding, captureScript: bind(fileURLToPath(import.meta.url)),
262-    runtime: { package: req.resolve('@playwright/test'), version: req('@playwright/test/package.json').version, executablePath, node: process.version },
263-    isolatedHeadless: true, browserLaunches: 0, contexts: 0, pages: 0,
264-    screenshotCalls: 0, contentLoads: 0, deviceScaleFactor: 1,
265-    viewport: { width: 640, height: 480 },
266-    rasterization: 'Original generated SVG rendered directly at CSS640x480 with DPR1; no existing raster resize/crop.',
267-    candidateRasterViews: 0, visualReview: 'NOT_RUN',
268-    closures: { page: false, context: false, browser: false },
269-    startedAt: new Date().toISOString(),
270-  };
271-  let browser;
272-  let context;
273-  let page;
274-  try {
275-    record.browserLaunches++;
276-    browser = await chromium.launch({ headless: true, executablePath });
277-    record.contexts++;
278-    context = await browser.newContext({ viewport: record.viewport, deviceScaleFactor: 1 });
279-    await context.route('**/*', route => route.abort());
280-    record.pages++;
281-    page = await context.newPage();
282-    record.browserVersion = browser.version();
283-    record.contentLoads++;
284-    await page.setContent(`<!doctype html><html><head><meta charset="utf-8"><style>
285-      :root { --ld-figure-ink:#15201f; --ld-figure-muted:#4c5a58; --ld-figure-accent:#15201f; --ld-figure-accent-soft:#8a9795; --ld-figure-grid:#e3eae9; --ld-figure-paper:#ffffff; }
286-      html,body { margin:0; width:640px; height:480px; overflow:hidden; background:#ffffff; }
287-      svg { display:block; width:640px; height:480px; }
288-      </style></head><body>${fs.readFileSync(svgPath, 'utf8')}</body></html>`, { waitUntil: 'load' });
289-    await page.evaluate(() => document.fonts.ready);
290-    record.domTechnicalObservation = await page.evaluate(ids => {
291-      const svg = document.querySelector('svg');
292-      const anchors = ids.map(id => {
293-        const node = document.getElementById(`ld-fig-16_ld-${id}`);
294-        const style = node && getComputedStyle(node);
295-        return { id, found: Boolean(node), display: style?.display, visibility: style?.visibility, visible: Boolean(node) && style.display !== 'none' && style.visibility !== 'hidden' };
296-      });
297-      const labels = [...svg.querySelectorAll('text')].map(node => {
298-        const box = node.getBoundingClientRect();
299-        const matrix = node.getScreenCTM();
300-        return {
301-          id: node.getAttribute('data-label-id'), text: node.textContent,
302-          x: box.x, y: box.y, width: box.width, height: box.height,
303-          finalFontPx: Number.parseFloat(node.getAttribute('font-size')) * Math.hypot(matrix.a, matrix.b),
304-        };
305-      });
306-      const svgBox = svg.getBoundingClientRect();
307-      return {
308-        svgWidth: svgBox.width, svgHeight: svgBox.height,
309-        devicePixelRatio: devicePixelRatio, anchors, labels,
310-        yLabelRightEdgeClearanceFromAxisPx: 320 - (labels.find(label => label.text === 'y').x + labels.find(label => label.text === 'y').width),
311-        yUnitRightEdgeClearanceFromAxisPx: 320 - (labels.find(label => label.id === 'fig-16-y-unit-label-label').x + labels.find(label => label.id === 'fig-16-y-unit-label-label').width),
312-      };
313-    }, hiddenIds);
314-    assert.equal(record.domTechnicalObservation.svgWidth, 640);
315-    assert.equal(record.domTechnicalObservation.svgHeight, 480);
316-    assert.equal(record.domTechnicalObservation.devicePixelRatio, 1);
317-    assert.equal(record.domTechnicalObservation.labels.length, 9);
318-    assert.ok(record.domTechnicalObservation.anchors.every(anchor => anchor.found && !anchor.visible));
319-    assert.ok(record.domTechnicalObservation.labels.every(label => label.finalFontPx >= 16));
320-    assert.ok(record.domTechnicalObservation.yLabelRightEdgeClearanceFromAxisPx >= 16);
321-    assert.ok(record.domTechnicalObservation.yUnitRightEdgeClearanceFromAxisPx >= 16);
322-    record.screenshotCalls++;
323-    await page.screenshot({ path: outputPath, type: 'png', fullPage: false, animations: 'disabled' });
324-    const bytes = fs.readFileSync(outputPath);
325-    assert.equal(bytes.subarray(0, 8).toString('hex'), '89504e470d0a1a0a');
326-    assert.equal(bytes.subarray(12, 16).toString('ascii'), 'IHDR');
327-    record.png = { ...bind(outputPath), width: bytes.readUInt32BE(16), height: bytes.readUInt32BE(20) };
328-    assert.equal(record.png.width, 640);
329-    assert.equal(record.png.height, 480);
330-    record.technicalCaptureStatus = 'complete';
331-  } catch (error) {
332-    record.technicalCaptureStatus = 'failed';
333-    record.error = error.message;
334-    throw error;
335-  } finally {
336-    if (page) { await page.close(); record.closures.page = true; }
337-    if (context) { await context.close(); record.closures.context = true; }
338-    if (browser) { await browser.close(); record.closures.browser = true; }
339-    record.finishedAt = new Date().toISOString();
340-    const binding = write('capture.record', record);
341-    console.log(JSON.stringify({ capture: binding, png: record.png, screenshotCalls: record.screenshotCalls, closures: record.closures, candidateViews: 0 }));
--
