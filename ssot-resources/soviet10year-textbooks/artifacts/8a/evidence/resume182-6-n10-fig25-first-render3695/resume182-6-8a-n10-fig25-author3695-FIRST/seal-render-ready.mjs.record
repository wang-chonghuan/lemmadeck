import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

const R = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
const work = `${R}/.tmp/resume182-6-8a-n10-fig25-author3695-FIRST`;
assert.equal(process.cwd(), R);
const bind = (path) => ({
  path, sha256: crypto.createHash('sha256').update(fs.readFileSync(path)).digest('hex'),
});
const read = (path) => JSON.parse(fs.readFileSync(path, 'utf8'));
const inventory = bind(`${work}/ready.record`);
assert.equal(inventory.sha256, '12dc00282ea205a5031beb8a47ee5a69c8c7e52574a674d24a1480fe87d150fa');
const spec = bind(`${work}/draft-FIRST/fig-25.spec.json`);
const svg = bind(`${work}/render-FIRST/fig-25.svg`);
const render = bind(`${work}/render-FIRST/fig-25.render.json`);
const report = read(render.path);
const capture = bind(`${work}/raster-FIRST/capture.record`);
const captured = read(capture.path);
assert.equal(report.status, 'pass');
assert.equal(report.spec.sha256, spec.sha256);
assert.equal(report.output.svg.sha256, svg.sha256);
assert.equal(captured.status, 'CAPTURE_COMPLETE_NOT_VISUAL_APPROVAL');
assert.equal(captured.sourceSvg.sha256, svg.sha256);
assert.deepEqual(captured.closures, { page: true, context: true, browser: true });
assert.equal(captured.screenshotCalls, 2);
const nativePng = captured.captures.find((item) => item.name === 'native').png;
const width640Preview = captured.captures.find((item) => item.name === 'width640').png;
assert.equal(bind(nativePng.path).sha256, nativePng.sha256);
assert.equal(bind(width640Preview.path).sha256, width640Preview.sha256);
const receipts = fs.readdirSync(`${work}/shell`)
  .filter((directory) => fs.existsSync(`${work}/shell/${directory}/receipt.record`))
  .map((directory) => {
    const root = `${work}/shell/${directory}`;
    return {
      directory: root, receipt: bind(`${root}/receipt.record`),
      stdout: bind(`${root}/stdout.txt`), stderr: bind(`${root}/stderr.txt`),
      result: read(`${root}/receipt.record`),
    };
  });
const failureReceipts = receipts.filter((item) => item.result.returncode !== 0);
const notes = read(`${work}/draft-FIRST/authoring-notes.record`);
for (const input of notes.inputs) assert.equal(bind(input.path).sha256, input.sha256);
const sourceImage = read(spec.path).source.image;
assert.equal(bind(sourceImage.path).sha256, sourceImage.sha256);
const record = {
  schema: 'resume182-6/figure-render-ready@1',
  status: 'RENDER_READY_FOR_INDEPENDENT_REVIEW_NOT_FIGURE_APPROVAL',
  role: 'AUTHOR_NOT_REVIEWER', createdAt: new Date().toISOString(),
  cwd: R, authorizedWriteRoot: work,
  book: '8a', lesson: 'alg8-c2-s2-n10', edition: 'modern-us-neutral', figure: 'fig-25',
  spec, svg, render, nativePng, width640Preview,
  sourceImage,
  independentSourceInventory: inventory,
  preservedInventoryStatus: 'SOURCE_INVENTORY_READY_NOT_FIGURE_APPROVAL',
  frozenInputs: notes.inputs,
  authoringNotes: bind(`${work}/draft-FIRST/authoring-notes.record`),
  authoringScript: bind(`${work}/build-draft.mjs`),
  capture, captureScript: bind(`${work}/capture-first.mjs`),
  sealScript: bind(fileURLToPath(import.meta.url)),
  frames: notes.frames,
  preservedRequirements: [
    'Four separate coordinate frames and every visible source row/column and origin phase are retained.',
    'Rectangle bottom is one source unit above the x axis; it is not on that axis.',
    'The complete circle and solid axial diameter remain, with hatching only in its right half.',
    'The inner and outer solid circumferences remain, with hatching only in the annulus.',
    'All source axis names, O and given numeric labels are retained; source has no visible dots and no visible point objects are authored.',
    'Irregular scan blemishes are omitted as blemishes, not reinterpreted as boundaries.',
    'Source labels а/б/в/г map to modern English a/b/c/d; this is explicitly a modern mapping.',
  ],
  authorProductionEvidence: {
    explicitDraftValidator: {
      script: bind(`${R}/.agents/skills/ld-s10y-image/scripts/validate_spec.py`),
      interpreter: '/Users/yong/work/lemmadeck-ws/lemmadeck/.claude/skills/ld-s10y-lesson/.venv/bin/python',
      interpreterArgs: ['-B'], stage: 'draft',
      receipt: bind(`${work}/shell/validate-spec-FIRST-01/receipt.record`),
      result: read(`${work}/shell/validate-spec-FIRST-01/stdout.txt`),
      explicitInvocations: 1,
    },
    renderer: {
      script: bind(`${R}/.agents/skills/ld-s10y-image/scripts/render_spec.mjs`),
      pythonAdapter: bind(`${work}/python-B.sh`),
      receipt: bind(`${work}/shell/render-spec-FIRST-01/receipt.record`),
      rendererAttempts: 1, successfulRuns: 1, repairRuns: 0,
      mandatoryEmbeddedDraftValidatorRuns: 1,
      separatelyRepeatedPassedValidatorRuns: 0,
      name: report.renderer.name, version: report.renderer.version,
      status: report.status, objects: report.objects, labels: report.labels,
      collisions: report.collisions, displayChecks: report.displayChecks,
      browserLaunches: 1, rendererScreenshotCalls: 0,
      isNotIndependentSourceOrMathApproval: true,
    },
    rasterization: {
      receipt: bind(`${work}/shell/capture-native-and-640-FIRST-01/receipt.record`),
      runtime: captured.runtime, browserVersion: captured.browserVersion,
      method: 'Two first rasterizations of the original generated SVG with current R/app Playwright; native canvas and actual CSS640 width, DPR1. Neither raster resizes an existing PNG.',
      resvgUsed: false, otherProjectRuntimeUsed: false,
      screenshotCalls: captured.screenshotCalls,
      contentLoads: captured.contentLoads, browserLaunches: captured.browserLaunches,
      contexts: captured.contexts, pages: captured.pages,
      deviceScaleFactor: captured.deviceScaleFactor,
      closures: captured.closures, closureErrors: captured.closureErrors,
      abortedRequests: captured.abortedRequests,
      networkPolicy: captured.networkPolicy,
      consoleErrors: captured.consoleErrors, pageErrors: captured.pageErrors,
      actual640CssHeight: captured.captures.find((item) => item.name === 'width640').cssSize.height,
      actual640MinMeasuredTextPx: captured.captures.find((item) => item.name === 'width640').minMeasuredTextPx,
      previewReusedNativePng: false,
      rasterResizeOrCrop: false,
      sourcePngUsedInRasterization: false,
      authorCandidatePngViews: 0,
      visualApproval: 'NOT_RUN',
    },
  },
  counts: {
    sourcePngViewsCumulative: 1, sourcePngViewsThisContinuation: 0,
    sourcePageViews: 0, sourceReopens: 0, sourceCrops: 0, authorCandidateViews: 0,
    imagesLoadedIntoAuthorContext: 1, imageBatchLimit: 8, contextImageLimit: 24,
    explicitDraftValidationInvocations: 1, embeddedRendererDraftValidations: 1,
    rendererInvocations: 1, successfulRendererInvocations: 1,
    nativeRasterizations: 1, width640Rasterizations: 1, screenshotCalls: 2,
    browserLaunches: 2, contentRepairs: 0, technicalCandidateRepairs: 0,
    dependencyInstalls: 0, copiedRuntimes: 0, copiedSourcePngs: 0,
    paidGenerationCalls: 0, independentFigureReviewCalls: 0,
  },
  preservedFailures: {
    originalInventoryPhase: read(inventory.path).execution_evidence.failure,
    originalReceiptRootDeviation: read(inventory.path).execution_evidence.receipt_root_deviation,
    continuationNonzeroShellReceipts: failureReceipts,
    interpretation: 'Nonzero discovery searches and MODULE_NOT_FOUND probe output are retained as execution evidence, not mathematical or image failures. No validator, renderer or raster candidate failed.',
    allFirstCandidateBytesPreserved: true,
  },
  receipts,
  readyCreationReceiptPath: `${work}/shell/seal-render-ready-FIRST-01/receipt.record`,
  unknowns: ['Cost', 'Original exact subpixel/ink geometry', 'Independent figure review outcome'],
  cost: 'unknown',
  scopeBoundaries: [
    'TEXT_PASS is recorded only as received/read hash-bound upstream input, not re-reviewed.',
    'No source PNG or source page reopened; original inventory ready.record was not edited.',
    'No answer or choice artifact read, no answer inequalities or formulas generated, no answer labels added.',
    'No record_review, promotion, publish, DB, Plane write, chat/create/attach, merge, deploy or push.',
    'No file in another project written; no dependency installed or runtime copied.',
    'Draft validation and renderer PASS are producer technical evidence, not source/figure scientific approval.',
    'The independent reviewer must receive these file bindings and inspect the candidate separately.',
  ],
};
const readyPath = `${work}/render-ready.record`;
fs.writeFileSync(readyPath, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({
  ready: bind(readyPath), spec, svg, render, nativePng, width640Preview,
  cost: 'unknown', independentFigureApproval: false,
}, null, 2));
