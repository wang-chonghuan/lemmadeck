        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "A",
          "B"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "y(-x)=y(x)，最低点为(0,0)，x=±2均得y=0.25×4=1；这些点保持指定系数而非任意正系数。",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "系数0.25>0给向上抛物线；代入x=0、2、4分别得y=0、1、4。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "x=2时唯一函数值为1，(2,-1)不在图象上；正负x配对不等于正负y配对。",
            "misconception": "把平方中的正负x配对误作正负y配对。"
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "代入源函数x=2、4分别得1、4，而不是0.5、1；给出的直线和点来自y=0.25x。",
            "misconception": "把y=0.25x²误读为y=0.25x，漏掉指数2后计算三点并连成直线。"
          }
        ]
      }
