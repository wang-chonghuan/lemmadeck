            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "末式展开0.3x²+52x-550。",
            "misconception": "清分母后的第三式根因式为(x-10)(3x+55)，除10时只除3x，未把55同除10。"
