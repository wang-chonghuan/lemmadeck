          "B",
          "D",
          "F"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "原分子=(x-1)(7x+8)，原分母=7(x-1)。",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "原分母=(a+2)(2a+9)，两个零点保留。",
