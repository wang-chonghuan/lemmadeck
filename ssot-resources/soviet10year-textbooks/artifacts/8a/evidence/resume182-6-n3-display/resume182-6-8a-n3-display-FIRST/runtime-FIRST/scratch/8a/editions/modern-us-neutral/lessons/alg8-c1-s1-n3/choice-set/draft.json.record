  "questions": [
    {
      "id": "n3-12",
      "source_numbers": [
        "12"
      ],
      "view": {
        "mode": "multiple",
        "stem": "求下列三项式的根并分解因式。选择所有正确的结果。\n\n$a)\\ 2x^2-5x+3$；$b)\\ 5y^2+2y-3$；$c)\\ 2x^2-5x-7$；$d)\\ x^2-11x+30$；$e)\\ -y^2+6y-5$；$f)\\ -z^2-5z+6$。",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$a)$ 的根为 $1,\\frac32$，分解为 $(x-1)(2x-3)$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$b)$ 的根为 $-1,\\frac35$，分解为 $(y+1)(5y-3)$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$c)$ 的根为 $1,-\\frac72$，分解为 $(x-1)(2x+7)$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$d)$ 的根为 $5,6$，分解为 $(x-5)(x-6)$。",
            "figure_ids": []
          },
          {
            "id": "E",
            "text": "$e)$ 的根为 $1,5$，分解为 $-(y-1)(y-5)$。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "以根与一次因式的共同对应判断六个三项式的完整结果。",
        "source_solution": "a (2x-3)(x-1), roots 3/2,1; b (5y-3)(y+1), roots 3/5,-1; c (2x-7)(x+1), roots 7/2,-1; d (x-5)(x-6), roots 5,6; e -(y-1)(y-5), roots 1,5; f -(z-1)(z+6), roots 1,-6. Each leading coefficient is retained and expansion recovers the source.",
        "unit_reason": "六个完整根集和乘积共用同一个因式分解判据，不拆成单根点击。",
        "concept_blocks": [
          0,
          1
        ],
        "limitations": [
          "独立求出并书写六组完整根集和因式乘积未测；拒绝错误候选也不证明能自主补出正确结果。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "A",
          "B",
          "D",
          "E"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "两个因式分别给根1和3/2，展开2x²-5x+3。",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "展开5y²+2y-3；两因式的零点为-1和3/5。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "候选展开2x²+5x-7，不是中间项-5x。",
            "misconception": "先把原中间项-5x误作+5x，解该错误三项式得到1,-7/2和此乘积。"
          },
          {
            "option_id": "D",
            "truth": "correct",
            "derivation": "5+6=11，5·6=30，展开符合源式。",
            "misconception": null
          },
          {
            "option_id": "E",
            "truth": "correct",
            "derivation": "保留首项负号，展开-y²+6y-5。",
            "misconception": null
          },
          {
            "option_id": "F",
            "truth": "incorrect",
            "derivation": "该候选展开-z²+5z+6，与原中间项相反。",
            "misconception": "把提出负号后的z²+5z-6误写成z²-5z-6，再解为-1和6。"
          }
        ]
      }
    },
    {
