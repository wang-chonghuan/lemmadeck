      }),
    };
  }
  window.__n9Display = { bring, reset, snapshot,
    inspect: id => ({ rect: targets[id].rect(), frame: frameFor(targets[id].element),
      text: targets[id].element.textContent,
      ancestors: [...function* () {
        for (let element = targets[id].element; element; element = element.parentElement) {
