    },
    "cssSha256": "9e4d91245be1c3c9c6433c0e2e2121cb7900b31d4d0700bf327820c25f005fb5",
    "questions": [
      {
        "id": "n3-12",
        "index": 0,
        "source_numbers": [
          "12"
        ],
        "view": {
          "mode": "multiple",
          "stem": "求下列三项式的根并分解因式。选择所有正确的结果。\n\n$a)\\ 2x^2-5x+3$；$b)\\ 5y^2+2y-3$；$c)\\ 2x^2-5x-7$；$d)\\ x^2-11x+30$；$e)\\ -y^2+6y-5$；$f)\\ -z^2-5z+6$。",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "$a)$ 的根为 $1,\\frac32$，分解为 $(x-1)(2x-3)$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "$b)$ 的根为 $-1,\\frac35$，分解为 $(y+1)(5y-3)$。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "$c)$ 的根为 $1,-\\frac72$，分解为 $(x-1)(2x+7)$。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "$d)$ 的根为 $5,6$，分解为 $(x-5)(x-6)$。",
              "figure_ids": []
            },
            {
              "id": "E",
              "text": "$e)$ 的根为 $1,5$，分解为 $-(y-1)(y-5)$。",
              "figure_ids": []
            },
            {
              "id": "F",
              "text": "$f)$ 的根为 $-1,6$，分解为 $-(z+1)(z-6)$。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "bfb13dd3b84f7b4ad1ee4d8b05adaf047a7ea6fdd7fd11364561217041c31eed",
        "sectionBytes": 28790
      },
      {
        "id": "n3-13",
        "index": 1,
        "source_numbers": [
          "13"
        ],
        "view": {
          "mode": "multiple",
          "stem": "在实数范围内判断下列因式分解，选择所有正确的断言。\n\n$a)\\ 4x^2-9x+5$；$b)\\ 4b^2-9b+7$；$c)\\ -3y^2+8y+11$；$d)\\ 16a^2-24a+9$；$e)\\ x^2-x-2$；$f)\\ y^2-7y+11$；$g)\\ 3x^2-12x+12$；$h)\\ -48a^2-8a+1$；$i)\\ 4x^2+x+0.04$。",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "$a)=(4x-5)(x-1)$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "$b)$ 不能分解为两个实系数一次式的积。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "$c)=-(3y+11)(y-1)$。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "$d)=(4a+3)^2$。",
              "figure_ids": []
            },
            {
              "id": "E",
              "text": "$e)=(x-2)(x+1)$。",
              "figure_ids": []
            },
            {
              "id": "F",
              "text": "$f)=\\left(y-\\frac{7+\\sqrt5}{2}\\right)\\left(y-\\frac{7-\\sqrt5}{2}\\right)$。",
              "figure_ids": []
            },
            {
              "id": "G",
              "text": "$g)=3(x-2)^2$。",
              "figure_ids": []
            },
            {
              "id": "H",
              "text": "$h)=-(12a+1)(4a-1)$。",
              "figure_ids": []
            },
            {
              "id": "I",
              "text": "$i)=4\\left(x+\\frac1{20}\\right)\\left(x+\\frac15\\right)$。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "44c2903122d03763f3c098d31bb621406296bb6e8c28792462383b9f63f4636c",
        "sectionBytes": 37329
      },
      {
        "id": "n3-14",
        "index": 2,
        "source_numbers": [
          "14"
        ],
        "view": {
          "mode": "single",
          "stem": "把 $0.1x^2-10x+240$、$\\frac1{16}y^2-\\frac38y-1$、$0.3x^2+2.5x-55$ 分别写成两个一次式的积。哪组依次正确？",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "$(x-40)(x-60)$；$(y-8)(y+2)$；$(x-10)(3x+55)$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "$(x+40)(0.1x+6)$；$(y+8)(\\frac y{16}-\\frac18)$；$(x+10)(0.3x-5.5)$。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "$(x-40)(0.1x-6)$；$(y-8)(\\frac y{16}+\\frac18)$；$(x-10)(0.3x+5.5)$。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "$(x-40)(0.1x-6)$；$(y-8)(\\frac y{16}+\\frac18)$；$(x-10)(0.3x+55)$。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "74730c32b51d3d50da1781adc4c9ad4d2d2f52509f422274f0b1fc1edff27b36",
        "sectionBytes": 28729
      },
      {
        "id": "n3-15",
        "index": 3,
        "source_numbers": [
          "15"
        ],
        "view": {
          "mode": "multiple",
          "stem": "约分并保留原分母不为零的限制。选择所有正确结果。\n\n$a)\\frac{7x^2+x-8}{7x-7}$；$b)\\frac{5a+10}{2a^2+13a+18}$；$c)\\frac{b^2-8b+15}{b^2-25}$；$d)\\frac{y^2-5y-36}{81-y^2}$；$e)\\frac{c^2-c-110}{22+9c-c^2}$；$f)\\frac{5a^2+8a+3}{14+3a-11a^2}$。",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "$a)=\\frac{7x+8}{7}$，$x\\ne1$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "$b)=\\frac5{2a+9}$，$a\\ne-2,-\\frac92$。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "$c)=\\frac{b-3}{b+5}$，只需 $b\\ne-5$。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "$d)=-\\frac{y+4}{y+9}$，$y\\ne9,-9$。",
              "figure_ids": []
            },
            {
              "id": "E",
              "text": "$e)=\\frac{c+10}{c+2}$，$c\\ne11,-2$。",
              "figure_ids": []
            },
            {
              "id": "F",
              "text": "$f)=\\frac{5a+3}{14-11a}$，$a\\ne-1,\\frac{14}{11}$。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "deb0325d6041a0ac93b274f5c776263cbde3ee64dc962029c5fa33d86a9c5434",
        "sectionBytes": 37738
      },
      {
        "id": "n3-16",
        "index": 4,
        "source_numbers": [
          "16"
        ],
        "view": {
          "mode": "multiple",
          "stem": "对于 $f(x)=\\frac{x^2-5x+6}{x-2}$ 和 $g(x)=\\frac{-2x^2+7x-3}{2x-1}$，保留原分式定义域。选择所有正确的图象描述。",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "$f$ 的图象是直线 $y=x-3$ 去掉点 $(2,-1)$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "$g$ 的图象是直线 $y=3-x$ 去掉点 $(\\frac12,\\frac52)$。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "$f$ 的图象是完整的直线 $y=x-3$。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "$g$ 的图象是直线 $y=x-3$ 去掉点 $(\\frac12,-\\frac52)$。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "7824d6af9d62ffdd9a85f64d5c1612881fa1dfe6f5c6fa534553912d6e18973d",
        "sectionBytes": 18061
      },
      {
        "id": "n3-17",
        "index": 5,
        "source_numbers": [
          "17"
        ],
        "view": {
          "mode": "single",
          "stem": "依次解 $3a^2-10a-8<0$、$y^2-26y+168<0$、$x^2+6x-55>0$、$-2b^2+9b+5>0$。哪组解集全部正确？",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "$a\\lt-\\frac23$ 或 $a\\gt4$；$y\\lt12$ 或 $y\\gt14$；$-11\\lt x\\lt5$；$b\\lt-\\frac12$ 或 $b\\gt5$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "$-\\frac23\\le a\\le4$；$12\\le y\\le14$；$x\\le-11$ 或 $x\\ge5$；$-\\frac12\\le b\\le5$。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "$-\\frac23\\lt a\\lt4$；$12\\lt y\\lt14$；$x\\lt-11$ 或 $x\\gt5$；$b\\lt-\\frac12$ 或 $b\\gt5$。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "$-\\frac23\\lt a\\lt4$；$12\\lt y\\lt14$；$x\\lt-11$ 或 $x\\gt5$；$-\\frac12\\lt b\\lt5$。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "5943baa7bc44110482f6bdae6b749bc33cc6c2b146b44c5333883191a7c3f137",
        "sectionBytes": 35340
      },
      {
        "id": "n3-18",
        "index": 6,
        "source_numbers": [
          "18"
        ],
        "view": {
          "mode": "single",
          "stem": "依次解四个不等式组：\n\n$a)\\begin{cases}4x-21>0\\\\x+3.5<0\\end{cases}$；$b)\\begin{cases}5x-9\\le0\\\\2x+7\\le0\\end{cases}$；$c)\\begin{cases}5-4x<10\\\\1-3x<-2\\end{cases}$；$d)\\begin{cases}3x-6>5\\\\1-4x>8\\end{cases}$。\n\n哪组解集依次正确？",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "$\\varnothing$；$x\\le-\\frac72$；$x>1$；$\\varnothing$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "$x<-\\frac72$；$x\\le-\\frac72$；$x>1$；$x<-\\frac74$。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "$x>\\frac{21}4$；$x\\le\\frac95$；$x>-\\frac54$；$x>\\frac{11}3$。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "$\\varnothing$；$x\\le-\\frac72$；$-\\frac54\\lt x\\lt1$；$x\\gt\\frac{11}3$。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "d6837a45c35132119e7d9c51b7df4788ab256d28ed72799b2d526242f9f31114",
        "sectionBytes": 32731
      },
      {
        "id": "n3-19",
        "index": 7,
        "source_numbers": [
          "19"
        ],
        "view": {
          "mode": "multiple",
          "stem": "函数 $y=0.25x^2$ 的图象具有哪些性质？选择所有正确断言。",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "图象关于 $y$ 轴对称，顶点是 $(0,0)$，且经过 $(2,1)$ 与 $(-2,1)$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "图象是开口向上的抛物线，经过 $(0,0)$、$(2,1)$ 与 $(4,4)$。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "图象关于 $x$ 轴对称，且同时经过 $(2,1)$ 与 $(2,-1)$。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "图象是一条直线，经过 $(0,0)$、$(2,0.5)$ 与 $(4,1)$。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "e7673dcb7f7be9e21204922a82937fac41b80f3df2f1e367ef1d75cd9fcad4c7",
        "sectionBytes": 10414
      },
      {
        "id": "n3-20",
        "index": 8,
        "source_numbers": [
          "20"
        ],
        "view": {
          "mode": "multiple",
          "stem": "对于实变量函数 $y=-\\frac13x^2$，选择所有正确的图象性质。",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "图象是开口向下的抛物线，顶点是 $(0,0)$，对称轴是 $y$ 轴，并经过 $(3,-3)$ 与 $(-3,-3)$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "除顶点 $(0,0)$ 外，图象位于第三、第四象限，其中 $(3,-3)$ 与 $(-3,-3)$ 分别在两个分支上。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "图象最高点是 $(0,0)$，在 $x=\\pm3$ 时 $y=-3$，函数最大值为 $0$，在 $x=0$ 时取得。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "图象最低点是 $(0,0)$，在 $x=\\pm3$ 时 $y=3$，函数最小值为 $0$，在 $x=0$ 时取得。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "6a7ba9c38a87b1f289cb96b794d576cddd86126be7e38211aaa00c4cc5936dfe",
        "sectionBytes": 14438
      },
      {
        "id": "n3-22",
        "index": 9,
        "source_numbers": [
          "22"
        ],
        "view": {
          "mode": "single",
          "stem": "将 $x^2-2x+5$ 和 $2x^2-8x+7$ 分别配方。哪组恒等变形依次正确？",
          "figure_ids": [],
          "options": [
            {
              "id": "A",
              "text": "$(x-1)^2+5$；$2(x-2)^2+7$。",
              "figure_ids": []
            },
            {
              "id": "B",
              "text": "$(x-1)^2+4$；$2(x-2)^2-1$。",
              "figure_ids": []
            },
            {
              "id": "C",
              "text": "$(x+1)^2+4$；$2(x+2)^2-1$。",
              "figure_ids": []
            },
            {
              "id": "D",
              "text": "$(x-1)^2+4$；$2\\big((x-2)^2-1\\big)$。",
              "figure_ids": []
            }
          ]
        },
        "sectionSha256": "75b37ea4ad741bfe0404fc3016ce5cfe893fc747e53b3a17644e3e199ef99762",
        "sectionBytes": 15903
      }
