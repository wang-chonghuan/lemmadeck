    "html": {
      "path": "/Users/yong/.codex/worktrees/stemrobin-182-six-7186/lemmadeck/ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c1-s1-n3/choice-set/evidence/choices.html",
