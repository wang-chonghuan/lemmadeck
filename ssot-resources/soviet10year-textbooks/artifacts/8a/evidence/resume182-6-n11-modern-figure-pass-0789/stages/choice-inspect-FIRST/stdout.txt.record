  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "\u6211\u4eec\u6309\u7167\u9012\u589e\u7684\u987a\u5e8f\u5199\u51fa\u4ee5\u6570\u5b575\u7ed3\u5c3e\u7684\u4e24\u4f4d\u6570\uff1a\n$15,25,35,45,55,65,75,85,95$.\n\u7b2c1\u4e2a\u6570\u662f15\uff0c\u7b2c2\u4e2a\u6570\u662f25\uff0c\u7b2c3\u4e2a\u6570\u662f35\uff0c\u7b2c9\u4e2a\uff08\u6700\u540e\u4e00\u4e2a\uff09\u6570\u662f95.\n\n\u4ece1\u52309\u7684\u6bcf\u4e00\u4e2a\u81ea\u7136\u6570\u90fd\u548c\u552f\u4e00\u7684\u4e00\u4e2a\u4ee5\u6570\u5b575\u7ed3\u5c3e\u7684\u4e24\u4f4d\u6570\u76f8\u5bf9\u5e94\uff1a\n$1\\to15,2\\to25,3\\to35,\\cdots,9\\to95$.\n\u8fd9\u6837\u5c31\u7ed9\u51fa\u4e86\u4e00\u4e2a\u51fd\u6570\uff0c\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u662f\u96c6\u5408$\\{1,2,3,\\cdots,9\\}$\uff0c\u800c\u51fd\u6570\u7684\u503c\u57df\u662f\u96c6\u5408$\\{15,25,35,\\cdots,95\\}$.\n\n\u6211\u4eec\u7528\u5b57\u6bcd$g$\u8868\u793a\u8fd9\u4e2a\u51fd\u6570. \u4e8e\u662f$g(1)=15$\uff0c$g(2)=25$\uff0c$g(3)=35$\uff0c$\\cdots$\uff0c$g(9)=95$."
    },
    {
      "block": 1,
      "text": "\u6211\u4eec\u6765\u770b\u53e6\u4e00\u4e2a\u4f8b\u5b50."
    },
    {
      "block": 2,
      "text": "\u6211\u4eec\u6309\u7167\u9012\u51cf\u7684\u987a\u5e8f\u6392\u5217\u5206\u5b50\u7b49\u4e8e1\u7684\u771f\u5206\u6570\uff1a\n$\\frac{1}{2},\\frac{1}{3},\\frac{1}{4},\\frac{1}{5},\\frac{1}{6},\\cdots$."
    },
    {
      "block": 3,
      "text": "\u4e0a\u9762\u6211\u4eec\u53ea\u5199\u51fa\u4e86\u524d5\u4e2a\u8fd9\u79cd\u5206\u6570. \u663e\u7136\uff0c$\\frac{1}{7}$\u5e94\u5f53\u5728\u7b2c6\u4e2a\u4f4d\u7f6e\uff0c$\\frac{1}{8}$\u5e94\u5f53\u5728\u7b2c7\u4e2a\u4f4d\u7f6e\uff0c$\\frac{1}{31}$\u5e94\u5f53\u5728\u7b2c30\u4e2a\u4f4d\u7f6e\uff0c$\\frac{1}{101}$\u5e94\u5f53\u5728\u7b2c100\u4e2a\u4f4d\u7f6e. \u603b\u4e4b\uff0c\u5bf9\u4e8e\u4efb\u4f55\u4e00\u4e2a\u81ea\u7136\u6570$n$\uff0c\u53ef\u4ee5\u7ed9\u51fa\u548c\u5b83\u5bf9\u5e94\u7684\u5206\u6570\uff0c\u5e76\u4e14\u8fd9\u4e2a\u5206\u6570\u662f\u552f\u4e00\u7684."
    },
    {
      "block": 4,
      "text": "\u56e0\u6b64\uff0c\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\u4e5f\u7ed9\u51fa\u4e00\u4e2a\u51fd\u6570\uff0c\u8fd9\u4e2a\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u662f\u81ea\u7136\u6570\u96c6\u5408$N$\uff0c\u800c\u51fd\u6570\u7684\u503c\u57df\u662f\u5206\u5b50\u7b49\u4e8e1\u7684\u771f\u5206\u6570\u7684\u96c6\u5408. \u6211\u4eec\u7528\u5b57\u6bcd$h$\u8868\u793a\u6240\u8ba8\u8bba\u7684\u51fd\u6570\uff0c\u4e8e\u662f$h(1)=\\frac{1}{2}$\uff0c$h(2)=\\frac{1}{3}$\uff0c$h(3)=\\frac{1}{4}$\uff0c$\\cdots$\uff0c$h(30)=\\frac{1}{31}$\uff0c$\\cdots$\uff0c$h(100)=\\frac{1}{101}$\uff0c$\\cdots$."
    },
    {
      "block": 5,
      "text": "\u5b9a\u4e49 \u5b9a\u4e49\u57df\u662f\u81ea\u7136\u6570\u7684\u96c6\u5408\u6216\u524d$n$\u4e2a\u81ea\u7136\u6570\u7684\u96c6\u5408\u7684\u51fd\u6570\u53eb\u505a\u6570\u5217."
    },
    {
      "block": 6,
      "text": "\u5982\u679c\u6570\u5217\u5b9a\u4e49\u5728\u6240\u6709\u81ea\u7136\u6570\u7684\u96c6\u5408\u4e0a\uff0c\u90a3\u4e48\u8fd9\u79cd\u6570\u5217\u5c31\u53eb\u505a\u65e0\u7a77\u6570\u5217\uff1b\n\u5982\u679c\u6570\u5217\u5b9a\u4e49\u5728\u524d$n$\u4e2a\u81ea\u7136\u6570\u7684\u96c6\u5408\u4e0a\uff0c\u90a3\u4e48\u5b83\u5c31\u53eb\u505a\u6709\u9650\u6570\u5217. \u5728\u4e0a\u9762\u6240\u5f15\u7528\u7684\u7b2c\u4e00\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u6211\u4eec\u8ba8\u8bba\u4e86\u6709\u9650\u6570\u5217\uff1b\n\u5728\u7b2c\u4e8c\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u6211\u4eec\u8ba8\u8bba\u4e86\u65e0\u7a77\u6570\u5217\uff08\u5728\u5199\u6cd5\u91cc\uff0c\u7528\u5220\u8282\u53f7\u8868\u793a\uff09."
    },
    {
      "block": 7,
      "text": "\u8bbe\u67d0\u51fd\u6570$f$\u662f\u4e00\u4e2a\u6570\u5217. \u548c\u81ea\u53d8\u91cf\u503c\u7b49\u4e8e$1,2,3,\\cdots,n$\uff0c$\\cdots$\u5bf9\u5e94\u7684\u51fd\u6570\u503c$f(1),f(2),f(3),\\cdots,f(n),\\cdots$\u53eb\u505a\u6570\u5217\u7684\u7b2c1\u9879\uff0c\u7b2c2\u9879\uff0c\u7b2c3\u9879\uff0c$\\cdots$\uff0c\u7b2c$n$\u9879\uff0c$\\cdots$."
    },
    {
      "block": 8,
      "text": "\u901a\u5e38\u6211\u4eec\u7528\u5e26\u4e0b\u6807\u7684\u5b57\u6bcd\u8868\u793a\u6570\u5217\u7684\u9879. \u7528\u7b26\u53f7$a_1$\u8868\u793a\u6570\u5217\u7684\u7b2c1\u9879\uff0c\u7528\u7b26\u53f7$a_2$\u8868\u793a\u6570\u5217\u7684\u7b2c2\u9879\uff0c\u7528\u7b26\u53f7$a_3$\u8868\u793a\u6570\u5217\u7684\u7b2c3\u9879\uff0c$\\cdots$\uff0c\u7528\u7b26\u53f7$a_n$\u8868\u793a\u5e8f\u53f7\u4e3a$n$\u7684\u9879\u7b49\u7b49\uff1a\n$f(1)=a_1,f(2)=a_2,f(3)=a_3,\\cdots,f(n)=a_n,\\cdots$."
    },
    {
      "block": 9,
      "text": "\u5f53\u91c7\u7528\u8fd9\u79cd\u8868\u793a\u65b9\u6cd5\u65f6\uff0c\u4e0b\u6807\uff08\u9879\u7684\u5e8f\u53f7\uff09\u7b49\u4e8e\u81ea\u53d8\u91cf\u7684\u6570\u503c\uff1b\n\u548c\u81ea\u53d8\u91cf$n$\u5bf9\u5e94\u7684\u51fd\u6570\u503c\u7528\u7b26\u53f7$a_n$\u8868\u793a. \u800c\u6570\u5217\u672c\u8eab\u5c06\u8868\u793a\u6210$(a_n)$."
    },
    {
      "block": 10,
      "text": "\u4f8b\u5982\uff0c\u6211\u4eec\u7528\u7b26\u53f7$(a_n)$\u8868\u793a\u4e0a\u9762\u6240\u8ba8\u8bba\u7684\u5404\u9879\u662f\u5206\u5b50\u7b49\u4e8e1\u7684\u771f\u5206\u6570\u7684\u6570\u5217\uff0c\u4e8e\u662f$a_1=\\frac{1}{2},a_2=\\frac{1}{3},a_3=\\frac{1}{4},a_{30}=\\frac{1}{31},a_{100}=\\frac{1}{101}$."
    },
    {
      "block": 11,
      "text": "\u6211\u4eec\u6307\u51fa\uff0c\u4e5f\u53ef\u4ee5\u7528\u4efb\u4f55\u4e00\u4e2a\u5176\u4ed6\u5b57\u6bcd\u4ee3\u66ff\u5b57\u6bcd$a$."
    },
    {
      "block": 12,
      "text": "\u5982\u679c\u6570\u5217\u662f\u589e\u51fd\u6570\uff0c\u901a\u5e38\u5c31\u628a\u8fd9\u79cd\u6570\u5217\u53eb\u505a\u589e\u6570\u5217."
    },
    {
      "block": 13,
      "text": "\u5728\u7b2c\u4e00\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u6211\u4eec\u6240\u8ba8\u8bba\u7684\u4ee5\u6570\u5b575\u7ed3\u5c3e\u7684\u4e24\u4f4d\u6570\u7684\u6570\u5217\uff0c\u662f\u8f83\u5927\u7684\u5e8f\u53f7\uff08\u8f83\u5927\u7684\u81ea\u53d8\u91cf\u503c\uff09\u5bf9\u5e94\u4e8e\u6570\u5217\u8f83\u5927\u7684\u9879\uff08\u8f83\u5927\u7684\u51fd\u6570\u503c\uff09. \u5c31\u662f\u8bf4\uff0c\u8fd9\u4e2a\u6709\u9650\u6570\u5217\u662f\u589e\u6570\u5217."
    },
    {
      "block": 14,
      "text": "\u5076\u6570\u7684\u65e0\u7a77\u6570\u5217$2,4,6,8,\\cdots$\u4e5f\u53ef\u4ee5\u4f5c\u4e3a\u589e\u6570\u5217\u7684\u4f8b\u5b50\uff0c\u5176\u4e2d\u6bcf\u4e00\u9879\u7b49\u4e8e\u81ea\u8eab\u7684\u5e8f\u53f7\u76842\u500d."
    },
    {
      "block": 15,
      "text": "\u663e\u7136\uff0c\u6bcf\u4e00\u9879\uff08\u4ece\u7b2c2\u9879\u8d77\uff09\u90fd\u6bd4\u5b83\u524d\u9762\u4e00\u9879\u5927\u7684\u6570\u5217\u662f\u589e\u6570\u5217\uff0c\u800c\u4e14\u53ea\u6709\u8fd9\u79cd\u6570\u5217\u624d\u662f\u589e\u6570\u5217."
    },
    {
      "block": 16,
      "text": "\u7c7b\u4f3c\u5730\uff0c\u5982\u679c\u6570\u5217\u662f\u51cf\u51fd\u6570\uff0c\u901a\u5e38\u5c31\u628a\u8fd9\u79cd\u6570\u5217\u53eb\u505a\u51cf\u6570\u5217."
    },
    {
      "block": 17,
      "text": "\u4f8b\u5982\uff0c\u6709\u9650\u6570\u5217$-2,-4,-6,-8,-10$\u662f\u51cf\u6570\u5217\uff0c\u4e0a\u9762\u6240\u8ba8\u8bba\u7684\u5206\u5b50\u7b49\u4e8e1\u7684\u771f\u5206\u6570\u7684\u65e0\u7a77\u6570\u5217\u4e5f\u662f\u51cf\u6570\u5217."
    },
    {
      "block": 18,
      "text": "\u6bcf\u4e00\u9879\uff08\u4ece\u7b2c2\u9879\u8d77\uff09\u90fd\u6bd4\u5b83\u524d\u9762\u4e00\u9879\u5c0f\u7684\u6570\u5217\u662f\u51cf\u6570\u5217\uff0c\u800c\u4e14\u53ea\u6709\u8fd9\u79cd\u6570\u5217\u624d\u662f\u51cf\u6570\u5217."
    },
    {
      "block": 19,
      "text": "\u5e76\u975e\u6240\u6709\u7684\u6570\u5217\u90fd\u662f\u589e\u6570\u5217\u6216\u51cf\u6570\u5217. \u4f8b\u5982\uff0c\u6709\u9650\u6570\u5217$8,-6,4,-2,0$\uff1b\n\u65e0\u7a77\u6570\u5217$5,0,5,0,5,0,\\cdots$\uff0c\u5b83\u6240\u6709\u7684\u5947\u6570\u9879\u90fd\u7b49\u4e8e5\uff0c\u800c\u5b83\u6240\u6709\u7684\u5076\u6570\u9879\u90fd\u7b49\u4e8e0\uff1b\n\u65e0\u7a77\u6570\u5217$10,10,10,10,\\cdots$\u5b83\u6240\u6709\u7684\u9879\u90fd\u7b49\u4e8e10."
    },
    {
      "block": 20,
      "text": "\u5e94\u5f53\u6307\u51fa\uff0c\u6240\u6709\u7684\u9879\u5f7c\u6b64\u76f8\u7b49\u7684\u6570\u5217\u53eb\u505a\u5e38\u6570\u5217."
    },
    {
      "block": 21,
      "text": "\u4e00\u822c\u8bf4\u6765\uff0c\u8c61\u8868\u793a\u6570\u503c\u51fd\u6570\u4e00\u6837\uff0c\u5728\u51e0\u4f55\u4e0a\u53ef\u4ee5\u5229\u7528\u5750\u6807\u5e73\u9762\u4e0a\u7684\u70b9\u8868\u793a\u6570\u503c\u5e8f\u5217. \u56e0\u4e3a\u6570\u503c\u5e8f\u5217\u662f\u5b9a\u4e49\u57df\u4e3a\u81ea\u7136\u6570\u96c6\u5408$N$\uff08\u6216\u524d$n$\u4e2a\u81ea\u7136\u6570\u7684\u96c6\u5408\uff09\u7684\u51fd\u6570\uff0c\u6240\u4ee5\u5b83\u7684\u56fe\u8c61\u662f\u5750\u6807\u5e73\u9762\u4e0a\u8fd9\u6837\u4e00\u4e9b\u70b9\u7684\u96c6\u5408\uff0c\u5373\u70b9\u7684\u6a2a\u5750\u6807\u662f\u81ea\u7136\u6570$1,2,3$\uff0c$\\cdots,n,\\cdots$\uff0c\u800c\u70b9\u7684\u7eb5\u5750\u6807\u662f\u6570\u5217\u76f8\u5e94\u7684\u9879."
    },
    {
      "block": 22,
      "text": "\u5728\u56fe28\u4e2d\u753b\u51fa\u4e86\u6709\u9650\u6570\u5217$-4,-2,0,2,4$\u7684\u56fe\u8c61. \u5b83\u7531\u4e94\u4e2a\u70b9\u7ec4\u6210\uff0c\u70b9\u7684\u5750\u6807\u662f\u6570\u5bf9$(1,-4),(2,-2),(3,0),(4,2),(5,4)$."
    }
  ],
