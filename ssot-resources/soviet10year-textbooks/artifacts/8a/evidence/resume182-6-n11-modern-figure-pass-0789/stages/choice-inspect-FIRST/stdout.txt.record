    {
      "number": "201",
      "text": "201. \u5728\u56fe29\u4e2d\u753b\u51fa\u4e86\u6570\u5217$(a_n)$\u3001$(b_n)$\u3001$(c_n)$\u548c$(d_n)$\u7684\u56fe\u8c61. \u5176\u4e2d\u54ea\u4e9b\u6570\u5217\u662f\u589e\u6570\u5217\uff1f\u54ea\u4e9b\u662f\u51cf\u6570\u5217\uff1f",
      "figure_ids": [
        "fig-29"
      ]
    },
    {
      "number": "202",
      "text": "202. \u5468\u957f\u7b49\u4e8e$p\\,\\mathrm{cm}$\u3001\u9762\u79ef\u7b49\u4e8e$S\\,\\mathrm{cm}^2$\u7684\u77e9\u5f62\u5b58\u5728\u5417\uff1f\u8bbe\uff1a\na) $p=40,S=84$\uff1b\nb) $p=40,S=105$.",
      "figure_ids": []
    },
    {
      "number": "203",
      "text": "203.\na) \u65b9\u7a0b$x^2+x+y=30$\u7684\u56fe\u8c61\u7ecf\u8fc7\u4e24\u5750\u6807\u7684\u548c\u7b49\u4e8e5\u7684\u70b9. \u6c42\u8fd9\u4e2a\u70b9\u7684\u5750\u6807.\nb) \u65b9\u7a0b$x^2+4y=20$\u7684\u56fe\u8c61\u7ecf\u8fc7\u7eb5\u5750\u6807\u4e3a\u6a2a\u5750\u6807\u7684\u4e24\u500d\u7684\u70b9. \u6c42\u8fd9\u4e2a\u70b9\u7684\u5750\u6807.",
      "figure_ids": []
