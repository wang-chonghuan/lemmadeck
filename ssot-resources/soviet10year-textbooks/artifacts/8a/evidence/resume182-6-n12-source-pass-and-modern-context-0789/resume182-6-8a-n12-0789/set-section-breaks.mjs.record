import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { createRequire } from 'node:module';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/resume182-6-8a-n12-0789';
const file = `${base}/modern-FIRST/adapt/8a/modern-us-neutral/lessons/alg8-c3-s1-n12/lesson.template.json`;
const stdout = `${base}/stages/modern-prose-flow-layout1/stdout.txt`;
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const entry = file => ({ path: path.resolve(file), sha256: sha(fs.readFileSync(file)) });
const before = entry(file);
const lesson = JSON.parse(fs.readFileSync(file));
assert.deepEqual(lesson.section_breaks, []);
const objects = fs.readFileSync(stdout, 'utf8').split('\n')
  .map(line => line.trim()).filter(line => line.startsWith('break: '))
  .map(line => JSON.parse(line.slice('break: '.length)));
const selected = objects.filter(item => /^(?:2|3)\. /u.test(item.after));
assert.equal(selected.length, 2);
lesson.section_breaks = selected;
const require = createRequire(path.resolve('.claude/skills/ld-s10y-lesson/tools/htmlfrag.js'));
const { proseFlow } = require('./htmlfrag.js');
const flow = proseFlow(lesson.prose, lesson.section_breaks);
assert.equal(flow.filter(item => item.sectionBreak).length, 2);
fs.writeFileSync(file, `${JSON.stringify(lesson, null, 2)}\n`);
const output = `${base}/modern-author-layout1/section-breaks.record`;
fs.writeFileSync(output, `${JSON.stringify({
  status: 'ACTUAL_PROSE_FLOW_BOUNDARIES_AUTHORED_NOT_APPROVED',
  book: '8a', lesson: 'alg8-c3-s1-n12', edition: 'modern-us-neutral',
  before, after: entry(file), nativeOutput: entry(stdout), selected,
  manualParagraphIndices: false, sourceChanges: 0, imageViews: 0,
  databaseWrites: 0, finish: 'review',
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(entry(output)));
