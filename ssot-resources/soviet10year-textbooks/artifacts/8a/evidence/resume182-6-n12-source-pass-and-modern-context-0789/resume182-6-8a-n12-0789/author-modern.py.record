import copy
import hashlib
import json
from pathlib import Path
import re
import sys

REPO = Path("/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck")
assert Path.cwd() == REPO
sys.path.insert(0, str(REPO / ".claude/skills/ld-s10y-lesson/tools"))
import edition

BASE = REPO / ".tmp/resume182-6-8a-n12-0789"
TARGET = BASE / "modern-FIRST/adapt/8a/modern-us-neutral/lessons/alg8-c3-s1-n12"
HISTORY = BASE / "modern-author-layout1"
HISTORY.mkdir()


def sha(data):
    return hashlib.sha256(data).hexdigest()


def bind(file):
    return {"path": str(file), "sha256": sha(file.read_bytes()), "bytes": file.stat().st_size}


review_file = BASE / "source-review-FIRST/result-affected-annotation1.record"
assert sha(review_file.read_bytes()) == "cd18e13a0ff01a8c5ea64a6951a2f640c0cdda29c3468371680dc9593dc87c14"
review = json.loads(review_file.read_bytes())
assert review["status"] == "SOURCE_PASS"
inputs = []
documents = {}
originals = {}
for name in ("lesson", "exercises"):
    file = TARGET / f"{name}.template.json"
    data = file.read_bytes()
    inputs.append(bind(file))
    (HISTORY / f"{name}.before.record").write_bytes(data)
    prepared_file = BASE / "modern-author-FIRST" / f"{name}.before.record"
    inputs.append(bind(prepared_file))
    documents[name] = json.loads(prepared_file.read_bytes())
    originals[name] = copy.deepcopy(documents[name])

lesson = documents["lesson"]
exercises = documents["exercises"]
for block in lesson["prose"]:
    if block["kind"] != "p":
        continue
    text = block["source_text"].replace(". ", ".\n")
    if re.match(r"^[1-3]\.\n", text):
        text = text.replace("\n", " ", 1)
    if block["source_refs"] == ["p0082#5"]:
        text = text.replace(".\n", ".\n\n").replace("\uff0c$b_", "\uff0c\n$b_")
    block["text"] = edition.normalize_prose_layout(text)
    assert "".join(block["text"].split()) == "".join(block["source_text"].split())
    block["changes"] = ["layout"] if block["text"] != block["source_text"] else []

labels = {chr(code): chr(97 + index) for index, code in enumerate(
    [0x430, 0x431, 0x432, 0x433, 0x434, 0x435, 0x436, 0x437, 0x438, 0x43a]
)}
label_changes = []
for exercise in exercises["exercises"]:
    before = exercise["text"]
    exercise["text"] = re.sub(
        r"(?m)^([\u0430-\u044f])\)",
        lambda match: labels[match.group(1)] + ")", before,
    )
    if exercise["text"] != before:
        exercise["changes"] = list(dict.fromkeys([*exercise["changes"], "enum-latin"]))
        label_changes.append(exercise["number"])
    exercise["lines"] = exercise["text"].splitlines()

assert len(lesson["errata"]) == 1
erratum = lesson["errata"][0]
assert erratum["id"] == "p0084-ex210-lowered-n"
assert erratum["target"] == "exercises[6]"
assert erratum["original"] == "$c_n=4_n-1$"
assert erratum["corrected"] == ""
erratum["corrected"] = "$c_n=4n-1$"
target_exercise = exercises["exercises"][6]
assert target_exercise["number"] == "210"
assert target_exercise["text"].count(erratum["original"]) == 1
target_exercise["text"] = target_exercise["text"].replace(erratum["original"], erratum["corrected"], 1)
target_exercise["lines"] = target_exercise["text"].splitlines()
target_exercise["changes"] = list(dict.fromkeys([*target_exercise["changes"], "math-correction"]))
edition.normalize_lesson_layout(lesson)
edition.normalize_exercise_layout(exercises)

outputs = []
for name, document in documents.items():
    assert document["source"] == originals[name]["source"]
    data = (json.dumps(document, ensure_ascii=False, indent=2) + "\n").encode()
    (HISTORY / f"{name}.after.record").write_bytes(data)
    file = TARGET / f"{name}.template.json"
    file.write_bytes(data)
    outputs.append(bind(file))

record = {
    "schema": "stemrobin-182/modern-text-author@1",
    "status": "MODERN_TEXT_AUTHORED_NOT_APPROVED",
    "book": "8a", "lesson": "alg8-c3-s1-n12", "edition": "modern-us-neutral",
    "sourceApproval": bind(review_file), "inputs": inputs, "outputs": outputs,
    "prose": len(lesson["prose"]), "exercises": len(exercises["exercises"]),
    "latinOrdinalExercises": label_changes,
    "sourceBoundMathCorrection": erratum,
    "culturalNameOrNumberChanges": 0, "sourceSnapshotChanges": 0,
    "figuresAuthoredOrApproved": False, "imageViews": 0,
    "oldPassReruns": 0, "databaseWrites": 0, "finish": "review", "totalCost": "unknown",
}
file = HISTORY / "result.record"
file.write_text(json.dumps(record, ensure_ascii=True, indent=2) + "\n", encoding="utf-8")
print(json.dumps(bind(file)))
