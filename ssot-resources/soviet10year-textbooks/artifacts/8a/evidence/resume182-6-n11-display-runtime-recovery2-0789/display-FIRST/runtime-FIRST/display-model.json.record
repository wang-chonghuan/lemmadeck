{
  "lesson": {
    "id": "alg8-c3-s1-n11",
    "card_id": "alg8-c3-s1-n11",
    "chapter": "第三章　等差数列和等比数列",
    "section": "§5. 数列",
    "title": "数列的概念",
    "printed_title": "11. 数列的概念",
    "start_printed": 67,
    "exercise_count": 16,
    "section_breaks": [],
    "figures": [
      {
        "id": "fig-28",
        "label": "图 28",
