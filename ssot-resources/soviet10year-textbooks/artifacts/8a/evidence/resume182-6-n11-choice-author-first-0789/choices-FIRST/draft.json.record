          {"id": "B", "text": "$X=\\{1,2,3\\},\\ Y=\\{10,20,30\\}$；数对为 $\\{(1,10),(2,20),(3,30)\\}$。", "figure_ids": []},
          {"id": "C", "text": "$X=\\{1,2,3,4,5,6\\},\\ Y=\\{10,20,30,40,50,60\\}$；数对为 $\\{(1,10),(2,20),(3,30),(4,40),(5,50),(6,60)\\}$。", "figure_ids": []}
