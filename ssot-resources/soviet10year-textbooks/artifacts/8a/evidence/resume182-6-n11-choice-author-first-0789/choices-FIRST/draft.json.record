          {"option_id": "B", "truth": "incorrect", "derivation": "The claimed increasing list repeats 2, so its middle adjacent difference is zero.", "misconception": "Use nondecreasing instead of the supplied strict increase definition."},
          {"option_id": "C", "truth": "correct", "derivation": "Adjacent differences are +1 in the first list, -3 in the second, and alternating -2,+2,-2 in the third.", "misconception": null},
          {"option_id": "D", "truth": "incorrect", "derivation": "-4,-3,-2,-1 has adjacent +1, so is increasing, not decreasing.", "misconception": "Compare absolute values of negative numbers and reverse their actual order."}
