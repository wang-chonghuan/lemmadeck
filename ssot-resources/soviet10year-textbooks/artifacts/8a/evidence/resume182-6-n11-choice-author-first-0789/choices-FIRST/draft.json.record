          {"option_id": "B", "truth": "incorrect", "derivation": "Adding one produces successors, starting with c51 rather than c49.", "misconception": "Apply the forward direction to a request for the preceding term."},
          {"option_id": "C", "truth": "incorrect", "derivation": "Subtracting from the value assumes an unstated value difference; it does not identify position j-1.", "misconception": "Treat index succession as arithmetic progression of values."},
          {"option_id": "D", "truth": "incorrect", "derivation": "Subtracting two skips the immediate predecessor, giving c48 before c50.", "misconception": "Count two positions backward rather than the single adjacent position."}
