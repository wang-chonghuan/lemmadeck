          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}x^2+y^2\\leqslant36,\\\\|x|>1;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}x^2+y^2\\leqslant100,\\\\|x|<8;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}x^2+y^2\\leqslant1.44,\\\\xy\\geqslant0;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}x^2+y^2\\leqslant100,\\\\x^2+y^2\\geqslant64,\\\\xy\\leqslant0;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}y\\geqslant x^2,\\\\y\\leqslant-x^2+9;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}y\\geqslant x^2+4x+4,\\\\y\\leqslant4;\\end{array}\\right.",
