    {
      "key": "exercise-181",
      "serialized": "画细线条表示由下列不等式组给出的坐标平面上点的集合。 a) [[MATH:0]] b) [[MATH:1]] c) [[MATH:2]] d) [[MATH:3]] e) [[MATH:4]] f) [[MATH:5]]",
      "lines": [
        "画细线条表示由下列不等式组给出的坐标平面上点的集合。",
        "a) [[MATH:0]]",
        "b) [[MATH:1]]",
        "c) [[MATH:2]]",
        "d) [[MATH:3]]",
        "e) [[MATH:4]]",
        "f) [[MATH:5]]"
      ],
      "formulas": [
        {
          "tex": "\\left\\{\\begin{array}{l}y>x,\\\\y<2x,\\\\y<4;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}y-x<2,\\\\y+x>4,\\\\x-4<0;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}x+y\\leqslant6,\\\\2x+2y\\geqslant7,\\\\x\\geqslant0;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}x-y\\geqslant3,\\\\x+y\\leqslant5,\\\\y\\geqslant1;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}|x|\\leqslant2,\\\\|y|\\leqslant3;\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}|x|\\leqslant4,\\\\|y|\\geqslant5.\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        }
      ],
