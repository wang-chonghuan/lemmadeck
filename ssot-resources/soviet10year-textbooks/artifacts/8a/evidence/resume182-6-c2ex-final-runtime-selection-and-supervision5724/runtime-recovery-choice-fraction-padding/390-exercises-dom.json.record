          "visible": true,
          "nonempty": true
        },
        {
          "tex": "\\left\\{\\begin{array}{l}y\\geqslant(x-2)(x-3),\\\\y\\leqslant0.\\end{array}\\right.",
          "visible": true,
          "nonempty": true
        }
      ],
