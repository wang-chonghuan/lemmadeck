    {
      "id": "c2p2-absolute-regions",
      "source_numbers": [
        "170"
      ],
      "view": {
        "mode": "multiple",
        "stem": "对 $y\\geq|x|$、$y\\leq-|x|$、$y\\geq|x-2|$、$y\\leq|1-x|$ 的区域，选择所有完整且正确的描述。各式均允许任意实数横坐标。",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$y\\geq|x|$：位于两射线 $y=|x|$ 的上方，包含边界；等价于同时满足 $y\\geq x$、$y\\geq-x$。",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$y\\leq|1-x|$：顶点 $(1,0)$，包含边界；等价于同时满足 $y\\leq1-x$、$y\\leq x-1$。",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$y\\leq-|x|$：位于两射线 $y=-|x|$ 的下方，包含边界；等价于同时满足 $y\\leq x$、$y\\leq-x$。",
            "figure_ids": []
          },
          {
            "id": "d",
            "text": "$y\\geq|x-2|$：顶点 $(-2,0)$，包含边界；等价于同时满足 $y\\geq x+2$、$y\\geq-x-2$。",
            "figure_ids": []
          },
          {
            "id": "e",
            "text": "$y\\geq|x-2|$：顶点 $(2,0)$，包含边界；等价于同时满足 $y\\geq x-2$、$y\\geq2-x$。",
            "figure_ids": []
          },
          {
            "id": "f",
            "text": "$y\\geq|x|$：位于两射线 $y=-|x|$ 的下方，包含边界；等价于同时满足 $y\\leq x$、$y\\leq-x$。",
            "figure_ids": []
          },
          {
            "id": "g",
            "text": "$y\\leq|1-x|$：顶点 $(1,0)$，包含边界；等价于 $y\\leq1-x$ 或 $y\\leq x-1$，至少满足一个。",
            "figure_ids": []
          },
          {
            "id": "h",
            "text": "$y\\leq-|x|$：位于两射线 $y=|x|$ 的上方，包含边界；等价于同时满足 $y\\geq x$、$y\\geq-x$。",
            "figure_ids": []
          }
        ]
      }
    },
