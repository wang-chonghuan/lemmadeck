import fs from 'node:fs';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const own = '.tmp/resume182-6-8a-n10-display-final-code3695-FIRST';
assert.ok(!fs.existsSync(own));
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const inputs = [
  ['.tmp/resume182-6-8a-n8-display-select3695-AFFECTED-media-contract1.mjs',
    '.tmp/resume182-6-8a-n10-display-select3695.mjs'],
  ['.tmp/resume182-6-8a-n8-display-bind3695.mjs',
    '.tmp/resume182-6-8a-n10-display-bind3695.mjs'],
];
fs.mkdirSync(own);
const entries = [];
for (const [input, output] of inputs) {
  assert.ok(!fs.existsSync(output));
  const bytes = fs.readFileSync(input);
  const text = bytes.toString('utf8')
    .replaceAll('alg8-c2-s1-n8', 'alg8-c2-s2-n10')
    .replaceAll('n8-display-select3695-AFFECTED-media-contract1',
      'n10-display-select3695')
    .replaceAll('n8', 'n10');
  fs.writeFileSync(output, text, { flag: 'wx' });
  const command = [process.execPath, '--check', output];
  const result = spawnSync(command[0], command.slice(1), {
    cwd: repo, encoding: 'utf8',
  });
  const name = output.includes('-select') ? 'selector' : 'binder';
  for (const stream of ['stdout', 'stderr']) {
    fs.writeFileSync(`${own}/${name}-${stream}.txt`, result[stream] ?? '',
      { flag: 'wx' });
  }
  fs.writeFileSync(`${own}/${name}-receipt.record`, `${JSON.stringify({
    command, cwd: repo, returncode: result.status, signal: result.signal,
    error: result.error?.message ?? null,
  }, null, 2)}\n`, { flag: 'wx' });
  assert.equal(result.status, 0, result.stderr);
  assert.equal(sha(fs.readFileSync(input)), sha(bytes));
  entries.push({ input, inputSha256: sha(bytes), output,
    outputSha256: sha(fs.readFileSync(output)) });
}
const value = {
  status: 'CODE_PREPARED_NOT_EXECUTED', ticket: 'STEMROBIN-182',
  root: repo, book: '8a', lesson: 'alg8-c2-s2-n10',
  edition: 'modern-us-neutral', created: new Date().toISOString(), entries,
  changes: ['Lesson and scratch identity only'],
  coverageLogic: 'Reuse actual DOM media geometry, not SVG canvas dimensions.',
  syntaxCalls: 2, contentReadinessChecks: 0, rendererCalls: 0,
  browserCalls: 0, imageViews: 0, semanticReviews: 0,
  sourceMathAnswerChoiceFigurePASSReruns: 0, DBWrites: 0,
  unknownHistoricalBytesRecovered: false, finish: 'review',
};
const file = `${own}/ready.record`;
fs.writeFileSync(file, `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ path: file, sha256: sha(fs.readFileSync(file)),
  runtimeExecutions: 0 }));
