  "prose_decisions": [
    {"target": "lesson.prose[0]", "source_refs": ["p0060#2"], "decision": "PASS", "reason": "完整引出二元不等式组；y>=x及x²+y²<=9的两行原TeX和次序不变，只将引出公式独立成行。"},
    {"target": "lesson.prose[1]", "source_refs": ["p0060#3"], "decision": "PASS", "reason": "解集合是各不等式解集合交集的完整定义保留；未改成并集或只满足其中一个，句号在数学区外。"},
    {"target": "lesson.prose[2]", "source_refs": ["p0060#4"], "decision": "PASS", "reason": "以解为坐标考察平面点集的对象和问题完整，只有中文句号排版变更。"},
    {"target": "lesson.prose[3]", "source_refs": ["p0060#5", "p0060#8"], "decision": "PASS", "reason": "直线上的点与上方开半平面取并集；圆心原点、半径3及水平/铅直细线说明均保留。圆形区域和半圆形区域明确含内部和完整边界；当且仅当保留源文的充分与必要两方向，交集及重叠细线未丢失。三个原公式逐字保留；实际两个短段分别完整含2句、3句。", "changes_accepted": ["layout", "clarification"]},
    {"target": "lesson.prose[4]", "source_refs": ["p0060#6"], "decision": "BINDING_PASS_ONLY", "reason": "fig-22对象的id、label、printed_page、source_refs及空文本不变；不是图审。"},
    {"target": "lesson.prose[5]", "source_refs": ["p0060#7"], "decision": "BINDING_PASS_ONLY", "reason": "图22图题和来源保持，不增补图像事实。"},
    {"target": "lesson.prose[6]", "source_refs": ["p0060#9"], "decision": "PASS", "reason": "引出两个例子的完整过渡句保留，不增加或减少例题。"},
    {"target": "lesson.prose[7]", "source_refs": ["p0060#10", "p0061#1"], "decision": "PASS", "reason": "例1两行不等式原TeX未改。中文限定为第二象限及其在坐标轴上的边界，包含原点；指该象限的轴上边界，不是整条两轴，也不是去掉边界的开象限。跨页绑定与图23引用保留。", "changes_accepted": ["layout", "clarification"]},
    {"target": "lesson.prose[8]", "source_refs": ["p0061#2"], "decision": "BINDING_PASS_ONLY", "reason": "fig-23对象身份和来源不变；不是图审。"},
    {"target": "lesson.prose[9]", "source_refs": ["p0061#3"], "decision": "BINDING_PASS_ONLY", "reason": "图23图题和来源不变。"},
    {"target": "lesson.prose[10]", "source_refs": ["p0061#4"], "decision": "BINDING_PASS_ONLY", "reason": "fig-24对象身份和来源不变；不是图审。"},
    {"target": "lesson.prose[11]", "source_refs": ["p0061#5"], "decision": "BINDING_PASS_ONLY", "reason": "图24图题和来源不变。"},
    {"target": "lesson.prose[12]", "source_refs": ["p0061#6"], "decision": "PASS", "reason": "例2原不等式组及y=2x-3、y=2x+2两条边界公式逐字不变。带形区域明确包含两条边界直线，未改为开带或单边区域；图24引用完整。", "changes_accepted": ["layout", "clarification"]}
  ],
  "exercise_decisions": [
    {"target": "exercises[0]", "number": "131", "source_refs": ["p0061#7"], "decision": "PASS", "subparts": 4, "reason": "仍逐一判断给定数对是否为原不等式组的解；2x+3y>-1与x²+y²<=2的严格性、连接关系和次序不变。四点(0,0)、(-1,0.5)、(1,-1)、(1/3,1)对应a–d且逐字原TeX保留，未替换成求解或加入答案。题干及各小问独占行。"},
    {"target": "exercises[1]", "number": "132", "source_refs": ["p0061#8"], "decision": "PASS", "subparts": 4, "reason": "仍判断四点是否属于原两行不等式给出的F；y<=x+4、y>=x-4及A(0,5)、B(-1,3)、C(-20,20)、D(100,102)的符号和顺序不变。新a–d只是给原四个判断项独立成行的layout标号，没有新增数学项目。"},
    {"target": "exercises[2]", "number": "133", "source_refs": ["p0061#9", "p0062#1"], "decision": "PASS", "subparts": 4, "reason": "画细线条表示各点集的任务保留。a、b两行系统及c的两个复合范围、d的两个严格范围均完整保留；4.5及全部端点、方向和非严格/严格关系不变。原а、б、в、г与现代a、b、c、d的系统逐项对应，跨页题干无截断或串栏。"},
    {"target": "exercises[3]", "number": "134", "source_refs": ["p0062#2"], "decision": "PASS", "subparts": 4, "reason": "绘制满足各不等式组的点集任务及a/b/c/d各系统的2/3/2/3行原式逐字保留。唯一标号勘误绑定完整左下块，现代第三序位c)不是误改右上б；未改两式、题号或顺序。", "changes_accepted": ["layout", "math-correction"], "erratum": "p0062-ex134-label-3"},
    {"target": "exercises[4]", "number": "135", "source_refs": ["p0062#3"], "decision": "PASS", "subparts": 4, "reason": "画点集的任务和四个两行系统原TeX保持。0.64、4、16、4-x、x²、y-4及所有比较方向和等号边界不变；c的圆与直线两项没有删减，d也未改成其他曲线或数值。"},
    {"target": "exercises[5]", "number": "136", "source_refs": ["p0062#4"], "figure_source_refs": ["p0063#1", "p0063#2"], "decision": "PASS", "subparts": 0, "figure_refs": ["fig-25"], "reason": "题面仍要求写出图25细线条区域对应的各不等式组；保留复数任务、figure_refs及唯一展示归属。没有预写任何不等式或读图答案；图25实际内容未审。"},
    {"target": "exercises[6]", "number": "137", "source_refs": ["p0063#4"], "decision": "PASS", "subparts": 2, "group": "复习题", "group_id": "g1", "reason": "本课七题中的完整复习题，a和b均保留；未用旧core=false排除，也未并入第二章补充习题或纳入138。", "a": {"decision": "PASS", "before": "两个少先队中队", "after": "两支徒步队", "invariants": ["同地同时出发", "一队向北，另一队向东", "经过4小时", "两队之间距离等于24公里", "第一队比第二队多走4.8公里", "第一/第二身份及多走的方向未倒置", "仍问每队行进速度"], "numeric_changes": []}, "b": {"decision": "PASS", "invariants": ["两个物体从直角顶点分别沿两条边同时开始移动", "经过15秒两物体间距离等于3米", "第一个物体6秒内路程等于第二个物体8秒内路程", "first-second与6-8配对不变", "仍问每个物体速度"], "numeric_changes": []}, "changes_accepted": ["layout", "culture"]}
  ],
