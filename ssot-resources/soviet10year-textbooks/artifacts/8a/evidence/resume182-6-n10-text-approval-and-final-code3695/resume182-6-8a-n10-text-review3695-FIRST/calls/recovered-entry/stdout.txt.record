.claude/skills/ld-s10y-lesson/SKILL.md:325:p2c.py adapt-prepare --book 5m --edition modern-us-neutral \
.claude/skills/ld-s10y-lesson/SKILL.md:326:  --lesson math5-c1-s2-n12 --lesson math5-c1-s2-n13
