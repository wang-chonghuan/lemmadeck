import fs from 'node:fs';
import crypto from 'node:crypto';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const root = path.dirname(fileURLToPath(import.meta.url));
const seedPath = path.join(root, 'seed.json');
const solutionPath = path.join(root, 'source-solutions.record');
const draftPath = path.join(root, 'draft.json');
const seedHash = '6b440516068ae890672eb4278bda35eec08cadfdaba9ed05e7ccb8c3507c67bf';
const seedFileHash = 'dddc95b98efcb46d62fc1a5fe6920390a818ca2a1878244554ea6e42f4c6337c';
const sha256 = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const seedBytes = fs.readFileSync(seedPath);
if (sha256(seedBytes) !== seedFileHash) throw new Error('Seed bytes changed.');
const seed = JSON.parse(seedBytes);
const solutions = JSON.parse(fs.readFileSync(solutionPath, 'utf8'));
if (solutions.input.seed_canonical_sha256 !== seedHash ||
    solutions.phase !== 'SOLVED_AND_PERSISTED_BEFORE_OPTION_CONSTRUCTION' ||
    solutions.review_performed !== false ||
    seed.figures.length !== 0) {
  throw new Error('The prior independent solution binding is not intact.');
}
if (fs.existsSync(draftPath)) throw new Error('Refusing to overwrite a draft.');

// All candidate statements and mistaken procedures below are hand-authored.
// These helpers only assemble the contract; they do not generate alternatives.
function alternative(id, text, truth, derivation, misconception = null) {
  return {
    view: { id, text, figure_ids: [] },
    rationale: { option_id: id, truth, derivation, misconception }
  };
}

function question(id, source, mode, stem, task, sourceSolution, unitReason,
                  limitations, correct, alternatives, concepts = [7, 8, 9, 10]) {
  return {
    id,
    source_numbers: [source],
    view: {
      mode,
      stem,
      figure_ids: [],
      options: alternatives.map(item => item.view)
    },
    intent: {
      task,
      source_solution: sourceSolution,
      unit_reason: unitReason,
      concept_blocks: concepts,
      limitations,
      figure_observations: []
    },
    key: {
      correct,
      rationales: alternatives.map(item => item.rationale)
    }
  };
}

const source = number => solutions.solutions.find(item => item.source_number === number);
const allDerivations = number => source(number).subtasks.map(
  item => `${item.part}) ${item.independent_derivation}`
).join('\n');
const prefixLoss = 'Selecting a complete prefix does not demonstrate independently writing the sequence.';
const variableFive = 'The source asks for the first few terms without fixing their number; five is an explicit condition of this authored question only.';
const variableEight = 'The source asks for the first few terms without fixing their number; eight is an explicit condition of this authored question only.';
const formulaLoss = 'Selecting a prefix and formula does not demonstrate independently constructing a general term.';

const questions = [
  question(
    'recurrence-rows', '218', 'multiple',
    '四个数列的条件如下，其中 $n$ 为整数。\n\n' +
      '| 数列 | 第1项 | 从第2项起的规则 |\n' +
      '| --- | --- | --- |\n' +
      '| $(p_n)$ | $p_1=4$ | $p_{n+1}=p_n+12$，$n\\ge1$ |\n' +
      '| $(q_n)$ | $q_1=8$ | $q_{n+1}=3q_n$，$n\\ge1$ |\n' +
      '| $(r_n)$ | $r_1=10$ | $r_{n+1}=r_n/2$，$n\\ge1$ |\n' +
      '| $(s_n)$ | $s_1=1$ | $s_n=s_{n-1}/n$，$n\\ge2$ |\n\n' +
      '选择所有正确给出相应数列前5项的选项。',
    'Construct coherent early-term rows for additive, multiplicative, fixed-division and new-index-division recurrences.',
    allDerivations('218'),
    'A complete row retains the initial condition and every recurrence transition. Multiple selection compares four different update procedures without splitting individual terms into answer slots.',
    [prefixLoss, variableFive],
    ['a', 'd', 'e', 'h'],
    [
      alternative('a', '$(p_n)$：$4,\\ 16,\\ 28,\\ 40,\\ 52$。',
        'correct', 'Four successive additions of 12 to 4 give 16,28,40,52.'),
      alternative('b', '$(q_n)$：$8,\\ 11,\\ 14,\\ 17,\\ 20$。',
        'incorrect', 'Replace multiplication by 3 with addition of 3: 8+3=11, then 14,17,20.',
        'Confuse multiplying the previous term by 3 with adding 3 to it.'),
      alternative('c', '$(s_n)$：$1,\\ 1,\\ \\frac12,\\ \\frac16,\\ \\frac1{24}$。',
        'incorrect', 'Use the preceding index as divisor: s_2=1/1=1, s_3=1/2, s_4=(1/2)/3=1/6, s_5=(1/6)/4=1/24.',
        'Use s_n=s_(n-1)/(n-1), shifting every required new-term divisor down by one.'),
      alternative('d', '$(r_n)$：$10,\\ 5,\\ \\frac52,\\ \\frac54,\\ \\frac58$。',
        'correct', 'Repeated division by 2 gives 5,5/2,5/4,5/8 without rounding.'),
      alternative('e', '$(q_n)$：$8,\\ 24,\\ 72,\\ 216,\\ 648$。',
        'correct', 'Successively multiply the evolving term by 3: 24,72,216,648.'),
      alternative('f', '$(p_n)$：$4,\\ 16,\\ 16,\\ 16,\\ 16$。',
        'incorrect', 'For every term after the first, compute p_1+12=4+12=16 instead of updating the preceding term.',
        'Keep using the initial value in place of the preceding term.'),
      alternative('g', '$(r_n)$：$10,\\ 5,\\ \\frac53,\\ \\frac5{12},\\ \\frac1{12}$。',
        'incorrect', 'Divide by the new index rather than by 2: r_2=10/2=5, r_3=5/3, r_4=(5/3)/4=5/12, r_5=(5/12)/5=1/12.',
        'Transfer the changing-index division rule to the fixed-division sequence.'),
      alternative('h', '$(s_n)$：$1,\\ \\frac12,\\ \\frac16,\\ \\frac1{24},\\ \\frac1{120}$。',
        'correct', 'Divide successively by the new indices 2,3,4,5; the product of the divisors gives the factorial denominators.')
    ]
  ),
  question(
    'signed-increments', '219', 'single',
    '数列 $(p_n)$ 和 $(q_n)$ 满足\n' +
      '$$p_1=1,\\quad p_{n+1}=p_n+1;\\qquad q_1=7,\\quad q_{n+1}=q_n-3,$$\n' +
      '其中 $n=1,2,3,\\ldots$。哪张表正确给出两个数列各自的前5项？',
    'Construct complete five-term rows for positive and negative additive updates, including passage across zero.',
    `${source('219').subtasks[0].independent_derivation}\n${source('219').subtasks[1].independent_derivation}`,
    'The response is one complete two-row table. It compares the direction of two additive recurrences and tests retaining the initial term and continuing subtraction through zero.',
    [prefixLoss],
    ['c'],
    [
      alternative('a',
        '| 数列 | 前5项 |\n| --- | --- |\n| $(p_n)$ | $2,\\ 3,\\ 4,\\ 5,\\ 6$ |\n| $(q_n)$ | $4,\\ 1,\\ -2,\\ -5,\\ -8$ |',
        'incorrect', 'Perform an update before recording the first position: p begins at p_2=2 and q at q_2=4. Continue four more updates to obtain the displayed rows.',
