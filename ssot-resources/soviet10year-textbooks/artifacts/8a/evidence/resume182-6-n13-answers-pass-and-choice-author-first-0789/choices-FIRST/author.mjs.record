      question_ids: ['complete-paired-solution-sets'],
      omitted_tasks: ['Independent written substitution, factorization and proof that no further ordered-pair solutions exist are not elicited by selecting a table.'],
      reason: 'Both full real solution sets are represented in one paired table, including both roots for the first system and the unique pair for the second. No root, equation or coordinate-pairing task is deferred.'
    }
  ]
};

fs.writeFileSync(draftPath, `${JSON.stringify(draft, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({
  status: 'AUTHORED_NOT_APPROVED',
  draft_path: draftPath,
  questions: questions.length,
  options: questions.reduce((sum, item) => sum + item.view.options.length, 0),
  single_questions: questions.filter(item => item.view.mode === 'single').length,
  multiple_questions: questions.filter(item => item.view.mode === 'multiple').length,
  source_exercises: draft.coverage.length,
  source_figures: seed.figures.length,
  new_figures: draft.new_figures.length,
  review_performed: false,
  cost: 'unknown'
}, null, 2));
