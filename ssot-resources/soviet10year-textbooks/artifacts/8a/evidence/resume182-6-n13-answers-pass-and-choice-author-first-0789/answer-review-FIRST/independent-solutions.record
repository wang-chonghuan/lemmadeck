  "solutions": [
    {
      "exercise": "218",
      "task": "Give the first few terms of each of four sequences.",
      "grading": "ungraded",
      "reason": "The task does not prescribe a term count. The following six-term lists are complete explicit examples, not a unique fixed-length answer.",
      "subparts": [
        {
          "label": "a)",
          "initialTerms": ["4"],
          "recurrence": "a_(n+1)=a_n+12 for n>=1",
          "terms": ["4", "16", "28", "40", "52", "64"],
          "derivation": "Start at 4; add 12 each time. The optional general term is 4+12(n-1)=12n-8."
        },
        {
          "label": "b)",
          "initialTerms": ["8"],
          "recurrence": "a_(n+1)=3a_n for n>=1",
          "terms": ["8", "24", "72", "216", "648", "1944"],
          "derivation": "Start at 8; multiply the previous term by 3."
        },
        {
          "label": "c)",
          "initialTerms": ["10"],
          "recurrence": "a_(n+1)=a_n/2 for n>=1",
          "terms": ["10", "5", "5/2", "5/4", "5/8", "5/16"],
          "derivation": "Start at 10; divide the previous term by 2."
        },
        {
          "label": "d)",
          "initialTerms": ["1"],
          "recurrence": "a_n=a_(n-1)/n for n>=2; equivalently a_(n+1)=a_n/(n+1) for n>=1",
          "terms": ["1", "1/2", "1/6", "1/24", "1/120", "1/720"],
          "derivation": "The divisor is the requested term's own index: 2 for a_2, 3 for a_3, and so on. Thus a_n=1/n! for n>=1."
        }
      ]
    },
    {
      "exercise": "219",
      "task": "Give exactly the first five terms of each of six sequences.",
      "grading": "auto",
      "requiredNumericParts": 30,
      "order": "a) a_1..a_5, then b) a_1..a_5, through f) a_1..a_5",
      "subparts": [
        {
          "label": "a)",
          "initialTerms": ["1"],
          "recurrence": "a_(n+1)=a_n+1",
          "terms": ["1", "2", "3", "4", "5"],
          "derivation": "Apply addition of 1 four times after the given first term."
        },
        {
          "label": "b)",
          "initialTerms": ["7"],
          "recurrence": "a_(n+1)=a_n-3",
          "terms": ["7", "4", "1", "-2", "-5"],
          "derivation": "Subtract 3 successively, retaining the signs of the fourth and fifth terms."
        },
        {
          "label": "c)",
          "initialTerms": ["-5"],
          "recurrence": "a_(n+1)=2a_n",
          "terms": ["-5", "-10", "-20", "-40", "-80"],
          "derivation": "Doubling a negative term keeps every term negative."
        },
        {
          "label": "d)",
          "initialTerms": ["75"],
          "recurrence": "a_(n+1)=a_n/10",
          "terms": ["75", "7.5", "0.75", "0.075", "0.0075"],
          "derivation": "Multiply by the exact decimal 0.1, equivalently divide by 10, at each step."
        },
        {
          "label": "e)",
          "initialTerms": ["1/6"],
          "recurrence": "a_(n+1)=-a_n",
          "terms": ["1/6", "-1/6", "1/6", "-1/6", "1/6"],
          "derivation": "Negation produces alternating signs with unchanged magnitude 1/6."
        },
        {
          "label": "f)",
          "initialTerms": ["3"],
          "recurrence": "a_(n+1)=1/a_n",
          "terms": ["3", "1/3", "3", "1/3", "3"],
          "derivation": "Taking reciprocals gives the two-cycle 3,1/3. No term is zero."
        }
      ]
    },
    {
      "exercise": "220",
      "task": "Give the first few terms of two second-order recursively defined sequences.",
      "grading": "ungraded",
      "reason": "No fixed term count is prescribed. Ten-term explicit examples are provided, and both given initial terms are included.",
      "subparts": [
        {
          "label": "a)",
          "initialTerms": ["-1", "1"],
          "recurrence": "c_(n+2)=c_n+c_(n+1) for n>=1",
          "terms": ["-1", "1", "0", "1", "1", "2", "3", "5", "8", "13"],
          "derivation": "c_3=-1+1=0, c_4=1+0=1, c_5=0+1=1. Continue adding the two previous terms."
        },
        {
          "label": "b)",
          "initialTerms": ["13", "6"],
          "recurrence": "c_(n+2)=c_n-c_(n+1) for n>=1",
          "terms": ["13", "6", "7", "-1", "8", "-9", "17", "-26", "43", "-69"],
          "derivation": "Subtract the immediately previous term from the term two places earlier: c_3=13-6=7, c_4=6-7=-1, c_5=7-(-1)=8, c_6=-1-8=-9. The subtraction order must not be reversed."
        }
      ]
    },
    {
      "exercise": "221",
      "task": "For each of four sequences give the first few terms AND a general-term formula.",
      "grading": "ungraded",
      "reason": "Each compound task includes an unspecified-length initial list. Supply a full explicit example and its general term rather than pretending one fixed list length is mandatory.",
      "subparts": [
        {
          "label": "a)",
          "initialTerms": ["10"],
          "recurrence": "u_(n+1)=u_n+10",
          "terms": ["10", "20", "30", "40", "50", "60"],
          "generalTerm": "u_n=10n",
          "domain": "integer n>=1",
          "derivation": "10+10(n-1)=10n. At n=1 it is 10; the consecutive difference is exactly 10."
        },
        {
          "label": "b)",
          "initialTerms": ["10"],
          "recurrence": "u_(n+1)=10u_n",
          "terms": ["10", "100", "1000", "10000", "100000", "1000000"],
          "generalTerm": "u_n=10^n",
          "domain": "integer n>=1",
          "derivation": "10*10^(n-1)=10^n. At n=1 it is 10, not 1; the consecutive ratio is exactly 10."
        },
        {
          "label": "c)",
          "initialTerms": ["2"],
          "recurrence": "u_(n+1)=u_n+2",
          "terms": ["2", "4", "6", "8", "10", "12"],
          "generalTerm": "u_n=2n",
          "domain": "integer n>=1",
          "derivation": "2+2(n-1)=2n. At n=1 it is 2; the consecutive difference is exactly 2."
        },
        {
          "label": "d)",
          "initialTerms": ["2"],
          "recurrence": "u_(n+1)=2u_n",
          "terms": ["2", "4", "8", "16", "32", "64"],
          "generalTerm": "u_n=2^n",
          "domain": "integer n>=1",
          "derivation": "2*2^(n-1)=2^n. At n=1 it is 2, not 1; the consecutive ratio is exactly 2."
        }
      ]
    },
    {
      "exercise": "222",
      "task": "Solve both systems, giving full paired solution sets.",
      "grading": "ungraded",
      "reason": "The solutions are sets of paired coordinates, including two alternatives in a). Independent scalar keys would not preserve solution-pair structure.",
      "subparts": [
        {
          "label": "a)",
          "equations": ["x^2-2y^2=14", "2x-3y=1"],
          "derivation": "The linear equation gives x=(1+3y)/2 without division by a variable. Substitute into the first equation: ((1+3y)^2-8y^2)/4=14, hence y^2+6y-55=0=(y-5)(y+11). Thus y=5 or -11; the corresponding x values are 8 and -16. These are all roots of the quadratic, so the full set has exactly two pairs.",
          "solutionPairs": [
            {"x": "8", "y": "5"},
            {"x": "-16", "y": "-11"}
          ],
          "substitutionChecks": [
            "8^2-2*5^2=64-50=14; 2*8-3*5=16-15=1",
            "(-16)^2-2*(-11)^2=256-242=14; 2*(-16)-3*(-11)=-32+33=1"
          ]
        },
        {
          "label": "b)",
          "equations": ["3xy-2y^2=30", "3x-2y=10"],
          "derivation": "Factor the first left side as y(3x-2y). The second equation then gives 10y=30, so y=3. Substitute back: 3x-6=10, hence x=16/3. Division was only by nonzero constants; the set has exactly one pair.",
          "solutionPairs": [
            {"x": "16/3", "y": "3"}
          ],
          "substitutionChecks": [
            "3*(16/3)*3-2*3^2=48-18=30; 3*(16/3)-2*3=16-6=10"
          ]
        }
      ]
    }
  ],
