import fs from 'node:fs';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const own = '.tmp/resume182-6-8a-n8-delivery-prepared3695-FIRST';
assert.ok(!fs.existsSync(own));
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const write = (file, bytes) => fs.writeFileSync(file, bytes, { flag: 'wx' });
const save = (file, value) => write(file, `${JSON.stringify(value, null, 2)}\n`);
fs.mkdirSync(own);
const files = [];
for (const kind of ['display-select', 'staged-check']) {
  const source = `.tmp/resume182-6-8a-n7-${kind}3695.mjs`;
  const target = `.tmp/resume182-6-8a-n8-${kind}3695.mjs`;
  assert.ok(!fs.existsSync(target));
  const original = fs.readFileSync(source);
  let text = original.toString('utf8').replaceAll('n7', 'n8');
  const transformations = ['Lesson and scratch identity n7 -> n8'];
  if (kind === 'staged-check') {
    const before = "['fig-14', 'fig-15']";
    assert.equal(text.split(before).length - 1, 1);
    text = text.replace(before, "['fig-16']");
    const prefix = "name.startsWith('resume182-6-n8-')";
    assert.equal(text.split(prefix).length - 1, 1);
    text = text.replace(prefix,
      "(name.startsWith('resume182-6-n8-') || name === 'resume182-6-n7-git-delivery-proof3695')");
    transformations.push('Required figure IDs -> fig-16',
      'Include only the existing uncommitted n7 post-push receipts, no other n7 package');
  }
  write(target, text);
  const command = [process.execPath, '--check', target];
  save(`${own}/${kind}-syntax-start.record`, { command, cwd: repo });
  const result = spawnSync(command[0], command.slice(1), { cwd: repo, encoding: 'utf8' });
  write(`${own}/${kind}-syntax-stdout.txt`, result.stdout ?? '');
  write(`${own}/${kind}-syntax-stderr.txt`, result.stderr ?? '');
  save(`${own}/${kind}-syntax-receipt.record`, {
    command, cwd: repo, returncode: result.status, signal: result.signal,
    error: result.error?.message ?? null,
  });
  assert.equal(result.status, 0, result.stderr);
  assert.equal(sha(fs.readFileSync(source)), sha(original));
  files.push({
    source, sourceSHA: sha(original), target, targetSHA: sha(fs.readFileSync(target)),
    transformations, syntaxCalls: 1, runtimeExecutions: 0,
  });
}
save(`${own}/ready.record`, {
  status: 'DELIVERY_SCRIPTS_PREPARED_NOT_EXECUTED',
  root: repo, book: '8a', lesson: 'alg8-c2-s1-n8', files,
  gitOperations: 0, imageObservations: 0, rendererCalls: 0,
  sourceMathAnswerChoiceFigurePASSReruns: 0, wholeLessonApproval: false,
  priorFailuresAndCostsPreserved: true, unknownHistoricalBytesRecovered: false,
  DBWrites: 0, hostTokens: 'unknown', totalCost: 'unknown', finish: 'review',
});
console.log(JSON.stringify({
  path: `${own}/ready.record`, sha256: sha(fs.readFileSync(`${own}/ready.record`)),
  files: files.length, runtimeExecutions: 0,
}));
