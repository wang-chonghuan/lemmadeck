import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const source = '.tmp/resume182-6-8a-n8-answers3695-FIRST/answers.draft.json';
const comparison = '.tmp/resume182-6-8a-n8-parent-answer-review3695-FIRST/review.record';
const own = '.tmp/resume182-6-8a-n8-answers-wording3695-AFFECTED1';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const read = file => fs.readFileSync(file);
const bind = file => ({ path: path.resolve(file), sha256: sha(read(file)) });
const save = (file, value) => fs.writeFileSync(file,
  `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
const bytes = read(source);
assert.equal(sha(bytes), '0cffe5e0b33898354a3e81437fa22e8278e52dd9eb884eea635aaefaf722d24a');
const review = JSON.parse(read(comparison));
assert.equal(review.status, 'HOLD');
assert.equal(review.mathematicalComparisonStatus, 'PASS');
assert.deepEqual(review.blockingFindings.map(item => item.id), ['answer-display-production-narration']);
assert.ok(!fs.existsSync(own));
const original = JSON.parse(bytes);
const candidate = structuredClone(original);
const changes = [
  ['102', '封存支撑记录中各数对均满足相应的两个方程。', '各数对均满足相应的两个方程。'],
  ['103', '封存支撑记录中这些数对均满足各自的原方程组。', '这些数对均满足各自的原方程组。'],
  ['104', '以下给出具体作图方案和封存支撑中的全部交点。', '具体作法与全部交点如下。'],
  ['104', '\n以上为文字作图方案及封存的精确交点支撑，本次没有实际绘图、渲染或查看图形。', ''],
  ['106', '所列数对没有零分母，并且封存支撑中均满足相应的原倒数方程。', '所列数对均没有零分母且满足相应的原倒数方程。'],
];
for (const [id, before, after] of changes) {
  const answer = candidate.answers.find(item => item.exercise === id);
  assert.equal(answer.displayAnswer.split(before).length - 1, 1);
  answer.displayAnswer = answer.displayAnswer.replace(before, after);
}
const math = text => [...text.matchAll(/\$\$(.+?)\$\$|\$([^$]+?)\$/gs)].map(match => match[1] ?? match[2]);
for (let index = 0; index < candidate.answers.length; index++) {
  const before = original.answers[index], after = candidate.answers[index];
  assert.deepEqual(math(after.displayAnswer), math(before.displayAnswer));
  assert.deepEqual({ ...after, displayAnswer: before.displayAnswer }, before);
  assert.ok(!/封存|本次|渲染/u.test(after.displayAnswer));
}
fs.mkdirSync(own);
save(`${own}/answers.draft.json`, candidate);
save(`${own}/repair.record`, {
  status: 'AFFECTED_NONMATHEMATICAL_DISPLAY_WORDING_READY',
  root: repo, book: '8a', lesson: 'alg8-c2-s1-n8', edition: 'modern-us-neutral',
  source: bind(source), comparison: bind(comparison), candidate: bind(`${own}/answers.draft.json`),
  replacements: changes.map(([exercise, before, after]) => ({ exercise, before, after })),
  mathematicsAndAllOtherFieldsUnchanged: true, internalNotesAndLimitationsUnchanged: true,
  graphicalExecutionClaimed: false, newContentWordingRepairs: 1, mathematicalRepairs: 0,
  newSolvesOrMathematicalReviews: 0, images: 0, validatorCalls: 0,
  independentAffectedWordingApprovalPending: true, wholeLessonApproval: false,
  oldFailuresAndCountsPreserved: true, unknownHistoricalBytesRecovered: false,
  DBWrites: 0, hostTokens: 'unknown', totalCost: 'unknown',
});
console.log(JSON.stringify({ candidate: bind(`${own}/answers.draft.json`), repair: bind(`${own}/repair.record`),
  replacements: changes.length, mathChanged: false }));
