import assert from "node:assert/strict";
import crypto from "node:crypto";
import fs from "node:fs";
import path from "node:path";

const repo = "/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck";
assert.equal(process.cwd(), repo);
const base = path.join(repo, ".tmp/resume182-6-8a-n12-0789");
const raw = path.join(repo, "ssot-resources/soviet10year-textbooks/artifacts/8a");
const candidate = path.join(base, "assembly-RECOVERY1/artifacts/8a");
const lessonId = "alg8-c3-s1-n12";
const read = (p) => fs.readFileSync(path.resolve(repo, p));
const json = (p) => JSON.parse(read(p).toString("utf8"));
const bind = (p) => {
  const bytes = read(p);
  return {
    path: path.resolve(repo, p),
    sha256: crypto.createHash("sha256").update(bytes).digest("hex"),
    bytes: bytes.length,
  };
};
const sameBinding = (p, expected) => {
  const actual = bind(p);
  assert.equal(actual.sha256, expected.sha256, p);
  if (expected.bytes !== undefined) assert.equal(actual.bytes, expected.bytes, p);
  return actual;
};
const bootstrapPath = path.join(base, "bootstrap.record");
const authorPath = path.join(base, "source-author/result.record");
const assemblyPath = path.join(base, "assembly-RECOVERY1/assembly.record");
sameBinding(bootstrapPath, {
  sha256: "857ab7ed5355be13e6f2d41a6a6ac73ff6a049a9b26301fe083a8e406ba9a7df",
});
sameBinding(authorPath, {
  sha256: "abf5d4d49ba90e577c0ce5ec92d881a1bdc6508919222c667e6fd87835c58ea0",
});
sameBinding(assemblyPath, {
  sha256: "a19a936359e2d252c4ca68d42da154a9f484840bbccfb1a56b58f76c1f21c7e8",
});
const bootstrap = json(bootstrapPath);
const author = json(authorPath);
const assembly = json(assemblyPath);
assert.equal(author.status, "SOURCE_AUTHORED_NOT_APPROVED");
const priorPath = bootstrap.reusedPage81.approval.path;
sameBinding(priorPath, bootstrap.reusedPage81.approval);
const prior = json(priorPath);
assert.equal(prior.status, "SOURCE_PASS");
const priorBindings = new Map(prior.bindings.map((b) => [b.path, b]));
for (const file of bootstrap.reusedPage81.files) {
  sameBinding(file.path, file);
  sameBinding(file.path, priorBindings.get(file.path));
}

const bindings = [];
for (let page = 81; page <= 85; page++) {
  for (const name of ["page.md", "page.json", "audit.json"]) {
    bindings.push(bind(path.join(raw, `pages/${String(page).padStart(4, "0")}`, name)));
  }
}
bindings.push(bind(assemblyPath));
for (const name of ["lesson.json", "lesson.md", "exercises.json"]) {
  bindings.push(bind(path.join(candidate, "lessons", lessonId, name)));
}
for (const ext of ["png", "svg"]) {
  bindings.push(bind(path.join(candidate, `figures/tbl-p0081-01.${ext}`)));
}
const page81Work = bootstrap.reusedPage81.sourceWork;
const grid81 = bind(path.join(page81Work, "page.grid.png"));
sameBinding(grid81.path, priorBindings.get(grid81.path));
bindings.push(grid81);
for (const item of author.pages) {
  sameBinding(item.sourceGrid.path, item.sourceGrid);
  bindings.push(bind(item.sourceGrid.path));
}
bindings.push(bind(bootstrapPath), bind(authorPath), bind(priorPath));
const ancestorPath = path.resolve(repo, assembly.reused_ancestor.path);
sameBinding(ancestorPath, assembly.reused_ancestor);
sameBinding(ancestorPath, priorBindings.get(ancestorPath));
bindings.push(bind(ancestorPath));
for (const entry of assembly.entries) {
  sameBinding(entry.source, entry);
  sameBinding(entry.path, entry);
  assert.deepEqual(read(entry.source), read(entry.path), entry.path);
}
const tableSources = ["png", "svg"].map((ext) =>
  bind(path.join(page81Work, `figures/tbl-p0081-01.${ext}`)),
);
for (const source of tableSources) {
  sameBinding(path.join(candidate, "figures", path.basename(source.path)), source);
}

const pages = [];
const stream = [];
const rowExpectations = new Map([[82, 25], [83, 24], [84, 25], [85, 23]]);
for (let page = 81; page <= 85; page++) {
  const tag = String(page).padStart(4, "0");
  const doc = json(path.join(raw, `pages/${tag}/page.json`));
  const audit = json(path.join(raw, `pages/${tag}/audit.json`));
  assert.equal(doc.meta.book, "8a");
  assert.equal(doc.meta.page, page);
  assert.equal(doc.meta.printed_page, page - 7);
  assert.deepEqual(audit.errors, []);
  assert.equal(audit.lines_md, audit.lines_printed);
  if (page !== 81) {
    const md = read(path.join(raw, `pages/${tag}/page.md`)).toString("utf8");
    const header = md.match(/^---\n([\s\S]*?)\n---\n/);
    assert.ok(header, tag);
    assert.deepEqual(JSON.parse(header[1]), doc.meta);
    const body = md.slice(header[0].length);
    const blocks = [...body.matchAll(/<!-- ([^\n]+) -->\n([\s\S]*?)(?=\n<!-- |$)/g)];
    assert.equal(blocks.length, doc.blocks.length, tag);
    for (const [i, match] of blocks.entries()) {
      const actual = match[2].replace(/\n+$/, "").split("\n");
      assert.deepEqual(actual, doc.blocks[i].lines, `p${tag}#${i + 1}`);
      const tokens = match[1].split(" ");
      assert.equal(tokens[0], doc.blocks[i].kind);
      assert.equal(tokens.includes("open"), doc.blocks[i].open);
      assert.equal(tokens.includes("cont"), doc.blocks[i].cont);
      if (tokens[0] === "ex") assert.equal(tokens[1], doc.blocks[i].label);
    }
    assert.deepEqual(doc.meta.figures, []);
    const rows = doc.blocks.reduce((total, b) => total + b.lines.length, 0);
    assert.equal(rows, rowExpectations.get(page));
    assert.equal(audit.lines_md, rows);
    assert.ok(doc.blocks.every((b) => !b.offset_label_row && !b.samerow));
    assert.ok(doc.blocks.every((b) => b.lines.every((line) => !line.includes("\u21b5"))));
    pages.push({
      physical: page,
      printed: page - 7,
      rows,
      blocks: doc.blocks.map((b, i) => ({
        ref: `p${tag}#${i + 1}`,
        kind: b.kind,
        label: b.label,
        rows: b.lines.length,
        open: b.open,
        cont: b.cont,
      })),
      mdJsonExact: true,
      rawAndCandidateByteIdentical: true,
    });
  }
  doc.blocks.forEach((b, i) =>
    stream.push({ ...b, page, printed_page: page - 7, ref: `p${tag}#${i + 1}` }),
  );
}
const start = stream.findIndex((b) => b.ref === "p0081#4");
const end = stream.findIndex((b) => b.ref === "p0085#4");
assert.equal(stream[start].kind, "h3");
assert.equal(stream[end].kind, "h3");
const selected = stream.slice(start, end);
assert.deepEqual(assembly.boundary_refs, { start: "p0081#4", excluded_right: "p0085#4" });
const ancestorDoc = json(ancestorPath);
const ancestors = ancestorDoc.blocks
  .map((b, i) => ({ ...b, ref: `p0074#${i + 1}` }))
  .filter((b) => b.kind === "h1" || b.kind === "h2");
assert.deepEqual(ancestors.map((b) => b.ref), ["p0074#1", "p0074#2"]);
assert.deepEqual(assembly.selected_refs, [...ancestors, ...selected].map((b) => b.ref));

const textOf = (lines) => lines.join("").trim();
const lessonDir = path.join(candidate, "lessons", lessonId);
const lesson = json(path.join(lessonDir, "lesson.json"));
const exercises = json(path.join(lessonDir, "exercises.json"));
assert.equal(lesson.id, lessonId);
assert.equal(lesson.card_id, lessonId);
assert.equal(lesson.chapter, textOf(ancestors[0].lines));
assert.equal(lesson.section, textOf(ancestors[1].lines));
assert.equal(lesson.number, "12");
assert.equal(lesson.title, "\u7ed9\u51fa\u6570\u5217\u7684\u65b9\u6cd5");
assert.equal(lesson.printed_title, textOf(selected[0].lines));
assert.equal(lesson.start_page, 81);
assert.equal(lesson.start_printed, 74);
assert.deepEqual(lesson.figures, [{ id: "tbl-p0081-01", label: "\u8868", page: 81 }]);
const expectedProse = selected.filter((b) => b.kind === "p" || b.kind === "fig").map((b) => ({
  kind: b.kind,
  text: textOf(b.lines),
  id: b.id ?? null,
  label: b.label ?? null,
  printed_page: b.printed_page,
  source_refs: [b.ref],
}));
assert.equal(expectedProse.length, 15);
assert.deepEqual(lesson.prose, expectedProse);

const expectedExercises = [];
let group = null;
let groupId = "g0";
for (const b of selected) {
  if (b.kind === "exhead") {
    group = textOf(b.lines);
    groupId = "g1";
  }
  if (b.kind !== "ex") continue;
  if (b.cont) {
    const previous = expectedExercises.at(-1);
    assert.ok(previous._open);
    assert.equal(previous.number, b.label);
    previous.lines.push(...b.lines);
    previous.pages.push(b.ref);
    previous._open = b.open;
  } else {
    assert.ok(!expectedExercises.at(-1)?._open);
    expectedExercises.push({
      number: b.label,
      source_number: b.label,
      group,
      group_id: groupId,
      lines: [...b.lines],
      pages: [b.ref],
      figure_refs: [],
      figures: [],
      _open: b.open,
    });
  }
}
for (const ex of expectedExercises) {
  assert.ok(!ex._open);
  delete ex._open;
  ex.text = textOf(ex.lines);
}
assert.equal(expectedExercises.length, 14);
assert.deepEqual(expectedExercises.map((ex) => ex.number),
  Array.from({ length: 14 }, (_, i) => String(204 + i)));
assert.equal(exercises.lesson, lessonId);
assert.equal(exercises.count, 14);
assert.equal(lesson.exercise_count, 14);
assert.deepEqual(exercises.exercises, expectedExercises);
assert.deepEqual(expectedExercises.find((ex) => ex.number === "209").pages, ["p0083#6", "p0084#1"]);
assert.deepEqual(expectedExercises.find((ex) => ex.number === "216").pages, ["p0084#8", "p0085#1"]);
assert.equal(expectedExercises.at(-1).group, "\u590d\u4e60\u9898");
assert.ok(expectedExercises.find((ex) => ex.number === "210").text.includes("$c_n=4_n-1$"));
const inequalities = expectedExercises.find((ex) => ex.number === "214").text;
assert.equal((inequalities.match(/\\geqslant/g) ?? []).length, 1);
assert.equal((inequalities.match(/\\leqslant/g) ?? []).length, 3);
const mdParts = [
  `# ${lesson.printed_title}`,
  "",
  `> ${lesson.chapter} \u00b7 ${lesson.section}`,
  "",
];
for (const prose of expectedProse) {
  mdParts.push(prose.kind === "fig"
    ? `![${prose.label}](../../figures/${prose.id}.svg)`
    : prose.text, "");
}
assert.equal(read(path.join(lessonDir, "lesson.md")).toString("utf8"),
  mdParts.join("\n").trimEnd() + "\n");
assert.equal(expectedProse.filter((b) => b.kind === "fig").length, 1);
assert.ok(!lesson.prose.some((p) => p.source_refs.includes("p0085#4")));
assert.ok(!exercises.exercises.some((ex) => ex.number === "202" || ex.number === "203"));

const finalize = [];
for (let page = 82; page <= 85; page++) {
  const stage = path.join(base, `stages/source-finalize${page}-FIRST`);
  const receipt = json(path.join(stage, "receipt.record"));
  assert.equal(receipt.returncode, 0);
  assert.equal(receipt.cwd, repo);
  const stdout = read(path.join(stage, "stdout.txt")).toString("utf8");
  assert.ok(stdout.includes(`${rowExpectations.get(page)} \u884c`));
  finalize.push({
    physical: page,
    receipt: bind(path.join(stage, "receipt.record")),
    stdout: bind(path.join(stage, "stdout.txt")),
    returncode: receipt.returncode,
  });
}
const firstStage = path.join(base, "stages/source-assembly-FIRST");
const recoveryStage = path.join(base, "stages/source-assembly-RECOVERY1");
assert.equal(json(path.join(firstStage, "receipt.record")).returncode, 1);
assert.ok(read(path.join(firstStage, "stderr.txt")).toString("utf8").includes("KeyError: 'page'"));
assert.equal(json(path.join(recoveryStage, "receipt.record")).returncode, 0);

console.log(JSON.stringify({
  status: "MECHANICAL_PASS_NOT_SOURCE_APPROVAL",
  pages,
  assembly: {
    inputsVerified: assembly.entries.length,
    selectedRefs: assembly.selected_refs,
    prose: expectedProse.map((p) => ({ refs: p.source_refs, textExact: true })),
    exercises: expectedExercises.map((ex) => ({
      number: ex.number, refs: ex.pages, lines: ex.lines.length, textExact: true,
    })),
    allProseTextExact: true,
    allExerciseLinesAndTextExact: true,
    lessonMdExact: true,
    boundariesExact: true,
    groupsExact: true,
    noUnclosedN12Object: true,
    tableByteReuseOnly: true,
    tableSources,
    n13RefsExcluded: stream.slice(end).map((b) => b.ref),
    printTypo210Retained: true,
    slantedInequalities214Retained: true,
  },
  finalize,
  retainedFailure: {
    receipt: bind(path.join(firstStage, "receipt.record")),
    stderr: bind(path.join(firstStage, "stderr.txt")),
    implementation: bind(path.join(base, "assemble.FIRST.py.record")),
    returncode: 1,
  },
  recovery: {
    receipt: bind(path.join(recoveryStage, "receipt.record")),
    stdout: bind(path.join(recoveryStage, "stdout.txt")),
    implementation: bind(path.join(base, "assemble.py")),
    returncode: 0,
  },
  sourceImagesByteChecks: [81, 82, 83, 84, 85].map((page) => {
    const tag = String(page).padStart(4, "0");
    const source = page === 81 ? page81Work : path.join(base, `source/8a/pages/${tag}`);
    const actual = bind(path.join(source, "page.png"));
    assert.equal(actual.sha256, json(path.join(raw, `pages/${tag}/page.json`)).meta.render.sha256);
    return actual;
  }),
  bindings,
  verifier: bind(path.join(base, "source-review-FIRST/verify.mjs")),
  imageDecodingByVerifier: 0,
  rawSourceWrites: 0,
  candidateWrites: 0,
  producerInvocations: 0,
}, null, 2));
