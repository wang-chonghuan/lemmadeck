    "const fs=require(\"node:fs\"), crypto=require(\"node:crypto\"), assert=require(\"node:assert/strict\"), p=require(\"node:path\"); const path=p.resolve(\".tmp/resume182-6-8a-n7-observe3695-batch6/result.json\"); const bytes=fs.readFileSync(path); const result=JSON.parse(bytes); const selection=JSON.parse(fs.readFileSync(\".tmp/resume182-6-8a-n7-display3695-FIRST/selection-d-label-affected/batch6.json\",\"utf8\")); assert.equal(result.status,\"DISPLAY_PASS\"); assert.equal(result.book,\"8a\"); assert.equal(result.lesson,\"alg8-c2-s1-n7\"); assert.equal(result.batch,\"batch6\"); assert.equal(result.images.length,8); assert.equal(new Set(result.images.map(image=>image.path)).size,8); assert.deepEqual(result.images.map(image=>image.path),selection.images.map(image=>image.path)); for(const image of result.images){ assert.match(image.sha256,/^[a-f0-9]{64}$/); assert.equal(image.sha256,selection.images.find(assigned=>assigned.path===image.path).sha256); assert.ok(image.observations.length>0); assert.deepEqual(image.blockers,[]); } assert.deepEqual(result.blockers,[]); assert.deepEqual(result.imageAccounting,{views:8,uniqueImages:8,reopens:0,crops:0,resizes:0,rerenders:0}); assert.equal(result.wholeLessonApproval,false); assert.equal(result.hostTokens,\"unknown\"); assert.equal(result.totalCost,\"unknown\"); console.log(JSON.stringify({path,sha256:crypto.createHash(\"sha256\").update(bytes).digest(\"hex\"),status:result.status,blockers:result.blockers.length,imageAccounting:result.imageAccounting,wholeLessonApproval:result.wholeLessonApproval}));"
