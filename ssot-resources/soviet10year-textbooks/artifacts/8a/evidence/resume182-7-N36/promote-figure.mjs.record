import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';

const root = '/Users/yong/work/lemmadeck-ws/lemmadeck--STEMROBIN-182';
assert.equal(process.cwd(), root);
const base = `${root}/.tmp/ld-s10y-lesson/resume182-7-N36`;
const edition = `${root}/ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral`;
const evidence = `${root}/ssot-resources/soviet10year-textbooks/artifacts/8a/evidence/resume182-7-N36`;
const reviewPath = `${base}/figure-review-FIRST/review-FIRST.record`;
const review = JSON.parse(fs.readFileSync(reviewPath));
assert.equal(review.status, 'pass');
assert.equal(review.figures.length, 1);
const figure = review.figures[0];
assert.equal(figure.id, 'fig-83');
assert.equal(figure.status, 'pass');
const sha = file => createHash('sha256').update(fs.readFileSync(file)).digest('hex');
function keep(file, content) {
  const bytes = Buffer.isBuffer(content) ? content : Buffer.from(content);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  if (fs.existsSync(file)) assert.ok(fs.readFileSync(file).equals(bytes), file);
  else fs.writeFileSync(file, bytes, { flag: 'wx' });
}
for (const name of ['source', 'spec', 'svg', 'render', 'preview']) {
  const input = figure.inputs[name];
  assert.ok(input);
  assert.equal(sha(input.path), input.sha256, name);
}
const specFile = `${edition}/figures/fig-83.spec.json`;
const svgFile = `${edition}/figures/fig-83.svg`;
const renderFile = `${edition}/figures/fig-83.render.json`;
const reviewFile = `${edition}/figures/fig-83.review.json`;
const spec = fs.readFileSync(figure.inputs.spec.path);
assert.ok(!spec.toString().includes('.tmp/'));
const render = JSON.parse(fs.readFileSync(figure.inputs.render.path));
assert.equal(render.status, 'pass');
render.spec.path = path.relative(root, specFile);
render.output.svg.path = path.relative(root, svgFile);
keep(specFile, spec);
keep(svgFile, fs.readFileSync(figure.inputs.svg.path));
keep(renderFile, `${JSON.stringify(render, null, 2)}\n`);
keep(`${evidence}/figure-review-FIRST/review-FIRST.record`, fs.readFileSync(reviewPath));
const result = spawnSync('python3', [
  `${root}/.agents/skills/ld-s10y-image/scripts/record_review.py`,
  '--spec', specFile, '--render', renderFile, '--output', reviewFile,
  '--status', 'pass', '--notes',
  `Reuse independent ${path.relative(root, evidence)}/figure-review-FIRST/review-FIRST.record SHA ${sha(reviewPath)}. All seven source inventory groups, the 18x27 grid, point relationships and complete 640px visible labels were independently reviewed. Analytic base and level heights are disclosed modern regularization, not source measurements; no exact scan root coordinate is claimed. Spec/SVG unchanged in promotion; only render paths and this evidence reference are rebound.`,
], { cwd: root, encoding: 'utf8' });
assert.equal(result.status, 0, result.stderr);
const template = `${base}/modern-prepared/adapt/8a/modern-us-neutral/lessons/alg8-c6-s1-n36/figures.template.json`;
const manifest = JSON.parse(fs.readFileSync(template));
assert.deepEqual(manifest.figures.map(item => item.id), ['fig-83']);
Object.assign(manifest.figures[0], {
  mode: 'deterministic',
  svg: 'figures/fig-83.svg',
  render: 'figures/fig-83.render.json',
  review: 'figures/fig-83.review.json',
});
fs.writeFileSync(template, `${JSON.stringify(manifest, null, 2)}\n`);
const promotionName = process.argv[2] || 'figure-promotion';
assert.match(promotionName, /^figure-promotion(?:-[A-Z0-9]+)?$/);
keep(`${base}/${promotionName}.record`, `${JSON.stringify({
  status: 'PASS',
  review: { path: reviewPath, sha256: sha(reviewPath) },
  figure: 'fig-83',
  exitCode: result.status,
  stdout: result.stdout,
  stderr: result.stderr,
  sourceSpecAndSvgChanged: false,
  rerenders: 0,
  repeatedSemanticReviews: 0,
}, null, 2)}\n`);
console.log(JSON.stringify({ status: 'PASS', figure: 'fig-83', metadataOnly: true }));
