        "assertions": [
          "src-exponential-count"
        ]
      },
      {
        "id": "src-positive-level",
        "description": "Solid horizontal y=b (b>0) above the unit height, crossing the exponential at the right. Modern positive height 4.5 preserves the depicted order, not a source numeric value.",
