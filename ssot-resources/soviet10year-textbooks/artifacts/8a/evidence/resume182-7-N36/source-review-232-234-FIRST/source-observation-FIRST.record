      "rows": [
        {"n": 1, "y_approx": 365, "kind": "ex-725", "text": "725. 检验下列等式的正确性："},
        {"n": 2, "y_approx": 515, "kind": "ex-725", "text": "а) $\\log_3 9=2$； б) $\\log_5 125=3$； в) $\\log_{10}\\frac{1}{10}=-1$；"},
        {"n": 3, "y_approx": 710, "kind": "ex-725", "text": "г) $\\log_4 2=\\frac{1}{2}$； д) $\\log_2\\frac{1}{64}=-6$； е) $\\log_{\\frac{1}{3}}81=-4$。"},
        {"n": 4, "y_approx": 856, "kind": "ex-726", "text": "726. 利用对数符号表示下列等式中的幂指数："},
        {"n": 5, "y_approx": 1010, "kind": "ex-726", "text": "а) $2^5=32$； б) $3^{-3}=\\frac{1}{27}$； в) $12^1=12$；"},
        {"n": 6, "y_approx": 1200, "kind": "ex-726", "text": "г) $20^0=1$； д) $25^{\\frac{1}{2}}=5$； е) $8^{-\\frac{1}{3}}=\\frac{1}{2}$。"},
        {"n": 7, "y_approx": 1395, "kind": "ex-727", "text": "727. а) 分别求出 $8$、$32$、$\\frac{1}{4}$、$1$、$0.5$ 以 $2$ 为底的对数。"},
        {"n": 8, "y_approx": 1580, "kind": "ex-727", "text": "б) 分别求出 $3$、$81$、$\\frac{1}{27}$、$1$、$\\frac{1}{243}$ 以 $3$ 为底的对数。"},
        {"n": 9, "y_approx": 1735, "kind": "ex-728", "text": "728. 求值："},
        {"n": 10, "y_approx": 1900, "kind": "ex-728", "text": "а) $\\log_2 4$； б) $\\log_3\\frac{1}{9}$； в) $\\log_{10}0.01$；"},
        {"n": 11, "y_approx": 2090, "kind": "ex-728", "text": "г) $\\log_{\\sqrt{2}}8$； д) $\\log_{\\frac{1}{5}}25$； е) $\\log_{16}\\frac{1}{2}$；"},
        {"n": 12, "y_approx": 2240, "kind": "ex-728", "text": "ж) $\\log_{\\frac{1}{\\sqrt{3}}}27$； з) $\\log_{0.4}6.25$。"},
        {"n": 13, "y_approx": 2410, "kind": "ex-729", "text": "729. 求 $b$，设："},
        {"n": 14, "y_approx": 2545, "kind": "ex-729", "text": "а) $\\log_5 b=2$； б) $\\log_6 b=3$； в) $\\log_{\\frac{1}{2}}b=-1$；"},
        {"n": 15, "y_approx": 2700, "kind": "ex-729", "text": "г) $\\log_{11}b=0$； д) $\\log_{10}b=-2$； е) $\\log_4 b=1.5$。"},
        {"n": 16, "y_approx": 2810, "kind": "ex-730", "text": "730. 下列各式有意义吗？"},
        {"n": 17, "y_approx": 2945, "kind": "ex-730", "text": "а) $\\log_5(-25)$； б) $\\log_3(-7)^2$； в) $\\log_{12}0$；"},
        {"n": 18, "y_approx": 3060, "kind": "ex-730", "text": "г) $\\log_2(-4)^3$； д) $\\log_6(-6)^{-2}$； е) $-\\log_8 16$。"},
        {"n": 19, "y_approx": 3170, "kind": "foot", "text": "226"}
      ],
