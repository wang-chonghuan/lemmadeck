import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { execFileSync } from 'node:child_process';

const root = '/Users/yong/work/lemmadeck-ws/lemmadeck--STEMROBIN-182';
assert.equal(process.cwd(), root);
const target = 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/figures';
const failed = '.tmp/ld-s10y-lesson/resume182-7-N32/figures-contract-failure-FIRST';
assert.ok(!fs.existsSync(failed));
fs.mkdirSync(failed);
for (const number of [74, 75, 76]) {
  const name = `fig-${number}.spec.json`;
  const filename = path.join(target, name);
  fs.copyFileSync(filename, path.join(failed, name), fs.constants.COPYFILE_EXCL);
  const spec = JSON.parse(fs.readFileSync(filename));
  assert.equal(typeof spec.source.authoritativeText, 'string');
  spec.source.authoritativeText = [{ lesson: 'alg8-c5-s1-n32', text: spec.source.authoritativeText }];
  const objects = new Map(spec.objects.map(object => [object.id, object]));
  for (const group of spec.source.inventory) {
    if (!group.id.includes('-curve-')) continue;
    // Source curves have no printed point markers. Hidden vertices construct
    // their strokes; inventory maps the visible strokes, not fictional points.
    group.objects = group.objects.filter(id => objects.get(id).visible !== false);
    delete group.requires;
    group.description += ' Inventory objects are the visible curve strokes and equation label. The hidden vertices referenced by coordinate assertions are renderer construction facts, not extra source point markers.';
  }
  fs.writeFileSync(filename, JSON.stringify(spec, null, 2) + '\n');
  const result = execFileSync('.claude/skills/ld-s10y-lesson/.venv/bin/python', [
    '.agents/skills/ld-s10y-image/scripts/validate_spec.py', filename, '--stage', 'draft',
  ], { cwd: root, maxBuffer: 8 * 1024 * 1024 });
  fs.writeFileSync(path.join(failed, `fig-${number}.recovery-validation.record`), result, { flag: 'wx' });
  console.log(result.toString().trim());
}
