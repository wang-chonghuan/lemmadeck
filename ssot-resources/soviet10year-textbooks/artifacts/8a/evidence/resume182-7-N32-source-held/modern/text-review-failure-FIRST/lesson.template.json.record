    },
    {
      "kind": "p",
      "text": "我们来简单说明，当 $0<a<1$ 时，函数 $y=a^x$（$x\\in R$）的性质。",
      "id": null,
      "label": null,
      "printed_page": 199,
      "source_refs": [
        "p0206#8"
      ],
      "source_text": "我们来简单说明，当 $0<a<1$ 时，函数 $y=a^x$（$x\\in R$）的性质.",
      "changes": [
