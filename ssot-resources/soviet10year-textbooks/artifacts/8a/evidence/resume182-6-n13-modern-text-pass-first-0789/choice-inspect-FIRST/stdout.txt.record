{
  "exercises": [
    {
      "number": "218",
      "text": "218. \u5199\u51fa\u4e0b\u5217\u6570\u5217\u7684\u524d\u51e0\u9879. \u5df2\u77e5\uff1a\na) \u7b2c1\u9879\u7b49\u4e8e4\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u662f\u901a\u8fc7\u628a\u5b83\u7684\u524d\u9762\u4e00\u9879\u52a0\u4e0a12\u5f97\u51fa\uff1b\nb) \u7b2c1\u9879\u7b49\u4e8e8\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u662f\u901a\u8fc7\u628a\u5b83\u7684\u524d\u9762\u4e00\u9879\u4e58\u4ee53\u5f97\u51fa\uff1b\nc) \u6570\u5217\u7684\u7b2c1\u9879\u7b49\u4e8e10\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u662f\u901a\u8fc7\u628a\u5b83\u7684\u524d\u9762\u4e00\u9879\u9664\u4ee52\u5f97\u51fa\uff1b\nd) \u7b2c1\u9879\u7b49\u4e8e1\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u662f\u901a\u8fc7\u7528\u6240\u6c42\u9879\u7684\u5e8f\u53f7\u53bb\u9664\u5b83\u7684\u524d\u9762\u4e00\u9879\u5f97\u51fa.",
      "figure_ids": []
    },
    {
      "number": "219",
      "text": "219. \u6c42\u51fa\u7528\u9012\u63a8\u6cd5\u7ed9\u51fa\u7684\u6570\u5217$(a_n)$\u7684\u524d5\u9879\uff1a\na) $a_1=1,\\quad a_{n+1}=a_n+1$\uff1b\nb) $a_1=7,\\quad a_{n+1}=a_n-3$\uff1b\nc) $a_1=-5,\\quad a_{n+1}=2a_n$\uff1b\nd) $a_1=75,\\quad a_{n+1}=0.1a_n$\uff1b\ne) $a_1=\\frac{1}{6},a_{n+1}=-a_n$\uff1b\nf) $a_1=3,\\quad a_{n+1}=\\frac{1}{a_n}$.",
      "figure_ids": []
    },
    {
      "number": "220",
      "text": "220. \u5199\u51fa\u6570\u5217$(c_n)$\u7684\u524d\u51e0\u9879\uff0c\u8bbe\uff1a\na) $c_1=-1,\\quad c_2=1,\\quad c_{n+2}=c_n+c_{n+1}$\uff1b\nb) $c_1=13,\\quad c_2=6,\\quad c_{n+2}=c_n-c_{n+1}$.",
      "figure_ids": []
    },
    {
      "number": "221",
      "text": "221. \u5199\u51fa\u6570\u5217$(u_n)$\u7684\u524d\u51e0\u9879\u5e76\u4e14\u7528\u901a\u9879\u516c\u5f0f\u7ed9\u51fa\u8fd9\u4e2a\u6570\u5217\uff0c\u8bbe\uff1a\na) $u_1=10,\\quad u_{n+1}=u_n+10$\uff1b\nb) $u_1=10,\\quad u_{n+1}=u_n\\cdot10$\uff1b\nc) $u_1=2,\\quad u_{n+1}=u_n+2$\uff1b\nd) $u_1=2,\\quad u_{n+1}=u_n\\cdot2$.",
      "figure_ids": []
    },
    {
      "number": "222",
      "text": "222. \u89e3\u4e0b\u5217\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}x^2-2y^2=14,\\\\2x-3y=1\\end{cases}$\uff1b\nb) $\\begin{cases}3xy-2y^2=30,\\\\3x-2y=10\\end{cases}$.",
      "figure_ids": []
    }
  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "\u8bbe\u5728\u4e00\u4e2a\u6570\u5217\u91cc\uff0c\u5df2\u77e5\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u7b49\u4e8e\u524d\u9762\u4e00\u9879\u7684\u5e73\u65b9.\n\u8fd9\u79cd\u6570\u5217\u6709\u65e0\u7a77\u591a.\n\u6211\u4eec\u4e3e\u51e0\u4e2a\u4f8b\u5b50\uff1a\n$2,4,16,256,\\cdots$\uff1b\n$1,1,1,1,\\cdots$\uff1b\n$\\frac{1}{3},\\frac{1}{9},\\frac{1}{81},\\frac{1}{6561},\\cdots$."
    },
    {
      "block": 1,
      "text": "\u4e3a\u4e86\u7ed9\u51fa\u5176\u4e2d\u7684\u4e00\u4e2a\u6570\u5217\uff0c\u4f8b\u5982\u6570\u5217$2,4,16,256,\\cdots$\uff0c\u53ea\u8981\u6307\u51fa\u5b83\u7684\u7b2c1\u9879\u5c31\u884c\u4e86.\n\u56e0\u6b64\uff0c\u8fd9\u4e2a\u6570\u5217\u7531\u4e24\u4e2a\u6761\u4ef6\u7ed9\u51fa\uff1a"
    },
    {
      "block": 2,
      "text": "\u7b2c1\u9879\u7b49\u4e8e2\uff1b"
    },
    {
      "block": 3,
      "text": "\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u7b49\u4e8e\u524d\u4e00\u9879\u7684\u5e73\u65b9."
    },
    {
      "block": 4,
      "text": "\u5982\u679c\u6570\u5217\u7528$(a_n)$\u8868\u793a\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u6761\u4ef6\u53ef\u4ee5\u5199\u6210\uff1a\n$a_1=2,\\quad a_{n+1}=a_n^2$."
    },
    {
      "block": 5,
      "text": "\u6211\u4eec\u6765\u8ba8\u8bba\u6570\u5217$(b_n)$\uff0c\u5b83\u7684\u7b2c1\u9879\u7b49\u4e8e1\uff0c\u7b2c2\u9879\u7b49\u4e8e2\uff0c\u4ece\u7b2c3\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u7b49\u4e8e\u524d\u9762\u4e24\u9879\u7684\u548c.\n\u5c31\u662f\uff1a\n$b_1=1,\\quad b_2=2,\\quad b_{n+2}=b_n+b_{n+1}$."
    },
    {
      "block": 6,
      "text": "\u77e5\u9053\u6570\u5217$(b_n)$\u7684\u524d\u4e24\u9879$b_1$\u548c$b_2$\u4ee5\u53ca\u516c\u5f0f$b_{n+2}=b_n+b_{n+1}$\u4ee5\u540e\uff0c\u5c31\u80fd\u591f\u6c42\u51fa\u8fd9\u4e2a\u6570\u5217\u7684\u4efb\u4f55\u4e00\u9879.\n\u4f8b\u5982\uff1a\n$b_3=1+2=3$\uff0c\n$b_4=2+3=5$\uff0c\n$b_5=3+5=8$\uff0c\n\u7b49\u7b49.\u8fd9\u6837\u5c31\u7ed9\u51fa\u4e86\u6570\u5217$(b_n)$."
    },
    {
      "block": 7,
      "text": "\u4ece\u6570\u5217\u7684\u67d0\u4e00\u9879\u8d77\uff0c\u901a\u8fc7\u524d\u9762\u7684\u9879\uff08\u4e00\u9879\u6216\u51e0\u9879\uff09\u8868\u793a\u6570\u5217\u4efb\u4f55\u4e00\u9879\u7684\u516c\u5f0f\u53eb\u505a\u9012\u63a8\u516c\u5f0f."
    },
    {
      "block": 8,
      "text": "\u5728\u7ed9\u51fa\u6570\u5217\u7684\u9012\u63a8\u6cd5\u4e2d\uff0c\u901a\u5e38\u6307\u51fa\uff1a"
    },
    {
      "block": 9,
      "text": "a) \u6570\u5217\u7684\u7b2c1\u9879\uff08\u6216\u524d\u51e0\u9879\uff09\uff0c"
    },
    {
      "block": 10,
      "text": "b) \u6839\u636e\u5df2\u77e5\u7684\u524d\u9762\u7684\u9879\u80fd\u591f\u786e\u5b9a\u6570\u5217\u7684\u4efb\u4f55\u4e00\u9879\u7684\u516c\u5f0f."
    },
    {
      "block": 11,
      "text": "\u4e0b\u9762\uff0c\u6211\u4eec\u518d\u4e3e\u51fa\u4e00\u4e9b\u7528\u9012\u63a8\u6cd5\u7ed9\u51fa\u6570\u5217\u7684\u4f8b\u5b50."
    },
    {
      "block": 12,
      "text": "\u4f8b1 \u5047\u8bbe\u6570\u5217$(c_n)$\u7684\u7b2c1\u9879\u7b49\u4e8e12\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u662f\u901a\u8fc7\u4ece\u5b83\u524d\u9762\u4e00\u9879\u51cf\u53bb5\u5f97\u51fa\uff0c\u4e5f\u5c31\u662f\u8bf4\uff0c$c_1=12,c_{n+1}=c_n-5$.\n\u4e8e\u662f\uff0c$c_2=c_1-5=7$\uff0c$c_3=c_2-5=2$\uff0c$c_4=c_3-5=-3$\u7b49\u7b49."
    },
    {
      "block": 13,
      "text": "\u4f8b2 \u6570\u5217$(d_n)$\u7684\u7b2c1\u9879\u7b49\u4e8e1\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u7b49\u4e8e\u81ea\u8eab\u7684\u5e8f\u53f7\u548c\u524d\u4e00\u9879\u7684\u79ef\uff0c\u4e5f\u5c31\u662f\u8bf4\uff0c$d_1=1,d_{n+1}=d_n(n+1)$.\n\u4e8e\u662f $d_2=d_1\\cdot2=1\\cdot2=2$\uff0c$d_3=d_2\\cdot3=1\\cdot2\\cdot3=6$\uff0c$d_4=d_3\\cdot4=1\\cdot2\\cdot3\\cdot4=24$\uff0c\u7b49\u7b49."
    },
    {
      "block": 14,
      "text": "\u5728\u8fd9\u4e2a\u6570\u5217\u4e2d\uff0c\u7b2c$n$\u9879\u7b49\u4e8e\u4ece1\u5230$n$\u6240\u6709\u81ea\u7136\u6570\u7684\u79ef.\n\u5728\u6570\u5b66\u91cc\uff0c\u6211\u4eec\u7528$n!$\n\uff08\u8bfb\u4f5c\u201c$n$\u7684\u9636\u4e58\u201d\uff09\u8868\u793a\u79ef$1\\cdot2\\cdot3\\cdot\\ldots\\cdot n$.\n\n\u4f8b\u5982\uff0c$1\\cdot2\\cdot3\\cdot4\\cdot5=5!$\n\n\u5229\u7528\u8fd9\u4e2a\u7b26\u53f7\uff0c\u53ef\u4ee5\u628a\u6570\u5217$(d_n)$\u7684\u901a\u9879\u516c\u5f0f\u5199\u6210$d_n=n!$\n\u8fd9\u79cd\u5f62\u5f0f."
    }
  ],
  "figures": []
}
