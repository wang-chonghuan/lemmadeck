      "rationales": [
        {
          "option_id": "A",
          "truth": "correct",
          "derivation": "2乘3与(-2)乘(-3)均等于6，3乘(-4)与(-3)乘4均等于-12；乘积符号确定相应的两支象限，非零常数排除轴上点，倒数关系给出两轴渐近线。",
          "misconception": null
        },
        {
          "option_id": "B",
          "truth": "incorrect",
          "derivation": "分离y时给两式无依据地添负号，误得y=-6/x和y=12/x；代入x=2、-2和x=3、-3，分别得到所列(-3,3)与(4,-4)纵坐标，连同象限一起交换。",
          "misconception": "分离乘积变量时无依据地变号，得到相反的乘积和象限。"
        },
        {
          "option_id": "C",
          "truth": "incorrect",
          "derivation": "把x不等于0错误加强成x大于0，留下第一式(2,3)和第二式(3,-4)，却删去合法的负横坐标解点(-2,-3)与(-3,4)，因而只保留各一支。",
          "misconception": "把分母非零误当分母必须为正，缩小原定义域并漏掉负横坐标分支。"
        },
        {
          "option_id": "D",
          "truth": "incorrect",
          "derivation": "取样时误把标为x的横坐标按x/10代入，仍把结果标在横坐标x处：6/(x/10)=60/x，-12/(x/10)=-120/x。于是x=2、-2得到30、-30，x=3、-3得到-40、40，象限不变但各点的乘积变为60和-120，均不满足原式。",
          "misconception": "取样代入和横坐标标注使用不同尺度，把横坐标缩小十倍计算却仍按原横坐标作点。"
        }
