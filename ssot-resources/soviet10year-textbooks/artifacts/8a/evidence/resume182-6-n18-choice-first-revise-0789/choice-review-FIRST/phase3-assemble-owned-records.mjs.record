import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import assert from "node:assert/strict";

const cwd = "/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck";
assert.equal(process.cwd(), cwd);
const base = path.join(cwd, ".tmp/resume182-6-8a-n18-0789");
const owned = path.join(base, "choice-review-FIRST");
const identity = process.env.CODEX_THREAD_ID;
assert.equal(identity, "01a1fd53-9b80-7e30-af7a-ea3e21789631");
const sha = bytes => crypto.createHash("sha256").update(bytes).digest("hex");
const sorted = value => Array.isArray(value)
  ? value.map(sorted)
  : value !== null && typeof value === "object"
    ? Object.fromEntries(Object.keys(value).sort().map(key => [key, sorted(value[key])]))
    : value;
const canonical = value => JSON.stringify(sorted(value)).replace(
  /[\u007f-\uffff]/g,
  character => "\\u" + character.charCodeAt(0).toString(16).padStart(4, "0")
);
const load = (relative, expected) => {
  const filename = path.join(base, relative);
  const bytes = fs.readFileSync(filename);
  assert.equal(sha(bytes), expected, `Changed permitted input: ${relative}`);
  const value = JSON.parse(bytes);
  return { path: filename, sha256: expected, canonical_sha256: sha(canonical(value)), bytes: bytes.length, value };
};

const phase1 = load("choice-review-FIRST/phase1-source.record", "552d8600bf5c18ede4397291f2168c2e8c67208029bdb7f3c45ff055415a0ce9");
const fidelity = load("choice-review-FIRST/phase2-fidelity.record", "a712436f7aff0a0f3949538bd25d6c4d82f29d02d55c2d1e8fe765e8dbef435f");
const visible = load("choice-review-FIRST/phase2-visible.record", "b1eeaec5f81bc607d5bda2f60d0cebcb689a23319872aa800865d71c8147b094");
const failure = load("choice-review-FIRST/phase2-verification-FIRST.failure.record", "64d320d5c6c1d6b29bc8f3b1738e7752de6f7e524ff5ecdeff4176c69dfcc534");
const projection = load("choice-review-FIRST/views.record", "feaf76195a7397d34729aa0b4430bf61a1725cb3d24eec9af07eb2610784c094");
const draft = load("choices-REVIEW1/draft.json", "bf49a67e3e63fcb53a841c268e7183003b5c8ed522644d65e7b87e3470c73cc3");
const authorFirst = load("choices-FIRST/author/source-solutions-FIRST.record", "3d0025a61b825c1ecc7348a5c8478535613d884e1e32c9d3faf4e90be7bd7f3f");
const authorClarified = load("choices-FIRST/author/source-solutions-FIRST-scope-clarified.record", "6ea0a98bbf9af398d3c17700b383a68dbc12b2b123af933d46a9562742f045ac");
const authorResult = load("choices-FIRST/author/result.record", "bd4155624e7941cf9c0ebfe35b1917555a6934ec4aa573f9b8eab49f550541c2");
assert.equal(draft.canonical_sha256, "e7af72004cbb02d0d9247e17a86d714fee4af45ccdb863c20d5dcf71e02c984e");
assert.equal(draft.value.seed_sha256, phase1.value.input.actual_canonical_sha256);
assert.equal(authorClarified.value.historical_record_preserved.sha256, authorFirst.sha256);
assert.deepEqual(draft.value.new_figures, []);
for (const saved of [phase1, fidelity, visible, failure]) {
  assert.equal(saved.value.reviewer.identity, identity);
}

// These are phase3 checks of the declared wrong procedures, not newly solved keys.
const procedureEvidence = {
  q01: {
    a: "Replacing j-1 by j at all six indices yields 5,21,150,m,m+2,2k+1, exactly the displayed exponent tuple.",
    c: "Replacing each step q by q^2 gives exponent 2(j-1); its six substitutions are 8,40,298,2m-2,2m+2,4k.",
    d: "The declared additive rule x_1+(j-1)q gives exactly all six displayed sums."
  },
  q02: {
    a: "The declared extra-halving formula 256*(1/2)^j gives 32,8,1/4 at indices 3,5,10, and its symbolic component is the same wrong formula.",
    b: "The omitted-halving exponent j-2 gives 128,32,1 at indices 3,5,10 and the displayed n-2 formula.",
    c: "Inverting the ratio to 2 gives 256*2^2=1024, 256*2^4=4096 and 256*2^9=131072, with the matching general formula."
  },
  q03: {
    b: "The extra-factor exponents 7,6,9,7 produce 3/4,8,-1/4,3*sqrt(10), exactly this false tuple.",
    c: "Dropping negative signs before powers changes B from -4 to +4, while C's even power and both positive-ratio cases stay unchanged.",
    d: "The declared n-2 exponents are 5,4,7,5. They produce (3,+2,-1/2,0.3*sqrt(10)), NOT the displayed (3,-2,-1/2,0.3*sqrt(10)). In B, (-2)^4=+16, so (1/8)*(-2)^4=+2. The author's calculation '(1/8)*(-16)=-2' inserts a sign not produced by its declared rule."
  },
  q04: {
    a: "Applying b_n=b_1*q^n yields all four displayed formulas, with initial values 6,-12,125,6 rather than the stated ones.",
    b: "Changing every recurrence to b_(n+1)=b_n+q gives b_1+(n-1)q, exactly the four sums.",
    d: "Moving the minus sign outside (-3)^(n-1) gives -4*3^(n-1) in B, exactly the displayed false formula; the other three remain unchanged."
  },
  q05: {
    a: "The declared two-index quotients are 2^2,3^2,2^2=4,9,4; substituting these into one-index labels gives exactly the false assertions.",
    b: "Leaving numerator outer coefficients uncancelled gives 2,5*3,3*2=2,15,6, exactly the claimed ratios.",
    d: "The declared backward quotients give 1/2,1/3,1/2; keeping the forward quotient labels reproduces the false proof assertions."
  },
  q06: {
    a: "Replacing B's negative ratio by its magnitude gives (32/81)/(32/243)=3; the unchanged A calculation gives 3.",
    c: "Dividing by q^(n-2) gives 384/2^6=6 and (32/81)/(-2/3)^4=2. The even B exponent is positive here, unlike the sign error in q03(d).",
    d: "Dividing by q^n gives 384/2^8=3/2 and (32/81)/(64/729)=9/2."
  },
  q07: {
    a: "Treating a_5 as a first-term anchor yields target-index-minus-one exponents 6,15,39.",
    b: "Counting j-5+1 rather than j-5 gives the displayed exponents 3,12,36.",
    c: "Using a_j=a_5+(j-5)q gives precisely the three displayed additive expressions."
  },
  q08: {
    a: "Principal positive roots alone omit -2 in B and -3/5 in C and give exactly the displayed incomplete four-set tuple.",
    b: "Appending both signs to every extracted root gives {-2,2} in A and {-3,3} in D as displayed, adding invalid odd-power roots.",
    c: "Replacing q^2=9/25 with |q|=9/25 gives +/-9/25 in C instead of taking square roots, exactly the displayed false set."
  },
  q09: {
    a: "Using +3 in both anchored powers gives 13*3^2=117 and 13*3^5=3159.",
    b: "The declared additive offsets give 13+2*(-3)=7 and 13+5*(-3)=-2.",
    d: "Adding one to each gap gives powers 3 and 6 and the displayed values -351 and 9477."
  },
  q10: {
    a: "Subtracting an extra 1 from the gap 8-5 gives exponent 2 and 27*3^2=243.",
    c: "Reversing c_5/c_4 gives ratio 1/3 and 27*(1/3)^3=1.",
    d: "The declared arithmetic difference is 27-9=18; 27+3*18=81, exactly this false scalar alternative."
  },
  q11: {
    a: "Reporting the solved transition counts 4,6,4,3 directly yields the displayed indices instead of adding 1.",
    b: "Adding 2 to transition counts 4,6,4,3 yields 6,8,6,5.",
    d: "Counting 640->160 as one halving, then 160->80->40->20->10 as four more, yields five counted transitions and index 6 in B. Keeping the other indices gives (5,6,5,4)."
  },
  q12: {
    b: "Using a two-step endpoint equation q^2=16 and its positive root 4 generates the three offered inserted terms 4,16,64, with a wrong next endpoint 256.",
    d: "Arithmetic interpolation difference (16-1)/4=15/4 generates exactly 19/4,17/2,49/4."
  },
  q13: {
    a: "Negating every positive inserted magnitude produces -30,-15,-15/2,-15/4,-15/8 exactly; the first two ratios change from -1/2 to +1/2.",
    c: "The reversed endpoint quotient 60/(15/16)=64 gives positive q=2 and the displayed five terms 120,240,480,960,1920."
  },
  q14: {
    a: "Reporting the solved powers 7 and 6 as indices gives (7,6).",
    c: "Adding 2 rather than 1 to powers 7 and 6 yields (9,8).",
    d: "Treating the second printed term 640 as the new index-1 anchor gives 640*(1/2)^(n-1)=20 and n=6; retaining A gives (8,6)."
  },
  q15: {
    a: "Four fixed interests of 1000*0.02=20 give 1000+4*20=1080, exactly 1000*(1+4*0.02).",
    b: "Counting an extra initial-time interest event gives five factors, exactly 1000*(1.02)^5.",
    d: "Mistaking elapsed year 4 for sequence term 4 with the initial balance as term 1 gives three factors, exactly 1000*(1.02)^3."
  },
  q16: {
    a: "One doubling per hour incorrectly gives exponent 10 and 2^10=1024.",
    b: "Treating twenty elapsed periods as term 20 and subtracting 1 gives 2^19=524288.",
    c: "Multiplying the twenty-period count by the multiplier 2 gives 40 rather than iterating the multiplication."
  },
  q17: {
    b: "Fixed yearly additions of 200000*0.1 give 200000*(1+6*0.1)=320000.",
    c: "Subtracting 1 from six elapsed years gives five factors and 200000*1.1^5=322102.",
    d: "Adding an initial-state growth event gives seven factors and 200000*1.1^7=389743.42."
  },
  q18: {
    a: "Adding division exponents gives (4n+7)+(3n+5)=7n+12 and 3(4n-1)+4(3n-1)=24n-7; the correctly retained coefficients reproduce both displayed false expressions.",
    b: "Reversing y-power order gives 3-2=1, and reversing the remaining 5-power quotient gives 5^(6-4)=25; keeping other exponents gives (-2*x^(n+2)*y,25*a).",
    d: "Reversing only B's variable exponent subtraction gives 4(3n-1)-3(4n-1)=-1; with the retained 1/25 coefficient this is 1/(25*a)."
  },
  q19: {
    a: "Using a quotient exponent rule on a difference gives 4^(n-(n-2))=16 and 3^(2n-(2n-1))=3.",
    b: "Attaching the coefficient 16-1=15 to the wrong common factor 4^(n-1) gives exactly its first component; the second is unchanged.",
    c: "Using the wrong residual multiplier 9 with the extracted 3^(2n-1) gives coefficient 9-1=8, exactly its second component."
  },
  q20: {
    a: "Retaining residual coefficient 9-1=8 but attaching the larger factor 3^(2n+1) gives 8*3^(2n+1)/(4*3^n)=2*3^(n+1).",
    c: "Retaining residual coefficient 9-7=2 but attaching 9^n gives 2*9^n/8=9^n/4.",
    d: "Inverting only the numeric quotient 8/4 to 4/8 gives (1/2)*3^(n-1), exactly the second displayed component."
  },
  q21: {
    b: "Replacing target-3 discriminant -39 by its absolute value 39 and applying the quadratic formula gives (5+/-sqrt(39))/8 exactly, while preserving the target-6 set.",
    c: "Keeping only the plus-sign target-6 root (5+3)/8=1 and dropping (5-3)/8=1/4 gives the displayed incomplete set.",
    d: "Using b^2+4ac for target 6 gives 25+16=41 and roots (5+/-sqrt(41))/8 exactly."
  }
};

const finding = {
  id: "Q03_D_MISCONCEPTION_DERIVATION_SIGN",
  verdict: "revise",
  question_id: "q03",
  option_id: "d",
  source_number: "280",
  file: draft.path,
  rationale_pointer: "/questions/2/key/rationales/3",
  option_pointer: "/questions/2/view/options/3/text",
  evidence: procedureEvidence.q03.d,
  effect: "The false option does not result from the declared mistaken procedure. The author also states a false even-power evaluation. Correct set {a} and all four option-truth classifications remain unchanged.",
  required_repair: "Make the affected rationale/misconception and displayed tuple agree using a reproducible wrong procedure, or revise the affected option consistently. Obtain an affected-unit review of the changed hash-bound draft. The reviewer has not edited the candidate."
};
assert.equal(0.125 * (-2) ** 4, 2);

const questionComparisons = [];
const questionReviews = [];
let trueMatches = 0;
let correctRationales = 0;
let wrongProcedures = 0;
let procedurePasses = 0;
for (const question of draft.value.questions) {
  const savedView = projection.value.questions.find(item => item.id === question.id);
  const savedMath = visible.value.question_reviews.find(item => item.question_id === question.id);
  const savedFidelity = fidelity.value.question_reviews.find(item => item.question_id === question.id);
  assert.deepEqual(question.view, savedView.view);
  assert.deepEqual(question.source_numbers, savedView.source_numbers);
  assert.deepEqual(question.key.correct, savedMath.correct);
  assert.deepEqual(question.key.rationales.map(item => item.option_id), savedMath.option_checks.map(item => item.option_id));
  assert.equal(question.source_numbers.length, 1);
  const source = question.source_numbers[0];
  const original = source === "294"
    ? authorClarified.value
    : authorFirst.value.solutions.find(item => item.source_number === source);
  assert.equal(question.intent.source_solution, original.derivation);
  assert.ok(question.intent.task.trim());
  assert.ok(question.intent.unit_reason.trim());
  assert.ok(question.intent.limitations.length);
  assert.deepEqual(question.intent.figure_observations, []);
  assert.ok(question.intent.concept_blocks.every(block => phase1.value.input.selected_concept_blocks.includes(block)));

  const misconceptionChecks = [];
  const correctChecks = [];
  for (const rationale of question.key.rationales) {
    const independent = savedMath.option_checks.find(item => item.option_id === rationale.option_id);
    assert.equal(rationale.truth, independent.truth);
    trueMatches++;
    if (rationale.truth === "correct") {
      assert.equal(rationale.misconception, null);
      correctRationales++;
      correctChecks.push({
        option_id: rationale.option_id,
        verdict: "pass",
        author_derivation: rationale.derivation,
        independent_evidence: independent.evidence,
        comparison: "The correct rationale agrees with the frozen independently solved source and visible question; no key-derived substitution was made."
      });
    } else {
      wrongProcedures++;
      const evidence = procedureEvidence[question.id][rationale.option_id];
      assert.ok(evidence, `Unexamined wrong procedure: ${question.id}/${rationale.option_id}`);
      const needsRevision = question.id === "q03" && rationale.option_id === "d";
      if (!needsRevision) procedurePasses++;
      misconceptionChecks.push({
        option_id: rationale.option_id,
        truth_matches_independent_review: true,
        author_misconception: rationale.misconception,
        author_derivation: rationale.derivation,
        verdict: needsRevision ? "revise" : "pass",
        independent_wrong_procedure_evidence: evidence,
        false_option_evidence: independent.evidence
      });
    }
  }
  assert.deepEqual(
    Object.keys(procedureEvidence[question.id]).sort(),
    misconceptionChecks.map(item => item.option_id).sort()
  );
  questionComparisons.push({
    question_id: question.id,
    source_numbers: question.source_numbers,
    view_matches_phase2_snapshot: true,
    independent_correct: savedMath.correct,
    author_correct: question.key.correct,
    all_option_truths_match: true,
    source_solution_matches_pre_options_record_exactly: true,
    source_solution_record: source === "294" ? authorClarified.path : authorFirst.path,
    intent_review: {
      verdict: "pass",
      author_task: question.intent.task,
      author_unit_reason: question.intent.unit_reason,
      author_limitations: question.intent.limitations,
      evidence: savedFidelity.task_fidelity.evidence,
      unit_and_losses_comparison: "The stated response unit matches the source boundaries judged in phase2. The author's production-loss disclosure agrees with the saved recognition limitation; no essential source task is silently omitted."
    },
    correct_rationale_checks: correctChecks,
    misconception_checks: misconceptionChecks
  });
  const checks = savedMath.option_checks.map(item => ({ ...item }));
  if (question.id === "q03") {
    checks.find(item => item.option_id === "d").evidence =
      "The displayed tuple (3,-2,-1/2,0.3*sqrt(10)) is false for the requested terms. Its declared n-2 procedure actually gives (3,+2,-1/2,0.3*sqrt(10)), because (1/8)*(-2)^4=+2. Therefore this false option is not produced by the declared misconception; the author rationale's inserted negative sign requires revision. The independent correct set remains {a}.";
  }
  questionReviews.push({
    question_id: question.id,
    task_fidelity: { ...savedFidelity.task_fidelity },
    redundancy: { ...savedFidelity.redundancy },
    answer_leakage: { ...savedFidelity.answer_leakage },
    mathematics: {
      verdict: question.id === "q03" ? "revise" : "pass",
      independent_solution: savedMath.independent_solution,
      correct: [...savedMath.correct],
      option_checks: checks
    }
  });
}
assert.equal(trueMatches, 84);
assert.equal(correctRationales, 23);
assert.equal(wrongProcedures, 61);
assert.equal(procedurePasses, 60);
assert.equal(questionReviews.length, 21);

const coverageComparisons = [];
const sourceReviews = phase1.value.source_reviews.map(source => {
  const savedCoverage = visible.value.source_coverage.find(item => item.source_number === source.source_number);
  const authorCoverage = draft.value.coverage.find(item => item.source_number === source.source_number);
  assert.deepEqual(authorCoverage.question_ids, savedCoverage.question_ids);
  assert.ok(authorCoverage.omitted_tasks.length);
  assert.ok(authorCoverage.reason.trim());
  coverageComparisons.push({
    source_number: source.source_number,
    question_ids: savedCoverage.question_ids,
    verdict: "pass",
    independent_coverage: savedCoverage.coverage,
    independent_production_losses: savedCoverage.production_losses,
    author_omitted_tasks: authorCoverage.omitted_tasks,
    author_reason: authorCoverage.reason,
    evidence: "The exact source-to-question relationship matches phase2 and the author's disclosed production loss agrees with the saved loss. No essential source subtask is missing."
  });
  return {
    source_number: source.source_number,
    independent_solution: source.independent_solution,
    coverage: {
      verdict: "pass",
      evidence: savedCoverage.coverage + " Production loss: " + savedCoverage.production_losses.join(" ") +
        " The draft's exact question mapping and author loss disclosure agree; no essential source omission is found."
    }
  };
});
assert.equal(sourceReviews.length, 20);
assert.equal(draft.value.coverage.length, 20);

const review = {
  schema: "s10y-choice-review-v1",
  seed_sha256: phase1.value.input.actual_canonical_sha256,
  draft_sha256: draft.canonical_sha256,
  reviewer: { kind: "independent_agent", identity },
  source_reviews: sourceReviews,
  figure_checks: [],
  new_figure_reviews: [],
  question_reviews: questionReviews,
  outcome: "revise"
};

const exactFields = (object, fields) => assert.deepEqual(Object.keys(object).sort(), [...fields].sort());
exactFields(review, ["schema", "seed_sha256", "draft_sha256", "reviewer", "source_reviews", "figure_checks", "new_figure_reviews", "question_reviews", "outcome"]);
exactFields(review.reviewer, ["kind", "identity"]);
for (const source of review.source_reviews) {
  exactFields(source, ["source_number", "independent_solution", "coverage"]);
  exactFields(source.coverage, ["verdict", "evidence"]);
}
for (const question of review.question_reviews) {
  exactFields(question, ["question_id", "task_fidelity", "redundancy", "answer_leakage", "mathematics"]);
  for (const field of ["task_fidelity", "redundancy", "answer_leakage"]) {
    exactFields(question[field], ["verdict", "evidence"]);
  }
  exactFields(question.mathematics, ["verdict", "independent_solution", "correct", "option_checks"]);
  for (const option of question.mathematics.option_checks) {
    exactFields(option, ["option_id", "truth", "evidence"]);
  }
}

const binding = record => ({
  path: record.path,
  actual_file_sha256: record.sha256,
  canonical_sha256: record.canonical_sha256,
  bytes: record.bytes
});
const reviewPath = path.join(owned, "review.record");
const comparisonPath = path.join(owned, "comparison.record");
assert.ok(!fs.existsSync(reviewPath), "Preserve an existing review instead of overwriting it");
assert.ok(!fs.existsSync(comparisonPath), "Preserve an existing comparison instead of overwriting it");
const reviewBytes = Buffer.from(JSON.stringify(review, null, 2) + "\n");
const reviewHash = sha(reviewBytes);
const comparison = {
  schema: "s10y-choice-phase3-comparison-record-v1",
  status: "PHASE3_COMPARISON_COMPLETE_REVISE_NOT_APPROVED",
  outcome: "revise",
  cwd,
  reviewer: { kind: "independent_agent", identity, identity_source: "Actual CODEX_THREAD_ID" },
  order_and_bytehash_proof: {
    phase1_source_before_visible_options: {
      ...binding(phase1),
      source_input: phase1.value.input,
      status: phase1.value.status,
      independence: "All 20 solutions were recorded by this reviewer before visible options or author material were disclosed."
    },
    phase2_visible_projection_before_author_disclosure: binding(projection),
    phase2_fidelity_saved_before_option_calculations: { ...binding(fidelity), status: fidelity.value.status },
    phase2_complete_independent_true_sets_before_author_disclosure: { ...binding(visible), status: visible.value.status },
    phase3_first_author_disclosure: {
      draft: binding(draft),
      author_source_first: binding(authorFirst),
      author_scope_clarified: binding(authorClarified),
      author_result: binding(authorResult)
    },
    evidence_limit: "Byte hashes bind exact snapshots, not chronology by themselves. Ordering is supported by this chat's staged authorizations and tool sequence, and by the frozen phase records. No author material was opened until the current phase3 authorization.",
    earlier_record_bytes_unchanged: true,
    draft_view_equals_pre_author_phase2_projection: true,
    seed_reopened_or_source_approval_repeated: false
  },
  review: {
    path: reviewPath,
    actual_file_sha256: reviewHash,
    canonical_sha256: sha(canonical(review)),
    contract: "Exact s10y-choice-review-v1 fields only",
    outcome: review.outcome
  },
  aggregate_comparison: {
    question_keys_compared: 21,
    key_mismatches: 0,
    independent_option_truths_compared: 84,
    truth_label_mismatches: 0,
    correct_rationales_consistent: 23,
    declared_incorrect_misconceptions_checked: 61,
    reproducible_false_option_procedures: 60,
    defective_wrong_procedures: 1,
    exact_pre_options_source_solution_matches: 21,
    full_source_coverage_entries_compared: 20,
    fidelity_redundancy_leakage_verdicts_reused: 63,
    rationale_agreement_is_not_implied_by_key_agreement: true
  },
  findings: [finding],
  prior_diagnostic_correction_without_rewriting: {
    record: binding(visible),
    location: "question_reviews[q03].option_checks[d].evidence",
    earlier_statement: "Its components are produced one multiplication too early: 3,-2,-1/2,0.3*sqrt(10).",
    correction: "Only the B component of that diagnostic procedure description is wrong: one multiplication too early gives +2, not -2. The original option d is still false and the independent correct set {a} is unchanged. The final review records the targeted phase3 correction; the phase2 bytes are preserved.",
    scope: "Affected misconception/sign derivation only; no source or all-option pass was rerun."
  },
  per_question_comparisons: questionComparisons,
  coverage_and_loss_comparisons: coverageComparisons,
  package_cross_question_relationships: visible.value.package_cross_question_relationships,
  source294_scope_comparison: {
    original_author_block_preserved: binding(authorFirst),
    pre_options_resolution_preserved: binding(authorClarified),
    original_scope_error: "The first author record elevated complete n-independent domain enumeration to an extra required source task and blocked it.",
    resolution: "The authorized pre-options clarification retains only the two conditional original-domain simplification identities. Those agree with the reviewer's already recorded phase1 and phase2 solutions. No range for n or broader simplified-expression domain is introduced.",
    remaining_unspecified_parameter_range: "Not a required source answer and not a review blocker.",
    upstream_source_status_claims: "Observed only in allowed author records; not adopted as a new source/text/pixel approval."
  },
  first_failed_checker_preservation: {
    separate_first_failure: binding(failure),
    inline_failure_in_visible_record: binding(visible),
    exit_code: failure.value.first_failure.exit_code,
    failed_assertion: failure.value.first_failure.failed_assertion,
    actual_error: failure.value.first_failure.actual_error_excerpt_verbatim,
    technical_recovery: failure.value.technical_repair,
    count_reset: false,
    first_failure_erased: false,
    unrelated_q03_content_failure_does_not_replace_technical_failure: true
  },
  author_result_comparison: {
    binding: binding(authorResult),
    source_and_draft_metadata_hashes_agree_with_actual_allowed_files: true,
    stated_21_questions_84_options_20_sources_agree: true,
    author_claim_every_misconception_reproduces_option: "Disproved for q03(d).",
    reported_prior_structural_success: "Author result reports one prior native structural execution; its receipt paths were not followed and that report does not settle semantic truth or this defect.",
    source_solution_and_production_loss_metadata_agree: true
  },
  boundaries_and_usage: {
    images_opened: 0,
    figure_checks: 0,
    new_figure_reviews: 0,
    database_accesses: 0,
    git_operations: 0,
    app_operations: 0,
    other_chat_accesses: 0,
    dependencies_changed: false,
    skills_changed: false,
    author_or_candidate_writes: false,
    source_or_full_option_recalculation_passes: 0,
    native_validator_executions: 0,
    native_retain_or_publish_executions: 0,
    earlier_phases_and_failures_unchanged: true,
    final_choice_approval: false,
    writes_owned_only: [
      path.join(owned, "phase3-assemble-owned-records.mjs"),
      reviewPath,
      comparisonPath
    ]
  },
  stop: "Phase3 comparison complete with revise. No candidate repair, native validator or retention was performed. Parent owns the affected repair, binding and closure."
};

// Generate only new reviewer artifacts; never overwrite prior evidence or inputs.
fs.writeFileSync(reviewPath, reviewBytes, { flag: "wx" });
const comparisonBytes = Buffer.from(JSON.stringify(comparison, null, 2) + "\n");
fs.writeFileSync(comparisonPath, comparisonBytes, { flag: "wx" });
for (const record of [phase1, fidelity, visible, failure, projection, draft, authorFirst, authorClarified, authorResult]) {
  assert.equal(sha(fs.readFileSync(record.path)), record.sha256, "Input changed during reviewer assembly");
}
assert.equal(sha(fs.readFileSync(reviewPath)), reviewHash);
assert.equal(JSON.parse(fs.readFileSync(comparisonPath, "utf8")).review.actual_file_sha256, reviewHash);
console.log(JSON.stringify({
  review_path: reviewPath,
  review_actual_file_sha256: reviewHash,
  review_canonical_sha256: sha(canonical(review)),
  outcome: review.outcome,
  comparison_path: comparisonPath,
  comparison_actual_file_sha256: sha(comparisonBytes),
  findings: [finding],
  counts: { sources: 20, questions: 21, options: 84, misconceptions: 61, reproducible: 60, revise: 1 },
  prior_bytes_preserved: true,
  native_validator_run: false
}, null, 2));
