24.\\end{cases}$","figure_ids":[],"options":[{"id":"A","text":"$\\{(\\frac{\\sqrt{15}+9}2,\\frac{\\sqrt{15}-9}2),(\\frac{\\sqrt{15}-9}2,\\frac{\\sqrt{15}+9}2),(\\frac{-\\sqrt{15}+9}2,\\frac{-\\sqrt{15}-9}2),(\\frac{-\\sqrt{15}-9}2,\\frac{-\\sqrt{15}+9}2)\\}$。","figure_ids":[]},{"id":"B","text":"$\\varnothing$。","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"以下哪些陈述给出了相应实数方程组的完整解集？","figure_ids":[],"options":[{"id":"A","text":"$\\begin{cases}x^2+y^2=40,\\\\xy=-12\\end{cases}$ 的解集为 $\\{(6,-2),(-2,6)\\}$。","figure_ids":[]},{"id":"B","text":"$\\begin{cases}x^2+y^2=80,\\\\xy=24\\end{cases}$ 的解集为 $\\{(6\\sqrt2,2\\sqrt2),(2\\sqrt2,6\\sqrt2),(-6\\sqrt2,-2\\sqrt2),(-2\\sqrt2,-6\\sqrt2)\\}$。","figure_ids":[]},{"id":"C","text":"$\\begin{cases}x^2+y^2=15,\\\\xy=6\\end{cases}$ 的解集为 $\\{(6,3),(3,6),(-6,-3),(-3,-6)\\}$。","figure_ids":[]},{"id":"D","text":"$\\begin{cases}x^2+y^2=40,\\\\xy=-12\\end{cases}$ 的解集为 $\\{(6,-2),(-2,6),(2,-6),(-6,2)\\}$。","figure_ids":[]},{"id":"E","text":"$\\begin{cases}x^2+y^2=80,\\\\xy=24\\end{cases}$ 的解集为 $\\{(6\\sqrt2,-2\\sqrt2),(2\\sqrt2,-6\\sqrt2),(-6\\sqrt2,2\\sqrt2),(-2\\sqrt2,6\\sqrt2)\\}$。","figure_ids":[]},{"id":"F","text":"$\\begin{cases}x^2+y^2=15,\\\\xy=6\\end{cases}$ 的解集为 $\\{(2\\sqrt3,\\sqrt3),(\\sqrt3,2\\sqrt3),(-2\\sqrt3,-\\sqrt3),(-\\sqrt3,-2\\sqrt3)\\}$。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"在实数范围内，方程组的解是什么？$\\begin{cases}x^2-3xy+y^2+x+2y=8,\\\\2x-5y=-1,\\\\3y-x=2.\\end{cases}$","figure_ids":[],"options":[{"id":"A","text":"没有解。","figure_ids":[]},{"id":"B","text":"恰有一个解 $(7,3)$。","figure_ids":[]},{"id":"C","text":"恰有一个解 $(3,7)$。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"方程 $\\frac{x}{2}-\\frac{y}{3}=1$、$x^2+xy-2y^2-x+y=5$、$x+y=7$ 的三个图像是否有共同点？","figure_ids":[],"options":[{"id":"A","text":"没有共同点。","figure_ids":[]},{"id":"B","text":"唯一共同点是 $(4,3)$。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"求实数方程组 $x^2-4y^2=0,\\ x^2+xy-y^2=20$ 的完整解集。坐标按 $(x,y)$ 排列。","figure_ids":[],"options":[{"id":"A","text":"$\\{(4,2),(-4,-2)\\}$","figure_ids":[]},{"id":"B","text":"$\\{(4,2),(-4,-2),(-4\\sqrt5,2\\sqrt5),(4\\sqrt5,-2\\sqrt5)\\}$","figure_ids":[]},{"id":"C","text":"$\\{(4,2),(-4,-2),(4\\sqrt5,2\\sqrt5),(-4\\sqrt5,-2\\sqrt5)\\}$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"求实数方程组 $4x^2-9y^2=0,\\ x^2-xy-y^2=-1$ 的完整解集。","figure_ids":[],"options":[{"id":"A","text":"$\\{(3,2),(-3,-2),(-3,2),(3,-2)\\}$","figure_ids":[]},{"id":"B","text":"$\\{(3,2)\\}$","figure_ids":[]},{"id":"C","text":"$\\{(3,2),(-3,-2)\\}$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"求实数方程组 $x^2y^2+xy=72,\\ x+y=6$ 的完整解集。","figure_ids":[],"options":[{"id":"A","text":"$\\{(2,4),(4,2),(3+3\\sqrt2,3-3\\sqrt2),(3-3\\sqrt2,3+3\\sqrt2)\\}$","figure_ids":[]},{"id":"B","text":"$\\{(2,4),(4,2)\\}$","figure_ids":[]},{"id":"C","text":"$\\{(3,3),(3+\\sqrt{17},3-\\sqrt{17}),(3-\\sqrt{17},3+\\sqrt{17})\\}$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"求实数方程组 $(x+y)^2-2(x+y)=15,\\ x+xy+y=11$ 的完整解集。","figure_ids":[],"options":[{"id":"A","text":"$\\{(2,3)\\}$","figure_ids":[]},{"id":"B","text":"$\\{(2,3),(3,2),((-3+\\sqrt{47})/2,(-3-\\sqrt{47})/2),((-3-\\sqrt{47})/2,(-3+\\sqrt{47})/2)\\}$","figure_ids":[]},{"id":"C","text":"$\\{(2,3),(3,2)\\}$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"原分数分子为 $m$、分母为 $n$。分子加1、分母加3后等于 $1/2$；分子减1、分母加1后，所得分数与原分数的积等于 $1/5$。求原来的 $(m,n)$。","figure_ids":[],"options":[{"id":"A","text":"$(m,n)=(3,5)$","figure_ids":[]},{"id":"B","text":"$(m,n)=(0,-1)$","figure_ids":[]},{"id":"C","text":"$(m,n)=(5,3)$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"原分数的分子为 $m$、分母为 $n$。分子加2、分母加3后值不变；分子加1、分母加6后比原值小 $1/6$。原来的 $(m,n)$ 是什么？","figure_ids":[],"options":[{"id":"A","text":"$(m,n)=(2,3)$","figure_ids":[]},{"id":"B","text":"$(m,n)=(8,12)$","figure_ids":[]},{"id":"C","text":"$(m,n)=(-16,-24)$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"矩形的对角线为 $17\\ \\mathrm{dm}$，面积为 $120\\ \\mathrm{dm}^2$。它的两条不同方向的边长是多少？","figure_ids":[],"options":[{"id":"A","text":"$\\sqrt{120}\\ \\mathrm{dm}$ 和 $\\sqrt{120}\\ \\mathrm{dm}$","figure_ids":[]},{"id":"B","text":"$17\\ \\mathrm{dm}$ 和 $120/17\\ \\mathrm{dm}$","figure_ids":[]},{"id":"C","text":"$8\\ \\mathrm{dm}$ 和 $15\\ \\mathrm{dm}$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"直角三角形斜边为 $26\\ \\mathrm{cm}$，面积为 $120\\ \\mathrm{cm}^2$。求周长。","figure_ids":[],"options":[{"id":"A","text":"$60\\ \\mathrm{cm}$","figure_ids":[]},{"id":"B","text":"$(26+2\\sqrt{229})\\ \\mathrm{cm}$","figure_ids":[]},{"id":"C","text":"$34\\ \\mathrm{cm}$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"直角三角形原斜边为 $13\\ \\mathrm{m}$。两条直角边各增加 $3\\ \\mathrm{m}$ 后，斜边增加 $4\\ \\mathrm{m}$。面积增加多少？","figure_ids":[],"options":[{"id":"A","text":"$60\\ \\mathrm{m}^2$","figure_ids":[]},{"id":"B","text":"$30\\ \\mathrm{m}^2$","figure_ids":[]},{"id":"C","text":"$25.5\\ \\mathrm{m}^2$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"两个直角三角形斜边分别为 $29\\ \\mathrm{dm}$ 和 $5\\ \\mathrm{dm}$。大三角形每条直角边比小三角形对应边长 $17\\ \\mathrm{dm}$。两者面积相差多少？","figure_ids":[],"options":[{"id":"A","text":"$59.5\\ \\mathrm{dm}^2$","figure_ids":[]},{"id":"B","text":"$408\\ \\mathrm{dm}^2$","figure_ids":[]},{"id":"C","text":"$204\\ \\mathrm{dm}^2$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"两台联合收割机一起工作，20小时收完一块地。第二台收完 $1/3$ 块地比第一台收完 $1/2$ 块地快3小时。单独收完整块地所需时间按（第一台，第二台）排列，哪一项成立？","figure_ids":[],"options":[{"id":"A","text":"$(45,36)$ 小时","figure_ids":[]},{"id":"B","text":"$(36,45)$ 小时","figure_ids":[]},{"id":"C","text":"$(10/3,-4)$ 小时","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"两根水管同时放水，40小时灌满水池。先用第一根灌 $1/3$ 池，再用第二根灌其余部分，总共78小时。选择所有可能的单独灌满时间，按（第一根，第二根）排列，单位为小时。","figure_ids":[],"options":[{"id":"A","text":"$(90,72)$","figure_ids":[]},{"id":"B","text":"$(65,104)$","figure_ids":[]},{"id":"C","text":"$(104,65)$","figure_ids":[]},{"id":"D","text":"$(72,90)$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"公共汽车从A出发半小时后，摩托车从B相向出发。摩托车相遇后1小时到A，比公共汽车到B早半小时。AB相距90千米。选择（公共汽车速度，摩托车速度），单位为千米/小时。","figure_ids":[],"options":[{"id":"A","text":"$(45,30)$","figure_ids":[]},{"id":"B","text":"$(36,54)$","figure_ids":[]},{"id":"C","text":"$(30,45)$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"第一位旅行者从A出发1小时后，第二位从B相向出发。相遇前第二位比第一位少走2千米；第二位到A比第一位到B早6分钟。相遇后第一位又走2小时30分钟。选择（第一位速度，第二位速度，AB距离），速度单位为千米/小时，距离单位为千米。","figure_ids":[],"options":[{"id":"A","text":"$(4,5,22)$","figure_ids":[]},{"id":"B","text":"$(4,5,20)$","figure_ids":[]},{"id":"C","text":"$(5,4,22)$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"两辆汽车从相距80千米的A、B同时相向出发。相遇后，从A出的车再过20分钟到B，从B出的车再过45分钟到A。选择（A出发速度，B出发速度），单位为千米/小时。","figure_ids":[],"options":[{"id":"A","text":"$(64,96)$","figure_ids":[]},{"id":"B","text":"$(96,64)$","figure_ids":[]},{"id":"C","text":"$(160,320/3)$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"两列火车从相距112千米的A、B同时相向出发，56分钟后相遇，保持各自速度继续运行。从A出的车比从B出的车早15分钟到达对方城市。选择（A出发速度，B出发速度），单位为千米/小时。","figure_ids":[],"options":[{"id":"A","text":"$(64,56)$","figure_ids":[]},{"id":"B","text":"$(60,60)$","figure_ids":[]},{"id":"C","text":"$(56,64)$","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"$(x^2-3x+q)(3x^2-2x+c)=3x^4-11x^3+nx^2-24$。选择所有满足条件的 $(n,c,q)$。","figure_ids":[],"options":[{"id":"A","text":"$(-8,4,-6)$","figure_ids":[]},{"id":"B","text":"$(-14,4,-6)$","figure_ids":[]},{"id":"C","text":"$(14,-4,6)$","figure_ids":[]},{"id":"D","text":"$(20,-4,6)$","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"二次三项式 $(x^2+bx+4)(ax^2+x-3)$ 的积为 $ax^4-9x^3+cx-12$。选择所有满足条件的 $(a,b,c)$。","figure_ids":[],"options":[{"id":"A","text":"$(2,-5,-11)$","figure_ids":[]},{"id":"B","text":"$(-5/4,8,-20)$","figure_ids":[]},{"id":"C","text":"$(2,-5,19)$","figure_ids":[]},{"id":"D","text":"$(-5/4,8,28)$","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"底120 cm、高60 cm的三角形内接矩形：两个顶点在底边上，另外两个在两腰上。矩形面积1750 cm²。选择所有可能的矩形周长。","figure_ids":[],"options":[{"id":"A","text":"$95\\ \\mathrm{cm}$","figure_ids":[]},{"id":"B","text":"$190\\ \\mathrm{cm}$","figure_ids":[]},{"id":"C","text":"$170\\ \\mathrm{cm}$","figure_ids":[]},{"id":"D","text":"$85\\ \\mathrm{cm}$","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"周长140 dm的等腰三角形内接边长24 dm的菱形，菱形一边在三角形底边上，另一边在三角形一条腰上。选择所有可能的（腰长，底边长），单位为dm。","figure_ids":[],"options":[{"id":"A","text":"$(40,60)$","figure_ids":[]},{"id":"B","text":"$(60,40)$","figure_ids":[]},{"id":"C","text":"$(56,42)$","figure_ids":[]},{"id":"D","text":"$(42,56)$","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"对 $y\\geq|x|$、$y\\leq-|x|$、$y\\geq|x-2|$、$y\\leq|1-x|$ 的区域，选择所有完整且正确的描述。各式均允许任意实数横坐标。","figure_ids":[],"options":[{"id":"A","text":"$y\\geq|x|$：位于两射线 $y=|x|$ 的上方，包含边界；等价于同时满足 $y\\geq x$、$y\\geq-x$。","figure_ids":[]},{"id":"B","text":"$y\\leq|1-x|$：顶点 $(1,0)$，包含边界；等价于同时满足 $y\\leq1-x$、$y\\leq x-1$。","figure_ids":[]},{"id":"C","text":"$y\\leq-|x|$：位于两射线 $y=-|x|$ 的下方，包含边界；等价于同时满足 $y\\leq x$、$y\\leq-x$。","figure_ids":[]},{"id":"D","text":"$y\\geq|x-2|$：顶点 $(-2,0)$，包含边界；等价于同时满足 $y\\geq x+2$、$y\\geq-x-2$。","figure_ids":[]},{"id":"E","text":"$y\\geq|x-2|$：顶点 $(2,0)$，包含边界；等价于同时满足 $y\\geq x-2$、$y\\geq2-x$。","figure_ids":[]},{"id":"F","text":"$y\\geq|x|$：位于两射线 $y=-|x|$ 的下方，包含边界；等价于同时满足 $y\\leq x$、$y\\leq-x$。","figure_ids":[]},{"id":"G","text":"$y\\leq|1-x|$：顶点 $(1,0)$，包含边界；等价于 $y\\leq1-x$ 或 $y\\leq x-1$，至少满足一个。","figure_ids":[]},{"id":"H","text":"$y\\leq-|x|$：位于两射线 $y=|x|$ 的上方，包含边界；等价于同时满足 $y\\geq x$、$y\\geq-x$。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"设甲为 $3y-x+4\\geq0$ 的点集，乙为 $2x-2y\\geq1$ 的点集。哪项完整描述两者？“上方”“下方”均指同一横坐标下比较纵坐标。","figure_ids":[],"options":[{"id":"A","text":"甲：直线 $y=x/3-4/3$ 及其上方；乙：直线 $y=x-1/2$ 及其下方。","figure_ids":[]},{"id":"B","text":"甲：直线 $y=x/3-4/3$ 及其上方；乙：直线 $y=x-1/2$ 及其上方。","figure_ids":[]},{"id":"C","text":"甲：直线 $y=x/3+4/3$ 及其上方；乙：直线 $y=x-1/2$ 及其下方。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"直线经过 $O(0,0)$、$P(5,1)$。无论“上半平面”是否包含这条边界，哪一项给出正确的边界方程及其严格上方内部的充要条件？","figure_ids":[],"options":[{"id":"A","text":"边界 $y=5x$；严格上方内部 $y>5x$。","figure_ids":[]},{"id":"B","text":"边界 $5y-x=0$；严格上方内部 $5y-x<0$。","figure_ids":[]},{"id":"C","text":"边界 $5y-x=0$；严格上方内部 $5y-x>0$。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲为 $y\\geq x^2-4$，乙为 $y<-x^2+1$，丙为 $y\\geq x^2+4x+4$。哪项给出三个完整图形的顶点、方向及边界归属？","figure_ids":[],"options":[{"id":"A","text":"甲：开口向上，顶点 $(0,-4)$，边界及上方；乙：开口向下，顶点 $(0,1)$，仅严格下方；丙：开口向上，顶点 $(-2,0)$，边界及上方。","figure_ids":[]},{"id":"B","text":"甲：开口向上，顶点 $(0,-4)$，边界及上方；乙：开口向下，顶点 $(0,1)$，边界及下方；丙：开口向上，顶点 $(-2,0)$，边界及上方。","figure_ids":[]},{"id":"C","text":"甲：开口向上，顶点 $(0,-4)$，边界及上方；乙：开口向下，顶点 $(0,1)$，仅严格下方；丙：开口向上，顶点 $(2,0)$，边界及上方。","figure_ids":[]},{"id":"D","text":"甲：开口向上，顶点 $(0,-4)$，边界及下方；乙：开口向下，顶点 $(0,1)$，仅严格下方；丙：开口向上，顶点 $(-2,0)$，边界及上方。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"比较甲 $y\\leq4/x$ 与乙 $xy\\leq4$ 的完整点集。哪项正确？","figure_ids":[],"options":[{"id":"A","text":"甲：$x\\ne0,\\ y\\leq4/x$；乙：$x>0$ 时 $y\\leq4/x$，$x<0$ 时 $y\\geq4/x$，$x=0$ 时任意 $y$。","figure_ids":[]},{"id":"B","text":"甲：$x\\ne0,\\ y\\leq4/x$；乙：$x>0$ 时 $y\\leq4/x$，$x<0$ 时 $y\\geq4/x$，$x=0$ 时无点。","figure_ids":[]},{"id":"C","text":"甲：$x\\ne0,\\ y\\leq4/x$；乙：$x\\ne0,\\ y\\leq4/x$，$x=0$ 时任意 $y$。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"比较甲 $y\\geq10/x$ 与乙 $xy\\geq10$ 的完整点集。哪项正确？未列出的点均不属于对应点集。","figure_ids":[],"options":[{"id":"A","text":"甲：$x\\ne0,\\ y\\geq10/x$；乙：$x\\ne0,\\ y\\geq10/x$。两者都不含 $x=0$ 上的点。","figure_ids":[]},{"id":"B","text":"甲：$x\\ne0,\\ y\\geq10/x$；乙：$x>0$ 时 $y\\geq10/x$，$x<0$ 时 $y\\leq10/x$，$x=0$ 无点。","figure_ids":[]},{"id":"C","text":"甲：$x>0$ 时 $y\\geq10/x$，$x<0$ 时 $y\\leq10/x$；乙：$x\\ne0,\\ y\\geq10/x$。两者都不含 $x=0$ 上的点。","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"选择所有整条直线都位于严格半平面 $y>3$ 内的方程。每条直线均取全部实数 $x$。","figure_ids":[],"options":[{"id":"A","text":"$y=4$","figure_ids":[]},{"id":"B","text":"$y=x+4$","figure_ids":[]},{"id":"C","text":"$y=3$","figure_ids":[]},{"id":"D","text":"$y=7$","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"选择所有整条抛物线都位于严格半平面 $y>5$ 内的方程。每条抛物线取全部实数 $x$。","figure_ids":[],"options":[{"id":"A","text":"$y=2x^2+5$","figure_ids":[]},{"id":"B","text":"$y=(x-1)^2+6$","figure_ids":[]},{"id":"C","text":"$y=-x^2+6$","figure_ids":[]},{"id":"D","text":"$y=x^2+4x+10$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"用一个不等式表示所有离原点不大于7个单位长度的点 $(x,y)$。","figure_ids":[],"options":[{"id":"A","text":"$x^2+y^2<49$","figure_ids":[]},{"id":"B","text":"$x^2+y^2\\leq7$","figure_ids":[]},{"id":"C","text":"$x^2+y^2\\leq49$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲：$x^2+y^2\\geq0$；乙：$x^2+y^2>0$；丙：$x^2+y^2\\leq0$。哪项依次给出完整点集？","figure_ids":[],"options":[{"id":"A","text":"甲：整个平面；乙：整个平面；丙：仅原点。","figure_ids":[]},{"id":"B","text":"甲：整个平面；乙：除原点外的平面；丙：仅原点。","figure_ids":[]},{"id":"C","text":"甲：整个平面；乙：除原点外的平面；丙：空集。","figure_ids":[]},{"id":"D","text":"甲：仅原点；乙：除原点外的平面；丙：仅原点。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"下图 (a) 中，哪个不等式的解集恰好是画细线条的区域？","figure_ids":["fig-26"],"options":[{"id":"A","text":"$y\\ge 2x$","figure_ids":[]},{"id":"B","text":"$y\\ge \\dfrac{x}{2}$","figure_ids":[]},{"id":"C","text":"$y\\le \\dfrac{x}{2}$","figure_ids":[]},{"id":"D","text":"$y>\\dfrac{x}{2}$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"下图 (b) 中，哪个不等式的解集恰好是画细线条的区域？","figure_ids":["fig-26"],"options":[{"id":"A","text":"$y\\le 2x+1$","figure_ids":[]},{"id":"B","text":"$y\\ge 2x-1$","figure_ids":[]},{"id":"C","text":"$y<2x-1$","figure_ids":[]},{"id":"D","text":"$y\\le 2x-1$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲：$|x|<3.7$；乙：$|y|\\geq5.5$。哪项描述各自完整点集？","figure_ids":[],"options":[{"id":"A","text":"甲：$-3.7<y<3.7$，$x$任意；乙：$x\\leq-5.5$ 或 $x\\geq5.5$，$y$任意。","figure_ids":[]},{"id":"B","text":"甲：$-3.7<x<3.7$，$y$任意；乙：空集。","figure_ids":[]},{"id":"C","text":"甲：$-3.7<x<3.7$，$y$任意；乙：$y\\leq-5.5$ 或 $y\\geq5.5$，$x$任意。","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"甲为 $|y|\\geq x$，乙为 $y\\leq|2x|$。选择所有关于完整区域的正确描述。","figure_ids":[],"options":[{"id":"A","text":"甲：$x\\leq0$ 时任意 $y$；$x>0$ 时 $y\\geq x$ 或 $y\\leq-x$；两条边界射线包含。","figure_ids":[]},{"id":"B","text":"乙：同时满足 $y\\leq2x$ 和 $y\\leq-2x$；顶点 $(0,0)$，边界包含。","figure_ids":[]},{"id":"C","text":"乙：满足 $y\\leq2x$ 或 $y\\leq-2x$；顶点 $(0,0)$，两边界射线包含，所有 $y\\leq0$ 的点也包含。","figure_ids":[]},{"id":"D","text":"甲：同时满足 $y\\geq x$ 和 $y\\leq-x$，即 $x\\leq y\\leq-x$；两边界包含。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲：$|x|+|y|\\leq1$；乙：$|x|+|y|\\geq4$。哪项描述各自完整区域？","figure_ids":[],"options":[{"id":"A","text":"甲：顶点 $(\\pm1,0),(0,\\pm1)$ 的菱形内部及边界；乙：顶点 $(\\pm4,0),(0,\\pm4)$ 的菱形外部及边界。","figure_ids":[]},{"id":"B","text":"甲：半径1的圆盘内部及边界；乙：半径4的圆的外部及周界，圆心均为原点。","figure_ids":[]},{"id":"C","text":"甲：顶点 $(\\pm1,0),(0,\\pm1)$ 的菱形内部及边界；乙：顶点 $(\\pm4,0),(0,\\pm4)$ 的菱形内部及边界。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"求点集 $|x|+|y|\\leq2$ 所围图形的面积，单位为平方坐标单位。","figure_ids":[],"options":[{"id":"A","text":"$16$","figure_ids":[]},{"id":"B","text":"$8$","figure_ids":[]},{"id":"C","text":"$2$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲由 $|x|\\leq2,\\ |y|\\leq3$ 共同确定；乙由 $|x|\\leq4,\\ |y|\\geq5$ 共同确定。哪项完整描述两者？","figure_ids":[],"options":[{"id":"A","text":"甲：闭矩形 $[-2,2]\\times[-3,3]$；乙：$[-4,4]\\times(( -\\infty,-5]\\cup[5,\\infty))$，包括有限边界，两部分均无界。","figure_ids":[]},{"id":"B","text":"甲：闭矩形 $[-2,2]\\times[-3,3]$；乙：闭矩形 $[-4,4]\\times[-5,5]$，全部边界包含。","figure_ids":[]},{"id":"C","text":"甲：闭矩形 $[-3,3]\\times[-2,2]$；乙：$[-4,4]\\times(( -\\infty,-5]\\cup[5,\\infty))$，包括有限边界，两部分均无界。","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"甲由 $y>x,\\ y<2x,\\ y<4$ 共同确定；乙由 $y-x<2,\\ y+x>4,\\ x<4$ 共同确定。选择所有完整区域描述中正确的项。","figure_ids":[],"options":[{"id":"A","text":"甲：顶点为 $(0,0),(2,4),(4,4)$ 的三角形内部，三条边及三个顶点均不包含。","figure_ids":[]},{"id":"B","text":"乙：空集，不含任何点，也不含任何边界点。","figure_ids":[]},{"id":"C","text":"乙：顶点为 $(1,3),(4,0),(4,6)$ 的三角形内部，三条边及三个顶点均不包含。","figure_ids":[]},{"id":"D","text":"甲：顶点为 $(0,0),(2,4),(4,4)$ 的三角形内部及全部三条边、三个顶点。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲由 $x+y\\leq6,\\ 2x+2y\\geq7,\\ x\\geq0$ 共同确定；乙由 $x-y\\geq3,\\ x+y\\leq5,\\ y\\geq1$ 共同确定。哪项给出完整点集？","figure_ids":[],"options":[{"id":"A","text":"甲：无界闭带 $7/2\\leq x+y\\leq6$，不限制 $x$ 的符号；乙：仅点 $(4,1)$。","figure_ids":[]},{"id":"B","text":"甲：空集；乙：仅点 $(4,1)$。","figure_ids":[]},{"id":"C","text":"甲：无界闭区域 $x\\geq0,\\ 7/2\\leq x+y\\leq6$，三条边界都包含；乙：仅点 $(4,1)$。","figure_ids":[]},{"id":"D","text":"甲：无界闭区域 $x\\geq0,\\ 7/2\\leq x+y\\leq6$，三条边界都包含；乙：闭三角形，顶点为 $(3,0)$、$(5,0)$、$(4,1)$，三条边都包含。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲：$y\\geq0,\\ x-y=0$；乙：$x\\leq0,\\ x+y=0$；丙：$x+y+2\\geq0,\\ x-y=0$。哪项完整描述三个点集？参数 $t$ 为实数。","figure_ids":[],"options":[{"id":"A","text":"甲：$(t,t),t\\geq0$；乙：$(-t,t),t\\geq0$；丙：$(t,t),t\\geq1$。均为包含起点的射线。","figure_ids":[]},{"id":"B","text":"甲：$(t,t),t\\geq0$；乙：$(-t,t),t\\geq0$；丙：$(t,t),t\\geq-1$。均为包含起点的射线。","figure_ids":[]},{"id":"C","text":"甲：$(t,t),t\\geq0$；乙：$(-t,-t),t\\geq0$；丙：$(t,t),t\\geq-1$。均为包含起点的射线。","figure_ids":[]},{"id":"D","text":"甲：$(t,t),t\\leq0$；乙：$(-t,t),t\\geq0$；丙：$(t,t),t\\geq-1$。均为包含起点的射线。","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"选择所有对下列不等式完整区域的正确描述：$xy\\geq0$、$xy\\leq0$、$(x-2)(y-3)\\geq0$、$(x+y)(x-y)\\leq0$。象限按通常坐标轴编号，轴或边界的包含性单独注明。","figure_ids":[],"options":[{"id":"A","text":"$xy\\geq0$：第一、第三象限，以及两条完整坐标轴。","figure_ids":[]},{"id":"B","text":"$(x+y)(x-y)\\leq0$：$|x|\\geq|y|$，两条直线 $y=x$、$y=-x$ 包含。","figure_ids":[]},{"id":"C","text":"$(x-2)(y-3)\\geq0$：$x\\geq2,y\\geq3$ 或 $x\\leq2,y\\leq3$，包括整条 $x=2$ 和 $y=3$。","figure_ids":[]},{"id":"D","text":"$xy\\leq0$：第一、第三象限，以及两条完整坐标轴。","figure_ids":[]},{"id":"E","text":"$(x+y)(x-y)\\leq0$：$|x|\\leq|y|$，两条直线 $y=x$、$y=-x$ 包含。","figure_ids":[]},{"id":"F","text":"$(x-2)(y-3)\\geq0$：$x\\geq2,y\\leq3$ 或 $x\\leq2,y\\geq3$，包括整条 $x=2$ 和 $y=3$。","figure_ids":[]},{"id":"G","text":"$xy\\leq0$：第二、第四象限，以及两条完整坐标轴。","figure_ids":[]},{"id":"H","text":"$xy\\geq0$：第二、第四象限，以及两条完整坐标轴。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲：$(x+y)(1/x+1/y)>0$；乙：$(x-y)(1/x-1/y)>0$。哪项给出各自完整点集？","figure_ids":[],"options":[{"id":"A","text":"甲：第一、第三象限，不含坐标轴；乙：第一、第三象限去掉 $x=y$，不含坐标轴。","figure_ids":[]},{"id":"B","text":"甲：$x\\ne0,y\\ne0,x+y\\ne0$ 的全部点；乙：第二、第四象限，不含坐标轴。","figure_ids":[]},{"id":"C","text":"甲：第一、第三象限，不含坐标轴；乙：第二、第四象限，不含坐标轴。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"对 $y\\leq3x+1,\\ y\\geq3x+b$ 的共同点集，哪项完整分类正确？这里“带形”指两条不同平行边界之间的非零宽度区域。","figure_ids":[],"options":[{"id":"A","text":"$b<1$：带形，包含两边界；$b=1$：一条直线；$b>1$：空集。","figure_ids":[]},{"id":"B","text":"$b>1$：带形，包含两边界；$b=1$：一条直线；$b<1$：空集。","figure_ids":[]},{"id":"C","text":"$b<1$：带形，包含两边界；$b\\geq1$：空集。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲由 $x^2+y^2\\leq36,\\ |x|>1$ 确定；乙由 $x^2+y^2\\leq100,\\ |x|<8$ 确定。哪项完整坐标范围正确？","figure_ids":[],"options":[{"id":"A","text":"甲：$x\\in[-6,-1]\\cup[1,6]$，$-\\sqrt{36-x^2}\\leq y\\leq\\sqrt{36-x^2}$；乙：$x\\in[-8,8]$，$-\\sqrt{100-x^2}\\leq y\\leq\\sqrt{100-x^2}$。","figure_ids":[]},{"id":"B","text":"甲：$x\\in[-6,-1)\\cup(1,6]$，$-\\sqrt{36-x^2}\\leq y\\leq\\sqrt{36-x^2}$；乙：$x\\in(-8,8)$，$-\\sqrt{100-x^2}\\leq y\\leq\\sqrt{100-x^2}$。","figure_ids":[]},{"id":"C","text":"甲：$x\\in(-1,1)$，$-\\sqrt{36-x^2}\\leq y\\leq\\sqrt{36-x^2}$；乙：$x\\in(-8,8)$，$-\\sqrt{100-x^2}\\leq y\\leq\\sqrt{100-x^2}$。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲由 $y\\geq x^2,\\ y\\leq-x^2+9$ 确定；乙由 $y\\geq x^2+4x+4,\\ y\\leq4$ 确定。哪项给出完整区域？各项的区间端点和上下曲线均包含。","figure_ids":[],"options":[{"id":"A","text":"甲：$-3/\\sqrt2\\leq x\\leq3/\\sqrt2$，$x^2\\leq y\\leq9-x^2$；乙：$-4\\leq x\\leq0$，$(x+2)^2\\leq y\\leq4$。","figure_ids":[]},{"id":"B","text":"甲：$-3\\leq x\\leq3$，$x^2\\leq y\\leq9$；乙：$-4\\leq x\\leq0$，$(x+2)^2\\leq y\\leq4$。","figure_ids":[]},{"id":"C","text":"甲：$-3/\\sqrt2\\leq x\\leq3/\\sqrt2$，$x^2\\leq y\\leq9-x^2$；乙：$0\\leq x\\leq4$，$(x-2)^2\\leq y\\leq4$。","figure_ids":[]}]}},{"view":{"mode":"multiple","stem":"设甲由 $x^2+y^2\\leq9,\\ x^2+y^2\\geq1.69$ 确定；乙由 $x^2+y^2\\leq1.44,\\ xy\\geq0$ 确定；丙由 $x^2+y^2\\leq100,\\ x^2+y^2\\geq64,\\ xy\\leq0$ 确定。选择所有完整区域描述中正确的项。","figure_ids":[],"options":[{"id":"A","text":"甲：以原点为圆心，半径1.3至3的闭圆环，两圆周都包含。","figure_ids":[]},{"id":"B","text":"乙：以原点为圆心、半径1.44的闭圆盘在第一、第三象限及坐标轴上的部分。","figure_ids":[]},{"id":"C","text":"丙：以原点为圆心，半径8至10的闭圆环在第二、第四象限及坐标轴上的部分。","figure_ids":[]},{"id":"D","text":"甲：以原点为圆心，半径1.69至3的闭圆环，两圆周都包含。","figure_ids":[]},{"id":"E","text":"乙：以原点为圆心、半径1.2的闭圆盘在第一、第三象限及坐标轴上的部分。","figure_ids":[]},{"id":"F","text":"丙：以原点为圆心，半径8至10的闭圆环在第一、第三象限及坐标轴上的部分。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"甲由 $y\\geq(x-1)^2,\\ y\\leq3.5$ 确定；乙由 $y\\geq(x-2)(x-3),\\ y\\leq0$ 确定。哪项给出完整区域？各项注明的端点和曲线均包含。","figure_ids":[],"options":[{"id":"A","text":"甲：$1-3.5\\leq x\\leq1+3.5$，$0\\leq y\\leq3.5$；乙：$2\\leq x\\leq3$，$(x-2)(x-3)\\leq y\\leq0$。","figure_ids":[]},{"id":"B","text":"甲：$1-\\sqrt{14}/2\\leq x\\leq1+\\sqrt{14}/2$，$(x-1)^2\\leq y\\leq7/2$；乙：$2\\leq x\\leq3$，$0\\leq y\\leq-(x-2)(x-3)$。","figure_ids":[]},{"id":"C","text":"甲：$1-\\sqrt{14}/2\\leq x\\leq1+\\sqrt{14}/2$，$(x-1)^2\\leq y\\leq7/2$；乙：$2\\leq x\\leq3$，$(x-2)(x-3)\\leq y\\leq0$。","figure_ids":[]}]}},{"view":{"mode":"single","stem":"下图 (a) 中，哪个不等式组的解集恰好是画细线条的全部区域？","figure_ids":["fig-27"],"options":[{"id":"A","text":"$\\begin{cases}x^2+y^2\\le 4,\\\\x^2\\le 1.\\end{cases}$","figure_ids":[]},{"id":"B","text":"$\\begin{cases}x^2+y^2\\ge 4,\\\\x^2\\ge 1.\\end{cases}$","figure_ids":[]},{"id":"C","text":"$\\begin{cases}x^2+y^2\\le 4,\\\\x^2\\ge 1.\\end{cases}$","figure_ids":[]},{"id":"D","text":"$\\begin{cases}x^2+y^2\\le 4,\\\\x\\ge 1.\\end{cases}$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"下图 (b) 中，哪个不等式组的解集恰好是画细线条的区域？","figure_ids":["fig-27"],"options":[{"id":"A","text":"$\\begin{cases}y\\ge x+1,\\\\y\\le 1-x.\\end{cases}$","figure_ids":[]},{"id":"B","text":"$\\begin{cases}y\\ge x+1,\\\\y\\ge 1-x.\\end{cases}$","figure_ids":[]},{"id":"C","text":"$\\begin{cases}y\\le x+1,\\\\y\\le 1-x.\\end{cases}$","figure_ids":[]},{"id":"D","text":"$\\begin{cases}y\\le x+1,\\\\y\\ge 1-x.\\end{cases}$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"求 $y\\geq|x|,\\ y\\leq4$ 的共同点集所围图形面积，单位为平方坐标单位。","figure_ids":[],"options":[{"id":"A","text":"$32$","figure_ids":[]},{"id":"B","text":"$16$","figure_ids":[]},{"id":"C","text":"$8$","figure_ids":[]}]}},{"view":{"mode":"single","stem":"求 $y\\geq|x|,\\ y\\leq0.5x+1.5$ 的共同点集所围图形面积，单位为平方坐标单位。","figure_ids":[],"options":[{"id":"A","text":"$3$","figure_ids":[]},{"id":"B","text":"$9/4$","figure_ids":[]},{"id":"C","text":"$6$","figure_ids":[]}]}}],"new_figures":[]}
