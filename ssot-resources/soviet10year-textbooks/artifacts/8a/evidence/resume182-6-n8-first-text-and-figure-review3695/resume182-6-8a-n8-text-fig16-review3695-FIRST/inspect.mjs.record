import fs from 'node:fs';
import assert from 'node:assert/strict';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), root);
const raw = 'ssot-resources/soviet10year-textbooks/artifacts/8a/lessons/alg8-c2-s1-n8';
const author = '.tmp/resume182-6-8a-n8-text-author3695-FIRST/adapt/8a/modern-us-neutral/lessons/alg8-c2-s1-n8';
const figure = '.tmp/resume182-6-8a-n8-fig16-author3695-FIRST';
const load = path => JSON.parse(fs.readFileSync(path, 'utf8'));

if (['text', 'lesson', 'exercises'].includes(process.argv[2])) {
  for (const [label, path] of [
    ['raw lesson', `${raw}/lesson.json`],
    ['author lesson', `${author}/lesson.template.json`],
    ['raw exercises', `${raw}/exercises.json`],
    ['author exercises', `${author}/exercises.template.json`],
  ]) {
    if (process.argv[2] !== 'text' && !label.includes(process.argv[2])) continue;
    const data = load(path);
    console.log(JSON.stringify({ label, path, keys: Object.keys(data) }));
    const items = Array.isArray(data) ? data : data.prose ?? data.exercises;
    if (!items) {
      console.log(JSON.stringify(data, null, 2));
      continue;
    }
    for (const [index, item] of items.entries()) {
      const { source_text, ...rest } = item;
      console.log(JSON.stringify({ index, ...rest }));
    }
    const remainder = Array.isArray(data) ? {} : Object.fromEntries(
      Object.entries(data).filter(([key]) => !['prose', 'exercises'].includes(key)),
    );
    if (remainder.source) {
      const { data: embeddedSource, ...provenance } = remainder.source;
      remainder.source = provenance;
      remainder.embeddedSourceKeys = Object.keys(embeddedSource ?? {});
    }
    console.log(JSON.stringify({ label, remainder }));
  }
}

if (process.argv[2] === 'figure-svg') {
  const svg = fs.readFileSync(`${figure}/render/figure.svg`, 'utf8');
  const nodes = [...svg.matchAll(/<(?:text|circle|ellipse|path)\b[^>]*>/g)].map(match => match[0]);
  for (const node of nodes) {
    if (/\bid="(?:fig-16-|sr-svg_)/.test(node)) console.log(node);
  }
  for (const match of svg.matchAll(/<text\b[^>]*>.*?<\/text>/gs)) {
    console.log(match[0]);
  }
}
