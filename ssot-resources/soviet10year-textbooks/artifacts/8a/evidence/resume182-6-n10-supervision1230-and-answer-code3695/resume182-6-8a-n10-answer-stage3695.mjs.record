import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const [reviewFile, reviewSHA, textReviewFile, textReviewSHA] = process.argv.slice(2);
const root = 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral';
const id = 'alg8-c2-s2-n10';
const lesson = `${root}/lessons/${id}`;
const own = '.tmp/resume182-6-8a-n10-answer-stage3695-FIRST';
const template = '.tmp/resume182-6-8a-n10-approved-binding3695-FIRST/adapt/8a/modern-us-neutral/lessons/alg8-c2-s2-n10';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const read = file => fs.readFileSync(file);
const json = file => JSON.parse(read(file));
const save = (file, value) => fs.writeFileSync(file,
  `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
for (const [file, hash, status] of [
  [reviewFile, reviewSHA, 'PASS'], [textReviewFile, textReviewSHA, 'TEXT_PASS'],
]) {
  assert.match(hash, /^[a-f0-9]{64}$/);
  assert.equal(sha(read(file)), hash);
  const value = json(file);
  assert.equal(value.status, status);
  assert.equal(value.book, '8a');
  assert.equal(value.lesson, id);
  assert.equal(value.edition, 'modern-us-neutral');
}
const review = json(reviewFile);
for (const item of review.inputs) assert.equal(sha(read(item.path)), item.sha256);
const source = review.inputs.find(item => item.path.endsWith('answers.draft.json'));
assert.ok(source);
const candidateBytes = read(source.path), candidate = JSON.parse(candidateBytes);
assert.deepEqual(candidate.answers.map(answer => answer.exercise),
  json(`${lesson}/exercises.json`).exercises.map(exercise => String(exercise.number)));
assert.equal(json(`${lesson}/adaptation.audit.json`).status, 'pass');
assert.equal(json(`${lesson}/lesson.json`).status, 'ready');
assert.equal(json(`${lesson}/exercises.json`).status, 'ready');
const formulas = text => [...text.matchAll(/\$\$(.+?)\$\$|\$([^$]+?)\$/gs)]
  .map(match => match[1] ?? match[2]);
const compact = text => text.replace(/\s+/gu, '');
let formulaSpans = 0;
for (const [before, after] of [
  [json(`${template}/lesson.template.json`).prose, json(`${lesson}/lesson.json`).prose],
  [json(`${template}/exercises.template.json`).exercises, json(`${lesson}/exercises.json`).exercises],
]) {
  assert.equal(before.length, after.length);
  for (let index = 0; index < before.length; index++) {
    assert.deepEqual(formulas(before[index].text), formulas(after[index].text));
    assert.equal(compact(before[index].text), compact(after[index].text));
    formulaSpans += formulas(before[index].text).length;
  }
}
assert.ok(!fs.existsSync(own));
assert.ok(!fs.existsSync(`${lesson}/answer-keys.json`));
fs.mkdirSync(own);
fs.writeFileSync(`${lesson}/answer-keys.json`, candidateBytes, { flag: 'wx' });
const indexPath = `${root}/book.json`, indexBytes = read(indexPath), index = JSON.parse(indexBytes);
fs.writeFileSync(`${own}/index-before-portable-path.record`, indexBytes, { flag: 'wx' });
if (path.isAbsolute(index.profile.path)) {
  assert.ok(index.profile.path.startsWith(`${repo}/`));
  index.profile.path = path.relative(repo, index.profile.path);
}
assert.equal(sha(read(index.profile.path)), index.profile.sha256);
fs.writeFileSync(indexPath, `${JSON.stringify(index, null, 2)}\n`);
save(`${own}/binding.record`, {
  status: 'APPROVED_ANSWER_CANDIDATE_BOUND_PENDING_OFFICIAL_VALIDATION',
  root: repo, ticket: 'STEMROBIN-182', book: '8a', lesson: id, edition: 'modern-us-neutral',
  review: { path: reviewFile, sha256: reviewSHA },
  textReview: { path: textReviewFile, sha256: textReviewSHA },
  candidate: source, target: `${lesson}/answer-keys.json`, targetBytesUnchanged: true,
  answers: candidate.answers.length, finalTextOnlyWhitespaceNormalized: true,
  formulaSpansPreserved: formulaSpans, portableProfileBinding: index.profile,
  newSourceMathImageOrSemanticReviews: 0, graphicalExecutionClaimed: false,
  oldFailuresAndUsagePreserved: true, formalAnswerFinalizerPending: true,
  DBWrites: 0, wholeLessonApproval: false, unknownHistoricalBytesRecovered: false,
  hostTokens: 'unknown', totalCost: 'unknown',
});
console.log(JSON.stringify({
  path: `${own}/binding.record`, sha256: sha(read(`${own}/binding.record`)),
  answers: candidate.answers.length, formulaSpansPreserved: formulaSpans,
}));
