        {"option_id": "B", "truth": "incorrect", "derivation": "Take ceil(274/9)=31, then add one more to obtain 32; a_32=-0.28.", "misconception": "Apply the strict-inequality adjustment twice."},
        {"option_id": "C", "truth": "incorrect", "derivation": "Mistaken a_n=5.3-0.18n becomes negative first at n=30, yielding -0.10.", "misconception": "Use n instead of n-1 increments, shifting the entire sequence."},
        {"option_id": "D", "truth": "correct", "derivation": "a_30=0.08>=0 and a_31=-0.10<0; monotone decrease establishes firstness.", "misconception": null}
      ]}
    },
