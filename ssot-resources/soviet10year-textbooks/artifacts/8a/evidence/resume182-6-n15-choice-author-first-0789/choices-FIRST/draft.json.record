  "questions": [
    {
      "id": "q232-symbolic", "source_numbers": ["232"],
      "view": {
        "mode": "multiple",
        "stem": "等差数列 $(a_n)$ 的首项为 $a_1$，公差为 $d$，$m$ 为正整数。选出对任意这样的数列都成立的等式。",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "$a_3=a_1+3d$", "figure_ids": []},
          {"id": "B", "text": "$a_{26}=a_1+25d$", "figure_ids": []},
          {"id": "C", "text": "$a_{m+1}=a_1+md$", "figure_ids": []},
          {"id": "D", "text": "$a_{260}=a_1+259d$", "figure_ids": []},
          {"id": "E", "text": "$a_{2m}=2a_1+(2m-2)d$", "figure_ids": []},
          {"id": "F", "text": "$a_3=a_1+2d$", "figure_ids": []},
          {"id": "G", "text": "$a_m=a_1+(m-1)d$", "figure_ids": []},
          {"id": "H", "text": "$a_{26}=a_1+24d$", "figure_ids": []},
          {"id": "I", "text": "$a_{2m}=a_1+(2m-1)d$", "figure_ids": []},
          {"id": "J", "text": "$a_{m+1}=a_1+(m+1)d$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Judge the six requested symbolic positions by one universal general-term rule.",
        "source_solution": "a_r=a_1+(r-1)d gives coefficients 2,25,259,m-1,m,2m-1 for the six requested positions.",
        "unit_reason": "These are manifestations of one index-to-increment identity. One selection set retains all six forms without six separate value clicks.",
        "concept_blocks": [5],
        "limitations": ["Recognition of all identities does not establish independent production of their formulas."],
        "figure_observations": []
      },
      "key": {
        "correct": ["B", "C", "D", "F", "G", "I"],
        "rationales": [
          {"option_id": "A", "truth": "incorrect", "derivation": "There are two gaps to index 3, not three; a_1=0,d=1 gives 2 rather than 3.", "misconception": "Replace r-1 by r: a_3=a_1+3d."},
          {"option_id": "B", "truth": "correct", "derivation": "26-1=25 increments.", "misconception": null},
          {"option_id": "C", "truth": "correct", "derivation": "(m+1)-1=m increments.", "misconception": null},
          {"option_id": "D", "truth": "correct", "derivation": "260-1=259 increments.", "misconception": null},
          {"option_id": "E", "truth": "incorrect", "derivation": "At a_1=1,d=0 the actual a_(2m)=1 but the proposed expression is 2.", "misconception": "Confuse doubling the index with doubling the term: a_(2m)=2a_m=2a_1+2(m-1)d."},
          {"option_id": "F", "truth": "correct", "derivation": "3-1=2 increments.", "misconception": null},
          {"option_id": "G", "truth": "correct", "derivation": "Index m requires m-1 increments from index 1.", "misconception": null},
          {"option_id": "H", "truth": "incorrect", "derivation": "At a_1=0,d=1 the actual term is 25, not 24.", "misconception": "Count the gap from index 2 while still using a_1: 26-2=24."},
          {"option_id": "I", "truth": "correct", "derivation": "Substitute r=2m into a_r=a_1+(r-1)d.", "misconception": null},
          {"option_id": "J", "truth": "incorrect", "derivation": "At d=1 the proposed result exceeds a_(m+1) by 1.", "misconception": "Use the index m+1 itself as the number of increments."}
        ]
      }
    },
    {
      "id": "q233-complete", "source_numbers": ["233"],
      "view": {
        "mode": "single", "stem": "等差数列 $(c_n)$ 中，$c_1=20$，$d=3$。哪一组给出了正确的 $c_5$、$c_{101}$ 和通项公式？", "figure_ids": [],
        "options": [
          {"id": "A", "text": "$c_5=35$，$c_{101}=323$，$c_n=3n+20$。", "figure_ids": []},
          {"id": "B", "text": "$c_5=8$，$c_{101}=-280$，$c_n=23-3n$。", "figure_ids": []},
          {"id": "C", "text": "$c_5=32$，$c_{101}=320$，$c_n=3n+17$。", "figure_ids": []},
          {"id": "D", "text": "$c_5=12$，$c_{101}=300$，$c_n=3n-3$。", "figure_ids": []}
        ]
      },
      "intent": {"task": "Obtain the formula and both requested terms as a coherent result.", "source_solution": "20+3(n-1)=3n+17 gives c_5=32,c_101=320.", "unit_reason": "The two values and formula describe one progression; checking a complete result preserves their consistency.", "concept_blocks": [5], "limitations": ["Selection does not establish independent writing of the general-term derivation."], "figure_observations": []},
      "key": {"correct": ["C"], "rationales": [
        {"option_id": "A", "truth": "incorrect", "derivation": "20+3n gives 35 and 323 but has first term 23.", "misconception": "Use n rather than n-1 increments."},
        {"option_id": "B", "truth": "incorrect", "derivation": "20-3(n-1)=23-3n gives 8 and -280.", "misconception": "Reverse the sign of the given positive common difference."},
        {"option_id": "C", "truth": "correct", "derivation": "20+3(4)=32 and 20+3(100)=320; expand to 3n+17.", "misconception": null},
        {"option_id": "D", "truth": "incorrect", "derivation": "3(n-1) gives 12 and 300.", "misconception": "Keep the cumulative increments but omit the initial 20."}
      ]}
    },
