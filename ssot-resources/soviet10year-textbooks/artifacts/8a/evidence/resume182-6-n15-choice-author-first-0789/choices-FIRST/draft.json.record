    {
      "id": "q236-symmetric-sums", "source_numbers": ["236"],
      "view": {"mode": "single", "stem": "一个等差数列共有 $30$ 项，$a_1=2.8$，$d=0.3$。按顺序求首项与末项、第 $2$ 项与倒数第 $2$ 项、第 $5$ 项与倒数第 $5$ 项的和。哪一组正确？", "figure_ids": [], "options": [
        {"id": "A", "text": "$14.3,\\ 14.3,\\ 14.3$", "figure_ids": []},
        {"id": "B", "text": "$14.6,\\ 14.6,\\ 14.6$", "figure_ids": []},
        {"id": "C", "text": "$14.3,\\ 14.0,\\ 14.0$", "figure_ids": []},
        {"id": "D", "text": "$5.6,\\ 6.2,\\ 8.0$", "figure_ids": []}
      ]},
      "intent": {"task": "Compute every requested symmetric pair sum in the finite progression.", "source_solution": "The paired indices are (1,30),(2,29),(5,26), all summing to 31. Each term sum equals 2(2.8)+29(0.3)=14.3.", "unit_reason": "Symmetric sums are linked by one invariant. A complete three-sum result tests the finite-endpoint correspondence rather than isolated addition.", "concept_blocks": [5], "limitations": ["Selection does not establish independent writing of the symmetry argument."], "figure_observations": []},
      "key": {"correct": ["A"], "rationales": [
        {"option_id": "A", "truth": "correct", "derivation": "a_30=11.5; a_2+a_29=3.1+11.2; a_5+a_26=4+10.3; all are 14.3.", "misconception": null},
        {"option_id": "B", "truth": "incorrect", "derivation": "Use a_30=2.8+30d=11.8, then transfer the endpoint sum 2.8+11.8=14.6 to every symmetric pair.", "misconception": "Count thirty gaps to the last term, then transfer that mistaken endpoint sum to every symmetric pair."},
        {"option_id": "C", "truth": "incorrect", "derivation": "Using a_28 as the second from the end gives 3.1+10.9=14; using a_25 as the fifth gives 4+10=14.", "misconception": "For non-endpoint pairs use index 30-r rather than 31-r, while retaining the actual last term in the first pair."},
        {"option_id": "D", "truth": "incorrect", "derivation": "2a_1=5.6,2a_2=6.2,2a_5=8.", "misconception": "Pair each forward term with itself instead of the equally ranked term from the end."}
      ]}
    },
