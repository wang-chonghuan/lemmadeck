  "concept_reviews": [
    {
      "block": 5,
      "status": "solved",
      "selected_text": "a_n=a_1+d(n-1). (1)",
      "independent_solution": "Starting at a_1, reaching index n requires n-1 equal increments d. Thus a_n=a_1+(n-1)d for n in N+. Subtracting two such identities gives a_j-a_i=(j-i)d, and consecutive differences are a_(n+1)-a_n=d. Conversely, a sequence with a common consecutive difference satisfies this expression by repeated addition.",
      "required_mathematical_tasks": [
        "Distinguish the index n from the number n-1 of increments.",
        "Obtain terms from a first term and a signed common difference.",
        "Invert the formula for a first term, a difference or an integer index.",
        "Use constant consecutive differences to prove an explicit linear sequence is arithmetic."
      ],
      "boundaries_and_symbols": [
        "At n=1 the increment count is zero, so the formula returns a_1.",
        "Negative d gives decreasing terms and d=0 gives a constant arithmetic sequence.",
        "A real-valued inverse index is insufficient for membership; it must belong to N+.",
        "The concept does not require a positive d or an unmentioned last index."
      ],
      "complete_solution_set": {
        "general_term": "a_n=a_1+(n-1)d, n in N+",
        "index_difference": "a_j-a_i=(j-i)d, i,j in N+",
        "consecutive_difference": "a_(n+1)-a_n=d, n in N+"
      }
    }
  ],
