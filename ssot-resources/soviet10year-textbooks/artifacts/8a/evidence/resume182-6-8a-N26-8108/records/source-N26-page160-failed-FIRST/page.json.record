      "sha256": "abe1aa782c18751a053f639723b95c19954610245f6b47b12aeb8ae77f12717b"
    },
    "profile": {
      "id": "soviet-cn",
      "sha256": "dad8d974ba16880482f359073263269de8c405ccf8cb17dc4215fad11da44849"
    },
