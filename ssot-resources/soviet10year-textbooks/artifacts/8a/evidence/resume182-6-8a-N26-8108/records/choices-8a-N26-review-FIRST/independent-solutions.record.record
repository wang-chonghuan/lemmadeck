  "concept_facts": [
    {
      "block": 4,
      "fact": "For nonnegative radicands, equal-index roots multiply by multiplying radicands. This also permits splitting an nth-power factor out of a radical."
    },
    {
      "block": 5,
      "fact": "For a nonnegative numerator and strictly positive denominator, the root of a quotient is the quotient of roots. Denominator positivity must survive rewriting."
    },
    {
      "block": 21,
      "fact": "For a nonnegative radicand, nested roots have the product of the two indices, not their sum."
    },
    {
      "block": 25,
      "fact": "A common positive integer factor in a radical index and radicand exponent can be canceled under the stated nonnegative-domain hypothesis."
    }
