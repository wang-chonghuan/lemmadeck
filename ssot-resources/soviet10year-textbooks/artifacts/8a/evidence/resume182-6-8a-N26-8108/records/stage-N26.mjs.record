import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-8108/lemmadeck';
assert.equal(process.cwd(), repo);
const run = (...args) => {
  const result = spawnSync('git', args, { cwd: repo, encoding: 'utf8' });
  assert.equal(result.status, 0, result.stderr);
  return result.stdout;
};
assert.equal(run('diff', '--cached', '--name-only').trim(), '', 'Preserve an existing staged set');
assert.equal(run('rev-parse', 'HEAD'), run('rev-parse', 'FETCH_HEAD'), 'Resolve upstream changes before staging');
const base = 'ssot-resources/soviet10year-textbooks/artifacts/8a';
const evidence = `${base}/evidence/resume182-6-8a-N26-8108`;
const binding = JSON.parse(fs.readFileSync(`${evidence}/binding.record`, 'utf8'));
assert.equal(binding.status, 'SOURCE_MODERN_ANSWERS_CHOICES_COMPLETE_OFFLINE_DISPLAY_PASS');
assert.equal(binding.actualNewImagesObserved, 103);
assert.equal(binding.oldTreeMigrationBytes, 0);
assert.equal(binding.finish, 'review');
for (const file of [...binding.source, ...binding.artifacts, ...binding.retained]) {
  const bytes = fs.readFileSync(path.join(repo, file.path));
  assert.equal(bytes.length, file.bytes);
  assert.equal(crypto.createHash('sha256').update(bytes).digest('hex'), file.sha256);
}
for (const index of [`${base}/book.json`, `${base}/editions/modern-us-neutral/book.json`]) {
  const previous = JSON.parse(run('show', `HEAD:${index}`));
  const current = JSON.parse(fs.readFileSync(index, 'utf8'));
  const added = current.lessons.filter(lesson => lesson.id === 'alg8-c4-s2-n26');
  assert.equal(added.length, 1);
  assert.equal(added[0].exercises, 20);
  assert.deepEqual(current.lessons.filter(lesson => lesson.id !== 'alg8-c4-s2-n26'), previous.lessons);
}
const targets = [
  '.claude/skills/ld-s10y-lesson/tools/layout.py',
  '.claude/skills/ld-s10y-lesson/tests/test_fraction_following_sentence.py',
  '.claude/skills/ld-s10y-lesson/tests/test_underlined_prose_fraction.py',
  '.intentfold/tickets/STEMROBIN-182/progress.md',
  `${base}/book.json`, `${base}/editions/modern-us-neutral/book.json`,
  `${base}/lessons/alg8-c4-s2-n26`,
  `${base}/editions/modern-us-neutral/lessons/alg8-c4-s2-n26`,
  evidence,
  ...Array.from({ length: 7 }, (_, index) => `${base}/pages/${String(159 + index).padStart(4, '0')}`),
];
run('add', '--', ...targets);
const staged = run('diff', '--cached', '--name-only', '-z').split('\0').filter(Boolean);
for (const file of staged) {
  assert.ok(targets.some(target => file === target || file.startsWith(`${target}/`)), file);
  assert.ok(!/(^|\/)\.env(?:$|\.)/.test(file), file);
}
console.log(JSON.stringify({ at: new Date().toISOString(), stagedFiles: staged.length, targets,
  excluded: ['.intentfold/tickets/STEMROBIN-182/ticket.json',
    'ssot-resources/soviet10year-textbooks/artifacts/7a/editions/modern-us-neutral/lessons/alg7-c2-s1-n14/answer-keys.json'],
  contentReviewReruns: 0, dbWrites: 0 }, null, 2));
console.log(run('diff', '--cached', '--stat'));
