import sys
import unittest
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))
import layout


def glyph_row(ink, top, left, count=5, height=20, width=14):
    for index in range(count):
        x = left + index * (width + 6)
        ink[top:top + height, x:x + 3] = True
        ink[top:top + height, x + width - 3:x + width] = True
        ink[top:top + 3, x:x + width] = True
        ink[top + height - 3:top + height, x:x + width] = True


def fraction_sentence():
    ink = np.zeros((270, 520), dtype=bool)
    glyph_row(ink, 10, 40, count=18)
    glyph_row(ink, 60, 40, count=10)
    glyph_row(ink, 45, 300, count=4)
    ink[68:71, 290:385] = True
    glyph_row(ink, 77, 300, count=4)
    glyph_row(ink, 101, 100, count=5)
    glyph_row(ink, 150, 40, count=18)
    glyph_row(ink, 200, 40, count=18)
    return ink


class FractionFollowingSentence(unittest.TestCase):
    def test_short_sentence_survives_tight_fraction_gap(self):
        ink = fraction_sentence()
        before = ink.copy()
        self.assertTrue(layout._fraction_followed_by_text(ink, 45, 96, 101, 120, 20))
        self.assertEqual(len(layout.line_bands(ink, 520)), 5)
        np.testing.assert_array_equal(ink, before)

    def test_denominator_is_not_a_following_sentence(self):
        ink = np.zeros((170, 520), dtype=bool)
        glyph_row(ink, 40, 300, count=4)
        ink[67:70, 290:385] = True
        glyph_row(ink, 76, 300, count=4)
        self.assertFalse(layout._fraction_followed_by_text(ink, 40, 69, 76, 95, 20))
        self.assertEqual(len(layout.line_bands(ink, 520)), 1)

    def test_three_real_rows_are_not_collapsed(self):
        ink = np.zeros((160, 520), dtype=bool)
        for top in (20, 55, 90):
            glyph_row(ink, top, 40, count=18)
        self.assertFalse(layout._fraction_followed_by_text(ink, 20, 74, 90, 109, 20))
        self.assertEqual(len(layout.line_bands(ink, 520)), 3)

    def test_three_brace_connected_rows_are_not_collapsed(self):
        ink = np.zeros((160, 520), dtype=bool)
        for top in (20, 55, 90):
            glyph_row(ink, top, 80, count=15)
        ink[20:110, 45:49] = True
        self.assertFalse(layout._fraction_followed_by_text(ink, 20, 74, 90, 109, 20))
        self.assertEqual(len(layout.line_bands(ink, 520)), 3)


if __name__ == "__main__":
    unittest.main()
