import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-8108/lemmadeck';
assert.equal(process.cwd(), repo);
const scratch = path.join(repo, '.tmp/ld-s10y-lesson/resume182-6-8108');
const book = path.join(repo, 'ssot-resources/soviet10year-textbooks/artifacts/8a');
const lesson = path.join(book, 'editions/modern-us-neutral/lessons/alg8-c4-s2-n26');
const target = path.join(book, 'evidence/resume182-6-8a-N26-8108');
assert.ok(!fs.existsSync(target));
const bind = file => {
  const bytes = fs.readFileSync(file);
  return { path: path.relative(repo, file), bytes: bytes.length, sha256: crypto.createHash('sha256').update(bytes).digest('hex') };
};
const keys = JSON.parse(fs.readFileSync(path.join(lesson, 'answer-keys.json'), 'utf8'));
const candidate = JSON.parse(fs.readFileSync(path.join(scratch, 'answers-8a-N26-author-candidate-GRADING-RECOVERY1.json'), 'utf8'));
assert.deepEqual(keys, { ...candidate, status: 'ready', count: 20 });
const audit = JSON.parse(fs.readFileSync(path.join(lesson, 'answer-keys.audit.json'), 'utf8'));
assert.equal(audit.status, 'pass');
assert.equal(audit.auto, 10);
assert.equal(audit.ungraded, 10);
const answerReview = path.join(scratch, 'answers-8a-N26-review-FIRST/review-GRADING-RECOVERY1.record');
assert.equal(bind(answerReview).sha256, '2fb7f556f9e307797e2d17ea19c2d62cc89a53d36f85b16eace6580cc01ed2f9');
const choiceReview = JSON.parse(fs.readFileSync(path.join(lesson, 'choice-set/review.json'), 'utf8'));
assert.equal(choiceReview.outcome, 'pass');
const captures = ['written', 'practice'].map(mode => ({
  mode, data: JSON.parse(fs.readFileSync(path.join(scratch, `display-8a-N26-${mode}-FIRST/capture.record`), 'utf8')),
}));
const observationsDir = path.join(scratch, 'display-N26-observers');
const observations = fs.readdirSync(observationsDir).filter(f => f.endsWith('.record')).map(name => {
  const filename = path.join(observationsDir, name);
  return { filename, data: JSON.parse(fs.readFileSync(filename, 'utf8')) };
});
const approved = new Set();
for (const { data } of observations) {
  assert.equal(data.status, 'PASS');
  assert.ok(data.frames.length <= 8);
  const mode = data.captureMode || 'written';
  const capture = captures.find(c => c.mode === mode).data;
  for (const frame of data.frames) {
    const actual = capture.frames.find(f => f.index === frame.index);
    assert.ok(actual);
    assert.equal(frame.sha256, actual.sha256);
    assert.equal(frame.status, 'PASS');
    assert.ok(frame.evidence?.trim());
    const key = `${mode}:${frame.index}`;
    assert.ok(!approved.has(key), `Duplicate observation: ${key}`);
    approved.add(key);
  }
}
for (const { mode, data } of captures) {
  assert.equal(data.status, 'RUNTIME_PASS_NEW_PIXELS_PENDING');
  assert.deepEqual(data.errors, []);
  assert.deepEqual(data.externalRequests, []);
  for (const input of data.inputs) assert.equal(bind(input.path).sha256, input.sha256);
  for (const f of data.frames) {
    assert.equal(bind(f.path).sha256, f.sha256);
    assert.ok(approved.has(`${mode}:${f.index}`), `Unobserved frame: ${mode}:${f.index}`);
  }
  for (const s of data.surfaces) assert.equal(bind(s.file.path).sha256, s.file.sha256);
}
fs.mkdirSync(target, { recursive: true });
const retained = [];
const retain = (src, relative) => {
  const dest = path.join(target, relative);
  fs.mkdirSync(path.dirname(dest), { recursive: true });
  fs.copyFileSync(src, dest, fs.constants.COPYFILE_EXCL);
  assert.equal(bind(dest).sha256, bind(src).sha256);
  retained.push(bind(dest));
  return bind(dest);
};
const records = [
  'source-N26-author-FIRST.record', 'source-N26-reuse159.record',
  'source-N26-review-FIRST/source-observations-FIRST.record',
  'source-N26-review-FIRST/source-manuscript-comparison-FIRST.record',
  'source-N26-review-FIRST/source-manuscript-comparison-TEXTRECOVERY1.record',
  'source-N26-review-FIRST/line21-glyph-DETAIL1.record',
  'source-N26-review-FIRST/erratum161-math-DETAIL1.record',
  'source-N26-detail161-FIRST/crop.record',
  'source-N25-review-FIRST/source-manuscript-comparison-FIRST.record',
  'source-N25-review-FIRST/source-manuscript-comparison-TEXTRECOVERY1.record',
  'answers-8a-N26-author-FIRST.record',
  'answers-8a-N26-author-candidate-FIRST.json',
  'answers-8a-N26-author-candidate-GRADING-RECOVERY1.json',
  'answers-8a-N26-grading-GRADING-RECOVERY1.record',
  'answers-8a-N26-review-FIRST/independent-solutions.record',
  'answers-8a-N26-review-FIRST/review-FIRST.record',
  'answers-8a-N26-review-FIRST/review-GRADING-RECOVERY1.record',
  'choice-review-spawn-FIRST.record',
  'choices-8a-N26-FIRST/source-solutions-FIRST.record',
  'choices-8a-N26-FIRST/draft.json',
  'choices-8a-N26-FIRST/author-FIRST.record',
  'choices-8a-N26-views-FIRST.json', 'project-N26-choice-views-FIRST.mjs',
  'repair-N26-table-RECOVERY1.mjs',
  'execute.mjs', 'display-N26.mjs', 'repair-N26-grading-RECOVERY1.mjs',
  'stage-N26-answers-FIRST.mjs', 'stage-N26.mjs', 'retain-N26-source-modern.py', 'retain-N26-final.mjs',
  'record-N26-parent-display-FIRST.mjs', 'record-N26-parent-batch2-FIRST.mjs',
  'layout-before160-FIRST.py', 'layout-before159-FIRST.py',
  'test-fraction-following-sentence-FIRST.py',
];
for (const relative of records) retain(path.join(scratch, relative), `records/${relative}.record`);
retain(path.join(scratch, 'source-N26-detail161-FIRST/line21.png'), 'source-detail/line21.png');
for (const directory of [
  'source-N26-page160-failed-FIRST', 'source-N26-page160-beforeTEXT1', 'source-N26-page161-beforeTEXT1',
  'N26-retain-source-modern-FIRST', 'choices-8a-N26-review-FIRST', 'choices-8a-N26-TABLE-RECOVERY1',
]) {
  for (const name of fs.readdirSync(path.join(scratch, directory))) {
    const src = path.join(scratch, directory, name);
    if (fs.statSync(src).isFile()) retain(src, `records/${directory}/${name}.record`);
  }
}
for (const name of fs.readdirSync(scratch)) {
  const dir = path.join(scratch, name);
  const receipt = path.join(dir, 'execution.json');
  if (!fs.statSync(dir).isDirectory() || !fs.existsSync(receipt)) continue;
  if (!name.includes('N26') && ![
    'test-underlined-prose-FIRST', 'test-fraction-160-FIRST', 'test-brace-160-FIRST',
    'source-8a-159-counter-160PATCH', 'source-8a-N25-layoutTests-RECOVERY1',
    'source-8a-N25-existingFractionTests-RECOVERY2',
    'supervision-fetch-1516Z-FIRST', 'supervision-fetch-1603Z-FIRST',
  ].includes(name)) continue;
  for (const file of ['execution.json', 'stdout', 'stderr']) retain(path.join(dir, file), `records/executions/${name}/${file}.record`);
}
for (const { filename } of observations) retain(filename, `observations/${path.basename(filename)}`);
const frames = [];
for (const { mode, data } of captures) {
  retain(path.join(scratch, `display-8a-N26-${mode}-FIRST/capture.record`), `captures/${mode}.record`);
  for (const surface of data.surfaces.filter(s => s.viewport.width === 1440)) retain(surface.file.path, `${surface.surface}.html`);
  for (const frame of data.frames) frames.push({ captureMode: mode, index: frame.index, surface: frame.surface, viewport: frame.viewport, scrollY: frame.scrollY, horizontalState: frame.horizontalState, ...retain(frame.path, `screenshots/${mode}/${path.basename(frame.path)}`) });
}
const source = [];
for (let page = 159; page <= 165; page++) {
  for (const file of ['page.md', 'page.json', 'audit.json']) source.push(bind(path.join(book, `pages/${String(page).padStart(4, '0')}/${file}`)));
}
const artifacts = ['lesson.json', 'exercises.json', 'figures.json', 'adaptation.audit.json', 'answer-keys.json', 'answer-keys.audit.json', 'choice-set/seed.json', 'choice-set/draft.json', 'choice-set/review.json'].map(file => bind(path.join(lesson, file)));
const binding = {
  at: new Date().toISOString(), workdir: repo, book: '8a', lesson: 'alg8-c4-s2-n26',
  status: 'SOURCE_MODERN_ANSWERS_CHOICES_COMPLETE_OFFLINE_DISPLAY_PASS',
  source, artifacts, retained, frames, actualNewImagesObserved: approved.size,
  existingSourceOrAnswerOrChoicePassReruns: 0, oldTreeMigrationBytes: 0,
  sourceTableMethod489: { status: 'HOLD_RETAINED', lookupCount: 0, precision: 'UNKNOWN', derivedDisplayApproved: true },
  authoredTableMethod489: { originalSourceTableRecovered: false, rows: 11, precision: 'six decimal places; final four places', authorLookupCount: 8, independentChoiceReview: artifacts.find(f => f.path.endsWith('choice-set/review.json')) },
  sourceConventionN14: 'HOLD_UNCHANGED', sourceGlyphN25: 'HOLD_UNCHANGED',
  n27Boundary: 'INCOMPLETE_AND_SOURCE_FIGURE_DETAIL_HOLD_NOT_PROMOTED',
  source159UnknownIntermediateFailedAuditBytesRecovered: false,
  finish: 'review', dbWrites: 0, planeWrites: 0, merge: 0, deploy: 0,
  fullProductOrWholeTicketAcceptance: false, hostTokenUsageAndCost: null,
};
const output = path.join(target, 'binding.record');
fs.writeFileSync(output, `${JSON.stringify(binding, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ ...bind(output), observed: approved.size, retainedBytes: retained.reduce((n, f) => n + f.bytes, 0) }, null, 2));
