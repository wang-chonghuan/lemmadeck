  "concept_candidates": [
    {
      "block": 0,
      "text": "\u6211\u4eec\u77e5\u9053\u7b97\u672f\u5e73\u65b9\u6839\u5177\u6709\u4e0b\u5217\u6027\u8d28\uff1a"
    },
    {
      "block": 1,
      "text": "\u5982\u679c $a\\geqslant0$\uff0c$b\\geqslant0$\uff0c\u90a3\u4e48 $\\sqrt{ab}=\\sqrt{a}\\cdot\\sqrt{b}$\uff1b"
    },
    {
      "block": 2,
      "text": "\u5982\u679c $a\\geqslant0$\uff0c$b>0$\uff0c\u90a3\u4e48 $\\sqrt{\\frac{a}{b}}=\\frac{\\sqrt{a}}{\\sqrt{b}}$\u3002"
    },
    {
      "block": 3,
      "text": "$n$ \u6b21\u7b97\u672f\u6839\uff08\u5f53 $n>2$ \u65f6\uff09\u5177\u6709\u7c7b\u4f3c\u7684\u6027\u8d28\u3002"
    },
    {
      "block": 4,
      "text": "\u5b9a\u7406 $1$ **\u5982\u679c $a\\geqslant0$\uff0c$b\\geqslant0$\uff0c\u90a3\u4e48 $\\sqrt[n]{ab}=\\sqrt[n]{a}\\cdot\\sqrt[n]{b}$\u3002\n**"
    },
    {
      "block": 5,
      "text": "\u5b9a\u7406 $2$ **\u5982\u679c $a\\geqslant0$\uff0c$b>0$\uff0c\u90a3\u4e48 $\\sqrt[n]{\\frac{a}{b}}=\\frac{\\sqrt[n]{a}}{\\sqrt[n]{b}}$\u3002\n**"
    },
    {
      "block": 6,
      "text": "\u6211\u4eec\u6765\u8bc1\u660e\u5b9a\u7406 $1$\u3002"
    },
    {
      "block": 7,
      "text": "\u5f0f $\\sqrt[n]{a}\\cdot\\sqrt[n]{b}$ \u7684\u503c\u662f\u975e\u8d1f\u6570\uff0c\u56e0\u4e3a\u5f53 $a\\geqslant0$ \u548c $b\\geqslant0$ \u65f6\uff0c\u5176\u4e2d\u6bcf\u4e00\u4e2a\u5f0f\u5b50\u90fd\u6709\u610f\u4e49\u5e76\u4e14\u53d6\u975e\u8d1f\u503c\u3002\n\u6b64\u5916\uff0c\u79ef $\\sqrt[n]{a}\\cdot\\sqrt[n]{b}$\u7684 $n$ \u6b21\u5e42\u7b49\u4e8e $ab$\uff0c\u5c31\u662f\uff1a\n$(\\sqrt[n]{a}\\cdot\\sqrt[n]{b})^n=(\\sqrt[n]{a})^n\\cdot(\\sqrt[n]{b})^n=ab$\u3002"
    },
    {
      "block": 8,
      "text": "\u6240\u4ee5\uff0c\u6839\u636e $n$ \u6b21\u7b97\u672f\u6839\u7684\u5b9a\u4e49\uff0c\u7b49\u5f0f $\\sqrt[n]{ab}=\\sqrt[n]{a}\\cdot\\sqrt[n]{b}$ $(a\\geqslant0,b\\geqslant0)$ \u662f\u771f\u7b49\u5f0f\u3002"
    },
    {
      "block": 9,
      "text": "\u56e0\u6b64\uff0c\u5f53 $n$ \u662f\u4efb\u4f55\u81ea\u7136\u6570\u65f6\uff0c\u4e24\u4e2a\u975e\u8d1f\u56e0\u6570\u7684\u79ef\u7684 $n$ \u6b21\u7b97\u672f\u6839\u7b49\u4e8e\u8fd9\u4e24\u4e2a\u56e0\u6570\u7684 $n$ \u6b21\u7b97\u672f\u6839\u7684\u79ef\u3002"
    },
    {
      "block": 10,
      "text": "\u901a\u8fc7\u7c7b\u4f3c\u7684\u8ba8\u8bba\uff0c\u53ef\u4ee5\u8bc1\u660e $n$ \u6b21\u7b97\u672f\u6839\u7684\u7b2c\u4e8c\u4e2a\u6027\u8d28\uff08\u5b9a\u7406 $2$\uff09\uff1a\u5f53 $n$ \u662f\u4efb\u4f55\u81ea\u7136\u6570\u65f6\uff0c\u5206\u5b50\u662f\u975e\u8d1f\u6570\u800c\u5206\u6bcd\u662f\u6b63\u6570\u7684\u5206\u6570\u7684 $n$ \u6b21\u7b97\u672f\u6839\u7b49\u4e8e\u5206\u5b50\u7684 $n$ \u6b21\u7b97\u672f\u6839\u9664\u4ee5\u5206\u6bcd\u7684 $n$ \u6b21\u7b97\u672f\u6839\u3002"
    },
    {
      "block": 11,
      "text": "\u6211\u4eec\u4e3e\u51fa\u5e94\u7528\u8fd9\u4e24\u4e2a\u5b9a\u7406\u7684\u4f8b\u5b50\u3002"
    },
    {
      "block": 12,
      "text": "\u4f8b $1$ \u6c42\u5f0f $\\sqrt[4]{16\\times81}$ \u7684\u503c\u3002"
    },
    {
      "block": 13,
      "text": "\u6839\u636e\u5b9a\u7406 $1$ \u5f97\uff1a\n$\\sqrt[4]{16\\times81}=\\sqrt[4]{16}\\times\\sqrt[4]{81}=2\\times3=6$\u3002"
    },
    {
      "block": 14,
      "text": "\u4f8b $2$ \u5316\u7b80 $\\sqrt[3]{2}\\times\\sqrt[3]{4}$\u3002"
    },
    {
      "block": 15,
      "text": "\u6211\u4eec\u5199\u51fa\u7b49\u5f0f $\\sqrt[n]{ab}=\\sqrt[n]{a}\\cdot\\sqrt[n]{b}$\uff08$a\\geqslant0,b\\geqslant0$\uff09\uff0c\u6216\u5199\u6210\u53e6\u4e00\u5f62\u5f0f\uff1a\n$\\sqrt[n]{a}\\cdot\\sqrt[n]{b}=\\sqrt[n]{ab}$\u3002\n\u5229\u7528\u8fd9\u4e2a\u7b49\u5f0f\uff0c\u5f97\u5230\uff1a\n$\\sqrt[3]{2}\\times\\sqrt[3]{4}=\\sqrt[3]{2\\times4}=\\sqrt[3]{8}=2$\u3002"
    },
    {
      "block": 16,
      "text": "\u4f8b $3$ \u6c42\u5f0f $\\sqrt[3]{2\\frac{10}{27}}$ \u7684\u503c\u3002"
    },
    {
      "block": 17,
      "text": "\u6839\u636e\u5b9a\u7406 $2$\uff0c\u5f97$\\sqrt[3]{2\\frac{10}{27}}=\\sqrt[3]{\\frac{64}{27}}=\\frac{\\sqrt[3]{64}}{\\sqrt[3]{27}}=\\frac{4}{3}=1\\frac{1}{3}$\u3002"
    },
    {
      "block": 18,
      "text": "\u73b0\u5728\uff0c\u6211\u4eec\u8ba8\u8bba $n$ \u6b21\u7b97\u672f\u6839\u7684\u5176\u4ed6\u6027\u8d28\u3002\n\u6211\u4eec\u4ece\u4f8b\u5b50\u7740\u624b\u3002"
    },
    {
      "block": 19,
      "text": "\u5047\u8bbe\u9700\u8981\u6bd4\u8f83\u6839\u5f0f $\\sqrt{\\sqrt[3]{64}}$ \u548c $\\sqrt[6]{64}$ \u7684\u503c\u7684\u5927\u5c0f\uff0c$\\sqrt{\\sqrt[3]{64}}=\\sqrt{4}=2$\uff0c $\\sqrt[6]{64}=\\sqrt[6]{2^6}=2$\u3002"
    },
    {
      "block": 20,
      "text": "\u6211\u4eec\u770b\u5230\uff0c\u8fd9\u4e24\u4e2a\u5f0f\u5b50\u7684\u503c\u76f8\u7b49\uff0c\u4e5f\u5c31\u662f\uff0c$\\sqrt{\\sqrt[3]{64}}=\\sqrt[6]{64}$\u3002"
    },
    {
      "block": 21,
      "text": "\u5b9a\u7406 $3$ \u5982\u679c $a\\geqslant0$\uff0c\u90a3\u4e48 $\\sqrt[n]{\\sqrt[k]{a}}=\\sqrt[nk]{a}$\uff08$n$ \u548c $k$ \u662f\u81ea\u7136\u6570\uff09\u3002"
    },
    {
      "block": 22,
      "text": "\u5f0f $\\sqrt[n]{\\sqrt[k]{a}}$ \u7684\u503c\u662f\u975e\u8d1f\u7684\uff0c\u6b64\u5916\uff0c\u5f0f $\\sqrt[n]{\\sqrt[k]{a}}$ \u7684 $nk$ \u6b21\u5e42\u7b49\u4e8e $a$\u3002"
    },
    {
      "block": 23,
      "text": "\u5b9e\u9645\u4e0a\uff1a\n$(\\sqrt[n]{\\sqrt[k]{a}})^{nk}=((\\sqrt[n]{\\sqrt[k]{a}})^n)^k=(\\sqrt[k]{a})^k=a$\u3002"
    },
    {
      "block": 24,
      "text": "\u4e8e\u662f\uff0c\u6839\u636e $n$ \u6b21\u7b97\u672f\u6839\u7684\u5b9a\u4e49\uff0c\u7b49\u5f0f $\\sqrt[n]{\\sqrt[k]{a}}=\\sqrt[nk]{a}$\uff08$a\\geqslant0$\uff09\u662f\u771f\u7b49\u5f0f\u3002"
    },
    {
      "block": 25,
      "text": "\u5b9a\u7406 $4$ \u5982\u679c $a\\geqslant0$\uff0c\u90a3\u4e48 $\\sqrt[nk]{a^{mk}}=\\sqrt[n]{a^m}$\uff08$n$\u3001$k$ \u548c $m$ \u662f\u81ea\u7136\u6570\uff09\u3002"
    },
    {
      "block": 26,
      "text": "\u6839\u636e\u5b9a\u7406 $3$ \u5f97\u5230\uff1a\n$\\sqrt[nk]{a^{mk}}=\\sqrt[n]{\\sqrt[k]{a^{mk}}}=\\sqrt[n]{\\sqrt[k]{(a^m)^k}}=\\sqrt[n]{a^m}$\u3002"
    },
    {
      "block": 27,
      "text": "\u6211\u4eec\u5df2\u7ecf\u8bc1\u660e\uff0c\u5982\u679c\u6839\u6307\u6570\u548c\u88ab\u5f00\u65b9\u5f0f\u7684\u5e42\u6307\u6570\u540c\u4e58\u4ee5\u6216\u8005\u540c\u9664\u4ee5\u540c\u4e00\u4e2a\u81ea\u7136\u6570\uff0c\u90a3\u4e48\u6839\u5f0f\u7684\u503c\u4e0d\u53d8\u3002"
    },
    {
      "block": 28,
      "text": "\u6709\u65f6\uff0c\u6211\u4eec\u628a\u6839\u5f0f\u7684\u8fd9\u4e2a\u6027\u8d28\u53eb\u505a\u6839\u5f0f\u7684\u57fa\u672c\u6027\u8d28\uff08\u548c\u5206\u5f0f\u7684\u57fa\u672c\u6027\u8d28\u7c7b\u4f3c\uff09\u3002"
    },
    {
      "block": 29,
      "text": "\u6211\u4eec\u4e3e\u4e00\u4e2a\u5e94\u7528\u5b9a\u7406 $3$ \u548c\u5b9a\u7406 $4$ \u7684\u4f8b\u5b50\u3002"
    },
    {
      "block": 30,
      "text": "\u5316\u7b80 $\\sqrt[3]{2\\sqrt{2}}$\u3002"
    },
    {
      "block": 31,
      "text": "\u628a\u56e0\u6570 $2$ \u79fb\u5230\u5e73\u65b9\u6839\u53f7\u4e0b\u9762\uff0c\u5f97\u5230\uff1a\n$\\sqrt[3]{2\\sqrt{2}}=\\sqrt[3]{\\sqrt{2^2\\times2}}=\\sqrt[3]{\\sqrt{2^3}}$\u3002"
    },
    {
      "block": 32,
      "text": "\u6839\u636e\u5b9a\u7406 $3$\uff0c\u5f97\uff1a\n$\\sqrt[3]{\\sqrt{2^3}}=\\sqrt[6]{2^3}$\u3002"
    },
    {
      "block": 33,
      "text": "\u5e94\u7528\u5b9a\u7406 $4$\uff0c\u5f97\uff1a\n$\\sqrt[6]{2^3}=\\sqrt{2}$\u3002"
    },
    {
      "block": 34,
      "text": "\u56e0\u6b64\uff0c$\\sqrt[3]{2\\sqrt{2}}=\\sqrt{2}$\u3002"
    }
  ],
  "figures": []
}
