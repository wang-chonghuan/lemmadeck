import copy
import hashlib
import json
from pathlib import Path
import shutil
import sys

REPO = Path("/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck")
assert Path.cwd() == REPO
TOOLS = REPO / ".claude/skills/ld-s10y-lesson/tools"
sys.path.insert(0, str(TOOLS))
import assemble as A

BASE = REPO / ".tmp/ld-s10y-lesson/resume182-6-3129"
SOURCE = REPO / "ssot-resources/soviet10year-textbooks/artifacts/8a"
RAW = BASE / "raw-N20-FIRST/8a"
WORK = RAW
STAGE = BASE / "assembly-N20-FIRST"
BOOK = STAGE / "artifacts/8a"
ID = "alg8-c3-s3-n20"
assert not BOOK.exists(), "Never replay an existing assembly"
entries = []


def digest(file):
    return hashlib.sha256(file.read_bytes()).hexdigest()


def copy_bytes(source, destination):
    assert not destination.exists()
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, destination)
    assert digest(source) == digest(destination)
    entries.append({
        "source": str(source.relative_to(REPO)),
        "path": str(destination.relative_to(REPO)),
        "sha256": digest(source), "bytes": source.stat().st_size,
    })


for page in range(113, 118):
    directory = (SOURCE if page == 113 else RAW) / f"pages/{page:04d}"
    audit = json.loads((directory / "audit.json").read_bytes())
    assert audit["errors"] == []
    assert audit["lines_md"] == audit["lines_printed"]
    for name in ("page.md", "page.json", "audit.json"):
        copy_bytes(directory / name, BOOK / f"pages/{page:04d}" / name)

full_stream = A.load_stream(BOOK)
start = next(i for i, block in enumerate(full_stream)
             if block["ref"] == "p0113#4")
assert full_stream[start]["kind"] == "h3"
assert A.SEC_NUM.match(A.B.text_of(full_stream[start])).group(1) == "20"
end = next(i for i, block in enumerate(full_stream[start + 1:], start + 1)
           if block["kind"] in ("h1", "h2", "h3"))
assert full_stream[end]["kind"] == "h3"
assert "补充习题" in A.B.text_of(full_stream[end])
assert full_stream[end]["page"] == 117

ancestors = []
ancestor_bindings = []
for page, kind in ((74, "h1"), (102, "h2")):
    file = SOURCE / f"pages/{page:04d}/page.json"
    doc = json.loads(file.read_bytes())
    matches = [
        {**block, "page": page, "printed_page": doc["meta"]["printed_page"],
         "ref": f"p{page:04d}#{i + 1}"}
        for i, block in enumerate(doc["blocks"]) if block["kind"] == kind
    ]
    assert len(matches) == 1
    ancestors.extend(matches)
    ancestor_bindings.append({
        "path": str(file.relative_to(REPO)), "sha256": digest(file),
        "refs": [block["ref"] for block in matches],
    })

selected = [*ancestors, *full_stream[start:end]]
merged, warnings = A.merge_across_pages(copy.deepcopy(selected))
assert not warnings, warnings
assert not any(block.get("open") for block in merged), "Incomplete target object"
figures = sorted({block["id"] for block in selected if block["kind"] == "fig"})
figure_sources = {}
for figure in figures:
    matches = list(WORK.glob(f"pages/*/figures/{figure}.png"))
    assert len(matches) == 1, figure
    figure_sources[figure] = str(matches[0].relative_to(REPO))
    for extension in ("png", "svg"):
        source = matches[0].with_suffix(f".{extension}")
        assert source.exists(), f"Vectorize new selected figure first: {figure}"
        copy_bytes(source, BOOK / f"figures/{figure}.{extension}")

original_loader = A.load_stream
A.load_stream = lambda book: copy.deepcopy(selected) if book == BOOK else original_loader(book)
try:
    result = A.run(BOOK, REPO / "ssot-resources/soviet10year-textbooks/toc/8a/zh.json",
                   TOOLS.parent / "profiles/soviet-cn.json", strict=True,
                   work=None, exercise_numbering="book")
finally:
    A.load_stream = original_loader
assert result == 0
index = json.loads((BOOK / "book.json").read_bytes())
assert index["audit"]["errors"] == []
assert [lesson["id"] for lesson in index["lessons"]] == [ID]
record = {
    "schema": "stemrobin-182/scoped-source-assembly@1",
    "status": "SCOPED_ASSEMBLY_PASS_NOT_SOURCE_APPROVAL",
    "ticket": "STEMROBIN-182", "book": "8a", "lesson": ID,
    "entries": entries, "selected_refs": [block["ref"] for block in selected],
    "boundary_refs": {
        "start": full_stream[start]["ref"], "excluded_right": full_stream[end]["ref"],
        "excluded_kind": full_stream[end]["kind"],
        "excluded_heading": A.B.text_of(full_stream[end]),
    },
    "exercise_count": index["lessons"][0]["exercises"], "figures": figures,
    "figure_sources": figure_sources, "reused_ancestors": ancestor_bindings,
    "source_block_indexes_preserved": True, "existing_assembler_used": True,
    "durable_promotions": 0, "old_lesson_assembly_reruns": 0, "image_views": 0,
    "unknown_historical_bytes_recovered": False, "database_writes": 0, "finish": "review",
}
out = STAGE / "assembly.record"
with out.open("x", encoding="utf-8") as handle:
    handle.write(json.dumps(record, ensure_ascii=True, indent=2) + "\n")
print(json.dumps({"path": str(out), "sha256": digest(out), "status": record["status"]}))
