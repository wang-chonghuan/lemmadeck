import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-6213/lemmadeck';
assert.equal(process.cwd(), repo);
const [name, ...sources] = process.argv.slice(2);
assert.match(name, /^[a-z][a-z0-9-]{0,79}$/u);
assert.ok(sources.length);
const root = 'ssot-resources/soviet10year-textbooks/artifacts/8a';
const target = `${root}/evidence/resume182-6-c2ex-${name}`;
assert.ok(!fs.existsSync(target));
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const existing = new Map(), retained = new Map(), entries = [];
function register(file) {
  if (!fs.existsSync(file)) return;
  const stat = fs.lstatSync(file);
  if (stat.isDirectory()) {
    for (const item of fs.readdirSync(file).sort()) register(path.join(file, item));
  } else if (stat.isFile()) existing.set(sha(fs.readFileSync(file)), file);
}
for (const edition of ['', '/editions/modern-us-neutral']) {
  register(`${root}${edition}/lessons/alg8-c2-ex`);
}
for (let page = 63; page <= 74; page++) {
  register(`${root}/pages/${String(page).padStart(4, '0')}`);
}
for (const book of ['6a', '7a', '8a']) {
  const evidence = `ssot-resources/soviet10year-textbooks/artifacts/${book}/evidence`;
  for (const name of fs.existsSync(evidence) ? fs.readdirSync(evidence).sort() : []) {
    const file = `${evidence}/${name}/retention.record`;
    if (!fs.existsSync(file)) continue;
    for (const entry of JSON.parse(fs.readFileSync(file)).entries ?? []) {
      if (entry.path?.startsWith('ssot-resources/') && !existing.has(entry.sha256)) {
        existing.set(entry.sha256, entry.path);
      }
    }
  }
}
function retain(source, destination) {
  const stat = fs.lstatSync(source);
  assert.ok(!stat.isSymbolicLink(), source);
  if (stat.isDirectory()) {
    for (const item of fs.readdirSync(source).sort()) {
      retain(path.join(source, item), path.join(destination, item));
    }
    return;
  }
  assert.ok(stat.isFile());
  const bytes = fs.readFileSync(source), digest = sha(bytes);
  let output = retained.get(digest) ?? existing.get(digest);
  if (output && (!fs.existsSync(output) || sha(fs.readFileSync(output)) !== digest)) {
    output = undefined;
  }
  if (!output) {
    output = destination.endsWith('.record') ? destination : `${destination}.record`;
    fs.mkdirSync(path.dirname(output), { recursive: true });
    fs.writeFileSync(output, bytes, { flag: 'wx' });
    retained.set(digest, output);
  }
  entries.push({ historical_path: source, path: output, sha256: digest, bytes: bytes.length });
}
for (const source of sources) {
  assert.ok(source.startsWith('.tmp/resume182-6-'));
  assert.ok(!source.split(path.sep).includes('.env'));
  retain(source, `${target}/${path.basename(source)}`);
}
fs.mkdirSync(target, { recursive: true });
const record = {
  schema: 'stemrobin-182/production-evidence-retention@1',
  ticket: 'STEMROBIN-182', book: '8a', lesson: 'alg8-c2-ex',
  date: new Date().toISOString(), evidence_package: name, entries,
  unique_files: retained.size, status: 'retained-existing-bytes-only',
  paths: 'historical_path is provenance; path binds durable bytes.',
  unknownHistoricalBytesRecovered: false, newContentOrRuntimeRuns: 0,
  hostTokens: 'unknown', totalCost: 'unknown', databaseWrites: 0, finish: 'review',
};
const file = `${target}/retention.record`;
fs.writeFileSync(file, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ path: file, sha256: sha(fs.readFileSync(file)),
  unique: retained.size, references: entries.length }));
