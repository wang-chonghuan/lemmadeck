import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/resume182-6-8a-n18-0789', id = 'alg8-c3-s3-n18';
const target = `${base}/modern-FIRST/adapt/8a/modern-us-neutral/lessons/${id}`;
const history = `${base}/modern-flow-recovery1`;
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bind = file => ({ path: path.resolve(file), sha256: sha(fs.readFileSync(file)) });
assert.ok(!fs.existsSync(history));
fs.mkdirSync(history);
const lessonPath = `${target}/lesson.template.json`;
const beforeBytes = fs.readFileSync(lessonPath), before = JSON.parse(beforeBytes);
fs.writeFileSync(`${history}/lesson.before.record`, beforeBytes, { flag: 'wx' });
const audit = `ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/${id}/adaptation.audit.json`;
assert.equal(JSON.parse(fs.readFileSync(audit)).status, 'fail');
fs.writeFileSync(`${history}/audit.before.record`, fs.readFileSync(audit), { flag: 'wx' });
let current = structuredClone(before), stable = false;
const attempts = [];
for (let i = 0; i < 5; i += 1) {
  const input = JSON.stringify(current);
  const result = spawnSync('.claude/skills/ld-s10y-lesson/.venv/bin/python', ['-c',
    'import json,sys;sys.path.insert(0,".claude/skills/ld-s10y-lesson/tools");import edition;d=json.load(sys.stdin);edition.normalize_lesson_layout(d);print(json.dumps(d,ensure_ascii=True))'],
  { cwd: repo, input, encoding: 'utf8', maxBuffer: 8 * 1024 * 1024,
    env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1' } });
  fs.writeFileSync(`${history}/normalization-${i + 1}.stdout.record`, result.stdout, { flag: 'wx' });
  fs.writeFileSync(`${history}/normalization-${i + 1}.stderr.record`, result.stderr, { flag: 'wx' });
  assert.equal(result.status, 0, result.stderr);
  const next = JSON.parse(result.stdout);
  attempts.push({ attempt: i + 1, returncode: result.status, inputSha256: sha(input),
    outputSha256: sha(result.stdout), changed: JSON.stringify(next) !== input });
  stable = JSON.stringify(next) === input;
  current = next;
  if (stable) break;
}
assert.ok(stable, 'Native layout did not stabilize; stop without promotion');
const restored = structuredClone(current);
restored.prose.forEach((item, index) => {
  assert.equal(item.text.replace(/\s/gu, ''), before.prose[index].text.replace(/\s/gu, ''));
  item.text = before.prose[index].text;
});
assert.deepEqual(restored, before);
current.section_breaks = [];
const flowInput = `${history}/flow-input.record`;
fs.writeFileSync(flowInput, `${JSON.stringify(current, null, 2)}\n`, { flag: 'wx' });
const flow = spawnSync(process.execPath, ['.claude/skills/ld-s10y-lesson/tools/prose_flow.mjs', flowInput],
  { cwd: repo, encoding: 'utf8', maxBuffer: 4 * 1024 * 1024 });
fs.writeFileSync(`${history}/flow.stdout.record`, flow.stdout, { flag: 'wx' });
fs.writeFileSync(`${history}/flow.stderr.record`, flow.stderr, { flag: 'wx' });
assert.equal(flow.status, 0, flow.stderr);
const boundaries = flow.stdout.split('\n').map(line => line.trim())
  .filter(line => line.startsWith('break: ')).map(line => JSON.parse(line.slice(7)));
const starts = ['\u7531\u7b49\u6bd4\u6570\u5217\u7684\u5b9a\u4e49\u5f97\u51fa',
  '\u6211\u4eec\u4e3e\u51fa\u51e0\u4e2a\u5229\u7528\u516c\u5f0f', '\u4f8b2', '\u4f8b3'];
current.section_breaks = boundaries.filter(item => starts.some(prefix => item.after.startsWith(prefix)));
assert.equal(current.section_breaks.length, starts.length);
fs.writeFileSync(lessonPath, `${JSON.stringify(current, null, 2)}\n`);
const check = spawnSync(process.execPath, ['.claude/skills/ld-s10y-lesson/tools/prose_flow.mjs', lessonPath],
  { cwd: repo, encoding: 'utf8', maxBuffer: 4 * 1024 * 1024 });
fs.writeFileSync(`${history}/flow-check.stdout.record`, check.stdout, { flag: 'wx' });
fs.writeFileSync(`${history}/flow-check.stderr.record`, check.stderr, { flag: 'wx' });
assert.equal(check.status, 0, check.stderr);
const file = `${history}/result.record`;
fs.writeFileSync(file, `${JSON.stringify({
  status: 'NATIVE_LAYOUT_STABILIZED_BOUNDARIES_REBOUND_NOT_TEXT_APPROVAL',
  book: '8a', lesson: id, edition: 'modern-us-neutral', attempts,
  before: bind(`${history}/lesson.before.record`), firstFailedAudit: bind(`${history}/audit.before.record`),
  after: bind(lessonPath), section_breaks: current.section_breaks,
  proseChangesOnlyWhitespace: true, exerciseChanges: 0, mathematicalChanges: 0,
  oldPassReruns: 0, sourceViews: 0, databaseWrites: 0, finish: 'review',
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(bind(file)));
