  "adaptations": [
    {
      "before": "const hidden = [];",
      "after": "const hidden = [];\n  const collectedTextNodes = new Set();"
    },
    {
      "before": "let offset = 0;",
      "after": "collectedTextNodes.add(node);\n    let offset = 0;"
    },
    {
      "before": "window.scrollBy({ top: rect.top + rect.height / 2 - innerHeight / 2, behavior: 'instant' });",
      "after": "window.scrollBy({ top: Math.ceil(rect.top + rect.height / 2 - innerHeight / 2), behavior: 'instant' });"
    },
    {
      "before": "left -= box.left + ancestor.clientLeft - rect.left;",
