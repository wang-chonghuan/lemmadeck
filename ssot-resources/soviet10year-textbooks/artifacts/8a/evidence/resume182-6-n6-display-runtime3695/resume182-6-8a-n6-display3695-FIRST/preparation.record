      "after": "top -= Math.ceil(box.top + ancestor.clientTop - rect.top);"
    },
    {
      "before": "top += rect.bottom - box.top - ancestor.clientTop - ancestor.clientHeight;",
      "after": "top += Math.ceil(rect.bottom - box.top - ancestor.clientTop - ancestor.clientHeight);"
    },
    {
      "before": "const expectedLabels = contract.labels ?? [];",
      "after": "if (!svg) throw new Error('This retained figure contract requires SVG');\n    const expectedTemplate = document.createElement('template');\n    expectedTemplate.innerHTML = contract.svgMarkup;\n    const expectedSvg = expectedTemplate.content.querySelector('svg');\n    const exactSvg = svg.outerHTML === expectedSvg.outerHTML;\n    const expectedLabels = contract.labels ?? [];"
    },
