      "before": "const labelBindings = expectedLabels.every((expected) => labels.some((actual) =>",
      "after": "const labelBindings = expectedLabels.length === labels.length && expectedLabels.every((expected) => labels.some((actual) =>"
    },
    {
      "before": "minimumPx: contract.minimumPx, expectedLayout: contract.layout,",
      "after": "minimumPx: contract.minimumPx, exactSvg, expectedLayout: contract.layout,"
    },
    {
      "before": "const scrollables = [...document.querySelectorAll('*')].filter((element) =>",
      "after": "const bodyText = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);\n  for (let node = bodyText.nextNode(); node; node = bodyText.nextNode()) {\n    if (!node.data.trim() || node.parentElement.closest('style,script,figure,.katex-mathml')) continue;\n    if (!collectedTextNodes.has(node)) throw new Error('Unbound actual DOM text: ' + node.data);\n  }\n  const scrollables = [...document.querySelectorAll('*')].filter((element) =>"
    },
    {
      "before": "rect.right > box.left + 0.5",
      "after": "rect.right > box.left"
    },
    {
      "before": "return { key, x: left - box.left, y: top - box.top,",
      "after": "return { key, x: Math.max(0, left - box.left), y: Math.max(0, top - box.top),"
    },
    {
      "before": "const decoded = PNG.sync.read(bytes);",
      "after": "const image = {\n      path: output, sha256: sha(bytes), viewport, surface, ...frame, newIds,\n      visualObservation: 'UNOBSERVED', nativeSize: true, fullPage: false, croppedOrResized: false,\n      captureChecks: 'PENDING',\n    };\n    images.push(image);\n    report.screenshots.push(image);\n    usage.screenshotsCaptured += 1;\n    await event({ screenshot: { path: output, sha256: image.sha256,\n      targetsVisible: frame.visibleIds.length, newTargets: newIds.length } });\n    const decoded = PNG.sync.read(bytes);"
    },
    {
      "before": "const image = {\n      path: output, sha256: sha(bytes), width: decoded.width, height: decoded.height, ink,\n      viewport, surface, ...frame, newIds,\n      visualObservation: 'UNOBSERVED', nativeSize: true, fullPage: false, croppedOrResized: false,\n    };\n    images.push(image);\n    report.screenshots.push(image);\n    usage.screenshotsCaptured += 1;\n    await event({ screenshot: { path: output, sha256: image.sha256,\n      targetsVisible: frame.visibleIds.length, newTargets: newIds.length } });",
      "after": "Object.assign(image, { width: decoded.width, height: decoded.height, ink, captureChecks: 'PASS' });"
    },
    {
      "before": "const covered = new Set();\n  const states = new Set();\n  const images = [];",
      "after": "const images = report.screenshots.filter(image => image.viewport.width === viewport.width\n    && image.surface === surface && image.captureChecks === 'PASS');\n  const covered = new Set(images.flatMap(image => image.visibleIds));\n  const states = new Set(images.map(image => JSON.stringify([image.scroll, image.scrollables])));"
    },
    {
      "before": "report.coverage.push(inventory);",
      "after": "report.coverage = report.coverage.filter(item =>\n    item.viewport.width !== viewport.width || item.surface !== surface);\n  report.coverage.push(inventory);"
