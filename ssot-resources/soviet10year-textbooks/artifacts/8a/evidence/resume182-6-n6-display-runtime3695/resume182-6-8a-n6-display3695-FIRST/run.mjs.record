async function waitForInputs() {
  const deadline = Date.now() + waitSeconds * 1000;
  let last;
  do {
    try { return await preparedInputs(); }
    catch (error) {
      last = error;
      // Pins and already present but invalid inputs are real failures, not waiting conditions.
      if (!['ENOENT', 'PRECONDITIONS_PENDING'].includes(error.code)) throw error;
      if (Date.now() >= deadline) break;
      await new Promise(resolve => setTimeout(resolve, Math.min(1000, deadline - Date.now())));
    }
  } while (Date.now() <= deadline);
  throw new Error(`PRECONDITIONS_NOT_READY: ${last.message}`);
}
