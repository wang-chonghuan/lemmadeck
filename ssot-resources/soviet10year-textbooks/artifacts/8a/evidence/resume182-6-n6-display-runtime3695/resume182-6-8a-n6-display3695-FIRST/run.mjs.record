    const bytes = await readBound(filename, expectedHash);
    await check(`${name}:no-private-choice-key-intent-or-source-payload`, !leakage.test(bytes.toString('utf8')));
    html.set(`/${name}`, bytes);
  }
  server = createServer((request, response) => {
    network.served.push({ method: request.method, path: request.url });
    if (request.method === 'GET' && request.url === '/favicon.ico') return void response.writeHead(204).end();
    const bytes = request.method === 'GET' ? html.get(request.url) : undefined;
    if (!bytes) return void response.writeHead(404).end();
    response.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store',
      'Content-Security-Policy': "default-src 'none'; style-src 'unsafe-inline'; font-src data:; img-src data:; script-src 'none'; connect-src 'none'; frame-src 'none'; form-action 'none';" }).end(bytes);
  });
  await new Promise((resolve, reject) => { server.once('error', reject); server.listen(0, '127.0.0.1', resolve); });
  report.cleanup.serverClosed = false;
  origin = `http://127.0.0.1:${server.address().port}`;
  for (const [route, bytes] of html) {
    const response = await fetch(`${origin}${route}`, { signal: AbortSignal.timeout(5000) });
    assert.equal(response.status, 200); assert.equal(sha(Buffer.from(await response.arrayBuffer())), sha(bytes));
  }
  usage.browserLaunches += 1;
  browser = await chromium.launch({ headless: true, timeout: 30000, downloadsPath: path.join(RUN, 'browser-tmp'),
    env: { PATH: '/usr/bin:/bin:/usr/sbin:/sbin', LANG: 'en_US.UTF-8', TMPDIR: path.join(RUN, 'browser-tmp') },
    args: ['--disable-background-networking', '--disable-component-update', '--disable-sync', '--no-first-run',
      '--disable-default-apps', '--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE 127.0.0.1'] });
  report.cleanup.browserClosed = false;
  report.browser = { family: 'Chromium', version: browser.version(), headless: true, isolated: true,
    installedInApp: true, limitation: 'Not headed application acceptance' };
  for (const viewport of [{ width: 1440, height: 960 }, { width: 390, height: 844 }]) {
    const pending = ['text', 'exercises', 'choices'].filter(surface =>
      !report.completedViews.includes(`${viewport.width}:${surface}`));
    if (!pending.length) continue;
    const context = await browser.newContext({ viewport, deviceScaleFactor: 1, serviceWorkers: 'block', acceptDownloads: false });
    contexts.push(context); usage.browserContexts += 1;
    context.setDefaultTimeout(20000);
    await context.route('**/*', async route => {
      const request = route.request(), url = new URL(request.url());
      if (request.method() === 'GET' && url.origin === origin && !url.search && !url.hash
        && [...html.keys(), '/favicon.ico'].includes(url.pathname)) await route.continue();
      else { network.blocked.push({ method: request.method(), url: request.url() }); await route.abort('blockedbyclient'); }
    });
    await context.routeWebSocket(/.*/, async socket => { network.blocked.push({ kind: 'websocket' }); await socket.close(); });
    const page = await context.newPage();
    page.on('pageerror', error => network.pageErrors.push(error.message));
    page.on('console', message => { if (message.type() === 'error') network.consoleErrors.push(message.text()); });
    page.on('requestfailed', request => network.failures.push({ url: request.url(), error: request.failure() }));
    page.on('response', response => { if (response.status() >= 400) network.badResponses.push({ url: response.url(), status: response.status() }); });
    for (const surface of pending) {
      usage.pageNavigations += 1;
      const response = await page.goto(`${origin}/${surface}.html`, { waitUntil: 'load' });
      assert.equal(response.status(), 200); await page.evaluate(() => document.fonts.ready);
      assertOfflineRuntime(); await expect(page.locator('h1')).toBeVisible();
      const materials = [];
      const add = (key, selector, index, expected, paragraph = false) => materials.push({ key, selector, index, expected, paragraph });
      const title = lesson.printed_title || lesson.title;
      add('title', 'h1', 0, projection(surface === 'text' ? title : `${title} · ${surface === 'exercises' ? '\u4e60\u9898' : '\u9009\u62e9\u9898'}`));
      const crumb = surface === 'choices' ? '' : [lesson.chapter, lesson.section, `\u5370\u5237\u9875 ${lesson.start_printed ?? '?'}`].filter(Boolean).join(' \u00b7 ');
      add('crumb', '.crumb', 0, projection(crumb));
      if (surface === 'text') {
        await expect(page.locator('p.para')).toHaveCount(paragraphs.length);
        for (const [index, paragraph] of paragraphs.entries()) add(`prose-${index}`, 'p.para', index, projection(paragraph.text), true);
        const caps = flow.filter(item => item.kind === 'cap');
        await expect(page.locator('.figcap')).toHaveCount(caps.length);
        for (const [index, cap] of caps.entries()) add(`caption-${index}`, '.figcap', index, projection(cap.text));
        const ids = flow.filter(item => item.kind === 'fig').map(item => item.id);
        assert.deepEqual(await page.locator('figure').evaluateAll(nodes => nodes.map(node => node.id)), ids);
        assert.ok(ids.every(id => manifest.figures.some(figure => figure.id === id)));
        const actual = await page.locator('p.para').evaluateAll(nodes => nodes.flatMap((node, index) =>
          parseFloat(getComputedStyle(node).borderTopWidth) > 0 ? [index] : []));
        await check(`${viewport.width}:prose-current-source-blocks-and-anchored-rules`, same(actual, boundaries));
        add('jump', '.jump', 0, projection(`\u53bb\u505a\u9898 \u00b7 ${exercises.count} \u9053 \u2192`));
        await expect(page.getByRole('link')).toHaveAttribute('href', 'exercises.html');
      } else if (surface === 'exercises') {
        await expect(page.locator('li.ex')).toHaveCount(12);
        assert.deepEqual(await page.locator('li.ex').evaluateAll(nodes => nodes.map(node => node.id)),
          exercises.exercises.map(item => `ex-${item.number}`));
        for (const exercise of exercises.exercises) {
          const display = writtenText(exercise);
          add(`exercise-${exercise.number}`, `#ex-${exercise.number} .body`, 0, projection(display.text));
          add(`number-${exercise.number}`, `#ex-${exercise.number} .no`, 0, projection(display.number));
        }
        const groups = exercises.exercises.filter((item, index, all) =>
          item.group !== (index === 0 ? null : all[index - 1].group));
        await expect(page.locator('.exgroup')).toHaveCount(groups.length);
        for (const [index, group] of groups.entries()) add(`group-${index}`, '.exgroup', index, projection(group.group || '\u7ec3\u4e60'));
        assert.deepEqual(await page.locator('figure').evaluateAll(nodes => nodes.map(node => node.id)),
          exercises.exercises.flatMap(item => (item.figures ?? []).map(figure => figure.id)));
        add('jump', '.jump', 0, projection('\u2190 \u56de\u8bfe\u6587'));
        await expect(page.getByRole('link')).toHaveAttribute('href', 'text.html');
      } else {
        await expect(page.locator('.choice')).toHaveCount(views.length);
        await expect(page.locator('.choice-options > li')).toHaveCount(report.projection.options);
        await expect(page.locator('a,link')).toHaveCount(0);
        for (const [index, view] of views.entries()) {
          const selector = `.choice:nth-of-type(${index + 1})`;
          add(`choice-${index}-heading`, '.choice-heading', index, projection(`${index + 1}. ${view.mode === 'multiple' ? '\u591a\u9009' : '\u5355\u9009'}`));
          add(`choice-${index}-stem`, '.choice-stem', index, expectedChoice(view.stem));
          for (const [optionIndex, option] of view.options.entries()) {
            add(`choice-${index}-option-${optionIndex}`, `${selector} .choice-option-body`, optionIndex, expectedChoice(option.text));
            add(`choice-${index}-label-${optionIndex}`, `${selector} .option-id`, optionIndex, projection(String.fromCharCode(65 + optionIndex)));
          }
          assert.deepEqual(await page.locator(selector).locator('figure').evaluateAll(nodes => nodes.map(node => node.id)),
            [...view.figure_ids, ...view.options.flatMap(option => option.figure_ids)]);
        }
      }
      const dom = await page.evaluate(installDisplayTools, {
        materials: materials.map(({ expected, paragraph, ...descriptor }) => descriptor), figureContracts,
        reuseReachability: passedNames.has(`${viewport.width}:${surface}:every-glyph-math-rule-and-media-edge-reachable`),
      });
      if (prior) {
        const previousDomPath = path.join(path.dirname(from), `${viewport.width}-${surface}-dom.json`);
        const previousDomInput = prior.inputs.find(input => input.path === previousDomPath)
          ?? prior.inputs.find(input => input.path.endsWith(`/${viewport.width}-${surface}-dom.json`));
        if (previousDomInput) {
          const previousDom = JSON.parse(await readBound(previousDomInput.path, previousDomInput.sha256));
          assert.deepEqual(dom.targets, previousDom.targets, 'Recovery receipts require stable actual DOM target IDs');
        } else assert.ok(!report.screenshots.some(shot => shot.viewport.width === viewport.width
          && shot.surface === surface), 'Cannot reuse captures without their target inventory');
      }
      await save(`${viewport.width}-${surface}-dom.json`, dom);
      await readBound(path.join(RUN, `${viewport.width}-${surface}-dom.json`));
      const reachability = `${viewport.width}:${surface}:every-glyph-math-rule-and-media-edge-reachable`;
      if (!passedNames.has(reachability)) await check(reachability,
        dom.hidden.length === 0 && dom.failed.length === 0 && dom.targetCount > 0
        && dom.ends.every(end => end.maximum === end.actual), { targets: dom.targetCount, hidden: dom.hidden, failed: dom.failed, ends: dom.ends });
      for (const material of materials) {
        const name = `${viewport.width}:${surface}:${material.key}:projected-text-formulas-subpart-rows`;
        if (passedNames.has(name)) continue;
        const actual = dom.roots.find(root => root.key === material.key), expected = material.expected;
        const literalLF = expected.literalLF !== false;
        const typography = !material.paragraph || parseFloat(actual.textIndent) === 0
          && actual.mathTypography.every(font => /KaTeX_Main/u.test(font.family) && font.px >= actual.fontPx * 1.1 - 0.02);
        const subparts = actual.lines.flatMap((line, index) => /^(?:[a-z]|\d+)\)\s/u.test(line) ? [index] : []);
        const rowComparisons = subparts.map(index => {
          let previous = index - 1;
          while (previous >= 0 && actual.lines[previous] === '') previous -= 1;
          return { index, previous, current: actual.lineGeometry[index], preceding: previous < 0 ? null : actual.lineGeometry[previous] };
        });
        const separateRows = rowComparisons.every(({ previous, current, preceding }) =>
          previous < 0 || current && preceding && current.top > preceding.top + 0.5);
        const tables = actual.tables.map(rows => rows.map(row => row.map(({ serialized, formulas, lines }) => ({ serialized, formulas, lines }))));
        await check(name, actual.serialized === expected.serialized
          && same(actual.formulas.map(formula => formula.tex), expected.formulas)
          && actual.formulas.every(formula => formula.visible && formula.nonempty)
          && (!literalLF || same(actual.lines, expected.lines)) && same(tables, expected.tables ?? [])
          && typography && separateRows, { textSha256: sha(actual.serialized), formulas: actual.formulas.length,
            formulasSha256: sha(JSON.stringify(actual.formulas.map(formula => formula.tex))),
            literalLF, typography, separateRows, rowComparisons, domTargets: actual.indices.length });
      }
      for (const figure of dom.figures) {
        const name = `${viewport.width}:${surface}:${figure.key}:current-figure-labels-native-minimum`;
        if (passedNames.has(name)) continue;
        await check(name, figure.exactSvg && figure.labelBindings
          && figure.labels.every(label => label.insideSvg && label.px >= figure.minimumPx)
          && figure.minimumPx >= 16 && figure.layout === figure.expectedLayout
          && figure.mediaWidth > 0 && figure.mediaHeight > 0 && figure.svgWidth === figure.mediaWidth
          && (figure.expectedWidth === null || figure.layout !== 'scroll' || figure.mediaWidth === figure.expectedWidth),
        { id: figure.id, exactSvg: figure.exactSvg, labels: figure.labels, mediaWidth: figure.mediaWidth,
          mediaHeight: figure.mediaHeight, requiredMinimumPx: figure.minimumPx });
      }
      const safety = await page.evaluate(pageSafety);
      await check(`${viewport.width}:${surface}:readonly-no-key-leakage-overflow-or-label-overlap`,
        safety.documentWidth <= viewport.width && safety.bodyWidth <= viewport.width && safety.scrollX === 0
        && safety.errors === 0 && safety.widgets === 0 && safety.scripts === 0
        && safety.dangerousAttributes.length === 0 && safety.labelBodyCollisions.length === 0
        && safety.sections.every((box, index, boxes) => box.left >= 0 && box.right <= viewport.width
          && box.height > 0 && (index === 0 || box.top >= boxes[index - 1].bottom))
        && safety.fonts.some(font => font.family.startsWith('KaTeX') && font.status === 'loaded')
        && safety.fonts.every(font => font.status !== 'error'), safety);
      await captureCoverage(page, viewport, surface, dom);
      await readBound(path.join(RUN, `${viewport.width}-${surface}-coverage.json`));
      const after = await page.evaluate(pageSafety);
      await check(`${viewport.width}:${surface}:wholepage-still-contained-after-all-native-scrolls`,
        after.documentWidth <= viewport.width && after.bodyWidth <= viewport.width && after.scrollX === 0);
      report.completedViews.push(`${viewport.width}:${surface}`);
    }
    await context.close(); contexts.splice(contexts.indexOf(context), 1);
  }
  await check('one-render-budget-six-current-n6-surfaces',
    usage.rendererCalls === (mode === '--first' ? 1 : 0)
    && (mode !== '--first' || usage.browserContexts === 2 && usage.pageNavigations === 6)
    && report.completedViews.length === 6
    && new Set(report.coverage.map(item => `${item.viewport.width}:${item.surface}`)).size === 6);
  await check('no-browser-errors-or-nonoffline-requests',
    network.served.every(item => item.method === 'GET' && [...html.keys(), '/favicon.ico'].includes(item.path)), network);
} catch (error) {
  report.executionFailure = { name: error.name, message: error.message, stack: error.stack };
  report.faults.push({ stage: mode, ...report.executionFailure, preserved: true });
  await event({ failure: report.executionFailure });
} finally {
  if (rendererChild) {
    const child = rendererChild;
    const closed = new Promise(resolve => child.once('close', resolve));
    child.kill('SIGKILL'); await closed; report.cleanup.rendererClosed = true;
  }
  for (const context of contexts) {
    try { await context.close(); } catch (error) { report.cleanup.contextsClosed = false; report.faults.push({ stage: 'context-close', message: error.message }); }
  }
  try { if (browser) await browser.close(); report.cleanup.browserClosed = true; }
  catch (error) { report.cleanup.browserClosed = false; report.faults.push({ stage: 'browser-close', message: error.message }); }
  try {
    if (server?.listening) { server.closeAllConnections(); await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve())); }
    report.cleanup.serverClosed = true;
  } catch (error) { report.cleanup.serverClosed = false; report.faults.push({ stage: 'server-close', message: error.message }); }
  for (const input of [...report.inputs, ...report.staged]) {
    try { assert.equal(sha(await readFile(input.path)), input.sha256); }
    catch (error) { report.faults.push({ stage: 'input-preservation', path: input.path, message: error.message }); }
  }
  report.network = network; report.finished = new Date().toISOString();
  const priorUsage = report.recovery?.cumulativePriorUsage;
  usage.cumulative = Object.fromEntries(Object.entries(usage)
    .filter(([key, value]) => typeof value === 'number'
      && !['observationBatchLimit', 'observationContextLimit'].includes(key))
    .map(([key, value]) => [key, value + (priorUsage?.cumulative?.[key] ?? priorUsage?.[key] ?? 0)]));
  report.status = report.executionFailure || report.faults.length || Object.values(report.cleanup).some(closed => !closed)
    ? 'FAIL' : 'RUNTIME_PASS_VISUAL_PENDING';
  if (report.status === 'FAIL') await save('failure-receipt.record', {
    firstFailure: report.executionFailure ?? report.faults[0], faults: report.faults,
    generatedFilesPreserved: true, cleanup: report.cleanup, noAutomaticRetry: true,
    rendererCalls: usage.rendererCalls, browserLaunches: usage.browserLaunches,
  });
  await save('report-FIRST.json', report);
  await save('usage-FIRST.json', usage);
  await save('visual-handoff.json', { status: 'PENDING', imagesObserved: 0, batchLimit: 8, contextLimit: 24,
    report: path.join(RUN, 'report-FIRST.json'), allPaths: report.screenshots.map(shot => shot.path),
    rule: 'Run the owned selector against actual receipts. Fresh bounded image reviewers inspect only its selected batches. No assumed observation or final binding.',
    domCoverageIsNotVisualApproval: true, screenshotsPreservedEvenIfRedundant: true });
  console.log(JSON.stringify({ status: report.status, report: path.join(RUN, 'report-FIRST.json'),
    usage: path.join(RUN, 'usage-FIRST.json'), screenshots: report.screenshots.length, imagesObserved: 0, cleanup: report.cleanup }));
  if (report.status === 'FAIL') process.exitCode = 1;
}
}
