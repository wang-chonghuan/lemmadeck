async function readBound(filename, expectedHash, entries = report.inputs) {
  assert.ok(!path.basename(filename).startsWith('.env'));
  const actual = await realpath(filename);
  const dependencyPin = prep.pins.find(pin => pin.path === filename && pin.existingDependencyLink);
  assert.ok(actual.startsWith(`${R}/`) || dependencyPin?.realpath === actual,
    `Input escaped current tree or pinned existing dependency: ${filename}`);
  const bytes = await readFile(filename);
  if (expectedHash) assert.equal(sha(bytes), expectedHash, `Input hash changed: ${filename}`);
  if (!entries.some(entry => entry.path === filename)) entries.push({ path: filename, bytes: bytes.length, sha256: sha(bytes) });
  return bytes;
}
async function stage(filename, bytes) {
