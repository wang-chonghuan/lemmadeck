  const number = Object.hasOwn(exercise, 'source_number') ? exercise.source_number : exercise.number;
  const prefix = number == null ? '' : String(number), suffix = exercise.text.slice(prefix.length);
  const prefixed = prefix && exercise.text.startsWith(prefix)
    && (/^\.\s/u.test(suffix) || /^\uFF0E(?![0-9\uFF10-\uFF19])/u.test(suffix));
