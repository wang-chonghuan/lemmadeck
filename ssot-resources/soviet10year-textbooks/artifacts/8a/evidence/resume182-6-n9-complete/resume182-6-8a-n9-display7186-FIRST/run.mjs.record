import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { createRequire } from 'node:module';
import { pathToFileURL } from 'node:url';
import { createDisplayHelpers } from '../resume182-6-8a-n3-display-FIRST/display-helper-recovery3.mjs';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-7186/lemmadeck';
assert.equal(process.cwd(), root);
const RUN = path.join(root, '.tmp/resume182-6-8a-n9-display7186-FIRST/runtime');
assert.ok(!fs.existsSync(RUN));
fs.mkdirSync(path.join(RUN, 'screenshots'), { recursive: true });
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const read = filename => fs.readFileSync(filename);
const id = 'alg8-c2-s2-n9';
const lessonRoot = `ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/${id}`;
const lesson = JSON.parse(read(`${lessonRoot}/lesson.json`));
const exercises = JSON.parse(read(`${lessonRoot}/exercises.json`));
assert.equal(lesson.status, 'ready');
assert.equal(exercises.exercises.length, 0);
assert.equal(lesson.figures.length, 0);
const originalHTML = `.tmp/resume182-6-8a-n9-render7186-FIRST/render/${id}/text.html`;
const inputHTML = read(originalHTML);
const stagedHTML = path.join(RUN, 'text.html');
fs.writeFileSync(stagedHTML, inputHTML, { flag: 'wx' });
const require = createRequire(path.join(root, 'app/package.json'));
const { chromium, expect } = require('@playwright/test');
const { proseFlow } = require(path.join(root, '.claude/skills/ld-s10y-lesson/tools/htmlfrag.js'));
const core = path.dirname(require.resolve('playwright-core/package.json'));
const { PNG } = require(path.join(core, 'lib/utilsBundle.js'));
const report = { status: 'RUNNING', checks: [], screenshots: [], coverage: [], views: [],
  inputHTML: { path: originalHTML, sha256: sha(inputHTML) },
  inputs: ['lesson.json', 'exercises.json', 'figures.json', 'adaptation.audit.json'].map(name =>
    ({ path: `${lessonRoot}/${name}`, sha256: sha(read(`${lessonRoot}/${name}`)) })),
  noInventedExercisesAnswersChoicesOrFigures: true, visualObservation: 'UNOBSERVED', errors: [] };
const usage = { screenshotsCaptured: 0, browserLaunches: 0, contexts: 0,
  rendererCalls: 0, imageObservations: 0, DBWrites: 0, sourceImageReopens: 0, hostUsage: 'unknown' };
const own = filename => {
  assert.ok(path.resolve(filename).startsWith(`${RUN}/`));
  return filename;
};
const save = async (name, data) => fs.writeFileSync(own(path.join(RUN, name)),
  `${JSON.stringify(data, null, 2)}\n`, { flag: 'wx' });
const event = async data => fs.appendFileSync(path.join(RUN, 'events.ndjson'), `${JSON.stringify(data)}\n`);
const check = async (name, passed, facts = {}) => {
  report.checks.push({ name, status: passed ? 'PASS' : 'FAIL', ...facts });
  assert.ok(passed, name);
};
const assertOfflineRuntime = () => assert.equal(report.errors.length, 0);
const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
const norm = text => String(text).normalize('NFC').replace(/\s+/gu, ' ').trim();
const { projection, installDisplayTools, pageSafety, captureCoverage } = createDisplayHelpers({
  norm, own, RUN, assertOfflineRuntime, PNG, same, sha, report, usage, event, save, check,
});
const browser = await chromium.launch({ headless: true });
usage.browserLaunches++;
try {
  for (const viewport of [{ width: 1440, height: 960 }, { width: 390, height: 844 }]) {
    const context = await browser.newContext({ viewport, deviceScaleFactor: 1 });
    usage.contexts++;
    try {
      const page = await context.newPage();
      const url = pathToFileURL(stagedHTML).href;
      await context.route('**/*', async route => {
        if (route.request().method() === 'GET' && route.request().url() === url) await route.continue();
        else { report.errors.push(route.request().url()); await route.abort(); }
      });
      page.on('pageerror', error => report.errors.push(error.message));
      await page.goto(url, { waitUntil: 'load' });
      await expect(page.locator('.para')).toHaveCount(4);
      await expect(page.locator('figure,.choice,li.ex')).toHaveCount(0);
      const blocks = proseFlow(lesson.prose, lesson.section_breaks);
      const materials = [
        { key: 'title', selector: 'h1', index: 0, expected: projection(lesson.printed_title) },
        ...blocks.map((block, index) =>
          ({ key: `paragraph-${index}`, selector: '.para', index, expected: projection(block.text) })),
        { key: 'crumb', selector: '.crumb', index: 0,
          expected: projection([lesson.chapter, lesson.section, `印刷页 ${lesson.start_printed}`].filter(Boolean).join(' · ')) },
        { key: 'navigation', selector: 'a.jump', index: 0, expected: projection('去做题 · 0 道 →') },
      ];
      const dom = await page.evaluate(installDisplayTools, {
        materials: materials.map(({ expected, ...item }) => item), figureContracts: {},
      });
      await save(`${viewport.width}-inventory.json`, dom);
      await check(`${viewport.width}:all-glyphs-reachable`, dom.hidden.length === 0
        && dom.failed.length === 0 && dom.targetCount > 0);
      for (const material of materials) {
        const actual = dom.roots.find(item => item.key === material.key);
        await check(`${viewport.width}:${material.key}:exact-prose-and-formulas`,
          actual.serialized === material.expected.serialized
          && same(actual.formulas.map(formula => formula.tex), material.expected.formulas)
          && actual.formulas.every(formula => formula.visible && formula.nonempty));
      }
      const safety = await page.evaluate(pageSafety);
      await check(`${viewport.width}:no-overflow-or-errors`, safety.documentWidth <= viewport.width
        && safety.bodyWidth <= viewport.width && safety.scrollX === 0
        && safety.errors === 0 && safety.widgets === 0 && safety.scripts === 0);
      await captureCoverage(page, viewport, 'text', dom);
      report.views.push({ viewport, status: 'CAPTURED_UNOBSERVED' });
    } finally {
      await context.close();
    }
  }
  report.status = 'CAPTURED_UNOBSERVED';
} catch (error) {
  report.status = 'FAIL';
  report.failure = { message: error.message, stack: error.stack };
  process.exitCode = 1;
} finally {
  await browser.close();
  report.cleanup = { browserClosed: true, contextsClosed: true, serverStarted: false };
  await save('report.json', report);
  await save('usage.json', usage);
}
console.log(JSON.stringify({ status: report.status, screenshots: report.screenshots.length,
  report: path.join(RUN, 'report.json') }));
