import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/resume182-6-8a-n12-0789';
const lesson = 'alg8-c3-s1-n12';
const finalRoot = `ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/${lesson}`;
const [templatePath, candidatePath] = process.argv.slice(2);
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bound = filename => {
  const absolute = path.resolve(filename);
  assert.ok(absolute.startsWith(`${repo}/`));
  assert.equal(fs.realpathSync(absolute), absolute);
  const bytes = fs.readFileSync(absolute);
  return { path: absolute, sha256: sha(bytes), bytes: bytes.length };
};
const read = filename => JSON.parse(fs.readFileSync(filename));
const textReviewPath = `${base}/modern-text-review-FIRST/result.record`;
const textReview = read(textReviewPath);
assert.equal(bound(textReviewPath).sha256, '59dac5c27657ae1b650724a7e90bba320c08c8cf0895f1da13e1de7219ca3691');
const approved = textReview.approved_text_bindings.exercises;
assert.equal(bound(approved.path).sha256, approved.sha256);
const finalExercisesPath = `${finalRoot}/exercises.json`;
const finalExercises = read(finalExercisesPath);
assert.equal(finalExercises.status, 'ready');
const approvedExercises = read(approved.path);
approvedExercises.status = finalExercises.status;
assert.deepEqual(finalExercises, approvedExercises);
const template = read(templatePath);
const candidate = read(candidatePath);
for (const value of [template, candidate]) {
  assert.equal(value.schema, 'ld-s10y-answer/lesson-answers@1');
  assert.equal(value.book, '8a');
  assert.equal(value.lesson, lesson);
  assert.equal(value.edition, 'modern-us-neutral');
}
const numbers = finalExercises.exercises.map(item => String(item.number));
assert.equal(numbers.length, 14);
assert.deepEqual(template.answers.map(item => item.exercise), numbers);
assert.deepEqual(candidate.answers.map(item => item.exercise), numbers);
for (const [index, answer] of candidate.answers.entries()) {
  const native = template.answers[index];
  assert.equal(native.prompt, finalExercises.exercises[index].text);
  assert.deepEqual(native.figureEvidence, []);
  assert.equal(answer.source, native.source);
  assert.equal(answer.bookRaw, native.bookRaw);
  assert.ok(answer.displayAnswer.trim());
  assert.ok(['auto', 'ungraded'].includes(answer.grading));
  assert.ok(answer.parts.every(part => part.judge !== 'exact'));
}
const record = {
  schema: 'stemrobin-182/native-answer-context-binding@1',
  status: 'NATIVE_CONTEXT_MATCHED_INDEPENDENT_ANSWER_REVIEW_PENDING',
  book: '8a', lesson, edition: 'modern-us-neutral',
  textReview: bound(textReviewPath), approvedExercises: approved,
  finalExercises: bound(finalExercisesPath), nativeTemplate: bound(templatePath),
  candidate: bound(candidatePath), questions: numbers,
  promptEquality: true, sourceAndBookRawEquality: true,
  candidateChanged: false, imageViews: 0, oldPassReruns: 0,
  databaseWrites: 0, finish: 'review', hostTokens: 'unknown', totalCost: 'unknown',
};
const output = `${base}/answer-context-binding.record`;
fs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(bound(output)));
