import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { createRequire } from 'node:module';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const own = '.tmp/resume182-6-8a-n12-0789/figure-author-FIRST';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bind = filename => ({ path: path.resolve(filename),
  sha256: sha(fs.readFileSync(filename)), bytes: fs.statSync(filename).size });
const pins = ['firstcandidate/tbl-p0081-01.spec.json', 'tbl-p0081-01.svg',
  'tbl-p0081-01.render.json', 'tbl-p0081-01.preview640.png'].map(name => bind(`${own}/${name}`));
const target = `${own}/tbl-p0081-01.preview640.browser-recovery4.png`;
assert.ok(!fs.existsSync(target));
const require = createRequire(path.resolve('app/package.json'));
const { chromium } = require('@playwright/test');
const browser = await chromium.launch({ headless: true });
let checks, screenshot;
try {
  const page = await browser.newPage({ viewport: { width: 640, height: 320 }, deviceScaleFactor: 1 });
  await page.route('**/*', route => route.abort());
  await page.setContent(`<html><head><style>html,body{margin:0;width:640px;height:320px;overflow:hidden;background:white}</style></head><body>${fs.readFileSync(pins[1].path, 'utf8')}</body></html>`);
  await page.evaluate(() => document.fonts.ready);
  checks = await page.evaluate(() => {
    const svg = document.querySelector('svg');
    const labels = [...svg.querySelectorAll('[data-label-id]')].map(node => {
      const bbox = node.getBBox(), computed = getComputedStyle(node);
      return { id: node.getAttribute('data-label-id'), text: node.textContent,
        fontSize: Number.parseFloat(computed.fontSize),
        box: { x: bbox.x, y: bbox.y, width: bbox.width, height: bbox.height } };
    });
    return { width: svg.getBoundingClientRect().width,
      height: svg.getBoundingClientRect().height, labels };
  });
  assert.equal(checks.width, 640);
  assert.equal(checks.height, 320);
  assert.equal(checks.labels.length, 22);
  assert.equal(checks.labels.find(label => label.id === 'r2-c1-label').text, 'a\u2099');
  assert.ok(checks.labels.every(label => label.fontSize >= 16 && label.box.width > 0
    && label.box.height > 0 && label.box.x >= 0 && label.box.y >= 0
    && label.box.x + label.box.width <= 640 && label.box.y + label.box.height <= 320));
  screenshot = await page.screenshot({ path: target, type: 'png', fullPage: false });
  assert.equal(sha(screenshot), bind(target).sha256);
} finally {
  await browser.close();
}
assert.deepEqual(pins.map(item => bind(item.path)), pins);
const record = {
  schema: 'stemrobin-182/native-browser-preview-recovery@1',
  status: 'NATIVE_BROWSER_PREVIEW_READY_INDEPENDENT_VISUAL_REVIEW_PENDING',
  book: '8a', lesson: 'alg8-c3-s1-n12', figure: 'tbl-p0081-01',
  edition: 'modern-us-neutral', preserved: pins, preview: bind(target), checks,
  nativeSvgChanged: false, nativeRendererReruns: 0,
  previewBrowserLaunches: 1, previewScreenshots: 1, parentImageViews: 0,
  priorAuthorImageViews: 2, recoveredPreviewImageViews: 0,
  cropOrResize: false, deviceScaleFactor: 1, networkRequestsPermitted: 0,
  browserClosed: true, databaseWrites: 0, finish: 'review',
  hostTokens: 'unknown', totalCost: 'unknown',
};
const output = `${own}/preview-browser-recovery4.record`;
fs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ record: bind(output), preview: bind(target) }));
