#!/usr/bin/env python3
"""Inspect existing SFNT character maps without installing a font library."""

import hashlib
import json
from pathlib import Path
import struct

ROOT = Path("/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck")
assert Path.cwd() == ROOT
OWN = ROOT / ".tmp/resume182-6-8a-n12-0789/figure-author-FIRST"
paths = [
    Path("/System/Library/Fonts/Supplemental/Arial.ttf"),
    Path("/System/Library/Fonts/Supplemental/Arial Bold.ttf"),
    Path("/System/Library/Fonts/Supplemental/Arial Unicode.ttf"),
    Path("/System/Library/Fonts/Supplemental/STIXTwoText.ttf"),
    Path("/System/Library/Fonts/Supplemental/STIXGeneral.otf"),
    Path("/System/Library/Fonts/Apple Symbols.ttf"),
    Path("/System/Library/Fonts/SFNS.ttf"),
]
codepoints = [0x61, 0x2099]


def inspect(path):
    data = path.read_bytes()
    u16 = lambda offset: struct.unpack_from(">H", data, offset)[0]
    u32 = lambda offset: struct.unpack_from(">I", data, offset)[0]
    tables = {}
    for index in range(u16(4)):
        offset = 12 + 16 * index
        tag, checksum, start, size = struct.unpack_from(">4sIII", data, offset)
        tables[tag] = (start, size)
    cmap_start, _ = tables[b"cmap"]
    mappings = []
    for index in range(u16(cmap_start + 2)):
        entry = cmap_start + 4 + 8 * index
        platform, encoding, relative = struct.unpack_from(">HHI", data, entry)
        if platform != 0 and not (platform == 3 and encoding in (1, 10)):
            continue
        start = cmap_start + relative
        format_number = u16(start)
        found = {}
        if format_number == 4:
            segments = u16(start + 6) // 2
            end_start = start + 14
            begin_start = end_start + 2 * segments + 2
            delta_start = begin_start + 2 * segments
            range_start = delta_start + 2 * segments
            for codepoint in codepoints:
                glyph = 0
                for segment in range(segments):
                    if u16(begin_start + 2 * segment) <= codepoint <= u16(end_start + 2 * segment):
                        delta = u16(delta_start + 2 * segment)
                        range_offset = u16(range_start + 2 * segment)
                        if range_offset == 0:
                            glyph = (codepoint + delta) % 65536
                        else:
                            glyph = u16(range_start + 2 * segment + range_offset + 2 * (codepoint - u16(begin_start + 2 * segment)))
                            if glyph:
                                glyph = (glyph + delta) % 65536
                        break
                found[f"U+{codepoint:04X}"] = glyph
        elif format_number == 12:
            for codepoint in codepoints:
                glyph = 0
                for group in range(u32(start + 12)):
                    first, last, first_glyph = struct.unpack_from(">III", data, start + 16 + 12 * group)
                    if first <= codepoint <= last:
                        glyph = first_glyph + codepoint - first
                        break
                found[f"U+{codepoint:04X}"] = glyph
        else:
            continue
        mappings.append({"platform": platform, "encoding": encoding, "format": format_number, "glyphs": found})
    family_names = []
    name_start, _ = tables[b"name"]
    string_start = name_start + u16(name_start + 4)
    for index in range(u16(name_start + 2)):
        platform, encoding, language, name_id, length, offset = struct.unpack_from(">HHHHHH", data, name_start + 6 + 12 * index)
        if name_id != 1:
            continue
        raw = data[string_start + offset:string_start + offset + length]
        family = raw.decode("utf-16-be" if platform in (0, 3) else "mac_roman")
        if family not in family_names:
            family_names.append(family)
    return {
        "path": str(path), "sha256": hashlib.sha256(data).hexdigest(),
        "bytes": len(data), "familyNames": family_names, "characterMaps": mappings,
        "bothGlyphsPresent": any(all(glyph > 0 for glyph in mapping["glyphs"].values()) for mapping in mappings),
    }


fonts = [inspect(path) for path in paths]
selected = next((font for font in fonts if font["bothGlyphsPresent"]), None)
payload = {
    "schema": "stemrobin182/raster-font-audit@1",
    "status": "pass" if selected else "DIAGNOSED_NO_REQUIRED_GLYPH_IN_INSPECTED_FONTS",
    "fonts": fonts, "selectedHeaderFont": selected,
    "requiredCharacters": ["U+0061", "U+2099"],
    "method": "Read existing SFNT name and Unicode cmap tables using Python standard-library struct; require nonzero glyph IDs for a and subscript n. No image loading, font copying, dependency installation, or extra raster generation.",
    "actualImageViewsAdded": 0,
}
with (OWN / "font-audit.record").open("x") as handle:
    json.dump(payload, handle, indent=2)
    handle.write("\n")
print(json.dumps(payload))
