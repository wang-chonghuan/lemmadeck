import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), root);
const own = '.tmp/resume182-6-8a-n12-0789/figure-author-FIRST';
const require = createRequire(path.resolve('.claude/skills/ld-s10y-lesson/package.json'));
const { Resvg } = require('@resvg/resvg-js');
const hash = (bytes) => createHash('sha256').update(bytes).digest('hex');
const bind = (file) => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), sha256: hash(bytes), bytes: bytes.length };
};
const report = JSON.parse(fs.readFileSync(`${own}/tbl-p0081-01.render.json`, 'utf8'));
const creation = JSON.parse(fs.readFileSync(`${own}/firstcandidate/creation.record`, 'utf8'));
const fontAudit = JSON.parse(fs.readFileSync(`${own}/font-audit.record`, 'utf8'));
const specBefore = bind(`${own}/firstcandidate/tbl-p0081-01.spec.json`);
const svgBefore = bind(`${own}/tbl-p0081-01.svg`);
const renderBefore = bind(`${own}/tbl-p0081-01.render.json`);
const originalPreview = bind(`${own}/tbl-p0081-01.preview640.png`);
assert.equal(originalPreview.sha256, '8fbea69d2046c0c33a4145eacb0b523e5e8c1db226406c15a679d5f5d1ab26b0');
assert.equal(specBefore.sha256, creation.specSha256);
assert.equal(svgBefore.sha256, report.output.svg.sha256);
assert.equal(report.status, 'pass');
assert.equal(fontAudit.status, 'pass');
assert.equal(fontAudit.selectedHeaderFont.bothGlyphsPresent, true);
const fontFiles = [
  '/System/Library/Fonts/Supplemental/Arial.ttf',
  '/System/Library/Fonts/Supplemental/Arial Bold.ttf',
  fontAudit.selectedHeaderFont.path,
].filter((file) => fs.existsSync(file));
assert.equal(fontFiles.length, 3);
assert.equal(bind(fontFiles[2]).sha256, fontAudit.selectedHeaderFont.sha256);
const previewPath = `${own}/tbl-p0081-01.preview640.font-recovery1.png`;
assert.ok(!fs.existsSync(previewPath));
const input = spawnSync('python3', [`${own}/raster-input-recovery1.py`], {
  cwd: root, encoding: 'utf8', env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1' },
});
assert.equal(input.status, 0, input.stderr);
const resvg = new Resvg(input.stdout, {
  background: '#ffffff',
  font: { loadSystemFonts: false, fontFiles, defaultFontFamily: 'Arial', sansSerifFamily: 'Arial' },
});
const outlined = spawnSync('python3', [`${own}/check-recovery-outlines.py`], {
  cwd: root, encoding: 'utf8', input: resvg.toString(),
  env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1' },
});
assert.equal(outlined.status, 0, outlined.stderr);
const outlineEvidence = JSON.parse(outlined.stdout);
const raster = resvg.render();
assert.equal(raster.width, 640);
assert.equal(raster.height, 320);
const pixels = raster.pixels;
let darkPixels = 0, headerInkPixels = 0;
for (let index = 0; index < pixels.length; index += 4) {
  if (pixels[index] < 180 && pixels[index + 1] < 180 && pixels[index + 2] < 180) {
    darkPixels++;
    const pixel = index / 4;
    const x = pixel % 640, y = Math.floor(pixel / 640);
    if (x > 16 && x < 64 && y > 170 && y < 213) headerInkPixels++;
  }
}
assert.ok(darkPixels > 1000 && darkPixels < 640 * 320 / 4);
assert.ok(headerInkPixels > 40 && headerInkPixels < 600);
const png = raster.asPng();
fs.writeFileSync(previewPath, png, { flag: 'wx' });
assert.deepEqual(bind(`${own}/firstcandidate/tbl-p0081-01.spec.json`), specBefore);
assert.deepEqual(bind(`${own}/tbl-p0081-01.svg`), svgBefore);
assert.deepEqual(bind(`${own}/tbl-p0081-01.render.json`), renderBefore);
assert.deepEqual(bind(`${own}/tbl-p0081-01.preview640.png`), originalPreview);
fs.writeFileSync(`${own}/preview-recovery1.record`, `${JSON.stringify({
  schema: 'stemrobin182/preview-font-recovery@1',
  status: 'TECHNICAL_PREVIEW_RECOVERY_COMPLETE_VISUAL_GATE_PENDING',
  figure: 'tbl-p0081-01', book: '8a', lesson: 'alg8-c3-s1-n12', edition: 'modern-us-neutral',
  spec: specBefore, svg: svgBefore, render: renderBefore,
  originalFailedPreview: originalPreview, recoveredPreview: bind(previewPath),
  width: raster.width, height: raster.height, fontFiles: fontFiles.map(bind),
  headerFontFamily: '.SF NS', headerCharacters: ['U+0061', 'U+2099'],
  fontAudit: bind(`${own}/font-audit.record`), outlineEvidence,
  darkPixels, headerInkPixels,
  nativeSpecChanged: false, nativeSvgChanged: false, nativeRenderChanged: false,
  originalFailedPreviewChanged: false, nativeRendererReruns: 0,
  paidGenerationCalls: 0, dependencyInstalls: 0, fontCopies: 0,
  resvgRecoveryRasterCalls: 1, cumulativeResvgRasterCalls: 2,
  cumulativeActualImageViews: 2, recoveredPreviewImageViews: 0,
  reopens: 0, crops: 0, resizes: 0, screenshots: 0,
  visualGate: 'PENDING_NEW_INDEPENDENT_FIGURE_REVIEW', independentlyApproved: false,
  rasterization: 'Font-only scratch recovery from the unchanged native SVG. Explicit existing fontFiles; only bottom-left header font family changed in memory. Native dimensions 640 by 320, no fitTo or scaling.',
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({
  status: 'TECHNICAL_PREVIEW_RECOVERY_COMPLETE_VISUAL_GATE_PENDING',
  recoveredPreview: bind(previewPath), headerInkPixels,
  actualImageViews: 2, nativeRendererReruns: 0,
}));
