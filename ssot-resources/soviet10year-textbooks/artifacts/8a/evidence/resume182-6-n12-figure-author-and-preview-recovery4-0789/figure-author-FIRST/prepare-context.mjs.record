import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), root);
const base = '.tmp/resume182-6-8a-n12-0789';
const own = `${base}/figure-author-FIRST`;
const candidate = `${base}/modern-FIRST/adapt/8a/modern-us-neutral/lessons/alg8-c3-s1-n12`;
const scratch = `${own}/context-artifacts/8a`;
const lessonDirectory = `${scratch}/editions/modern-us-neutral/lessons/alg8-c3-s1-n12`;
const sha = (bytes) => createHash('sha256').update(bytes).digest('hex');
const bind = (file) => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), sha256: sha(bytes), bytes: bytes.length };
};
const write = (file, value) => fs.writeFileSync(file, `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
assert.ok(!fs.existsSync(`${own}/context-bindings.record`));
fs.mkdirSync(lessonDirectory, { recursive: true });
fs.mkdirSync(`${scratch}/figures`, { recursive: true });
const copies = [
  [`${candidate}/lesson.template.json`, `${lessonDirectory}/lesson.json`],
  [`${candidate}/exercises.template.json`, `${lessonDirectory}/exercises.json`],
  ['ssot-resources/soviet10year-textbooks/artifacts/8a/figures/tbl-p0081-01.png', `${scratch}/figures/tbl-p0081-01.png`],
];
const bindings = copies.map(([source, destination]) => {
  fs.copyFileSync(source, destination, fs.constants.COPYFILE_EXCL);
  assert.deepEqual(fs.readFileSync(destination), fs.readFileSync(source));
  return { original: bind(source), copy: bind(destination), exactByteCopy: true };
});
assert.equal(bindings[2].original.sha256, 'c6d2eb582584a5fd96a606b9bac82a795d0b8ca296e829fd37eac95ce74198b3');
const approval = bind(`${base}/source-review-FIRST/result-affected-annotation1.record`);
assert.equal(approval.sha256, 'cd18e13a0ff01a8c5ea64a6951a2f640c0cdda29c3468371680dc9593dc87c14');
fs.copyFileSync(`${candidate}/figures.template.json`, `${own}/figures.template.before.json`, fs.constants.COPYFILE_EXCL);
write(`${own}/context-bindings.record`, {
  schema: 'stemrobin182/draft-context-bindings@1',
  book: '8a', lesson: 'alg8-c3-s1-n12', edition: 'modern-us-neutral', figure: 'tbl-p0081-01',
  status: 'DRAFT_CONTEXT_NOT_APPROVED_NOT_PUBLISHED',
  sourceApproval: { ...approval, reused: true, reruns: 0 },
  candidateByteCopies: bindings,
  originalFigureTemplate: bind(`${own}/figures.template.before.json`),
  scratchRoot: path.resolve(`${own}/context-artifacts`),
  sourceInventory: bind(`${own}/source-inventory.json`),
  figureSpecSourcePathMustName: bindings[2].original.path,
  rawOriginalHashIdentical: true,
  approved: false, published: false, durableWrites: 0,
  sourceImageViews: 1, previewImageViews: 0, cumulativeActualImageViews: 1,
  copiesWereNotOpenedAsImages: true,
});
console.log(JSON.stringify({ status: 'DRAFT_CONTEXT_COPIES_READY', bindings }));
