import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
const work = path.join(root, '.tmp/resume182-6-8a-n14-0789');
const modern = path.join(root, 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c3-s2-n14');
const checks = [];
const errors = [];
const bindings = {};
function check(name, pass, details = {}) {
  checks.push({name, status: pass ? 'pass' : 'fail', ...details});
  if (!pass) errors.push({name, ...details});
}
function read(name, file, pinnedSha) {
  const bytes = fs.readFileSync(file);
  const binding = {
    path: file,
    sha256: crypto.createHash('sha256').update(bytes).digest('hex'),
    bytes: bytes.length,
  };
  bindings[name] = binding;
  if (pinnedSha) check(`${name} hash pin`, binding.sha256 === pinnedSha);
  return JSON.parse(bytes.toString('utf8'));
}
function same(a, b) {
  return JSON.stringify(a) === JSON.stringify(b);
}

function gcd(a, b) {
  a = a < 0n ? -a : a;
  b = b < 0n ? -b : b;
  while (b) [a, b] = [b, a % b];
  return a;
}
function rational(n, d = 1n) {
  n = BigInt(n);
  d = BigInt(d);
  if (!d) throw Error('Zero denominator');
  if (d < 0n) [n, d] = [-n, -d];
  const g = gcd(n, d);
  return {n: n / g, d: d / g};
}
function str(q) {
  return q.d === 1n ? `${q.n}` : `${q.n}/${q.d}`;
}
function decimal(s) {
  if (!/^-?\d+(?:\.\d+)?$/.test(s)) throw Error(`Not an exact decimal: ${s}`);
  const sign = s.startsWith('-') ? -1n : 1n;
  const [whole, frac = ''] = s.replace(/^-/, '').split('.');
  return rational(sign * BigInt(whole + frac), 10n ** BigInt(frac.length));
}
function fromSaved(s) {
  if (s.includes('/')) {
    const [n, d] = s.split('/');
    return rational(n, d);
  }
  return decimal(s);
}
function add(a, b) { return rational(a.n * b.d + b.n * a.d, a.d * b.d); }
function neg(a) { return rational(-a.n, a.d); }
function sub(a, b) { return add(a, neg(b)); }
function mul(a, b) { return rational(a.n * b.n, a.d * b.d); }
function div(a, b) { return rational(a.n * b.d, a.d * b.n); }
function eq(a, b) { return a.n === b.n && a.d === b.d; }
function pow(q, exponent) {
  if (!Number.isInteger(exponent)) throw Error('Noninteger exponent');
  return exponent < 0
    ? rational(q.d ** BigInt(-exponent), q.n ** BigInt(-exponent))
    : rational(q.n ** BigInt(exponent), q.d ** BigInt(exponent));
}

// A bounded exact reader for the current keys: decimals, LaTeX fractions and
// affine expressions in indexed x symbols. Unsupported input fails closed.
function affineLatex(input) {
  const text = input.replace(/\s+/g, '');
  let pos = 0;
  const zero = rational(0);
  const one = rational(1);
  const scalar = q => new Map([['constant', q]]);
  const isScalar = m => [...m.keys()].every(k => k === 'constant');
  function combine(a, b, sign = one) {
    const m = new Map(a);
    for (const [key, value] of b) m.set(key, add(m.get(key) || zero, mul(sign, value)));
    return m;
  }
  function scale(a, q) {
    return new Map([...a].map(([key, value]) => [key, mul(value, q)]));
  }
  function argument() {
    if (text[pos] === '{') {
      pos++;
      const value = sum();
      if (text[pos++] !== '}') throw Error(`Unclosed group: ${input}`);
      return value;
    }
    return atom(true);
  }
  function atom(oneDigit = false) {
    if (text.startsWith('\\frac', pos)) {
      pos += 5;
      const numerator = argument();
      const denominator = argument();
      if (!isScalar(denominator)) throw Error(`Nonscalar denominator: ${input}`);
      return scale(numerator, div(one, denominator.get('constant') || zero));
    }
    if (text[pos] === '{' || text[pos] === '(') {
      const end = text[pos++] === '{' ? '}' : ')';
      const value = sum();
      if (text[pos++] !== end) throw Error(`Unclosed expression: ${input}`);
      return value;
    }
    const indexed = /^x_(?:\{(\d+)\}|(\d))/.exec(text.slice(pos));
    if (indexed) {
      pos += indexed[0].length;
      return new Map([[`x_${indexed[1] || indexed[2]}`, one]]);
    }
    const number = (oneDigit ? /^\d/ : /^\d+(?:\.\d+)?/).exec(text.slice(pos));
    if (!number) throw Error(`Unsupported key at ${pos}: ${input}`);
    pos += number[0].length;
    return scalar(decimal(number[0]));
  }
  function signedAtom() {
    let sign = one;
    while (text[pos] === '+' || text[pos] === '-') {
      if (text[pos++] === '-') sign = neg(sign);
    }
    return scale(atom(), sign);
  }
  function product() {
    let value = signedAtom();
    while (text[pos] === '*' || text[pos] === '/' || text.startsWith('\\cdot', pos)) {
      const divide = text[pos] === '/';
      pos += text.startsWith('\\cdot', pos) ? 5 : 1;
      const next = signedAtom();
      if (divide) {
        if (!isScalar(next)) throw Error(`Nonscalar division: ${input}`);
        value = scale(value, div(one, next.get('constant') || zero));
      } else if (isScalar(value)) {
        value = scale(next, value.get('constant') || zero);
      } else if (isScalar(next)) {
        value = scale(value, next.get('constant') || zero);
      } else {
        throw Error(`Nonlinear product: ${input}`);
      }
    }
    return value;
  }
  function sum() {
    let value = product();
    while (text[pos] === '+' || text[pos] === '-') {
      const sign = text[pos++] === '-' ? neg(one) : one;
      value = combine(value, product(), sign);
    }
    return value;
  }
  const result = sum();
  if (pos !== text.length) throw Error(`Unparsed key at ${pos}: ${input}`);
  return Object.fromEntries([...result]
    .filter(([, q]) => q.n !== 0n)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([key, q]) => [key, str(q)]));
}
function numericLatex(text) {
  const value = affineLatex(text);
  if (Object.keys(value).some(key => key !== 'constant')) throw Error(`Not numeric: ${text}`);
  return fromSaved(value.constant || '0');
}

function review() {
  check('exact cwd', process.cwd() === root, {actual: process.cwd()});
  const solutions = read('independentSolutions', path.join(work, 'answer-review-FIRST/independent-solutions.record'),
