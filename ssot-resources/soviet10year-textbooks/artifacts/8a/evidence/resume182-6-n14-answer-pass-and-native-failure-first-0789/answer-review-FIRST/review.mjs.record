        check(`${s.exercise} ${p.label} every expected exact equivalence`, Boolean(pass), {expected: text, canonical});
        actualCanonical.push(canonical);
      }
      partEvidence.push({
        ordinal: j + 1, label: p.label, judge: p.judge, expected: p.expected,
