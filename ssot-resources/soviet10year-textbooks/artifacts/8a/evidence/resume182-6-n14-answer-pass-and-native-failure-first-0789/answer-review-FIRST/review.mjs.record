    }));
  }
  check('229 middle-angle sum arithmetic', eq(div(rational(180), rational(3)), rational(60)));
  check('230 middle-side perimeter arithmetic', eq(div(rational(24), rational(3)), rational(8)));
  const exponentEvidence = [
