    !same(affineLatex('(x_{11}-x_{10})/2'), affineLatex('(x_{10}-x_{11})/2')) &&
    !same(affineLatex('\\frac{x_8-x_6}{2}'), affineLatex('\\frac{x_8-x_6}{3}')));

  const displays = {
    '223': {
      verdict: 'All six classifications and reasons are complete.',
      reason: 'a,c,e are arithmetic with differences 10,10,1/2. b has differences 10,14,10,10; d has 20,200. For f the unequal first two differences -8/15,-8/35 already prove nonarithmetic; listing the third is not required.',
      required: ['10,10,\\frac12', '10,14,10,10', '20,200', '-\\frac8{15},-\\frac8{35}'],
    },
    '224': {
      verdict: 'All four five-term lists are exact and ordered.',
