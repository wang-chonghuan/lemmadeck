      Object.keys(t).every(k => Object.hasOwn(a, k)) &&
      (!Object.hasOwn(a, 'notes') || (typeof a.notes === 'string' && a.notes.length > 0)));
    const partEvidence = [];
    for (let j = 0; j < a.parts.length; j++) {
      const p = a.parts[j];
      const wanted = expected[j];
      const reliable = wanted && p.label === wanted.label && p.judge === wanted.judge &&
        p.unit === wanted.unit && Object.keys(p).every(k => ['label', 'judge', 'expected', 'unit'].includes(k)) &&
        Array.isArray(p.expected) && p.expected.length > 0 && p.expected.every(x => typeof x === 'string' && x.length > 0);
      check(`${s.exercise} part ${j + 1} ordered field contract`, Boolean(reliable));
      const actualCanonical = [];
      for (const text of p.expected) {
        let pass = false;
        let canonical = null;
        try {
          if (p.judge === 'numeric') {
            canonical = str(numericLatex(text));
            pass = wanted && canonical === str(fromSaved(wanted.value));
          } else if (p.judge === 'expression') {
            canonical = affineLatex(text);
            pass = wanted && same(canonical, affineLatex(wanted.value));
          }
        } catch (error) {
