  const first = solutions.exercises[0];
  check('223 independent successive differences', first.parts.every(p => {
    const qs = p.terms.map(fromSaved);
    const ds = qs.slice(1).map((q, i) => sub(q, qs[i]));
    const arithmetic = ds.every(q => eq(q, ds[0]));
    return same(ds.map(str), p.successiveDifferences) &&
