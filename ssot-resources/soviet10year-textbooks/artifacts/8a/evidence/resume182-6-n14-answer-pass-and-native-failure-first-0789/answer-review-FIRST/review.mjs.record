    {label: 'b)', coefficient: str(mul(pow(rational(3), -2), rational(9))), aExponent: -2 + 3, bExponent: 4 - 5, substitution: ['370', '17/100']},
  ];
  const exponentValues = exponentEvidence.map(e =>
    mul(fromSaved(e.coefficient), mul(pow(fromSaved(e.substitution[0]), e.aExponent), pow(fromSaved(e.substitution[1]), e.bExponent))));
  check('231 independent exponent laws and exact substitutions', same(exponentValues.map(str), solutions.exercises[8].parts.map(p => p.value)) &&
    eq(decimal('0.05'), exponentValues[0]) && eq(decimal('0.17'), rational(17, 100)));
  check('bounded reader independent positive/negative controls',
