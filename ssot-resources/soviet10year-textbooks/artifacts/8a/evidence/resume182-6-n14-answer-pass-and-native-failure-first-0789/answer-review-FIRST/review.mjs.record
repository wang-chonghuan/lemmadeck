  check('candidate/template root metadata unchanged', ['schema', 'book', 'lesson', 'edition', 'status'].every(k => candidate[k] === template[k]) &&
    candidate.schema === 'ld-s10y-answer/lesson-answers@1' &&
    candidate.book === '8a' && candidate.lesson === 'alg8-c3-s2-n14' &&
    candidate.edition === 'modern-us-neutral' && candidate.status === 'draft' &&
    same(Object.keys(candidate).sort(), ['schema', 'book', 'lesson', 'edition', 'status', 'answers'].sort()));
  const ids = solutions.exercises.map(x => x.exercise);
  check('ordered complete nine-exercise coverage', ids.length === 9 &&
    new Set(ids).size === 9 && lesson.exercise_count === 9 && exercises.count === 9 &&
    same(ids, exercises.exercises.map(x => x.number)) &&
