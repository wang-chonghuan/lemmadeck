      required: ['10,14,18,22,26', '29,24,19,14,9', '1.7,1.5,1.3,1.1,0.9', '-\\frac72,-\\frac83,-\\frac{11}6,-1,-\\frac16'],
    },
    '225': {
      verdict: 'Both quantities appear for all four subparts.',
      reason: 'd is later-minus-earlier; a_6=a_1+5d gives 220,-10,55,11/3. Display orders each d before a_6.',
      required: ['d=30,a_6=220', 'd=-50,a_6=-10', 'd=15,a_6=55', 'd=\\frac23,a_6=\\frac{11}3'],
    },
    '226': {
      verdict: 'Both missing terms in both lists are correct and the backtracking explanation is sound.',
      reason: 'Display works backward from b_3 through b_2 to b_1, explicitly identifying each result. That explanatory order is valid; graded fields remain requested b_1,b_2 order. Differences are 6 and 7.5.',
      required: ['d=6', 'b_3=17', 'b_2=11,b_1=5', 'd=7.5', 'b_3=-19', 'b_2=-26.5,b_1=-34'],
    },
    '227': {
      verdict: 'Four indexed expressions have correct later-minus-earlier signs and index-gap divisors.',
