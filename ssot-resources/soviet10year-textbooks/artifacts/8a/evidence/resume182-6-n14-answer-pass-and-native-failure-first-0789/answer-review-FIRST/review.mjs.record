    exactParts: parts.filter(p => p.judge === 'exact').length,
    expectedCandidates: parts.reduce((n, p) => n + p.expected.length, 0),
  };
  check('reliable numeric/expression only and zero exact keys', totals.autoParts === 45 &&
    totals.numericParts === 41 && totals.expressionParts === 4 && totals.exactParts === 0 &&
    totals.autoExercises === 7 && totals.ungradedExercises === 2 &&
    parts.every(p => ['numeric', 'expression'].includes(p.judge)));
  check('classification/proof no fake numeric yes/no', ['223', '229'].every(id => {
    const a = candidate.answers.find(x => x.exercise === id);
    return a.grading === 'ungraded' && a.parts.length === 0 && a.displayAnswer.length > 0;
  }));
  const sourceMetadataBasis = {
    bookRaw: 'Absent in each current native template entry and correctly absent in each candidate entry.',
    source: 'All nine are derived, as supplied by the native template. Independent mathematics supports that selection.',
    captureAbsenceClaimed: false,
    bookCaptureOpened: false,
    sourceSnapshot: {
      lessonPath: lesson.source.path,
      lessonSha256: lesson.source.sha256,
      exercisesPath: exercises.source.path,
      exercisesSha256: exercises.source.sha256,
    },
    sourceApprovalBasis: 'Approved modern input and embedded source identity; no source pixel re-review or other source-review record access.',
  };
  const scriptBytes = fs.readFileSync(import.meta.filename);
  bindings.checker = {path: import.meta.filename,
    sha256: crypto.createHash('sha256').update(scriptBytes).digest('hex'), bytes: scriptBytes.length};
  return {schema: 'stemrobin-182/independent-answer-review-evidence@1', book: '8a',
    lesson: 'alg8-c3-s2-n14', edition: 'modern-us-neutral', cwd: root, status: errors.length ? 'revise' : 'pass',
    reviewer: {kind: 'independent_agent', role: 'ANSWER only'},
    bindings, totals, orderedExerciseEvidence, sourceMetadataBasis, exponentEvidence,
    checks, errors,
    nativeChecks: {validateLessonRuns: 0, finalizeRuns: 0, prepareRuns: 0, renderRuns: 0,
      promotionRuns: 0, publishRuns: 0, computeEngineRuns: 0,
      basis: 'This is independent offline answer review only. Parent owns native finalization and ComputeEngine checks.'},
    imageAccounting0: {figureCount: 0, imageViews: 0, imageBytesReadOrRehashed: 0,
      imagePayloads: 0, sourcePixelRereviews: 0},
    preservation: {readOnlyChecker: true, contentWrites: 0, choiceAccesses: 0,
      priorPassReruns: 0, gitCommands: 0, networkCalls: 0, databaseCalls: 0,
      setupUpdateCreateAttachActions: 0, applicationChanges: 0,
      historicalRecordsModified: 0, historicalUsageReset: false},
    hostTokens: 'unknown', totalCost: 'unknown'};
}
try {
  const result = review();
  console.log(JSON.stringify(result, null, 2));
  if (result.errors.length) process.exitCode = 1;
} catch (error) {
  console.log(JSON.stringify({status: 'revise', errors: [{name: 'checker execution', error: String(error)}],
    checks, bindings}, null, 2));
  process.exitCode = 1;
}
