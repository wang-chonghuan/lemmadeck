          "c2p1-integers-option-4"
        ],
        "rationales": [
          {
            "option_id": "c2p1-integers-option-3",
            "truth": "incorrect",
            "derivation": "3(x-y)=4 demands x-y=4/3. Rounding that to 1 and taking (1,0) yields left side 3, not 4.",
            "misconception": "Round the fractional difference to manufacture integer coordinates."
          },
          {
            "option_id": "c2p1-integers-option-5",
            "truth": "correct",
            "derivation": "(1,13) is an integer pair with product 13.",
            "misconception": null
          },
          {
            "option_id": "c2p1-integers-option-1",
            "truth": "incorrect",
            "derivation": "Taking x=1,y=-7.5 works over reals but not integers; a product of two integers cannot be -7.5.",
