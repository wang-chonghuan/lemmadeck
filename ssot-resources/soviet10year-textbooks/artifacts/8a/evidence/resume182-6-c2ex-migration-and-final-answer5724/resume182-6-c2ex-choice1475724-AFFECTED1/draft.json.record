          },
          {
            "option_id": "c2p1-integers-option-2",
            "truth": "correct",
            "derivation": "y=1 gives x=8; the denominator is nonzero and 8-7=1.",
            "misconception": null
          },
          {
            "option_id": "c2p1-integers-option-6",
            "truth": "correct",
            "derivation": "x=y=12 gives 1/12+1/12=1/6 with nonzero coordinates.",
            "misconception": null
          },
          {
            "option_id": "c2p1-integers-option-4",
            "truth": "correct",
            "derivation": "x=6,y=5 gives 36-25=11.",
            "misconception": null
          }
        ]
      }
    },
