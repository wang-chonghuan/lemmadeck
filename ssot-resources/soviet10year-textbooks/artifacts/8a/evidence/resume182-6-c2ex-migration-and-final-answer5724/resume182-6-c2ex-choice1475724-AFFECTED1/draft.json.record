          },
          {
            "id": "c2p1-finite-examples-option-4",
            "text": "$y^2+(x^2-1)^2=0$ 恰有四个解。",
            "figure_ids": []
          },
          {
            "id": "c2p1-finite-examples-option-5",
            "text": "$x^2+y^2=0$ 恰有一个解。",
            "figure_ids": []
          },
          {
            "id": "c2p1-finite-examples-option-6",
            "text": "$y^2+(x^2-1)^2=0$ 恰有两个解。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "Recognize equations realizing each requested finite cardinality, including why squared sums isolate points.",
        "source_solution": "Examples for 0,1,2,3 are x^2+y^2+1=0; x^2+y^2=0; y^2+(x^2-1)^2=0; y^2+[x(x-1)(x+1)]^2=0. Their sets are empty,{(0,0)},{(-1,0),(1,0)},{(-1,0),(0,0),(1,0)}.",
        "unit_reason": "The native collection tests cardinality across all four requested cases, not a pairing code for the four cases.",
        "concept_blocks": [],
        "limitations": [
          "NOT_FULL_COVERAGE: selecting examples does not assess inventing equations with prescribed numbers of solutions."
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "c2p1-finite-examples-option-3",
          "c2p1-finite-examples-option-6",
          "c2p1-finite-examples-option-1",
          "c2p1-finite-examples-option-5"
        ],
        "rationales": [
          {
            "option_id": "c2p1-finite-examples-option-3",
            "truth": "correct",
            "derivation": "Its left side is at least 1.",
            "misconception": null
          },
          {
            "option_id": "c2p1-finite-examples-option-6",
            "truth": "correct",
            "derivation": "y=0 and x^2=1 force exactly (-1,0),(1,0).",
            "misconception": null
          },
          {
            "option_id": "c2p1-finite-examples-option-1",
            "truth": "correct",
            "derivation": "y=0 and x(x-1)(x+1)=0 force exactly x=-1,0,1.",
            "misconception": null
          },
          {
            "option_id": "c2p1-finite-examples-option-5",
            "truth": "correct",
            "derivation": "Both coordinates must vanish, so only (0,0).",
            "misconception": null
          },
          {
            "option_id": "c2p1-finite-examples-option-2",
            "truth": "incorrect",
            "derivation": "Counting only the two roots x=+-1 ignores that each permits any y and that y=0 also permits every x; the set is three entire lines.",
            "misconception": "Count roots of one factor as full ordered-pair solutions, ignoring the free coordinate and other zero factor."
          },
          {
            "option_id": "c2p1-finite-examples-option-4",
            "truth": "incorrect",
            "derivation": "Taking y=+-sqrt0 and treating +0,-0 as different gives two y values for each x=+-1, falsely counting four.",
            "misconception": "Count +0 and -0 as distinct numbers."
          }
        ]
      }
    },
    {
