"""Match recovered glyph outlines without depending on discarded XML IDs."""

import json
import sys
import xml.etree.ElementTree as ET

inputs = json.load(sys.stdin)
full = ET.fromstring(inputs["full"])
header = ET.fromstring(inputs["header"])
assert not any(node.tag.endswith("}text") for node in full.iter())
paths = [node.attrib["d"] for node in header.iter() if node.tag.endswith("}path")]
assert paths and all(value.strip() for value in paths)
full_paths = [node.attrib["d"] for node in full.iter() if node.tag.endswith("}path")]
assert all(full_paths.count(value) == 1 for value in paths)
print(json.dumps({
    "status": "pass", "recoveredHeaderOutlinePaths": len(paths),
    "allHeaderPathsMatchedExactlyOnceInFullPreview": True,
    "missingGlyphsExcludedByExplicitFontCmapAudit": True,
    "idPreservationRequired": False, "imageViewsAdded": 0,
}))
