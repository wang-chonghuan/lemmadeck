const fileManifest = [];
const walk = directory => {
  for (const item of fs.readdirSync(directory, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
    const file = path.join(directory, item.name);
    assert.ok(file.startsWith(`${own}/`));
    if (item.isDirectory()) walk(file);
    else if (item.isFile()) {
      const artifact = ref(file);
      let status = 'retained';
      if (item.name === 'receipt.record') {
        const receipt = json(file);
        status = receipt.exitCode === 0 ? 'execution-pass' : 'execution-fail';
      } else if (file.endsWith('fig-14-native640-REPEAT1.png')) {
        status = 'FAILED_NATIVE_STROKE_COMPATIBILITY_DO_NOT_USE';
      } else if (file.endsWith('fig-15-FIRST.svg')) {
        status = 'FAILED_RENDER_COLLISIONS_DO_NOT_USE';
      } else if (file.endsWith('.png')) {
        status = 'CURRENT_NATIVE_PREVIEW_UNVIEWED';
      }
      fileManifest.push({ ...artifact, status });
    } else {
      throw new Error(`unexpected non-file artifact: ${file}`);
    }
  }
};
