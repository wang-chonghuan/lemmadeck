    draft: {
      status: draft.status,
      receipt: ref(path.join(draftDir, 'receipt.record')),
      validation: ref(path.join(draftDir, 'stdout.txt')),
      appliesDirectlyToCurrentSpec: id === 'fig-14',
      currentSpecAlsoValidatedByEachRenderer: true,
