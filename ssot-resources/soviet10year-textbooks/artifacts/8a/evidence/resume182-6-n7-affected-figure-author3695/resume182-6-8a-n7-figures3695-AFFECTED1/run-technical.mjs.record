import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
const own = path.join(root, '.tmp/resume182-6-8a-n7-figures3695-AFFECTED1');
assert.equal(process.cwd(), root);
const [phase, attempt] = process.argv.slice(2);
assert.ok(['native-stroke-check', 'native-raster-recovery'].includes(phase));
assert.ok(['REPEAT1', 'NATIVEFIX1'].includes(attempt));
const commands = path.join(own, 'technical-commands');
fs.mkdirSync(commands, { recursive: true });
const directory = path.join(commands, `${phase}-${attempt}`);
fs.mkdirSync(directory);
const python = '/Users/yong/work/lemmadeck-ws/lemmadeck/.claude/skills/ld-s10y-lesson/.venv/bin/python';
const executable = phase === 'native-stroke-check' ? python : process.execPath;
const args = phase === 'native-stroke-check'
  ? ['-B', path.join(own, 'native-stroke-check.py'), attempt]
  : [path.join(own, 'native-raster-recovery.mjs')];
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const start = {
  root, phase, attempt, command: [executable, ...args],
  script: { path: args[phase === 'native-stroke-check' ? 1 : 0] },
  createdAt: new Date().toISOString(),
  contentRevisions: 0, sourceImageReads: 0, imageVisualLoads: 0,
  independentReview: 'NOT_RUN',
};
start.script.sha256 = sha(fs.readFileSync(start.script.path));
const write = (name, value) => fs.writeFileSync(
  path.join(directory, name), `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' },
);
write('start.record', start);
const result = spawnSync(executable, args, {
  cwd: root,
  env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1', TMPDIR: directory },
  encoding: 'utf8', maxBuffer: 8 * 1024 * 1024,
});
fs.writeFileSync(path.join(directory, 'stdout.txt'), result.stdout || '', { flag: 'wx' });
fs.writeFileSync(path.join(directory, 'stderr.txt'), result.stderr || '', { flag: 'wx' });
const receipt = {
  ...start, exitCode: result.status, signal: result.signal,
  executionError: result.error?.message || null,
  stdoutSHA256: sha(result.stdout || ''), stderrSHA256: sha(result.stderr || ''),
  finishedAt: new Date().toISOString(),
  nativeRasterCalls: phase === 'native-raster-recovery' ? 1 : 0,
  renderCalls: 0, approval: 'NONE',
};
write('receipt.record', receipt);
console.log(JSON.stringify(receipt, null, 2));
console.log(result.stdout || '');
if (result.stderr) console.error(result.stderr);
process.exitCode = result.status ?? 1;
