    "path": "/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck/.tmp/resume182-6-8a-n18-0789/modern-FIRST/adapt/8a/modern-us-neutral/lessons/alg8-c3-s3-n18/lesson.template.json",
