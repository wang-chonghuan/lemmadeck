import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/resume182-6-8a-n18-0789';
const edition = 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral';
const id = 'alg8-c3-s3-n18';
const lesson = `${edition}/lessons/${id}`;
const args = process.argv.slice(2);
assert.equal(args.length, 8);
const [textPath, textHash, figurePath, figureHash, answerPath, answerHash, choicePath, choiceHash] = args;
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const snapshots = new Map();
const bound = file => {
  const absolute = path.resolve(file);
  assert.ok(absolute.startsWith(`${repo}/`) && fs.realpathSync(absolute) === absolute);
  assert.ok(!absolute.split(path.sep).some(item => /^\.env(?:\.|$)/u.test(item)));
  if (!snapshots.has(absolute)) snapshots.set(absolute, fs.readFileSync(absolute));
  return { path: absolute, sha256: sha(snapshots.get(absolute)) };
};
const read = (file, hash) => {
  const binding = bound(file);
  if (hash) assert.equal(binding.sha256, hash, file);
  return JSON.parse(snapshots.get(binding.path));
};
const owner = review => {
  assert.equal(review.reviewer.kind, 'independent_agent');
  assert.equal(review.book, '8a');
  assert.equal(review.lesson, id);
  assert.equal(review.edition, 'modern-us-neutral');
};
const text = read(textPath, textHash), figure = read(figurePath, figureHash);
const answer = read(answerPath, answerHash), choice = read(choicePath, choiceHash);
for (const review of [text, figure, answer]) owner(review);
assert.equal(choice.reviewer.kind, 'independent_agent');
assert.equal(text.status, 'TEXT_PASS');
assert.equal(figure.status, 'pass');
assert.equal(answer.status, 'pass');
assert.equal(choice.outcome, 'pass');
const exercises = read(`${lesson}/exercises.json`);
const count = exercises.exercises.length;
assert.equal(count, 20);
assert.deepEqual(exercises.exercises.map(item => String(item.number)),
  ["278","279","280","281","282","283","284","285","286","287","288","289","290","291","292","293","294","295","296","297"]);
const normalizationCalls = [];
const normalize = (name, document) => {
  const helper = name === 'lesson' ? 'normalize_lesson_layout' : 'normalize_exercise_layout';
  const input = JSON.stringify(document);
  const result = spawnSync(`${repo}/.claude/skills/ld-s10y-lesson/.venv/bin/python`, [
    '-c',
    `import json,sys; sys.path.insert(0,${JSON.stringify(`${repo}/.claude/skills/ld-s10y-lesson/tools`)}); import edition; value=json.load(sys.stdin); edition.${helper}(value); json.dump(value,sys.stdout,ensure_ascii=True)`,
  ], { cwd: repo, input, encoding: 'utf8', maxBuffer: 8 * 1024 * 1024,
    env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1' } });
  assert.equal(result.status, 0, result.stderr);
  normalizationCalls.push({
    module: bound(`${repo}/.claude/skills/ld-s10y-lesson/tools/edition.py`),
    helper, inputSha256: sha(Buffer.from(input)), outputSha256: sha(Buffer.from(result.stdout)),
    returncode: result.status, rendererCalls: 0, productionWrites: 0,
  });
  return JSON.parse(result.stdout);
};
for (const [name, item] of Object.entries(text.approved_text_bindings)) {
  const template = normalize(name, read(item.path, item.sha256));
  const final = read(`${lesson}/${name}.json`);
  template.status = 'ready';
  if (name === 'lesson') template.exercise_count = count;
  else template.count = count;
  assert.deepEqual(final, template);
}
const candidate = read(answer.answerKey.path, answer.answerKey.sha256);
const answers = read(`${lesson}/answer-keys.json`);
candidate.status = 'ready';
candidate.count = count;
assert.deepEqual(answers, candidate);
assert.equal(answers.answers.length, count);
assert.ok(answers.answers.every(item => item.parts.every(part => part.judge !== 'exact')));
const manifest = read(`${lesson}/figures.json`);
const figureIds = manifest.figures.map(item => item.id).sort();
assert.deepEqual(figureIds, []);
assert.deepEqual(figure.figures.map(item => item.id).sort(), figureIds);
assert.equal(read(`${lesson}/adaptation.audit.json`).status, 'pass');
assert.equal(read(`${lesson}/answer-keys.audit.json`).status, 'pass');
const native = read(`${lesson}/choice-set/review.json`);
assert.deepEqual(native, choice);
assert.equal(native.source_reviews.length, count);
const draft = read(`${lesson}/choice-set/draft.json`);
assert.equal(draft.new_figures.length, 0);
const files = {
  modern: ['lesson.json', 'exercises.json', 'figures.json', 'adaptation.audit.json']
    .map(name => bound(`${lesson}/${name}`)),
  answers: ['answer-keys.json', 'answer-keys.audit.json'].map(name => bound(`${lesson}/${name}`)),
  choices: ['seed.json', 'draft.json', 'review.json'].map(name => bound(`${lesson}/choice-set/${name}`)),
  figures: figureIds.flatMap(figureId => ['spec.json', 'svg', 'render.json', 'review.json', 'render.png']
    .map(ext => bound(`${edition}/figures/${figureId}.${ext}`))),
};
for (const figureId of figureIds) {
  const nativeReview = read(`${edition}/figures/${figureId}.review.json`);
  assert.equal(nativeReview.status, 'pass');
  const reviewed = figure.figures.find(item => item.id === figureId);
  assert.equal(bound(`${edition}/figures/${figureId}.spec.json`).sha256, reviewed.spec.sha256);
  assert.equal(bound(`${edition}/figures/${figureId}.svg`).sha256, reviewed.svg.sha256);
}
const usagePath = `${base}/upstream-usage.record`;
const usage = read(usagePath);
assert.equal(usage.schema, 'stemrobin-182/upstream-usage-preservation@1');
const ready = {
  schema: 'n18-parent-display-ready@1', status: 'parentREADY', ticket: 'STEMROBIN-182',
  scope: { root: repo, book: '8a', edition: 'modern-us-neutral', lesson: id },
  authorization: { offlineDisplay: true, rendererCalls: 1, appAcceptance: false, production: false },
  files: Object.values(files).flat(),
  approvals: {
    modern: { status: 'pass', files: files.modern,
      receipts: [bound(textPath), bound(`${lesson}/adaptation.audit.json`)] },
    answers: { status: 'pass', finalized: true, files: files.answers,
      receipts: [bound(answerPath), bound(`${lesson}/answer-keys.audit.json`)] },
    choices: { status: 'pass', retained: true, files: files.choices,
      receipts: [bound(`${lesson}/choice-set/review.json`)] },
    figures: { status: 'pass', ids: figureIds, files: files.figures, receipts: [bound(figurePath)] },
  },
  upstreamUsage: bound(usagePath), currentImageAccountingPreserved: true,
  nativeNormalization: normalizationCalls,
  oldPassReruns: 0, databaseWrites: 0, finish: 'review',
};
for (const [filename, bytes] of snapshots) assert.equal(sha(fs.readFileSync(filename)), sha(bytes));
const output = `${base}/parent-ready.record`;
fs.writeFileSync(output, `${JSON.stringify(ready, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(bound(output)));
