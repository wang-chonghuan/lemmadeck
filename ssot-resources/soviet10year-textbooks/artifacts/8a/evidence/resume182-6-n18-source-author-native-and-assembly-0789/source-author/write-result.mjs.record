import { createHash } from "node:crypto";
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

const root = "/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck";
const scratch = ".tmp/resume182-6-8a-n18-0789/source-author";
const source = ".tmp/resume182-6-8a-n18-0789/source/8a/pages";
const artifacts = "ssot-resources/soviet10year-textbooks/artifacts/8a/pages";
if (process.cwd() !== root) throw new Error("Wrong working directory");

function file(relative) {
  const absolute = path.join(root, relative);
  const bytes = readFileSync(absolute);
  return {
    path: absolute,
    sha256: createHash("sha256").update(bytes).digest("hex"),
    bytes: bytes.length,
  };
}

function requireHash(relative, expected) {
  const actual = file(relative);
  if (actual.sha256 !== expected) throw new Error(`Changed retained binding: ${relative}`);
  return actual;
}

function parsePage(relative) {
  const text = readFileSync(path.join(root, relative), "utf8");
  const match = text.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  if (!match) throw new Error(`Invalid frontmatter: ${relative}`);
  const meta = JSON.parse(match[1]);
  const blocks = [];
  let current;
  for (const line of match[2].split("\n")) {
    if (!line.trim()) continue;
    if (line.startsWith("<!--")) {
      const header = line.match(/^<!-- ([a-z0-9 ]+) -->$/);
      if (!header) throw new Error(`Unexpected block header: ${relative}`);
      current = { header: header[1], lines: [] };
      blocks.push(current);
    } else {
      if (!current) throw new Error(`Unowned body row: ${relative}`);
      current.lines.push(line);
    }
  }
  for (const block of blocks) {
    if (!block.lines.length) throw new Error(`Empty block: ${relative}`);
    for (const line of block.lines) {
      if ((line.match(/\$/g)?.length ?? 0) % 2) throw new Error(`Unpaired math delimiter: ${relative}`);
      if (/[абвгде]\)/u.test(line) && /(?:^|\s)[a-z]\)/.test(line)) {
        throw new Error(`Latin subpart label: ${relative}`);
      }
    }
  }
  return { meta, blocks };
}

const expected = {
  "0106": { printed: 99, rows: 23, headers: ["p cont", "p", "p", "p", "p", "p", "p", "p", "p open", "foot"] },
  "0107": { printed: 100, rows: 22, headers: ["p cont", "p", "p", "p", "ex 278", "ex 279", "ex 280 open", "foot"] },
  "0108": { printed: 101, rows: 22, headers: ["ex 280 cont", "ex 281", "ex 282", "ex 283", "ex 284", "ex 285", "ex 286", "ex 287", "ex 288", "foot"] },
  "0109": { printed: 102, rows: 23, headers: ["ex 289", "ex 290", "ex 291", "ex 292", "ex 293", "exhead", "ex 294", "ex 295", "ex 296", "foot"] },
  "0110": { printed: 103, rows: 24, headers: ["ex 297", "h3", "p", "p", "p", "p", "p", "p", "p", "p", "p", "p open", "foot"] },
};

const pages = Object.entries(expected).map(([id, expect]) => {
  const relative = `${artifacts}/${id}/page.md`;
  const parsed = parsePage(relative);
  const templateText = readFileSync(path.join(root, source, id, "page.template.md"), "utf8");
  const template = JSON.parse(templateText.match(/^---\n([\s\S]*?)\n---/)[1]);
  const image = file(`${source}/${id}/page.png`);
  const grid = file(`${source}/${id}/page.grid.png`);
  for (const key of ["schema", "book", "page", "source", "render", "profile"]) {
    if (JSON.stringify(parsed.meta[key]) !== JSON.stringify(template[key])) {
      throw new Error(`Template binding drift in ${id}: ${key}`);
    }
  }
  if (image.sha256 !== parsed.meta.render.sha256) throw new Error(`Image binding drift in ${id}`);
  if (parsed.meta.printed_page !== expect.printed) throw new Error(`Wrong footer in ${id}`);
  if (JSON.stringify(parsed.blocks.map(block => block.header)) !== JSON.stringify(expect.headers)) {
    throw new Error(`Block ordering drift in ${id}`);
  }
  const totalRows = parsed.blocks.reduce((sum, block) => sum + block.lines.length, 0);
  if (totalRows !== expect.rows) throw new Error(`Authored row count drift in ${id}`);
  if (id === "0110" && parsed.blocks[1].lines[0] !== "19. 等比数列前$n$项的和的公式") {
    throw new Error("Right-boundary heading drift");
  }
  const inventory = JSON.parse(readFileSync(path.join(root, scratch, `${id}.after.record`)));
  if (inventory.rows.total !== totalRows) throw new Error(`Inventory row mismatch in ${id}`);
  return {
    physicalPage: Number(id),
    printedPagePixelConfirmed: expect.printed,
    sourcePage: { pdf: parsed.meta.source, template: file(`${source}/${id}/page.template.md`), layout: file(`${source}/${id}/layout.json`) },
    sourceImage: image,
    sourceGrid: grid,
    authoredMd: file(relative),
    authoredBlockCount: parsed.blocks.length,
    authoredBodyLines: totalRows - parsed.blocks.at(-1).lines.length,
    authoredFooterLines: parsed.blocks.at(-1).lines.length,
    authoredTotalLines: totalRows,
    blockOrdering: parsed.blocks.map((block, index) => ({
      ref: `p${id}#${index + 1}`,
      header: block.header,
      printedLines: block.lines.length,
    })),
    inventory: file(`${scratch}/${id}.after.record`),
    figureInventory: inventory.figureInventory,
    unresolvedUncertainties: inventory.uncertainties,
    gridViews: 1,
    cropViews: inventory.cropViews,
  };
});

