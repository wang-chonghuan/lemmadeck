    "rationales": [
      {
        "option_id": "a",
        "truth": "correct",
        "derivation": "Starting at 10, n-1 increments of 10 give 10+10(n-1)=10n. Its first five values are exactly the displayed prefix.",
        "misconception": null
      },
      {
        "option_id": "b",
        "truth": "incorrect",
        "derivation": "Replace q_(n+1)=10q_n by q_(n+1)=q_n+10. Starting at 10 gives the displayed arithmetic prefix and q_n=10+10(n-1)=10n.",
        "misconception": "Treat multiplying by 10 as adding 10 when extending the sequence and deriving its formula."
      },
      {
        "option_id": "c",
        "truth": "incorrect",
        "derivation": "Replace r_(n+1)=r_n+2 by r_(n+1)=2r_n. This yields 2,4,8,16,32 and 2*2^(n-1)=2^n.",
        "misconception": "Infer doubling from the common first two values 2,4 instead of respecting the additive recurrence."
      },
      {
        "option_id": "d",
        "truth": "correct",
        "derivation": "The initial factor 2 followed by n-1 doublings gives 2*2^(n-1)=2^n; evaluation at n=1,...,5 gives 2,4,8,16,32.",
        "misconception": null
      },
      {
        "option_id": "e",
        "truth": "correct",
        "derivation": "The initial factor 10 followed by n-1 multiplications by 10 gives 10*10^(n-1)=10^n and the displayed first five values.",
        "misconception": null
      },
      {
        "option_id": "f",
        "truth": "incorrect",
        "derivation": "Count an increment even at the first position: p_n=10+10n=10(n+1), giving 20,30,40,50,60 at indices 1 through 5.",
        "misconception": "Apply n increments after the supplied first value instead of n-1, shifting both prefix and formula."
