import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/resume182-6-8a-n13-0789';
const file = `${base}/choices-FIRST/draft.json`;
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const entry = file => ({ path: path.resolve(file), sha256: sha(fs.readFileSync(file)), bytes: fs.statSync(file).size });
const before = entry(file);
assert.equal(before.sha256, '4cb3c5575e847d481c12c2b695a12a6f6391e7edded6f408cc587cb911d26b95');
const draft = JSON.parse(fs.readFileSync(file));
const original = structuredClone(draft);
const question = draft.questions.find(item => item.id === 'prefix-and-formula');
assert.deepEqual(question.source_numbers, ['221']);
const option = id => question.view.options.find(item => item.id === id);
const rationale = id => question.key.rationales.find(item => item.option_id === id);
assert.ok(option('b').text.includes('q_n=10n'));
assert.ok(option('f').text.includes('20,\\ 30,\\ 40,\\ 50,\\ 60'));
option('b').text = option('b').text.replace('q_n=10n', 'q_n=10^n');
option('f').text = option('f').text.replace('20,\\ 30,\\ 40,\\ 50,\\ 60', '10,\\ 20,\\ 30,\\ 40,\\ 50');
rationale('b').derivation = 'The general formula q_n=10^n is correctly obtained from the supplied initial factor 10 and n-1 multiplications. The prefix is incorrectly generated by repeatedly adding 10, producing 10,20,30,40,50 instead of the geometric prefix. Its formula alone is true but the required combined claim is false.';
rationale('b').misconception = 'Remember the correct geometric general term but extend the early terms using addition instead of multiplication.';
rationale('f').derivation = 'The displayed prefix is correctly obtained by four successive additions of 10 after p_1=10. The proposed general formula incorrectly counts n additions rather than n-1, giving 10+10n=10(n+1); it fails p_1=10. Its prefix alone is true but the required combined claim is false.';
rationale('f').misconception = 'Correctly iterate the recurrence for early terms, then apply an extra increment when translating the index into a general formula.';
question.intent.unit_reason = 'Each alternative is a complete prefix-plus-formula pair across the four initial-value rules. Option f has the correct prefix and an incorrect formula, while b has an incorrect prefix and the correct formula. The complete correct set therefore requires judging both components: checking prefixes alone adds f; checking formulas alone adds b. Multiple selection retains one coherent comparison, not per-term or per-slot questions.';
assert.deepEqual(question.key.correct, ['a', 'd', 'e', 'g']);
const unchanged = value => {
  const copy = structuredClone(value);
  copy.questions = copy.questions.filter(item => item.id !== question.id);
  return copy;
};
assert.deepEqual(unchanged(draft), unchanged(original));
const directory = `${base}/choice-221formula1`;
fs.mkdirSync(directory);
fs.writeFileSync(`${directory}/question-before.record`,
  `${JSON.stringify(original.questions.find(item => item.id === question.id), null, 2)}\n`, { flag: 'wx' });
fs.writeFileSync(file, `${JSON.stringify(draft, null, 2)}\n`);
const projection = `${base}/choice-review-FIRST/views-affected221.record`;
const write = (file, data) => {
  fs.writeFileSync(file, `${JSON.stringify(data, null, 2)}\n`, { flag: 'wx' });
  return entry(file);
};
const projected = write(projection, {
  schema: 'stemrobin-182/choice-visible-review-projection@1',
  book: '8a', lesson: 'alg8-c3-s1-n13', edition: 'modern-us-neutral',
  draft: entry(file), questions: draft.questions.map(item => ({
    id: item.id, source_numbers: item.source_numbers, view: item.view,
  })), new_figures: [], authorKeysAndIntentDisclosed: false,
});
console.log(JSON.stringify(write(`${directory}/result.record`, {
  status: 'AFFECTED_221_PREFIX_FORMULA_JUDGMENT_REPAIRED_NOT_APPROVED',
  book: '8a', lesson: 'alg8-c3-s1-n13', edition: 'modern-us-neutral',
  original: before, current: entry(file), keylessProjection: projected,
  changedQuestion: question.id, changedOptions: ['b', 'f'],
  changedKeys: 0, otherQuestionsOrCoverageChanged: false,
  sourceOrAnswerChanged: false, newImages: 0, oldPassReruns: 0,
  databaseWrites: 0, finish: 'review', hostTokens: 'unknown', totalCost: 'unknown',
})));
