import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';

const R = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), R);
const work = path.join(R, '.tmp/resume182-6-8a-n10-source3695-FIRST');
const author = path.join(R, '.tmp/resume182-6-8a-n10-source-author3695-FIRST');
const hash = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const identity = file => {
  const bytes = fs.readFileSync(file);
  return { path: file, sha256: hash(bytes), bytes: bytes.length };
};
const json = file => JSON.parse(fs.readFileSync(file, 'utf8'));
const observations = json(path.join(author, 'observations.record'));
const preflight = fs.readFileSync(path.join(author, '006-preflight-inputs-FIRST/stdout.txt'), 'utf8');
const baseline = JSON.parse(preflight.split('INPUT_HASHES\n')[1].split('\nN8 RECEIPT DIRS\n')[0]);
const prepared = baseline.map(previous => {
  const current = identity(previous.path);
  assert.equal(current.sha256, previous.sha256, `Prepared input changed: ${previous.path}`);
  return { ...current, unchangedFromPreflight: true };
});
const profile = identity(path.join(R, '.claude/skills/ld-s10y-lesson/profiles/soviet-cn.json'));
