const manifest = json(sourceManifest);
const catalog = manifest.catalogs.find(item => item.book === '8a');
assert.ok(catalog);
const pdfRecord = manifest.pdfs.find(item => item.book === catalog.sourcePdf);
assert.ok(pdfRecord);
const roots = path.isAbsolute(manifest.pdfRoot) ? [manifest.pdfRoot] : [
  path.join(R, manifest.pdfRoot), path.join(path.dirname(sourceManifest), manifest.pdfRoot),
];
const pdfPath = roots.map(root => path.join(root, pdfRecord.file)).find(file => fs.existsSync(file));
assert.ok(pdfPath);
const pdf = identity(pdfPath);
const pages = observations.nativeImages.map(native => {
  const number = String(native.physical).padStart(4, '0');
  const pdir = path.join(work, 'draft-root/8a/pages', number);
  const wdir = path.join(work, '8a/pages', number);
  const page = json(path.join(pdir, 'page.json'));
  const audit = json(path.join(pdir, 'audit.json'));
  const template = JSON.parse(fs.readFileSync(path.join(wdir, 'page.template.md'), 'utf8').split('---')[1]);
  assert.deepEqual(page.meta.source, template.source);
  assert.deepEqual(page.meta.render, template.render);
  assert.deepEqual(page.meta.profile, template.profile);
  assert.equal(page.meta.source.pdf_sha256, pdf.sha256);
  assert.equal(page.meta.profile.sha256, profile.sha256);
  assert.equal(page.meta.source.pdf_page, native.physical);
  assert.equal(page.meta.printed_page, native.printed);
  assert.equal(native.physical - native.printed, 7);
  assert.equal(page.blocks.at(-1).kind, 'foot');
  assert.equal(page.blocks.at(-1).lines.join(''), String(native.printed));
  const commandIndex = { '0060': '013', '0061': '015', '0062': '017', '0063': '020' }[number];
  const receiptPath = path.join(author, `${commandIndex}-p${number}-finalize-FIRST/receipt.record`);
  const receipt = json(receiptPath);
  assert.equal(receipt.cwd, R);
  assert.equal(receipt.returncode, audit.errors.length ? 1 : 0);
  return {
    ...native,
    offset: 7,
    files: ['page.md', 'page.json', 'audit.json'].map(file => identity(path.join(pdir, file))),
    inputs: prepared.filter(file => file.path.startsWith(wdir + '/')),
    authorSnapshot: identity(path.join(author, `${number}-author-FIRST-snapshot/manifest.record`)),
    failureSnapshot: audit.errors.length
      ? identity(path.join(author, `${number}-failure-FIRST-snapshot/manifest.record`)) : null,
    finalize: {
      stage: 'FIRST', attempts: 1, retries: 0, receipt: identity(receiptPath),
      returncode: receipt.returncode,
      status: audit.errors.length ? 'FAIL' : 'PASS',
      linesPrintedMachine: audit.lines_printed,
      linesTranscribed: audit.lines_md,
      errors: audit.errors,
      unknownChars: audit.unknown_chars,
      normalizations: audit.normalizations,
      katexWarnings: audit.katex_warnings,
    },
    blockInventory: page.blocks.map((block, index) => ({
      ref: `p${number}#${index + 1}`, kind: block.kind, label: block.label,
      cont: block.cont, open: block.open, samerow: block.samerow,
      ownerEx: block.owner_exercise,
    })),
    figures: audit.figures.map(figure => ({
      ref: `p${number}#${page.blocks.findIndex(block => block.kind === 'fig' && block.id === figure.id) + 1}`,
      id: figure.id, printedLabel: figure.label,
      coarseBox: figure.from, snappedBox: figure.box,
      components: figure.components,
      output: identity(path.join(wdir, 'figures', `${figure.id}.png`)),
      visuallyOpened: false,
      physicalMeasurementInferred: false,
    })),
  };
});
const failures = pages.filter(page => page.finalize.returncode !== 0);
assert.deepEqual(failures.map(page => page.physical), [62]);
const proof = ['commit', 'push', 'remote-confirm'].map(stage => {
  const dir = path.join(R, `.tmp/resume182-6-8a-n8-${stage}3695-FIRST`);
  const receipt = json(path.join(dir, 'receipt.record'));
  assert.equal(receipt.returncode, 0);
  return {
    stage, returncode: receipt.returncode,
    files: ['receipt.record', 'stdout.txt', 'stderr.txt'].map(file => identity(path.join(dir, file))),
  };
});
const remote = fs.readFileSync(path.join(R, '.tmp/resume182-6-8a-n8-remote-confirm3695-FIRST/stdout.txt'), 'utf8').trim().split(/\s+/);
assert.equal(remote[0], '127efaf507aabd664f73c4516fe9154b03c9fa56');
const records = [];
function inventory(dir) {
  for (const item of fs.readdirSync(dir, { withFileTypes: true })) {
    const file = path.join(dir, item.name);
    if (item.isDirectory()) inventory(file);
    else if (item.isFile() && item.name !== 'ready.record') records.push(identity(file));
  }
}
inventory(author);
