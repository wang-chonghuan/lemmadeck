{
  "inventory": [
    {
      "id": "fig24-source-grid",
      "description": "Exactly 12 columns by 18 rows, integer phase; origin left5/right7/top11/bottom7. It is neither square nor centered. Source bounds [-5,11,7,-7], steps [1,1], offsets [0,0]; origin left/right/above/below [5,7,11,7].",
      "objects": [
        "fig24-frame",
        "fig24-grid"
      ],
      "assertions": [
        "fig24-grid-dimensions",
        "fig24-grid-phase-units",
        "fig24-grid-origin-left-top",
        "fig24-grid-origin-right-bottom",
        "fig24-grid-unit-equality"
      ],
      "requires": [
        "gridDimensions"
      ],
      "mappedObjectCount": 2,
      "mappedAssertionCount": 5
    },
    {
      "id": "fig24-source-axes-unit-labels",
      "description": "One shared axis frame with positive arrows, origin/x/y and two unit labels; y-unit 1 is on the RIGHT of the y axis. Original labels and sides: 0: Immediately southwest of the axes intersection, below x axis and left of y axis, inside the hatched strip. x: Near positive x end, below horizontal axis and right of the arrowhead. y: Near positive y end, left of vertical axis. 1: Below the x axis at x=1, the first coarse line right of origin, inside the strip. 1: RIGHT of the y axis at y=1, the first coarse line above origin, inside the strip. This is not the left-side placement of fig-23.",
      "objects": [
        "fig24-x-axis",
        "fig24-y-axis",
        "fig24-x-positive-arrow",
        "fig24-y-positive-arrow",
        "fig24-origin-label",
        "fig24-x-label",
        "fig24-y-label",
        "fig24-x-unit-label",
        "fig24-y-unit-label"
      ],
      "assertions": [
        "fig24-axes-orthogonal",
        "fig24-axes-origin",
        "fig24-axes-origin-on-y",
        "fig24-x-arrow-connects",
        "fig24-x-arrow-positive",
        "fig24-y-arrow-connects",
        "fig24-y-arrow-positive",
        "fig24-x-unit-position",
        "fig24-y-unit-position",
        "fig24-origin-label-anchor-inside-frame",
        "fig24-x-label-anchor-inside-frame",
        "fig24-y-label-anchor-inside-frame",
        "fig24-x-unit-label-anchor-inside-frame",
        "fig24-y-unit-label-anchor-inside-frame"
      ],
      "mappedObjectCount": 9,
      "mappedAssertionCount": 14
    },
    {
      "id": "fig24-source-strip-boundaries",
      "description": "Two included solid slope-2 parallels, upper y=2x+2 and lower y=2x-3; preserve line-label associations and half-cell lower x intercept.",
      "objects": [
        "fig24-upper-line",
        "fig24-lower-line",
        "fig24-upper-line-label",
        "fig24-lower-line-label"
      ],
      "assertions": [
        "fig24-upper-line-endpoints",
        "fig24-lower-line-endpoints",
        "fig24-lines-parallel",
        "fig24-upper-equation-intercepts",
        "fig24-upper-x-intercept",
        "fig24-upper-intercept-displacement",
        "fig24-upper-slope2",
        "fig24-lower-equation-intercepts",
        "fig24-lower-x-intercept",
        "fig24-lower-intercept-displacement",
        "fig24-lower-slope2",
        "fig24-lower-equation-intercepts-halfcell",
        "fig24-boundary-vertical-gap5",
        "fig24-upper-line-label-anchor-inside-frame",
        "fig24-lower-line-label-anchor-inside-frame"
      ],
      "mappedObjectCount": 4,
      "mappedAssertionCount": 15
    },
    {
      "id": "fig24-source-strip-hatching",
      "description": "SW-to-NE hatching confined to the strip, shallower than the boundaries. The graph's origin is inside the strip. Original shading: Parallel oblique strokes rising southwest to northeast (/), shallower than the two boundary lines; NOT parallel to those boundaries; Only the closed strip 2x-3<=y<=2x+2 within frame. No hatching outside the two lines. No deliberate dashed boundary.",
      "objects": [
        "fig24-strip-region"
      ],
      "assertions": [
        "fig24-strip-includes-origin",
        "fig24-strip-corner-0-on-boundary",
        "fig24-strip-corner-1-on-boundary",
        "fig24-strip-corner-2-on-boundary",
        "fig24-strip-corner-3-on-boundary"
      ],
      "mappedObjectCount": 43,
      "mappedAssertionCount": 341
    }
