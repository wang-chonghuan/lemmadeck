import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = `${repo}/.tmp/resume182-6-8a-n15-0789`;
const [reviewFile, reviewHash] = process.argv.slice(2);
assert.ok(path.isAbsolute(reviewFile) && reviewFile.startsWith(`${base}/choice-review-FIRST/`));
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bind = file => ({ path: file, sha256: sha(fs.readFileSync(file)) });
const bytes = fs.readFileSync(reviewFile);
assert.equal(sha(bytes), reviewHash);
const review = JSON.parse(bytes);
assert.equal(review.schema, 's10y-choice-review-v1');
assert.equal(review.outcome, 'pass');
assert.equal(review.reviewer.kind, 'independent_agent');
const directory = `${base}/choices-AFFECTED248`;
const draft = JSON.parse(fs.readFileSync(`${directory}/draft.json`));
assert.equal(review.question_reviews.length, draft.questions.length);
assert.equal(review.source_reviews.length, 22);
const target = `${directory}/review.json`;
fs.writeFileSync(target, bytes, { flag: 'wx' });
const record = {
  status: 'APPROVED_REVIEW_BYTES_BOUND_NATIVE_RETENTION_PENDING',
  source: bind(reviewFile), target: bind(target),
  candidateDraft: bind(`${directory}/draft.json`),
  firstDraftPreserved: bind(`${base}/choices-FIRST/draft.json`),
  imagesViewed: 0, sourceOrDraftChangedByBinding: false, oldPassReruns: 0,
  databaseWrites: 0, finish: 'review', hostTokens: 'unknown', totalCost: 'unknown',
};
fs.writeFileSync(`${base}/choice-review-affected248-binding.record`,
  `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(record));
