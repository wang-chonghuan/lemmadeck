import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = `${repo}/.tmp/resume182-6-8a-n15-0789`;
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bind = file => ({ path: file, sha256: sha(fs.readFileSync(file)) });
const original = `${base}/choices-FIRST/draft.json`;
assert.equal(bind(original).sha256, '46ea72805d9faf80477dd297860d5e2c721f04446103d5c65a675423c44d0784');
const candidate = `${base}/choices-AFFECTED248/draft.json`;
const [candidateHash] = process.argv.slice(2);
assert.equal(bind(candidate).sha256, candidateHash);
const before = JSON.parse(fs.readFileSync(original));
const after = JSON.parse(fs.readFileSync(candidate));
assert.equal(after.schema, before.schema);
assert.equal(after.seed_sha256, before.seed_sha256);
assert.deepEqual(after.new_figures, before.new_figures);
const affected = question => question.source_numbers.includes('248');
assert.deepEqual(after.questions.filter(question => !affected(question)),
  before.questions.filter(question => !affected(question)));
assert.deepEqual(after.coverage.filter(item => item.source_number !== '248'),
  before.coverage.filter(item => item.source_number !== '248'));
assert.equal(after.coverage.length, 22);
assert.ok(after.questions.some(affected));
const directory = `${base}/choice-review-FIRST/affected248`;
assert.ok(!fs.existsSync(directory));
fs.mkdirSync(directory);
const output = `${directory}/views.record`;
fs.writeFileSync(output, `${JSON.stringify({
  schema: 'stemrobin-182/choice-visible-review-projection@1',
  book: '8a', lesson: 'alg8-c3-s2-n15', edition: 'modern-us-neutral',
  draft: bind(candidate), originalDraft: bind(original),
  affectedSourceNumbers: ['248'],
  questions: after.questions.filter(affected).map(question => ({
    id: question.id, source_numbers: question.source_numbers, view: question.view,
  })),
  new_figures: after.new_figures,
  authorKeysAndIntentDisclosed: false,
  unchangedQuestions: after.questions.filter(question => !affected(question)).length,
  unaffectedQuestionsAndCoverageCompared: true,
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(bind(output)));
