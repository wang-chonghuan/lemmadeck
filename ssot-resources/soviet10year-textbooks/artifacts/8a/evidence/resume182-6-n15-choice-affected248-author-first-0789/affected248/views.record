  "questions": [
    {
      "id": "q248-mixed-difference",
      "source_numbers": [
        "248"
      ],
      "view": {
        "mode": "single",
        "stem": "数列由 $b_n=2n+3$ 给出，$k,n$ 为独立的正整数。哪一项正确给出 $b_2-b_1$、$b_{10}-b_9$、$b_{k+1}-b_n$，以及是否为等差数列的判断？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "三个差依次为 $2,2,2$；是等差数列，公差为 $2$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "三个差依次为 $2,2,2(k+1-n)$；是等差数列，公差为 $2$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "三个差依次为 $2,2,2(k+1-n)$；不是等差数列，没有固定公差。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "三个差依次为 $-2,-2,2(n-k-1)$；是等差数列，公差为 $-2$。",
            "figure_ids": []
          }
        ]
      }
    }
  ],
