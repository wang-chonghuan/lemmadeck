  {
    "mode": "single",
    "stem": "Solve $2^x=(4^{-1/3})^{12}\\cdot8^{2/3}$. Which complete base-2 calculation is valid?",
    "figure_ids": [],
    "options": [
      {
        "id": "a",
        "text": "$\\text{RHS}=2^{-4}\\cdot2^2=2^{-2}$, so $x=-2$.",
        "figure_ids": []
      },
      {
        "id": "b",
        "text": "$\\text{RHS}=2^{-8}\\cdot2^2=2^{-6}$, so $x=-6$.",
        "figure_ids": []
      },
      {
        "id": "c",
        "text": "$\\text{RHS}=2^{-8}\\cdot2^2=2^{-16}$, so $x=-16$.",
        "figure_ids": []
      }
    ]
  },
  {
    "mode": "single",
    "stem": "Solve $3^x=(9^{-1/3})^6\\cdot27^{0.5}$. Which complete base-3 calculation is valid?",
    "figure_ids": [],
    "options": [
      {
        "id": "a",
        "text": "$\\text{RHS}=3^{-4}\\cdot3^{3/2}=3^{-5/2}$, so $x=-5/2$.",
        "figure_ids": []
      },
      {
        "id": "b",
        "text": "$\\text{RHS}=3^{-2}\\cdot3^{3/2}=3^{-1/2}$, so $x=-1/2$.",
        "figure_ids": []
      },
      {
        "id": "c",
        "text": "$\\text{RHS}=3^{-4}\\cdot3^{1/2}=3^{-7/2}$, so $x=-7/2$.",
        "figure_ids": []
      }
    ]
  }
]
