    {"question_id":"c2p2-sum-product","task_fidelity":{"verdict":"pass","evidence":"161c retains product quadratic, sum 6, ordered swaps and all real roots."},"redundancy":{"verdict":"pass","evidence":"Options differ in negative product retention and erroneous quadratic coefficients."},"answer_leakage":{"verdict":"pass","evidence":"Other systems do not supply xy=8 or -9."},"mathematics":{"verdict":"pass","independent_solution":"p^2+p=72 yields p=8,-9; x+y=6 gives roots 2,4 or 3+-3sqrt2, with both swaps.","correct":["a"],"option_checks":[{"option_id":"a","truth":"correct","evidence":"Products 8 and -9 give 64+8=72 and 81-9=72; sums 6."},{"option_id":"b","truth":"incorrect","evidence":"Omits real negative-product pair and its swap."},{"option_id":"c","truth":"incorrect","evidence":"(3,3) product 9 gives 90; radical pairs have product -8 giving 56, neither 72."}]}},
