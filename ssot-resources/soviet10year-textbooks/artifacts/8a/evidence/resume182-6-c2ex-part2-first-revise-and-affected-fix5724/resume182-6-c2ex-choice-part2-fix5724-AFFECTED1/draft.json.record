    {
      "id": "c2p2-absolute-regions",
      "source_numbers": [
        "170"
      ],
      "view": {
        "mode": "multiple",
        "stem": "对 $y\\geq|x|$、$y\\leq-|x|$、$y\\geq|x-2|$、$y\\leq|1-x|$ 的区域，选择所有完整且正确的描述。各式均允许任意实数横坐标。",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$y\\geq|x|$：位于两射线 $y=|x|$ 的上方，包含边界；等价于同时满足 $y\\geq x$、$y\\geq-x$。",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$y\\leq|1-x|$：顶点 $(1,0)$，包含边界；等价于同时满足 $y\\leq1-x$、$y\\leq x-1$。",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$y\\leq-|x|$：位于两射线 $y=-|x|$ 的下方，包含边界；等价于同时满足 $y\\leq x$、$y\\leq-x$。",
            "figure_ids": []
          },
          {
            "id": "d",
            "text": "$y\\geq|x-2|$：顶点 $(-2,0)$，包含边界；等价于同时满足 $y\\geq x+2$、$y\\geq-x-2$。",
            "figure_ids": []
          },
          {
            "id": "e",
            "text": "$y\\geq|x-2|$：顶点 $(2,0)$，包含边界；等价于同时满足 $y\\geq x-2$、$y\\geq2-x$。",
            "figure_ids": []
          },
          {
            "id": "f",
            "text": "$y\\geq|x|$：位于两射线 $y=-|x|$ 的下方，包含边界；等价于同时满足 $y\\leq x$、$y\\leq-x$。",
            "figure_ids": []
          },
          {
            "id": "g",
            "text": "$y\\leq|1-x|$：顶点 $(1,0)$，包含边界；等价于 $y\\leq1-x$ 或 $y\\leq x-1$，至少满足一个。",
            "figure_ids": []
          },
          {
            "id": "h",
            "text": "$y\\leq-|x|$：位于两射线 $y=|x|$ 的上方，包含边界；等价于同时满足 $y\\geq x$、$y\\geq-x$。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "识别绝对值的上包络、负绝对值下包络、水平平移与并集/交集区别。",
        "source_solution": "c为y>=max(x,-x)，d为y<=min(x,-x)，e为y>=max(x-2,2-x)，f为y<=max(1-x,x-1)。前三者为两半平面交集，最后为并集。顶点依次(0,0),(0,0),(2,0),(1,0)，边界全包含。",
        "unit_reason": "四种完整区域描述构成共同的绝对值包络比较；每项有实际几何断言，不是逐坐标点击或组合编码。",
        "concept_blocks": [],
        "limitations": [
          "不能证明自行绘制V形边界、射线和阴影。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "a",
          "c",
          "e",
          "g"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "correct",
            "derivation": "|x|=max(x,-x)，大于等于最大值需同时大于等于两者，边界包含。",
            "misconception": null
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "把小于等于max误作小于等于两者，得到y<=min(1-x,x-1)=-|x-1|。例如(1,-1)包含但(0,0)本来包含而此描述排除。",
            "misconception": "最大值之下的并集误写为两条件的交集。"
          },
          {
            "option_id": "c",
            "truth": "correct",
            "derivation": "-|x|=min(x,-x)，y不大于最小值即同时不大于两者，所有边界点包含。",
            "misconception": null
          },
          {
            "option_id": "d",
            "truth": "incorrect",
            "derivation": "将x-2误读成x+2，边界变成|x+2|，顶点从2移到-2，两支成为x+2和-x-2。",
            "misconception": "横向平移方向颠倒。"
          },
          {
            "option_id": "e",
            "truth": "correct",
            "derivation": "|x-2|=max(x-2,2-x)，两支在x=2相交为0，交集包含等号边界。",
            "misconception": null
          },
          {
            "option_id": "f",
            "truth": "incorrect",
            "derivation": "把y>=max(x,-x)的两个>=都改成<=，得到y<=-abs(x)；(0,1)在源区域却被排除。",
            "misconception": "把上方区域错作下方交集。"
          },
          {
            "option_id": "g",
            "truth": "correct",
            "derivation": "y<=max(a,b)当且仅当y<=a或y<=b。a=1-x,b=x-1，顶点1,0且边界包括。",
            "misconception": null
          },
          {
            "option_id": "h",
            "truth": "incorrect",
            "derivation": "对y<=-|x|两边乘-1后正确应为-y>=|x|，误把-y继续写成y，产生y>=|x|。",
            "misconception": "乘负数后遗漏纵坐标的负号。"
          }
        ]
      }
    },
