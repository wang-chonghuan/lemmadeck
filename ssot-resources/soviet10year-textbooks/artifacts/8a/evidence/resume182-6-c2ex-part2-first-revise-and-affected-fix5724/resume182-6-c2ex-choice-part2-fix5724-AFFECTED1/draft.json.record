    {
      "id": "c2p2-traveler-offset",
      "source_numbers": [
        "166"
      ],
      "view": {
        "mode": "single",
        "stem": "第一位旅行者从A出发1小时后，第二位从B相向出发。相遇前第二位比第一位少走2千米；第二位到A比第一位到B早6分钟。相遇后第一位又走2小时30分钟。选择（第一位速度，第二位速度，AB距离），速度单位为千米/小时，距离单位为千米。",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$(4,5,22)$",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$(4,5,20)$",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$(5,4,22)$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "区分出发时差、相遇前距离差和绝对到达时刻差，求两速度与全程距离。",
        "source_solution": "第二相遇前t小时，vt=2.5u，u(t+1)=2.5u+2=2.4v。消去得9u^2-32u-16=0，正根u=4，v=5，t=2，D=5u+2=22；负根-4/9排除。",
        "unit_reason": "速度与全程构成同一运动模型的一份完整结果，不分拆相互泄漏的数值题。",
        "concept_blocks": [],
        "limitations": [
          "选择不能验证独立画时间线或列方程的能力。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "a"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "correct",
            "derivation": "相遇前第一走3*4=12、第二2*5=10；全程22。第一到达在5.5小时，第二在1+22/5=5.4小时，早0.1小时=6分钟。",
            "misconception": null
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "正确得速度4,5及第二相遇前距离2.5*4=10，却把两段都当10，取D=20；漏掉第一段比第二段多2千米。",
            "misconception": "将相遇点误设为全程中点。"
          },
          {
            "option_id": "c",
            "truth": "incorrect",
            "derivation": "求出4,5后交换两人标签；按D=22，新到达时刻第一4.4小时、第二6.5小时，方向和6分钟条件均不符。",
            "misconception": "把带不同出发和到达条件的两人速度交换。"
          }
        ]
      }
    },
