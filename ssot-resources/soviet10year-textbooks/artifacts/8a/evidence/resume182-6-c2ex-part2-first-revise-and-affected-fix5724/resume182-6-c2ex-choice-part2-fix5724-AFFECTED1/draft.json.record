          },
          {
            "id": "c",
            "text": "$8\\ \\mathrm{dm}$ 和 $15\\ \\mathrm{dm}$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "将对角线的平方和关系与面积乘积关系共同用于正边长。",
        "source_solution": "a,b>0，a^2+b^2=289，ab=120；a+b=23，根方程(t-8)(t-15)=0，两边8,15dm。",
        "unit_reason": "一个无序边长对就是矩形的完整尺度，交换不作为不同选项。",
