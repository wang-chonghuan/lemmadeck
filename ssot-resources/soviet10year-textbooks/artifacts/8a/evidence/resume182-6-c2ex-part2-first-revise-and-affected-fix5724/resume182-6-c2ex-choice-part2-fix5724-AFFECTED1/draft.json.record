        "figure_observations": []
      },
      "key": {
        "correct": [
          "c"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "incorrect",
            "derivation": "把矩形当正方形，令a=b、a^2=120，得到两边sqrt120；对角线平方为240，不是289。",
            "misconception": "无依据地假设矩形两边相等。"
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "把17当一条边，再用面积除17求另一边120/17；实际对角线平方超过17^2。",
            "misconception": "把对角线长度代作边长。"
          },
          {
            "option_id": "c",
            "truth": "correct",
            "derivation": "8*15=120，8^2+15^2=289=17^2，两边都正。",
            "misconception": null
          }
        ]
      }
    },
