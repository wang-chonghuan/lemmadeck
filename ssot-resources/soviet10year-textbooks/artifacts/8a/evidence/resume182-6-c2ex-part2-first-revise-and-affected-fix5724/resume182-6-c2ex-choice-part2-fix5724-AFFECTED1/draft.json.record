        "164"
      ],
      "view": {
        "mode": "single",
        "stem": "两个直角三角形斜边分别为 $29\\ \\mathrm{dm}$ 和 $5\\ \\mathrm{dm}$。大三角形每条直角边比小三角形对应边长 $17\\ \\mathrm{dm}$。两者面积相差多少？",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$59.5\\ \\mathrm{dm}^2$",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$408\\ \\mathrm{dm}^2$",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$204\\ \\mathrm{dm}^2$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "从两个勾股式求小边长和，保留大幅增长的平方项和面积单位。",
        "source_solution": "小腿a,b满足a^2+b^2=25，34(a+b)+578=841-25=816，故a+b=7，ab=12，小腿3,4，大腿20,21。面积210-6=204dm^2。",
        "unit_reason": "完整面积差统一检验对应边增长与三角形面积公式。",
        "concept_blocks": [],
        "limitations": [
          "不检验自行建模和完整书面计算。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "c"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "incorrect",
            "derivation": "求得a+b=7后，面积增长只用17(a+b)/2=119/2，遗漏17^2/2。",
            "misconception": "展开两个增大边的乘积时漏掉289。"
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "把面积差当矩形乘积差，17*7+17^2=408。",
            "misconception": "直角三角形面积差缺少1/2。"
          },
          {
            "option_id": "c",
            "truth": "correct",
            "derivation": "(20*21-3*4)/2=204，正长度与两斜边均符合。",
            "misconception": null
          }
        ]
      }
    },
