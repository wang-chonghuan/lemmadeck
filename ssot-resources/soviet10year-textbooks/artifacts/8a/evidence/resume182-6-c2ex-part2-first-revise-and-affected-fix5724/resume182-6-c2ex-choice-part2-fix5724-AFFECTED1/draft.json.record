  "questions": [
    {
      "id": "c2p2-factor-system",
      "source_numbers": [
        "161"
      ],
      "view": {
        "mode": "single",
        "stem": "求实数方程组 $x^2-4y^2=0,\\ x^2+xy-y^2=20$ 的完整解集。坐标按 $(x,y)$ 排列。",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$\\{(4,2),(-4,-2)\\}$",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$\\{(4,2),(-4,-2),(-4\\sqrt5,2\\sqrt5),(4\\sqrt5,-2\\sqrt5)\\}$",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$\\{(4,2),(-4,-2),(4\\sqrt5,2\\sqrt5),(-4\\sqrt5,-2\\sqrt5)\\}$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "因式分解后保留两条比例分支及正负根，求全部有序实数解。",
        "source_solution": "独立先解：x=2y 给出 5y^2=20，得 (4,2),(-4,-2)；x=-2y 给出 y^2=20，得 (-4sqrt5,2sqrt5),(4sqrt5,-2sqrt5)。四点互异且均代回两式成立。",
        "unit_reason": "整个二元解集是一项分支完整性判断，不拆成逐坐标点击。",
        "concept_blocks": [],
        "limitations": [
          "选择完整解集不证明能够自行书写因式分解及全部推导。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "b"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "incorrect",
            "derivation": "只取 x=2y 得 y=±2，输出这两点；漏掉 x=-2y 的实根。",
            "misconception": "由 (x-2y)(x+2y)=0 只令第一个因子为零。"
          },
          {
            "option_id": "b",
            "truth": "correct",
            "derivation": "两条分支各有两点，合并即所列四点；无交点，因为交点原点不满足第二式。",
            "misconception": null
          },
          {
            "option_id": "c",
            "truth": "incorrect",
            "derivation": "第二分支求得 y=±2sqrt5 后却按 x=+2y 报坐标，得到同号的 ±(4sqrt5,2sqrt5)。这些点第二式为100而非20。",
            "misconception": "解完负比例分支后回填坐标时丢掉 x=-2y 的负号。"
          }
        ]
      }
    },
    {
      "id": "c2p2-real-branch",
      "source_numbers": [
        "161"
      ],
      "view": {
        "mode": "single",
        "stem": "求实数方程组 $4x^2-9y^2=0,\\ x^2-xy-y^2=-1$ 的完整解集。",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$\\{(3,2),(-3,-2),(-3,2),(3,-2)\\}$",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$\\{(3,2)\\}$",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$\\{(3,2),(-3,-2)\\}$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "分别检查两条比例分支的实数可解性，保留所有实根。",
        "source_solution": "x=3y/2 时 -y^2/4=-1，得 y=±2；x=-3y/2 时 11y^2/4=-1，没有实根。完整实解为 (3,2),(-3,-2)。",
        "unit_reason": "选择完整解集检验负平方无实根与正负根两项关键区别。",
        "concept_blocks": [],
        "limitations": [
          "不检验独立写出分支推导的能力。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "c"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "incorrect",
            "derivation": "先算出 y=±2，再从 4x^2=9y^2 任意配 x=±3，得到四种符号配对。异号两点第二式为11，不是-1。",
            "misconception": "把第一式的符号选择当成不受第二式限制。"
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "从 y^2=4 只写 y=2，继而 x=3，漏掉 y=-2,x=-3。",
            "misconception": "开平方只保留正根。"
          },
          {
            "option_id": "c",
            "truth": "correct",
            "derivation": "正比例分支两个实根，负比例分支平方等于负数无实根；所列两点逐一满足两式。",
            "misconception": null
          }
        ]
      }
    },
    {
      "id": "c2p2-sum-product",
      "source_numbers": [
        "161"
      ],
      "view": {
        "mode": "single",
        "stem": "求实数方程组 $x^2y^2+xy=72,\\ x+y=6$ 的完整解集。",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$\\{(2,4),(4,2),(3+3\\sqrt2,3-3\\sqrt2),(3-3\\sqrt2,3+3\\sqrt2)\\}$",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$\\{(2,4),(4,2)\\}$",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$\\{(3,3),(3+\\sqrt{17},3-\\sqrt{17}),(3-\\sqrt{17},3+\\sqrt{17})\\}$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "以乘积为中间未知量，恢复两种乘积所对应的完整有序实解。",
        "source_solution": "p=xy 满足 (p-8)(p+9)=0。p=8 时 t^2-6t+8=0 根2,4；p=-9 时 t^2-6t-9=0 根3±3sqrt2。每种根对均需两种顺序。",
        "unit_reason": "中间乘积的分支及坐标顺序共同决定一个完整解集。",
        "concept_blocks": [],
        "limitations": [
          "不证明可独立建立和积二次方程。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "a"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "correct",
            "derivation": "四对坐标的和均为6，乘积分别8或-9，而 p^2+p 都为72；两类根均实且互不重合。",
            "misconception": null
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "以 p=xy 为非负量，只保留 p=8，输出2,4的两种顺序，丢失负乘积的两实解。",
            "misconception": "误将两个实数的乘积当成必定非负。"
          },
          {
            "option_id": "c",
            "truth": "incorrect",
            "derivation": "把 p^2+p-72 误分解为 (p-9)(p+8)，得到 p=9,-8；和为6分别产生 (3,3) 与3±sqrt17的两种顺序。实际 p^2+p 分别90、56。",
            "misconception": "错误因式分解使一次项的符号从+p变成-p。"
          }
        ]
      }
    },
    {
      "id": "c2p2-symmetric-system",
      "source_numbers": [
        "161"
      ],
      "view": {
        "mode": "single",
        "stem": "求实数方程组 $(x+y)^2-2(x+y)=15,\\ x+xy+y=11$ 的完整解集。",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$\\{(2,3)\\}$",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$\\{(2,3),(3,2),((-3+\\sqrt{47})/2,(-3-\\sqrt{47})/2),((-3-\\sqrt{47})/2,(-3+\\sqrt{47})/2)\\}$",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$\\{(2,3),(3,2)\\}$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "由和与积恢复坐标，剔除判别式为负的分支。",
        "source_solution": "s=x+y 得 s=5,-3；p=11-s 得6,14。t^2-5t+6 根2,3；t^2+3t+14 判别式-47，没有实根。完整解为两种顺序。",
        "unit_reason": "一个解集同时涵盖和的两分支及实数筛选。",
        "concept_blocks": [],
        "limitations": [
          "选择不检验独立书写判别式论证。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "c"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "incorrect",
            "derivation": "恢复根2,3后只把2指定为x、3指定为y，漏掉方程对称性允许的交换解。",
            "misconception": "无依据地给两个根固定坐标顺序。"
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "对第二分支把 sqrt(-47) 错写为 sqrt47，套根公式产生所列两点；它们乘积(9-47)/4=-19/2，不是14。",
            "misconception": "用判别式绝对值强行生成实根。"
          },
          {
            "option_id": "c",
            "truth": "correct",
            "derivation": "s=5,p=6 的根2,3两种顺序满足两式；s=-3 的分支没有实数坐标。",
            "misconception": null
          }
        ]
      }
    },
    {
      "id": "c2p2-fraction-representation",
      "source_numbers": [
        "162"
      ],
      "view": {
        "mode": "single",
        "stem": "原分数的分子为 $m$、分母为 $n$。分子加2、分母加3后值不变；分子加1、分母加6后比原值小 $1/6$。原来的 $(m,n)$ 是什么？",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$(m,n)=(2,3)$",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$(m,n)=(8,12)$",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$(m,n)=(-16,-24)$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "保留分数的原始分子分母，而不只确定约分后的值。",
        "source_solution": "分母 n,n+3,n+6 非零。第一条件给2n=3m，原值2/3；第二变为 (m+1)/(n+6)=1/2，给2m+2=n+6。联立得m=8,n=12，全部分母有效。",
        "unit_reason": "两次改动针对表示中的分子分母，完整有序对比单独的分数值更忠实。",
        "concept_blocks": [],
        "limitations": [
          "不检验独立列比例方程及交叉相乘的书写。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "b"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "incorrect",
            "derivation": "只从第一条件得到值2/3并立即约分，报告(2,3)。第二次变成3/9=1/3，减少1/3而非1/6。",
            "misconception": "把等值分数误当成对分子分母改动也等效。"
          },
          {
            "option_id": "b",
            "truth": "correct",
            "derivation": "10/15=8/12=2/3，9/18=1/2=2/3-1/6；原始表示是8/12。",
            "misconception": null
          },
          {
            "option_id": "c",
            "truth": "incorrect",
            "derivation": "把小1/6误列为大1/6，令 (m+1)/(n+6)=5/6 与m=2n/3联立：4n+6=5n+30，n=-24,m=-16。实际改后5/6大于原值。",
            "misconception": "比较关系中的减少误写为增加。"
          }
        ]
      }
    },
    {
      "id": "c2p2-fraction-domain",
      "source_numbers": [
        "162"
      ],
      "view": {
        "mode": "single",
        "stem": "原分数分子为 $m$、分母为 $n$。分子加1、分母加3后等于 $1/2$；分子减1、分母加1后，所得分数与原分数的积等于 $1/5$。求原来的 $(m,n)$。",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$(m,n)=(3,5)$",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$(m,n)=(0,-1)$",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$(m,n)=(5,3)$",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "求原表示并检查原分母和改后分母，剔除交叉相乘引入的无定义候选。",
        "source_solution": "n=2m-1，5m(m-1)=n(n+1) 得m(m-3)=0。m=0,n=-1使n+1=0，不合法；m=3,n=5合法，原分数3/5。",
        "unit_reason": "用完整表示判断兼顾两条件和分母限制。",
        "concept_blocks": [],
        "limitations": [
          "不验证自行列式和剔除增根的书面论证。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "a"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "correct",
            "derivation": "4/8=1/2，(2/6)(3/5)=1/5，所有分母非零。",
            "misconception": null
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "m(m-3)=0的m=0候选对应n=-1；忽略n+1非零就把交叉相乘的0=0当成原等式成立。实际改后分数为-1/0。",
            "misconception": "交叉相乘后不回查分母定义域。"
          },
          {
            "option_id": "c",
            "truth": "incorrect",
            "derivation": "得出分子3分母5后，把(分子,分母)的次序交换成(5,3)。改后6/6=1，不满足1/2。",
            "misconception": "回报结果时交换分子和分母。"
          }
        ]
      }
    },
    {
