  "concept_requirements": [
    {
      "block": 2,
      "requirement": "Arithmetic progression means the same additive constant at every successive step. Pattern resemblance or a repeated subset of differences is insufficient."
    },
    {
      "block": 4,
      "requirement": "Use later term minus immediately preceding term, with the sign preserved; all available adjacent differences must agree."
    },
    {
      "block": 5,
      "requirement": "d is that common signed difference, not the absolute change, a ratio or an arbitrary total change between separated terms."
    },
    {
      "block": 7,
      "requirement": "The first term and recurrence a_(n+1)=a_n+d determine the ordered terms. Iterating gives a_n=a_1+(n-1)d; moving backward subtracts d."
    },
    {
      "block": 13,
      "requirement": "An interior term equals the arithmetic mean of its two adjacent terms. This supports the middle-term arguments but does not make all terms equal."
    },
    {
      "block": 18,
      "requirement": "The arithmetic-mean property is an if-and-only-if characterization when it holds at every applicable interior position. One favorable interior check is not enough for a longer finite list."
    }
  ],
