  "independentDerivations": [
    {
      "exercise": "269",
      "method": "All terms are nonzero. Compute each consecutive later/earlier ratio; a finite sequence is geometric exactly when all these ratios agree.",
      "subtasks": [
        {"label": "a)", "ratios": ["1/10", "1/10", "1/10", "1/10"], "conclusion": "Geometric, q=1/10."},
        {"label": "b)", "ratios": ["1/10", "1/10", "1/10"], "conclusion": "Geometric, q=1/10."},
        {"label": "c)", "ratios": ["2", "4", "4", "4", "2"], "conclusion": "Not geometric. The first and last ratios remain 2; no repair of the given sequence."},
        {"label": "d)", "ratios": ["-10", "-10", "-10", "-10"], "conclusion": "Geometric, q=-10."},
        {"label": "e)", "ratios": ["11/10", "111/110", "1111/1110"], "conclusion": "Not geometric. Already 11/10 != 111/110, since 1210 != 1110 after multiplication by 1100."},
        {"label": "f)", "ratios": ["5", "5", "5", "5"], "conclusion": "Geometric, q=5; 5^(k+1)/5^k=5 for each adjacent pair."}
      ],
      "gradingReason": "Classification plus conditional ratio and nonconstant-ratio reasoning cannot be completely judged with numeric/expression parts. All six subtasks have explicit standard answers."
    },
    {
      "exercise": "270",
      "method": "Use b_(n+1)=b_n*q four times for each given nonzero first term. Each ordered sequence includes the given first term.",
      "subtasks": [
        {"label": "a)", "first": "6", "q": "2", "sequence": ["6", "12", "24", "48", "96"], "derivation": "6*2=12; 12*2=24; 24*2=48; 48*2=96."},
        {"label": "b)", "first": "-16", "q": "1/2", "sequence": ["-16", "-8", "-4", "-2", "-1"], "derivation": "Each multiplication by 1/2 preserves the negative sign and halves the magnitude."},
        {"label": "c)", "first": "3/4", "q": "-2/3", "sequence": ["3/4", "-1/2", "1/3", "-2/9", "4/27"], "derivation": "(3/4)*(-2/3)=-1/2; (-1/2)*(-2/3)=1/3; (1/3)*(-2/3)=-2/9; (-2/9)*(-2/3)=4/27."},
        {"label": "d)", "first": "-24", "q": "-3/2", "sequence": ["-24", "36", "-54", "81", "-243/2"], "derivation": "The given -1.5 equals -3/2. Products are 36, -54, 81, -243/2; the last equals -121.5 exactly."},
        {"label": "e)", "first": "2/5", "q": "sqrt(2)", "sequence": ["2/5", "2*sqrt(2)/5", "4/5", "4*sqrt(2)/5", "8/5"], "derivation": "The given 0.4 equals 2/5. Alternating products use sqrt(2)^2=2, without decimal approximation."},
        {"label": "f)", "first": "9/5", "q": "sqrt(3)/3", "sequence": ["9/5", "3*sqrt(3)/5", "3/5", "sqrt(3)/5", "1/5"], "derivation": "The given 1.8 equals 9/5. (9/5)*(sqrt(3)/3)=3*sqrt(3)/5; multiplying again gives 3/5; then sqrt(3)/5; then 1/5."}
      ],
      "gradingReason": "Thirty independent finite-real numeric parts, five ordered terms for each of six subtasks. Candidate expected values are LaTeX rather than the explanatory ASCII notation used in this record."
    },
    {
      "exercise": "271",
      "method": "Adjacent given terms determine q=b_2/b_1 uniquely, including its sign. Then b_4=b_2*q^2.",
      "subtasks": [
        {"label": "a)", "derivation": "q=15/3=5; b_4=15*25=375.", "q": "5", "b4": "375"},
        {"label": "b)", "derivation": "q=3/15=1/5; b_4=3*(1/25)=3/25.", "q": "1/5", "b4": "3/25"},
        {"label": "c)", "derivation": "q=-12/6=-2; b_4=-12*4=-48.", "q": "-2", "b4": "-48"},
        {"label": "d)", "derivation": "q=(-10)/(-20)=1/2; b_4=-10*(1/4)=-5/2.", "q": "1/2", "b4": "-5/2"},
        {"label": "e)", "derivation": "q=4/(2*sqrt(2))=sqrt(2); b_4=4*2=8.", "q": "sqrt(2)", "b4": "8"},
        {"label": "f)", "derivation": "q=1/(1/(3*sqrt(3)))=3*sqrt(3); b_4=1*(3*sqrt(3))^2=27.", "q": "3*sqrt(3)", "b4": "27"}
      ],
      "gradingReason": "Twelve independent finite-real numeric parts: q then b_4 for each subtask."
    },
    {
      "exercise": "272",
      "method": "Check both observed adjacent ratios agree. Divide the third term by q to obtain the second, then divide once more for the first.",
      "subtasks": [
        {"label": "a)", "derivation": "36/24=54/36=3/2. y_2=24/(3/2)=16; y_1=16/(3/2)=32/3.", "sequence": ["32/3", "16", "24", "36", "54"]},
        {"label": "b)", "derivation": "-135/225=81/(-135)=-3/5. y_2=225/(-3/5)=-375; y_1=-375/(-3/5)=625.", "sequence": ["625", "-375", "225", "-135", "81"]}
      ],
      "gradingReason": "Four numeric parts in the requested order y_1,y_2. The supporting ratios are displayed but not added as unrequested inputs."
    },
    {
      "exercise": "273",
      "method": "Use x_j=x_i*q^(j-i) over the reals, with every term and q nonzero by the lesson definition.",
      "subtasks": [
        {"label": "a)", "derivation": "x_2=x_1*q, so q=x_2/x_1. The denominator x_1 is nonzero and x_2 is also nonzero."},
        {"label": "b)", "derivation": "x_3=x_1*q^2, so q^2=x_3/x_1. A real nonzero q exists exactly when x_1 is nonzero and x_3/x_1>0. Equivalently, x_1 and x_3 are nonzero with the same sign.", "branches": [{"q": "sqrt(x_3/x_1)", "x2": "x_1*sqrt(x_3/x_1)"}, {"q": "-sqrt(x_3/x_1)", "x2": "-x_1*sqrt(x_3/x_1)"}], "completeness": "Each branch gives x_2*q=x_1*q^2=x_3 and defines the full sequence x_n=x_1*q^(n-1). The two known terms do not determine which sign is taken. A negative ratio has no real square root; a zero ratio forces q=0, forbidden; x_1=0 violates the definition."},
        {"label": "c)", "derivation": "x_(k+1)=x_k*q for positive integer k, so q=x_(k+1)/x_k with both terms nonzero."}
      ],
      "gradingReason": "A complete two-branch result with existence conditions cannot be judged as an expected list in which matching only one sign would suffice. All three standard answers remain displayed."
    },
    {
      "exercise": "274",
      "method": "For real geometric sequences use a_j/a_i=q^(j-i). An even gap leaves both real signs when the ratio is positive; a negative ratio for an even gap is impossible. An odd gap has a unique real root.",
      "subtasks": [
        {
          "label": "a)",
          "derivation": "q^2=24/6=4, so q=2 or -2. a_1=a_3/q^2=3/2; a_6=a_5*q; a_7=a_5*q^2=96.",
          "branches": [
            {"q": "2", "a6": "48", "a7": "96", "firstSevenTerms": ["3/2", "3", "6", "12", "24", "48", "96"]},
            {"q": "-2", "a6": "-48", "a7": "96", "firstSevenTerms": ["3/2", "-3", "6", "-12", "24", "-48", "96"]}
          ]
        },
        {
          "label": "b)",
          "derivation": "a_8/a_6=-10/10=-1=q^2. No real q has negative square. Since q is nonzero, q^2 would in fact be strictly positive.",
          "conclusion": "No real geometric sequence satisfies both unchanged givens. a_6=10 is supplied, not repaired, but there is no real q or a_7 compatible with both it and a_8=-10."
        },
        {
          "label": "c)",
          "derivation": "q^2=(-18)/(-2)=9, so q=3 or -3. a_1=a_3/q^2=-2/9; a_6=a_5*q; a_7=a_5*q^2=-162.",
          "branches": [
            {"q": "3", "a6": "-54", "a7": "-162", "firstSevenTerms": ["-2/9", "-2/3", "-2", "-6", "-18", "-54", "-162"]},
            {"q": "-3", "a6": "54", "a7": "-162", "firstSevenTerms": ["-2/9", "2/3", "-2", "6", "-18", "54", "-162"]}
          ]
        },
        {
          "label": "d)",
          "derivation": "q^3=3/24=1/8. The unique real cube root is q=1/2. a_6=24/2=12; a_7=12/2=6. a_1=24/(1/2)^4=384.",
          "q": "1/2",
          "a6": "12",
          "a7": "6",
          "firstEightTerms": ["384", "192", "96", "48", "24", "12", "6", "3"]
        }
      ],
      "gradingReason": "Complete branches must keep q and subsequent signs linked; separate alternative-value parts would accept an incoherent combination or an incomplete answer. The real nonexistence in b) also has no numeric/expression-only answer contract. Entire exercise is ungraded with all four complete solutions."
    },
    {
      "exercise": "275",
      "method": "A nonzero fixed multiplier gives a geometric sequence. A fixed summand gives an arithmetic sequence. Check initial differences or ratios to exclude the other classification.",
      "subtasks": [
        {"label": "a)", "derivation": "a_(n+1)/a_n=4 and a_n=5*4^(n-1) is always nonzero. Terms 5,20,80 have differences 15 and 60, so not arithmetic.", "classification": "geometric only", "q": "4"},
        {"label": "b)", "derivation": "a_(n+1)-a_n=4 and a_n=5+4*(n-1). Terms 5,9,13 have ratios 9/5 and 13/9, unequal.", "classification": "arithmetic only", "d": "4"},
        {"label": "c)", "derivation": "a_(n+1)-a_n=1/2 and a_n=-8+(n-1)/2. Terms -8,-15/2,-7 have ratios 15/16 and 14/15, unequal. Also a_17=0, forbidden for the lesson's geometric definition.", "classification": "arithmetic only", "d": "1/2"},
        {"label": "d)", "derivation": "a_(n+1)/a_n=1/2 and a_n=-8*(1/2)^(n-1) is always nonzero. Terms -8,-4,-2 have differences 4 and 2, unequal.", "classification": "geometric only", "q": "1/2"}
