  'figures/fig-24.svg': '3d99aeefa5fd5071661b5ad645bf267797707f1388a7b41b7e6348d73a568a8d',
  'figures/fig-25.png': 'c6982988a8fa79b1d62fec64a7027bf125c8535cd6ee0daa6cc86ad074b62e33',
