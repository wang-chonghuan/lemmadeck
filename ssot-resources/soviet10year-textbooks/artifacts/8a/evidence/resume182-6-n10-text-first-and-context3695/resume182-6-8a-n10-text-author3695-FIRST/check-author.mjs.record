import fs from 'node:fs'
import path from 'node:path'
import crypto from 'node:crypto'
import assert from 'node:assert/strict'

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck'
const work = path.join(repo, '.tmp/resume182-6-8a-n10-text-author3695-FIRST')
