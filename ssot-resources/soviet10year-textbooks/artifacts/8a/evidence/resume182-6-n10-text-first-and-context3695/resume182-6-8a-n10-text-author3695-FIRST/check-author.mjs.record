  '.claude/skills/ld-s10y-lesson/tools/htmlfrag.js',
]
const contracts = toolPaths.map((relative) => hash(path.join(repo, relative)))
const profilePath = path.resolve(repo, index.profile.path)
assert.equal(hash(profilePath).sha256, index.profile.sha256)
contracts.push(hash(profilePath))
console.log(JSON.stringify({
  scope: 'author-only draft integrity; no semantic math review or TEXT approval',
  sources,
  templates,
  contracts,
  prose_flow: hash(flowPath),
