}
const sources = Object.entries(sourceBaseline).map(([relative, expected]) => {
  const current = hash(path.join(book, relative))
  assert.equal(current.sha256, expected, `source drift: ${relative}`)
  return current
})
const pdf = path.join(repo, 'ssot-resources/soviet10year-textbooks/sources/soviet10years/8a 苏联十年制学校数学教材 代数 八年级.pdf')
const pdfHash = hash(pdf)
assert.equal(pdfHash.sha256, '5978388efc80df4085400f80d5912f710efb052a806222633b172b0a9479b071')
sources.push(pdfHash)
const lesson = read(path.join(target, 'lesson.template.json'))
const exercises = read(path.join(target, 'exercises.template.json'))
const figures = read(path.join(target, 'figures.template.json'))
const indexPath = path.join(work, 'adapt/8a/modern-us-neutral/book.template.json')
const index = read(indexPath)
const rawLesson = read(path.join(book, lesson.source.path))
const rawExercises = read(path.join(book, exercises.source.path))
assert.deepEqual(lesson.source.data, rawLesson)
assert.deepEqual(exercises.source.data, rawExercises)
assert.equal(lesson.source.sha256, hash(path.join(book, lesson.source.path)).sha256)
assert.equal(exercises.source.sha256, hash(path.join(book, exercises.source.path)).sha256)
assert.equal(lesson.prose.length, 13)
assert.equal(lesson.exercise_count, 7)
assert.equal(exercises.count, 7)
assert.equal(figures.figures.length, 4)
assert.deepEqual(exercises.exercises.map((item) => item.number), ['131', '132', '133', '134', '135', '136', '137'])
for (const document of [lesson, exercises, figures, index]) {
  assert.equal(document.status, 'draft')
  assert.equal(document.edition, 'modern-us-neutral')
}

const formulas = (text) => [...text.matchAll(/\$\$(.+?)\$\$|\$([^$]+?)\$/gs)].map((match) => match[0])
const numbers = (text) => [...text.replace(/\$\$(.+?)\$\$|\$([^$]+?)\$/gs, '').matchAll(/(?<![A-Za-z0-9_\u0400-\u04ff.])-?\d+(?:\.\d+)?(?![A-Za-z0-9_\u0400-\u04ff.])/g)].map((match) => match[0])
const unchangedMetadata = (item, omitted) => Object.fromEntries(Object.entries(item).filter(([key]) => !omitted.includes(key)))
const textChecks = (source, modern) => {
  assert.equal(modern.source_text, source.text)
  assert.deepEqual(formulas(modern.text), formulas(source.text), 'literal formula drift')
  assert.deepEqual(numbers(modern.text), numbers(source.text), 'literal numeric drift')
  assert.deepEqual(modern.numeric_changes, [])
  assert.deepEqual(modern.historical_entities, [])
  assert.ok(!/[\u0400-\u04ff\u3000]/u.test(modern.text))
  for (const expression of formulas(modern.text)) assert.ok(!/[、，；。？！：]/u.test(expression))
  assert.equal(modern.text === source.text, modern.changes.length === 0)
}
lesson.prose.forEach((modern, i) => {
  const source = rawLesson.prose[i]
  textChecks(source, modern)
  assert.deepEqual(
    unchangedMetadata(modern, ['text', 'source_text', 'changes', 'numeric_changes', 'historical_entities']),
    unchangedMetadata(source, ['text']),
  )
})
exercises.exercises.forEach((modern, i) => {
  const source = rawExercises.exercises[i]
  textChecks(source, modern)
  assert.deepEqual(modern.lines, modern.text.split('\n'))
  assert.deepEqual(
    unchangedMetadata(modern, ['text', 'lines', 'source_text', 'changes', 'numeric_changes', 'historical_entities']),
    unchangedMetadata(source, ['text', 'lines']),
  )
  const labels = [...modern.text.matchAll(/^([a-z])\) /gm)].map((match) => match[1])
  const expected = modern.number === '136' ? [] : modern.number === '137' ? ['a', 'b'] : ['a', 'b', 'c', 'd']
  assert.deepEqual(labels, expected)
  if (labels.length) {
    assert.ok(!/[a-z]\) /.test(modern.lines[0]))
    assert.equal(modern.lines.length, labels.length + 1)
  }
})
const review = exercises.exercises.at(-1)
assert.equal(review.group, '复习题')
assert.equal(review.group_id, 'g1')
assert.deepEqual(review.pages, ['p0063#4'])
const expectedReview = rawExercises.exercises.at(-1).text
  .replace('137. а)', '137.\na)')
  .replace('两个少先队中队', '两支徒步队')
  .replace('б)', '\nb)')
  .replaceAll('. ', '。')
assert.equal(review.text, expectedReview)
assert.deepEqual(review.changes, ['layout', 'culture'])

// Parse only the three template documents retained in the preparation read.
const preparedText = fs.readFileSync(path.join(work, 'shell-07-current-templates/stdout.txt'), 'utf8')
const prepared = []
let position = 0
while (prepared.length < 3) {
  while (/\s/.test(preparedText[position])) position++
  const start = position
  let depth = 0
  let quoted = false
  let escaped = false
  for (; position < preparedText.length; position++) {
    const char = preparedText[position]
    if (quoted) {
      if (escaped) escaped = false
      else if (char === '\\') escaped = true
      else if (char === '"') quoted = false
    } else if (char === '"') quoted = true
    else if (char === '{' || char === '[') depth++
    else if (char === '}' || char === ']') depth--
    if (depth === 0 && !quoted) {
      prepared.push(JSON.parse(preparedText.slice(start, ++position)))
      break
    }
  }
}
assert.deepEqual(figures, prepared[2])
assert.equal(lesson.errata.length, 1)
const erratum = lesson.errata[0]
assert.deepEqual(unchangedMetadata(erratum, ['corrected']), unchangedMetadata(prepared[0].errata[0], ['corrected']))
assert.equal(erratum.id, 'p0062-ex134-label-3')
assert.equal(erratum.target, 'exercises[3]')
assert.equal(erratum.source.block, 'p0062#2')
assert.equal(erratum.source.sha256, sourceBaseline['pages/0062/page.json'])
assert.equal(erratum.corrected, exercises.exercises[3].lines[3])
assert.equal(rawExercises.exercises[3].text.split(erratum.original).length - 1, 1)
assert.ok(exercises.exercises[3].text.includes(erratum.corrected))
assert.ok(!exercises.exercises[3].text.includes(erratum.original))
assert.deepEqual(formulas(erratum.corrected), formulas(erratum.original))
assert.deepEqual(exercises.exercises[3].changes, ['layout', 'math-correction'])
const flowPath = path.join(work, 'shell-13-prose-flow-ready/stdout.txt')
const flow = read(flowPath)
assert.deepEqual(flow.boundaries.map(({ before, after }) => ({ before, after })), lesson.section_breaks)
assert.equal(flow.paragraphs.length, 8)

const templates = ['lesson', 'exercises', 'figures'].map((name) => hash(path.join(target, `${name}.template.json`)))
templates.push(hash(indexPath))
