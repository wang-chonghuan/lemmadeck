const read = (filename) => JSON.parse(fs.readFileSync(filename, 'utf8'))
const hash = (filename) => {
  const bytes = fs.readFileSync(filename)
  return {
    path: filename,
    sha256: crypto.createHash('sha256').update(bytes).digest('hex'),
    bytes: bytes.length,
  }
}
