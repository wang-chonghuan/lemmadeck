    textual_prose_objects: 7,
    unchanged_figure_caption_objects: 6,
    final_prose_paragraphs: 8,
    section_breaks: lesson.section_breaks.length,
    exercises: 7,
    subparts: 22,
    figures_draft: 4,
    source_original_bytes_edited: 0,
    literal_formula_changes: 0,
    literal_numeric_changes: 0,
    figure_template_author_edits: 0,
    semantic_math_review_reruns: 0,
  },
  prose_changes: lesson.prose.map((item, i) => ({ target: `lesson.prose[${i}]`, changes: item.changes })),
  exercise_changes: exercises.exercises.map((item) => ({ number: item.number, changes: item.changes })),
  erratum,
}, null, 2))
