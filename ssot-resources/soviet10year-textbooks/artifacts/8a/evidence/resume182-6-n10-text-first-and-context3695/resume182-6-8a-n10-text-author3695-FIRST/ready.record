  "lesson_specific_clarifications": [
    {
      "target": "lesson.prose[3]",
      "source_refs": ["p0060#5", "p0060#8"],
      "description": "原书的圆和半圆均指含内部的点集。现代中文明确为包含内部和边界的圆形区域、半圆形区域；交集条件用当且仅当忠实表述；所有原公式与数字逐字保留，没有新增来源事实。"
    },
    {
      "target": "lesson.prose[7]",
      "source_refs": ["p0060#10", "p0061#1"],
      "description": "例1明确为第二象限及其在坐标轴上的边界，包含坐标原点；不是排除等号边界的开象限，也没有声称包含整条坐标轴。原不等式组不变。"
    },
    {
      "target": "lesson.prose[12]",
      "source_refs": ["p0061#6"],
      "description": "例2的带形区域包含两条边界直线；忠实于原组中的非严格不等式，原组和两条边界公式不变。"
    }
  ],
