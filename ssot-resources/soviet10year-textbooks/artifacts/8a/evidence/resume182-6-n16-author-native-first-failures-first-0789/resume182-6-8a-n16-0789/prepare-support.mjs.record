import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const previous = '.tmp/resume182-6-8a-n15-0789';
const base = '.tmp/resume182-6-8a-n16-0789';
const id = 'alg8-c3-s2-n16';
const root = 'ssot-resources/soviet10year-textbooks/artifacts/8a';
const edition = `${root}/editions/modern-us-neutral`;
const [reviewPath, reviewHash] = process.argv.slice(2);
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const binding = file => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), sha256: sha(bytes), bytes: bytes.length };
};
assert.equal(binding(reviewPath).sha256, reviewHash);
const review = JSON.parse(fs.readFileSync(reviewPath));
assert.equal(review.status, 'SOURCE_PASS');
assert.equal(review.lesson, id);
const assembly = JSON.parse(fs.readFileSync(`${base}/assembly-FIRST/assembly.record`));
const raw = JSON.parse(fs.readFileSync(`${root}/lessons/${id}/exercises.json`));
const numbers = raw.exercises.map(item => String(item.number));
assert.ok(numbers.length);
assert.equal(new Set(numbers).size, numbers.length);
assert.equal(numbers.length, assembly.exercise_count);
const figures = assembly.figures;
const outputs = [];
const adapted = (name, rewrite = text => text) => {
  const source = `${previous}/${name}`;
  const target = `${base}/${name}`;
  assert.ok(!fs.existsSync(target), `Do not overwrite ${target}`);
  const original = fs.readFileSync(source);
  const text = rewrite(original.toString('utf8').replaceAll('n15', 'n16'));
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, text, { flag: 'wx' });
  outputs.push({ source: binding(source), output: binding(target) });
};
const replace = (text, before, after) => {
  assert.equal(text.split(before).length, 2, `Expected one adaptation site: ${before}`);
  return text.replace(before, after);
};
adapted('prepare-choice-review.mjs');
adapted('bind-choice-review.mjs', text => replace(text,
  'assert.equal(review.source_reviews.length, 22);',
  `assert.equal(review.source_reviews.length, ${numbers.length});`));
adapted('promote-answers.mjs', text => replace(text,
  'assert.equal(data.answers.length, 22);',
  `assert.equal(data.answers.length, ${numbers.length});`));
adapted('observe-tools.mjs');
for (const name of ['run.mjs', 'display-helper.mjs', 'display-helper-base.mjs']) {
  adapted(`display-FIRST/${name}`);
}
adapted('display-FIRST/prepare.mjs', text => replace(text,
  "export const requiredFigures = ['fig-30'];",
  `export const requiredFigures = ${JSON.stringify(figures)};`));
adapted('ready-display.mjs', text => {
  text = replace(text, 'assert.equal(count, 22);', `assert.equal(count, ${numbers.length});`);
  text = replace(text, "Array.from({ length: 22 }, (_, i) => String(232 + i))",
    JSON.stringify(numbers));
  return replace(text, "assert.deepEqual(figureIds, ['fig-30']);",
    `assert.deepEqual(figureIds, ${JSON.stringify(figures)});`);
});
const file = `${base}/support-preparation.record`;
fs.writeFileSync(file, `${JSON.stringify({
  status: 'SOURCE_DERIVED_SUPPORT_PREPARED_NOT_DOWNSTREAM_APPROVAL',
  book: '8a', lesson: id, sourceApproval: binding(reviewPath),
  inventory: { numbers, figures }, outputs, oldPassReruns: 0,
  imageViews: 0, databaseWrites: 0, finish: 'review',
  hostTokens: 'unknown', totalCost: 'unknown',
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(binding(file)));
