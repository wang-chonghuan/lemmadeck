      },
      "key": {
        "correct": ["c"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "The actual exponent counts are 4,6,4,3. Reporting these directly as n yields this tuple rather than adding 1.", "misconception": "Confuse the number of ratio transitions with the term index."},
          {"option_id": "b", "truth": "incorrect", "derivation": "The exponent counts 4,6,4,3 are increased by 2, producing 6,8,6,5 rather than the required increase by 1.", "misconception": "Count the initial term twice when converting transition counts to indices."},
          {"option_id": "c", "truth": "correct", "derivation": "Divide targets by their initial terms to obtain 3^4,(1/2)^6,(1/3)^4,(0.1)^3; n-1 is 4,6,4,3, so n is 5,7,5,4.", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "In B, incorrectly count 640->160 as one halving, then count 160->80->40->20->10 as four more, obtaining five transitions and index 6. The other three correctly computed indices stay 5,5,4.", "misconception": "Skip the intermediate 320 while counting it as only one multiplication by 1/2."}
        ]
      }
    },
