          {"option_id": "b", "truth": "incorrect", "derivation": "Correctly obtain twenty periods but apply a term-20 formula from an initial term 1, giving 2^(20-1)=524288.", "misconception": "Subtract 1 from an elapsed-period count as if it were a term index."},
          {"option_id": "c", "truth": "incorrect", "derivation": "Compute twenty half-hour periods and replace repeated multiplication by a single multiplication 20*2=40.", "misconception": "Use the number of periods times the multiplier instead of exponentiating the multiplier."},
          {"option_id": "d", "truth": "correct", "derivation": "Ten hours contain twenty half-hour intervals. Starting at one, twenty doublings give 1*2^20=1048576 bacteria.", "misconception": null}
        ]
      }
    },
