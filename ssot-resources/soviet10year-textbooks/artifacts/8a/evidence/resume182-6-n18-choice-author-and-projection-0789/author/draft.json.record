          {"id": "b", "text": "$(a_5q^3,\\ a_5q^{12},\\ a_5q^{36})$", "figure_ids": []},
          {"id": "c", "text": "$(a_5+2q,\\ a_5+11q,\\ a_5+35q)$", "figure_ids": []},
          {"id": "d", "text": "$(a_5q^2,\\ a_5q^{11},\\ a_5q^{35})$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Express three later terms from the fifth-term anchor.",
        "source_solution": "Moving from index 5 to index j requires j-5 forward ratio steps. Therefore a_7=a_5 q^2, a_16=a_5 q^11, a_40=a_5 q^35. No inverse power or additional nonzero assumption is needed for these forward relations.",
        "unit_reason": "A shared non-first anchor determines all three exponent gaps; a full triple tests the relationship without per-term splitting.",
        "concept_blocks": [1],
        "limitations": ["Recognition does not demonstrate independent production of the three anchored expressions."],
