      ],
      "view": {
        "mode": "single",
        "stem": "等比数列 $(x_n)$ 的首项为 $x_1$，公比为 $q$。以下哪一组公式依次表示 $x_5,x_{21},x_{150},x_m,x_{m+2},x_{2k+1}$？各下标均为有效项序号。",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$(x_1q^5,\\ x_1q^{21},\\ x_1q^{150},\\ x_1q^m,\\ x_1q^{m+2},\\ x_1q^{2k+1})$",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$(x_1q^4,\\ x_1q^{20},\\ x_1q^{149},\\ x_1q^{m-1},\\ x_1q^{m+1},\\ x_1q^{2k})$",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$(x_1q^8,\\ x_1q^{40},\\ x_1q^{298},\\ x_1q^{2m-2},\\ x_1q^{2m+2},\\ x_1q^{4k})$",
            "figure_ids": []
          },
          {
            "id": "d",
            "text": "$(x_1+4q,\\ x_1+20q,\\ x_1+149q,\\ x_1+(m-1)q,\\ x_1+(m+1)q,\\ x_1+2kq)$",
            "figure_ids": []
          }
        ]
      }
    },
