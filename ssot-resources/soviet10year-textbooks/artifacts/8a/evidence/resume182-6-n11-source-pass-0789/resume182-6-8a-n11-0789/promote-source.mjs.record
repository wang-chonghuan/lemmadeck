import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const [reviewPath, reviewHash] = process.argv.slice(2);
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const base = '.tmp/resume182-6-8a-n11-0789';
const root = 'ssot-resources/soviet10year-textbooks/artifacts/8a';
const id = 'alg8-c3-s1-n11';
const readBound = item => {
  const absolute = path.resolve(item.path);
  assert.ok(absolute.startsWith(`${repo}/`) && fs.realpathSync(absolute) === absolute);
  const bytes = fs.readFileSync(absolute);
  assert.equal(sha(bytes), item.sha256, item.path);
  return bytes;
};
const review = JSON.parse(readBound({ path: reviewPath, sha256: reviewHash }));
assert.equal(review.status, 'SOURCE_PASS');
assert.equal(review.book, '8a');
assert.equal(review.lesson, id);
assert.equal(review.reviewer.kind, 'independent_agent');
assert.equal(review.blockers.length, 0);
const assemblyPath = `${base}/assembly-affected-join1/assembly.record`;
const assembly = JSON.parse(fs.readFileSync(assemblyPath));
assert.equal(assembly.status, 'SCOPED_ASSEMBLY_PASS_NOT_SOURCE_APPROVAL');
for (const binding of review.bindings) readBound(binding);
assert.ok(review.bindings.some(item => path.resolve(item.path) === path.resolve(assemblyPath)));
const source = `${base}/assembly-affected-join1/artifacts/8a`;
assert.ok(!fs.existsSync(`${root}/lessons/${id}`));
const outputs = [];
for (const name of ['lesson.json', 'lesson.md', 'exercises.json']) {
  const origin = `${source}/lessons/${id}/${name}`;
  const binding = review.bindings.find(item => path.resolve(item.path) === path.resolve(origin));
  assert.ok(binding, `Review does not bind ${origin}`);
  const bytes = readBound(binding);
  const target = `${root}/lessons/${id}/${name}`;
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, bytes, { flag: 'wx' });
  outputs.push({ path: target, sha256: sha(bytes), bytes: bytes.length });
}
for (const figure of assembly.figures) {
  for (const extension of ['png', 'svg']) {
    const origin = `${source}/figures/${figure}.${extension}`;
    const bytes = fs.readFileSync(origin);
    const target = `${root}/figures/${figure}.${extension}`;
    assert.ok(!fs.existsSync(target));
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, bytes, { flag: 'wx' });
    outputs.push({ path: target, sha256: sha(bytes), bytes: bytes.length });
  }
}
const record = {
  schema: 'stemrobin-182/reviewed-source-promotion@1',
  book: '8a', lesson: id, status: 'SOURCE_PASS',
  independentReview: { path: reviewPath, sha256: reviewHash }, outputs,
  oldLessonBytesChanged: 0, incompleteRightLessonPromoted: false,
  imageViews: 0, databaseWrites: 0, finish: 'review',
};
fs.writeFileSync(`${base}/source-promotion.record`, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ path: `${base}/source-promotion.record`,
  sha256: sha(fs.readFileSync(`${base}/source-promotion.record`)), outputs }));
