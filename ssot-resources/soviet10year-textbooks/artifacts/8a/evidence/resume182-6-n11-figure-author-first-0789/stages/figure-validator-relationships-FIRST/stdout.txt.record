42-def sha256(path: Path) -> str:
43-    digest = hashlib.sha256()
44-    with path.open("rb") as handle:
45-        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
46-            digest.update(chunk)
47-    return digest.hexdigest()
