33-def load(path: Path) -> dict:
34-    try:
35:        return json.loads(path.read_text(encoding="utf-8"))
36-    except FileNotFoundError:
37-        raise SystemExit(f"ERROR: missing spec: {path}")
38-    except json.JSONDecodeError as error:
39-        raise SystemExit(f"ERROR: invalid JSON {path}: {error}")
