556-def assertion_errors(
557-    assertions: list[dict],
558-    objects: list[dict],
559-    points: dict[str, tuple[float, float]],
560-) -> list[str]:
561-    errors = []
562-    objects_by_id = {
563-        item.get("id"): item
564-        for item in objects
565-        if isinstance(item, dict) and isinstance(item.get("id"), str)
566-    }
567-    for index, item in enumerate(assertions):
568-        label = f"assertions[{index}]"
569-        kind = item.get("type")
570-        tolerance = item.get("tolerance", 1e-6)
571-        if not finite_number(tolerance) or tolerance < 0:
572-            errors.append(f"{label}.tolerance must be a nonnegative number")
573-            continue
574:        if kind == "objectCount":
575-            object_type = item.get("objectType")
576-            expected = item.get("count")
577-            actual = sum(obj.get("type") == object_type for obj in objects)
578-            if not isinstance(expected, int) or actual != expected:
579-                errors.append(
580-                    f"{label}: expected {expected} {object_type}, found {actual}"
581-                )
582-            continue
583:        if kind == "gridDimensions":
584-            grid_id = item.get("grid")
585-            grid = objects_by_id.get(grid_id)
586-            if not isinstance(grid, dict) or grid.get("type") != "grid":
587-                errors.append(f"{label}.grid must reference a grid")
588-                continue
589-            columns = item.get("columns")
590-            rows = item.get("rows")
591-            if (
592-                not isinstance(columns, int)
593-                or isinstance(columns, bool)
594-                or columns <= 0
595-            ):
596-                errors.append(f"{label}.columns must be a positive integer")
597-            if (
598-                not isinstance(rows, int)
599-                or isinstance(rows, bool)
600-                or rows <= 0
601-            ):
602-                errors.append(f"{label}.rows must be a positive integer")
603-            bounds = grid.get("bounds")
604-            x_step = grid.get("xStep")
605-            y_step = grid.get("yStep")
606-            if (
607-                not isinstance(bounds, list)
608-                or len(bounds) != 4
609-                or not all(finite_number(value) for value in bounds)
610-            ):
611-                errors.append(
612:                    f"{label}: gridDimensions requires finite grid bounds"
613-                )
614-                continue
615-            if (
616-                not finite_number(x_step)
617-                or x_step <= 0
618-                or not finite_number(y_step)
619-                or y_step <= 0
620-            ):
621-                continue
622-            x_offset = grid.get("xOffset", 0)
623-            y_offset = grid.get("yOffset", 0)
624-            if not finite_number(x_offset) or not finite_number(y_offset):
625-                continue
626-            x_min, y_max, x_max, y_min = bounds
627-            aligned = all(
628-                abs(value - round(value)) <= tolerance
629-                for value in (
630-                    (x_min - x_offset) / x_step,
631-                    (x_max - x_offset) / x_step,
632-                    (y_min - y_offset) / y_step,
633-                    (y_max - y_offset) / y_step,
634-                )
635-            )
636-            if not aligned:
637-                errors.append(
638-                    f"{label}: grid bounds must align with its offsets and steps"
639-                )
640-                continue
641-            actual_columns = round((x_max - x_min) / x_step)
642-            actual_rows = round((y_max - y_min) / y_step)
643-            if isinstance(columns, int) and actual_columns != columns:
644-                errors.append(
645-                    f"{label}: grid has {actual_columns} columns, expected {columns}"
646-                )
647-            if isinstance(rows, int) and actual_rows != rows:
648-                errors.append(
649-                    f"{label}: grid has {actual_rows} rows, expected {rows}"
650-                )
651-            continue
652:        if kind == "displacement":
653-            start = resolve_point(
654-                item.get("from"), points, f"{label}.from", errors
655-            )
656-            end = resolve_point(
657-                item.get("to"), points, f"{label}.to", errors
658-            )
659-            expected_dx = item.get("dx")
660-            expected_dy = item.get("dy")
661-            if not finite_number(expected_dx):
662-                errors.append(f"{label}.dx must be finite")
663-            if not finite_number(expected_dy):
664-                errors.append(f"{label}.dy must be finite")
665-            if (
666-                start is not None
667-                and end is not None
668-                and finite_number(expected_dx)
669-                and finite_number(expected_dy)
670-            ):
671-                actual_dx = end[0] - start[0]
672-                actual_dy = end[1] - start[1]
673-                if (
674-                    abs(actual_dx - expected_dx) > tolerance
675-                    or abs(actual_dy - expected_dy) > tolerance
676-                ):
677-                    errors.append(
678:                        f"{label}: displacement ({actual_dx:.8g}, "
679-                        f"{actual_dy:.8g}) != ({expected_dx!r}, "
680-                        f"{expected_dy!r})"
681-                    )
682-            continue
683-        if kind == "pointOnCircle":
684-            point = resolve_point(item.get("point"), points, f"{label}.point", errors)
685-            center = resolve_point(item.get("center"), points, f"{label}.center", errors)
686-            radius = item.get("radius")
