149-def point_to_segment_distance(
150-    point: tuple[float, float],
151-    start: tuple[float, float],
152-    end: tuple[float, float],
153-) -> float:
154-    segment = vector(start, end)
155-    length_squared = dot(segment, segment)
156-    if length_squared == 0:
157-        return distance(point, start)
158-    offset = vector(start, point)
159-    position = max(0.0, min(1.0, dot(offset, segment) / length_squared))
160-    projection = (
161-        start[0] + segment[0] * position,
