692-            continue
693-        if kind == "centralSymmetry":
694-            center = resolve_point(
695-                item.get("center"), points, f"{label}.center", errors
696-            )
697-            pairs = item.get("pairs")
698-            if not isinstance(pairs, list) or not pairs:
699-                errors.append(f"{label}.pairs must be a nonempty array")
700-                continue
701-            if center is None:
702-                continue
703-            for pair_index, pair in enumerate(pairs):
704-                pair_label = f"{label}.pairs[{pair_index}]"
705-                if not isinstance(pair, dict):
706-                    errors.append(f"{pair_label} must be an object")
707-                    continue
708-                first = resolve_point(
709-                    pair.get("a"), points, f"{pair_label}.a", errors
710-                )
711-                second = resolve_point(
712-                    pair.get("b"), points, f"{pair_label}.b", errors
713-                )
