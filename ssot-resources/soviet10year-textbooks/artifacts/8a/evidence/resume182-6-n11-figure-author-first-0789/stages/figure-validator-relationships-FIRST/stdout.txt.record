133-def distance(a: tuple[float, float], b: tuple[float, float]) -> float:
134-    return math.hypot(a[0] - b[0], a[1] - b[1])
135-
136-
137-def vector(a: tuple[float, float], b: tuple[float, float]) -> tuple[float, float]:
138-    return b[0] - a[0], b[1] - a[1]
139-
140-
141-def cross(a: tuple[float, float], b: tuple[float, float]) -> float:
142-    return a[0] * b[1] - a[1] * b[0]
143-
144-
145-def dot(a: tuple[float, float], b: tuple[float, float]) -> float:
146-    return a[0] * b[0] + a[1] * b[1]
