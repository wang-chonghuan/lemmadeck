import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const own = '.tmp/resume182-6-8a-n8-text-status-bind3695-FIRST';
assert.ok(!fs.existsSync(own));
const reviewFile = '.tmp/resume182-6-8a-n8-text-fig16-review3695-FIRST/review.record';
const readyFile = '.tmp/resume182-6-8a-n8-text-author3695-FIRST/ready.record';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const read = file => fs.readFileSync(file);
const bind = file => ({ path: path.resolve(file), sha256: sha(read(file)) });
assert.equal(sha(read(reviewFile)), '02f24f7bf78811a36feb9bc20a6ed73e7581a2cbcacebb2d95a5c521babc28da');
assert.equal(sha(read(readyFile)), 'aa98066f0b8da07ffceeb8739c5d0edca92cf62204832bf73a1bd572f60e7683');
const review = JSON.parse(read(reviewFile)), ready = JSON.parse(read(readyFile));
assert.equal(review.status, 'HOLD');
assert.equal(review.textStatus, 'PASS');
assert.equal(sha(read(review.textReview.path)), review.textReview.sha256);
const observed = JSON.parse(read(review.textReview.path));
assert.equal(observed.status, 'PASS');
assert.deepEqual(observed.blockingFindings, []);
for (const item of ready.outputs) {
  assert.equal(sha(read(item.path)), item.sha256);
  assert.ok(Object.values(review.files).some(file => file.path === item.path && file.sha256 === item.sha256));
}
const value = {
  schema: 'resume182-6/inherited-text-approval-binding@1',
  status: 'TEXT_PASS', ticket: 'STEMROBIN-182', root: repo, book: '8a',
  lesson: 'alg8-c2-s1-n8', edition: 'modern-us-neutral',
  inheritedIndependentTextApproval: review.textReview,
  retainedCombinedHOLD: bind(reviewFile), authorReady: bind(readyFile),
  inputs: ready.outputs,
  action: 'Normalize the existing independent text PASS receipt label only; keep the combined figure HOLD unchanged.',
  newSourceMathTextOrImageReviews: 0, reviewerImageViews: 2, parentImageViews: 0,
  rendererCalls: 0, DBWrites: 0, wholeLessonApproval: false,
  unknownHistoricalBytesRecovered: false, hostTokens: 'unknown', totalCost: 'unknown',
};
fs.mkdirSync(own);
fs.writeFileSync(`${own}/text-review.record`, `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(bind(`${own}/text-review.record`)));
