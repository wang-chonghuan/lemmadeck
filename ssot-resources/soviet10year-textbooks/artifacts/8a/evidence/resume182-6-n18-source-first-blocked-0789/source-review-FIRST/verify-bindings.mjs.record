  initial_author_metadata_changes_only: ['printed_lines', 'provenance'],
  all18_scoped_raw_snapshots_equal_current_raw: true,
  all3_assembled_outputs_equal_exact_raw_projection: true,
  prose_refs: expectedProse.map(item => item.source_refs),
  exercise_refs: expectedExercises.map(item => ({number: item.number, refs: item.pages, group: item.group, line_count: item.lines.length})),
  selected_refs: selected.map(block => block.ref),
