  status: 'READ_ONLY_BINDINGS_AND_EXACT_RAW_TO_ASSEMBLY_COMPARISON_PASS_NOT_SOURCE_APPROVAL',
  counts, body_counts_new_pages: [22, 21, 21, 22, 23],
