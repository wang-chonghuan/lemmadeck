          "fig30-an-4-position", "fig30-an-8-position", "fig30-an-12-position",
          "fig30-an-16-position", "fig30-an-20-position", "fig30-an-24-position"
        ]
      },
      {
        "id": "fig30-clear-point-relations",
        "description": "Five independently read filled markers: (1,6),(2,10),(3,14),(4,18),(5,22). Each next marker moves half a grid cell right and two rows up. Intrinsic upper ROI shows guide/grid strokes, not an independently enlarged additional marker; neither (6,26) nor (7,30) is authored as a data point.",
        "objects": [
          "fig30-point-01", "fig30-point-02", "fig30-point-03",
          "fig30-point-04", "fig30-point-05"
        ],
        "assertions": [
          "fig30-step-01-02", "fig30-step-02-03", "fig30-step-03-04",
          "fig30-step-04-05", "fig30-collinear-03", "fig30-collinear-04",
          "fig30-collinear-05", "fig30-visible-point-count"
        ],
        "requires": ["pointRelationships"]
      },
      {
        "id": "fig30-broken-trace",
        "description": "Source rising dashed guide through all five plotted markers, continuing above and below them inside the common grid. Modern regular dash spacing and clipping endpoints (-2,-6)/(7,30) construct the straight guide at the frame boundary; these are not source labelled terminal coordinates and do not create visible point objects.",
        "objects": [
          "fig30-guide", "fig30-point-01", "fig30-point-02",
          "fig30-point-03", "fig30-point-04", "fig30-point-05"
        ],
        "assertions": [
          "fig30-point-01-on-guide", "fig30-point-02-on-guide",
          "fig30-point-03-on-guide", "fig30-point-04-on-guide", "fig30-point-05-on-guide"
        ]
      }
    ]
  },
