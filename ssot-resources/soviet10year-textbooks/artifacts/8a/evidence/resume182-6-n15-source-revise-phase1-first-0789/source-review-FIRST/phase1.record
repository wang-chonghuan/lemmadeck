        [1,"p0097#1",455,"16. 等差数列前 n 项的和的公式"],
        [2,"p0097#2",605,"Need sum of first100 natural numbers; direct addition"],
        [3,"p0097#2",715,"Can get answer but laborious; line ends 现在我们"],
        [4,"p0097#2",830,"试图按另一个方式求出需要的结果."],
        [5,"p0097#3",940,"Write sum of1..100 twice; line ends 按照递"],
        [6,"p0097#3",1045,"Increasing order vs decreasing order; line ends 就"],
        [7,"p0097#3",1160,"是："],
        [8,"p0097#3",1280,"1+2+3+...+98+99+100,"],
        [9,"p0097#3",1390,"100+99+98+...+3+2+1."],
        [10,"p0097#4",1510,"Vertically paired numbers have equal sums"],
        [11,"p0097#4",1620,"1+100=2+99=3+98=...=98+3"],
        [12,"p0097#4",1730,"=99+2=100+1."],
        [13,"p0097#5",1840,"Each pair sums101;100pairs; 因此"],
        [14,"p0097#5",1960,"1+2+3+...+98+99+100"],
        [15,"p0097#5",2100,"=(101 times100)/2=101 times50=5050, one fraction row"],
        [16,"p0097#6",2260,"Use analogous method for first n terms of an arithmetic sequence"],
        [17,"p0097#7",2370,"S_n denotes sum of first n terms of (a_n); line ends 这个和"],
        [18,"p0097#7",2490,"Write twice, reversing addend order the second time"],
        [19,"p0097#7",2600,"S_n=a_1+a_2+a_3+...+a_(n-2)+a_(n-1)+a_n, (1)"],
        [20,"p0097#7",2720,"S_n=a_n+a_(n-1)+a_(n-2)+...+a_3+a_2+a_1. (2)"],
        [21,"p0097#8",2830,"Add equations (1),(2); 就得："],
        [22,"p0097#8",2940,"2S_n=(a_1+a_n)+(a_2+a_(n-1))+(a_3+a_(n-2))+..."],
        [23,"p0097#8",3050,"+(a_(n-2)+a_3)+(a_(n-1)+a_2)+(a_n+a_1)."],
        [24,"p0097#9",3160,"Printed page90 with decorative dots"]
      ],
