import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const prior = '.tmp/resume182-6-8a-n14-0789';
const older = '.tmp/resume182-6-8a-n12-0789';
const base = '.tmp/resume182-6-8a-n15-0789';
const id = 'alg8-c3-s2-n15';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bind = file => ({ path: path.resolve(file), sha256: sha(fs.readFileSync(file)),
  bytes: fs.statSync(file).size, realpath: fs.realpathSync(file) });
const assembly = JSON.parse(fs.readFileSync(`${base}/assembly-FIRST/assembly.record`));
assert.equal(assembly.lesson, id);
assert.equal(assembly.exercise_count, 22);
assert.deepEqual(assembly.figures, ['fig-30']);
const adapt = text => text.replaceAll('resume182-6-8a-n14-0789', 'resume182-6-8a-n15-0789')
  .replaceAll('alg8-c3-s2-n14', id).replaceAll('resume182-6-n14-', 'resume182-6-n15-')
  .replaceAll('n14-parent-display-ready@1', 'n15-parent-display-ready@1')
  .replaceAll('bounded-n14-offline-display@1', 'bounded-n15-offline-display@1');
const outputs = [];
function save(source, target, transform = adapt) {
  assert.ok(!fs.existsSync(target), target);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.writeFileSync(target, transform(fs.readFileSync(source, 'utf8')), { flag: 'wx' });
  const check = spawnSync(process.execPath, ['--check', target], { encoding: 'utf8' });
  assert.equal(check.status, 0, check.stderr);
  outputs.push({ source: bind(source), output: bind(target) });
}
save(`${prior}/promote-answers.mjs`, `${base}/promote-answers.mjs`,
  code => adapt(code).replace('assert.equal(data.answers.length, 9);', 'assert.equal(data.answers.length, 22);'));
save(`${prior}/prepare-choice-review.mjs`, `${base}/prepare-choice-review.mjs`);
save(`${prior}/bind-choice-review.mjs`, `${base}/bind-choice-review.mjs`,
  code => adapt(code).replace('assert.equal(review.source_reviews.length, 9);',
    'assert.equal(review.source_reviews.length, 22);'));
save(`${older}/promote-figures.mjs`, `${base}/promote-figures.mjs`,
  code => code.replaceAll('resume182-6-8a-n12-0789', 'resume182-6-8a-n15-0789')
    .replaceAll('alg8-c3-s1-n12', id).replace('assembly-AFFECTED-annotation1', 'assembly-FIRST'));
save(`${prior}/delivery.mjs`, `${base}/delivery.mjs`, code => adapt(code)
  .replace("['0089', '0090', '0091']", "['0092', '0093', '0094', '0095', '0096', '0097']")
  .replace('N14_NARROW_STAGED', 'N15_NARROW_STAGED')
  .replace("assert.deepEqual(JSON.parse(fs.readFileSync(`${edition}/lessons/${id}/figures.json`)).figures, []);",
    "assert.deepEqual(JSON.parse(fs.readFileSync(`${edition}/lessons/${id}/figures.json`)).figures.map(item => item.id), ['fig-30']);")
  .replace('const display = JSON.parse', `exact.push('.claude/skills/ld-s10y-lesson/tools/layout.py',
  '.claude/skills/ld-s10y-lesson/tests/test_system_label_rows.py');
exact.push(...['png', 'svg'].map(ext => \`\${root}/figures/fig-30.\${ext}\`));
exact.push(...['spec.json', 'svg', 'render.json', 'review.json'].map(ext => \`\${edition}/figures/fig-30.\${ext}\`));
const display = JSON.parse`));
const originalReady = JSON.parse(fs.readFileSync(`${prior}/display-FIRST/ready-FIRST.record`));
const names = ['prepare.mjs', 'run.mjs', 'display-helper.mjs', 'display-helper-base.mjs'];
const displayFiles = [];
for (const name of names) {
  const source = `${prior}/display-FIRST/${name}`;
  assert.equal(bind(source).sha256, originalReady.files.find(item => item.path === path.resolve(source)).sha256);
  const target = `${base}/display-FIRST/${name}`;
  save(source, target, code => adapt(code).replace('export const requiredFigures = [];',
    "export const requiredFigures = ['fig-30'];"));
  displayFiles.push(bind(target));
}
save(`${prior}/observe-tools.mjs`, `${base}/observe-tools.mjs`);
const pins = originalReady.pins.filter(item => !names.some(name =>
  item.path === path.resolve(`${prior}/display-FIRST/${name}`)));
for (const item of pins) assert.equal(bind(item.path).sha256, item.sha256);
pins.push(...displayFiles);
const ready = {
  status: 'SCRIPTS_PREPARED_RUNTIME_NOT_EXECUTED', workdir: repo,
  files: displayFiles, pins, figureIds: assembly.figures, exerciseCount: assembly.exercise_count,
  parentGate: { schema: 'n15-parent-display-ready@1', statusRequired: 'parentREADY',
    textAnswerChoiceApprovalsMustBeIndependentlyPinned: true,
    independentFigureReviewRequired: true },
  correctedPriorImplementation: bind(`${prior}/display-FIRST/ready-FIRST.record`),
  observer: outputs.find(item => item.output.path === path.resolve(`${base}/observe-tools.mjs`)),
  runtimeExecuted: false, rendererCalls: 0, browserLaunches: 0, screenshotsCaptured: 0,
  imagesObserved: 0, oldPassReruns: 0, databaseWrites: 0, hostTokens: 'unknown',
  totalCost: 'unknown', finish: 'review',
};
fs.writeFileSync(`${base}/display-FIRST/ready-FIRST.record`, `${JSON.stringify(ready, null, 2)}\n`, { flag: 'wx' });
const file = `${base}/support.record`;
fs.writeFileSync(file, `${JSON.stringify({ status: 'SCOPED_SUPPORT_PREPARED_NOT_EXECUTED',
  book: '8a', lesson: id, outputs, displayReady: bind(`${base}/display-FIRST/ready-FIRST.record`),
  oldPassReruns: 0, imageViews: 0, databaseWrites: 0, finish: 'review',
  hostTokens: 'unknown', totalCost: 'unknown' }, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(bind(file)));
