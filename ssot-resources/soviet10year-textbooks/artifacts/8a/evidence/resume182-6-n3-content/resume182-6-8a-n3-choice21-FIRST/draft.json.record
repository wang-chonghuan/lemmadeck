        "options": [
          {
            "id": "opt-1",
            "text": "| 曲线 | $a$ |\n| --- | --- |\n| I | $1$ |\n| II | $2$ |\n| III | $-\\frac{1}{2}$ |\n| IV | $-1$ |",
