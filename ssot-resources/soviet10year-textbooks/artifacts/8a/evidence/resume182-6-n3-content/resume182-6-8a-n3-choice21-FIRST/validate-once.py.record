"""Capture the sole authorized structural check without a semantic verdict."""

from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import subprocess
import sys
import time


ROOT = Path("/Users/yong/.codex/worktrees/stemrobin-182-six/lemmadeck")
WORK = ROOT / ".tmp/resume182-6-8a-n3-choice21-FIRST"
OUTPUTS = (
    "validation.stdout.txt",
    "validation.stderr.txt",
    "validation.receipt.json",
    "usage.json",
)


def snapshot(path):
    raw = path.read_bytes()
    value = json.loads(raw)
    canonical = json.dumps(
        value, sort_keys=True, ensure_ascii=True, separators=(",", ":")
    ).encode("utf-8")
    return {
        "path": str(path.relative_to(ROOT)),
        "bytes": len(raw),
        "raw_sha256": hashlib.sha256(raw).hexdigest(),
        "canonical_sha256": hashlib.sha256(canonical).hexdigest(),
    }


def exclusive_write(name, value):
    with (WORK / name).open("x", encoding="utf-8") as stream:
        stream.write(value)


def main():
    if Path.cwd().resolve() != ROOT.resolve():
        raise RuntimeError("Wrong checkout root; no validation executed.")
    if any((WORK / name).exists() for name in OUTPUTS):
        raise RuntimeError("Evidence exists; this runner will not repeat validation.")
    seed_before = snapshot(WORK / "seed.json")
    solution = snapshot(WORK / "author-solution.record.json")
    seal = json.loads((WORK / "author-solution.seal.json").read_text())
    if (
        solution["raw_sha256"] != seal["raw_sha256"]
        or solution["canonical_sha256"] != seal["canonical_sha256"]
    ):
        raise RuntimeError("Author solution seal changed; no validation executed.")
    draft = snapshot(WORK / "draft.json")
    argv = [
        sys.executable,
        "-B",
        ".agents/skills/ld-s10y-choice/scripts/validate.py",
        "--repo",
        ".",
        "--seed",
        ".tmp/resume182-6-8a-n3-choice21-FIRST/seed.json",
        "--draft",
        ".tmp/resume182-6-8a-n3-choice21-FIRST/draft.json",
    ]
    started = datetime.now(timezone.utc).isoformat()
    clock = time.monotonic()
    result = subprocess.run(argv, cwd=ROOT, capture_output=True, text=True)
    elapsed = time.monotonic() - clock
    exclusive_write("validation.stdout.txt", result.stdout)
    exclusive_write("validation.stderr.txt", result.stderr)
    seed_after = snapshot(WORK / "seed.json")
    receipt = {
        "kind": "first-and-only-structural-validation",
        "cwd": str(ROOT),
        "argv": argv,
        "started_utc": started,
        "elapsed_seconds": elapsed,
        "exit_code": result.returncode,
        "stdout_path": str((WORK / OUTPUTS[0]).relative_to(ROOT)),
        "stderr_path": str((WORK / OUTPUTS[1]).relative_to(ROOT)),
        "seed_before": seed_before,
        "seed_after": seed_after,
        "seed_unchanged": seed_before == seed_after,
        "sealed_author_solution": solution,
        "draft": draft,
        "semantic_review": "pending; not run, not passed, no review supplied",
        "retry_count": 0,
    }
    exclusive_write(
        "validation.receipt.json",
        json.dumps(receipt, indent=2, ensure_ascii=True) + "\n",
    )
    usage = {
        "ticket": "STEMROBIN-182",
        "scope": "182-6 / 8a / alg8-c1-s1-n3 / original 21 only",
        "seed_sources": 1,
        "authored_questions": 1,
        "mode": "single",
        "options": 5,
        "new_figures": 0,
        "shared_seed_figures": 1,
        "original_image_views": 1,
        "modern_complete_image_views": 1,
        "total_image_views": 2,
        "crops_or_reopens": 0,
        "render_calls": 0,
        "figure_review_calls": 0,
        "external_model_service_calls": 0,
        "network_calls": 0,
        "database_calls": 0,
        "environment_file_reads": 0,
        "application_commands": 0,
        "git_commands": 0,
        "new_chats": 0,
        "installs": 0,
        "structural_validate_calls": 1,
        "structural_validate_retries": 0,
        "structural_exit_code": result.returncode,
        "semantic_gate": "pending; no independent reviewer authorized or invoked",
        "content_revisions": 0,
        "existing_old_questions_read_or_resolved": 0,
        "existing_old_choices_read_or_rewritten": 0,
        "answer_files_or_other_solvers_solutions_read": 0,
        "whole_lesson_complete": False,
        "paid_usage_reset": False,
        "host_cost": "unknown",
        "scope_note": "The structural checker refreshes its permitted source projection; no old choice or answer artifacts are supplied or displayed.",
    }
    exclusive_write(
        "usage.json", json.dumps(usage, indent=2, ensure_ascii=True) + "\n"
    )
    print(json.dumps(receipt, indent=2, ensure_ascii=True))
    print("Captured validator stdout:")
    print(result.stdout, end="")
    print("Captured validator stderr:")
    print(result.stderr, end="")
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
