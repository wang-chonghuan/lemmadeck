    assert.deepEqual(labelHits, []);
    const padded = inflate(glyph, spec.layout.minLabelGap);
    const geometryHits = spec.objects.filter((object) => {
      if (object.type === 'circle') return circleHitsBox(object, padded);
      if (['segment', 'arrow', 'axis'].includes(object.type) && Array.isArray(object.from) && Array.isArray(object.to)) {
        return segmentHitsBox(screen(object.from), screen(object.to), inflate(padded, (object.strokeWidth ?? 0) / 2));
      }
      return false;
    }).map((object) => object.id);
    assert.deepEqual(geometryHits, [], 'Given label must also avoid thin hatch segments, not just render-gated thick strokes.');
    assert.deepEqual(boxes.filter((box) => box.id !== glyph.id && overlap(padded, inflate(box, spec.layout.minLabelGap))).map((box) => box.id), []);
    // These short leaders leave the boundary immediately into an unhatched side.
    const radialDirection = (start[0] - screen(circle.center)[0]) * (end[0] - start[0]);
    assert.ok(item.offset[0] > 0 ? radialDirection > 0 : radialDirection < 0);
    const assertion = { id: `${leader.id}-connects`, type: 'connects', arrow: leader.id, from: [...leader.from], to: [...leader.to] };
    additions.push({ label: item.id, sourcePanel: item.panel, givenText: String(item.value), givenAbscissa: item.value, exactCircleAxisIntersection: item.anchor, origin: item.origin, circle: item.circle, existingPointOnCircleAssertion: item.circleAssertion, existingDisplacementAssertion: `${item.id}-source-coordinate`, leader, assertion, modernAdditionNotSourceFact: true });
    derivations.push({
      labelId: item.id, failedOffset: old.labelPlacement.offset, nextOffset: target.labelPlacement.offset,
      measuredFailedGlyphBox: measured, reusedFirstGlyphBox: glyph, paddedGlyphBox: padded,
      sourceIntersectionScreen: start, leaderEndScreen: end, leaderEndUser: leader.to,
