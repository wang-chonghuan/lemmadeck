      labelVsOtherLabelHits: [], method: 'Analytic text/segment/circle calculation from existing measured boxes; no browser, screenshots or image reads.',
    });
  }
  spec.objects.push(...additions.map((item) => item.leader));
  spec.assertions.push(...additions.map((item) => item.assertion));
  spec.source.inventory.push({
