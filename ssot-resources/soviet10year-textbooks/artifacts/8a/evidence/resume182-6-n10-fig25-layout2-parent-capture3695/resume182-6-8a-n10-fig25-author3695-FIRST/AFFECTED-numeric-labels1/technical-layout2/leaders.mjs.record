assert.equal(process.cwd(), R);
const hash = (value) => crypto.createHash('sha256').update(value).digest('hex');
const bind = (path) => ({ path, sha256: hash(fs.readFileSync(path)) });
const read = (path) => JSON.parse(fs.readFileSync(path, 'utf8'));
const write = (name, value) => {
  const path = `${work}/${name}`;
  fs.writeFileSync(path, `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
  return bind(path);
};
const changes = [
  { id: 'fig-25-v-x-four-label', panel: 'v', anchor: [14, 14], origin: [10, 14], value: 4, offset: [30, 30], circle: 'fig-25-v-circle', circleAssertion: 'fig-25-v-circle-right-intersection' },
  { id: 'fig-25-g-x-four-label', panel: 'g', anchor: [36, 14], origin: [32, 14], value: 4, offset: [-30, 30], circle: 'fig-25-g-inner-circle', circleAssertion: 'fig-25-g-inner-circle-right-intersection' },
  { id: 'fig-25-g-x-six-label', panel: 'g', anchor: [38, 14], origin: [32, 14], value: 6, offset: [30, 30], circle: 'fig-25-g-outer-circle', circleAssertion: 'fig-25-g-outer-circle-right-intersection' },
];
const screen = ([x, y]) => [x * 30, (36 - y) * 30];
const user = ([x, y]) => [x / 30, 36 - y / 30];
const inflate = (b, gap) => ({ x: b.x - gap, y: b.y - gap, width: b.width + gap * 2, height: b.height + gap * 2 });
const overlap = (a, b) => a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height;
function segmentHitsBox(a, b, box) {
  let lower = 0;
  let upper = 1;
  for (let axis = 0; axis < 2; axis++) {
    const start = axis ? box.y : box.x;
    const end = start + (axis ? box.height : box.width);
    const delta = b[axis] - a[axis];
    if (Math.abs(delta) < 1e-12) {
      if (a[axis] < start || a[axis] > end) return false;
    } else {
      const bounds = [(start - a[axis]) / delta, (end - a[axis]) / delta].sort((x, y) => x - y);
      lower = Math.max(lower, bounds[0]);
      upper = Math.min(upper, bounds[1]);
      if (lower > upper) return false;
    }
  }
  return true;
}
function circleHitsBox(object, box) {
  const [cx, cy] = screen(object.center);
  const radius = object.radius * 30;
  const dx = Math.max(box.x - cx, 0, cx - box.x - box.width);
  const dy = Math.max(box.y - cy, 0, cy - box.y - box.height);
  const nearest = Math.hypot(dx, dy);
  const farthest = Math.max(...[box.x, box.x + box.width].flatMap((x) =>
    [box.y, box.y + box.height].map((y) => Math.hypot(x - cx, y - cy))));
  return nearest <= radius + object.strokeWidth / 2 && farthest >= radius - object.strokeWidth / 2;
}

if (process.argv[2] === 'prepare') {
  const first = read(`${own}/render-ready.record`);
  const original = read(first.spec.path);
  const baseline = read(`${affected}/fig-25.spec.json`);
