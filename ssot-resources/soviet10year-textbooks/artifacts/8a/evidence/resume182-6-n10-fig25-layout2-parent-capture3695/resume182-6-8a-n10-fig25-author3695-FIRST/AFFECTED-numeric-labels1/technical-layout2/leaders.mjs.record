  const boxes = originalLabels.map((box) => ({ ...box }));
  const additions = [];
  const derivations = [];
  const leaderWidth = 2.8;
  const safety = 2;
  const glyphGap = spec.layout.minLabelGap + leaderWidth / 2 + safety;
