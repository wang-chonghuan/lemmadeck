import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

const R = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
const own = `${R}/.tmp/resume182-6-8a-n10-fig25-author3695-FIRST`;
const work = `${own}/AFFECTED-numeric-labels1`;
const reviewer = `${R}/.tmp/resume182-6-8a-n10-fig25-review3695-FIRST`;
assert.equal(process.cwd(), R);
const hash = (bytes) => crypto.createHash('sha256').update(bytes).digest('hex');
const bind = (path) => ({ path, sha256: hash(fs.readFileSync(path)) });
const read = (path) => JSON.parse(fs.readFileSync(path, 'utf8'));
const write = (name, value) => {
  const file = `${work}/${name}`;
  fs.writeFileSync(file, `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
  return bind(file);
};
const changes = [
  { id: 'fig-25-v-x-four-label', oldHorizontal: 30, anchor: [14, 14], value: '4' },
  { id: 'fig-25-g-x-four-label', oldHorizontal: -30, anchor: [36, 14], value: '4' },
  { id: 'fig-25-g-x-six-label', oldHorizontal: 30, anchor: [38, 14], value: '6' },
];
const phase = process.argv[2];
if (phase === 'prepare') {
  const first = read(`${own}/render-ready.record`);
  assert.equal(bind(`${own}/render-ready.record`).sha256, 'ae72a6142b362639133f721e9b6e1831cd759097186554aa34829db5e06a8cc0');
  assert.equal(bind(`${own}/ready.record`).sha256, '12dc00282ea205a5031beb8a47ee5a69c8c7e52574a674d24a1480fe87d150fa');
  assert.equal(bind(`${reviewer}/ready.record`).sha256, 'ad3caeadc5d09028be323f1b7d1d6c7dda22c0deaf58e2b1a0e6f5ed7b2bf6bb');
  assert.equal(bind(`${reviewer}/fig-25.hold.json`).sha256, 'c4902641d6c084635797d7bf4ca62624d055d1cc3b73dcdbc9c447aeaa4c6d0c');
  const original = read(first.spec.path);
  const repaired = structuredClone(original);
  const fieldChanges = [];
  for (const change of changes) {
    const index = repaired.objects.findIndex((item) => item.id === change.id);
    assert.ok(index >= 0);
    const item = repaired.objects[index];
    assert.deepEqual(item.at, change.anchor);
    assert.equal(item.text, change.value);
    assert.deepEqual(item.labelPlacement, { position: 'CENTER', offset: [change.oldHorizontal, 30] });
    item.labelPlacement.offset[0] = 0;
    fieldChanges.push({
      objectId: change.id,
      jsonPointer: `/objects/${index}/labelPlacement/offset/0`,
      before: change.oldHorizontal, after: 0,
      anchorBefore: original.objects[index].at, anchorAfter: item.at,
      verticalOffsetBefore: original.objects[index].labelPlacement.offset[1],
      verticalOffsetAfter: item.labelPlacement.offset[1],
      placementBefore: original.objects[index].labelPlacement.position,
      placementAfter: item.labelPlacement.position,
      textBefore: original.objects[index].text, textAfter: item.text,
    });
  }
  const restored = structuredClone(repaired);
  for (const change of changes) {
    restored.objects.find((item) => item.id === change.id).labelPlacement.offset[0] = change.oldHorizontal;
  }
  assert.deepEqual(restored, original, 'Only the three authorized scalar changes are allowed.');
  const originalBytes = fs.readFileSync(first.spec.path);
  assert.equal(`${JSON.stringify(original, null, 2)}\n`, originalBytes.toString('utf8'));
  const excluded = new Set(changes.map((item) => item.id));
  const untouchedBefore = original.objects.filter((item) => !excluded.has(item.id));
  const untouchedAfter = repaired.objects.filter((item) => !excluded.has(item.id));
  assert.deepEqual(untouchedAfter, untouchedBefore);
  assert.deepEqual(repaired.assertions, original.assertions);
  const preservation = [
    first.spec, first.svg, first.render, first.nativePng, first.width640Preview,
    first.independentSourceInventory, first.authoringNotes, first.capture,
    first.authoringScript, first.captureScript, first.sealScript,
    bind(`${own}/render-ready.record`),
    bind(`${reviewer}/ready.record`), bind(`${reviewer}/fig-25.hold.json`),
  ];
  for (const item of preservation) assert.equal(bind(item.path).sha256, item.sha256);
  const spec = write('fig-25.spec.json', repaired);
  const diff = write('label-repair.diff.record', {
    schema: 'resume182-6/affected-field-diff@1',
    role: 'AUTHOR_NOT_REVIEWER', repair: 'AFFECTED-numeric-labels1',
    contentLabelRepairsThisRound: 1, contentLabelRepairsCumulative: first.counts.contentRepairs + 1,
    baselineSpec: first.spec, affectedSpec: spec,
    fieldChanges, changedObjectCount: 3, changedScalarFieldCount: 3,
    restoredFullSpecEqualsOriginal: true,
    originalCanonicalHash: hash(JSON.stringify(original)),
    restoredCanonicalHash: hash(JSON.stringify(restored)),
    untouchedObjectsBeforeHash: hash(JSON.stringify(untouchedBefore)),
    untouchedObjectsAfterHash: hash(JSON.stringify(untouchedAfter)),
    assertionsBeforeHash: hash(JSON.stringify(original.assertions)),
    assertionsAfterHash: hash(JSON.stringify(repaired.assertions)),
    nonObjectFieldsBeforeHash: hash(JSON.stringify({ ...original, objects: null })),
    nonObjectFieldsAfterHash: hash(JSON.stringify({ ...repaired, objects: null })),
    preservedOriginalFiles: preservation,
    unchanged: ['All anchors', 'All vertical offsets and CENTER placements', 'All other labels', 'Canvas and fonts', 'Grid counts and phases', 'Circle/rectangle/region geometry and hatching', 'All assertions', 'No point objects or answer annotations added'],
    newAuthorImageViews: 0, newSourceViews: 0, sourceReopens: 0, crops: 0,
    cost: 'unknown',
  });
  console.log(JSON.stringify({ spec, diff, fieldChanges }, null, 2));
} else if (phase === 'seal') {
  const previous = read(`${own}/render-ready.record`);
  const diff = read(`${work}/label-repair.diff.record`);
  for (const item of diff.preservedOriginalFiles) assert.equal(bind(item.path).sha256, item.sha256);
  const maybeBind = (file) => fs.existsSync(file) ? bind(file) : null;
  const maybeRead = (file) => fs.existsSync(file) ? read(file) : null;
  const spec = bind(`${work}/fig-25.spec.json`);
  assert.equal(spec.sha256, diff.affectedSpec.sha256);
  const svg = maybeBind(`${work}/render/fig-25.svg`);
  const render = maybeBind(`${work}/render/fig-25.render.json`);
  const report = render && read(render.path);
  const capture = maybeBind(`${work}/raster/capture.record`);
  const captured = capture && read(capture.path);
  const validatorReceipt = `${own}/shell/affected-validate-spec-01/receipt.record`;
  const rendererReceipt = `${own}/shell/affected-render-spec-01/receipt.record`;
  const captureReceipt = `${own}/shell/affected-capture-native-and-640-01/receipt.record`;
  const validation = maybeRead(`${own}/shell/affected-validate-spec-01/stdout.txt`);
  const complete = validation?.status === 'pass' &&
    maybeRead(rendererReceipt)?.returncode === 0 && report?.status === 'pass' &&
    captured?.status === 'CAPTURE_COMPLETE_NOT_VISUAL_APPROVAL' &&
    Object.values(captured.closures).every(Boolean);
  const nativePng = captured?.captures.find((item) => item.name === 'native')?.png ?? null;
  const width640Preview = captured?.captures.find((item) => item.name === 'width640')?.png ?? null;
  if (report) {
    assert.equal(report.spec.sha256, spec.sha256);
    assert.equal(report.output.svg.sha256, svg.sha256);
  }
  for (const item of [nativePng, width640Preview].filter(Boolean)) assert.equal(bind(item.path).sha256, item.sha256);
  const receipts = fs.readdirSync(`${own}/shell`)
    .filter((name) => name.startsWith('affected-') && fs.existsSync(`${own}/shell/${name}/receipt.record`))
    .map((name) => {
      const root = `${own}/shell/${name}`;
      return { receipt: bind(`${root}/receipt.record`), stdout: bind(`${root}/stdout.txt`), stderr: bind(`${root}/stderr.txt`), result: read(`${root}/receipt.record`) };
    });
  const rendererInvocations = fs.existsSync(rendererReceipt) ? 1 : 0;
  const captureInvocations = fs.existsSync(captureReceipt) ? 1 : 0;
  const newFailures = receipts.filter((item) => item.result.returncode !== 0);
  const ready = write('render-ready.record', {
    schema: 'resume182-6/affected-figure-render-ready@1',
    status: complete ? 'AFFECTED_RENDER_READY_FOR_INDEPENDENT_REVIEW_NOT_FIGURE_APPROVAL' : 'HOLD_AFTER_SINGLE_AUTHORIZED_AFFECTED_ATTEMPT',
    role: 'AUTHOR_NOT_REVIEWER', createdAt: new Date().toISOString(),
    cwd: R, authorizedWriteRoot: own, affectedDirectory: work,
    book: '8a', lesson: 'alg8-c2-s2-n10', edition: 'modern-us-neutral', figure: 'fig-25',
    spec, svg, render, nativePng, width640Preview, capture,
    labelDiff: bind(`${work}/label-repair.diff.record`), changes: diff.fieldChanges,
    unchangedEvidence: {
      restoredFullSpecEqualsOriginal: diff.restoredFullSpecEqualsOriginal,
      originalCanonicalHash: diff.originalCanonicalHash, restoredCanonicalHash: diff.restoredCanonicalHash,
      untouchedObjectsBeforeHash: diff.untouchedObjectsBeforeHash, untouchedObjectsAfterHash: diff.untouchedObjectsAfterHash,
      assertionsBeforeHash: diff.assertionsBeforeHash, assertionsAfterHash: diff.assertionsAfterHash,
      nonObjectFieldsBeforeHash: diff.nonObjectFieldsBeforeHash, nonObjectFieldsAfterHash: diff.nonObjectFieldsAfterHash,
      preservedOriginalFilesCheckedAfterProduction: diff.preservedOriginalFiles,
    },
    sourceImage: previous.sourceImage, independentSourceInventory: previous.independentSourceInventory,
    preservedFirstRenderReady: bind(`${own}/render-ready.record`),
    firstIndependentReview: bind(`${reviewer}/ready.record`),
    firstVisualHold: bind(`${reviewer}/fig-25.hold.json`),
    independentReviewViewsReusedAsTextOnly: { source: 1, firstNative: 1, firstWidth640: 0, total: 2 },
    firstReviewerUnchangedGeometryConclusion: 'Reused as received HOLD context, not independently re-reviewed by the author.',
    affectedProducerEvidence: {
      validator: { receipt: maybeBind(validatorReceipt), result: validation, explicitAttempts: 1, stage: 'draft', pythonArgs: ['-B'] },
      renderer: {
        receipt: maybeBind(rendererReceipt), attempts: rendererInvocations,
        status: report?.status ?? 'NOT_RUN', collisions: report?.collisions ?? null,
        displayChecks: report?.displayChecks ?? null,
        mandatoryEmbeddedValidationAttempts: rendererInvocations,
      },
      capture: {
        receipt: maybeBind(captureReceipt), attempts: captureInvocations,
        status: captured?.status ?? 'NOT_RUN', closures: captured?.closures ?? null,
        notRunReason: !captured && report?.status === 'fail' ? 'The single affected renderer attempt failed its label-collision gate. Stop at HOLD without rasterization or another repair.' : null,
        alignmentMeasurements: captured?.captures.map(({ name, affectedLabels }) => ({ name, affectedLabels })) ?? [],
        candidateViews: 0, networkPolicy: captured?.networkPolicy ?? null,
        screenshotCalls: captured?.screenshotCalls ?? 0,
        width640MinMeasuredTextPx: captured?.captures.find((item) => item.name === 'width640')?.minMeasuredTextPx ?? null,
      },
    },
    countersThisAffectedRound: {
      contentLabelRepairs: 1, changedLabelObjects: 3, changedScalarFields: 3,
      explicitDraftValidationInvocations: 1, rendererInvocations,
      mandatoryEmbeddedDraftValidationInvocations: rendererInvocations,
      successfulRendererInvocations: report?.status === 'pass' ? 1 : 0,
      nativeRasterizations: nativePng ? 1 : 0, width640Rasterizations: width640Preview ? 1 : 0,
      screenshotCalls: captured?.screenshotCalls ?? 0,
      browserLaunches: rendererInvocations + (captured?.browserLaunches ?? 0),
      sourceViews: 0, authorCandidateViews: 0, sourceReopens: 0, sourceCrops: 0,
      paidGenerationCalls: 0, toolExecutionFailures: newFailures.length,
    },
    cumulativeAuthorCounters: {
      ...previous.counts,
      contentRepairs: previous.counts.contentRepairs + 1,
      explicitDraftValidationInvocations: previous.counts.explicitDraftValidationInvocations + 1,
      embeddedRendererDraftValidations: previous.counts.embeddedRendererDraftValidations + rendererInvocations,
      rendererInvocations: previous.counts.rendererInvocations + rendererInvocations,
      successfulRendererInvocations: previous.counts.successfulRendererInvocations + (report?.status === 'pass' ? 1 : 0),
      nativeRasterizations: previous.counts.nativeRasterizations + (nativePng ? 1 : 0),
      width640Rasterizations: previous.counts.width640Rasterizations + (width640Preview ? 1 : 0),
      screenshotCalls: previous.counts.screenshotCalls + (captured?.screenshotCalls ?? 0),
      browserLaunches: previous.counts.browserLaunches + rendererInvocations + (captured?.browserLaunches ?? 0),
      sourcePngViewsThisContinuation: 0, authorCandidateViews: 0,
      knownToolExecutionFailures: 1 + previous.preservedFailures.continuationNonzeroShellReceipts.length + newFailures.length,
    },
    historicalFailuresPreserved: previous.preservedFailures, newFailureReceipts: newFailures,
    originalIndependentHOLDPreserved: true, firstBytesOverwritten: false,
    affectedRepairBudgetUsed: 1, furtherRepairLoopAuthorized: false,
    stopReason: complete ? null : 'Affected renderer reported collisions for all three horizontally realigned labels. Their zero horizontal offsets and original 30-px vertical offsets/CENTER placement remain preserved; no threshold or geometry was changed.',
    rasterFilesProduced: Boolean(nativePng && width640Preview),
    independentFigureApproval: false, recordReviewRun: false, promoteRun: false,
    cost: 'unknown', previousCost: previous.cost,
    receipts, authorScript: bind(fileURLToPath(import.meta.url)),
    constraints: [
      'Only three horizontal label offsets changed to zero; anchors, vertical offsets and all other objects/assertions are identical.',
      'No source image/page or candidate PNG viewed. No answer/choice read or answer annotation added.',
      'No FIRST or reviewer artifact overwritten; preserved files were rehashed, not visually reopened.',
      'No SOURCE/math/TEXT re-review, DB, Plane write, chat creation, merge, deploy or push.',
      'If any affected producer stage failed, keep HOLD and do not run another repair cycle.',
      'Renderer and capture evidence are not independent figure approval.',
    ],
  });
  console.log(JSON.stringify({ ready, complete, spec, svg, render, nativePng, width640Preview, contentLabelRepairsCumulative: 1, independentFigureApproval: false }, null, 2));
} else {
  throw new Error('Expected prepare or seal.');
}
