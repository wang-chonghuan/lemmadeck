FILE .tmp/resume182-6-8a-n10-fig25-author3695-FIRST/AFFECTED-numeric-labels1/capture.mjs
import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import { createRequire } from 'node:module';
import { fileURLToPath } from 'node:url';

const R = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
const work = `${R}/.tmp/resume182-6-8a-n10-fig25-author3695-FIRST/AFFECTED-numeric-labels1`;
assert.equal(process.cwd(), R);
const bind = (path) => ({ path, sha256: crypto.createHash('sha256').update(fs.readFileSync(path)).digest('hex') });
const specPath = `${work}/fig-25.spec.json`;
const renderPath = `${work}/render/fig-25.render.json`;
const svgPath = `${work}/render/fig-25.svg`;
const spec = JSON.parse(fs.readFileSync(specPath, 'utf8'));
const render = JSON.parse(fs.readFileSync(renderPath, 'utf8'));
assert.equal(render.status, 'pass');
assert.equal(render.spec.sha256, bind(specPath).sha256);
assert.equal(render.output.svg.sha256, bind(svgPath).sha256);
const output = `${work}/raster`;
assert.equal(fs.existsSync(output), false);
fs.mkdirSync(output);
const req = createRequire(`${R}/app/package.json`);
const { chromium } = req('@playwright/test');
const targets = [
  { id: 'fig-25-v-x-four-label', origin: [10, 14], value: 4 },
  { id: 'fig-25-g-x-four-label', origin: [32, 14], value: 4 },
  { id: 'fig-25-g-x-six-label', origin: [32, 14], value: 6 },
].map((item) => ({ ...item, anchor: spec.objects.find((object) => object.id === item.id).at }));
const record = {
  schema: 'resume182-6/affected-author-rasterization@1',
  status: 'STARTED', role: 'AUTHOR_NOT_REVIEWER', repair: 'AFFECTED-numeric-labels1',
  sourceSvg: bind(svgPath), spec: bind(specPath), render: bind(renderPath),
  captureScript: bind(fileURLToPath(import.meta.url)),
  runtime: { package: req.resolve('@playwright/test'), executablePath: chromium.executablePath() },
  networkPolicy: 'abort all requests', browserLaunches: 0, contexts: 0, pages: 0,
  screenshotCalls: 0, contentLoads: 0, captures: [], abortedRequests: 0,
  closures: { page: false, context: false, browser: false }, closureErrors: [],
  sourceViews: 0, candidateViews: 0, resizes: 0, crops: 0,
  visualApproval: 'NOT_RUN', cost: 'unknown',
};
let browser;
let context;
let page;
let failure;
try {
  record.browserLaunches++;
  browser = await chromium.launch({ headless: true, executablePath: chromium.executablePath() });
  record.contexts++;
  context = await browser.newContext({ viewport: { width: spec.canvas.width, height: spec.canvas.height }, deviceScaleFactor: 1, serviceWorkers: 'block' });
  await context.route('**/*', (route) => { record.abortedRequests++; return route.abort(); });
  record.pages++;
  page = await context.newPage();
  for (const [name, width] of [['native', spec.canvas.width], ['width640', 640]]) {
    const cssHeight = width * spec.canvas.height / spec.canvas.width;
    const height = Math.ceil(cssHeight);
    await page.setViewportSize({ width, height });
    record.contentLoads++;
    await page.setContent(`<!doctype html><html><head><meta charset="utf-8"><style>
      :root { --ld-figure-ink:#15201f; --ld-figure-muted:#4c5a58; --ld-figure-accent:#15201f; --ld-figure-accent-soft:#8a9795; --ld-figure-grid:#e3eae9; --ld-figure-paper:#ffffff; }
      html,body { margin:0; width:${width}px; height:${height}px; overflow:hidden; background:#ffffff; }
      svg { display:block; width:${width}px; height:${cssHeight}px; }
      </style></head><body>${fs.readFileSync(svgPath, 'utf8')}</body></html>`, { waitUntil: 'load' });
    await page.evaluate(() => document.fonts.ready);
    const observation = await page.evaluate(({ targets, canvas }) => {
      const svg = document.querySelector('svg');
      const matrix = svg.getScreenCTM();
      const box = svg.getBoundingClientRect();
      const toScreen = ([x, y]) => new DOMPoint(
        (x - canvas.boundingBox[0]) * canvas.width / (canvas.boundingBox[2] - canvas.boundingBox[0]),
        (canvas.boundingBox[1] - y) * canvas.height / (canvas.boundingBox[1] - canvas.boundingBox[3]),
      ).matrixTransform(matrix);
      const labels = [...svg.querySelectorAll('text')].map((node) => {
        const rect = node.getBoundingClientRect();
        return { id: node.getAttribute('data-label-id'), text: node.textContent, centerX: rect.x + rect.width / 2, fontPx: Number.parseFloat(node.getAttribute('font-size')) * Math.hypot(matrix.a, matrix.b) };
      });
      const affectedLabels = targets.map((target) => {
        const label = labels.find((item) => item.id === `${target.id}-label`);
        const anchor = toScreen(target.anchor);
        const origin = toScreen(target.origin);
        const unit = toScreen([target.origin[0] + 1, target.origin[1]]).x - origin.x;
        return {
          id: target.id, text: label.text, expectedGridAbscissa: target.value,
          actualDisplayedGridAbscissa: (label.centerX - origin.x) / unit,
          textCenterPx: label.centerX, anchorScreenX: anchor.x,
          horizontalAlignmentErrorPx: label.centerX - anchor.x,
        };
      });
      return { width: box.width, height: box.height, devicePixelRatio, minTextPx: Math.min(...labels.map((label) => label.fontPx)), labelCount: labels.length, affectedLabels };
    }, { targets, canvas: spec.canvas });
    assert.equal(observation.width, width);
    assert.ok(Math.abs(observation.height - cssHeight) < 0.03);
    assert.equal(observation.devicePixelRatio, 1);
    assert.equal(observation.labelCount, 28);
    assert.ok(observation.minTextPx >= 16);
    assert.ok(observation.affectedLabels.every((item) => Math.abs(item.horizontalAlignmentErrorPx) < 0.03 && Math.abs(item.actualDisplayedGridAbscissa - item.expectedGridAbscissa) < 0.003));
    const pngPath = `${output}/fig-25.${name}.png`;
    assert.equal(fs.existsSync(pngPath), false);
    record.screenshotCalls++;
    await page.screenshot({ path: pngPath, type: 'png', fullPage: false, animations: 'disabled' });
    const bytes = fs.readFileSync(pngPath);
    assert.equal(bytes.readUInt32BE(16), width);
    assert.equal(bytes.readUInt32BE(20), height);
    record.captures.push({
      name, png: { ...bind(pngPath), width, height },
      cssHeight, deviceScaleFactor: 1,
      minMeasuredTextPx: observation.minTextPx, affectedLabels: observation.affectedLabels,
      method: 'Direct affected SVG rasterization at native or CSS640; not an existing PNG resize.',
    });
  }
  record.status = 'CAPTURE_COMPLETE_NOT_VISUAL_APPROVAL';
} catch (error) {
  failure = error; record.status = 'CAPTURE_FAILED'; record.error = error.message;
} finally {
  for (const [name, resource] of [['page', page], ['context', context], ['browser', browser]]) {
    if (!resource) continue;
    try { await resource.close(); record.closures[name] = true; }
    catch (error) { record.closureErrors.push({ resource: name, error: error.message }); failure ??= error; }
  }
  const file = `${output}/capture.record`;
  fs.writeFileSync(file, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
  console.log(JSON.stringify({ capture: bind(file), status: record.status, captures: record.captures, closures: record.closures }, null, 2));
}
if (failure) throw failure;

