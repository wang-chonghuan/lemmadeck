          x: Math.min(topLeft[0], bottomRight[0]),
          y: Math.min(topLeft[1], bottomRight[1]),
          width: Math.abs(bottomRight[0] - topLeft[0]),
          height: Math.abs(bottomRight[1] - topLeft[1]),
