  "exercises": [
    {
      "number": "218",
      "text": "218. \u5199\u51fa\u4e0b\u5217\u6570\u5217\u7684\u524d\u51e0\u9879. \u5df2\u77e5\uff1a\na) \u7b2c1\u9879\u7b49\u4e8e4\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u662f\u901a\u8fc7\u628a\u5b83\u7684\u524d\u9762\u4e00\u9879\u52a0\u4e0a12\u5f97\u51fa\uff1b\nb) \u7b2c1\u9879\u7b49\u4e8e8\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u662f\u901a\u8fc7\u628a\u5b83\u7684\u524d\u9762\u4e00\u9879\u4e58\u4ee53\u5f97\u51fa\uff1b\nc) \u6570\u5217\u7684\u7b2c1\u9879\u7b49\u4e8e10\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u662f\u901a\u8fc7\u628a\u5b83\u7684\u524d\u9762\u4e00\u9879\u9664\u4ee52\u5f97\u51fa\uff1b\nd) \u7b2c1\u9879\u7b49\u4e8e1\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u662f\u901a\u8fc7\u7528\u6240\u6c42\u9879\u7684\u5e8f\u53f7\u53bb\u9664\u5b83\u7684\u524d\u9762\u4e00\u9879\u5f97\u51fa.",
      "figure_ids": []
    },
    {
      "number": "219",
      "text": "219. \u6c42\u51fa\u7528\u9012\u63a8\u6cd5\u7ed9\u51fa\u7684\u6570\u5217$(a_n)$\u7684\u524d5\u9879\uff1a\na) $a_1=1,\\quad a_{n+1}=a_n+1$\uff1b\nb) $a_1=7,\\quad a_{n+1}=a_n-3$\uff1b\nc) $a_1=-5,\\quad a_{n+1}=2a_n$\uff1b\nd) $a_1=75,\\quad a_{n+1}=0.1a_n$\uff1b\ne) $a_1=\\frac{1}{6},a_{n+1}=-a_n$\uff1b\nf) $a_1=3,\\quad a_{n+1}=\\frac{1}{a_n}$.",
      "figure_ids": []
    },
    {
      "number": "220",
      "text": "220. \u5199\u51fa\u6570\u5217$(c_n)$\u7684\u524d\u51e0\u9879\uff0c\u8bbe\uff1a\na) $c_1=-1,\\quad c_2=1,\\quad c_{n+2}=c_n+c_{n+1}$\uff1b\nb) $c_1=13,\\quad c_2=6,\\quad c_{n+2}=c_n-c_{n+1}$.",
      "figure_ids": []
    },
    {
      "number": "221",
      "text": "221. \u5199\u51fa\u6570\u5217$(u_n)$\u7684\u524d\u51e0\u9879\u5e76\u4e14\u7528\u901a\u9879\u516c\u5f0f\u7ed9\u51fa\u8fd9\u4e2a\u6570\u5217\uff0c\u8bbe\uff1a\na) $u_1=10,\\quad u_{n+1}=u_n+10$\uff1b\nb) $u_1=10,\\quad u_{n+1}=u_n\\cdot10$\uff1b\nc) $u_1=2,\\quad u_{n+1}=u_n+2$\uff1b\nd) $u_1=2,\\quad u_{n+1}=u_n\\cdot2$.",
      "figure_ids": []
    },
    {
      "number": "222",
      "text": "222. \u89e3\u4e0b\u5217\u65b9\u7a0b\u7ec4\uff1a\na) $\\begin{cases}x^2-2y^2=14,\\\\2x-3y=1\\end{cases}$\uff1b\nb) $\\begin{cases}3xy-2y^2=30,\\\\3x-2y=10\\end{cases}$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 7,
      "text": "\u4ece\u6570\u5217\u7684\u67d0\u4e00\u9879\u8d77\uff0c\u901a\u8fc7\u524d\u9762\u7684\u9879\uff08\u4e00\u9879\u6216\u51e0\u9879\uff09\u8868\u793a\u6570\u5217\u4efb\u4f55\u4e00\u9879\u7684\u516c\u5f0f\u53eb\u505a\u9012\u63a8\u516c\u5f0f."
    },
    {
      "block": 8,
      "text": "\u5728\u7ed9\u51fa\u6570\u5217\u7684\u9012\u63a8\u6cd5\u4e2d\uff0c\u901a\u5e38\u6307\u51fa\uff1a"
    },
    {
      "block": 9,
      "text": "a) \u6570\u5217\u7684\u7b2c1\u9879\uff08\u6216\u524d\u51e0\u9879\uff09\uff0c"
    },
    {
      "block": 10,
      "text": "b) \u6839\u636e\u5df2\u77e5\u7684\u524d\u9762\u7684\u9879\u80fd\u591f\u786e\u5b9a\u6570\u5217\u7684\u4efb\u4f55\u4e00\u9879\u7684\u516c\u5f0f."
    }
  ],
