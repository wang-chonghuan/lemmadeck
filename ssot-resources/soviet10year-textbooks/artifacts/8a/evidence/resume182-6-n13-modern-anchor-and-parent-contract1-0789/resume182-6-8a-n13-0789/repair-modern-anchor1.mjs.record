import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/resume182-6-8a-n13-0789';
const target = `${base}/modern-FIRST/adapt/8a/modern-us-neutral/lessons/alg8-c3-s1-n13/lesson.template.json`;
const retentionFile = 'ssot-resources/soviet10year-textbooks/artifacts/8a/evidence/resume182-6-n13-modern-text-revise-first-0789/retention.record';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const entry = file => ({ path: path.resolve(file), sha256: sha(fs.readFileSync(file)),
  bytes: fs.statSync(file).size });
const retained = JSON.parse(fs.readFileSync(retentionFile)).entries.find(item =>
  item.sha256 === '191b06dfa3598cac089c2b27f192826d3a3f58b028b029e60499753c9a42ae61');
assert.ok(retained);
assert.equal(entry(retained.path).sha256, retained.sha256);
const original = JSON.parse(fs.readFileSync(retained.path));
const lesson = JSON.parse(fs.readFileSync(target));
const expected = structuredClone(original);
expected.prose[6].text = expected.prose[6].text.replace('$b_5=3+5=8$\uff0c', '$b_5=3+5=8$\uff0c\n');
assert.deepEqual(lesson, expected, 'Only the independently identified newline was edited');
const directory = `${base}/modern-anchor-norm1`;
assert.ok(!fs.existsSync(directory));
fs.mkdirSync(directory);
const input = `${directory}/lesson-flow-input.record`;
fs.writeFileSync(input, `${JSON.stringify({ ...lesson, section_breaks: [] }, null, 2)}\n`, { flag: 'wx' });
const result = spawnSync('node', ['.claude/skills/ld-s10y-lesson/tools/prose_flow.mjs', input],
  { cwd: repo, encoding: 'utf8' });
for (const name of ['stdout', 'stderr']) {
  fs.writeFileSync(`${directory}/native-flow-${name}.record`, result[name] ?? '', { flag: 'wx' });
}
assert.equal(result.status, 0);
assert.equal(result.stderr, '');
const selected = result.stdout.split('\n').map(line => line.trim())
  .filter(line => line.startsWith('break: ')).map(line => JSON.parse(line.slice(7)))
  .filter(item => item.after.startsWith('\u4ece\u6570\u5217\u7684\u67d0\u4e00\u9879\u8d77') ||
    item.after.startsWith('\u4e0b\u9762\uff0c\u6211\u4eec\u518d\u4e3e\u51fa'));
assert.equal(selected.length, 2);
assert.deepEqual(selected[1], original.section_breaks[1]);
assert.equal(selected[0].after, original.section_breaks[0].after);
assert.equal(selected[0].before, lesson.prose[6].text);
lesson.section_breaks = selected;
fs.writeFileSync(target, `${JSON.stringify(lesson, null, 2)}\n`);
const output = `${directory}/result.record`;
fs.writeFileSync(output, `${JSON.stringify({
  status: 'AFFECTED_MODERN_NEWLINE_AND_NATIVE_ANCHOR_BOUND_NOT_APPROVED',
  book: '8a', lesson: 'alg8-c3-s1-n13', edition: 'modern-us-neutral',
  first: { ...entry(retained.path), historical_path: path.resolve(target) },
  current: entry(target), nativeFlowInput: entry(input),
  nativeFlowStdout: entry(`${directory}/native-flow-stdout.record`),
  changed: ['prose[6].text newline only', 'section_breaks[0].before same native newline'],
  selected, otherPayloadChanged: false, formulasChanged: false,
  newImageViews: 0, sourceApprovalReruns: 0, databaseWrites: 0, finish: 'review',
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(entry(output)));
