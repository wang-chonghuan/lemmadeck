      originalDeclaredRemainingContentRepairBudget: ready.originalDeclaredRemainingContentRepairBudget,
      cleanup: ready.cleanup,
    },
    combinedKnownRenderCalls: chromium.imageAccounting.combinedKnownRenderCalls + ready.rendererCalls,
    combinedKnownNativeRasterCalls: chromium.imageAccounting.combinedKnownNativeRasterCalls + ready.technicalNativeRasterCalls,
    newRenderCallsThisReviewer: 0,
    newNativeRasterCallsThisReviewer: 0,
    newBrowserCallsThisReviewer: 0,
    newIndependentValidatorCallsThisReviewer: 0,
    newContentRepairsThisReviewer: 0,
    officialRecorderCallsThisReviewer: 1,
