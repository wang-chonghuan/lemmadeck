    answerChoicesObservedThisReviewer: 0,
    answerOrChoiceActionsThisReviewer: 0,
    DBWritesThisReviewer: 0,
    gitActionsThisReviewer: 0,
    progressActionsThisReviewer: 0,
    otherChatActionsThisReviewer: 0,
    promotionsThisReviewer: 0,
    paidCallsThisReviewer: 0,
    crossChatImageHistory: "unknown; not loaded",
    hostTokens: "unknown",
    totalCost: "unknown",
  },
  officialRecorderCalledOnce: true,
  nominalFontSizeUsedAsVisualPassEvidence: false,
  rendererPassUsedAsPixelEvidence: false,
  observationsSealedBeforeReadyAndDiffRead: true,
  commandCaptures,
  commandCapturePolicy: {
    stdoutStderrExitSavedBeforeDisplayForLoggedCommands: true,
    root: output,
    finalizationCommandCapture: path.join(output, "finalize.command.record"),
    finalIdentityCommandCapture: path.join(output, "final-identities.command.record"),
    initialInstructionReadCaptureGap: "The first three read-only instruction commands (image skill, intentfold readme, engineering charter) returned exec tool stdout with exit 0 before the on-disk logger was created. Those original outputs were not persisted to disk before display; no claim of complete pre-persisted capture is made. Every subsequent shell command uses the on-disk logger, including the single official recorder invocation.",
  },
  scope: "Only the newly repaired fig-15 y-label layout and absence of new visible endpoint/subscript obstruction. No source image, old preview, fig-14/text PASS action, solving, answer/choice, DB, git, progress, other chat, asset promotion, manual SVG edit, or additional renderer/browser/raster/independent-validator run.",
  writeSet: `${output}/`,
  wholeLessonApproval: false,
};
const target = path.join(output, "review.record");
fs.writeFileSync(target, `${JSON.stringify(record, null, 2)}\n`, { flag: "wx" });
console.log(JSON.stringify({
  status: record.status,
  conclusion: record.conclusion,
  reviewRecord: reference(target),
  officialReview: officialRef,
  observations: binding.observations,
  binding: bindingRef,
  combinedKnownRenderCalls: record.imageAccounting.combinedKnownRenderCalls,
  combinedKnownNativeRasterCalls: record.imageAccounting.combinedKnownNativeRasterCalls,
  wholeLessonApproval: false,
}, null, 2));
