    {
      "question_id": "q15",
      "source_numbers": ["291"],
      "mode": "single",
      "independent_solution": "With B_0=1000 USD, one annual capitalization multiplies the balance by 1.02. After four full years B_4=1000*(1.02)^4=1082.43216 USD exactly. A final cents representation would be 1082.43 USD, but the visible question asks for the exact amount, so the formula is sufficient.",
      "correct": ["c"],
      "option_checks": [
        {"option_id": "a", "truth": "incorrect", "evidence": "1000*(1+4*0.02)=1080 USD is simple interest, not the stipulated annual capitalization total 1082.43216 USD."},
        {"option_id": "b", "truth": "incorrect", "evidence": "1000*(1.02)^5=1104.0808032 USD counts five postings rather than four."},
        {"option_id": "c", "truth": "correct", "evidence": "1000*(1.02)^4 counts exactly four capitalized annual increases and denotes the full exact balance in USD."},
        {"option_id": "d", "truth": "incorrect", "evidence": "1000*(1.02)^3=1061.208 USD is the balance after only three years, not four."}
      ],
      "visible_mathematics": "determinate"
