        {"option_id": "b", "truth": "incorrect", "evidence": "524288=2^19 is one doubling too early. Twenty elapsed intervals require exponent 20, not 19."},
        {"option_id": "c", "truth": "incorrect", "evidence": "40=2*20 is linear multiplication of the factor by the interval count, not repeated doubling of the current population."},
        {"option_id": "d", "truth": "correct", "evidence": "1048576=2^20 is the total obtained from one bacterium after all twenty half-hour doublings."}
      ],
      "visible_mathematics": "determinate"
