    {
      "question_id": "q17",
      "source_numbers": ["293"],
      "mode": "single",
      "independent_solution": "The initial volume is 20*10^4=200000 m^3. Six annual 10% increases give 200000*(1.1)^6=200000*1.771561=354312.2 m^3.",
