xpected=Array.from({length:20},(_,i)=>String(278+i));assert.deepEqual(m.value.source_coverage.map(c=>c.source_number),expected);for(const c of m.value.source_coverage){assert.deepEqual(c.question_ids,v.value.questions.filter(q=>q.source_numbers.includes(c.source_number)).map(q=>q.id));assert.deepEqual(c.essential_omitted_tasks,[]);assert.ok(c.coverage.length>30);assert.ok(c.production_losses.length>0);}assert.deepEqual(m.value.visible_findings.defects,[]);assert.deepEqual(m.value.visible_findings.blockers,[]);console.log(JSON.stringify({verification:\"Owned-record checks only; all 21 identities, 84 option checks and 20 source-coverage identities bound; phase1 unchanged\",records:[{path:process.cwd()+\"/\"+root+\"phase2-fidelity.record\",sha256:f.sha,status:f.value.status},{path:process.cwd()+\"/\"+root+\"phase2-visible.record\",sha256:m.sha,status:m.value.status}],defects:[],blockers:[],phase3_not_started:true},null,2));",
