    {
      "source_number": "109",
      "group": null,
      "source_pages": ["p0052#6", "p0053#1"],
      "status": "ORIGINAL_MATH_SUPPORT_COMPLETE",
      "source_method_expectation": "Model the actual changes to each side and distinguish algebraic solutions from permitted length reductions/increases.",
      "parts": [
        {
