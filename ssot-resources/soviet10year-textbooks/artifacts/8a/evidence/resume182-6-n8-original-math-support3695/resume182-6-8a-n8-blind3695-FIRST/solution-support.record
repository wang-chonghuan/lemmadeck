      "status": "ORIGINAL_MATH_SUPPORT_COMPLETE",
      "source_method_expectation": "Test both displayed pairs and also prove the unlettered general swap statement.",
      "parts": [
        {
          "part": "а",
          "original_conditions": ["Determine whether (5,1) satisfies x^2+3*x*y+y^2=41."],
          "domain": "Real pair (x,y)=(5,1).",
          "method": ["Substitution gives 5^2+3*5*1+1^2=25+15+1=41."],
          "tested_point": ["5", "1"],
          "evaluated_lhs": "41",
          "is_solution": true,
          "result": "Yes.",
          "limitations": []
        },
        {
          "part": "б",
          "original_conditions": ["Determine whether (1,5) satisfies x^2+3*x*y+y^2=41."],
          "domain": "Real pair (x,y)=(1,5).",
          "method": ["Substitution gives 1^2+3*1*5+5^2=1+15+25=41."],
          "tested_point": ["1", "5"],
          "evaluated_lhs": "41",
          "is_solution": true,
          "result": "Yes.",
          "limitations": []
        }
      ],
      "additional_obligations": [
        {
          "identity": "unlettered-swap-proof",
          "original_conditions": "Prove that if (a,b) is a solution of x^2+3*x*y+y^2=41 then (b,a) is also a solution.",
          "domain": "a,b in R.",
          "scope": "all real a,b satisfying the equation",
          "proof": "Assume a^2+3*a*b+b^2=41. For the swapped pair the left side is b^2+3*b*a+a^2. By commutativity of real multiplication b*a=a*b, and by commutativity of addition b^2+3*a*b+a^2=a^2+3*a*b+b^2=41. Thus (b,a) satisfies the same equation.",
          "proof_status": "COMPLETE_WRITTEN_ELEMENTARY_PROOF",
          "method": "Symmetry under exchange of x and y; proof covers arbitrary real a,b, not only the two tested examples.",
          "limitations": ["The proof is independently written from the isolated condition; no raw-lesson/source review or broader content approval is asserted."]
        }
      ]
    },
    {
