import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const target = '.tmp/resume182-6-8a-n10-display3695-FIRST';
const source = '.tmp/resume182-6-8a-n8-display3695-FIRST/ready-FIRST.record';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const read = file => fs.readFileSync(file);
const json = file => JSON.parse(read(file));
const bind = file => ({ path: path.resolve(file), sha256: sha(read(file)),
  bytes: read(file).length });
const previous = json(source);
const codeFile = `${target}/code-prepared.record`;
const code = json(codeFile);
assert.equal(code.status, 'CODE_PREPARED_NOT_CONTENT_READY');
assert.equal(code.lesson, 'alg8-c2-s2-n10');
assert.equal(code.entries.length, 3);
assert.ok(!fs.existsSync(`${target}/ready-FIRST.record`));
const files = [], syntax = [];
for (const entry of code.entries) {
  const file = bind(entry.output);
  assert.equal(file.sha256, entry.sha256);
  assert.equal(sha(read(entry.input)), entry.inputSha256);
  const receipt = `${entry.output}.syntax.record`;
  assert.equal(json(receipt).returncode, 0);
  files.push(file);
  syntax.push({ name: path.basename(entry.output), invocations: 0,
    status: 'REUSE_CURRENT_CODE_PREPARATION_SYNTAX', evidence: bind(receipt) });
}
for (const pin of previous.pins) {
  assert.equal(fs.realpathSync(pin.path), pin.realpath);
  assert.equal(sha(read(pin.path)), pin.sha256);
}
const value = {
  schema: 'n10-display-preparation@1',
  status: 'SCRIPTS_PREPARED_RUNTIME_NOT_EXECUTED', workdir: repo,
  runtimeAuthorized: false,
  scope: { ticket: 'STEMROBIN-182', root: repo, book: '8a',
    edition: 'modern-us-neutral', lesson: 'alg8-c2-s2-n10',
    owned: path.resolve(target) },
  files, pins: previous.pins,
  requiredFigures: ['fig-22', 'fig-23', 'fig-24', 'fig-25'],
  requiredFigureAssets: ['svg', 'spec.json', 'render.json', 'review.json'],
  expectedParentSchema: 'n10-parent-display-ready@1', rendererBudget: 1,
  viewports: previous.viewports, surfaces: previous.surfaces, syntax,
  transformations: bind(codeFile),
  usage: { local: Object.fromEntries(Object.keys(previous.usage.local)
    .map(key => [key, 0])), cumulative: Object.fromEntries(
    Object.keys(previous.usage.local).map(key => [key, null])) },
  runtime: 0, parentREADY: { produced: false, consumed: false },
  sourcePreparationEvidence: bind(source), newSyntaxCalls: 0,
  contentReadinessChecks: 0, sourceModernAnswerChoiceFigureReads: 0,
  rendererCalls: 0, browserCalls: 0, imageViews: 0, DBWrites: 0,
  unknownHistoricalBytesRecovered: false, hostTokens: 'unknown',
  totalCost: 'unknown', finish: 'review',
};
fs.writeFileSync(`${target}/ready-FIRST.record`, `${JSON.stringify(value, null, 2)}\n`,
  { flag: 'wx' });
console.log(JSON.stringify(bind(`${target}/ready-FIRST.record`)));
