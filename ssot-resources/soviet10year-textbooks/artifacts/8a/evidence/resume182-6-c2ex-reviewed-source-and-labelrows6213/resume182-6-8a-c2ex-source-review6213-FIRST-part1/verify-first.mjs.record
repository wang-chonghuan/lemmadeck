const inputHashes = new Map();
function read(file, mode = "text") {
  const bytes = fs.readFileSync(file);
  inputHashes.set(path.resolve(file), crypto.createHash("sha256").update(bytes).digest("hex"));
  return mode === "bytes" ? bytes : mode === "json" ? JSON.parse(bytes.toString("utf8")) : bytes.toString("utf8");
}
function hash(file) {
  read(file, "bytes");
  return inputHashes.get(path.resolve(file));
}
function blocks(md) {
  const lines = md.split("\n");
  const frontEnd = lines.indexOf("---", 1);
  assert(frontEnd > 0);
  const meta = JSON.parse(lines.slice(1, frontEnd).join("\n"));
  const result = [];
  for (let i = frontEnd + 1; i < lines.length; i++) {
    const match = lines[i].match(/^<!-- (.*?) -->$/);
    if (match) {
      result.push({ header: match[1], line: i + 1, rows: [] });
    } else if (lines[i].trim()) {
      assert(result.length);
      result.at(-1).rows.push({ line: i + 1, text: lines[i] });
    }
  }
  return { meta, blocks: result };
}
function diff(a, b, at = "") {
  if (JSON.stringify(a) === JSON.stringify(b)) return [];
  if (a && b && typeof a === "object" && typeof b === "object") {
    return [...new Set([...Object.keys(a), ...Object.keys(b)])]
      .flatMap(key => diff(a[key], b[key], `${at}/${key}`));
  }
  return [{ path: at, before: a, after: b }];
}

