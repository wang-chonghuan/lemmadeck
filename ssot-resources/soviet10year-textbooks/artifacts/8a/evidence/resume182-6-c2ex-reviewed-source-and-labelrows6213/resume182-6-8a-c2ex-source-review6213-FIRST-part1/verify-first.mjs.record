const occurrences = [];
const pages = ready.pages.map((entry, i) => {
  const page = String(entry.physical_page).padStart(4, "0");
  const candidatePath = `${author}/pages/${page}/page.md`;
  const candidate = blocks(read(candidatePath));
  const candidateSha = inputHashes.get(path.resolve(candidatePath));
  assert.equal(candidateSha, entry.output_sha256);
  const imagePath = `${prepared}/${page}/page.png`;
  const png = read(imagePath, "bytes");
  const imageSha = inputHashes.get(path.resolve(imagePath));
  assert.equal(imageSha, originalShas[i]);
  assert.equal(imageSha, candidate.meta.render.sha256);
  assert.equal(png.readUInt32BE(16), candidate.meta.render.w);
  assert.equal(png.readUInt32BE(20), candidate.meta.render.h);
  const layoutPath = `${prepared}/${page}/layout.json`;
  const layout = read(layoutPath, "json");
  assert.equal(inputHashes.get(path.resolve(layoutPath)), entry.layout_sha256);
  assert.equal(candidate.meta.book, "8a");
  assert.equal(candidate.meta.page, 64 + i);
  assert.equal(candidate.meta.printed_page, 57 + i);
  const represented = candidate.blocks.reduce((n, b) =>
    n + b.rows.reduce((s, r) => s + r.text.split("\u21b5").length, 0), 0);
  assert.equal(represented, physicalRows[i]);
  assert.equal(Object.values(groups[i]).reduce((a, b) => a + b), physicalRows[i]);
  for (const block of candidate.blocks) {
    const ex = block.header.match(/^ex (\d+)(?: (cont|open))?$/);
    if (ex) occurrences.push({ identity: Number(ex[1]), page, flag: ex[2] ?? "complete" });
    for (const row of block.rows) {
      assert.equal((row.text.match(/\$/g) ?? []).length % 2, 0);
      assert(!/(?:^|[;； ]+)[abe]\)/.test(row.text));
    }
  }
  return {
    physical_page: 64 + i,
    printed_page: 57 + i,
    status: [65, 70, 71].includes(64 + i) ? "HOLD" : "PASS",
    image: path.resolve(imagePath),
    image_sha256: imageSha,
    source_png_dimensions: [png.readUInt32BE(16), png.readUInt32BE(20)],
    candidate: path.resolve(candidatePath),
    candidate_sha256: candidateSha,
    layout: path.resolve(layoutPath),
    layout_sha256: inputHashes.get(path.resolve(layoutPath)),
    source_view_count: 1,
    reopens: 0,
    independent_physical_rows: physicalRows[i],
    independent_row_groups: groups[i],
    candidate_represented_rows_actual: represented,
    prepared_band_count_actual: layout.line_bands.length,
    actual_visual_check: {
      all_outside_figure_printed_rows_compared: true,
      printed_text_numbers_math_symbols_sublabels_match: true,
      source_text_correction_observed: false,
      block_classification_matches: ![65, 70].includes(64 + i),
      source_figure_details_fully_certified: i === 7 ? false : null,
      inventory_and_row_line_mapping: `${path.resolve(output)}/review.md#physical-${page}`,
    },
    source_figures: i === 7 ? [{ number: 26, subfigures: ["\u0430)", "\u0431)"], referenced_by: 177, coarse_box: [310, 2270, 1740, 590], exact_dimensions_certified: false }] : [],
    candidate_blocks: candidate.blocks.map(b => ({
      header: b.header, line: b.line,
      candidate_text_lines: b.rows.map(r => r.line),
      physical_rows_represented: b.rows.reduce((n, r) => n + r.text.split("\u21b5").length, 0),
    })),
  };
});
const identities = [...new Set(occurrences.map(x => x.identity))].sort((a, b) => a - b);
assert.deepEqual(identities, Array.from({ length: 41 }, (_, i) => i + 138));
assert.deepEqual(occurrences.filter(x => x.flag === "cont").map(x => x.identity), [138, 144, 151, 154, 164, 166, 170]);
assert.deepEqual(occurrences.filter(x => x.flag === "open").map(x => x.identity), [144, 151, 154, 164, 166, 170, 178]);

