    sha256: inputs.get(path.resolve(`${deltaRoot}/receipt.record`)),
    returncode: receipt.returncode,
    stdout_path: path.resolve(`${deltaRoot}/stdout.txt`),
    stdout_sha256: inputs.get(path.resolve(`${deltaRoot}/stdout.txt`)),
    declarations_compared_with_actual_files: true,
    note: "Producer delta receipt checks p65 JSON and both pre-finalize MD bodies. This independent follow-up also checks current p70 FIRST-finalized JSON against immutable source blocks and explicitly accounts for generated frontmatter additions.",
  },
  before_hash_checks: beforeHashChecks,
  pages,
  same_book_patterns: patterns,
  boundary0063: {
    status: "PASS",
    first_affected_only_review_reused: true,
    old_pass_not_refinalized_or_reaudited: true,
    original_differences: first.boundary_metadata_review.actual_json_differences,
    current_files: currentBoundary,
    source_text_and_indices_unchanged: true,
    image_views: 0,
  },
  classification: {
    status: "PASS",
    supplement_count: 1,
    supplement_title: "第二章补充习题",
    toc_id: "alg8-c2-ex",
    toc_printed_page: 56,
    toc_sha256: tocEntry.sha256,
    subsection7_8_9_kind: "exhead",
    new_numbered_units_created_by_repaired_headers: 0,
    unchanged_n10_hash_only: unchangedN10,
    whole_lesson_assembly_or_delivery_performed: false,
  },
  input_files: [...inputs].map(([file, sha256]) => ({ path: file, sha256 })),
  constraints: {
    writes_outside_reviewer_root: 0, git_db_cloud_operations: 0,
    worktrees_attachments_new_chats_old_reviewer_resumes: 0,
    source_finalization_or_image_reviews_rerun: 0,
    solutions_keys_or_modern_artifact_content_read: 0,
    modern_n10_files_hash_only: 2,
    others_changes_reverted: 0,
  },
  self_sha256: "Reported externally, not recursively embedded.",
};
const recordPath = `${out}/metadata-only.record`;
fs.writeFileSync(recordPath, `${JSON.stringify(result, null, 2)}\n`, { flag: "wx" });
assert.equal(hash(firstPath), firstSha);
console.log(JSON.stringify({
  status: result.status,
  record: path.resolve(recordPath),
  sha256: hash(recordPath),
  original_first_ready_sha256_unchanged: firstSha,
  pages: pages.map(p => ({ page: p.physical_page, status: p.status, md_sha256: p.working_md_sha256, json_sha256: p.working_json_sha256 })),
