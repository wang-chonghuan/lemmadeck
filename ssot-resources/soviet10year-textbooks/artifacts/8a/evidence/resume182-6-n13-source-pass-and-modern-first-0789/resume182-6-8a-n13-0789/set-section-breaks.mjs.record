import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { createRequire } from 'node:module';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/resume182-6-8a-n13-0789';
const file = `${base}/modern-FIRST/adapt/8a/modern-us-neutral/lessons/alg8-c3-s1-n13/lesson.template.json`;
const stdout = `${base}/stages/modern-prose-flow-FIRST/stdout.txt`;
const entry = file => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), bytes: bytes.length,
    sha256: crypto.createHash('sha256').update(bytes).digest('hex') };
};
const before = entry(file);
const lesson = JSON.parse(fs.readFileSync(file));
assert.deepEqual(lesson.section_breaks, []);
const boundaries = fs.readFileSync(stdout, 'utf8').split('\n')
  .map(line => line.trim()).filter(line => line.startsWith('break: '))
  .map(line => JSON.parse(line.slice('break: '.length)));
const selected = boundaries.filter(item =>
  item.after.startsWith('\u4ece\u6570\u5217\u7684\u67d0\u4e00\u9879\u8d77') ||
  item.after.startsWith('\u4e0b\u9762\uff0c\u6211\u4eec\u518d\u4e3e\u51fa'));
assert.equal(selected.length, 2);
lesson.section_breaks = selected;
const require = createRequire(path.resolve('.claude/skills/ld-s10y-lesson/tools/htmlfrag.js'));
assert.equal(require('./htmlfrag.js').proseFlow(lesson.prose, selected)
  .filter(item => item.sectionBreak).length, 2);
fs.writeFileSync(file, `${JSON.stringify(lesson, null, 2)}\n`);
const output = `${base}/modern-author-FIRST/section-breaks.record`;
fs.writeFileSync(output, `${JSON.stringify({
  status: 'ACTUAL_PROSE_FLOW_BOUNDARIES_AUTHORED_NOT_APPROVED',
  book: '8a', lesson: 'alg8-c3-s1-n13', edition: 'modern-us-neutral',
  before, after: entry(file), nativeOutput: entry(stdout), selected,
  manualParagraphIndices: false, sourceChanges: 0, imageViews: 0,
  databaseWrites: 0, finish: 'review',
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(entry(output)));
