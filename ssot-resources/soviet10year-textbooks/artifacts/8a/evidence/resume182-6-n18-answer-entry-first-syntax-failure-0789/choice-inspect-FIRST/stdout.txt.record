  "concept_candidates": [
    {
      "block": 0,
      "text": "\u77e5\u9053\u7b49\u6bd4\u6570\u5217$(b_n)$\u7684\u7b2c1\u9879$b_1$\u4e0e\u516c\u6bd4$q$\u540e\uff0c\u901a\u8fc7\u9010\u6b21\u8ba1\u7b97\uff0c\u53ef\u4ee5\u6c42\u51fa\u5b83\u7684\u7b2c2\u9879\u3001\u7b2c3\u9879\u4ee5\u53ca\u4e00\u822c\u8bf4\u6765\u4efb\u4f55\u4e00\u9879. \u4f46\u662f\uff0c\u5bfb\u6c42\u5e8f\u53f7\u8db3\u591f\u5927\u7684\u9879\u65f6\uff0c\u5229\u7528\u516c\u5f0f\u6bd4\u8f83\u65b9\u4fbf\uff0c\u8fd9\u4e2a\u516c\u5f0f\u901a\u8fc7\u7b2c1\u9879\u3001\u6570\u5217\u7684\u516c\u6bd4$q$\u548c\u6240\u6c42\u9879\u7684\u5e8f\u53f7$n$\u8868\u793a\u6570\u5217$(b_n)$\u7684\u4efb\u4f55\u4e00\u9879."
    },
    {
      "block": 1,
      "text": "\u7531\u7b49\u6bd4\u6570\u5217\u7684\u5b9a\u4e49\u5f97\u51fa\uff1a\n$b_2=b_1\\cdot q$\uff1b\n$b_3=b_2\\cdot q=(b_1\\cdot q)\\cdot q=b_1\\cdot q^2$\uff0c\n$b_4=b_3\\cdot q=(b_1\\cdot q^2)\\cdot q=b_1\\cdot q^3$\uff0c\n$b_5=b_4\\cdot q=(b_1\\cdot q^3)\\cdot q=b_1\\cdot q^4$\uff0c\n\u7b49\u7b49.\u4e00\u822c\u5730\uff0c$b_n=b_1\\cdot q^{n-1}$. (1)"
    },
    {
      "block": 2,
      "text": "\u6211\u4eec\u4e3e\u51fa\u51e0\u4e2a\u5229\u7528\u516c\u5f0f(1)\u7684\u4f8b\u5b50."
    },
    {
      "block": 3,
      "text": "\u4f8b1 \u5728\u7b49\u6bd4\u6570\u5217$(b_n)$\u91cc\uff0c$b_1=0.8$\uff0c$q=\\frac{1}{2}$. \u6c42$b_{10}$."
    },
    {
      "block": 4,
      "text": "\u5229\u7528\u516c\u5f0f(1)\uff1a\n$b_{10}=0.8\\left(\\frac{1}{2}\\right)^{10-1}=0.8\\left(\\frac{1}{2}\\right)^9=\\frac{1}{640}$."
    },
    {
      "block": 5,
      "text": "\u4f8b2 \u5728\u7b49\u6bd4\u6570\u5217$(c_n)$\u91cc\uff0c$c_1=-27$\uff0c$q=\\frac{1}{3}$. \u6c42\u8fd9\u4e2a\u6570\u5217\u7684\u7b2c$n$\u9879."
    },
    {
      "block": 6,
      "text": "\u6839\u636e\u516c\u5f0f(1)\u5f97\u5230\uff1a\n$c_n=-27\\left(\\frac{1}{3}\\right)^{n-1}=-\\frac{3^3}{3^{n-1}}=-3^{4-n}$."
    },
    {
      "block": 7,
      "text": "\u4f8b3 \u62bd\u6c14\u673a\u7684\u6d3b\u585e\u6bcf\u52a8\u4f5c\u4e00\u6b21\u4ee5\u540e\uff0c\u4ece\u5bb9\u5668\u91cc\u6392\u9664\u5b83\u91cc\u9762\u7684\u7a7a\u6c14\u768420%. \u5982\u679c\u6700\u521d\u7684\u538b\u529b\u7b49\u4e8e750\u6beb\u7c73\u6c5e\u67f1\uff0c\u786e\u5b9a\u6d3b\u585e\u52a8\u4f5c6\u6b21\u4ee5\u540e\uff0c\u5bb9\u5668\u91cc\u9762\u7a7a\u6c14\u7684\u538b\u529b."
    },
    {
      "block": 8,
      "text": "\u56e0\u4e3a\u6d3b\u585e\u6bcf\u52a8\u4f5c\u4e00\u6b21\u4ee5\u540e\uff0c\u4ece\u5bb9\u5668\u91cc\u6392\u9664\u5b83\u91cc\u9762\u7684\u7a7a\u6c14\u768420%\uff0c\u6240\u4ee5\u5728\u5bb9\u5668\u91cc\u5269\u4e0b\u539f\u6709\u7a7a\u6c14\u768480%\u6216$\\frac{4}{5}$."
    },
    {
      "block": 9,
      "text": "\u4e3a\u4e86\u5f97\u77e5\u6d3b\u585e\u6bcf\u4f5c\u4e00\u6b21\u52a8\u4f5c\u540e\u5bb9\u5668\u5185\u7a7a\u6c14\u7684\u538b\u529b\uff0c\u53ea\u8981\u5c06\u6d3b\u585e\u524d\u4e00\u6b21\u52a8\u4f5c\u540e\u6240\u6307\u793a\u51fa\u7684\u7a7a\u6c14\u538b\u529b\u7684\u503c\u4e58\u4ee5$\\frac{4}{5}$\u5c31\u884c\u4e86. \u4f9d\u6b21\u6307\u793a\u51fa\u7684\u5bb9\u5668\u5185\u6700\u521d\u7684\u7a7a\u6c14\u538b\u529b\u7684\u503c\uff0c\u5373\u6d3b\u585e\u52a8\u4f5c1\u6b21\u540e\u3001\u52a8\u4f5c2\u6b21\u540e\u3001\u52a8\u4f5c3\u6b21\u540e\u7b49\u7b49\u7684\u538b\u529b\u7684\u503c\u6210\u7b49\u6bd4\u6570\u5217\uff0c\u5b83\u7684\u7b2c1\u9879\u7b49\u4e8e750\uff0c\u516c\u6bd4\u7b49\u4e8e$\\frac{4}{5}$. \u6d3b\u585e\u52a8\u4f5c6\u6b21\u540e\u7a7a\u6c14\u538b\u529b\u7684\u6570\u503c(\u4ee5\u6beb\u7c73\u6c5e\u67f1\u4e3a\u5355\u4f4d)\u662f\u8fd9\u4e2a\u6570\u5217\u7684\u7b2c7\u9879\uff1b\n\n\u8fd9\u5c31\u662f\u8bf4\uff0c\u5b83\u7b49\u4e8e\u79ef$750\\cdot\\left(\\frac{4}{5}\\right)^6$."
    },
    {
      "block": 10,
      "text": "\u901a\u8fc7\u8ba1\u7b97\u540e\uff0c\u5f97\u5230$750\\cdot\\left(\\frac{4}{5}\\right)^6=\\frac{750\\times2^{12}}{5^6}=\\frac{750\\times4096}{5^6}=\\frac{24576}{125}\\approx197$."
    },
    {
      "block": 11,
      "text": "\u4e8e\u662f\uff0c\u6d3b\u585e\u52a8\u4f5c6\u6b21\u540e\uff0c\u5bb9\u5668\u5185\u7a7a\u6c14\u7684\u538b\u529b\u7b49\u4e8e197\u6beb\u7c73\u6c5e\u67f1."
    }
  ],
  "figures": []
}
