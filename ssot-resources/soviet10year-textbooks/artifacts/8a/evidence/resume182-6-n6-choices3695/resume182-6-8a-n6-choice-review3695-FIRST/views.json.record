      "options": [
        {
          "id": "A",
          "text": "开口向上，与$x$轴交于$(-4,0)$、$(1,0)$，经过$(0,-4)$；$f(x)<0$的解集为$(-4,1)$，$f(x)>0$的解集为$(-\\infty,-4)\\cup(1,+\\infty)$。",
          "figure_ids": []
        },
        {
          "id": "B",
          "text": "开口向下，与$x$轴交于$(-1,0)$、$(4,0)$，经过$(0,4)$；$f(x)<0$的解集为$(-\\infty,-1)\\cup(4,+\\infty)$，$f(x)>0$的解集为$(-1,4)$。",
          "figure_ids": []
        },
        {
          "id": "C",
          "text": "开口向上，与$x$轴交于$(-1,0)$、$(4,0)$，经过$(0,-4)$；$f(x)<0$的解集为$(-1,4)$，$f(x)>0$的解集为$(-\\infty,-1)\\cup(4,+\\infty)$。",
          "figure_ids": []
        },
        {
          "id": "D",
          "text": "开口向上，与$x$轴交于$(-1,0)$、$(4,0)$，经过$(0,-4)$；$f(x)<0$的解集为$[-1,4]$，$f(x)>0$的解集为$(-\\infty,-1]\\cup[4,+\\infty)$。",
          "figure_ids": []
        }
      ]
    }
