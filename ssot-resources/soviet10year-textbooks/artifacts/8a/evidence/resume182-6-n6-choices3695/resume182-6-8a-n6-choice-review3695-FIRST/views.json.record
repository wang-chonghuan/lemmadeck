          "figure_ids": []
        },
        {
          "id": "B",
          "text": "若$a>0$、$D>0$，则$f(x)>0$的解集为$(x_1,x_2)$。",
          "figure_ids": []
        },
        {
          "id": "C",
          "text": "若$a>0$、$D>0$，则$f(x)\\le0$的解集为$(x_1,x_2)$。",
          "figure_ids": []
        },
        {
          "id": "D",
          "text": "若$a>0$、$D>0$，则$f(x)\\le0$的解集为$[x_1,x_2]$。",
