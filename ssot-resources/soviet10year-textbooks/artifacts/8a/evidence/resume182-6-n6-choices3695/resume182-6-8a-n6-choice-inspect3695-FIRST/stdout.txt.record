  "concept_candidates": [
    {
      "block": 0,
      "text": "\u89e3$ax^2+bx+c<0$\u548c$ax^2+bx+c>0(a\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u4e0d\u7b49\u5f0f\u65f6\uff0c\u53ef\u4ee5\u5229\u7528\u4e8c\u6b21\u51fd\u6570\u56fe\u8c61\u7684\u6027\u8d28\u3002\n\u8fd9\u79cd\u5f62\u5f0f\u7684\u4e0d\u7b49\u5f0f\u53eb\u505a\u4e00\u5143\u4e8c\u6b21\u4e0d\u7b49\u5f0f\u3002"
    },
    {
      "block": 1,
      "text": "\u6211\u4eec\u6765\u770b\u51e0\u4e2a\u4f8b\u5b50\u3002"
    },
    {
      "block": 2,
      "text": "\u4f8b1 \u89e3\u4e0d\u7b49\u5f0f$3x^2+10x-8<0$\u3002"
    },
    {
      "block": 3,
      "text": "\u6211\u4eec\u5229\u7528\u51fd\u6570$y=3x^2+10x-8$\u7684\u56fe\u8c61\u7684\u6027\u8d28\u3002\n\u8fd9\u4e2a\u56fe\u8c61\u662f\u629b\u7269\u7ebf\uff0c\u56e0\u4e3a$x^2$\u7684\u7cfb\u6570\u662f\u6b63\u6570\uff0c\u6240\u4ee5\u5b83\u7684\u201c\u5f00\u53e3\u201d\u5411\u4e0a\u3002\n\u4e3a\u4e86\u5f04\u6e05\u8fd9\u6761\u629b\u7269\u7ebf\u76f8\u5bf9\u4e8e$x$\u8f74\u7684\u4f4d\u7f6e\uff0c\u6211\u4eec\u6765\u6c42\u4e09\u9879\u5f0f$3x^2+10x-8$\u7684\u5224\u522b\u5f0f\u3002\n\n\u5f97\u5230\uff1a\n$D=100+96=196$\uff0c\n\u5373$D>0$\u3002\n\n\u5c31\u662f\u8bf4\uff0c\u4e09\u9879\u5f0f\u6709\u4e24\u4e2a\u6839\u3002\n\u901a\u8fc7\u8ba1\u7b97\u540e\uff0c\u6c42\u51fa\u4e09\u9879\u5f0f\u7684\u6839\u662f$-4$\u548c$\\frac{2}{3}$\u3002\n\u629b\u7269\u7ebf\u548c$x$\u8f74\u76f8\u4ea4\u4e8e\u4e24\u70b9\uff0c\u5b83\u4eec\u7684\u6a2a\u5750\u6807\u5206\u522b\u7b49\u4e8e$-4$\u548c$\\frac{2}{3}$\u3002"
    },
    {
      "block": 4,
      "text": "\u73b0\u5728\u53ef\u4ee5\u8868\u793a\u629b\u7269\u7ebf\u5728\u5750\u6807\u5e73\u9762\u4e0a\u7684\u5927\u81f4\u4f4d\u7f6e\uff08\u56fe9\uff09\u3002\n\u7531\u56fe\u770b\u51fa\uff0c\u5f53$-4<x<\\frac{2}{3}$\u65f6\uff0c\u4e09\u9879\u5f0f$3x^2+10x-8$\u53d6\u8d1f\u503c\u3002\n\u56e0\u6b64\uff0c\u6240\u6c42\u7684\u4e0d\u7b49\u5f0f$3x^2+10x-8<0$\u7684\u89e3\u96c6\u5408\u662f\u6570\u533a\u95f4$\\left]-4,\\frac{2}{3}\\right[$\u3002"
    },
    {
      "block": 7,
      "text": "\u6211\u4eec\u53d1\u73b0\uff0c\u5728\u4e0a\u9762\u6240\u8ba8\u8bba\u7684\u4e0d\u7b49\u5f0f\u7684\u89e3\u6cd5\u4e2d\uff0c\u6211\u4eec\u5e76\u4e0d\u5173\u5fc3\u629b\u7269\u7ebf\u9876\u70b9\u7684\u5750\u6807\uff0c\u8981\u7d27\u7684\u662f\u53ea\u8981\u77e5\u9053\u629b\u7269\u7ebf\u7684\u201c\u5f00\u53e3\u201d\u5411\u4e0a\u8fd8\u662f\u5411\u4e0b\u4ee5\u53ca\u5b83\u548c$x$\u8f74\u4ea4\u70b9\u7684\u6a2a\u5750\u6807\u662f\u4ec0\u4e48\u3002"
    },
    {
      "block": 8,
      "text": "\u4f8b2 \u89e3\u4e0d\u7b49\u5f0f$9x^2+30x+25>0$\u3002"
    },
    {
      "block": 9,
      "text": "\u4f5c\u4e3a\u51fd\u6570$y=9x^2+30x+25$\u7684\u56fe\u8c61\u7684\u629b\u7269\u7ebf\u7684\u201c\u5f00\u53e3\u201d\u5411\u4e0a\uff08$x^2$\u7684\u7cfb\u6570\u662f\u6b63\u7684\uff09\u3002"
    },
    {
      "block": 10,
      "text": "\u56e0\u4e3a\u4e09\u9879\u5f0f$9x^2+30x+25$\u7684\u5224\u522b\u5f0f\u7b49\u4e8e0\uff08$D=900-900=0$\uff09\uff0c\u6240\u4ee5\u4e09\u9879\u5f0f\u6709\u552f\u4e00\u7684\u6839\u3002\n\u901a\u8fc7\u8ba1\u7b97\uff0c\u6c42\u51fa\u4e09\u9879\u5f0f\u7684\u6839\u7b49\u4e8e$-1\\frac{2}{3}$\u3002\n\u56e0\u6b64\uff0c\u6240\u8ba8\u8bba\u7684\u629b\u7269\u7ebf\u548c$x$\u8f74\u53ea\u6709\u4e00\u4e2a\u516c\u5171\u70b9\uff0c\u5b83\u7684\u5750\u6807\u7b49\u4e8e$-1\\frac{2}{3}$\u3002\n\n\u5728\u56fe10\u4e2d\u7b80\u7565\u5730\u753b\u51fa\u4e86\u629b\u7269\u7ebf$y=9x^2+30x+25$\u3002\n\u7531\u56fe\u770b\u51fa\uff0c\u5f53\u53d8\u91cf$x$\u53d6\u6240\u6709\u7684\u503c\uff08$-1\\frac{2}{3}$\u9664\u5916\uff09\u65f6\uff0c\u4e0d\u7b49\u5f0f$9x^2+30x+25>0$\u662f\u771f\u4e0d\u7b49\u5f0f\uff0c\u4e5f\u5c31\u662f\u8bf4\uff0c\u4e0d\u7b49\u5f0f\u7684\u89e3\u96c6\u5408\u662f$\\left]-\\infty,-1\\frac{2}{3}\\right[\\cup\\left]-1\\frac{2}{3},+\\infty\\right[$\u3002"
    },
    {
      "block": 13,
      "text": "\u4f8b3 \u89e3\u4e0d\u7b49\u5f0f$-2x^2+x-5>0$\u3002"
    },
    {
      "block": 14,
      "text": "\u51fd\u6570$y=-2x^2+x-5$\u7684\u56fe\u8c61\u662f\u201c\u5f00\u53e3\u201d\u5411\u4e0b\u7684\u629b\u7269\u7ebf\u3002"
    },
    {
      "block": 15,
      "text": "\u4e09\u9879\u5f0f$-2x^2+x-5$\u7684\u5224\u522b\u5f0f\u662f\u8d1f\u6570\uff08$D=1-40<0$\uff09\u3002\n\u5c31\u662f\u8bf4\uff0c\u629b\u7269\u7ebf\u548c$x$\u8f74\u6ca1\u6709\u516c\u5171\u70b9\u3002"
    },
    {
      "block": 16,
      "text": "\u5728\u56fe11\u4e2d\u753b\u51fa\u4e86\u51fd\u6570$y=-2x^2+x-5$\u7684\u7b80\u7565\u7684\u56fe\u8c61\u3002\n\u7531\u56fe\u770b\u51fa\uff0c\u5bf9\u4e8e\u6240\u6709\u7684$x$\u503c\uff0c\u4e09\u9879\u5f0f\u7684\u503c\u662f\u8d1f\u7684\u3002\n\u56e0\u6b64\uff0c\u4e0d\u7b49\u5f0f$-2x^2+x-5>0$\u7684\u89e3\u96c6\u5408\u662f\u7a7a\u96c6\u3002"
    },
    {
      "block": 19,
      "text": "\u89e3\u4e8c\u6b21\u4e0d\u7b49\u5f0f\u65f6\uff0c\u6211\u4eec\u5229\u7528\u4e86\u5173\u4e8e\u4e8c\u6b21\u51fd\u6570\u7684\u56fe\u8c61\u76f8\u5bf9\u4e8e$x$\u8f74\u7684\u4f4d\u7f6e\u7684\u60f3\u6cd5\u3002\n\u663e\u7136\uff0c\u8fd9\u4e2a\u4f4d\u7f6e\u7531\u4e24\u4e2a\u6761\u4ef6\u786e\u5b9a\uff0c\u5c31\u662f\u4e8c\u6b21\u4e09\u9879\u5f0f$ax^2+bx+c$\u7684\u7cfb\u6570$a$\u7684\u7b26\u53f7\u548c\u5224\u522b\u5f0f$D$\u7684\u503c\u3002\n\u629b\u7269\u7ebf\u201c\u5f00\u53e3\u201d\u7684\u65b9\u5411\u51b3\u5b9a\u4e8e\u7cfb\u6570$a$\u7684\u7b26\u53f7\uff0c\u629b\u7269\u7ebf\u76f8\u5bf9\u4e8e$x$\u8f74\u7684\u4f4d\u7f6e\uff08\u629b\u7269\u7ebf\u548c$x$\u8f74\u6709\u4e24\u4e2a\u516c\u5171\u70b9\uff0c\u53ea\u6709\u4e00\u4e2a\u516c\u5171\u70b9\uff0c\u6ca1\u6709\u516c\u5171\u70b9\uff09\u51b3\u5b9a\u4e8e\u5224\u522b\u5f0f$D$\u7684\u7b26\u53f7\u3002"
    },
    {
      "block": 20,
      "text": "\u51fd\u6570$y=ax^2+bx+c(a\\ne0)$\u7684\u56fe\u8c61\u76f8\u5bf9\u4e8e$x$\u8f74\u7684\u4f4d\u7f6e\u8868\u793a\u5728\u56fe12\u4e2d\u3002"
    }
