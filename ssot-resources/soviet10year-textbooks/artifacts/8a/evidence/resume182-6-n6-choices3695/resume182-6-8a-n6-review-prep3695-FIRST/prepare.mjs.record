import fs from 'node:fs';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const source = '.tmp/resume182-6-8a-n6-choices3695-FIRST';
const target = '.tmp/resume182-6-8a-n6-choice-review3695-FIRST';
const bytes = fs.readFileSync(`${source}/draft.json`);
const draft = JSON.parse(bytes);
assert.equal(draft.schema, 's10y-choice-draft-v1');
assert.ok(draft.questions.length > 0);
assert.ok(!fs.existsSync(target));
fs.mkdirSync(target);
const digest = value => createHash('sha256').update(value).digest('hex');
const ordered = value => Array.isArray(value) ? value.map(ordered)
  : value && typeof value === 'object'
    ? Object.fromEntries(Object.keys(value).sort().map(key => [key, ordered(value[key])]))
    : value;
const canonical = value => digest(JSON.stringify(ordered(value)).replace(/[\u007f-\uffff]/g,
  char => `\\u${char.charCodeAt(0).toString(16).padStart(4, '0')}`));
const seedBytes = fs.readFileSync(`${source}/seed.json`);
const seed = JSON.parse(seedBytes);
assert.equal(canonical(seed), draft.seed_sha256);
fs.writeFileSync(`${target}/seed.json`, seedBytes, { flag: 'wx' });
fs.writeFileSync(`${target}/draft.snapshot.json`, bytes, { flag: 'wx' });
const views = draft.questions.map(question => ({
  question_id: question.id, source_numbers: question.source_numbers, view: question.view,
}));
fs.writeFileSync(`${target}/views.json`, `${JSON.stringify(views, null, 2)}\n`, { flag: 'wx' });
fs.writeFileSync(`${target}/packet.record`, `${JSON.stringify({
  seed: { path: `${target}/seed.json`, sha256: digest(seedBytes), canonical: canonical(seed) },
  draft: { path: `${target}/draft.snapshot.json`, sha256: digest(bytes), canonical: canonical(draft) },
  views: { path: `${target}/views.json`, sha256: digest(fs.readFileSync(`${target}/views.json`)) },
  questions: views.length, options: views.reduce((n, q) => n + q.view.options.length, 0),
  sourceOnlySeal: {
    path: '.tmp/resume182-6-8a-n6-blind7186-FIRST/solutions.record',
    sha256: '7d8732e381f340748fd198b0c78cf93a67c1a9c355f012f645e52febe8349b23',
  },
  order: 'Reuse sealed independent SOURCE first; judge and solve only NEW views before opening author keys.',
  authorKeysHiddenFromViews: true, rerunExistingSourceMathOrFigures: false,
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ packet: `${target}/packet.record`, questions: views.length,
  options: views.reduce((n, q) => n + q.view.options.length, 0) }));
