import fs from 'node:fs';
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';

const R = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), R);
const root = 'ssot-resources/soviet10year-textbooks/artifacts/8a';
const edition = `${root}/editions/modern-us-neutral`;
const lesson = `${edition}/lessons/alg8-c2-s1-n8`;
const display = JSON.parse(fs.readFileSync(`${lesson}/offline-display.json`));
assert.equal(display.status, 'OFFLINE_DISPLAY_PASS');
assert.equal(display.lesson, 'alg8-c2-s1-n8');
assert.equal(display.coverage.pending, 0);
assert.equal(display.coverage.missing, 0);
const pending = spawnSync('git', ['diff', '--cached', '--name-only', '-z'], { cwd: R, encoding: 'utf8' });
assert.equal(pending.status, 0);
assert.equal(pending.stdout, '', 'Do not alter a pre-existing staged set');
const paths = [
  '.intentfold/tickets/STEMROBIN-182/progress.md',
  `${edition}/book.json`,
  ...['svg', 'spec.json', 'render.json', 'review.json'].map(suffix => `${edition}/figures/fig-16.${suffix}`),
  lesson,
  ...fs.readdirSync(`${root}/evidence`).sort()
    .filter(name => name.startsWith('resume182-6-n8-') || name === 'resume182-6-n7-git-delivery-proof3695')
    .map(name => `${root}/evidence/${name}`),
];
for (const filename of paths) assert.ok(fs.existsSync(filename), filename);
const result = spawnSync('git', ['add', '--', ...paths], { cwd: R, encoding: 'utf8' });
process.stdout.write(result.stdout);
process.stderr.write(result.stderr);
assert.equal(result.status, 0);
console.log(JSON.stringify({ status: 'N8_NARROW_STAGED', paths, halfLessonsIncluded: false }));
