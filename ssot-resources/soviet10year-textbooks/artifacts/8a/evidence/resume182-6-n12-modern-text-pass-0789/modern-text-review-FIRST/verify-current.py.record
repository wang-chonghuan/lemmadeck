check(exercises["source"]["data"] == raw_exercises, "exercises-full-source-snapshot-identity")

profile_path = ROOT / ".claude/skills/ld-s10y-lesson/profiles/modern-us-neutral.json"
profile = load(profile_path)
forbidden = profile["forbidden_terms"] + profile["forbidden_person_names"]
object_evidence = []
ordinal_evidence = []
prose_layout = []
formula_introductions = []
for family, source_items, modern_items in (
    ("lesson.prose", raw_lesson["prose"], lesson["prose"]),
    ("exercises", raw_exercises["exercises"], exercises["exercises"]),
):
    for index, (source, modern) in enumerate(zip(source_items, modern_items)):
        target = f"{family}[{index}]"
        is_exercise = family == "exercises"
        source_text = source["text"]
        modern_text = modern["text"]
        fields = (
            ("number", "source_number", "group", "group_id", "pages", "figure_refs",
             "figures", "numbering_erratum")
            if is_exercise else ("kind", "id", "label", "printed_page", "source_refs")
        )
        native_errors += edition.validate_identity_fields(source, modern, fields, target)
        check(modern["source_text"] == source_text, f"source-text:{target}")
        native_errors += edition.validate_text(
            source_text, modern_text, modern["changes"], modern["numeric_changes"],
            target, forbidden, modern["historical_entities"], corrections.get(target),
            source_lines=source["lines"] if is_exercise else None,
        )
        expected_text = source_text
        for correction in corrections.get(target, []):
            expected_text = expected_text.replace(correction["original"], correction["corrected"], 1)
        expected_changes = []
        if is_exercise:
            expected_changes = ["layout", "enum-latin"]
            if corrections.get(target):
                expected_changes.append("math-correction")
            prefix, source_parts = subparts(expected_text, edition.CYRILLIC_PARTS)
            modern_prefix, modern_parts = subparts(modern_text, edition.LATIN_PARTS)
            count = len(source_parts)
            check(count >= 2, f"complete-source-subparts:{target}")
            check([part["label"] for part in source_parts] == list(edition.CYRILLIC_PARTS[:count]),
                  f"source-natural-ordinal-order:{target}")
            check([part["label"] for part in modern_parts] == list(edition.LATIN_PARTS[:count]),
                  f"complete-modern-natural-ordinal-order:{target}")
            check(compact(prefix) == compact(modern_prefix), f"subpart-prefix-retained:{target}")
            check([compact(part["payload"]) for part in source_parts] ==
                  [compact(part["payload"]) for part in modern_parts],
                  f"full-subpart-payloads-retained:{target}")
            expected_text = prefix + "\n" + "\n".join(
                f"{edition.LATIN_PARTS[i]}) {part['payload']}"
                for i, part in enumerate(source_parts)
            )
            check(modern["lines"] == modern_text.splitlines(), f"current-lines-equal-text:{target}")
            check(len(modern["lines"]) == count + 1, f"prefix-and-each-subpart-own-line:{target}")
            native_errors += edition.validate_numbered_subpart_layout(modern_text)
            check(edition.normalize_numbered_subparts(modern_text) == modern_text,
                  f"subparts-idempotent:{target}")
            ordinal_evidence.append({
                "target": target, "number": modern["number"], "source_prefix": prefix,
                "modern_prefix": modern_prefix, "source_parts": source_parts,
                "modern_parts": modern_parts, "count": count,
                "natural_order": True, "all_payloads_exact_modulo_layout": True,
                "prefix_and_each_subpart_own_line": True,
            })
        else:
            expected_changes = ["layout"] if modern_text != source_text else []
            if modern["kind"] == "p":
                normalized = edition.normalize_prose_layout(modern_text)
                normalized_twice = edition.normalize_prose_layout(normalized)
                check(normalized == modern_text == normalized_twice, f"prose-idempotent:{target}")
                paragraphs = re.split(r"\n[ \t]*\n+", edition.masked_math(modern_text))
                paragraph_count = len(paragraphs)
                check(not any(re.search(r"\n[ \t]*\n", match.group())
                              for match in edition.MATH.finditer(modern_text)),
                      f"no-math-double-newline:{target}")
                check(not re.search(r"(?m)^\s*(?:[123]\.|" +
                                    "\u7b49\u7b49" + r"[.\u3002]?)\s*$", modern_text),
                      f"no-isolated-method-number-or-prose-tail:{target}")
                check(not re.search(r"[\uff0c,]\s*\n[ \t]*\n", edition.masked_math(modern_text)),
                      f"no-paragraph-split-at-comma-clause:{target}")
                masked = edition.masked_math(modern_text)
                for position, char in enumerate(masked):
                    if char in ":\uff1a" and modern_text[position + 1:].lstrip().startswith("$"):
                        gap = re.match(r"\s*", modern_text[position + 1:]).group()
                        check("\n" in gap, f"introduced-formula-own-line:{target}:{position}")
                        formula_introductions.append({"target": target, "colon_offset": position})
                prose_layout.append({
                    "target": target, "source_refs": modern["source_refs"],
                    "paragraph_count": paragraph_count,
                    "lines": modern_text.splitlines(), "idempotent": normalized == modern_text,
                    "second_application_unchanged": normalized_twice == modern_text,
                })
        check(modern["changes"] == expected_changes, f"only-allowed-changes:{target}")
        check(modern["numeric_changes"] == [], f"no-numeric-context-change:{target}")
        check(modern["historical_entities"] == [], f"no-cultural-identity-change:{target}")
        check(compact(expected_text) == compact(modern_text), f"entire-content-retained:{target}")
        check(strict_formulas(expected_text) == strict_formulas(modern_text),
              f"strict-formula-literals-order:{target}")
        check(all_numbers(expected_text) == all_numbers(modern_text),
              f"all-formula-and-prose-numbers-order:{target}")
        check(edition.number_signature(expected_text) == edition.number_signature(modern_text),
              f"native-prose-number-signature:{target}")
        check(not edition.CYRILLIC.search(modern_text), f"no-modern-cyrillic:{target}")
        for match in edition.MATH.finditer(modern_text):
            check(not edition.MATH_BOUNDARY_PUNCTUATION.search(match.group()),
                  f"no-cjk-punctuation-inside-math:{target}")
        object_evidence.append({
            "target": target, "number": modern.get("number"),
            "source_refs": modern.get("source_refs", modern.get("pages")),
            "changes": modern["changes"], "native_text_errors": [],
            "source_math_signature": edition.math_signature(source_text),
            "expected_math_signature": edition.math_signature(expected_text),
            "current_math_signature": edition.math_signature(modern_text),
            "strict_expected_formula_literals": strict_formulas(expected_text),
            "strict_current_formula_literals": strict_formulas(modern_text),
            "expected_nonmath_numbers": edition.number_signature(expected_text),
            "current_nonmath_numbers": edition.number_signature(modern_text),
            "expected_all_numeric_tokens": all_numbers(expected_text),
            "current_all_numeric_tokens": all_numbers(modern_text),
            "entire_payload_equal_modulo_layout_and_registered_replacement":
                compact(expected_text) == compact(modern_text),
        })

flow, flow_errors = edition.prose_flow_contract(lesson["prose"], lesson["section_breaks"])
native_errors += flow_errors
native_stdout_path = Path(sections["nativeOutput"]["path"])
check(binding(native_stdout_path)["sha256"] == sections["nativeOutput"]["sha256"],
      "retained-native-prose-stdout-hash")
retained_stdout = native_stdout_path.read_text(encoding="utf-8")
retained_paragraphs = re.findall(
    r"(?ms)^\[(\d+)\] (.*?)(?=^\s{4}break: |^\[\d+\] |\Z)", retained_stdout)
check([text.rstrip("\n") for _, text in retained_paragraphs] ==
      [paragraph["text"] for paragraph in flow["paragraphs"]],
      "current-prose-outline-equals-retained-native-stdout")
retained_boundaries = [
    json.loads(match.group(1)) for match in
    re.finditer(r"(?m)^    break: (\{.*\})$", retained_stdout)
]
check(lesson["section_breaks"] == sections["selected"], "copied-boundary-objects")
check(all(boundary in retained_boundaries for boundary in lesson["section_breaks"]),
      "each-boundary-copied-from-native-stdout")
check([{key: boundary[key] for key in ("before", "after")} for boundary in flow["boundaries"]] ==
      lesson["section_breaks"], "current-native-adjacent-anchor-resolution")
method_indices = [
    item["index"] for item in flow["paragraphs"]
    if re.match(r"^[23]\. ", item["text"])
]
check(flow["resolvedBreaks"] == method_indices, "boundaries-exactly-methods-two-and-three")
flow_code = (
    "const fs=require('node:fs');"
    "const {proseFlow}=require(process.argv[1]);"
    "const d=JSON.parse(fs.readFileSync(0,'utf8'));"
    "process.stdout.write(JSON.stringify(proseFlow(d.prose,d.section_breaks)));"
)
flow_result = subprocess.run(
    ["node", "-e", flow_code, str(TOOLS / "htmlfrag.js")],
    input=json.dumps(lesson, ensure_ascii=False), text=True, capture_output=True,
)
check(flow_result.returncode == 0, "native-proseFlow-text-only-returncode")
actual_flow = json.loads(flow_result.stdout) if flow_result.returncode == 0 else []
check(len(actual_flow) == 16, "fifteen-paragraphs-plus-table-in-publish-flow")
check([item["text"] for item in actual_flow if item["kind"] == "p"] ==
      [item["text"] for item in flow["paragraphs"]], "native-proseFlow-matches-outline")
check([item["text"] for item in actual_flow if item.get("sectionBreak")] ==
      [boundary["after"] for boundary in lesson["section_breaks"]],
      "actual-flow-breaks-at-authorized-concept-changes")
check(actual_flow[3]["kind"] == "fig" and actual_flow[3]["id"] == "tbl-p0081-01" and
      actual_flow[4].get("sectionBreak") is True, "table-metadata-stays-before-method-two")

refs = [
    ref for item in (*lesson["prose"], *exercises["exercises"])
    for ref in item.get("source_refs", item.get("pages", []))
]
position = lambda ref: tuple(map(int, re.fullmatch(r"p(\d+)#(\d+)", ref).groups()))
check(all((81, 4) < position(ref) < (85, 4) for ref in refs), "exact-source-boundaries")
page81 = load(BOOK / "pages/0081/page.json")
page85 = load(BOOK / "pages/0085/page.json")
check(page81["blocks"][3]["kind"] == "h3" and
      edition.blocks.text_of(page81["blocks"][3]) == raw_lesson["printed_title"],
      "start-p0081-four-exact-title")
check(page85["blocks"][3]["kind"] == "h3" and
      edition.blocks.text_of(page85["blocks"][3]).startswith("13."),
      "excluded-p0085-four-next-lesson")
check(exercises["exercises"][5]["pages"] == ["p0083#6", "p0084#1"],
      "ex209-complete-cross-page-refs")
check(exercises["exercises"][12]["pages"] == ["p0084#8", "p0085#1"],
      "ex216-complete-cross-page-refs")
check(all(item["group"] is None and item["group_id"] == "g0"
          for item in exercises["exercises"][:-1]), "original-main-group-retained")
check(exercises["exercises"][-1]["group"] == "\u590d\u4e60\u9898" and
      exercises["exercises"][-1]["group_id"] == "g1", "ex217-review-group-retained")

test_receipts = []
for stage, count, expected_sha in (
    ("prose-layout-focused-tests-FIRST", 3, None),
    ("prose-layout-focused-tests-math-mask1", 4,
     "47010b4ce610ecd8cfd39cbfd7c184328d09d54725a173c3fa5b1367e6a0ffff"),
):
    path = WORK / f"stages/{stage}/receipt.record"
    receipt = load(path)
    current = binding(path)
    check(receipt["returncode"] == 0, f"reused-test-receipt:{stage}")
    if expected_sha:
        check(current["sha256"] == expected_sha, f"reused-test-receipt-hash:{stage}")
    log_paths = [path.parent / name for name in ("stdout.txt", "stderr.txt")]
    log = "".join(log_path.read_text(encoding="utf-8") for log_path in log_paths)
    check(f"Ran {count} tests" in log and "OK" in log, f"reused-test-count:{stage}")
    test_receipts.append({**current, "stage": stage, "tests": count, "returncode": 0,
                          "reused": True, "rerun": False,
                          "logs": [binding(log_path) for log_path in log_paths]})

for error in native_errors:
    blockers.append({"id": "native-text-validation", "severity": "blocking", "detail": error})
normalized_lesson = copy.deepcopy(lesson)
normalized_exercises = copy.deepcopy(exercises)
edition.normalize_lesson_layout(normalized_lesson)
edition.normalize_exercise_layout(normalized_exercises)
check(normalized_lesson == lesson, "full-lesson-normalization-idempotent-in-memory")
check(normalized_exercises == exercises, "full-exercises-normalization-idempotent-in-memory")
check(binding(TOOLS / "edition.py") == helper_at_start, "helper-byte-stability-during-review")
for name, path in (("lesson", lesson_path), ("exercises", exercises_path)):
    check(binding(path) == candidate_bindings[name], f"candidate-unchanged-during-review:{name}")
for item in source_bindings + raw_bindings + lineage_bindings:
    check(binding(item["path"]) == item, f"read-input-unchanged:{item['path']}")

status = "TEXT_PASS" if not blockers else "TEXT_REVISE"
record = {
    "schema": "stemrobin-182/independent-modern-text-review@1",
    "status": status, "date": "2026-11-20", "ticket": "STEMROBIN-182",
    "authorization": "182-6; NEW independent modern text reviewer; offline only; finish=review",
    "book": "8a", "lesson": LESSON_ID, "edition": "modern-us-neutral", "finish": "review",
    "workdir": str(ROOT),
    "reviewer": {
        "kind": "independent_agent",
        "identity": "codex-new-independent-modern-text-review-182-6-n12-0789-FIRST",
        "producer": False, "source_author": False, "self_author_approval": False,
        "old_paused_reviewer_resumed": False,
    },
    "blockers": blockers,
    "approved_text_bindings": candidate_bindings if status == "TEXT_PASS" else {},
    "current_text_bindings": candidate_bindings,
    "source_pass": lineage_bindings[0],
