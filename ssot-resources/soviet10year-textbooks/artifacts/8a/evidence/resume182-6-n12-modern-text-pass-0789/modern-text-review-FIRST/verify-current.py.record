sys.path.insert(0, str(TOOLS))
import edition


def load(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def binding(path):
    path = Path(path).resolve()
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return {"path": str(path), "sha256": digest.hexdigest(), "bytes": path.stat().st_size}


blockers = []


def check(ok, label):
    if not ok:
        blockers.append({"id": label, "severity": "blocking", "detail": label})
    return bool(ok)


def compact(text):
    return re.sub(r"\s+", "", text)


def strict_formulas(text):
    return [compact(match.group()) for match in edition.MATH.finditer(text)]


def all_numbers(text):
    return re.findall(r"\d+(?:\.\d+)?", text)


def subparts(text, alphabet):
    masked = edition.masked_math(text)
    depths = edition.nesting_depths(masked)
    markers = [
        match for match in edition.PART_MARKER.finditer(masked)
        if depths[match.start()] == 0 and match.group("label") in alphabet
    ]
    prefix = text[:markers[0].start()].strip() if markers else text
    parts = []
    for index, marker in enumerate(markers):
        end = markers[index + 1].start() if index + 1 < len(markers) else len(text)
        parts.append({
            "label": marker.group("label"),
            "payload": text[marker.end():end].strip(),
        })
    return prefix, parts


