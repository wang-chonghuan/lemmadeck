import assert from 'node:assert/strict';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { readFile, stat } from 'node:fs/promises';

const ROOT = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
const OUTPUT = path.join(ROOT, '.tmp/ld-s10y-lesson/resume182-6-3129/display-N19-text-FIRST');
const SOURCE = path.join(ROOT, '.tmp/ld-s10y-lesson/resume182-6-3129/display-N4-FIRST/run.mjs');
const ID = 'alg8-c3-s3-n19';
const LESSON = path.join(ROOT, 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons', ID);
const OLD_ROOT = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
assert.equal(process.cwd(), ROOT);
const pins = {};
const values = {};
for (const name of ['lesson.json', 'exercises.json', 'figures.json', 'answer-keys.json']) {
  const bytes = await readFile(path.join(LESSON, name));
  pins[name] = sha(bytes);
  values[name] = JSON.parse(bytes);
}
assert.equal(values['lesson.json'].id, ID);
assert.equal(values['exercises.json'].lesson, ID);
assert.equal(values['figures.json'].lesson, ID);
assert.equal(values['answer-keys.json'].lesson, ID);
assert.equal(values['lesson.json'].prose.length, 13);
assert.equal(values['exercises.json'].count, values['lesson.json'].exercise_count);
assert.equal(values['exercises.json'].count, 11);
assert.deepEqual(values['exercises.json'].exercises.map(item => String(item.number)),
  Array.from({ length: 11 }, (_, index) => String(298 + index)));
const requestedFigures = [...new Set([
  ...values['lesson.json'].prose.filter(block => block.kind === 'fig').map(block => block.id),
  ...values['exercises.json'].exercises.flatMap(item => (item.figures ?? []).map(figure => figure.id)),
])];
assert.deepEqual(values['figures.json'].figures.map(figure => figure.id), requestedFigures);
const unavailable = [];
for (const filename of [OLD_ROOT, path.join(OLD_ROOT, '.tmp')]) {
  try {
    await stat(filename);
    unavailable.push({ path: filename, available: true });
  } catch (error) {
    assert.equal(error.code, 'ENOENT');
    unavailable.push({ path: filename, available: false, code: error.code });
  }
}
const inherited = {
  authority: 'Direct human continuation instruction in this turn; no chat or reviewer messages read',
  oldRuntime: { status: 'PASS_RETAINED', screenshotsReported: 90, receiptBytesRecovered: false,
    rerunClaimed: false },
  textObservations: { status: 'TWO_PASS_RETAINED', count: 2, screenshotBytesRecovered: false,
    reportBytesRecovered: false, regionIdentityRecovered: false, targetCoverageTransferred: 0,
    reopened: 0, overwritten: false },
  lookup: unavailable,
  limitation: 'Original 0789 checkout is absent. Old PNG/custom tools and region bindings are unavailable. New preparation, capture, hashing and byte equality are not restoration of old observation.',
  observationContinuation: 'Exercise/standard/table screenshots only are actionable. New text selection remains non-actionable until the two historical PASS region identities can be excluded; no text is silently relabelled unseen.',
};
assert.ok(unavailable.every(entry => !entry.available),
  'If original reports become available, bind the two historical regions before preparing observation continuation');
const sourceBytes = await readFile(SOURCE);
let code = sourceBytes.toString('utf8');
const replaceOnce = (before, after) => {
  assert.equal(code.split(before).length, 2, before);
  code = code.replace(before, after);
};
replaceOnce('display-N4-FIRST', 'display-N19-text-FIRST');
replaceOnce("const ID = 'alg7-c1-s1-n4';", `const ID = ${JSON.stringify(ID)};`);
replaceOnce("artifacts/7a/editions/modern-us-neutral", 'artifacts/8a/editions/modern-us-neutral');
replaceOnce('render-7a-n4-FIRST', 'render-N19-missing-FIRST');
replaceOnce("schema: 'resume182-6-n4-offline-display@1', lesson: ID, book: '7a'",
  "schema: 'resume182-6-n19-reused-n4-offline-display@1', lesson: ID, book: '8a'");
const start = code.indexOf('  const pins = {');
const end = code.indexOf('  const loaded = {};', start);
assert.ok(start > 0 && end > start);
code = code.slice(0, start) + `  const pins = ${JSON.stringify(pins)};\n` + code.slice(end);
replaceOnce('  assert.equal(exercises.count, 15);',
  '  assert.equal(exercises.count, lesson.exercise_count);');
replaceOnce('  assert.equal(standardDisplay.length, 15);',
  '  assert.equal(standardDisplay.length, exercises.count);');
replaceOnce("  assert.deepEqual(Object.keys(figureContracts), ['fig-01']);",
  `  assert.deepEqual(Object.keys(figureContracts), ${JSON.stringify(requestedFigures)});`);
replaceOnce('    const spec = JSON.parse(await record(path.join(MODERN, figure.spec)));',
  `    const approved = JSON.parse(await record(path.join(MODERN, figure.review)));
    assert.equal(approved.status, 'pass');
    const spec = JSON.parse(await record(path.join(MODERN, figure.spec), approved.spec.sha256));`);
replaceOnce("await record(path.join(MODERN, figure.svg))",
  "await record(path.join(MODERN, figure.svg), approved.outputs.svg.sha256)");
replaceOnce('    await record(path.join(MODERN, figure.render));\n    await record(path.join(MODERN, figure.review));',
  `    await record(path.join(MODERN, figure.render), approved.render.sha256);
    assert.equal(spec.display.layout, 'scroll');
    assert.equal(spec.display.widths.length, 1);
    assert.ok(spec.display.widths[0] > 0);`);
replaceOnce('maxWidthPx: spec.display.maxWidthPx };',
  'maxWidthPx: spec.display.widths[0] };');
replaceOnce('  const pins = ', `  report.inherited = ${JSON.stringify(inherited)};
  report.adaptation = { source: ${JSON.stringify(SOURCE)}, sha256: ${JSON.stringify(sha(sourceBytes))},
    method: 'N4 executed runner unchanged except lesson scope, derived pins/counts/figure contracts and explicit historical limitation',
    standardCollector: 'Existing N6/N11 helper and standard-display projection; no new renderer or formula solving' };
  await record(${JSON.stringify(SOURCE)}, ${JSON.stringify(sha(sourceBytes))});
  const pins = `);
code += `\n//# sourceURL=${OUTPUT}/reused-n4-runner.mjs\n`;
await import(`data:text/javascript;base64,${Buffer.from(code).toString('base64')}`);
