          "tex": "n",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "b_1\\cdot q^{n-1}",
          "visible": true,
          "nonempty": true
        },
        {
          "tex": "S_n=\\frac{b_nq-b_1}{q-1}",
          "visible": true,
          "nonempty": true
        },
        {
