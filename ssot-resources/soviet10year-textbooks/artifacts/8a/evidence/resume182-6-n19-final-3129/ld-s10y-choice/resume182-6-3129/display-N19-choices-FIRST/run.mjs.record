section('  const fragment = text =>', '  const html = new Map();', `
  const leakage = /\\b(?:correct_index|correctIndex|answerKey|answer_key|correct|accept|expected|seed_sha256|draft_sha256|source_numbers|source_solution|independent_solution|rationales|misconception|omitted_tasks|api_key|password|postgres(?:ql)?|intent|key)\\b/iu;
  assert.ok(!leakage.test(oldHtmlBytes.toString('utf8')));
  report.projection = { fields: ['view.mode', 'view.stem', 'view.figure_ids',
    'view.options.id', 'view.options.text', 'view.options.figure_ids'],
    heading: (lesson.printed_title || lesson.title) + ' \\u00b7 \\u9009\\u62e9\\u9898',
    questions: questionCount, options: optionCount, sources: sourceNumbers.length,
    figureIds: usedFigures, optionLabels: 'Current view order displayed as A, B, C, D',
    clientIntentOrKey: false, sourceSolvingOrSemanticReviewRepeated: false };
  if (previous && args[0] === '--recover-formula-padding') {
    assert.ok(previous.executionFailure && previous.failedView);
    assert.match(previous.executionFailure.message, /glyph-rules-media-and-formula-boxes-reachable/u);
    assert.ok(previous.domFailure?.failed?.every(target =>
      target.kind === 'text-glyph' || target.kind === 'formula-box-region'));
    assert.ok(!previous.domFailure?.internalClips?.length);
    for (const image of report.screenshots)
      if (image.viewport.width + ':' + image.surface === previous.failedView) image.coverageReusable = false;
    report.recovery = { failedView: previous.failedView, reason: 'Affected formula scroll-padding only',
      priorFailurePreserved: true, semanticApprovalGranted: false };
  } else if (previous) {
    assert.equal(previous.failedView, null);
    assert.equal(previous.usage.browserLaunches, 0);
    assert.match(previous.executionFailure.message,
      /Failed to resolve module specifier|assert\\.ok\\(previous\\.executionFailure && previous\\.failedView\\)/u);
    report.recovery = { reason: 'Use a file URL for the existing marked module inside the data-URL adapter',
      stage: 'Module loading only; no prior rendered viewport or capture existed',
      priorFailurePreserved: true, semanticApprovalGranted: false };
  }
`);
