      .flatMap((table, tableIndex) => [...table.rows].flatMap((row, rowIndex) =>
        [...row.cells].map((cell, columnIndex) => {
          const style = getComputedStyle(cell);
          return { tableIndex, rowIndex, columnIndex, collapsed: getComputedStyle(table).borderCollapse === 'collapse',
            rightmost: columnIndex === row.cells.length - 1,
            edges: ['Top', 'Right', 'Bottom', 'Left'].map(side => ({
              side, width: parseFloat(style['border' + side + 'Width']),
              style: style['border' + side + 'Style'], color: style['border' + side + 'Color'] })) };
