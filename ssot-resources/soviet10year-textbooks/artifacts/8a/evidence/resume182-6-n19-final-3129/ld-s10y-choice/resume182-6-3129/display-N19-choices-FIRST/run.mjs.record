section('  const promotionPath =', '  const baseCode =', `
  await record(${JSON.stringify(METHOD)}, ${JSON.stringify(sha(bytes))});
  await record(${JSON.stringify(path.join(OUTPUT, 'run.mjs'))});
  await record(${JSON.stringify(path.join(OUTPUT, 'execute.mjs'))});
  const seed = JSON.parse(await record(path.join(CHOICES, 'seed.json'),
    '8ad4ce5c4412e1e6a4eb0625d30f5edf02433155ac5b7a3bb0a01327619cd449'));
  const draft = JSON.parse(await record(path.join(CHOICES, 'draft.json'),
    'f7b5c6ddd585cf8422c8d226e0f00d41dd7b2cbbdf93916c0475a242359b27f0'));
  const review = JSON.parse(await record(path.join(CHOICES, 'review.json'),
    'cc71aa407f572f70181a5c9e213d81ef6fed5bc5865629d52fbac7746050de40'));
  assert.equal(review.outcome, 'pass');
  assert.equal(draft.seed_sha256, review.seed_sha256);
  assert.equal(seed.source.book, '8a');
  assert.equal(seed.source.lesson, ID);
  const sourceNumbers = seed.exercises.map(exercise =>
    String(exercise.number ?? exercise.source_number ?? exercise.id));
  assert.deepEqual(sourceNumbers, Array.from({ length: 11 }, (_, index) => String(298 + index)));
  const views = draft.questions.map(({ view }) => ({ mode: view.mode, stem: view.stem,
    figure_ids: view.figure_ids,
    options: view.options.map(({ id, text, figure_ids }) => ({ id, text, figure_ids })) }));
  const questionCount = views.length;
  const optionCount = views.reduce((count, view) => count + view.options.length, 0);
  assert.equal(questionCount, 14);
  assert.equal(optionCount, 55);
  assert.equal(draft.new_figures.length, 0);
  report.approvalReuse = { authority: 'Direct human scope/status acceptance, current hash-bound existing review',
    outcome: review.outcome, sources: sourceNumbers.length, sourceNumbers,
    questions: questionCount, options: optionCount,
    canonicalBindings: { seed: review.seed_sha256, draft: review.draft_sha256 },
    checkerRerun: false, solverRerun: false, sourceReviewRerun: false, figureReviewRerun: false };
  report.preflightDiscovery = { failuresPreserved: [
    { exitCode: 2, command: 'rg scoped file inventory', reason: 'STEMROBIN-182-6 local ticket directory absent; router uses STEMROBIN-182' },
    { exitCode: 1, command: 'node read-only scope summary', reason: 'Render report objects is not an array; labels already obtained from spec, no content verdict' },
    { exitCode: 1, command: 'rg old0789 checkout scratch', reason: 'Old checkout lemmadeck/.tmp absent' },
    { exitCode: 1, command: 'ls current output directory', reason: 'New authorized output directory did not yet exist' },
    { exitCode: 1, command: 'node execute.mjs first adapter execution',
      reason: 'Section end marker matched two deliveredHtml pushes; adapter failed before browser/server creation',
      receipt: path.join(OUTPUT, 'execution-1.json'), repairedOnly: 'Unique section end locator',
      executionWrapperFailure: 'No runtime report exists after the adapter stopped' }
  ], old0789CustomToolRecovered: false, old0789NinetyPngRecovered: false,
    oldPassReopened: false, oldCheckout: '/Users/yong/.codex/worktrees/stemrobin-182-six-0789',
    observedOldCheckoutState: 'Only .codex-worktree-name exists; no lemmadeck checkout',
    priorN4Push: { authority: 'Human and existing production progress, not re-queried',
      revision: '285ef621d4b18fffc4a58202a6a4675eab240e25' } };
  const oldHtmlPath = path.join(ROOT,
    '.tmp/ld-s10y-lesson/resume182-6-3129/render-N19-missing-FIRST', ID, 'choices.html');
  const oldHtmlBytes = await record(oldHtmlPath,
    'bcd71441016db713a903d628eeaee5e170ef13c4d040879ec039bfcfede525c7');
  const lesson = JSON.parse(await record(path.join(LESSON, 'lesson.json')));
  const manifest = JSON.parse(await record(path.join(LESSON, 'figures.json')));
  const usedFigures = [...new Set(views.flatMap(view => [...view.figure_ids,
    ...view.options.flatMap(option => option.figure_ids)]))];
  assert.deepEqual(usedFigures, ['tbl-p0112-01']);
  const figureContracts = {};
  report.figureApprovalReuse = [];
  for (const id of usedFigures) {
    const figure = manifest.figures.find(item => item.id === id);
    assert.ok(figure);
    const approved = JSON.parse(await record(path.join(MODERN, figure.review),
      '9d5a9f5ba8490ce4ae233da5b2eda2addb3bbf6c5cb7cd16f37fa3a6210cdd5c'));
    assert.equal(approved.status, 'pass');
    const spec = JSON.parse(await record(path.join(MODERN, figure.spec), approved.spec.sha256));
    const svgMarkup = (await record(path.join(MODERN, figure.svg), approved.outputs.svg.sha256))
      .toString('utf8').replace(/<\\?xml[^>]*\\?>/u, '').trim();
    await record(path.join(MODERN, figure.render), approved.render.sha256);
    figureContracts[id] = { svgMarkup,
      labels: spec.objects.filter(item => item.type === 'text')
        .map(({ id, text }) => ({ id: id + '-label', text })),
      minimumPx: spec.display.minTextPx, layout: spec.display.layout,
      maxWidthPx: spec.display.maxWidthPx ?? Math.max(...spec.display.widths) };
    report.figureApprovalReuse.push({ id, review: figure.review, status: approved.status,
      sourceInventoryAccepted: true, originalPngOpened: false, gridInventory: spec.objects
        .filter(item => item.type === 'grid').map(({ id, bounds, xStep, yStep }) =>
          ({ id, bounds, xStep, yStep })), labels: figureContracts[id].labels.length });
  }
`);
