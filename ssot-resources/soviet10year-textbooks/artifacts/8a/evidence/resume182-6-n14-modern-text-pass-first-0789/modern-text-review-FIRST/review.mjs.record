const passStdout = read(`${work}/stages/modern-finalize-AFFECTED-tag1/stdout.txt`).toString('utf8');
read(`${work}/stages/modern-finalize-FIRST/stderr.txt`);
read(`${work}/stages/modern-finalize-AFFECTED-tag1/stderr.txt`);
const recovery = json(`${work}/modern-tag-recovery.record`);
const retention = json(`${retainedDir}/retention.record`);
const firstLessonPath = `${retainedDir}/modern-FIRST/adapt/8a/modern-us-neutral/lessons/${lessonId}/lesson.template.json.record`;
const firstLesson = json(firstLessonPath);
check('retained native FIRST failure and affected-tag1 success are genuine named receipts', () => {
  assert.equal(bound(passReceiptPath).sha256, 'b33490869c1b8b5079b9fb9353083e4c6bd512f5ec531a3c3afd193d639b0267');
  assert.equal(passReceipt.returncode, 0);
  assert.equal(firstReceipt.returncode, 2);
  assert.equal(bound(`${work}/stages/modern-finalize-FIRST/receipt.record`).sha256, recovery.receiptSHA256);
  assert.equal(firstReceipt.cwd, root);
