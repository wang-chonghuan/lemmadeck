// Derive this lesson's interval and coverage directly from the approved page stream.
const selected = [];
let active = false;
let closed = false;
for (const n of pageNumbers) {
  const page = pages.get(n);
  for (let i = 0; i < page.blocks.length; i++) {
    const block = page.blocks[i];
    const ref = `p${String(n).padStart(4, '0')}#${i + 1}`;
    if (block.kind === 'h3') {
      if (active) {
        closed = true;
        active = false;
        break;
      }
      if (block.lines.join('') === rawLesson.printed_title) active = true;
    }
    if (active && block.kind !== 'foot') selected.push({ ref, block, page: n });
  }
  if (closed) break;
}
const allBlocks = new Map(pageNumbers.flatMap((n) => pages.get(n).blocks.map(
  (block, i) => [`p${String(n).padStart(4, '0')}#${i + 1}`, block],
)));
const joined = (refs) => refs.map(
  (ref) => allBlocks.get(ref).lines.join(''),
).join('').replaceAll('\u21b5', '');
const coverage = {
  start: selected[0]?.ref,
  last: selected.at(-1)?.ref,
  excludedRight: 'p0091#6',
  proseRefs: rawLesson.prose.flatMap((block) => block.source_refs),
  exerciseRefs: rawExercises.exercises.flatMap((exercise) => exercise.pages),
  groupRefs: selected.filter(({ block }) => block.kind === 'exhead').map(({ ref }) => ref),
};
check('complete authoritative interval, all prose and exercises covered once', () => {
  assert(closed);
  assert.equal(coverage.start, 'p0088#2');
  assert.equal(coverage.last, 'p0091#5');
  assert.equal(allBlocks.get('p0091#6').kind, 'h3');
  assert.deepEqual(
    coverage.proseRefs,
    selected.filter(({ block }) => block.kind === 'p').map(({ ref }) => ref),
  );
  assert.deepEqual(
    coverage.exerciseRefs,
    selected.filter(({ block }) => block.kind === 'ex').map(({ ref }) => ref),
  );
  assert.deepEqual(coverage.groupRefs, ['p0091#4']);
  const refs = [...coverage.proseRefs, ...coverage.exerciseRefs];
  assert.equal(new Set(refs).size, refs.length);
  for (const block of rawLesson.prose) {
    assert.equal(block.text, joined(block.source_refs));
  }
  for (const exercise of rawExercises.exercises) {
    assert.equal(exercise.text, joined(exercise.pages));
    assert.equal(exercise.number, allBlocks.get(exercise.pages[0]).label);
  }
  assert.deepEqual(rawLesson.prose[18].source_refs, ['p0089#9', 'p0090#1']);
  assert(allBlocks.get('p0089#9').open && allBlocks.get('p0090#1').cont);
  assert.deepEqual(rawExercises.exercises[5].pages, ['p0090#7', 'p0091#1']);
  assert(allBlocks.get('p0090#7').open && allBlocks.get('p0091#1').cont);
  assert.equal(rawExercises.exercises[8].group, allBlocks.get('p0091#4').lines.join(''));
  assert.equal(rawExercises.exercises[8].group_id, 'g1');
});
const erratum = templates.lesson.errata[0];
check('one registered correction: all page/block/hash/original/corrected bindings', () => {
  assert.equal(templates.lesson.errata.length, 1);
  const page = pages.get(89);
  const declaration = page.meta.errata[0];
  assert.equal(page.meta.errata.length, 1);
  assert.equal(erratum.id, 'p0089-converse-subscript-1');
  assert.equal(erratum.target, 'lesson.prose[17]');
  assert.equal(erratum.source.page, 89);
  assert.equal(erratum.source.printed_page, page.meta.printed_page);
  assert.equal(erratum.source.block, 'p0089#8');
  assert.equal(erratum.source.sha256, bound(`${bookRoot}/pages/0089/page.json`).sha256);
  assert.equal(erratum.source.pdf_sha256, page.meta.source.pdf_sha256);
  assert.equal(erratum.source.pdf_sha256, '5978388efc80df4085400f80d5912f710efb052a806222633b172b0a9479b071');
  assert.equal(erratum.id, declaration.id);
  assert.equal(erratum.source.block, declaration.block);
  assert.equal(erratum.original, declaration.original);
  assert.equal(erratum.reason, declaration.reason);
  assert.equal(erratum.original, '$2a_n=a_{1-1}+a_{n+1}$');
  assert.equal(erratum.corrected, '$2a_n=a_{n-1}+a_{n+1}$');
  assert.equal(joined(['p0089#8']).split(erratum.original).length - 1, 1);
  assert.equal(rawLesson.prose[17].text.split(erratum.original).length - 1, 1);
  assert.deepEqual(templates.lesson.prose[17].source_refs, ['p0089#8']);
  assert.deepEqual(templates.lesson.prose[17].changes, ['layout', 'math-correction']);
  assert(!templates.lesson.prose[17].text.includes(erratum.original));
  assert(templates.lesson.prose[17].text.includes(erratum.corrected));
});

const cyrillic = ['\u0430', '\u0431', '\u0432', '\u0433', '\u0434', '\u0435'];
function latinEnums(text) {
  return text.replace(/([\u0430\u0431\u0432\u0433\u0434\u0435])\)/g,
    (_, label) => `${String.fromCharCode(97 + cyrillic.indexOf(label))})`);
}
const compact = (text) => text.replace(/\s+/g, '');
const formulas = (text) => [...text.matchAll(/\$([^$]*)\$/g)].map((match) => match[1]);
function sameFields(modern, raw, ignored) {
  for (const [key, value] of Object.entries(raw)) {
    if (!ignored.includes(key)) assert.deepEqual(modern[key], value, key);
  }
}
check('every prose sentence/formula preserved except the registered replacement', () => {
  for (let i = 0; i < rawLesson.prose.length; i++) {
    const raw = rawLesson.prose[i];
    const modern = templates.lesson.prose[i];
    const expected = i === 17 ? raw.text.replace(erratum.original, erratum.corrected) : raw.text;
    assert.equal(modern.source_text, raw.text);
    assert.equal(compact(modern.text), compact(expected), `prose[${i}]`);
    assert.deepEqual(formulas(modern.text), formulas(expected), `prose[${i}] formulas`);
    sameFields(modern, raw, ['text']);
    assert.deepEqual(modern.numeric_changes, []);
    assert.deepEqual(modern.historical_entities, []);
    const changed = modern.text !== raw.text;
    assert.deepEqual(
      modern.changes,
      i === 17 ? ['layout', 'math-correction'] : changed ? ['layout'] : [],
    );
  }
  sameFields(templates.lesson, rawLesson, ['prose']);
  const conditions = templates.lesson.prose[7].text.split('\n');
  assert.equal(conditions.length, 2);
  assert(conditions[0].startsWith('1) ') && conditions[1].startsWith('2) '));
});
const exerciseReview = [];
check('nine stable exercise IDs; every subpart ordered, independent and complete', () => {
  const ids = Array.from({ length: 9 }, (_, i) => String(223 + i));
  assert.deepEqual(templates.exercises.exercises.map((exercise) => exercise.number), ids);
  assert.equal(new Set(ids).size, 9);
  assert.equal(templates.exercises.count, 9);
  for (let i = 0; i < ids.length; i++) {
    const raw = rawExercises.exercises[i];
    const modern = templates.exercises.exercises[i];
    assert.equal(modern.source_text, raw.text);
    assert.equal(compact(modern.text), compact(latinEnums(raw.text)), ids[i]);
    assert.deepEqual(formulas(modern.text), formulas(raw.text), `${ids[i]} formulas`);
    assert.deepEqual(modern.lines, modern.text.split('\n'));
    sameFields(modern, raw, ['text', 'lines']);
    assert.equal(modern.source_number, ids[i]);
    const labels = [...modern.text.matchAll(/^([a-z])\) /gm)].map((match) => match[1]);
    const rawLabels = [...raw.text.matchAll(/([\u0430\u0431\u0432\u0433\u0434\u0435])\)/g)];
    assert.equal(labels.length, rawLabels.length);
    assert.deepEqual(labels, Array.from({ length: labels.length }, (_, j) => String.fromCharCode(97 + j)));
    assert.equal(modern.lines.length, labels.length ? labels.length + 1 : 1);
    assert(modern.lines[0].startsWith(`${ids[i]}. `));
    assert.deepEqual(modern.changes, labels.length ? ['layout', 'enum-latin'] : []);
    assert.deepEqual(modern.numeric_changes, []);
    assert.deepEqual(modern.historical_entities, []);
    exerciseReview.push({ number: ids[i], source_refs: modern.pages, subparts: labels, formulas: formulas(modern.text).length });
  }
  assert(templates.exercises.exercises[5].text.includes('$c_7,c_5,c_{10}$'));
});
check('no invented cultural text/numbers, answer payload, incomplete formula or source line marker', () => {
  for (const block of [...templates.lesson.prose, ...templates.exercises.exercises]) {
    assert(!/[\u0400-\u04ff\u21b5\u3000]|<\/?[a-z][^>]*>/i.test(block.text));
    assert.equal((block.text.match(/\$/g) || []).length % 2, 0);
    for (const formula of formulas(block.text)) {
      assert(!/[\u3001\uff0c\uff1b\u3002\uff1f\uff01\uff1a]/.test(formula));
      let depth = 0;
      for (const char of formula) {
        if (char === '{') depth++;
        if (char === '}') depth--;
        assert(depth >= 0);
      }
      assert.equal(depth, 0);
    }
    for (const key of ['answer', 'answers', 'answerKey', 'solution', 'correct_index', 'accept', 'interaction']) {
      assert(!Object.hasOwn(block, key));
    }
  }
});
check('current ready JSON is exactly current normalized templates modulo native status only', () => {
  for (const name of ['lesson', 'exercises', 'figures']) {
    assert.equal(templates[name].status, 'draft');
    assert.equal(finals[name].status, 'ready');
    assert.deepEqual(finals[name], { ...templates[name], status: 'ready' });
  }
});

const formatRecord = json(`${work}/modern-format-FIRST/result.record`);
const flowText = read(`${work}/modern-format-FIRST/flow.stdout.record`).toString('utf8');
const nativeParagraphs = [];
const nativeBoundaries = [];
for (const line of flowText.trimEnd().split('\n')) {
  const header = line.match(/^\[(\d+)\] (.*)$/);
  if (header) {
    assert.equal(Number(header[1]), nativeParagraphs.length);
    nativeParagraphs.push(header[2]);
  } else if (line.startsWith('    break: ')) {
    nativeBoundaries.push(JSON.parse(line.slice('    break: '.length)));
  } else {
    assert(nativeParagraphs.length);
    nativeParagraphs[nativeParagraphs.length - 1] += `\n${line}`;
  }
}
check('three semantic anchors selected from actual retained native proseFlow', () => {
  expectBinding(`${work}/modern-format-FIRST/flow.stdout.record`, formatRecord.flow.stdout);
  assert.equal(formatRecord.flow.returncode, 0);
  assert.equal(formatRecord.normalization.returncode, 0);
  assert.equal(nativeParagraphs.length, 20);
  assert.equal(nativeParagraphs.join('\n\n'), templates.lesson.prose.map((block) => block.text).join('\n\n'));
  assert.deepEqual(templates.lesson.section_breaks, formatRecord.selected);
  assert.equal(templates.lesson.section_breaks.length, 3);
  for (const boundary of templates.lesson.section_breaks) {
    assert(nativeBoundaries.some((candidate) => JSON.stringify(candidate) === JSON.stringify(boundary)));
  }
  assert.deepEqual(audit.resolvedSectionBreaks.map(({ before, after }) => ({ before, after })), templates.lesson.section_breaks);
  for (const { index, before, after } of audit.resolvedSectionBreaks) {
    assert.equal(nativeParagraphs[index - 1], before);
    assert.equal(nativeParagraphs[index], after);
  }
});
