check('independent symbolic verification of registered mean-to-converse correction', () => {
  const halfMean = [0.5, 0, 0.5];
  assert.deepEqual(halfMean.map((coefficient) => coefficient * 2), [1, 0, 1]);
  const doubledMeanResidual = [-1, 2, -1];
  const adjacentDifferenceResidual = [-1, 1, 0].map(
    (coefficient, i) => coefficient - [0, -1, 1][i],
  );
  assert.deepEqual(doubledMeanResidual, adjacentDifferenceResidual);
  assert(templates.lesson.prose[17].text.includes('$(n\\geqslant2)$'));
  assert(templates.lesson.prose[17].text.includes('$a_n=\\frac{a_{n-1}+a_{n+1}}{2}$'));
  assert(templates.lesson.prose[17].text.includes('$a_n-a_{n-1}=a_{n+1}-a_n$'));
});

// Detect concurrent changes without invoking any producer or prior validator.
check('all inspected text and record bytes remain stable at checker completion', () => {
  for (const binding of [...bindings.values()]) {
    const bytes = readFileSync(binding.path);
    assert.equal(bytes.length, binding.bytes);
    assert.equal(createHash('sha256').update(bytes).digest('hex'), binding.sha256);
  }
});
