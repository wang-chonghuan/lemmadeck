import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
const work = '.tmp/resume182-6-8a-n14-0789';
const bookRoot = 'ssot-resources/soviet10year-textbooks/artifacts/8a';
const lessonId = 'alg8-c3-s2-n14';
const rawDir = `${bookRoot}/lessons/${lessonId}`;
const templateDir = `${work}/modern-FIRST/adapt/8a/modern-us-neutral/lessons/${lessonId}`;
const finalDir = `${bookRoot}/editions/modern-us-neutral/lessons/${lessonId}`;
const retainedDir = `${bookRoot}/evidence/resume182-6-n14-source-pass-and-modern-failure-first-0789`;
const bindings = new Map();
const checks = [];
const blockers = [];

assert.equal(process.cwd(), root);
function read(path) {
  const absolute = resolve(root, path);
  assert(absolute.startsWith(`${root}/`));
  assert(!/\.(?:png|jpg|jpeg|svg|webp|pdf)$/i.test(absolute));
  const bytes = readFileSync(absolute);
  bindings.set(absolute, {
    path: absolute,
    sha256: createHash('sha256').update(bytes).digest('hex'),
    bytes: bytes.length,
  });
  return bytes;
}
const json = (path) => JSON.parse(read(path).toString('utf8'));
function check(name, fn) {
  try {
    fn();
    checks.push({ name, status: 'PASS' });
  } catch (error) {
    const finding = { name, status: 'FAIL', message: error.message };
    checks.push(finding);
    blockers.push(finding);
  }
}
function bound(path) {
  const absolute = resolve(root, path);
  if (!bindings.has(absolute)) read(path);
  return bindings.get(absolute);
}
function expectBinding(path, expected) {
  const actual = bound(path);
  assert.equal(actual.sha256, expected.sha256);
  assert.equal(actual.bytes, expected.bytes);
}
const sourcePath = `${work}/source-review-FIRST/result-affected-glyph1.record`;
const source = json(sourcePath);
const rawLesson = json(`${rawDir}/lesson.json`);
const rawExercises = json(`${rawDir}/exercises.json`);
const rawMD = read(`${rawDir}/lesson.md`);
const templates = Object.fromEntries(['lesson', 'exercises', 'figures'].map(
  (name) => [name, json(`${templateDir}/${name}.template.json`)],
));
const finals = Object.fromEntries(['lesson', 'exercises', 'figures'].map(
  (name) => [name, json(`${finalDir}/${name}.json`)],
));
const audit = json(`${finalDir}/adaptation.audit.json`);
const pageNumbers = [88, 89, 90, 91];
const pages = new Map(pageNumbers.map((n) => [
  n, json(`${bookRoot}/pages/${String(n).padStart(4, '0')}/page.json`),
]));
const sourceBindingMap = new Map(source.bindings.map((entry) => [entry.path, entry]));
check('closed SOURCE_PASS identity and supplied SHA', () => {
  assert.equal(bound(sourcePath).sha256, '973f9f75b47a086cc17a57d3f8794e4048fccf0c3dfe66c1e998ca887b1f311b');
  assert.equal(source.status, 'SOURCE_PASS');
  assert.equal(source.book, '8a');
  assert.equal(source.lesson, lessonId);
  assert.deepEqual(source.blockers, []);
});
check('current page text/JSON/audit bytes match approved source bindings', () => {
  for (const n of pageNumbers) {
    for (const file of ['page.md', 'page.json', 'audit.json']) {
      const path = `${bookRoot}/pages/${String(n).padStart(4, '0')}/${file}`;
      const expected = sourceBindingMap.get(resolve(root, path));
      assert(expected, path);
      expectBinding(path, expected);
    }
  }
});
check('current raw lesson objects match approved affected assembly bytes', () => {
  for (const file of ['lesson.json', 'lesson.md', 'exercises.json']) {
    const approved = `${work}/assembly-AFFECTED-glyph1/artifacts/8a/lessons/${lessonId}/${file}`;
    const expected = sourceBindingMap.get(resolve(root, approved));
    assert(expected, approved);
    expectBinding(approved, expected);
    assert(read(`${rawDir}/${file}`).equals(read(approved)));
  }
  assert(rawMD.length > 0);
});
check('raw snapshots and source SHAs match current raw files exactly', () => {
  for (const [name, raw] of [['lesson', rawLesson], ['exercises', rawExercises]]) {
    const template = templates[name];
    assert.equal(template.source.path, `lessons/${lessonId}/${name}.json`);
    assert.equal(template.source.sha256, bound(`${rawDir}/${name}.json`).sha256);
    assert.deepEqual(template.source.data, raw);
  }
  assert.equal(rawLesson.prose.length, 19);
  assert.equal(rawExercises.exercises.length, 9);
  assert.equal(rawLesson.card_id, lessonId);
  assert.equal(rawLesson.number, '14');
