  assert(firstStdout.includes('lesson.prose[17]') && firstStdout.includes('math-correction'));
  assert(passStdout.includes('PASS') && passStdout.includes('8/19') && passStdout.includes('7/9'));
  const entry = retention.entries.find((candidate) => candidate.path === firstLessonPath);
