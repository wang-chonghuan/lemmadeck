  "questions": [
    {
      "id": "pair-intersection",
      "intent": {
        "task": "按同一不等式组判断全部四个原给定数对，须同时满足两个条件并区分严格与非严格边界。",
        "source_solution": "(0,0)的两个左端值为0和0，均满足；(-1,0.5)的两个左端值为-0.5和1.25，均满足；(1,-1)的两个左端值为-1和2，第一条件的严格不等号不满足；(1/3,1)的两个左端值为11/3和10/9，均满足。完整解答为前三者中的前两者及最后一个数对属于，(1,-1)不属于。",
        "unit_reason": "四个数对服从同一判定定义，一道原生多选保留全部逐点判定，不拆为四个是非点击。",
        "concept_blocks": [
          1
        ],
        "limitations": [],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "A",
          "B",
          "D"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "2(0)+3(0)=0>-1，0^2+0^2=0<=2，两个条件同时成立。",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "2(-1)+3(0.5)=-0.5>-1，(-1)^2+0.5^2=1.25<=2。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "2(1)+3(-1)=-1，等于而非大于-1；平方和2虽满足第二条件，仍不是组的解。",
            "misconception": "把2x+3y>-1误读为2x+3y>=-1，得到-1>=-1及2<=2，遂错误选中此数对。"
          },
          {
            "option_id": "D",
            "truth": "correct",
            "derivation": "2/3+3=11/3>-1，1/9+1=10/9<=2。",
            "misconception": null
          }
        ]
      }
    },
    {
      "id": "strip-membership",
      "intent": {
        "task": "判断四个原点在闭合斜带中的归属，包含边界点和大坐标点。",
        "source_solution": "原组等价于-4<=y-x<=4。A的y-x=5，不属于；B的差为4，在上边界，属于；C的差为40，不属于；D的差为2，属于。因此完整真集合为B与D。",
        "unit_reason": "这是一个共同闭带条件下的全体点判定，用一道原生多选检验全部归属，避免按印刷小问逐个点击。",
        "concept_blocks": [
          1
        ],
        "limitations": [],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "B",
          "D"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "5<=0+4不成立，尽管5>=0-4成立，A仍不属于交集。",
            "misconception": "只检查下界y>=x-4，代入得5>=-4便选中，漏掉5<=4的上界检验。"
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "3<=-1+4=3且3>=-1-4=-5，非严格上边界包含此点。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "20<=-20+4=-16不成立；y-x=40超出允许区间。",
            "misconception": "把移项后的y-x误算为y+x，得20+(-20)=0，再以-4<=0<=4错误认定属于。"
          },
          {
            "option_id": "D",
            "truth": "correct",
            "derivation": "102<=104且102>=96，或y-x=2介于-4与4之间。",
            "misconception": null
          }
        ]
      }
    },
    {
