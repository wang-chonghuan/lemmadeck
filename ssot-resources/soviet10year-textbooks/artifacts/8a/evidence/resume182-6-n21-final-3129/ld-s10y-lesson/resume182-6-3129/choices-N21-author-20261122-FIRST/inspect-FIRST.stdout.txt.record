{
  "exercises": [
    {
      "number": "425",
      "text": "425. \u6570\u548c\u6570\u4e4b\u95f4\u7684\u5173\u7cfb\u7531\u4e0b\u5217\u6570\u5bf9\u7684\u96c6\u5408\u8868\u793a\uff1a\na) $\\{(1,20),(2,30),(3,40),(4,50),(5,50)\\}$\uff1b\nb) $\\{(\\frac{1}{2},3),(\\frac{1}{3},4),(\\frac{2}{3},5),(\\frac{1}{4},5),(\\frac{3}{4},7)\\}$. \u7528\u7bad\u5934\u53f7\u8868\u793a\u5df2\u77e5\u5173\u7cfb\u548c\u5df2\u77e5\u5173\u7cfb\u7684\u76f8\u53cd\u5173\u7cfb. \u5df2\u77e5\u5173\u7cfb\u548c\u5df2\u77e5\u5173\u7cfb\u7684\u76f8\u53cd\u5173\u7cfb\u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "426",
      "text": "426. \u6570\u548c\u6570\u4e4b\u95f4\u7684\u5173\u7cfb\u7531\u4e0b\u5217\u6570\u5bf9\u7684\u96c6\u5408\u8868\u793a\uff1a\na) $\\{(\\sqrt{2},7),(\\sqrt{3},8),(\\sqrt{5},10),(\\sqrt{6},11),(\\sqrt{7},12)\\}$\uff1b\nb) $\\{(0.3,1),(\\sqrt{10},0),(-2,1),(\\sqrt{6},0),(13,1)\\}$\uff1b\nc) $\\{(1,12),(2,6),(3,4),(4,3),(6,2),(12,1)\\}$. \u7528\u6570\u5bf9\u7684\u96c6\u5408\u8868\u793a\u5df2\u77e5\u5173\u7cfb\u7684\u76f8\u53cd\u5173\u7cfb. \u6307\u51fa\u5df2\u77e5\u5173\u7cfb\u548c\u5df2\u77e5\u5173\u7cfb\u7684\u76f8\u53cd\u5173\u7cfb\u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df.",
      "figure_ids": []
    },
    {
      "number": "427",
      "text": "427. \u6307\u51fa\u4e0b\u5217\u5173\u7cfb\u7684\u76f8\u53cd\u5173\u7cfb\uff1a\na) \u7f8e\u56fd\u57ce\u5e02\u4e4b\u95f4\uff0c\u201c\u7532\u57ce\u4f4d\u4e8e\u4e59\u57ce\u4ee5\u5317\u201d\u7684\u5173\u7cfb\uff1b\nb) \u4eba\u4eec\u4e4b\u95f4\u7684\u201c\u5e74\u957f\u201d\u5173\u7cfb\uff1b\nc) \u201c\u4e00\u4e2a\u6570\u6bd4\u53e6\u4e00\u4e2a\u6570\u591a2\u201d\u7684\u5173\u7cfb\uff1b\nd) \u201c\u4e00\u4e2a\u6b63\u6570\u7b49\u4e8e\u53e6\u4e00\u4e2a\u6b63\u6570\u7684 $\\frac{1}{5}$\u201d\u7684\u5173\u7cfb.",
      "figure_ids": []
    },
    {
      "number": "428",
      "text": "428. \u6570\u548c\u6570\u4e4b\u95f4\u7684\u5173\u7cfb\u7528\u7bad\u5934\u53f7\u7ed9\u51fa\uff08\u56fe41\uff09. \u4f5c\u51fa\u8fd9\u4e2a\u5173\u7cfb\u548c\u5b83\u7684\u76f8\u53cd\u5173\u7cfb\u7684\u56fe\u8c61. \u5df2\u77e5\u5173\u7cfb\u548c\u5df2\u77e5\u5173\u7cfb\u7684\u76f8\u53cd\u5173\u7cfb\u662f\u51fd\u6570\u5417\uff1f",
      "figure_ids": [
        "fig-41"
      ]
    },
    {
      "number": "429",
      "text": "429. \u5df2\u77e5\u70b9 $A(-8,1)$\uff0c$B(1,7)$\uff0c$C(0,9)$ \u5c5e\u4e8e\u5173\u7cfb $f$ \u7684\u56fe\u8c61. \u6307\u51fa\u5c5e\u4e8e $f$ \u7684\u76f8\u53cd\u5173\u7cfb\u7684\u56fe\u8c61\u7684\u4efb\u4f55\u4e24\u70b9\u7684\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "430",
      "text": "430. \u5173\u7cfb $f$ \u7684\u56fe\u8c61\u662f\u7ebf\u6bb5 $AB$\uff0c\u5176\u4e2d $A$ \u70b9\u7684\u5750\u6807\u662f $(-3,2)$\uff0c$B$ \u70b9\u7684\u5750\u6807\u662f $(4,5)$. \u5728\u540c\u4e00\u5750\u6807\u7cfb\u4e2d\u4f5c\u51fa\u5173\u7cfb $f$ \u7684\u56fe\u8c61\u548c\u5b83\u7684\u76f8\u53cd\u5173\u7cfb\u7684\u56fe\u8c61. \u6c42\u51fa\u5173\u7cfb $f$ \u548c $f$ \u7684\u76f8\u53cd\u5173\u7cfb\u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df.",
      "figure_ids": []
    },
    {
      "number": "431",
      "text": "431. \u51fd\u6570\u7684\u56fe\u8c61\u662f\u4f4d\u4e8e\u4e0a\u534a\u5e73\u9762\u7684\uff0c\u5706\u5fc3\u5728\u5750\u6807\u539f\u70b9\u3001\u534a\u5f84\u7b49\u4e8e3\u7684\u534a\u5706\u5468. \u4f5c\u51fa\u8fd9\u4e2a\u51fd\u6570\u7684\u76f8\u53cd\u5173\u7cfb\u7684\u56fe\u8c61\uff0c\u5e76\u8bf4\u660e\u8fd9\u4e2a\u5173\u7cfb\u662f\u4e0d\u662f\u51fd\u6570.",
      "figure_ids": []
    },
    {
      "number": "432",
      "text": "432. \u5173\u7cfb\u7531\u4e0b\u5217\u65b9\u7a0b\u7ed9\u51fa\uff1a\na) $x-5y=3$\uff1b\nb) $x+3y=1$\uff1b\nc) $x+y=5$\uff1b\nd) $x^2-y=0$\uff1b\ne) $2x^2+5x=y-y^2$\uff1b\nf) $xy=10$\uff1b\ng) $x^2+y^2=9$\uff1b\nh) $x^2-y^2=12$\uff1b\ni) $x^2-y^2=0$. \u7528\u65b9\u7a0b\u7ed9\u51fa\u5df2\u77e5\u5173\u7cfb\u7684\u76f8\u53cd\u5173\u7cfb. \u5728\u4e0a\u9762\u5217\u4e3e\u7684\u5173\u7cfb\u5f53\u4e2d\uff0c\u6307\u51fa\u672c\u8eab\u5c31\u662f\u5b83\u81ea\u5df1\u7684\u76f8\u53cd\u5173\u7cfb\u7684\u5173\u7cfb.",
      "figure_ids": []
    },
    {
      "number": "433",
      "text": "433. \u5173\u7cfb $h$ \u7531\u4e0b\u5217\u65b9\u7a0b\u7ed9\u51fa\uff1a\na) $x-2y=4$\uff1b\nb) $\\frac{x}{2}-\\frac{y}{3}=1$\uff1b\nc) $y=x^2$\uff1b\nd) $(x-2)^2+y=0$. \u4f5c\u51fa\u5173\u7cfb $h$ \u7684\u56fe\u8c61\u548c $h$ \u7684\u76f8\u53cd\u5173\u7cfb $p$ \u7684\u56fe\u8c61. \u7528\u65b9\u7a0b\u7ed9\u51fa\u5173\u7cfb $p$.",
      "figure_ids": []
    },
    {
      "number": "434",
      "text": "434. \u7ea6\u5206\uff1a\na) $\\frac{(b+4)^2-1}{b^3+125}$\uff1b\nb) $\\frac{(p-5)^2-4}{27-p^3}$\uff1b\nc) $\\frac{(x-2)^3+27}{x^3+1}$\uff1b\nd) $\\frac{(a+1)^3+1}{a^3-1}$.",
      "figure_ids": []
    },
    {
      "number": "435",
      "text": "435. \u8ba1\u7b97\uff1a\na) $8^{-3}\\cdot(\\frac{1}{2})^{-10}$\uff1b\nb) $81^5\\cdot9^{-11}$\uff1b\nc) $1.5^3\\cdot(\\frac{3}{8})^{-1}+(-\\frac{1}{3})^{-1}$.",
      "figure_ids": []
    }
  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "\u56fe34\u4e2d\u5229\u7528\u7bad\u5934\u53f7\u7ed9\u51fa\u4e86\u96c6\u5408 $X$ \u7684\u5143\u7d20\u4e0e\u96c6\u5408 $Y$ \u7684\u5143\u7d20\u4e4b\u95f4\u7684\u5173\u7cfb $p$\u3002\n\u6539\u53d8\u7bad\u5934\u53f7\u7684\u65b9\u5411\uff08\u56fe35\uff09\u540e\uff0c\u5f97\u5230\u53e6\u4e00\u4e2a\u5173\u7cfb\uff0c\u5c31\u662f\u96c6\u5408 $Y$ \u7684\u5143\u7d20\u4e0e\u96c6\u5408 $X$ \u7684\u5143\u7d20\u4e4b\u95f4\u7684\u5173\u7cfb $q$\u3002"
    },
    {
      "block": 5,
      "text": "\u6211\u4eec\u8bf4\uff0c$q$ \u662f\u5173\u7cfb $p$ \u7684\u76f8\u53cd\u5173\u7cfb\u3002\n\u540c\u6837\u5730\uff0c\u5173\u7cfb $p$ \u662f\u5173\u7cfb $q$ \u7684\u76f8\u53cd\u5173\u7cfb\u3002"
    },
    {
      "block": 6,
      "text": "\u5173\u7cfb $p$ \u7684\u5b9a\u4e49\u57df\u662f\u96c6\u5408 $\\{-3,-2,-1\\}$\uff0c\u503c\u57df\u662f\u96c6\u5408 $\\{2,3,4,5\\}$\u3002\n\u5bf9\u4e8e\u5173\u7cfb $p$ \u7684\u76f8\u53cd\u5173\u7cfb $q$\uff0c\u5b9a\u4e49\u57df\u662f\u96c6\u5408 $\\{2,3,4,5\\}$\uff0c\u503c\u57df\u662f\u96c6\u5408 $\\{-3,-2,-1\\}$\u3002\n\u56e0\u6b64\uff0c\u4e24\u4e2a\u4e92\u4e3a\u76f8\u53cd\u5173\u7cfb\u7684\u5b9a\u4e49\u57df\u548c\u503c\u57df\u53ea\u662f\u4ea4\u6362\u4e86\u4f4d\u7f6e\u3002"
    },
    {
      "block": 7,
      "text": "\u96c6\u5408 $X$ \u548c $Y$ \u7684\u5143\u7d20\u4e4b\u95f4\u7684\u5173\u7cfb $p$ \u7531\u4e0b\u5217\u6570\u5bf9\u7684\u96c6\u5408\u786e\u5b9a\uff1a\n$\\{(-3,2),(-2,3),(-1,4),(-1,5)\\}$\u3002"
    },
    {
      "block": 8,
      "text": "\u6539\u53d8\u6bcf\u4e00\u4e2a\u6570\u5bf9\u4e2d\u5143\u7d20\u7684\u4f4d\u7f6e\u540e\uff0c\u5f97\u5230\u7ed9\u51fa $p$ \u7684\u76f8\u53cd\u5173\u7cfb $q$ \u7684\u6570\u5bf9\u7684\u96c6\u5408\uff1a\n$\\{(2,-3),(3,-2),(4,-1),(5,-1)\\}$\u3002"
    },
    {
      "block": 9,
      "text": "\u4e00\u822c\u5730\uff0c\u5982\u679c\u4e00\u4e2a\u5173\u7cfb\u7531\u67d0\u4e2a\u6570\u5bf9\u7684\u96c6\u5408\u786e\u5b9a\uff0c\u90a3\u4e48\uff0c\u5b83\u7684\u76f8\u53cd\u5173\u7cfb\u5c31\u7531\u524d\u4e00\u96c6\u5408\u901a\u8fc7\u91cd\u65b0\u6392\u5217\u6bcf\u4e00\u6570\u5bf9\u4e2d\u7684\u5143\u7d20\u800c\u5f97\u5230\u7684\u6570\u5bf9\u7684\u96c6\u5408\u786e\u5b9a\u3002"
    },
    {
      "block": 10,
      "text": "\u6211\u4eec\u4e3e\u51fa\u51e0\u4e2a\u4e92\u4e3a\u76f8\u53cd\u5173\u7cfb\u7684\u4f8b\u5b50\u3002"
    },
    {
      "block": 11,
      "text": "\u4f8b1 \u56fe36\u4e2d\u7528\u7bad\u5934\u53f7\u7ed9\u51fa\u4e86\u96c6\u5408 $A=\\{5,7,10\\}$ \u548c $B=\\{2,3,8,12\\}$ \u7684\u5143\u7d20\u4e4b\u95f4\u7684\u201c\u5c0f\u4e8e\u201d\u5173\u7cfb\u3002"
    },
    {
      "block": 16,
      "text": "\u5b83\u7684\u76f8\u53cd\u5173\u7cfb\uff08\u56fe37\uff09\u662f\u96c6\u5408 $B$ \u7684\u5143\u7d20\u548c\u96c6\u5408 $A$ \u7684\u5143\u7d20\u4e4b\u95f4\u7684\u201c\u5927\u4e8e\u201d\u5173\u7cfb\u3002"
    },
    {
      "block": 17,
      "text": "\u4f8b2 \u81ea\u7136\u6570\u4e4b\u95f4\u7684\u201c\u7ea6\u6570\u201d\u548c\u201c\u500d\u6570\u201d\u5173\u7cfb\u4e92\u4e3a\u76f8\u53cd\u5173\u7cfb\u3002"
    },
    {
      "block": 18,
      "text": "\u5b9e\u9645\u4e0a\uff0c\u5982\u679c $a$ \u548c $b$ \u662f\u4e24\u4e2a\u81ea\u7136\u6570\uff0c\u5e76\u4e14 $a$ \u662f $b$ \u7684\u7ea6\u6570\uff0c\u90a3\u4e48 $b$ \u5c31\u662f $a$ \u7684\u500d\u6570\u3002\n\u53cd\u8fc7\u6765\uff0c\u5982\u679c $b$ \u662f $a$ \u7684\u500d\u6570\uff0c\u90a3\u4e48 $a$ \u5c31\u662f $b$ \u7684\u7ea6\u6570\u3002\n\u4f8b\u5982\uff0c\u7531\u201c2\u662f6\u7684\u7ea6\u6570\u201d\u5f97\u51fa\u201c6\u662f2\u7684\u500d\u6570\u201d\uff1b\n\n\u7531\u201c24\u662f8\u7684\u500d\u6570\u201d\u5f97\u51fa\u201c8\u662f24\u7684\u7ea6\u6570\u201d\u3002"
    },
    {
      "block": 19,
      "text": "\u73b0\u5728\uff0c\u6211\u4eec\u56de\u5230\u4e0a\u9762\u6240\u8ba8\u8bba\u7684\u4e92\u4e3a\u76f8\u53cd\u5173\u7cfb $p$ \u548c $q$\u3002"
    },
    {
      "block": 20,
      "text": "\u56fe38a\u4e2d\u4f5c\u51fa\u4e86\u5173\u7cfb $p$ \u7684\u56fe\u8c61\uff0c\u56fe38b\u4e2d\u4f5c\u51fa\u4e86\u5173\u7cfb $q$ \u7684\u56fe\u8c61\u3002"
    },
    {
      "block": 23,
      "text": "\u73b0\u5728\u6211\u4eec\u5728\u540c\u4e00\u5750\u6807\u7cfb\u4e0a\u4f5c\u51fa\u5173\u7cfb $p$ \u548c $q$ \u7684\u56fe\u8c61\uff08\u56fe39\uff09\uff1a"
    },
    {
      "block": 24,
      "text": "\u4e0d\u96be\u770b\u51fa\uff0c\u5750\u6807\u4e3a $(-3,2)$ \u548c $(2,-3)$\uff0c$(-1,4)$ \u548c $(4,-1)$ \u7b49\u7b49\u7684\u70b9\uff0c\u4e5f\u5c31\u662f\u7b2c\u4e00\u4e2a\u70b9\u7684\u6a2a\u5750\u6807\u662f\u7b2c\u4e8c\u4e2a\u70b9\u7684\u7eb5\u5750\u6807\u800c\u7b2c\u4e00\u4e2a\u70b9\u7684\u7eb5\u5750\u6807\u662f\u7b2c\u4e8c\u4e2a\u70b9\u7684\u6a2a\u5750\u6807\u7684\u4e24\u4e2a\u70b9\u5173\u4e8e\u76f4\u7ebf $y=x$ \u662f\u5bf9\u79f0\u7684\u3002\n\u5173\u7cfb $p$ \u7684\u56fe\u8c61\u4e0a\u6bcf\u4e00\u70b9\u4e0e\u5173\u7cfb $q$ \u7684\u56fe\u8c61\u4e0a\u5173\u4e8e\u76f4\u7ebf $y=x$ \u7684\u5bf9\u79f0\u70b9\u76f8\u5bf9\u5e94\u3002\n\n\u53cd\u8fc7\u6765\uff0c\u5173\u7cfb $q$ \u7684\u56fe\u8c61\u4e0a\u6bcf\u4e00\u70b9\u4e0e\u5173\u7cfb $p$ \u7684\u56fe\u8c61\u4e0a\u5173\u4e8e\u76f4\u7ebf $y=x$ \u7684\u5bf9\u79f0\u70b9\u76f8\u5bf9\u5e94\u3002\n\u56e0\u6b64\uff0c\u5173\u7cfb $p$ \u548c $q$ \u7684\u56fe\u8c61\u5173\u4e8e\u76f4\u7ebf $y=x$ \u662f\u5bf9\u79f0\u7684\u3002"
    },
    {
      "block": 27,
      "text": "\u4e00\u822c\u5730\uff0c\u4e0b\u8ff0\u5b9a\u7406\u6210\u7acb\uff1a"
    },
    {
      "block": 28,
      "text": "\u6570\u548c\u6570\u4e4b\u95f4\u7684\u4e92\u4e3a\u76f8\u53cd\u5173\u7cfb\u7684\u56fe\u8c61\u5173\u4e8e\u76f4\u7ebf $y=x$ \u662f\u5bf9\u79f0\u7684\u3002"
    },
    {
      "block": 29,
      "text": "\u6211\u4eec\u6765\u770b\u65b9\u7a0b"
    },
    {
      "block": 30,
      "text": "$2x-y=0$ \uff081\uff09\u3002"
    },
    {
      "block": 31,
      "text": "\u8fd9\u4e2a\u65b9\u7a0b\u7ed9\u51fa\u4e86\u53d8\u91cf $x$ \u7684\u503c\u548c\u53d8\u91cf $y$ \u7684\u503c\u4e4b\u95f4\u7684\u67d0\u4e2a\u5173\u7cfb\u3002\n\u6211\u4eec\u7528\u5b57\u6bcd $f$ \u8868\u793a\u8fd9\u4e2a\u5173\u7cfb\u3002"
    },
    {
      "block": 32,
      "text": "\u56fe40\u4e2d\u4f5c\u51fa\u4e86\u5173\u7cfb $f$ \u7684\u56fe\u8c61\u548c\u5b83\u7684\u76f8\u53cd\u5173\u7cfb $g$ \u7684\u56fe\u8c61\u3002\n\u5173\u7cfb $g$ \u7684\u56fe\u8c61\u662f\u8fc7\u5750\u6807\u539f\u70b9\u548c\u5750\u6807\u4e3a $(4,2)$ \u8fd9\u4e00\u70b9\u7684\u76f4\u7ebf\u3002\n\u4e8e\u662f\uff0c\u5173\u7cfb $g$ \u7684\u56fe\u8c61\u53ef\u80fd\u7531\u65b9\u7a0b $y=\\frac{1}{2}x$ \u6216\u8005\u7531\u548c\u5b83\u540c\u89e3\u7684\u65b9\u7a0b $2y-x=0$ \uff082\uff09\u7ed9\u51fa\u3002"
    },
    {
      "block": 35,
      "text": "\u6bd4\u8f83\u7ed9\u51fa\u5173\u7cfb $f$ \u7684\u65b9\u7a0b\uff081\uff09\u548c\u7ed9\u51fa\u5b83\u7684\u76f8\u53cd\u5173\u7cfb $g$ \u7684\u65b9\u7a0b\uff082\uff09\u540e\uff0c\u6211\u4eec\u53d1\u73b0\uff0c\u5728\u65b9\u7a0b\uff081\uff09\u4e2d\u7528 $y$ \u66ff\u6362 $x$ \u5e76\u7528 $x$ \u66ff\u6362 $y$\uff0c\u4fbf\u53ef\u5f97\u51fa\u65b9\u7a0b\uff082\uff09\u3002"
    },
    {
      "block": 36,
      "text": "\u4e00\u822c\u5730\uff0c\u5982\u679c\u67d0\u4e2a\u5173\u7cfb $f$ \u7531\u542b\u4e24\u4e2a\u53d8\u91cf $x$ \u548c $y$ \u7684\u65b9\u7a0b\u7ed9\u51fa\uff0c\u90a3\u4e48\u4e3a\u4e86\u7528\u65b9\u7a0b\u7ed9\u51fa $f$ \u7684\u76f8\u53cd\u5173\u7cfb\uff0c\u53ea\u8981\u5728\u5df2\u77e5\u65b9\u7a0b\u4e2d\u7528 $y$ \u66ff\u6362 $x$ \u5e76\u7528 $x$ \u66ff\u6362 $y$ \u5c31\u884c\u4e86\u3002"
    },
    {
      "block": 37,
      "text": "\u6211\u4eec\u770b\u5230\uff0c\u7531\u540c\u4e00\u4e2a\u4e8c\u5143\u65b9\u7a0b\u53ef\u4ee5\u7ed9\u51fa\u4e24\u4e2a\u4e92\u4e3a\u76f8\u53cd\u7684\u5173\u7cfb\u3002\n\u4f8b\u5982\uff0c\u7531\u65b9\u7a0b $x+2y=12$ \u53ef\u4ee5\u7ed9\u51fa\u7531 $(x,y)$ \u8fd9\u79cd\u5f62\u5f0f\u7684\u6570\u5bf9\u7684\u96c6\u5408\u786e\u5b9a\u7684\u5173\u7cfb $f$\uff0c\u5176\u4e2d\u6bcf\u4e00\u4e2a\u6570\u5bf9\u90fd\u4f7f\u8fd9\u4e2a\u65b9\u7a0b\u53d8\u6210\u771f\u7b49\u5f0f\uff0c\u7531\u540c\u4e00\u4e2a\u65b9\u7a0b\u8fd8\u53ef\u4ee5\u7ed9\u51fa\u7531 $(y,x)$ \u8fd9\u79cd\u5f62\u5f0f\u7684\u6570\u5bf9\u7684\u96c6\u5408\u786e\u5b9a\u7684 $f$ \u7684\u76f8\u53cd\u5173\u7cfb $g$\uff0c\u5176\u4e2d\u6bcf\u4e00\u4e2a\u6570\u5bf9\u90fd\u4f7f\u8fd9\u4e2a\u65b9\u7a0b\u53d8\u6210\u771f\u7b49\u5f0f\u3002\n\n\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u6570\u5bf9\u4e2d\u7b2c\u4e00\u4e2a\u53d8\u91cf\u770b\u6210\u4e0d\u662f $x$ \u800c\u662f $y$\uff0c\u800c\u7b2c\u4e8c\u4e2a\u53d8\u91cf\u770b\u6210\u4e0d\u662f $y$ \u800c\u662f $x$\u3002\n\u4f46\u662f\uff0c\u5982\u679c\u9075\u5faa\u8868\u793a\u6570\u5bf9\u4e2d\u53d8\u91cf\u7684\u901a\u5e38\u7684\u987a\u5e8f\uff08\u7b2c\u4e00\u4e2a\u53d8\u91cf\u770b\u6210 $x$\uff0c\u7b2c\u4e8c\u4e2a\u53d8\u91cf\u770b\u6210 $y$\uff09\uff0c\u90a3\u4e48\uff0c\u4e3a\u4e86\u7528\u65b9\u7a0b\u7ed9\u51fa\u5173\u7cfb $g$\uff0c\u5fc5\u987b\u5728\u65b9\u7a0b $x+2y=12$ \u4e2d\u7528 $y$ \u66ff\u6362 $x$ \u5e76\u7528 $x$ \u66ff\u6362 $y$\u3002\n\n\u4e8e\u662f\uff0c\u5f97\u5230\u65b9\u7a0b $y+2x=12$\uff0c\u7531\u5b83\u7ed9\u51fa $f$ \u7684\u76f8\u53cd\u5173\u7cfb $g$\u3002\n\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u8c61\u5173\u7cfb $f$ \u4e00\u6837\uff0c\u5173\u7cfb $g$ \u4e5f\u7531 $(x,y)$ \u8fd9\u79cd\u5f62\u5f0f\u7684\u6570\u5bf9\u7684\u96c6\u5408\u786e\u5b9a\u3002"
    }
  ],
