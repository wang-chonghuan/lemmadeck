7\u7684\u4f8b\u5b50\uff1a\u0430) $b_1>0$\uff0c$q>1$\uff1b\u3000\u0431) $b_1>0$\uff0c$0<q<1$\uff1b\u0432) $b_1<0$\uff0c$q>1$\uff1b\u3000\u0433) $b_1<0$\uff0c$0<q<1$.\u6570\u5217\u662f\u589e\u6570\u5217\u8fd8\u662f\u51cf\u6570\u5217\uff1f", "lines": ["276. \u4e3e\u51fa\u7b26\u5408\u4e0b\u5217\u6761\u4ef6\u7684\u7b49\u6bd4\u6570\u5217\u7684\u4f8b\u5b50\uff1a", "\u0430) $b_1>0$\uff0c$q>1$\uff1b\u3000\u0431) $b_1>0$\uff0c$0<q<1$\uff1b", "\u0432) $b_1<0$\uff0c$q>1$\uff1b\u3000\u0433) $b_1<0$\uff0c$0<q<1$.", "\u6570\u5217\u662f\u589e\u6570\u5217\u8fd8\u662f\u51cf\u6570\u5217\uff1f"], "pages": ["p0105#3"], "figure_refs": [], "figures": []}, {"number": "277", "source_number": "277", "group": "\u590d\u4e60\u9898", "group_id": "g1", "text": "277. \u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u5b9a\u4e49\u57df\uff1a\u0430) $\\sqrt{2x-3}+\\sqrt{3-2x}$\uff1b\u3000\u0431) $\\sqrt{6x}-\\frac{2}{\\sqrt{5x+1}}$\uff1b\u0432) $\\frac{1}{x^2-3x}+\\sqrt{7-4x}$\uff1b\u3000\u0433) $\\frac{4}{x^2-16}-\\sqrt{10-2x}$.", "lines": ["277. \u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u5b9a\u4e49\u57df\uff1a", "\u0430) $\\sqrt{2x-3}+\\sqrt{3-2x}$\uff1b\u3000\u0431) $\\sqrt{6x}-\\frac{2}{\\sqrt{5x+1}}$\uff1b", "\u0432) $\\frac{1}{x^2-3x}+\\sqrt{7-4x}$\uff1b\u3000\u0433) $\\frac{4}{x^2-16}-\\sqrt{10-2x}$."], "pages": ["p0105#5"], "figure_refs": [], "figures": []}]}}}}
