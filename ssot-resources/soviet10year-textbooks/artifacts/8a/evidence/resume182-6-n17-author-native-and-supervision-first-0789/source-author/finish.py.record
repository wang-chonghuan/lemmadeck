}
assert len(views) <= 8
with (OUT / "result.record").open("x", encoding="utf-8") as handle:
    json.dump(result, handle, ensure_ascii=False, indent=2)
    handle.write("\n")
print(json.dumps(file_fact(OUT / "result.record"), ensure_ascii=False))
for page in pages:
    print(json.dumps({
        k: page[k] for k in ("path", "sha256", "bytes", "actual_printed_rows")
    }, ensure_ascii=False))
