import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const [authorPath, authorHash] = process.argv.slice(2);
const base = '.tmp/resume182-6-8a-n17-0789';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const authorBytes = fs.readFileSync(authorPath);
assert.equal(sha(authorBytes), authorHash);
const author = JSON.parse(authorBytes);
assert.equal(author.status, 'SOURCE_AUTHORED_NOT_APPROVED');
assert.equal(author.book, '8a');
assert.equal(author.lesson, 'alg8-c3-s3-n17');
const outputs = [];
for (const physical of [103, 104, 105]) {
  const page = String(physical).padStart(4, '0');
  const source = `${repo}/ssot-resources/soviet10year-textbooks/artifacts/8a/pages/${page}/page.md`;
  const bytes = fs.readFileSync(source);
  const output = `${base}/source-author-snapshot/pages/${page}/page.md.record`;
  fs.mkdirSync(path.dirname(output), { recursive: true });
  fs.writeFileSync(output, bytes, { flag: 'wx' });
  outputs.push({ source, path: output, sha256: sha(bytes), bytes: bytes.length });
}
const file = `${base}/source-author-snapshot/manifest.record`;
fs.writeFileSync(file, `${JSON.stringify({
  status: 'ACTUAL_SOURCE_AUTHOR_BYTES_SNAPSHOTTED_NOT_APPROVED',
  author: { path: path.resolve(authorPath), sha256: authorHash }, outputs,
  parentImageViews: 0, unknownHistoricalBytesRecovered: false,
  databaseWrites: 0, finish: 'review',
}, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ path: file, sha256: sha(fs.readFileSync(file)), outputs }));
