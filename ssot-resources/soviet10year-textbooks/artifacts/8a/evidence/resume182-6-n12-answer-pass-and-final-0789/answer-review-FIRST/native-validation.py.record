"""Run only the read-only native lesson validator, never prepare or finalize."""

import json
import sys
from pathlib import Path

ROOT = Path("/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck")
sys.path.insert(0, str(ROOT / ".claude/skills/ld-s10y-answer/tools"))
import lesson_answers

batch = ROOT / ".tmp/resume182-6-8a-n12-0789"
profile = lesson_answers.load(lesson_answers.MODERN_US_PROFILE)
forbidden = [
    *profile.get("forbidden_terms", []),
    *profile.get("forbidden_person_names", []),
]
document, errors = lesson_answers.validate_lesson(
    batch / "answer-author-FIRST/answer-keys.json",
    batch / "modern-FIRST/adapt/8a/modern-us-neutral/lessons/alg8-c3-s1-n12/exercises.template.json",
    "8a",
    "alg8-c3-s1-n12",
    "modern-us-neutral",
    forbidden,
)
print(json.dumps({
    "validator": "lesson_answers.validate_lesson",
    "status": "revise" if errors else "pass",
    "answerCount": len(document["answers"]),
    "writes": 0,
    "prepareRuns": 0,
    "finalizeRuns": 0,
    "runtimeReplayRuns": 0,
    "errors": errors,
}, indent=2))
sys.exit(1 if errors else 0)
