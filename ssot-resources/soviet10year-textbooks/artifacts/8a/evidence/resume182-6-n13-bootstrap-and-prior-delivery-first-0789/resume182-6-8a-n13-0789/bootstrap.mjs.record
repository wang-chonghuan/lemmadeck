import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const prior = '.tmp/resume182-6-8a-n12-0789';
const next = '.tmp/resume182-6-8a-n13-0789';
const root = 'ssot-resources/soviet10year-textbooks/artifacts/8a';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const entry = file => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), sha256: sha(bytes), bytes: bytes.length };
};
const read = file => JSON.parse(fs.readFileSync(file));
const delivered = '20f936b7b84275e213ebd7594db8e4d1560052f1';
for (const name of ['delivery-check-FIRST', 'delivery-commit-FIRST',
  'delivery-push-FIRST', 'delivery-remote-confirm-FIRST']) {
  assert.equal(read(`${prior}/stages/${name}/receipt.record`).returncode, 0);
}
assert.equal(fs.readFileSync(`${prior}/stages/delivery-remote-confirm-FIRST/stdout.txt`, 'utf8').trim(),
  `${delivered}\trefs/heads/codex/STEMROBIN-182-textbooks`);
const offline = read(`${root}/editions/modern-us-neutral/lessons/alg8-c3-s1-n12/offline-display.json`);
assert.equal(offline.status, 'OFFLINE_DISPLAY_PASS');
assert.equal(offline.coverage.pending, 0);
const reviewFile = `${prior}/source-review-FIRST/result-affected-annotation1.record`;
assert.equal(entry(reviewFile).sha256, 'cd18e13a0ff01a8c5ea64a6951a2f640c0cdda29c3468371680dc9593dc87c14');
const review = read(reviewFile);
assert.equal(review.status, 'SOURCE_PASS');
const pageRoot = `${root}/pages/0085`;
const pageBindings = ['page.md', 'page.json', 'audit.json'].map(name => {
  const current = entry(`${pageRoot}/${name}`);
  const approved = review.bindings.find(item => path.resolve(item.path) === current.path);
  assert.ok(approved);
  assert.equal(current.sha256, approved.sha256);
  return current;
});
const page = read(`${pageRoot}/page.json`);
const headingIndex = page.blocks.findIndex(block => block.kind === 'h3'
  && /^13\.\s/u.test(block.lines.join('\n')));
assert.equal(headingIndex + 1, 4);
const tocFile = 'ssot-resources/soviet10year-textbooks/toc/8a/zh.json';
const toc = read(tocFile);
const objects = [];
const visit = value => {
  if (!value || typeof value !== 'object') return;
  if (!Array.isArray(value)) objects.push(value);
  for (const child of Object.values(value)) visit(child);
};
visit(toc);
const target = objects.find(item => item.id === 'alg8-c3-s1-n13');
const right = objects.find(item => item.id === 'alg8-c3-s2-n14');
assert.equal(target.printedNumber, 13);
assert.equal(right.printedNumber, 14);
assert.equal(page.meta.printed_page, target.page);
const offset = page.meta.page - page.meta.printed_page;
const rightPhysical = right.page + offset;
const newPages = Array.from({ length: rightPhysical - page.meta.page },
  (_, index) => page.meta.page + index + 1);
assert.deepEqual(newPages, [86, 87, 88]);
for (const physical of newPages) assert.ok(!fs.existsSync(`${root}/pages/${String(physical).padStart(4, '0')}/page.json`));
assert.ok(!fs.existsSync(`${root}/lessons/${target.id}`));
const copied = [];
for (const name of ['run-stage.mjs', 'retain.mjs']) {
  const file = `${next}/${name}`;
  const text = fs.readFileSync(`${prior}/${name}`, 'utf8')
    .replaceAll('resume182-6-8a-n12-0789', 'resume182-6-8a-n13-0789')
    .replaceAll('resume182-6-n12-', 'resume182-6-n13-')
    .replaceAll('alg8-c3-s1-n12', target.id);
  fs.writeFileSync(file, text, { flag: 'wx' });
  copied.push({ source: entry(`${prior}/${name}`), output: entry(file) });
}
const record = {
  status: 'NEXT_SOURCE_READY_FOR_NEW_PAGE_PREPARATION_NOT_CONTENT_APPROVAL',
  time: new Date().toISOString(), ticket: 'STEMROBIN-182', book: '8a',
  lesson: target.id, workdir: repo, copied,
  deliveredPriorLesson: {
    commit: delivered,
    receipts: ['delivery-check-FIRST', 'delivery-commit-FIRST', 'delivery-push-FIRST',
      'delivery-remote-confirm-FIRST'].map(name => entry(`${prior}/stages/${name}/receipt.record`)),
  },
  reusedPage85: {
    approval: entry(reviewFile), files: pageBindings,
    sourceWork: path.resolve(`${prior}/source/8a/pages/0085`),
    sourcePixelsAndRecognitionRerun: false, nativeFinalizationRerun: false,
  },
  toc: { file: entry(tocFile), target, next: right, offset },
  scope: {
    start: 'p0085#4', newPhysicalPages: newPages,
    rightBoundary: 'Locate exact next section/unit heading from physical88; exclude next lesson.',
    preserveNextLessonFragments: true, promoteOnlyCompleteN13: true,
  },
  technicalRecovery: {
    originalImplementation: entry(`${next}/bootstrap-FIRST.mjs.record`),
    originalFailure: entry(`${prior}/stages/next-n13-bootstrap-FIRST/receipt.record`),
    reason: 'Correct one-character source-review hash transcription; use native page block lines in the unreached heading lookup.',
    sourceOrContentPassReruns: 0,
  },
  previousFailuresLocksBackupsPendingMessagesAndUnknownUsagePreserved: true,
  unknownHistoricalBytesRecovered: false, parentImageViews: 0,
  createOrAttachCalls: 0, databaseWrites: 0, merges: 0, deployments: 0,
  finish: 'review', hostTokens: 'unknown', totalCost: 'unknown',
};
const file = `${next}/bootstrap.record`;
fs.writeFileSync(file, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ status: record.status, output: entry(file), newPages }));
