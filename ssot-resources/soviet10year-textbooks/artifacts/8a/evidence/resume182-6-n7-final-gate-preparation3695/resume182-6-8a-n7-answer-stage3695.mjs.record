import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const root = 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral';
const lesson = `${root}/lessons/alg8-c2-s1-n7`;
const own = '.tmp/resume182-6-8a-n7-answer-stage3695-FIRST';
const reviewPath = '.tmp/resume182-6-8a-n7-parent-answer-review3695-FIRST/review.record';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const read = file => fs.readFileSync(file);
const json = file => JSON.parse(read(file));
const save = (file, value) => fs.writeFileSync(file,
  `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
const [layoutReviewPath, layoutReviewSHA] = process.argv.slice(2);
assert.match(layoutReviewSHA, /^[a-f0-9]{64}$/);
assert.equal(sha(read(layoutReviewPath)), layoutReviewSHA);
const layoutReview = json(layoutReviewPath);
assert.equal(layoutReview.status, 'TEXT_PASS');
assert.equal(layoutReview.book, '8a');
assert.equal(layoutReview.lesson, 'alg8-c2-s1-n7');
assert.equal(layoutReview.edition, 'modern-us-neutral');
assert.equal(sha(read(reviewPath)), 'd69ed8a36891b709684b05d0122071b1c5ce524eb1dfbefe7de6e4a68dc7134d');
const review = json(reviewPath);
assert.equal(review.status, 'PASS');
for (const input of review.inputs) assert.equal(sha(read(input.path)), input.sha256);
const source = review.inputs.find(input => input.path.endsWith('answers.draft.json'));
const candidateBytes = read(source.path), candidate = JSON.parse(candidateBytes);
const finalLesson = json(`${lesson}/lesson.json`);
const finalExercises = json(`${lesson}/exercises.json`);
const audit = json(`${lesson}/adaptation.audit.json`);
assert.equal(audit.status, 'pass');
assert.equal(audit.lesson, 'alg8-c2-s1-n7');
assert.equal(finalLesson.status, 'ready');
assert.equal(finalExercises.status, 'ready');
assert.deepEqual(candidate.answers.map(answer => answer.exercise),
  finalExercises.exercises.map(exercise => String(exercise.number)));
const approvedRoot = '.tmp/resume182-6-8a-n7-layout-recovery3695-AFFECTED3/adapt/8a/modern-us-neutral/lessons/alg8-c2-s1-n7';
assert.equal(sha(read(`${approvedRoot}/lesson.template.json`)),
  '1045b70ae8865e29b3d7bec16b85a2b64ee87b286aa2c7d7726d79409c8fa398');
const approvedLesson = json(`${approvedRoot}/lesson.template.json`);
const approvedExercises = json(`${approvedRoot}/exercises.template.json`);
const formulas = text => [...text.matchAll(/\$\$(.+?)\$\$|\$([^$]+?)\$/gs)]
  .map(match => match[1] ?? match[2]);
const compact = text => text.replace(/\s+/gu, '');
let formulaSpans = 0;
for (const [before, after] of [
  [approvedLesson.prose, finalLesson.prose],
  [approvedExercises.exercises, finalExercises.exercises],
]) {
  assert.equal(before.length, after.length);
  for (let index = 0; index < before.length; index++) {
    assert.deepEqual(formulas(before[index].text), formulas(after[index].text));
    assert.equal(compact(before[index].text), compact(after[index].text));
    formulaSpans += formulas(before[index].text).length;
  }
}
assert.ok(!fs.existsSync(own));
assert.ok(!fs.existsSync(`${lesson}/answer-keys.json`));
fs.mkdirSync(own);
fs.writeFileSync(`${lesson}/answer-keys.json`, candidateBytes, { flag: 'wx' });
const indexPath = `${root}/book.json`, indexBytes = read(indexPath);
fs.writeFileSync(`${own}/index-before-portable-path.record`, indexBytes, { flag: 'wx' });
const index = JSON.parse(indexBytes);
if (path.isAbsolute(index.profile.path)) {
  assert.ok(index.profile.path.startsWith(`${repo}/`));
  index.profile.path = path.relative(repo, index.profile.path);
}
assert.equal(sha(read(index.profile.path)), index.profile.sha256);
fs.writeFileSync(indexPath, `${JSON.stringify(index, null, 2)}\n`);
save(`${own}/binding.record`, {
  status: 'APPROVED_ANSWER_CANDIDATE_BOUND_PENDING_OFFICIAL_VALIDATION',
  root: repo, ticket: 'STEMROBIN-182', book: '8a', lesson: 'alg8-c2-s1-n7',
  edition: 'modern-us-neutral',
  review: { path: reviewPath, sha256: sha(read(reviewPath)) },
  affectedLayoutReview: { path: layoutReviewPath, sha256: layoutReviewSHA },
  candidate: source, target: `${lesson}/answer-keys.json`,
  targetBytesUnchanged: true, answers: candidate.answers.length,
  finalTextAndExercisesOnlyWhitespaceNormalized: true,
  formulaSpansPreserved: formulaSpans, portableProfileBinding: index.profile,
  newSourceMathImageOrSemanticReviewCalls: 0, formalAnswerFinalizerPending: true,
  DBWrites: 0, wholeLessonApproval: false,
  unknownHistoricalBytesRecovered: false, hostTokens: 'unknown', totalCost: 'unknown',
});
console.log(JSON.stringify({ path: `${own}/binding.record`,
  sha256: sha(read(`${own}/binding.record`)), answers: candidate.answers.length,
  formulaSpansPreserved: formulaSpans, images: 0, mathematicalRecomputations: 0 }));
