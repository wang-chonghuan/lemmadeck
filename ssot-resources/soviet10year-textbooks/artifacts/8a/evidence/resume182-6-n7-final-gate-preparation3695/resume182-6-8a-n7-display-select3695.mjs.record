import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { fileURLToPath } from 'node:url';

const R = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
const OWN = path.join(R, '.tmp/resume182-6-8a-n7-display3695-FIRST');
assert.equal(process.cwd(), R);
assert.equal(fileURLToPath(import.meta.url), path.join(R, '.tmp/resume182-6-8a-n7-display-select3695.mjs'));
assert.equal(fs.realpathSync(OWN), OWN);
const args = process.argv.slice(2);
assert.equal(args.length, 4, 'Use --report <absolute-report> --name <unique-selection-name>');
assert.equal(args[0], '--report'); assert.equal(args[2], '--name');
const input = args[1], name = args[3];
assert.ok(path.isAbsolute(input) && input.startsWith(`${OWN}/runtime-`) && input.endsWith('/report-FIRST.json'));
assert.match(name, /^[a-z][a-z0-9-]{0,63}$/u);
assert.ok(fs.realpathSync(input).startsWith(`${OWN}/`));
const output = path.join(OWN, `selection-${name}`);
assert.ok(!fs.existsSync(output), 'Never overwrite prior selection');
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const bytes = fs.readFileSync(input), report = JSON.parse(bytes);
assert.equal(report.scope.lesson, 'alg8-c2-s1-n7');
assert.equal(report.scope.book, '8a'); assert.equal(report.scope.edition, 'modern-us-neutral');
assert.equal(report.status, 'RUNTIME_PASS_VISUAL_PENDING');
assert.ok(report.checks.every(check => check.status === 'PASS'));
assert.ok(Object.values(report.cleanup).every(Boolean));
const groupKey = item => `${item.viewport.width}:${item.surface}`;
const groups = new Map();
for (const item of report.coverage) {
  if (item.missingTargets.length === 0 && item.figureCoverage.every(figure => figure.complete))
    groups.set(groupKey(item), item);
}
assert.deepEqual([...groups.keys()].sort(), [
  '1440:choices', '1440:exercises', '1440:text', '390:choices', '390:exercises', '390:text',
]);
const shots = report.screenshots.map(item => ({ ...item, targets: new Set() }));
assert.equal(new Set(shots.map(shot => shot.path)).size, shots.length);
// Byte hashing is not image observation. All original screenshots remain untouched.
for (const shot of shots) {
  assert.ok(fs.realpathSync(shot.path).startsWith(`${OWN}/runtime-`));
  assert.equal(sha(fs.readFileSync(shot.path)), shot.sha256);
  assert.equal(shot.visualObservation, 'UNOBSERVED');
  assert.equal(shot.nativeSize, true);
  assert.equal(shot.fullPage, false); assert.equal(shot.croppedOrResized, false);
}
const universe = new Set();
for (const [key, group] of groups) {
  assert.ok(group.domTargets > 0);
  const inventoryPath = path.join(path.dirname(input), `${group.viewport.width}-${group.surface}-coverage.json`);
  // Recoveries can reuse earlier passed views without copying their evidence.
  let sourcePath = inventoryPath;
  if (!fs.existsSync(sourcePath)) {
    const firstShot = shots.find(shot => groupKey(shot) === key && shot.captureChecks === 'PASS');
    assert.ok(firstShot);
    sourcePath = path.join(path.dirname(path.dirname(firstShot.path)),
      `${group.viewport.width}-${group.surface}-coverage.json`);
  }
  assert.ok(fs.realpathSync(sourcePath).startsWith(`${OWN}/runtime-`));
  const inventoryBytes = fs.readFileSync(sourcePath);
  assert.equal(sha(inventoryBytes), report.inputs.find(entry => entry.path === sourcePath)?.sha256,
    'Only hash-bound actual target inventories can authorize selection');
  const inventory = JSON.parse(inventoryBytes);
  assert.equal(groupKey(inventory), key);
  assert.equal(inventory.targetInventory.length, group.domTargets);
  assert.deepEqual(inventory.targetInventory.map(target => target.id),
    Array.from({ length: group.domTargets }, (_, index) => index));
  const members = shots.filter(shot => groupKey(shot) === key && shot.captureChecks === 'PASS');
  assert.ok(members.length);
  for (let id = 0; id < group.domTargets; id += 1) universe.add(`${key}:dom:${id}`);
  for (const shot of members) for (const id of shot.visibleIds) {
    assert.ok(Number.isInteger(id) && id >= 0 && id < group.domTargets);
    shot.targets.add(`${key}:dom:${id}`);
  }
  for (const figure of group.figureCoverage) {
    assert.equal(figure.complete, true);
    const rectangles = new Map(members.map(shot => [shot.path,
      shot.figureRegions.filter(region => region.key === figure.key).map(region => ({
        x1: Math.max(0, Math.min(figure.nativeWidth, region.x)),
        x2: Math.max(0, Math.min(figure.nativeWidth, region.x + region.width)),
        y1: Math.max(0, Math.min(figure.nativeHeight, region.y)),
        y2: Math.max(0, Math.min(figure.nativeHeight, region.y + region.height)),
      })).filter(region => region.x2 > region.x1 && region.y2 > region.y1),
    ]));
    const xs = [...new Set([0, figure.nativeWidth,
      ...[...rectangles.values()].flatMap(items => items.flatMap(rect => [rect.x1, rect.x2])),
    ])].sort((a, b) => a - b);
    const ys = [...new Set([0, figure.nativeHeight,
      ...[...rectangles.values()].flatMap(items => items.flatMap(rect => [rect.y1, rect.y2])),
    ])].sort((a, b) => a - b);
    for (let x = 0; x < xs.length - 1; x += 1) for (let y = 0; y < ys.length - 1; y += 1) {
      const target = `${key}:figure:${figure.key}:${x}:${y}`;
      universe.add(target);
      const owners = members.filter(shot => rectangles.get(shot.path).some(rect =>
        rect.x1 <= xs[x] && rect.x2 >= xs[x + 1] && rect.y1 <= ys[y] && rect.y2 >= ys[y + 1]));
      assert.ok(owners.length, `Uncaptured exact figure cell: ${target}`);
      for (const shot of owners) shot.targets.add(target);
    }
  }
}
const selected = [], missing = new Set(universe);
while (missing.size) {
  const candidates = shots.filter(shot => !selected.includes(shot)).map(shot => ({
    shot, gain: [...shot.targets].filter(target => missing.has(target)).length,
  })).sort((a, b) => b.gain - a.gain || a.shot.path.localeCompare(b.shot.path));
  assert.ok(candidates[0]?.gain > 0, `Uncovered actual targets: ${missing.size}`);
  const shot = candidates[0].shot;
  selected.push(shot);
  for (const target of shot.targets) missing.delete(target);
}
for (const shot of [...selected].reverse()) {
  const others = new Set(selected.filter(other => other !== shot).flatMap(other => [...other.targets]));
  if ([...shot.targets].every(target => others.has(target))) selected.splice(selected.indexOf(shot), 1);
}
const covered = new Set(selected.flatMap(shot => [...shot.targets]));
assert.equal([...universe].filter(target => !covered.has(target)).length, 0);
const witnesses = selected.map(shot => {
  const others = new Set(selected.filter(other => other !== shot).flatMap(other => [...other.targets]));
  const unique = [...shot.targets].filter(target => !others.has(target));
  assert.ok(unique.length, 'Selected set is not inclusion-minimal');
  return { path: shot.path, indispensableTargets: unique.length, witness: unique[0] };
});
const pending = [...selected].sort((a, b) => groupKey(a).localeCompare(groupKey(b)) || a.path.localeCompare(b.path));
const summary = shot => ({
  path: shot.path, sha256: shot.sha256, viewport: shot.viewport, surface: shot.surface,
  targetCount: shot.targets.size, visibleCount: shot.visibleIds.length,
  visualObservation: 'PENDING', priorObservation: null,
  figureRegions: shot.figureRegions.filter(region => region.width > 0 && region.height > 0),
});
const record = {
  schema: 'bounded-n7-display-selection@1', date: new Date().toISOString().slice(0, 10),
  ticket: 'STEMROBIN-182', lesson: 'alg8-c2-s1-n7', status: 'COVERAGE_SELECTED_VISUAL_PENDING',
  authority: { path: input, sha256: sha(bytes) },
  method: 'Actual DOM glyph/rule/media targets and exact figure-cell union; deterministic greedy cover then redundancy elimination. Inclusion-minimal, not claimed globally optimal. No image observation.',
  counts: { saved: shots.length, selected: selected.length, priorObserved: 0, pending: pending.length,
    omitted: shots.length - selected.length, targets: universe.size, missing: 0 },
  surfaces: [...groups].map(([key, group]) => ({ key, domTargets: group.domTargets,
    figures: group.figureCoverage.length, selected: selected.filter(shot => groupKey(shot) === key).length })),
  selected: pending.map(summary), minimalityWitnesses: witnesses,
  omitted: shots.filter(shot => !selected.includes(shot)).map(shot => ({
    path: shot.path, sha256: shot.sha256, observed: false,
    reason: shot.captureChecks === 'PASS' ? 'All actual targets covered by selected screenshots.' : 'Failed capture receipt retained, not used as coverage.',
  })),
  batches: Array.from({ length: Math.ceil(pending.length / 8) }, (_, index) => ({
    id: `batch${index + 1}`, status: 'UNOBSERVED', freshReviewerRequired: true,
    images: pending.slice(index * 8, (index + 1) * 8).map(summary),
  })),
  usage: { screenshotBytesHashed: shots.length, imagesObserved: 0, rendererCalls: 0, browserLaunches: 0,
    captures: 0, validatorCalls: 0, networkCalls: 0 },
  finalBindingOwner: 'parent', allScreenshotsPreserved: true, noAssumedObservation: true,
};
fs.mkdirSync(output);
fs.writeFileSync(path.join(output, 'selection.record'), `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
for (const batch of record.batches)
  fs.writeFileSync(path.join(output, `${batch.id}.json`), `${JSON.stringify(batch, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ path: path.join(output, 'selection.record'), counts: record.counts,
  surfaces: record.surfaces, batches: record.batches.length, imagesObserved: 0 }));
