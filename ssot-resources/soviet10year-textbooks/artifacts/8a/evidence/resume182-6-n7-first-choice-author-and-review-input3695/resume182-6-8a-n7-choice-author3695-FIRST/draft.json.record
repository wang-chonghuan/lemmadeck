        "rationales": [
          {"option_id": "A", "truth": "incorrect", "derivation": "误移项为 y=2+5x，取 x=0,1 得 (0,2),(1,7)；第二对原式为 12。", "misconception": "移项时不改变 5x 的符号。"},
          {"option_id": "B", "truth": "correct", "derivation": "$5\\cdot0+2=2$，$5\\cdot1-3=2$，两对不同。", "misconception": null},
          {"option_id": "C", "truth": "incorrect", "derivation": "把正确的 (0,2),(1,-3) 交换坐标，得到 (2,0),(-3,1)；原式为 10,-14。", "misconception": "把 (x,y) 写成 (y,x)。"},
          {"option_id": "D", "truth": "incorrect", "derivation": "把 5x+y=2 错化为 x+y/5=2，继而 y=5(2-x)，取 x=0,1 得 (0,10),(1,5)；原式均为 10。", "misconception": "除以 5 时只除左边，未除右端常数。"}
        ]
      }
    },
    {
