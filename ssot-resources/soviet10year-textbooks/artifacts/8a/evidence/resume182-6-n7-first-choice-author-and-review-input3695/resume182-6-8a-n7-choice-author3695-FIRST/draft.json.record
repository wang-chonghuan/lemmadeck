    {
      "id": "q-square-sum-negative",
      "source_numbers": ["91"],
      "view": {
        "mode": "single",
        "stem": "对于实数方程 $(x+5)^2+(y-2)^2=-1$，下列关于解集的论断及其理由，哪一项正确？",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "解集为空；两个平方均非负，和也非负，不可能等于 $-1$。", "figure_ids": []},
          {"id": "B", "text": "解集为 $\\{(-5,2)\\}$；两个平方同时取最小值 $0$ 就满足方程。", "figure_ids": []},
          {"id": "C", "text": "解集为以 $(-5,2)$ 为圆心、半径为 $1$ 的圆周；平方和给出距离的平方。", "figure_ids": []},
          {"id": "D", "text": "解集为 $\\{(-6,2),(-4,2)\\}$；令 $y=2$ 后得到 $x+5=\\pm1$。", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "识别覆盖全部实数而不是几个样点的无解论证。",
        "source_solution": "任意实数的平方非负，两平方和至少为零，不能等于 -1，因此解集为空。",
        "unit_reason": "负目标与零目标对应不同的存在性结论；此题要求普遍非负推理，不能由另一唯一解题得到。用完整论断加理由作 single，不退化成仅猜空集。",
        "concept_blocks": [11, 14],
        "limitations": ["只检验完整无解论证的识别，未检验独立组织和书写证明。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["A"],
        "rationales": [
          {"option_id": "A", "truth": "correct", "derivation": "$ (x+5)^2\\ge0,(y-2)^2\\ge0$ 对所有实数成立，故左边不可能等于负数。", "misconception": null},
          {"option_id": "B", "truth": "incorrect", "derivation": "求出左边最小值 0 的位置 (-5,2)，却把最小位置自动判为方程解，不核对右端 -1；该点左边为 0。", "misconception": "最小值点必满足任意指定右端。"},
          {"option_id": "C", "truth": "incorrect", "derivation": "把右端 -1 改成其绝对值 1，使用距离平方等于 1 得到所述圆；圆上各点的左边为 1，不是 -1。", "misconception": "距离平方公式中无依据地取右端绝对值。"},
          {"option_id": "D", "truth": "incorrect", "derivation": "令 y=2 后从 (x+5)^2=-1 开方时取 sqrt(1)，得 x+5=±1，因此 x=-6,-4；两点左边都为 1。", "misconception": "对负数平方目标开方时丢掉负号。"}
        ]
      }
    },
