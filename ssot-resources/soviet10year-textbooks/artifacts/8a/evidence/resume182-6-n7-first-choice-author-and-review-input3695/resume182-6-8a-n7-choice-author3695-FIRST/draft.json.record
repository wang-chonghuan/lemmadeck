          {"option_id": "A", "truth": "incorrect", "derivation": "直接除以 x+y，得 x-y=0，却不补上 x+y=0 的情形，遗失 y=-x 分支。", "misconception": "除以可能为零的因子时丢解。"},
          {"option_id": "B", "truth": "incorrect", "derivation": "把零积的或条件改成且，同时解 x-y=0 与 x+y=0，得到 x=y=0。", "misconception": "把两分支并集误作交集。"},
          {"option_id": "C", "truth": "correct", "derivation": "乘积为零当且仅当至少一个因子为零，分别得到 y=x 与 y=-x，取并集。", "misconception": null},
          {"option_id": "D", "truth": "incorrect", "derivation": "展开得 x^2-y^2=0 后漏掉 y 的平方指数，误成 x^2-y=0，得到 y=x^2。", "misconception": "在平方差中只保留一个变量的平方。"}
        ]
      }
