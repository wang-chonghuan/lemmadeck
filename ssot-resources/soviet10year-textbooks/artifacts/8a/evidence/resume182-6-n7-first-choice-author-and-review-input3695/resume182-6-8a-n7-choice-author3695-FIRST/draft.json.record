          {"option_id": "B", "truth": "incorrect", "derivation": "正确令两括号为零，但把 y+4=0 解成 y=4；(7,4) 左边为 64。", "misconception": "移项未改变 +4 的符号。"},
          {"option_id": "C", "truth": "correct", "derivation": "由两项同时为零必得 (7,-4)，该点代入左边为 0，既存在又唯一。", "misconception": null},
          {"option_id": "D", "truth": "incorrect", "derivation": "把 t^2≥0 错强为 t^2>0，对两项都应用严格正性，得和>0；遗漏两个括号均为零的情形。", "misconception": "将平方非负误当恒正。"}
        ]
