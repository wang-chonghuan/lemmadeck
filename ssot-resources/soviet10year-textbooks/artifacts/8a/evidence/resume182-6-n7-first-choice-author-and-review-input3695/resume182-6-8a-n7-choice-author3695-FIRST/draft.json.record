  "questions": [
    {
      "id": "q-degree",
      "source_numbers": ["88"],
      "view": {
        "mode": "single",
        "stem": "确定各方程的次数，选择按 a 至 h 顺序列出的完整结果。\n\na) $x^2+y^2-12=0$；\nb) $5x-6y-14=0$；\nc) $x^3-5x^2y^4+y^5-8y^3=0$；\nd) $x^2-5x^3y+y^4-1=0$；\ne) $x-xy=65$；\nf) $x^4-8x^2y^3+y^4=16$；\ng) $3xy=x(y+1)-5y$；\nh) $7x^8-12xy+y=7x^2(x^6+1)$。",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "$(2,1,5,4,1,4,1,8)$", "figure_ids": []},
          {"id": "B", "text": "$(2,1,6,4,2,5,2,8)$", "figure_ids": []},
          {"id": "C", "text": "$(2,1,6,4,2,5,2,2)$", "figure_ids": []},
          {"id": "D", "text": "$(2,1,6,4,2,5,1,2)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "比较标准化后各多项式的总次数，保留混合项和最高幂消去的区别。",
        "source_solution": "各式标准化后的最大总次数依次为 $2,1,6,4,2,5,2,2$。c 的 $x^2y^4$ 总次数为 6；d 的 $x^3y$ 为 4；g 化为 $2xy-x+5y=0$；h 消去 $7x^8$ 后为 $-12xy+y-7x^2=0$，次数 2。",
        "unit_reason": "八式共同使用总次数与标准化判据，整组结果同时保留混合项、常数和消项，不把每个次数拆成孤立点击。整组有唯一正确结果，使用 single。",
        "concept_blocks": [2, 8],
        "limitations": [],
        "figure_observations": []
      },
      "key": {
        "correct": ["C"],
        "rationales": [
          {"option_id": "A", "truth": "incorrect", "derivation": "不先标准化，对两边出现的单个变量幂取最大值；xy 记作 1，c 的 x^2y^4 记作 4 但另有 y^5 故记 5，x^3y 记作 3 但另有 y^4 故 d 记 4，x^2y^3 记作 3 但另有 x^4 故 f 记 4，h 保留 8。得到所列完整序列。", "misconception": "把多变量总次数换成最大单变量指数，并在等式两边取幂而不合并。"},
          {"option_id": "B", "truth": "incorrect", "derivation": "a 至 g 正确标准化；h 直接把左边的 7x^8 当最高项，不展开并消去右边同项，故末项误记 8。", "misconception": "次数在等式移项消去前就已确定。"},
          {"option_id": "C", "truth": "correct", "derivation": "逐式移项合并，混合项指数相加；g 剩 2xy，h 只剩二次与一次项，得到 $(2,1,6,4,2,5,2,2)$。", "misconception": null},
          {"option_id": "D", "truth": "incorrect", "derivation": "其余各式正确；在 g 中展开右边后，把左边 3xy 与右边 xy 当成可全部消去，不保留系数差 2，剩 -x+5y=0，误记 1。", "misconception": "跨等号消同类项时忽略系数差。"}
        ]
      }
    },
    {
      "id": "q-solution-pairs",
      "source_numbers": ["89"],
      "view": {
        "mode": "multiple",
        "stem": "选择所有使方程 $x^2-y+2=0$ 成立的数对 $(x,y)$。",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "$(1,3)$", "figure_ids": []},
          {"id": "B", "text": "$(0,0)$", "figure_ids": []},
          {"id": "C", "text": "$(-2,2)$", "figure_ids": []},
          {"id": "D", "text": "$(-1,-3)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "依据解的定义逐一判断四个数对。",
        "source_solution": "代入后的左边依次为 $0,2,4,6$，仅 $(1,3)$ 是解。",
        "unit_reason": "四个数对是同一方程下的一组独立断言，选择所有成立者使用原生 multiple；真实正确数为一，不改造为组合编码。",
        "concept_blocks": [11],
        "limitations": [],
        "figure_observations": []
      },
      "key": {
        "correct": ["A"],
        "rationales": [
          {"option_id": "A", "truth": "correct", "derivation": "$1^2-3+2=0$。", "misconception": null},
          {"option_id": "B", "truth": "incorrect", "derivation": "真实代入得 2；若遗漏常数项，只检验 x^2-y=0，则在 (0,0) 得 0 并误选。", "misconception": "检验方程时丢弃非零常数项。"},
          {"option_id": "C", "truth": "incorrect", "derivation": "真实代入得 4；把 (-2)^2 误算成 -4，同时把左边 -y 误读成 +y，则按错误代入程序得到 -4+2+2=0，从而误选。", "misconception": "负数平方保留负号，并把减去 y 误作加上 y。"},
          {"option_id": "D", "truth": "incorrect", "derivation": "真实代入得 6；若把关系误写成 y=-x^2-2，则 x=-1 时得到 y=-1-2=-3，误选。", "misconception": "分离 y 时给 x^2 和常数同时加负号。"}
        ]
      }
    },
    {
      "id": "q-two-linear-first",
      "source_numbers": ["90"],
      "view": {
        "mode": "single",
        "stem": "对于方程 $x-3y=1$，下列哪一组含有两个不同的解？数对按 $(x,y)$ 书写。",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "$(1,0)$ 和 $(4,1)$", "figure_ids": []},
          {"id": "B", "text": "$(1,0)$ 和 $(-2,1)$", "figure_ids": []},
          {"id": "C", "text": "$(3,0)$ 和 $(4,1)$", "figure_ids": []},
          {"id": "D", "text": "$(0,1)$ 和 $(1,4)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "识别用自由变量构成的一组两解。",
        "source_solution": "全体解为 $(1+3t,t)$，任取不同实数 t 即得两解。取 t=0,1 得 $(1,0),(4,1)$。",
        "unit_reason": "一个完整的两解组是响应单元，而不是两个数格。此线性关系与同源其他方程的系数及可取自由变量不同，独立求解不依赖其他题的答案；四组中只有一组全部成立，使用 single。",
        "concept_blocks": [11],
        "limitations": ["只识别已给出的两解，不能检验自主选择参数、任意构造两个不同解。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["A"],
        "rationales": [
          {"option_id": "A", "truth": "correct", "derivation": "$1-3\\cdot0=1$，$4-3\\cdot1=1$，两个数对不同。", "misconception": null},
          {"option_id": "B", "truth": "incorrect", "derivation": "误移项为 x=1-3y，取 y=0,1，得到 (1,0),(-2,1)；第二对原式为 -5。", "misconception": "把 -3y 移至右边仍保留负号。"},
          {"option_id": "C", "truth": "incorrect", "derivation": "把 x-3y=1 中常数 1 和系数 3 交换，按 x-y=3 取 y=0,1，得到 (3,0),(4,1)；第一对原式为 3。", "misconception": "混淆乘在变量上的系数与等式右端常数。"},
          {"option_id": "D", "truth": "incorrect", "derivation": "先正确取两解 (1,0),(4,1)，再把 (x,y) 反写为 (y,x)，得到所列两对；原式分别为 -3,-11。", "misconception": "交换有序数对坐标。"}
        ]
      }
    },
    {
      "id": "q-two-linear-second",
      "source_numbers": ["90"],
      "view": {
        "mode": "single",
        "stem": "对于方程 $5x+y=2$，下列哪一组含有两个不同的解？数对按 $(x,y)$ 书写。",
