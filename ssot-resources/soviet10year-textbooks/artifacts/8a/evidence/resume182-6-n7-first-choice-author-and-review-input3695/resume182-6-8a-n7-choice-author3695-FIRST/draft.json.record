      "key": {
        "correct": ["B"],
        "rationales": [
          {"option_id": "A", "truth": "incorrect", "derivation": "由 1-y=15/x 错移成 y=15/x-1，取 x=15,5 得 y=0,2；第二对原式为 -5。", "misconception": "分离带负系数的 y 时符号反向。"},
          {"option_id": "B", "truth": "correct", "derivation": "$15-15\\cdot0=15$，$5-5(-2)=15$。", "misconception": null},
          {"option_id": "C", "truth": "incorrect", "derivation": "把正确两解的坐标交换为 (0,15),(-2,5)；原式为 0,8。", "misconception": "忽略有序数对表示方向。"},
          {"option_id": "D", "truth": "incorrect", "derivation": "把 -xy 误读成 +y，按 x+y=15 取 y=0,1，得到 (15,0),(14,1)。第二对原式为 0。", "misconception": "把乘积项视作单变量项，并混淆其运算符号。"}
        ]
      }
    },
    {
