import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const own = '.tmp/resume182-6-8a-n8-text-figure-compose3695-FIRST';
assert.ok(!fs.existsSync(own));
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const bind = (file, expected) => {
  const bytes = fs.readFileSync(file);
  if (expected) assert.equal(sha(bytes), expected, file);
  return { path: path.resolve(file), sha256: sha(bytes) };
};
const text = bind('.tmp/resume182-6-8a-n8-text-status-bind3695-FIRST/text-review.record',
  '70cce421ab2f5d682cf59971b43a05aecff9a573851871fcab519e171db8ce53');
const figure = bind('.tmp/resume182-6-8a-n8-fig16-xunit-review3695-AFFECTED2/review.record',
  '33cfd78499afafae5f5a36030a4985f7f2a249ff86f2f3a3756db1ad3314c0ed');
const textValue = JSON.parse(fs.readFileSync(text.path));
const figureValue = JSON.parse(fs.readFileSync(figure.path));
assert.equal(textValue.status, 'TEXT_PASS');
assert.equal(figureValue.status, 'PASS');
assert.equal(figureValue.affectedVisualReview.status, 'PASS');
assert.equal(figureValue.inheritedApprovals.unchangedTextApproval.sha256,
  textValue.inheritedIndependentTextApproval.sha256);
for (const value of [textValue, figureValue]) {
  assert.equal(value.book, '8a');
  assert.equal(value.lesson, 'alg8-c2-s1-n8');
  assert.equal(value.edition, 'modern-us-neutral');
}
const current = figureValue.currentEvidence;
for (const key of ['ready', 'spec', 'svg', 'render', 'nativePng', 'officialReview']) {
  bind(current[key].path, current[key].sha256);
}
assert.equal(current.officialReview.status, 'pass');
const value = {
  schema: 'resume182-6/text-and-affected-figure-approval-composition@1',
  status: 'PASS', ticket: 'STEMROBIN-182', root: repo, book: '8a',
  lesson: 'alg8-c2-s1-n8', edition: 'modern-us-neutral',
  textReview: text, affectedFigureReview: figure, figureReady: current.ready,
  officialFigureReview: current.officialReview,
  action: 'Compose existing independent text PASS and affected figure PASS, preserving their original HOLD and counters.',
  newSemanticReviews: 0, newSourceReviews: 0, imagesViewed: 0, rendererCalls: 0,
  observedFigureImagesTotal: 3, cumulativeCurrentN8ContentRepairs: 2,
  oldOrdinaryRepairBudgetRemaining: 0, oldRepairBudgetReset: false,
  DBWrites: 0, wholeLessonApproval: false, unknownHistoricalBytesRecovered: false,
  hostTokens: 'unknown', totalCost: 'unknown',
};
fs.mkdirSync(own);
fs.writeFileSync(`${own}/review.record`, `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(bind(`${own}/review.record`)));
