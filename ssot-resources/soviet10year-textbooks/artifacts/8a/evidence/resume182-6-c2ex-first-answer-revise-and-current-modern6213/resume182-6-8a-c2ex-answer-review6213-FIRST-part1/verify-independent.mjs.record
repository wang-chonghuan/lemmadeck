pairs("153e", [[4, 1]], [[(x, y) => 4 * x * x - 9 * y * y + x - 40 * y - 19, 0], [(x, y) => 2 * x - 3 * y, 5]]);
pairs("153f", [[-5 / 4, 3 / 4], [-5, -3]], [[(x, y) => 3 * x * x + y * y + 8 * x + 13 * y, 5], [(x, y) => x - y + 2, 0]]);
near((3 * sqrt(2)) ** 2, 18, "154 endpoints");
near((10 * sqrt(2)) ** 2, 200, "155 endpoints");
pairs("156a", [[10, 15], [3 / 2, -2]], [[(x, y) => 1 / x + 1 / y, 1 / 6], [(x, y) => 2 * x - y, 5]], true);
