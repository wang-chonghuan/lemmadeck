pairs("153a", [[(1 + 3 * sqrt(3)) / 2, (-1 - sqrt(3)) / 2], [(1 - 3 * sqrt(3)) / 2, (-1 + sqrt(3)) / 2]], [[(x, y) => x + 3 * y, -1], [(x, y) => x * x + 2 * x * y + y * y, 3]]);
pairs("153b", [[0, -1], [3, 5]], [[(x, y) => 2 * x - y, 1], [(x, y) => x * y - y * y + 3 * x, -1]]);
