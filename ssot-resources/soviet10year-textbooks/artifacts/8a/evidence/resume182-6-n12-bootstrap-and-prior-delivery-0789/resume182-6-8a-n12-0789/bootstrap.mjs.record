import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const prior = '.tmp/resume182-6-8a-n11-0789';
const next = '.tmp/resume182-6-8a-n12-0789';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const entry = file => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), sha256: sha(bytes), bytes: bytes.length };
};
const push = JSON.parse(fs.readFileSync(`${prior}/stages/delivery-push-FIRST/receipt.record`));
const confirm = JSON.parse(fs.readFileSync(`${prior}/stages/delivery-remote-confirm-FIRST/receipt.record`));
assert.equal(push.returncode, 0);
assert.equal(confirm.returncode, 0);
const delivered = '782928dc088e21dd49b0ae73731dc7b257c005f3';
assert.ok(fs.readFileSync(`${prior}/stages/delivery-remote-confirm-FIRST/stdout.txt`, 'utf8')
  .startsWith(`${delivered}\trefs/heads/codex/STEMROBIN-182-textbooks`));
const copied = [];
for (const name of ['run-stage.mjs', 'retain.mjs']) {
  const bytes = fs.readFileSync(`${prior}/${name}`);
  const text = bytes.toString().replaceAll('resume182-6-8a-n11-0789', 'resume182-6-8a-n12-0789')
    .replaceAll('resume182-6-n11-', 'resume182-6-n12-')
    .replaceAll('alg8-c3-s1-n11', 'alg8-c3-s1-n12');
  const file = `${next}/${name}`;
  fs.writeFileSync(file, text, { flag: 'wx' });
  copied.push({ prior: entry(`${prior}/${name}`), output: entry(file) });
}
const reviewFile = `${prior}/source-review-FIRST/result-affected-join1.record`;
const review = JSON.parse(fs.readFileSync(reviewFile));
assert.equal(review.status, 'SOURCE_PASS');
const pageRoot = 'ssot-resources/soviet10year-textbooks/artifacts/8a/pages/0081';
const pageBindings = ['page.md', 'page.json', 'audit.json'].map(name => {
  const file = `${pageRoot}/${name}`;
  const current = entry(file);
  const approved = review.bindings.find(item => path.resolve(item.path) === current.path);
  assert.ok(approved, `No approved page binding: ${file}`);
  assert.equal(current.sha256, approved.sha256);
  return current;
});
const page = JSON.parse(fs.readFileSync(`${pageRoot}/page.json`));
const heading = page.blocks.find(block => block.ref === 'p0081#4' || block.kind === 'h3');
assert.ok(heading && heading.kind === 'h3');
const record = {
  status: 'NEXT_SOURCE_READY_FOR_NEW_PAGE_PREPARATION_NOT_CONTENT_APPROVAL',
  time: new Date().toISOString(), ticket: 'STEMROBIN-182', book: '8a',
  lesson: 'alg8-c3-s1-n12', workdir: repo, copied,
  deliveredPriorLesson: { commit: delivered, push: entry(`${prior}/stages/delivery-push-FIRST/receipt.record`),
    remoteConfirm: entry(`${prior}/stages/delivery-remote-confirm-FIRST/receipt.record`) },
  reusedPage81: { approval: entry(reviewFile), files: pageBindings,
    sourceWork: path.resolve(`${prior}/source/8a/pages/0081`),
    sourcePixelsAndRecognitionRerun: false },
  scope: { start: 'p0081#4', newPhysicalPages: [82, 83, 84, 85],
    rightBoundary: 'TOC n13 starts on physical85; locate exact h3 from new source',
    preserveNextLessonFragments: true, publishOnlyCompleteN12: true },
  previousFailuresLocksBackupsAndUnknownUsagePreserved: true,
  unknownHistoricalBytesRecovered: false, parentImages: 0,
  databaseWrites: 0, merges: 0, deployments: 0, finish: 'review', totalCost: 'unknown',
};
const output = `${next}/bootstrap.record`;
fs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ status: record.status, output: entry(output) }));
