"""Assemble the reviewed N34 stream using the existing source assembler."""

import copy
import hashlib
import json
from pathlib import Path
import shutil
import sys

REPO = Path("/Users/yong/work/lemmadeck-ws/lemmadeck--STEMROBIN-182")
assert Path.cwd() == REPO
TOOLS = REPO / ".claude/skills/ld-s10y-lesson/tools"
sys.path.insert(0, str(TOOLS))
import assemble as A

BASE = REPO / ".tmp/ld-s10y-lesson/resume182-7-N34"
RAW = BASE / "raw-FIRST/8a"
STAGE = BASE / "assembly-FIRST"
BOOK = STAGE / "artifacts/8a"
ID = "alg8-c5-s2-n34"
assert not BOOK.exists(), "Preserve earlier assembly attempts"
review_path = BASE / "source-review-FIRST/source-comparison.record"
assert review_path.is_file(), "Receive the independent source review first"


def binding(path):
    return {
        "path": str(path.relative_to(REPO)),
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
    }


documents = []
sources = []
for page in [198, 213, 217]:
    path = REPO / (
        f"ssot-resources/soviet10year-textbooks/artifacts/8a/pages/{page:04d}/page.json"
    )
    documents.append((path, json.loads(path.read_bytes())))
    sources.append(binding(path))
for page in range(218, 223):
    directory = RAW / f"pages/{page:04d}"
    audit = json.loads((directory / "audit.json").read_bytes())
    assert not audit["errors"]
    assert audit["lines_md"] == audit["lines_printed"]
    path = directory / "page.json"
    document = json.loads(path.read_bytes())
    assert document["meta"]["printed_page"] == page - 7
    documents.append((path, document))
    sources.append(binding(path))

stream = A.load_stream(RAW, documents)


def number(block):
    match = A.SEC_NUM.match(A.B.text_of(block)) if block["kind"] == "h3" else None
    return match.group(1) if match else None


starts = [i for i, block in enumerate(stream) if number(block) == "34"]
assert len(starts) == 1
start = starts[0]
assert stream[start]["page"] == 217
end = next(
    i for i in range(start + 1, len(stream))
    if stream[i]["kind"] in ("h1", "h2", "h3")
)
assert number(stream[end]) == "35" and stream[end]["page"] == 222
chapter = next(block for block in reversed(stream[:start]) if block["kind"] == "h1")
section = next(block for block in reversed(stream[:start]) if block["kind"] == "h2")
selected = [chapter, section, *stream[start:end]]
merged, warnings = A.merge_across_pages(copy.deepcopy(selected))
assert not warnings, warnings
assert not any(block.get("open") for block in merged)
exercises = [int(block["label"]) for block in merged if block["kind"] == "ex"]
assert exercises == list(range(665, 675))
figure_blocks = [block for block in selected if block["kind"] == "fig"]
figures = sorted({block["id"] for block in figure_blocks})
assert figures == [
    "fig-81", "fig-82", "tbl-p0217-01", "tbl-p0218-01", "tbl-p0219-01"
]
for block in figure_blocks:
    source_root = (
        REPO / ".tmp/ld-s10y-lesson/resume182-7-N33/raw-FIRST/8a"
        if block["page"] == 217 else RAW
    )
    source_image = source_root / f"pages/{block['page']:04d}/figures/{block['id']}.png"
    destination = BOOK / f"figures/{block['id']}.png"
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source_image, destination)
    sources.append(binding(source_image))
for source_path, document in documents:
    destination = BOOK / f"pages/{document['meta']['page']:04d}/page.json"
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source_path, destination)

original_loader = A.load_stream
A.load_stream = lambda book: copy.deepcopy(selected) if book == BOOK else original_loader(book)
try:
    result = A.run(
        BOOK, REPO / "ssot-resources/soviet10year-textbooks/toc/8a/zh.json",
        TOOLS.parent / "profiles/soviet-cn.json",
        strict=True, work=None, exercise_numbering="book",
    )
finally:
    A.load_stream = original_loader
assert result == 0
index = json.loads((BOOK / "book.json").read_bytes())
assert not index["audit"]["errors"]
assert [lesson["id"] for lesson in index["lessons"]] == [ID]
record = {
    "schema": "stemrobin-182/scoped-source-assembly@1",
    "status": "RAW_CLOSED_NOT_MODERN_APPROVAL",
    "lesson": ID,
    "sources": sources,
    "independent_source_review": binding(review_path),
    "selected_refs": [block["ref"] for block in selected],
    "boundary": {"start": stream[start]["ref"], "excluded": stream[end]["ref"]},
    "exercise_numbers": exercises,
    "figures": figures,
    "prose_count": index["lessons"][0]["prose_blocks"],
    "existing_assembler_used": True,
    "source_block_indexes_preserved": True,
    "database_writes": 0,
    "complete_modern_lesson": False,
}
output = STAGE / "assembly.record"
output.write_text(json.dumps(record, ensure_ascii=False, indent=2) + "\n")
print(json.dumps({**binding(output), "exercises": len(exercises), "figures": figures}))
