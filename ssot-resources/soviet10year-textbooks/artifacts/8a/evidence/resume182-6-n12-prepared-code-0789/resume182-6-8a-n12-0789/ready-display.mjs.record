import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const [textPath, textHash, figurePath, figureHash, answerPath, answerHash] = process.argv.slice(2);
const base = '.tmp/resume182-6-8a-n12-0789';
const edition = 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral';
const id = 'alg8-c3-s1-n12';
const lesson = `${edition}/lessons/${id}`;
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bound = file => ({ path: path.resolve(file), sha256: sha(fs.readFileSync(file)) });
const read = (file, hash) => {
  const item = bound(file);
  if (hash) assert.equal(item.sha256, hash, file);
  return JSON.parse(fs.readFileSync(file));
};
const write = (file, value) => {
  fs.writeFileSync(file, `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
  return bound(file);
};
const owner = review => {
  assert.equal(review.reviewer.kind, 'independent_agent');
  assert.equal(review.book, '8a');
  assert.equal(review.lesson, id);
  assert.equal(review.edition, 'modern-us-neutral');
};
const textReview = read(textPath, textHash);
owner(textReview);
assert.equal(textReview.status, 'TEXT_PASS');
for (const [name, item] of Object.entries(textReview.approved_text_bindings)) {
  const template = read(item.path, item.sha256);
  const final = read(`${lesson}/${name === 'lesson' ? 'lesson' : 'exercises'}.json`);
  assert.equal(final.status, 'ready');
  template.status = final.status;
  assert.deepEqual(final, template, 'Final must equal the text-approved normalized candidate');
}
const figureReview = read(figurePath, figureHash);
owner(figureReview);
assert.equal(figureReview.status, 'pass');
const answerReview = read(answerPath, answerHash);
owner(answerReview);
assert.equal(answerReview.status, 'pass');
const candidate = read(answerReview.answerKey.path, answerReview.answerKey.sha256);
const answers = read(`${lesson}/answer-keys.json`);
const candidateComparable = structuredClone(candidate);
const finalComparable = structuredClone(answers);
for (const value of [candidateComparable, finalComparable]) {
  delete value.status;
  delete value.count;
}
assert.deepEqual(candidateComparable, finalComparable);
assert.equal(answers.status, 'ready');
const count = read(`${lesson}/exercises.json`).count;
assert.equal(count, 14);
assert.equal(answers.answers.length, count);
assert.ok(answers.answers.every(answer => answer.parts.every(part => part.judge !== 'exact')));
const figureIds = read(`${lesson}/figures.json`).figures.map(item => item.id).sort();
assert.deepEqual(figureReview.figures.map(item => item.id).sort(), figureIds);
const choiceDraft = read(`${lesson}/choice-set/draft.json`);
assert.equal(choiceDraft.new_figures.length, 0, 'Include independent new-choice-figure evidence before display');
const files = {
  modern: ['lesson.json', 'exercises.json', 'figures.json', 'adaptation.audit.json']
    .map(name => bound(`${lesson}/${name}`)),
  answers: ['answer-keys.json', 'answer-keys.audit.json'].map(name => bound(`${lesson}/${name}`)),
  choices: ['seed.json', 'draft.json', 'review.json'].map(name => bound(`${lesson}/choice-set/${name}`)),
  figures: figureIds.flatMap(figure => ['spec.json', 'svg', 'render.json', 'review.json']
    .map(ext => bound(`${edition}/figures/${figure}.${ext}`))),
};
assert.equal(read(`${lesson}/adaptation.audit.json`).status, 'pass');
assert.equal(read(`${lesson}/answer-keys.audit.json`).status, 'pass');
assert.equal(read(`${lesson}/choice-set/review.json`).outcome, 'pass');
for (const figure of figureIds) assert.equal(read(`${edition}/figures/${figure}.review.json`).status, 'pass');
const priorUsage = '.tmp/resume182-6-8a-n11-0789/display-FIRST/runtime-recovery-helper-history1/usage-FIRST.json';
const previous = read(priorUsage);
const usage = write(`${base}/upstream-usage.record`, {
  schema: 'stemrobin-182/upstream-usage-preservation@1',
  cumulative: previous.cumulative, previous: bound(priorUsage),
  currentEvidence: [
    bound(`${base}/source-author/result.record`), bound(textPath), bound(figurePath),
    bound(answerPath), bound(`${lesson}/choice-set/review.json`),
  ],
  note: 'Inherited unknown cumulative totals remain null. Known zero paid/generated/DB/app/dependency/other-chat actions remain zero. Local actual stage/image usage is retained in the bound original receipts, not reset or estimated.',
  parentImageViewsThisContinuation: 0, hostTokens: 'unknown', totalCost: 'unknown',
  databaseWrites: 0, finish: 'review',
});
const ready = {
  schema: 'n12-parent-display-ready@1', status: 'parentREADY', ticket: 'STEMROBIN-182',
  scope: { root: repo, book: '8a', edition: 'modern-us-neutral', lesson: id },
  authorization: { offlineDisplay: true, rendererCalls: 1, appAcceptance: false, production: false },
  files: Object.values(files).flat(),
  approvals: {
    modern: { status: 'pass', files: files.modern,
      receipts: [bound(textPath), bound(`${lesson}/adaptation.audit.json`)] },
    answers: { status: 'pass', finalized: true, files: files.answers,
      receipts: [bound(answerPath), bound(`${lesson}/answer-keys.audit.json`)] },
    choices: { status: 'pass', retained: true, files: files.choices,
      receipts: [bound(`${lesson}/choice-set/review.json`)] },
    figures: { status: 'pass', ids: figureIds, files: files.figures, receipts: [bound(figurePath)] },
  },
  upstreamUsage: usage, currentImageAccountingPreserved: true, oldPassReruns: 0,
  databaseWrites: 0, finish: 'review',
};
console.log(JSON.stringify(write(`${base}/parent-ready.record`, ready)));
