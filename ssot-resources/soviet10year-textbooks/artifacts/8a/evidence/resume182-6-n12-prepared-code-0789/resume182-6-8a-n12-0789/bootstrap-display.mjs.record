import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const prior = '.tmp/resume182-6-8a-n11-0789';
const base = '.tmp/resume182-6-8a-n12-0789';
const own = `${base}/display-FIRST`;
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const entry = file => {
  const bytes = fs.readFileSync(file);
  return { path: path.resolve(file), sha256: sha(bytes), bytes: bytes.length };
};
const priorReadyFile = `${prior}/display-FIRST/ready-helper-history1.record`;
const ready = JSON.parse(fs.readFileSync(priorReadyFile));
const assemblyFile = `${base}/assembly-RECOVERY1/assembly.record`;
const assembly = JSON.parse(fs.readFileSync(assemblyFile));
assert.equal(assembly.lesson, 'alg8-c3-s1-n12');
assert.equal(assembly.status, 'SCOPED_ASSEMBLY_PASS_NOT_SOURCE_APPROVAL');
const implementation = ['prepare.mjs', 'run.mjs', 'display-helper.mjs', 'display-helper-base.mjs'];
const origins = [], outputs = [], pins = [];
fs.mkdirSync(own);
for (const name of implementation) {
  const file = `${prior}/display-FIRST/${name}`;
  const original = entry(file);
  assert.equal(original.sha256, ready.files.find(item => item.path === original.path)?.sha256);
  let text = fs.readFileSync(file, 'utf8')
    .replaceAll('resume182-6-8a-n11-0789', 'resume182-6-8a-n12-0789')
    .replaceAll('alg8-c3-s1-n11', 'alg8-c3-s1-n12')
    .replaceAll('n11-parent-display-ready@1', 'n12-parent-display-ready@1')
    .replaceAll('bounded-n11-offline-display@1', 'bounded-n12-offline-display@1')
    .replaceAll('ready-helper-history1.record', 'ready-FIRST.record');
  if (name === 'prepare.mjs') {
    const line = 'export const requiredFigures = ["fig-28","tbl-p0077-02","tbl-p0078-01","fig-29"];';
    assert.equal(text.split(line).length, 2);
    text = text.replace(line, `export const requiredFigures = ${JSON.stringify(assembly.figures)};`);
  }
  const output = `${own}/${name}`;
  fs.writeFileSync(output, text, { flag: 'wx' });
  const check = spawnSync(process.execPath, ['--check', output], { cwd: repo, encoding: 'utf8' });
  assert.equal(check.status, 0, check.stderr);
  origins.push({ source: original, output: entry(output), syntaxExit: check.status });
  outputs.push(entry(output));
}
for (const pin of ready.pins) {
  if (implementation.some(name => pin.path === path.resolve(`${prior}/display-FIRST/${name}`))) continue;
  assert.equal(fs.realpathSync(pin.path), pin.realpath);
  assert.equal(entry(pin.path).sha256, pin.sha256);
  pins.push(pin);
}
for (const item of outputs) pins.push({ ...item, realpath: fs.realpathSync(item.path) });
const observerFile = `${prior}/observe-tools.mjs`;
const observerOut = `${base}/observe-tools.mjs`;
const observerText = fs.readFileSync(observerFile, 'utf8')
  .replaceAll('resume182-6-8a-n11-0789', 'resume182-6-8a-n12-0789')
  .replaceAll('alg8-c3-s1-n11', 'alg8-c3-s1-n12');
fs.writeFileSync(observerOut, observerText, { flag: 'wx' });
const observerCheck = spawnSync(process.execPath, ['--check', observerOut], { cwd: repo, encoding: 'utf8' });
assert.equal(observerCheck.status, 0, observerCheck.stderr);
const record = {
  status: 'SCRIPTS_PREPARED_RUNTIME_NOT_EXECUTED', workdir: repo,
  files: outputs, origins, pins, figureIds: assembly.figures,
  inventoryBasis: entry(assemblyFile), parentReadyRequired: true,
  correctedPriorImplementation: entry(priorReadyFile),
  observer: { source: entry(observerFile), output: entry(observerOut), syntaxExit: observerCheck.status },
  rendererCalls: 0, browserLaunches: 0, screenshotsCaptured: 0, imagesObserved: 0,
  contentApprovalReruns: 0, dependenciesRelinkedOrInstalled: 0,
  unknownHistoricalBytesRecovered: false, totalCost: 'unknown', databaseWrites: 0, finish: 'review',
};
const output = `${own}/ready-FIRST.record`;
fs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ status: record.status, output: entry(output), figureIds: assembly.figures }));
