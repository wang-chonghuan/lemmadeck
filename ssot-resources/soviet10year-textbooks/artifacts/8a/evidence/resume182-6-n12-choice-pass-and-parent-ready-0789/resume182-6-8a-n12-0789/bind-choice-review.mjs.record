import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-0789/lemmadeck';
assert.equal(process.cwd(), repo);
const base = '.tmp/resume182-6-8a-n12-0789';
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const reviewFile = `${base}/choice-review-FIRST/review.json`;
const bytes = fs.readFileSync(reviewFile);
assert.equal(sha(bytes), '5c4dde737dbf3fde1dbe40a79f7cfeb8b7381b032c3aeb4a979d28e358b5c332');
const review = JSON.parse(bytes);
assert.equal(review.schema, 's10y-choice-review-v1');
assert.equal(review.outcome, 'pass');
assert.equal(review.reviewer.kind, 'independent_agent');
assert.equal(review.question_reviews.length, 19);
assert.equal(review.source_reviews.length, 14);
const target = `${base}/choices-FIRST/review.json`;
fs.writeFileSync(target, bytes, { flag: 'wx' });
assert.equal(sha(fs.readFileSync(target)), sha(bytes));
const record = {
  status: 'APPROVED_REVIEW_BYTES_BOUND_NATIVE_RETENTION_PENDING',
  source: { path: path.resolve(reviewFile), sha256: sha(bytes) },
  target: { path: path.resolve(target), sha256: sha(bytes) },
  candidateDraft: { path: path.resolve(`${base}/choices-FIRST/draft.json`),
    sha256: sha(fs.readFileSync(`${base}/choices-FIRST/draft.json`)) },
  imagesViewed: 0, sourceOrDraftChanged: false, oldPassReruns: 0,
  databaseWrites: 0, finish: 'review', hostTokens: 'unknown', totalCost: 'unknown',
};
fs.writeFileSync(`${base}/choice-review-binding.record`, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify(record));
