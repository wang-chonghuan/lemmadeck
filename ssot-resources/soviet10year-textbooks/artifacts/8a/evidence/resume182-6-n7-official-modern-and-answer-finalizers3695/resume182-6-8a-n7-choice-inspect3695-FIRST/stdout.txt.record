  "concept_candidates": [
    {
      "block": 0,
      "text": "\u5148\u770b\u4e00\u4e2a\u542b\u53d8\u91cf$x$\u548c$y$\u7684\u591a\u9879\u5f0f$x^2+5xy^2-7xy+8$\u3002"
    },
    {
      "block": 1,
      "text": "\u5148\u660e\u786e\u542b\u51e0\u4e2a\u53d8\u91cf\u7684\u591a\u9879\u5f0f\u7684\u6b21\u6570\u7684\u6982\u5ff5\u3002"
    },
    {
      "block": 2,
      "text": "\u5728\u6807\u51c6\u5f62\u5f0f\u7684\u591a\u9879\u5f0f\u4e2d\uff0c\u627e\u51fa\u5404\u53d8\u91cf\u7684\u5e42\u6307\u6570\u4e4b\u548c\u6700\u5927\u7684\u4e00\u9879*\u3002\n\u8fd9\u4e00\u9879\u5404\u53d8\u91cf\u7684\u5e42\u6307\u6570\u4e4b\u548c\uff0c\u5c31\u662f\u8fd9\u4e2a\u591a\u9879\u5f0f\u7684\u6b21\u6570\u3002"
    },
    {
      "block": 3,
      "text": "\u4f8b\u5982\uff0c\u5728\u4e0a\u9762\u7684\u591a\u9879\u5f0f\u4e2d\uff0c\u5355\u9879\u5f0f$x^2$\u662f\u4e8c\u6b21\u9879\uff08\u8fd9\u4e2a\u5355\u9879\u5f0f\u4e2d\u53d8\u91cf$y$\u662f\u96f6\u6b21\u5e42\uff09\u3002\n\u5355\u9879\u5f0f$5xy^2$\u4e2d\u5404\u53d8\u91cf\u7684\u5e42\u6307\u6570\u4e4b\u548c\u7b49\u4e8e3\uff0c\u56e0\u6b64\u5b83\u662f\u4e09\u6b21\u9879\u3002\n\u5355\u9879\u5f0f$7xy$\u662f\u4e8c\u6b21\u9879\uff0c\u800c8\u662f\u96f6\u6b21\u9879\u3002\n\n\u56e0\u6b64\uff0c\u591a\u9879\u5f0f$x^2+5xy^2-7xy+8$\u662f\u4e09\u6b21\u591a\u9879\u5f0f\u3002"
    },
    {
      "block": 4,
      "text": "\u591a\u9879\u5f0f$x^3-2x^2y^2+y^4+7x^2y-3y^3+6xy-8$\u662f\u56db\u6b21\u591a\u9879\u5f0f\uff0c\u56e0\u4e3a\u5404\u9879\u4e2d\u53d8\u91cf\u7684\u5e42\u6307\u6570\u4e4b\u548c\u7684\u6700\u5927\u503c\uff08\u7b2c\u4e8c\u9879\u548c\u7b2c\u4e09\u9879\uff09\u7b49\u4e8e4."
    },
    {
      "block": 5,
      "text": "\u518d\u770b\u4e00\u4e2a\u542b\u4e24\u4e2a\u53d8\u91cf$x$\u548c$y$\u7684\u65b9\u7a0b$2x^5+4x^3y^3-9x^4y+y^5-5x+27=0$\u3002"
    },
    {
      "block": 6,
      "text": "\u8fd9\u4e2a\u65b9\u7a0b\u7684\u5de6\u8fb9\u662f\u516d\u6b21\u591a\u9879\u5f0f\uff0c\u53f3\u8fb9\u662f\u96f6\u3002\n\u6211\u4eec\u79f0\u5b83\u4e3a\u516d\u6b21\u65b9\u7a0b\u3002"
    },
    {
      "block": 7,
      "text": "* \u5728\u591a\u9879\u5f0f\u91cc\uff0c\u53d8\u91cf\u7684\u5e42\u6307\u6570\u548c\u6700\u5927\u7684\u4e00\u9879\u53eb\u505a\u591a\u9879\u5f0f\u7684\u9996\u9879."
    },
    {
      "block": 8,
      "text": "\u542b\u51e0\u4e2a\u53d8\u91cf\u7684\u65b9\u7a0b\uff0c\u5982\u679c\u5de6\u8fb9\u662f\u6807\u51c6\u5f62\u5f0f\u7684\u591a\u9879\u5f0f\uff0c\u53f3\u8fb9\u662f\u96f6\uff0c\u5c31\u628a\u8fd9\u4e2a\u591a\u9879\u5f0f\u7684\u6b21\u6570\u4f5c\u4e3a\u65b9\u7a0b\u7684\u6b21\u6570\u3002"
    },
    {
      "block": 9,
      "text": "\u8981\u786e\u5b9a\u65b9\u7a0b$(x^3+y)^2=x^6-1$\u7684\u6b21\u6570\uff0c\u5148\u628a\u5b83\u53d8\u5f62\uff0c\u4f7f\u5de6\u8fb9\u6210\u4e3a\u6807\u51c6\u5f62\u5f0f\u7684\u591a\u9879\u5f0f\uff0c\u53f3\u8fb9\u7b49\u4e8e\u96f6\u3002\n\u8fd9\u6837\u5f97\u5230\u4e0e\u539f\u65b9\u7a0b\u540c\u89e3\u7684\u65b9\u7a0b$2x^3y+y^2+1=0$\u3002\n\u56e0\u6b64\uff0c\u8fd9\u4e2a\u65b9\u7a0b\u548c\u539f\u65b9\u7a0b\u90fd\u662f\u56db\u6b21\u65b9\u7a0b\u3002"
    },
    {
      "block": 10,
      "text": "\u672c\u7ae0\u4e3b\u8981\u8ba8\u8bba\u4e8c\u5143\u4e00\u6b21\u65b9\u7a0b\u548c\u4e8c\u5143\u4e8c\u6b21\u65b9\u7a0b\u3002"
    },
    {
      "block": 11,
      "text": "\u4f7f\u4e8c\u5143\u65b9\u7a0b\u6210\u4e3a\u771f\u7b49\u5f0f\u7684\u53d8\u91cf\u53d6\u503c\u6570\u5bf9\uff0c\u53eb\u505a\u8fd9\u4e2a\u4e8c\u5143\u65b9\u7a0b\u7684\u89e3\u3002"
    },
    {
      "block": 12,
      "text": "\u4f8b\u5982\uff0c\u6570\u5bf9$(17,3)$\uff08\u7b2c\u4e00\u4e2a\u6570\u8868\u793a\u53d8\u91cf$x$\u7684\u503c\uff0c\u7b2c\u4e8c\u4e2a\u6570\u8868\u793a\u53d8\u91cf$y$\u7684\u503c\uff09\u662f\u65b9\u7a0b$x-2y^2+1=0$\u7684\u89e3\u3002\n\u4ee3\u5165\u540e\uff0c\u7b49\u5f0f$17-2\\times3^2+1=0$\u662f\u771f\u7b49\u5f0f\u3002"
    },
    {
      "block": 13,
      "text": "\u4efb\u610f\u9009\u53d6$y$\u503c\uff0c\u518d\u6c42\u51fa\u5bf9\u5e94\u7684$x$\u503c\uff0c\u5c31\u53ef\u4ee5\u5f97\u5230\u4efb\u610f\u591a\u4e2a\u5176\u4ed6\u6570\u5bf9\uff0c\u5b83\u4eec\u90fd\u662f\u8fd9\u4e2a\u65b9\u7a0b\u7684\u89e3\u3002\n\u4f8b\u5982\uff0c\u9009\u53d6$y$\u503c\u7b49\u4e8e0\uff0c\u5f97\u5230$x$\u503c\u7b49\u4e8e$-1$\u3002\n\u6570\u5bf9$(-1,0)$\u5c31\u662f\u65b9\u7a0b$x-2y^2+1=0$\u7684\u89e3\u3002"
    },
    {
      "block": 14,
      "text": "\u6bcf\u4e00\u4e2a\u542b\u4e24\u4e2a\u53d8\u91cf$x$\u548c$y$\u7684\u65b9\u7a0b\uff0c\u90fd\u786e\u5b9a\u4e00\u4e2a\u7531\u5b83\u7684\u89e3\u7ec4\u6210\u7684\u53d8\u91cf\u53d6\u503c\u6570\u5bf9$(x,y)$\u7684\u96c6\u5408\uff0c\u4e5f\u5c31\u662f\u5728\u53d8\u91cf$x$\u7684\u503c\u548c\u53d8\u91cf$y$\u7684\u503c\u4e4b\u95f4\u5efa\u7acb\u67d0\u79cd\u5173\u7cfb\u3002\n\u4e8c\u5143\u65b9\u7a0b\u7ed9\u51fa\u7684\u5173\u7cfb\u7684\u56fe\u8c61\uff0c\u7b80\u79f0\u4e8c\u5143\u65b9\u7a0b\u7684\u56fe\u8c61\uff0c\u662f\u4ee5\u8fd9\u4e2a\u65b9\u7a0b\u7684\u89e3\u4e3a\u5750\u6807\u7684\u5e73\u9762\u4e0a\u70b9\u7684\u96c6\u5408\u3002"
    },
    {
      "block": 15,
      "text": "$ax+by=c(a\\ne0$\u6216$b\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\uff0c\u5176\u56fe\u8c61\u662f\u76f4\u7ebf\uff1b\n$y=ax^2+bx+c(a\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\uff0c\u5176\u56fe\u8c61\u662f\u629b\u7269\u7ebf\uff1b\n$xy=k(k\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\uff0c\u5176\u56fe\u8c61\u662f\u53cc\u66f2\u7ebf\u3002"
    },
    {
      "block": 16,
      "text": "\u56fe14\u753b\u51fa\u4e86\u65b9\u7a0b$x^2+9y^2=81$\u7684\u56fe\u8c61\u3002\n\u8fd9\u79cd\u5f62\u5f0f\u7684\u66f2\u7ebf\u53eb\u505a\u692d\u5706\u3002"
    },
    {
      "block": 19,
      "text": "\u56fe15\u753b\u51fa\u4e86\u4e00\u4e2a\u5706\u5468\uff0c\u5b83\u7684\u5706\u5fc3\u5728\u5750\u6807\u539f\u70b9\uff0c\u534a\u5f84\u4e3a5\u4e2a\u5355\u4f4d\u957f\u3002\n\u4e0b\u9762\u6c42\u4ee5\u8fd9\u4e2a\u5706\u5468\u4e3a\u56fe\u8c61\u7684\u65b9\u7a0b\u3002"
    },
    {
      "block": 22,
      "text": "\u8bbe\u70b9$A(x,y)$\u662f\u8fd9\u4e2a\u5706\u5468\u4e0a\u4e0d\u5728\u4e24\u4e2a\u5750\u6807\u8f74\u4e0a\u7684\u4efb\u610f\u4e00\u70b9\u3002\n\u5728\u76f4\u89d2\u4e09\u89d2\u5f62$OAA_1$\u4e2d\uff0c\u7531\u52fe\u80a1\u5b9a\u7406\u5f97\uff1a\n$|OA_1|^2+|AA_1|^2=|OA|^2$\u3002\n\n\u663e\u7136\uff0c$|OA_1|^2=x^2$\uff0c$|AA_1|^2=y^2$\uff0c$|OA|^2=5^2$\u3002\n\u56e0\u6b64\uff0c\u5706\u5468\u4e0a\u4e0d\u5728\u4e24\u4e2a\u5750\u6807\u8f74\u4e0a\u7684\u4efb\u610f\u4e00\u70b9\u7684\u5750\u6807\u90fd\u6ee1\u8db3\u65b9\u7a0b$x^2+y^2=5^2$\uff1a \uff081\uff09"
    },
    {
      "block": 23,
      "text": "\u5706\u5468\u4e0e$x$\u8f74\u3001$y$\u8f74\u7684\u6bcf\u4e00\u4e2a\u4ea4\u70b9\uff0c\u5176\u5750\u6807\u4e5f\u6ee1\u8db3\u65b9\u7a0b\uff081\uff09\u3002\n\u4f8b\u5982\uff0c\u628a\u70b9$C(0,-5)$\u7684\u5750\u6807\u4ee3\u5165\u65b9\u7a0b\uff081\uff09\uff0c\u5f97\u5230\u771f\u7b49\u5f0f\uff1a\n$0^2+(-5)^2=5^2$\u3002"
    },
    {
      "block": 24,
      "text": "\u56e0\u6b64\uff0c\u8fd9\u4e2a\u5706\u5468\u4e0a\u4efb\u610f\u4e00\u70b9\u7684\u5750\u6807\u90fd\u6ee1\u8db3\u65b9\u7a0b\uff081\uff09\u3002"
    },
    {
      "block": 25,
      "text": "\u518d\u6765\u8bc1\u660e\uff1a\u4e0d\u5728\u8fd9\u4e2a\u5706\u5468\u4e0a\u7684\u70b9\uff0c\u5176\u5750\u6807\u4e0d\u6ee1\u8db3\u65b9\u7a0b\uff081\uff09\u3002"
    },
    {
      "block": 26,
      "text": "\u8bbe\u70b9$B(x_1,y_1)$\u5728\u5706\u5185\uff08\u53c2\u770b\u56fe15\uff09\uff0c\u90a3\u4e48$|OB|<5$\uff0c$x_1^2+y_1^2<5^2$\u3002"
    },
    {
      "block": 27,
      "text": "\u5982\u679c\u70b9$D(x_2,y_2)$\u5728\u5706\u5916\uff0c\u90a3\u4e48$|OD|>5$\uff0c$x_2^2+y_2^2>5^2$\u3002"
    },
    {
      "block": 28,
      "text": "\u56e0\u6b64\uff0c\u5f53\u4e14\u4ec5\u5f53\u5750\u6807\u4e3a$x$\u548c$y$\u7684\u70b9\u4f4d\u4e8e\u5706\u5fc3\u5728\u5750\u6807\u539f\u70b9\u3001\u534a\u5f84\u4e3a5\u4e2a\u5355\u4f4d\u957f\u7684\u5706\u5468\u4e0a\u65f6\uff0c\u7b49\u5f0f$x^2+y^2=5^2$\u6210\u7acb\u3002\n\u6240\u4ee5\uff0c\u56fe15\u4e2d\u7684\u5706\u5468\u5c31\u662f\u65b9\u7a0b$x^2+y^2=5^2$\u7684\u56fe\u8c61\u3002"
    },
    {
