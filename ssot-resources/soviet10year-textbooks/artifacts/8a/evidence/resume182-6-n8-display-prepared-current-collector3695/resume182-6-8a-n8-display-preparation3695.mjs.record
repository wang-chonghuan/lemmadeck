import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';

const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
assert.equal(process.cwd(), repo);
const source = '.tmp/resume182-6-8a-n7-display3695-FIRST';
const output = '.tmp/resume182-6-8a-n8-display3695-FIRST';
const own = '.tmp/resume182-6-8a-n8-display-preparation3695-FIRST';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const read = file => fs.readFileSync(file);
const save = (file, value) => {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, `${JSON.stringify(value, null, 2)}\n`, { flag: 'wx' });
};
assert.ok(!fs.existsSync(output) && !fs.existsSync(own));
const oldReady = JSON.parse(read(`${source}/ready-FIRST.record`));
const syntaxPath = '.tmp/resume182-6-8a-n7-display-preparation3695-FIRST/preparation.record';
const syntaxBytes = read(syntaxPath);
assert.equal(JSON.parse(syntaxBytes).helperSyntaxReused, true);
const substitutions = {
  'prepare.mjs': [
    [source, output],
    ["ID = 'alg8-c2-s1-n7'", "ID = 'alg8-c2-s1-n8'"],
    ["['fig-14', 'fig-15']", "['fig-16']"],
    ["'n7-parent-display-ready@1'", "'n8-parent-display-ready@1'"],
  ],
  'run.mjs': [
    ["'bounded-n7-offline-display@1'", "'bounded-n8-offline-display@1'"],
    ["'bounded-n7-display-usage@1'", "'bounded-n8-display-usage@1'"],
  ],
  'display-helper.mjs': [],
};
const files = [], transformations = [], syntax = [];
for (const [name, changes] of Object.entries(substitutions)) {
  const sourcePath = `${source}/${name}`, targetPath = `${output}/${name}`;
  const original = read(sourcePath);
  assert.equal(sha(original), oldReady.files.find(item => item.path === path.resolve(sourcePath)).sha256);
  let text = original.toString('utf8');
  for (const [before, after] of changes) {
    assert.equal(text.split(before).length - 1, 1, `${name}: expected one substitution`);
    text = text.replace(before, after);
  }
  fs.mkdirSync(output, { recursive: true });
  fs.writeFileSync(targetPath, text, { flag: 'wx' });
  const bytes = read(targetPath);
  files.push({ path: path.resolve(targetPath), sha256: sha(bytes), bytes: bytes.length });
  transformations.push({ name, sourcePath, sourceSha256: sha(original), changes,
    outputSha256: sha(bytes), byteIdentical: bytes.equals(original) });
  if (changes.length) {
    const command = [process.execPath, '--check', path.resolve(targetPath)];
    const receiptRoot = `${own}/syntax-${name}`;
    save(`${receiptRoot}/start.record`, { command, cwd: repo, started: new Date().toISOString() });
    const result = spawnSync(command[0], command.slice(1), { cwd: repo, encoding: 'utf8' });
    fs.writeFileSync(`${receiptRoot}/stdout.txt`, result.stdout ?? '', { flag: 'wx' });
    fs.writeFileSync(`${receiptRoot}/stderr.txt`, result.stderr ?? '', { flag: 'wx' });
    save(`${receiptRoot}/receipt.record`, { command, cwd: repo, returncode: result.status,
      signal: result.signal, error: result.error?.message ?? null });
    syntax.push({ name, invocations: 1, returncode: result.status, receiptRoot });
    assert.equal(result.status, 0, result.stderr);
  } else {
    syntax.push({ name, invocations: 0, status: 'REUSE_IDENTICAL_HELPER_SYNTAX',
      evidence: { path: syntaxPath, sha256: sha(syntaxBytes) } });
  }
  assert.equal(sha(read(sourcePath)), sha(original));
}
for (const pin of oldReady.pins) {
  assert.equal(fs.realpathSync(pin.path), pin.realpath);
  assert.equal(sha(read(pin.path)), pin.sha256);
}
const counters = Object.keys(oldReady.usage.local);
const ready = {
  schema: 'n8-display-preparation@1', status: 'SCRIPTS_PREPARED_RUNTIME_NOT_EXECUTED',
  workdir: repo, runtimeAuthorized: false,
  scope: { ticket: 'STEMROBIN-182', root: repo, book: '8a', edition: 'modern-us-neutral',
    lesson: 'alg8-c2-s1-n8', owned: path.resolve(output) },
  files, pins: oldReady.pins, requiredFigures: ['fig-16'],
  requiredFigureAssets: ['svg', 'spec.json', 'render.json', 'review.json'],
  expectedParentSchema: 'n8-parent-display-ready@1', rendererBudget: 1,
  viewports: oldReady.viewports, surfaces: oldReady.surfaces, syntax,
  transformations: { path: `${own}/preparation.record` },
  usage: { local: Object.fromEntries(counters.map(key => [key, 0])),
    cumulative: Object.fromEntries(counters.map(key => [key, null])) },
  runtime: 0, parentREADY: { produced: false, consumed: false },
  sourcePreparationEvidence: { path: `${source}/ready-FIRST.record`,
    sha256: sha(read(`${source}/ready-FIRST.record`)) },
  unknownHistoricalBytesRecovered: false, hostTokens: 'unknown', totalCost: 'unknown',
};
save(`${own}/preparation.record`, {
  status: 'PREPARED_ONLY', root: repo, book: '8a', lesson: 'alg8-c2-s1-n8',
  transformations, syntax, supportPinsVerified: oldReady.pins.length,
  helperSyntaxReused: true, newSyntaxCalls: 2, moduleEntryExecutions: 0,
  sourceModernAnswerChoiceOrFigureContentReads: 0, rendererBrowserRuntimeCalls: 0,
  parentREADYProducedOrConsumed: false, unknownHistoricalBytesRecovered: false,
  priorFailuresAndCountsUnchanged: true, DBWrites: 0, hostTokens: 'unknown', totalCost: 'unknown',
});
save(`${output}/ready-FIRST.record`, ready);
console.log(JSON.stringify({ status: ready.status, newSyntaxCalls: 2,
  record: `${own}/preparation.record`, sha256: sha(read(`${own}/preparation.record`)),
  ready: `${output}/ready-FIRST.record`, readySHA: sha(read(`${output}/ready-FIRST.record`)) }));
