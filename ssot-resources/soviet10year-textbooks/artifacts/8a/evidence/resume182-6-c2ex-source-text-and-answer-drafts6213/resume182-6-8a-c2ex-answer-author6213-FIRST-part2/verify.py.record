    check(s != 0 and s+3 != 0 and s+1 != 0, "b domain")
    check((r+1)/(s+3) == F(1, 2) and (r-1)/(s+1)*r/s == F(1, 5), "b original equations")
    check(2*q == 3*p and 2*p-q == 4, "a exact linear elimination")
    check(s == 2*r-1 and r*(r-3) == 0, "b elimination")
