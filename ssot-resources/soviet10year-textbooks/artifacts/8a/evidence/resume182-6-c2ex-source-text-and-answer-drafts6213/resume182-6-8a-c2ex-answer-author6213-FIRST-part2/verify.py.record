        check(a["grading"] != "ungraded" or not a["parts"], f"{e['number']} ungraded contract")

    current = "161"
    p = [value(part["expected"][0]) for part in answers[current]["parts"]]
    check(len(p) == 24, "all twelve coordinate pairs")
    for i in range(0, 8, 2):
