    check(v*(t-1)/u == F(5, 2), "a first post-meeting time")
    check(u*t/v == F(12, 5), "a second post-meeting time")
    check(D/u-(1+D/v) == F(1, 10), "a absolute arrival difference")
    check(multiply([-4, 1], [4, 9]) == [-16, -32, 9], "a speed roots exhaustive")
