    check(90/bus-(F(1, 2)+90/moto) == F(1, 2), "b absolute arrival difference")
    check(multiply([F(-3, 2), 1], [1, 1]) == [F(-3, 2), F(-1, 2), 1], "b ratio roots")

    current = "167"
