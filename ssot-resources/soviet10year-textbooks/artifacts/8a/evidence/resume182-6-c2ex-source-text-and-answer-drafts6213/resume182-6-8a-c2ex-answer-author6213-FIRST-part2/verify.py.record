    for i in range(8, 12, 2):
        x, y = p[i:i + 2]
        check(4*x**2 - 9*y**2 == 0 and x**2 - x*y - y**2 == -1, f"b pair {i//2-3}")
    for i in range(12, 20, 2):
        x, y = p[i:i + 2]
        check((x*y)**2 + x*y == 72 and x+y == 6, f"c pair {i//2-5}")
    for i in range(20, 24, 2):
        x, y = p[i:i + 2]
        check((x+y)**2 - 2*(x+y) == 15 and x+x*y+y == 11, f"d pair {i//2-9}")
    check(multiply([-8, 1], [9, 1]) == [-72, 1, 1], "c product branches exhaustive")
    check(multiply([-5, 1], [3, 1]) == [-15, -2, 1], "d sum branches exhaustive")
    check(F(11, 4) > 0 and -1 < 0, "b opposite-sign factor branch impossible")
    check((-3)**2 - 4*14 == -47, "d rejected negative discriminant")

