                64 <= r2 <= 100 and x*y <= 0,
                y >= x*x and y <= 9-x*x,
                y >= x*x+4*x+4 and y <= 4,
                y >= (x-1)**2 and y <= F(7, 2),
                y >= (x-2)*(x-3) and y <= 0,
            ]
            described = [
                F(13, 10)**2 <= r2 <= 3**2,
                ((1 < x <= 6) or (-6 <= x < -1)) and y*y <= 36-x*x,
                -8 < x < 8 and y*y <= 100-x*x,
                r2 <= F(6, 5)**2 and ((x >= 0 and y >= 0) or (x <= 0 and y <= 0)),
                8**2 <= r2 <= 10**2 and ((x <= 0 and y >= 0) or (x >= 0 and y <= 0)),
                x*x <= F(9, 2) and x*x <= y <= 9-x*x,
                -4 <= x <= 0 and (x+2)**2 <= y <= 4,
                (x-1)**2 <= F(7, 2) and (x-1)**2 <= y <= F(7, 2),
                2 <= x <= 3 and (x-2)*(x-3) <= y <= 0,
