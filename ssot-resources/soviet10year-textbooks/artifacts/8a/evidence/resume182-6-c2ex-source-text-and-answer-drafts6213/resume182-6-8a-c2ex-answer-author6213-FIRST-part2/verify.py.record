            for i, (a, b) in enumerate(zip(original, described)):
                check(a == b, f"{chr(97+i)} region/boundary at {x},{y}")

    current = "180"
    area, = rational(answers[current]["parts"])
    check(area == F(4*4, 2), "explicit diamond area")
    current = "187"
    a, b = rational(answers[current]["parts"])
    check(a == F(8*4, 2) == 16, "a explicit area")
    for x, y in ((F(-1), F(1)), (F(3), F(3))):
        check(y == abs(x) and y == x/2+F(3, 2), "b exact vertices")
    check(b == F(abs(-1*3-1*3), 2) == 3, "b explicit determinant area")
    check(b == F(3, 4)+F(9, 4), "b split-triangle area cross-check")

    report["sourceExerciseCount"] = len(selected)
    report["sourcePrimarySubparts"] = sum(
        len(re.findall(r"^[a-i]\)", e["text"], flags=re.M)) or 1 for e in selected
    )
    report["autoExercises"] = sum(a["grading"] == "auto" for a in answers.values())
    report["ungradedExercises"] = sum(a["grading"] == "ungraded" for a in answers.values())
    report["autoParts"] = sum(len(a["parts"]) for a in answers.values())
    report["ungradedDisplaySlots"] = sum(len(a.get("subpartAnswers", [])) for a in answers.values())
    report["grid"] = {"axisValues": len(grid), "points": len(grid)**2, "arithmetic": "exact Fraction"}
except Exception:
    failures.append({"exercise": current, "exception": traceback.format_exc()})

report["checksByExercise"] = dict(checks)
report["checks"] = sum(checks.values())
report["failures"] = failures
report["status"] = "pass" if not failures else "fail"
report["exitCode"] = 0 if not failures else 1
index = 1
while (ROOT / f"verification-algebra-{index:03d}.json").exists():
    index += 1
receipt = ROOT / f"verification-algebra-{index:03d}.json"
payload = json.dumps(report, ensure_ascii=False, indent=2) + "\n"
with receipt.open("x") as handle:
    handle.write(payload)
print(payload, end="")
print(f"RECEIPT {receipt}")
sys.exit(report["exitCode"])
