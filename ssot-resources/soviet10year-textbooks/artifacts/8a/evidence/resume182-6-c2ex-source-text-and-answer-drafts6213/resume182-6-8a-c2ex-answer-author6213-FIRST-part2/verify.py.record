#!/usr/bin/env python3
"""Bounded offline algebra checks; no external packages, figures, or services."""

from collections import Counter
from dataclasses import dataclass
from fractions import Fraction as F
import hashlib
import json
from pathlib import Path
import re
import sys
import traceback


ROOT = Path(__file__).resolve().parent
REPO = ROOT.parent.parent
SOURCE = REPO / ".tmp/resume182-6-8a-c2ex-modern6213-AFFECTED-continuation1/adapt/8a/modern-us-neutral/lessons/alg8-c2-ex/exercises.template.json"
PARENT = REPO / ".tmp/resume182-6-8a-c2ex-modern6213-AFFECTED-continuation1/text-author/ready.record"
EXPECTED_SOURCE_SHA = "154b9cac05f121628bcdbbe511127d48d1462be141da8fe6f05851d752d42fa0"
EXPECTED_PARENT_SHA = "892f0e474dde43bdeb721eaceb59536c107d3d39c858c2c5db1a087e26f90183"
SCOPE = [str(n) for n in range(161, 188) if n not in (177, 186)]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


@dataclass(frozen=True)
class Q:
    """An exact a+b*sqrt(d); only the two quadratic fields needed by 161."""

    a: F = F(0)
    b: F = F(0)
    d: int = 0

    @staticmethod
    def coerce(other):
        return other if isinstance(other, Q) else Q(F(other))

    def __add__(self, other):
        other = Q.coerce(other)
        d = self.d if self.b else other.d
        if self.b and other.b and self.d != other.d:
            raise ValueError("Different quadratic fields")
        return Q(self.a + other.a, self.b + other.b, d)

    __radd__ = __add__

    def __neg__(self):
        return Q(-self.a, -self.b, self.d)

    def __sub__(self, other):
        return self + -Q.coerce(other)

    def __rsub__(self, other):
        return Q.coerce(other) + -self

    def __mul__(self, other):
        other = Q.coerce(other)
        d = self.d if self.b else other.d
        if self.b and other.b and self.d != other.d:
            raise ValueError("Different quadratic fields")
        return Q(
            self.a * other.a + self.b * other.b * d,
            self.a * other.b + self.b * other.a,
            d,
        )

    __rmul__ = __mul__

    def __pow__(self, n):
        if n != 2:
            raise ValueError("This checker only needs squaring")
        return self * self

    def __eq__(self, other):
        other = Q.coerce(other)
        return self.a == other.a and self.b == other.b and (
            self.b == 0 or self.d == other.d
        )


RADICALS = {
    "-4\\sqrt{5}": Q(F(0), F(-4), 5),
    "2\\sqrt{5}": Q(F(0), F(2), 5),
    "4\\sqrt{5}": Q(F(0), F(4), 5),
    "-2\\sqrt{5}": Q(F(0), F(-2), 5),
    "3-3\\sqrt{2}": Q(F(3), F(-3), 2),
    "3+3\\sqrt{2}": Q(F(3), F(3), 2),
}


def value(text):
    if text in RADICALS:
        return RADICALS[text]
    fraction = re.fullmatch(r"(-?)\\frac(\d)(\d)", text)
    if fraction:
        sign = -1 if fraction[1] else 1
        return Q(F(sign * int(fraction[2]), int(fraction[3])))
    return Q(F(text))


def multiply(p, q):
    out = [F(0)] * (len(p) + len(q) - 1)
    for i, a in enumerate(p):
        for j, b in enumerate(q):
            out[i + j] += F(a) * F(b)
    return out


checks = Counter()
failures = []
current = "scope"


def check(ok, name):
    checks[current] += 1
    if not ok:
        failures.append({"exercise": current, "check": name})


def rational(parts):
    values = [value(p["expected"][0]) for p in parts]
    if any(v.b for v in values):
        raise ValueError("Expected a rational candidate")
    return [v.a for v in values]


report = {
    "schema": "stemrobin-182/answer-author-exact-algebra-check@1",
    "status": "NOT_RUN",
    "cwd": str(REPO),
    "command": "python3 .tmp/resume182-6-8a-c2ex-answer-author6213-FIRST-part2/verify.py",
