def sha_bytes(value):
    return hashlib.sha256(value).hexdigest()


def json_bytes(value):
    return (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8")


def json_sha(value):
    return sha_bytes(json_bytes(value))


def binding(path, data):
    return {"path": str(path), "sha256": sha_bytes(data)}


def save_record(name, value):
    path = SCOPE / name
    if path.parent != SCOPE or path.exists():
        raise RuntimeError(f"Refusing non-exclusive record write: {path}")
    payload = json_bytes(value)
    with path.open("xb") as handle:
        handle.write(payload)
    path.chmod(0o444)
    return binding(path, payload)


def whitespace_equivalent(text):
    return re.sub(r"\s+", "", text)


def exact_formulas(text):
    return [
        match.group(1) or match.group(2)
        for match in edition.MATH.finditer(text)
    ]


def multiset_record(expressions):
    return [
        {"expression": expression, "multiplicity": count}
        for expression, count in sorted(Counter(expressions).items())
    ]


def split_parts(text, alphabet):
    markers = [
        match for match in edition.PART_MARKER.finditer(edition.masked_math(text))
        if match.group("label") in alphabet
    ]
    if not markers:
        return {"prefix": text, "parts": []}
    parts = []
    for index, marker in enumerate(markers):
        end = markers[index + 1].start() if index + 1 < len(markers) else len(text)
        parts.append({
            "label": marker.group("label"),
            "payload": text[marker.end():end].strip(),
            "offset": marker.start(),
        })
    return {"prefix": text[:markers[0].start()].rstrip(), "parts": parts}


