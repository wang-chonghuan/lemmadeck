checks = []
blockers = []


def check(name, passed, detail=None):
    record = {"name": name, "pass": bool(passed)}
    if detail is not None:
        record["detail"] = detail
    checks.append(record)
    if not passed:
        blockers.append({"check": name, "detail": detail})
    return bool(passed)


