    "actual_python": sys.executable,
    "python_version": sys.version,
    "PYTHONDONTWRITEBYTECODE": os.environ["PYTHONDONTWRITEBYTECODE"],
    "sys_dont_write_bytecode": sys.dont_write_bytecode,
    "production_functions_called": [
        "edition.normalize_lesson_layout",
        "edition.normalize_exercise_layout",
    ],
    "evidence_helpers_only": [
        "edition.MATH", "edition.PART_MARKER", "edition.masked_math",
        "edition.number_signature", "standard-library JSON and SHA256",
    ],
    "image_api_calls": 0,
    "no_production_validators_publishers_or_renderers": True,
    "input_files": files,
