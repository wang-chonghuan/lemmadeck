        files[f"raw_{kind}"]["sha256"] == EXPECTED_SOURCE[kind],
    )
    check(f"{kind}_source_snapshot_exact", original["source"]["data"] == raw)
    check(
        f"{kind}_source_binding_exact",
        original["source"]["sha256"] == files[f"raw_{kind}"]["sha256"]
        and original["source"]["path"] == f"lessons/alg8-c3-s1-n11/{kind}.json",
    )
    check(f"{kind}_edition", original["edition"] == "modern-us-neutral")

lesson = copy.deepcopy(original_lesson)
exercises = copy.deepcopy(original_exercises)
edition.normalize_lesson_layout(lesson)
edition.normalize_exercise_layout(exercises)

normalization_differences = []
for kind, original, normalized, collection in [
    ("lesson", original_lesson, lesson, "prose"),
    ("exercises", original_exercises, exercises, "exercises"),
]:
    for index, (before, after) in enumerate(zip(original[collection], normalized[collection])):
        if before != after:
            changed_fields = [
                key for key in sorted(set(before) | set(after))
                if before.get(key) != after.get(key)
            ]
            normalization_differences.append({
                "kind": kind,
                "index": index,
                "number": after.get("number"),
                "source_refs": after.get("source_refs", after.get("pages")),
                "changed_fields": changed_fields,
            })
            check(
                f"{kind}_{index}_normalization_only",
                set(changed_fields) <= {"text", "lines", "changes"}
                and whitespace_equivalent(before["text"]) == whitespace_equivalent(after["text"]),
                changed_fields,
            )
    copy_for_idempotence = copy.deepcopy(normalized)
    if kind == "lesson":
        edition.normalize_lesson_layout(copy_for_idempotence)
    else:
        edition.normalize_exercise_layout(copy_for_idempotence)
    check(f"{kind}_production_normalization_idempotent", copy_for_idempotence == normalized)

files["normalized_lesson_template"] = save_record("lesson.template.json.record", lesson)
files["normalized_exercises_template"] = save_record("exercises.template.json.record", exercises)

check("lesson_identity_fields", all(
    lesson.get(field) == raw_lesson.get(field) for field in edition.IDENTITY_FIELDS
))
check("lesson_figure_bindings", lesson["figures"] == raw_lesson["figures"])
check("prose_count_and_order", len(lesson["prose"]) == len(raw_lesson["prose"]) == 25)
check("exercise_numbers_order_count", (
    [item["number"] for item in exercises["exercises"]]
    == [item["number"] for item in raw_exercises["exercises"]]
    == [str(number) for number in range(188, 204)]
    and exercises["count"] == raw_exercises["count"] == 16
))
check("section_breaks_no_modern_drift", lesson["section_breaks"] == original_lesson["section_breaks"] == [])
check("errata_no_modern_math_change", lesson["errata"] == original_lesson["errata"] == [])

formula_evidence = []
layout_evidence = []
for kind, raw_doc, original_doc, normalized_doc, collection in [
    ("prose", raw_lesson, original_lesson, lesson, "prose"),
    ("exercise", raw_exercises, original_exercises, exercises, "exercises"),
]:
    for index, (raw, original, normalized) in enumerate(zip(
        raw_doc[collection], original_doc[collection], normalized_doc[collection],
    )):
        object_id = f"prose:{index}" if kind == "prose" else f"exercise:{raw['number']}"
        expressions = exact_formulas(raw["text"])
        original_expressions = exact_formulas(original["text"])
        normalized_expressions = exact_formulas(normalized["text"])
        raw_multiset = multiset_record(expressions)
        exact_multiset = (
            Counter(expressions) == Counter(original_expressions)
            == Counter(normalized_expressions)
        )
        exact_order = expressions == original_expressions == normalized_expressions
        check(f"{object_id}_exact_formula_multiset", exact_multiset)
        check(f"{object_id}_exact_formula_order", exact_order)
        chinese_math_punctuation = [
            expression for expression in normalized_expressions
            if re.search(r"[、，；。？！：]", expression)
        ]
        check(f"{object_id}_chinese_punctuation_outside_math", not chinese_math_punctuation)
        check(
            f"{object_id}_numbers_and_conditions",
            edition.number_signature(raw["text"]) == edition.number_signature(normalized["text"]),
        )
        check(f"{object_id}_source_text_exact", normalized["source_text"] == raw["text"])
        identity_fields = (
            ("kind", "id", "label", "printed_page", "source_refs")
            if kind == "prose" else
            ("number", "source_number", "group", "group_id", "pages", "figure_refs", "figures")
        )
        check(
            f"{object_id}_metadata_refs_groups",
            all(normalized.get(key) == raw.get(key) for key in identity_fields),
        )
        check(f"{object_id}_no_numeric_changes", normalized["numeric_changes"] == [])
        check(f"{object_id}_no_historical_entities", normalized["historical_entities"] == [])
        check(f"{object_id}_modern_cyrillic_absent", not edition.CYRILLIC.search(normalized["text"]))
        forbidden = [
            term for term in profile["forbidden_terms"] + profile["forbidden_person_names"]
            if term in normalized["text"]
        ]
        check(f"{object_id}_modern_profile_terms", not forbidden, forbidden)
        formula_evidence.append({
            "object": object_id,
            "source_refs": raw.get("source_refs", raw.get("pages")),
            "count": len(expressions),
            "raw_multiset": raw_multiset,
            "raw_multiset_sha256": json_sha(raw_multiset),
            "original_multiset_sha256": json_sha(multiset_record(original_expressions)),
            "normalized_multiset_sha256": json_sha(multiset_record(normalized_expressions)),
            "exact_multiset_equal": exact_multiset,
            "exact_order_equal": exact_order,
            "layout_math_splitting_needed": False,
            "chinese_punctuation_inside_math": chinese_math_punctuation,
        })
        if kind == "prose":
            check(
                f"{object_id}_only_whitespace_layout",
                whitespace_equivalent(normalized["text"]) == whitespace_equivalent(raw["text"]),
            )
            paragraphs = normalized["text"].split("\n\n") if normalized["text"] else []
            layout_evidence.append({
                "object": object_id,
                "kind": normalized["kind"],
                "paragraphs": paragraphs,
                "paragraph_count": len(paragraphs),
                "source_refs": raw["source_refs"],
            })
        else:
            check(
                f"{object_id}_lines_exactly_text",
                normalized["lines"] == normalized["text"].splitlines(),
            )

context_evidence = []
subpart_evidence = []
for raw, modern in zip(raw_exercises["exercises"], exercises["exercises"]):
    number = raw["number"]
    expected = raw["text"]
    if number == "188":
        expected = expected.replace("\u00ab\u8230\u65d7\u00bb", " Westview ")
        expected = expected.replace("\u00ab\u4e1c\u65b9\u00bb", " Eastside ")
        check("exercise:188_exact_query_name_replacement", modern["text"] == expected)
        context_evidence.append({
            "object": "exercise:188",
            "changes": modern["changes"],
            "replacements": [
                {"source": "\u00ab\u8230\u65d7\u00bb", "modern": "Westview", "authorized_rank": 1},
                {"source": "\u00ab\u4e1c\u65b9\u00bb", "modern": "Eastside", "authorized_rank": 4},
            ],
            "authorized_table_order": ["Westview", "Dawn", "Zenith", "Eastside", "Harvest"],
            "order_evidence_origin": "Human authorization in this request, not an image observation",
            "query_relations_unchanged": True,
            "five_distinct_ranked_terms_preserved": True,
            "figure_ref": modern["figure_refs"],
            "figure_contents_inspected_or_approved": False,
            "text": modern["text"],
        })
    elif number == "190":
        expected = expected.replace("\u4fc4\u8bed", "\u82f1\u8bed")
        check("exercise:190_exact_subject_replacement", modern["text"] == expected)
        context_evidence.append({
            "object": "exercise:190",
            "changes": modern["changes"],
            "replacement": {"source": "\u4fc4\u8bed", "modern": "\u82f1\u8bed"},
            "four_subject_order_unchanged": True,
            "grade_day_lesson_count_and_each_subject_condition_unchanged": True,
            "text": modern["text"],
        })
    elif number in EXPECTED_SUBPARTS:
        source_parts = split_parts(raw["text"], edition.CYRILLIC_PARTS)
        modern_parts = split_parts(modern["text"], edition.LATIN_PARTS)
        count = EXPECTED_SUBPARTS[number]
        source_labels = [part["label"] for part in source_parts["parts"]]
        modern_labels = [part["label"] for part in modern_parts["parts"]]
        check(
            f"exercise:{number}_natural_label_order",
            source_labels == list(edition.CYRILLIC_PARTS[:count])
            and modern_labels == list(edition.LATIN_PARTS[:count]),
            {"source_labels": source_labels, "modern_labels": modern_labels},
        )
        check(
            f"exercise:{number}_prefix_unchanged",
            whitespace_equivalent(source_parts["prefix"])
            == whitespace_equivalent(modern_parts["prefix"]),
        )
        parts = []
        for source_part, modern_part in zip(source_parts["parts"], modern_parts["parts"]):
            same = (
                whitespace_equivalent(source_part["payload"])
                == whitespace_equivalent(modern_part["payload"])
            )
            check(
                f"exercise:{number}_complete_payload_{modern_part['label']}",
                same,
                {"source_label": source_part["label"], "modern_label": modern_part["label"]},
            )
            parts.append({
                "source_label": source_part["label"],
                "modern_label": modern_part["label"],
                "source_complete_payload": source_part["payload"],
                "modern_complete_payload": modern_part["payload"],
                "payload_equal_except_whitespace": same,
            })
        line_labels = [
            re.match(r"^([a-z])\) ", line).group(1)
            for line in modern["text"].splitlines()
            if re.match(r"^([a-z])\) ", line)
        ]
        check(
            f"exercise:{number}_one_prefix_and_one_line_per_complete_subpart",
            line_labels == list(edition.LATIN_PARTS[:count])
            and len(modern["text"].splitlines()) == count + 1
            and "\u3000" not in modern["text"],
        )
        subpart_evidence.append({
            "number": number,
            "source_refs": raw["pages"],
            "source_labels": source_labels,
            "modern_labels": modern_labels,
            "prefix": modern_parts["prefix"],
            "parts": parts,
            "complete_payloads_checked_not_just_formula_multiset": True,
            "mechanical_column_reassignment_used": False,
        })
    else:
        check(f"exercise:{number}_neutral_text_unchanged", modern["text"] == raw["text"])

check("eleven_cyrillic_subpart_items", len(subpart_evidence) == 11)
check("context_change_declarations", all(
