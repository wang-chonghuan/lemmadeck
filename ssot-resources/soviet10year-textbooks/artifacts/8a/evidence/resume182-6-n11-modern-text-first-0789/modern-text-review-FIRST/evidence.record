      "parts": [
        {
          "source_label": "а",
          "modern_label": "a",
          "source_complete_payload": "设$(b_n)$是有限数列，它的项是按照递增的顺序选取的能被13整除的两位数. 指出$b_1,b_4,b_7$.",
          "modern_complete_payload": "设$(b_n)$是有限数列，它的项是按照递增的顺序选取的能被13整除的两位数. 指出$b_1,b_4,b_7$.",
          "payload_equal_except_whitespace": true
        },
        {
          "source_label": "б",
          "modern_label": "b",
          "source_complete_payload": "设$(z_n)$是无穷数列，它所有的奇数项都等于$-1$，而所有的偶数项都等于0. 求$z_1,z_4,z_{100},z_{253},z_{2k},z_{2k+1}$，$k\\in N$.",
          "modern_complete_payload": "设$(z_n)$是无穷数列，它所有的奇数项都等于$-1$，而所有的偶数项都等于0. 求$z_1,z_4,z_{100},z_{253},z_{2k},z_{2k+1}$，$k\\in N$.",
          "payload_equal_except_whitespace": true
        }
      ],
      "complete_payloads_checked_not_just_formula_multiset": true,
      "mechanical_column_reassignment_used": false
    },
