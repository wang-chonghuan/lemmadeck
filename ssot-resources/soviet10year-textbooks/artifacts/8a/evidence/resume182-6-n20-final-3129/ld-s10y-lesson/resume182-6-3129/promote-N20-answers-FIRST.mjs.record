import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
assert.equal(process.cwd(), root);
const base = '.tmp/ld-s10y-answer/resume182-6-3129';
const source = path.join(root, base, 'answer-N20-grade-RECOVERY1/answer-keys.json');
const reviewPath = path.join(root, base, 'answer-N20-grade-review-RECOVERY1/result.json');
const target = path.join(root, 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c3-s3-n20/answer-keys.json');
const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const binding = filename => {
  const bytes = fs.readFileSync(filename);
  return { path: filename, sha256: sha(bytes), bytes: bytes.length };
};
const approvedHash = process.argv[2];
assert.match(approvedHash ?? '', /^[a-f0-9]{64}$/u);
const review = JSON.parse(fs.readFileSync(reviewPath));
assert.ok(['ANSWER_PASS', 'PASS'].includes(review.status));
assert.equal(binding(source).sha256, approvedHash);
assert.ok(JSON.stringify(review).includes(approvedHash), 'Reviewer must bind this exact key.');
const document = JSON.parse(fs.readFileSync(source));
assert.equal(document.lesson, 'alg8-c3-s3-n20');
assert.deepEqual(document.answers.map(item => item.exercise),
  Array.from({ length: 14 }, (_, index) => String(309 + index)));
assert.ok(!fs.existsSync(target));
fs.writeFileSync(target, fs.readFileSync(source), { flag: 'wx' });
const record = { status: 'APPROVED_ANSWERS_PROMOTED_IDENTICALLY', date: new Date().toISOString(),
  cwd: root, source: binding(source), review: binding(reviewPath), target: binding(target),
  nativeFinalizePending: true, newMathOrImageReview: false, parentImages: 0 };
const output = path.join(root, '.tmp/ld-s10y-lesson/resume182-6-3129/answers-N20-promotion-FIRST/result.record');
fs.mkdirSync(path.dirname(output), { recursive: true });
fs.writeFileSync(output, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx' });
console.log(JSON.stringify({ ...record, record: binding(output) }));
