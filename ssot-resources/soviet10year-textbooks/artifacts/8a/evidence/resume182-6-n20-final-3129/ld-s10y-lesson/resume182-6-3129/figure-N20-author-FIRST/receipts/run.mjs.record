import assert from 'node:assert/strict'
import crypto from 'node:crypto'
import fs from 'node:fs'
import path from 'node:path'
import { spawnSync } from 'node:child_process'

const cwd = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck'
assert.equal(process.cwd(), cwd)
const root = path.resolve('.tmp/ld-s10y-lesson/resume182-6-3129/figure-N20-author-FIRST')
const [name, command, ...argv] = process.argv.slice(2)
assert(/^[a-z0-9-]+$/.test(name) && command)
const stem = path.join(root, 'receipts', name)
assert(!fs.existsSync(`${stem}.json`), `Receipt already exists: ${name}`)
const startedAt = new Date().toISOString()
const result = spawnSync(command, argv, { cwd, encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 })
fs.writeFileSync(`${stem}.stdout`, result.stdout || '')
fs.writeFileSync(`${stem}.stderr`, result.stderr || '')
const bind = file => ({
  path: file, sha256: crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex'),
  bytes: fs.statSync(file).size,
})
const receipt = {
  schema: 'ld-s10y-image/author-execution@1', cwd, command, argv,
  startedAt, completedAt: new Date().toISOString(),
  exitCode: result.status, signal: result.signal, error: result.error?.message || null,
  stdout: bind(`${stem}.stdout`), stderr: bind(`${stem}.stderr`),
}
fs.writeFileSync(`${stem}.json`, `${JSON.stringify(receipt, null, 2)}\n`)
console.log(JSON.stringify(receipt, null, 2))
process.stdout.write(result.stdout || '')
process.stderr.write(result.stderr || '')
process.exitCode = result.status ?? 1
