import assert from 'node:assert/strict'
import crypto from 'node:crypto'
import fs from 'node:fs'
import path from 'node:path'

const cwd = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck'
assert.equal(process.cwd(), cwd)
const work = '.tmp/ld-s10y-lesson/resume182-6-3129/figure-N20-author-FIRST'
const prepared = '.tmp/ld-s10y-lesson/adapt/8a/modern-us-neutral/lessons/alg8-c3-s3-n20'
const digest = file => crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex')
const binding = file => ({ path: path.resolve(file), sha256: digest(file), bytes: fs.statSync(file).size })
const load = file => JSON.parse(fs.readFileSync(file, 'utf8'))
const write = (file, data) => {
  assert(!fs.existsSync(file), `Refusing to overwrite ${file}`)
  fs.writeFileSync(file, `${JSON.stringify(data, null, 2)}\n`)
}
const lessonFile = `${prepared}/lesson.template.json`
const exercisesFile = `${prepared}/exercises.template.json`
const preparedSnapshots = new Map([lessonFile, exercisesFile].map(file => [file, fs.readFileSync(file)]))
const preparedBinding = file => ({
  path: path.resolve(file),
  sha256: crypto.createHash('sha256').update(preparedSnapshots.get(file)).digest('hex'),
  bytes: preparedSnapshots.get(file).length,
})
const sourceFile = 'ssot-resources/soviet10year-textbooks/artifacts/8a/figures/fig-32.png'
const sourcePass = '.tmp/ld-s10y-lesson/resume182-6-3129/source-N20-crop-review-FIRST/result.json'
assert.equal(digest(sourceFile), 'f8cb6f416038ce000c219ba8ea97cb40f210f0411cfb5525ee4291730d6f1789')
assert.equal(digest(sourcePass), '6988effe4ea6a2ca0d864913a80b3c500dff731af0ade5cf7d32996033aa6649')
assert.equal(load(sourcePass).status, 'SOURCE_PASS')
const lesson = JSON.parse(preparedSnapshots.get(lessonFile))
const exercises = JSON.parse(preparedSnapshots.get(exercisesFile))
const exercise = exercises.exercises.find(item => item.number === '320')
assert(exercise && exercise.figure_refs.includes('fig-32'))
const mathTokens = text => [...text.matchAll(/\$([^$]+)\$/g)].map(match => match[1].replace(/\s+/g, ''))
assert.deepEqual(mathTokens(exercise.text), mathTokens(exercise.source_text))
for (const block of lesson.prose) assert.deepEqual(mathTokens(block.text), mathTokens(block.source_text))
const inventory = load(`${work}/inventory.json`)
assert.deepEqual(inventory.observed.points.map(item => item.at), [[1, 2], [3, 5], [6, 1]])
const imageBytes = fs.readFileSync(sourceFile)
const authoritativeText = [
  { lesson: lesson.id, text: `${lesson.printed_title}\n${lesson.prose.map(block => block.text).join('\n\n')}` },
  { lesson: lesson.id, exercise: '320', text: exercise.text },
]
const context = {
  schema: 'ld-s10y-image/draft-context@1',
  status: 'DRAFT_PREPARED_TEXT_NOT_FINAL_EDITION',
  book: '8a', edition: 'modern-us-neutral', figure: 'fig-32', lesson: lesson.id,
  authoritativeRule: 'Full prepared modern text supplies question and conceptual context. Original pixels supply figure facts. No answers or choice derivation. Final authored text must be rebound by the parent before independent figure approval.',
  sourceImage: { ...binding(sourceFile), width: imageBytes.readUInt32BE(16), height: imageBytes.readUInt32BE(20) },
  sourceApproval: binding(sourcePass),
  preparedInputs: { lesson: preparedBinding(lessonFile), exercises: preparedBinding(exercisesFile) },
  preparedInputChangeDuringAuthor: {
    failedAttempts: ['receipts/prepare-0001.json', 'receipts/prepare-0002.json'],
    initialLessonSha256: 'f547036f20d92b03917e3ebbc4c01627babc10cbf509663da81338eb46a5b250',
    initialExercisesSha256: '88862385ecedf5f85b6bb00f9d3927fbb177d37fa5ff81158fbd5cac36534a95',
    intermediateLessonSha256: '5597e9129bec2b05f40ad215ef39798ae65623d66c4eb7609b2cce9b18ef64d1',
    intermediateExercisesSha256: 'f4b0f076f12540ee4c1a156e186aadbf4531c39f668dea87dd8492d3f94429dd',
    diagnosis: 'Concurrent text-author normalization changed prepared file bytes twice. Both attempts stopped before writing context or spec. Recovery reads each prepared input once into a frozen buffer and hashes those same bytes, without chasing mutable filesystem hashes. Full prepared text is retained for author inspection. Mathematical tokens are checked against embedded source text. Final parent text binding is still required; no independent text approval is claimed.',
  },
  preparedSourceBindings: { lesson: lesson.source, exercises: exercises.source },
  fullPreparedLesson: lesson,
  fullPreparedExercises: exercises,
  exercise320: exercise,
  authoritativeText,
  inventory: binding(`${work}/inventory.json`),
  durableModernLessonContextClaimed: false,
  buildContextInvoked: false,
  pending: ['Parent binds final authored lesson/exercise text', 'Separate independent figure reviewer', 'Durable promotion and final product-surface verification are outside this author scope'],
}
write(`${work}/context.json`, context)

const ticks = (axis, count) => Array.from({ length: count }, (_, i) => {
  const value = i + 1
  return {
    at: axis === 'x' ? [value, 0.08] : [-0.08, value],
    size: 0.08,
    ...(value % 2 === 0 ? {
      label: String(value), fontSize: 22,
      labelPlacement: { position: axis === 'x' ? 'S' : 'W', offset: axis === 'x' ? [0, 8] : [-8, 0] },
    } : {}),
  }
})
const objects = [
  { id: 'x-axis', type: 'axis', from: [-0.55, 0], to: [7.7, 0], ticks: ticks('x', 7), stroke: 'ink', strokeWidth: 2 },
  { id: 'y-axis', type: 'axis', from: [0, -0.55], to: [0, 6.4], ticks: ticks('y', 6), stroke: 'ink', strokeWidth: 2 },
  { id: 'x-positive-arrow', type: 'arrow', from: [7.7, 0], to: [8.1, 0], stroke: 'ink', strokeWidth: 2 },
  { id: 'y-positive-arrow', type: 'arrow', from: [0, 6.4], to: [0, 6.8], stroke: 'ink', strokeWidth: 2 },
  { id: 'B-x-projection', type: 'segment', from: 'B', to: [1, 0], dash: 2, stroke: 'muted', strokeWidth: 2 },
  { id: 'A-x-projection', type: 'segment', from: 'A', to: [3, 0], dash: 2, stroke: 'muted', strokeWidth: 2 },
  { id: 'C-x-projection', type: 'segment', from: 'C', to: [6, 0], dash: 2, stroke: 'muted', strokeWidth: 2 },
  { id: 'BA', type: 'segment', from: 'B', to: 'A', dash: 0, stroke: 'ink', strokeWidth: 3 },
  { id: 'BC', type: 'segment', from: 'B', to: 'C', dash: 0, stroke: 'ink', strokeWidth: 3 },
  ...inventory.observed.points.map(point => ({
    id: point.id, type: 'point', at: point.at, label: point.id,
    face: 'o', size: 4, stroke: 'ink', fill: 'ink', strokeWidth: 2, fontSize: 24,
    labelPlacement: { position: point.id === 'B' ? 'NW' : point.id === 'A' ? 'NE' : 'E', offset: point.id === 'B' ? [-7, -7] : point.id === 'A' ? [7, -7] : [8, 0] },
  })),
  { id: 'origin-label', type: 'text', at: [0, 0], text: 'O', fontSize: 24, labelPlacement: { position: 'SW', offset: [-5, 6] } },
  { id: 'x-label', type: 'text', at: [8.1, 0], text: 'x', fontSize: 24, labelPlacement: { position: 'S', offset: [0, 8] } },
  { id: 'y-label', type: 'text', at: [0, 6.8], text: 'y', fontSize: 24, labelPlacement: { position: 'W', offset: [-8, 0] } },
]
const assertions = [
  ...inventory.observed.points.map(point => ({ id: `${point.id}-source-coordinate`, type: 'displacement', from: [0, 0], to: point.id, dx: point.at[0], dy: point.at[1], tolerance: 0 })),
  { id: 'BA-source-displacement', type: 'displacement', from: 'B', to: 'A', dx: 2, dy: 3, tolerance: 0 },
  { id: 'BC-source-displacement', type: 'displacement', from: 'B', to: 'C', dx: 5, dy: -1, tolerance: 0 },
  { id: 'BA-endpoints', type: 'connects', arrow: 'BA', from: 'B', to: 'A', tolerance: 0 },
  { id: 'BC-endpoints', type: 'connects', arrow: 'BC', from: 'B', to: 'C', tolerance: 0 },
  ...inventory.observed.points.flatMap(point => [
    { id: `${point.id}-projection-endpoints`, type: 'connects', arrow: `${point.id}-x-projection`, from: point.id, to: [point.at[0], 0], tolerance: 0 },
    { id: `${point.id}-projection-vertical`, type: 'perpendicular', a: point.id, b: [point.at[0], 0], c: [0, 0], d: [7, 0], tolerance: 0 },
  ]),
  { id: 'x-arrow-endpoints', type: 'connects', arrow: 'x-positive-arrow', from: [7.7, 0], to: [8.1, 0], tolerance: 0 },
  { id: 'y-arrow-endpoints', type: 'connects', arrow: 'y-positive-arrow', from: [0, 6.4], to: [0, 6.8], tolerance: 0 },
  { id: 'orthogonal-coordinate-frame', type: 'perpendicular', a: [-0.55, 0], b: [8.1, 0], c: [0, -0.55], d: [0, 6.8], tolerance: 0 },
  { id: 'filled-source-point-count', type: 'objectCount', objectType: 'point', count: 3 },
  { id: 'single-x-y-axis-pair', type: 'objectCount', objectType: 'axis', count: 2 },
  { id: 'no-full-grid', type: 'objectCount', objectType: 'grid', count: 0 },
]
const spec = {
  schema: 'ld-s10y-image/figure-spec@2', id: 'fig-32', mode: 'deterministic',
  description: 'Exercise 320: inspect the source broken line and the correspondences between its points and x coordinates. Preserve the source branch meeting at B without adding a third edge, plotted query points, or answers.',
  source: {
    image: { path: sourceFile, sha256: digest(sourceFile) },
    authoritativeText,
    inventory: [
      { id: 'single-frame-source-axes', description: 'One orthogonal Oxy frame with small negative tails, right/up positive arrowheads, x unit ticks 1 through 7 and y unit ticks 1 through 6; only 2,4,6 printed on each axis. No full grid. Blank extensions are regularized modern spacing, not added source data.', objects: ['x-axis', 'y-axis', 'x-positive-arrow', 'y-positive-arrow', 'origin-label', 'x-label', 'y-label'], assertions: ['orthogonal-coordinate-frame', 'x-arrow-endpoints', 'y-arrow-endpoints', 'single-x-y-axis-pair', 'no-full-grid'] },
      { id: 'source-three-points-and-two-branches', description: 'Three filled labelled source points B(1,2), A(3,5), C(6,1); solid BA and BC only, no AC. Stable exact displacements cover all source points inside this group.', objects: ['B', 'A', 'C', 'BA', 'BC'], assertions: ['B-source-coordinate', 'A-source-coordinate', 'C-source-coordinate', 'BA-source-displacement', 'BC-source-displacement', 'BA-endpoints', 'BC-endpoints', 'filled-source-point-count'], requires: ['pointRelationships'] },
      { id: 'source-three-vertical-dashed-projections', description: 'Exactly three dashed vertical guides from B, A and C to the same x axis at 1,3,6, with no horizontal guides or extra markers.', objects: ['B', 'A', 'C', 'B-x-projection', 'A-x-projection', 'C-x-projection'], assertions: ['BA-source-displacement', 'BC-source-displacement', 'B-projection-endpoints', 'A-projection-endpoints', 'C-projection-endpoints', 'B-projection-vertical', 'A-projection-vertical', 'C-projection-vertical'], requires: ['pointRelationships'] },
    ],
  },
  canvas: { width: 640, height: 560, boundingBox: [-0.9, 7.3, 8.7, -1.1], background: 'paper', keepAspectRatio: true },
  display: { purpose: 'instructional', layout: 'scroll', minTextPx: 16, widths: [640] },
  objects, assertions, layout: { minLabelGap: 3 },
}
write(`${work}/spec.json`, spec)
console.log(JSON.stringify({ status: 'DRAFT_AUTHORED', context: binding(`${work}/context.json`), spec: binding(`${work}/spec.json`), objects: objects.length, assertions: assertions.length, sourceDimensions: [context.sourceImage.width, context.sourceImage.height] }, null, 2))
