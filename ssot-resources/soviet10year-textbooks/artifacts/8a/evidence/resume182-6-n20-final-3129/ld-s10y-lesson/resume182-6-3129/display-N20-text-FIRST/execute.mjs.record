import assert from 'node:assert/strict';
import path from 'node:path';
import { readFile } from 'node:fs/promises';

const ROOT = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
assert.equal(process.cwd(), ROOT);
const SOURCE = path.join(ROOT, '.tmp/ld-s10y-lesson/resume182-6-3129/display-N4-FIRST/execute.mjs');
let code = await readFile(SOURCE, 'utf8');
for (const [before, after] of [
  ['display-N4-FIRST', 'display-N20-text-FIRST'],
  ["schema: 'resume182-6-n4-display-result@1'", "schema: 'resume182-6-n20-display-result@1'"],
  ["book: '7a', lesson: 'alg7-c1-s1-n4'", "book: '8a', lesson: 'alg8-c3-s3-n20'"],
]) {
  assert.equal(code.split(before).length, 2, before);
  code = code.replace(before, after);
}
await import(`data:text/javascript;base64,${Buffer.from(code).toString('base64')}`);
