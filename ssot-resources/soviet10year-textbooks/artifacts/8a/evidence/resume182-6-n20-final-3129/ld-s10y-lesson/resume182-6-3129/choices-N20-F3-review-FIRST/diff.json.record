  "exact_scalar_diff": [
    {
      "path": "/questions/13/view/options/2/text",
      "before": "I: $(a+5)(a^2+13a+43)$\n\nII: $(y+1)(y^2-3y+19)$\n\nIII: $(x-1)(x^2+4x+37)$\n\nIV: $(2x-y)(x^2-xy+y^2)$",
      "after": "I: $(a+5)(a^2+a+43)$\n\nII: $(y+1)(y^2-3y+19)$\n\nIII: $(x-1)(x^2+4x+37)$\n\nIV: $(2x-y)(x^2-xy+y^2)$"
    },
    {
      "path": "/questions/13/key/rationales/2/derivation",
      "before": "Row II needs (y-2)^2-3(y-2)+9=y^2-7y+19. Row III needs (x+3)^2+4(x+3)+16=x^2+10x+37; omitting +6x gives x^2+4x+37. At x=2 the candidate product is 49 instead of the original 61.",
      "after": "Row II needs (y-2)^2-3(y-2)+9=y^2-7y+19. Row III needs (x+3)^2+4(x+3)+16=x^2+10x+37; omitting +6x gives x^2+4x+37. At x=2 the candidate product is 49 instead of the original 61. Row I also omits the 12a cross term from (a+6)^2: the correct trinomial is a^2+13a+43, not a^2+a+43. At a=1 the original is 342, whereas C-I is 270."
    },
    {
      "path": "/questions/13/key/rationales/2/misconception",
      "before": "Expand (y-2)^2 as y^2+4, omitting -4y, then retain -3y+6+9 to get y^2-3y+19. For III, apply the same missing-cross-term procedure: (x+3)^2 is falsely x^2+9, and adding 4x+12+16 yields x^2+4x+37 with first factor x-1 unchanged.",
      "after": "Expand (y-2)^2 as y^2+4, omitting -4y, then retain -3y+6+9 to get y^2-3y+19. For III, apply the same missing-cross-term procedure: (x+3)^2 is falsely x^2+9, and adding 4x+12+16 yields x^2+4x+37 with first factor x-1 unchanged. In I, likewise omit 12a from (a+6)^2, then retain +(a+6)+1 to obtain a^2+a+43."
    }
  ],
