          {"id": "D", "text": "I: $(c-0.1)(c^2+0.1c+0.01)$\n\nII: $(0.2b+5)(0.04b^2-b+25)$\n\nIII: $(0.4-ny)(0.16+0.4ny+n^2y^2)$", "figure_ids": []}
        ]
      },
      "intent": {
