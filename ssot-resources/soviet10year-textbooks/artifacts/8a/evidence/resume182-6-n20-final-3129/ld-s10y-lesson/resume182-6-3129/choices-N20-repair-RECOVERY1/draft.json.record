  "questions": [
    {
      "id": "n20-expand-two-methods",
      "source_numbers": ["309"],
      "view": {
        "mode": "single",
        "stem": "Expand $(x-10)(x^2+10x+100)$ in two ways: first by distributing, then by the difference-of-cubes identity. Which pair of calculations gives its standard polynomial form?",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "Distribution: $x^3+10x^2+100x-10x^2-100x-100=x^3-100$.\n\nIdentity: $x^3-10^2=x^3-100$.", "figure_ids": []},
          {"id": "B", "text": "Distribution: $x^3+10x^2+100x-10x^2-100x-1000=x^3-1000$.\n\nIdentity: $x^3-10^3=x^3-1000$.", "figure_ids": []},
          {"id": "C", "text": "Distribution: $x^3+10x^2+100x+10x^2+100x+1000=x^3+20x^2+200x+1000$.\n\nIdentity: $(x+10)^3=x^3+20x^2+200x+1000$.", "figure_ids": []},
          {"id": "D", "text": "Distribution: $x^3+10x^2+100x-10x^2-100x+1000=x^3+1000$.\n\nIdentity: $x^3+10^3=x^3+1000$.", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Identify two complete transformations of the same original product, retaining distribution and identity application.",
        "source_solution": "Distribute to x^3+10x^2+100x-10x^2-100x-1000=x^3-1000. The identity with a=x,b=10 gives x^3-10^3=x^3-1000, for all real x.",
        "unit_reason": "The seed requests two methods for one polynomial, so one paired derivation is the coherent response, not two result clicks.",
        "concept_blocks": [7],
        "limitations": ["Recognition of both supplied derivations does not establish independent production of either derivation."],
        "figure_observations": []
      },
      "key": {
        "correct": ["B"],
        "rationales": [
          {"option_id": "A", "truth": "incorrect", "derivation": "The last distributed term must be (-10)*100=-1000, not -100; the identity cubes 10.", "misconception": "Retain 100 without multiplying it by 10, then replace b^3 by b^2 in the identity."},
          {"option_id": "B", "truth": "correct", "derivation": "Mixed-degree terms cancel; both exact methods give x^3-1000.", "misconception": null},
          {"option_id": "C", "truth": "incorrect", "derivation": "Changing the entire negative contribution to positive gives the displayed distribution, but not the original product; (x+10)^3 also has coefficients 30 and 300.", "misconception": "Distribute +10 instead of -10, and then falsely identify that altered product with the cube of a binomial."},
          {"option_id": "D", "truth": "incorrect", "derivation": "The constant contribution is negative, so neither the distributed constant nor the sum-of-cubes conclusion is valid.", "misconception": "Lose the negative sign only in (-10)*100, then use the sum-of-cubes conclusion for the difference-of-cubes factors."}
        ]
      }
    },
    {
      "id": "n20-expand-scalar",
      "source_numbers": ["310"],
      "view": {
        "mode": "single",
        "stem": "Write these products in standard polynomial form:\n\nI. $(x-2)(x^2+2x+4)$\n\nII. $(p-5)(p^2+5p+25)$\n\nIII. $(y+4)(y^2-4y+16)$\n\nIV. $(2a+1)(4a^2-2a+1)$\n\nWhich list gives all four results in this order?",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "I: $x^3-4$\n\nII: $p^3-25$\n\nIII: $y^3+16$\n\nIV: $4a^3+1$", "figure_ids": []},
          {"id": "B", "text": "I: $x^3+8$\n\nII: $p^3+125$\n\nIII: $y^3-64$\n\nIV: $8a^3-1$", "figure_ids": []},
          {"id": "C", "text": "I: $x^3-8$\n\nII: $p^3-125$\n\nIII: $y^3+64$\n\nIV: $8a^3+1$", "figure_ids": []},
          {"id": "D", "text": "I: $x^3-8$\n\nII: $p^3-125$\n\nIII: $y^3+64$\n\nIV: $2a^3+1$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Expand all four scalar cube-identity products, including the scaled base 2a.",
        "source_solution": "The difference bases (x,2),(p,5) give x^3-8,p^3-125; sum bases (y,4),(2a,1) give y^3+64,8a^3+1. All variables are real.",
        "unit_reason": "One complete list compares sum/difference signs and cubing whole scalar bases across the four concrete products.",
        "concept_blocks": [7, 10],
        "limitations": ["Complete-result recognition does not show independently written multiplication for each product."],
        "figure_observations": []
      },
      "key": {
        "correct": ["C"],
        "rationales": [
          {"option_id": "A", "truth": "incorrect", "derivation": "The constants 2,5,4 and coefficient 2 in 2a must be cubed, yielding 8,125,64,8, not their squares.", "misconception": "Square numeric cube bases instead of cubing them: 2^2,5^2,4^2 and 2^2*a^3."},
          {"option_id": "B", "truth": "incorrect", "derivation": "Each identity's sum/difference sign is reversed in the displayed list.", "misconception": "Read the first-factor minus sign as a cube sum and its plus sign as a cube difference."},
          {"option_id": "C", "truth": "correct", "derivation": "Apply the cube identities to each full base; all four standard forms follow.", "misconception": null},
          {"option_id": "D", "truth": "incorrect", "derivation": "(2a)^3=8a^3, not 2a^3; the other three rows are correct.", "misconception": "Apply the exponent only to a while leaving its coefficient 2 unchanged."}
        ]
      }
    },
    {
      "id": "n20-expand-monomials",
      "source_numbers": ["310"],
      "view": {
        "mode": "single",
        "stem": "Expand both products into standard polynomial form:\n\n$U=(10x-3y)(100x^2+30xy+9y^2)$\n\n$V=(4a+5b)(16a^2-20ab+25b^2)$\n\nWhich pair gives $U$ and $V$?",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "$U=1000x^3-27y^3$\n\n$V=64a^3+125b^3$", "figure_ids": []},
          {"id": "B", "text": "$U=10x^3-3y^3$\n\n$V=4a^3+5b^3$", "figure_ids": []},
          {"id": "C", "text": "$U=1000x^3+27y^3$\n\n$V=64a^3-125b^3$", "figure_ids": []},
          {"id": "D", "text": "$U=100x^3-9y^3$\n\n$V=16a^3+25b^3$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Expand both scaled two-variable products, preserving exact coefficients and sum/difference directions.",
        "source_solution": "Difference of cubes with bases 10x,3y gives U=1000x^3-27y^3. Sum of cubes with bases 4a,5b gives V=64a^3+125b^3.",
        "unit_reason": "These two products require cubing composite monomial bases; together they form a distinct unit from one-variable substitutions.",
        "concept_blocks": [7, 10],
        "limitations": ["Choice recognition does not establish independent multiplication of all terms."],
        "figure_observations": []
      },
      "key": {
        "correct": ["A"],
        "rationales": [
          {"option_id": "A", "truth": "correct", "derivation": "Cube both coefficients and variables in 10x,3y,4a,5b, using the indicated difference and sum.", "misconception": null},
          {"option_id": "B", "truth": "incorrect", "derivation": "Leaving coefficients unchanged yields the displayed pair but is not cubing a monomial.", "misconception": "Use (cx)^3=c*x^3 instead of c^3*x^3 for each base."},
          {"option_id": "C", "truth": "incorrect", "derivation": "Correct coefficient cubes are present but the outer signs are reversed.", "misconception": "Swap the sum-of-cubes and difference-of-cubes conclusions after recognizing the bases."},
          {"option_id": "D", "truth": "incorrect", "derivation": "The coefficients are squared rather than cubed, giving 100,9,16,25.", "misconception": "Read squared coefficients from the second factor as final coefficients of the cubic result."}
        ]
      }
    },
    {
      "id": "n20-factor-integer-bases",
      "source_numbers": ["311"],
      "view": {
        "mode": "single",
        "stem": "Factor each binomial using a sum or difference of cubes:\n\nI. $x^3-y^3$\n\nII. $c^3-8$\n\nIII. $27+x^3$\n\nIV. $8x^3-27$\n\nV. $125a^3+1$\n\nVI. $n^3-64m^3$\n\nWhich list gives a factorization of every binomial?",
        "figure_ids": [],
        "options": [
          {"id": "A", "text": "I: $(x-y)(x^2-xy+y^2)$\n\nII: $(c-2)(c^2-2c+4)$\n\nIII: $(x+3)(x^2+3x+9)$\n\nIV: $(2x-3)(4x^2-6x+9)$\n\nV: $(5a+1)(25a^2+5a+1)$\n\nVI: $(n-4m)(n^2-4nm+16m^2)$", "figure_ids": []},
          {"id": "B", "text": "I: $(x-y)(x^2+xy+y^2)$\n\nII: $(c-2)(c^2+2c+4)$\n\nIII: $(x+3)(x^2-3x+9)$\n\nIV: $(2x-3)(4x^2+3x+9)$\n\nV: $(5a+1)(25a^2-5a+1)$\n\nVI: $(n-4m)(n^2+4nm+16m^2)$", "figure_ids": []},
          {"id": "C", "text": "I: $(x-y)(x^2+xy+y^2)$\n\nII: $(c-2)(c^2+2c+4)$\n\nIII: $(x+3)(x^2-3x+9)$\n\nIV: $(2x-3)(4x^2+6x+9)$\n\nV: $(5a+1)(25a^2-5a+1)$\n\nVI: $(n-4m)(n^2+4nm+16m^2)$", "figure_ids": []},
          {"id": "D", "text": "I: $(x-y)(x^2+xy+y^2)$\n\nII: $(c-2)(c^2+2c+4)$\n\nIII: $(x+3)(x^2-3x+9)$\n\nIV: $(2x-3)(4x^2+6x+9)$\n\nV: $(5a+1)(25a^2-5a+1)$\n\nVI: $(n-4m)(n^2+4nm+4m^2)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "Factor all six integer-base cube binomials, including scaled variable cubes and a reversed-order sum.",
        "source_solution": "Cube bases are (x,y),(c,2),(x,3),(2x,3),(5a,1),(n,4m). Difference uses (A-B)(A^2+AB+B^2); sum uses (A+B)(A^2-AB+B^2), giving the six products in C.",
        "unit_reason": "The complete six-row result retains all concrete integer-base work while jointly testing base extraction and middle-term signs.",
        "concept_blocks": [7, 10],
        "limitations": ["Recognition of a complete factorization list does not prove independent production of each factorization."],
        "figure_observations": []
      },
      "key": {
        "correct": ["C"],
        "rationales": [
          {"option_id": "A", "truth": "incorrect", "derivation": "The AB sign in every second factor is reversed, leaving uncanceled mixed terms.", "misconception": "Match the trinomial middle sign to the binomial sign instead of using the opposite sign."},
          {"option_id": "B", "truth": "incorrect", "derivation": "Row IV needs AB=(2x)*3=6x, not 3x; all other rows match their original binomials.", "misconception": "Drop the coefficient 2 when multiplying the cube bases to form the middle term."},
          {"option_id": "C", "truth": "correct", "derivation": "Each product follows the cube identity with the independently extracted bases.", "misconception": null},
          {"option_id": "D", "truth": "incorrect", "derivation": "Row VI requires (4m)^2=16m^2, not 4m^2; the other rows are valid.", "misconception": "Square m but leave the coefficient 4 unsquared in B^2."}
        ]
      }
    },
    {
