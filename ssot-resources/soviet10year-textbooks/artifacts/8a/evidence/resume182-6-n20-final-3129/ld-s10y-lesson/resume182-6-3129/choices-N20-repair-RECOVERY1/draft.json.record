          {"id": "B", "text": "$U=\\frac{p-q}{p^2+pq+q^2}$, $p\\ne q$\n\n$V=\\frac{3a^2}{a+2}$, $a\\ne-2$", "figure_ids": []},
          {"id": "C", "text": "$U=\\frac{p-q}{p^2+pq+q^2}$, $(p,q)\\ne(0,0)$\n\n$V=\\frac{3a}{a+2}$, $a\\ne-2$", "figure_ids": []},
          {"id": "D", "text": "$U=\\frac{p-q}{p^2+pq+q^2}$, $p\\ne q$\n\n$V=\\frac{3a}{a+2}$, $a\\ne-2$", "figure_ids": []}
