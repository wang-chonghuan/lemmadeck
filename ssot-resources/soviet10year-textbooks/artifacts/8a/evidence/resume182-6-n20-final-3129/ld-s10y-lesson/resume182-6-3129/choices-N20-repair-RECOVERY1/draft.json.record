          {"option_id": "B", "truth": "incorrect", "derivation": "V's common numerator factors as 3a(a^2-2a+4), not 3a^2 times that quadratic.", "misconception": "Factor 3a^2 instead of 3a while leaving the same trinomial, increasing every numerator power by one."},
          {"option_id": "C", "truth": "incorrect", "derivation": "The original U excludes every p=q, whereas the displayed reduced-expression domain restores all nonzero equal pairs.", "misconception": "Keep only the zero of the reduced quadratic denominator and forget the canceled p-q factor."},
          {"option_id": "D", "truth": "correct", "derivation": "The common numerators factor exactly as (p-q)^2 and 3aT, with original domains unchanged.", "misconception": null}
        ]
      }
