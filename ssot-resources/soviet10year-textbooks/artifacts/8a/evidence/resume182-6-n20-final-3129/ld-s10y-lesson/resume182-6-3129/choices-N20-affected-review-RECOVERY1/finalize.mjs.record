import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const cwd = "/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck";
const base = ".tmp/ld-s10y-lesson/resume182-6-3129";
const owned = `${base}/choices-N20-affected-review-RECOVERY1`;
assert.equal(process.cwd(), cwd);
assert.equal(path.dirname(fileURLToPath(import.meta.url)), path.join(cwd, owned));
const paths = {
  seed: `${base}/choices-N20-author-FIRST/seed.json`,
  original_draft: `${base}/choices-N20-author-FIRST/draft.json`,
  repaired_draft: `${base}/choices-N20-repair-RECOVERY1/draft.json`,
  first_review: `${base}/choices-N20-review-FIRST/review.json`,
  first_result: `${base}/choices-N20-review-FIRST/result.json`,
  first_usage: `${base}/choices-N20-review-FIRST/usage.json`,
  repair_record: `${base}/choices-N20-repair-RECOVERY1/repair.record`,
  repair_result: `${base}/choices-N20-repair-RECOVERY1/result.json`
};
const affectedIds = ["n20-reduce-domain-table", "n20-composed-cube-factors"];
const affectedSources = ["314", "317"];
const sha = value => crypto.createHash("sha256").update(value).digest("hex");
function canonical(value) {
  if (value === null || typeof value !== "object") return JSON.stringify(value);
  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
  return `{${Object.keys(value).sort().map(key =>
    `${JSON.stringify(key)}:${canonical(value[key])}`).join(",")}}`;
}
const digest = value => sha(canonical(value).replace(/[\u007f-\uffff]/g,
  char => `\\u${char.charCodeAt(0).toString(16).padStart(4, "0")}`));
const read = filename => JSON.parse(fs.readFileSync(path.join(cwd, filename), "utf8"));
function binding(filename, json = true) {
  const bytes = fs.readFileSync(path.join(cwd, filename));
  return {
    path: path.join(cwd, filename),
    bytes: bytes.length,
    bytes_sha256: sha(bytes),
    ...(json ? { canonical_sha256: digest(JSON.parse(bytes.toString("utf8"))) } : {})
  };
}
function write(filename, value) {
  assert.equal(path.dirname(filename), owned);
  fs.writeFileSync(path.join(cwd, filename),
    typeof value === "string" || Buffer.isBuffer(value) ? value :
      `${JSON.stringify(value, null, 2)}\n`,
    { flag: "wx" });
}
const allBindings = () => Object.fromEntries(Object.entries(paths)
  .map(([name, filename]) => [name, binding(filename)]));
function differences(before, after, pointer = "", result = []) {
  if (canonical(before) === canonical(after)) return result;
  if (before !== null && after !== null && typeof before === "object" &&
      typeof after === "object" && Array.isArray(before) === Array.isArray(after)) {
    for (const key of new Set([...Object.keys(before), ...Object.keys(after)])) {
      differences(before[key], after[key], `${pointer}/${key}`, result);
    }
  } else {
    result.push({ json_pointer: pointer, before, after });
  }
  return result;
}
function aggregate(review) {
  const verdicts = [
    ...review.source_reviews.map(row => row.coverage.verdict),
    ...review.new_figure_reviews.map(row => row.verdict),
    ...review.question_reviews.flatMap(row =>
      ["task_fidelity", "redundancy", "answer_leakage", "mathematics"]
        .map(name => row[name].verdict))
  ];
  return verdicts.includes("blocked") ? "blocked" :
    verdicts.includes("revise") ? "revise" : "pass";
}
function checkInherited(first, draft, composed) {
  const oldRows = new Map(first.question_reviews.map(row => [row.question_id, row]));
  const inherited = composed.question_reviews.filter(row =>
    !affectedIds.includes(row.question_id));
  assert.equal(inherited.length, 17);
  for (const row of inherited) {
    assert.deepEqual(row, oldRows.get(row.question_id));
    assert(["task_fidelity", "redundancy", "answer_leakage", "mathematics"]
      .every(name => row[name].verdict === "pass"));
  }
  assert.deepEqual(composed.question_reviews.map(row => row.question_id),
    draft.questions.map(row => row.id));
  assert.equal(composed.source_reviews.length, 14);
  for (const row of composed.source_reviews) {
    const old = first.source_reviews.find(item => item.source_number === row.source_number);
    assert.equal(row.independent_solution, old.independent_solution);
    if (!affectedSources.includes(row.source_number)) assert.deepEqual(row, old);
  }
  assert.deepEqual(composed.figure_checks, first.figure_checks);
  assert.deepEqual(composed.new_figure_reviews, first.new_figure_reviews);
}

if (process.argv[2] === "compose") {
  const inputBindings = allBindings();
  const seed = read(paths.seed);
  const original = read(paths.original_draft);
  const draft = read(paths.repaired_draft);
  const first = read(paths.first_review);
  const firstResult = read(paths.first_result);
  const repair = read(paths.repair_record);
  const checks = read(`${owned}/affected-checks.json`);
  assert.equal(digest(seed), "338609df58f3f85a6cf7801beb74a970eb10b24eff37efdc285b21fe34412e93");
  assert.equal(digest(original), "e382df600c527ab9d9ff767b1ff95df1108e0d9c264fe6b783a2a503c27b8de6");
  assert.equal(digest(draft), "52083852bebb9751d4e290a66ea9d1e5a03ed490e399550d77e4db50f0fc8301");
  assert.equal(first.seed_sha256, digest(seed));
  assert.equal(first.draft_sha256, digest(original));
  assert.equal(first.outcome, "revise");
  assert.equal(firstResult.status, "REVISE");
  assert.equal(firstResult.current_bindings.review.canonical_sha256, digest(first));
  assert.deepEqual(repair.inherited.original_findings, firstResult.findings);
  assert.equal(repair.bindings.repaired_draft.canonical_sha256, digest(draft));
  assert.equal(seed.source.lesson, "alg8-c3-s3-n20");
  assert.equal(seed.source.book, "8a");
  assert.deepEqual(original.questions.map(q => q.id), draft.questions.map(q => q.id));
  const delta = differences(original, draft);
  assert.deepEqual(delta, repair.exact_json_changed_units);
  assert.equal(delta.length, 18);
  const changed = draft.questions.filter(q =>
    digest(q) !== digest(original.questions.find(old => old.id === q.id)));
  assert.deepEqual(changed.map(q => q.id), affectedIds);
  const unchanged = draft.questions.filter(q => !affectedIds.includes(q.id));
  const limitationsUnchanged = draft.questions.every(q =>
    canonical(q.intent.limitations) ===
      canonical(original.questions.find(old => old.id === q.id).intent.limitations));
  const omissionsUnchanged = draft.coverage.every(row =>
    canonical(row.omitted_tasks) ===
      canonical(original.coverage.find(old => old.source_number === row.source_number).omitted_tasks));
  assert(limitationsUnchanged && omissionsUnchanged);
  const rowCells = [];
  for (const question of changed) {
    const old = original.questions.find(q => q.id === question.id);
    assert.deepEqual(question.source_numbers, old.source_numbers);
    assert.equal(question.view.stem, old.view.stem);
    assert.equal(question.view.mode, old.view.mode);
    assert.deepEqual(question.key.correct, old.key.correct);
    for (const option of question.view.options) {
      const oldOption = old.view.options.find(item => item.id === option.id);
      const oldLines = oldOption.text.split("\n\n");
      const newLines = option.text.split("\n\n");
      assert.equal(oldLines.length, 4);
      assert.equal(newLines.length, 4);
      for (let i = 0; i < 4; i++) {
        if (oldLines[i] !== newLines[i]) rowCells.push({
          question_id: question.id, option_id: option.id,
          row: ["I", "II", "III", "IV"][i], before: oldLines[i], after: newLines[i]
        });
      }
    }
  }
  assert.equal(rowCells.length, 6);
  const targetPairs = [
    { question_id: affectedIds[0], source_number: "314", true_option: "C", false_option: "D" },
    { question_id: affectedIds[1], source_number: "317", true_option: "A", false_option: "B" }
  ].map(pair => {
    const q = draft.questions.find(row => row.id === pair.question_id);
    const left = q.view.options.find(row => row.id === pair.true_option).text.split("\n\n");
    const right = q.view.options.find(row => row.id === pair.false_option).text.split("\n\n");
    assert([0, 1, 3].every(i => left[i] === right[i]));
    assert.notEqual(left[2], right[2]);
    return {
      ...pair, identical_other_rows: ["I", "II", "IV"],
      true_III: left[2], false_III: right[2],
      cannot_distinguish_pair_without_c: true,
      qualification: "Deterministic non-c-row elimination cannot distinguish this pair; not a claim of independent written production, all-row mastery or impossibility of guessing."
    };
  });
  const q317 = draft.questions.find(row => row.id === affectedIds[1]);
  const unanimousI = q317.view.options.map(option => option.text.split("\n\n")[0]);
  assert(unanimousI.every(text => text === unanimousI[0]));
  const review = {
    schema: "s10y-choice-review-v1",
    seed_sha256: digest(seed),
    draft_sha256: digest(draft),
    reviewer: {
      kind: "independent_agent",
      identity: "Designated independent affected-only N20 reviewer, 182-6/STEMROBIN-182; did not author either draft. Repaired views independently derived before internal keys; 17 unchanged question approvals, all 14 original independent source solutions, 12 source coverage checks and the figure check inherited from FIRST. No new agent/chat or image opening; affected c checks resolve F1/F2, new unanimous 317(a) remains F3."
    },
    source_reviews: first.source_reviews.map(row => {
      const update = checks.source_reviews.find(item => item.source_number === row.source_number);
      return update ? { ...row, coverage: update.coverage } : row;
    }),
    figure_checks: first.figure_checks,
    new_figure_reviews: first.new_figure_reviews,
    question_reviews: draft.questions.map(question =>
      checks.question_reviews.find(row => row.question_id === question.id) ??
        first.question_reviews.find(row => row.question_id === question.id)),
    outcome: "revise"
  };
  checkInherited(first, draft, review);
  assert.equal(aggregate(review), "revise");
  for (const row of checks.question_reviews) {
    const q = draft.questions.find(item => item.id === row.question_id);
    assert.deepEqual(row.mathematics.correct, q.key.correct);
    assert.equal(row.mathematics.option_checks.length, 4);
    for (const option of row.mathematics.option_checks) {
      assert.equal(option.truth,
        q.key.rationales.find(item => item.option_id === option.option_id).truth);
    }
  }
  const historical = firstResult.findings.map(finding => ({
    original_finding: finding,
    historical_verdict: finding.verdict,
    repaired_snapshot_disposition: "resolved",
    evidence: targetPairs.find(pair => pair.question_id === finding.question_id)
  }));
  write(`${owned}/diff.json`, {
    schema: "s10y-choice-affected-diff-evidence-v1",
    original_draft: inputBindings.original_draft,
    repaired_draft: inputBindings.repaired_draft,
    changed_question_ids: affectedIds,
    changed_json_scalar_units: delta,
    changed_row_cells: rowCells,
    changed_coverage_reasons: delta.filter(item => item.json_pointer.startsWith("/coverage/")),
    limitations_unchanged: limitationsUnchanged,
    omitted_tasks_unchanged: omissionsUnchanged,
    target_c_pair_checks: targetPairs,
    new_unanimous_317_a: unanimousI
  });
  write(`${owned}/review.json`, review);
  write(`${owned}/review-provenance.json`, {
    schema: "s10y-choice-affected-review-provenance-v1",
    composed_at: new Date().toISOString(),
    input_bindings: inputBindings,
    affected_check_binding: binding(`${owned}/affected-checks.json`),
    observations_binding_before_gate: binding(`${owned}/observations.md`, false),
    diff_binding: binding(`${owned}/diff.json`),
    composed_review_binding: binding(`${owned}/review.json`),
    reviewer: review.reviewer,
    observation_order: [
      "Contracts, selected definitions and repaired visible subtrees; internals withheld.",
      "Independent visible true-set derivation; only affected seed prose and original visible subtrees read.",
      "Affected coverage reasons read; they disclose A/C labels after initial derivation, before internal keys. No claim of fresh blind whole-source solving.",
      "Concrete pre-key observations.md written.",
      "Only affected draft internals and first affected reviews compared; FIRST/result and repair evidence received.",
      "Detected newly unanimous 317(a), recorded F3 under the unchanged FIRST standard.",
      "Inherited unchanged records composed mechanically, not semantically revisited."
    ],
    inherited_question_reviews: unchanged.map(q => ({
      question_id: q.id,
      unchanged_question_canonical_sha256: digest(q),
      unchanged_review_canonical_sha256: digest(first.question_reviews.find(row => row.question_id === q.id))
    })),
    source_solutions: {
      inherited_count: 14,
      unchanged_count: 14,
      whole_source_resolves_here: 0,
      affected_source_prose_read: affectedSources,
      affected_expression_checks: 8,
      source_coverage_inherited: 12,
      source_coverage_reviewed: 2,
      qualification: "Original independent_solution strings are preserved verbatim. New affected algebra is recorded in question_reviews and observations, not represented as a second blind whole-source solve."
    },
    affected_view_key_bindings: changed.map(q => ({
      question_id: q.id,
      source_numbers: q.source_numbers,
      visible_canonical_sha256: digest(q.view),
      internal_key_canonical_sha256: digest(q.key),
      author_intent_canonical_sha256: digest(q.intent),
      complete_true_set: checks.question_reviews.find(row => row.question_id === q.id).mathematics.correct,
      all_option_truths_match_key_after_independent_check: true,
      source_and_view_figure_count: 0
    })),
    historical_first_outcome: "revise",
    historical_first_result_status: "REVISE",
    historical_findings: historical,
    new_findings: checks.new_findings,
    target_c_pair_checks: targetPairs,
    losses: {
      all_draft_limitations_unchanged: limitationsUnchanged,
      all_draft_omitted_tasks_unchanged: omissionsUnchanged,
      historical_capability_losses: firstResult.capability_losses,
      prior_figure_and_320_convention_inherited_without_reopening: true,
      current_recognition_losses: firstResult.capability_losses.filter(text =>
        !text.startsWith("Additional undeclared")),
      affected_declared_limitations: changed.map(q => ({
        question_id: q.id, limitations: q.intent.limitations
      })),
      new_specific_loss: checks.new_findings[0],
      qualification: "Historical c-loss statement is retained as history with resolved F1/F2, not silently erased or presented as currently unresolved. Newly unassessed 317(a) is explicitly recorded here, but remains missing from the author artifact and is not approved."
    },
    prior_usage: {
      first_review_image_opens: firstResult.total_image_opens,
      repair_counts: read(paths.repair_result).actual_counts,
      first_usage_reference: inputBindings.first_usage,
      no_historical_usage_reset: true
    },
    counts: {
      total_questions: draft.questions.length,
      total_options: draft.questions.reduce((sum, q) => sum + q.view.options.length, 0),
      inherited_questions: 17,
      reviewed_questions: 2,
      reviewed_options: 8,
      inherited_options: unchanged.reduce((sum, q) => sum + q.view.options.length, 0),
      source_reviews: 14,
      inherited_source_solutions: 14,
      reviewed_source_coverage: 2,
      inherited_source_coverage: 12,
      changed_json_scalar_units: delta.length,
      changed_option_texts: delta.filter(item => /\/view\/options\/\d+\/text$/.test(item.json_pointer)).length,
      changed_row_cells: rowCells.length,
      changed_c_row_cells: rowCells.filter(row => row.row === "III").length,
      corrected_non_c_row_cells: rowCells.filter(row => row.row !== "III").length,
      changed_coverage_reasons: 2,
      image_opens: 0,
      inherited_figure_checks: first.figure_checks.length,
      new_figure_reviews: 0
    },
    native_outcome: review.outcome,
    approval: false
  });
  console.log(JSON.stringify({
    composed_review: binding(`${owned}/review.json`),
    outcome: review.outcome,
    inherited_questions: 17,
    reviewed_questions: 2,
    images_opened: 0,
    historical_findings: historical.map(row => ({
      id: row.original_finding.id, current_disposition: row.repaired_snapshot_disposition
    })),
    new_findings: checks.new_findings.map(row => ({ id: row.id, verdict: row.verdict })),
    native_validator_invocations_so_far_here: 0
  }, null, 2));
} else if (process.argv[2] === "validate") {
  const provenance = read(`${owned}/review-provenance.json`);
  const review = read(`${owned}/review.json`);
  assert.deepEqual(allBindings(), provenance.input_bindings);
  assert.deepEqual(binding(`${owned}/review.json`), provenance.composed_review_binding);
  assert.deepEqual(binding(`${owned}/affected-checks.json`), provenance.affected_check_binding);
  assert.deepEqual(binding(`${owned}/observations.md`, false),
    provenance.observations_binding_before_gate);
  checkInherited(read(paths.first_review), read(paths.repaired_draft), review);
  const command = "python3";
  const argv = [
    ".agents/skills/ld-s10y-choice/scripts/validate.py",
    "--repo", ".", "--seed", paths.seed, "--draft", paths.repaired_draft,
    "--review", `${owned}/review.json`
  ];
  const environmentOverrides = { PYTHONDONTWRITEBYTECODE: "1" };
  const invocation = { cwd, command, argv, environment_overrides: environmentOverrides };
  const commandText = [command, ...argv].join(" ");
  const invocationDigest = digest(invocation);
  const started = new Date().toISOString();
  write(`${owned}/validation.once.json`, {
    invocation, command_sha256: invocationDigest,
    started_at: started, invocation_limit: 1,
    meaning: "Exclusive once-only marker written before process launch; no rerun is authorized."
  });
  const child = spawnSync(command, argv, {
    cwd,
    env: { ...process.env, ...environmentOverrides },
    maxBuffer: 1024 * 1024
  });
  const ended = new Date().toISOString();
  const stdout = child.stdout ?? Buffer.alloc(0);
  const stderr = child.stderr ?? Buffer.alloc(0);
  write(`${owned}/validation.stdout.txt`, stdout);
  write(`${owned}/validation.stderr.txt`, stderr);
  const afterBindings = allBindings();
  const stable = canonical(afterBindings) === canonical(provenance.input_bindings) &&
    canonical(binding(`${owned}/review.json`)) === canonical(provenance.composed_review_binding);
  const validation = {
    invocation_count: 1,
    ...invocation,
    command_text: commandText,
    command_sha256: invocationDigest,
    command_text_sha256: sha(commandText),
    argv_canonical_sha256: digest(argv),
    validator_script: binding(".agents/skills/ld-s10y-choice/scripts/validate.py", false),
    prepare_script: binding(".agents/skills/ld-s10y-choice/scripts/prepare.py", false),
    started_at: started,
    ended_at: ended,
    actual_exit_code: child.status,
    actual_signal: child.signal,
    process_error: child.error ? {
      name: child.error.name, message: child.error.message, code: child.error.code ?? null
    } : null,
    stdout: binding(`${owned}/validation.stdout.txt`, false),
    stderr: binding(`${owned}/validation.stderr.txt`, false),
    stdout_text: stdout.toString("utf8"),
    stderr_text: stderr.toString("utf8"),
    input_bindings_before: provenance.input_bindings,
    input_bindings_after: afterBindings,
    composed_review_binding: binding(`${owned}/review.json`),
    bindings_unchanged: stable,
    meaning: child.status === 3 ?
      "Mechanical checks succeeded; structurally valid semantic REVISE retained. This is a failed finite semantic gate, not an execution failure or approval." :
      child.status === 0 ? "Native mechanical and declared semantic checks succeeded." :
        "Native execution/input failure; no retry or draft modification performed."
  };
  write(`${owned}/validation.receipt.json`, validation);
  const expected = child.status === 3 && child.signal === null && !child.error && stable;
  const status = expected ? "REVISE" : "BLOCKED_EXECUTION";
  const finalObservation = [
    "",
    "## Actual once-only native gate",
    "",
    `- Command: \`${commandText}\`.`,
    `- Canonical structured command SHA-256: \`${invocationDigest}\`.`,
    `- Started: ${started}; ended: ${ended}.`,
    `- Actual exit code: ${child.status}; signal: ${child.signal ?? "none"}.`,
    `- stdout SHA-256: \`${sha(stdout)}\`; stderr SHA-256: \`${sha(stderr)}\`.`,
    `- stdout: ${JSON.stringify(stdout.toString("utf8"))}.`,
    `- stderr: ${JSON.stringify(stderr.toString("utf8"))}.`,
    `- All referenced input byte/canonical bindings and the composed review stayed unchanged: ${stable}.`,
    "- Invocation count here: 1. No repair, revalidation or integration follows this finite gate.",
    "- Final accounting: 0 image openings; 17 inherited question approvals; 2 affected questions / 8 options reviewed; all 14 independent source solutions inherited; 12 source coverage checks inherited and 2 updated.",
    "- F1/F2 are historical REVISE findings resolved for their c targets; new F3 at 317(a) remains unresolved. The first result/review were never altered. Parent owns the next decision.",
    ""
  ].join("\n");
  fs.appendFileSync(path.join(cwd, owned, "observations.md"), finalObservation);
  const finalBindings = {
    ...afterBindings,
    review: binding(`${owned}/review.json`),
    diff: binding(`${owned}/diff.json`),
    affected_checks: binding(`${owned}/affected-checks.json`),
    provenance: binding(`${owned}/review-provenance.json`),
    observations: binding(`${owned}/observations.md`, false),
    validation_receipt: binding(`${owned}/validation.receipt.json`),
    validation_once_marker: binding(`${owned}/validation.once.json`),
    finalizer: binding(`${owned}/finalize.mjs`, false)
  };
  const usage = {
    schema: "s10y-choice-affected-review-usage-v1",
    cwd, ticket: "182-6/STEMROBIN-182", book: "8a", lesson: "alg8-c3-s3-n20",
    bindings: finalBindings,
    counts: {
      ...provenance.counts,
      native_validator_invocations: 1,
      full_source_resolves: 0,
      draft_edits: 0,
      content_repair_rounds_here: 0,
      generated_images: 0,
      rendered_images: 0,
      figure_reviews_reopened: 0,
      agents_created_or_messaged: 0,
      chats_created_or_messaged: 0,
      worktrees_created: 0,
      git_actions: 0,
      database_calls: 0,
      installs: 0,
      network_calls: 0,
      paid_calls: 0,
      paid_cost: 0,
      newly_found_unresolved_defects: 1
    },
    inherited_usage_not_reset: provenance.prior_usage,
    prior_first_review_images: 2,
    prior_repair_images: 0,
    images_here: 0,
    retained_cumulative_images_from_referenced_stages: 2,
    prior_content_repair_rounds: 1,
    new_content_repair_rounds: 0,
    retained_cumulative_content_repair_rounds: 1,
    losses: provenance.losses,
    observation_order: provenance.observation_order,
    validation: {
      command_sha256: invocationDigest, actual_exit_code: child.status,
      stdout_sha256: sha(stdout), stderr_sha256: sha(stderr)
    },
    status,
    finite_gate_stopped: true,
    finalized_at: new Date().toISOString()
  };
  write(`${owned}/usage.json`, usage);
  const result = {
    status,
    semantic_outcome: review.outcome,
    approved: false,
    ticket: "182-6/STEMROBIN-182",
    book: "8a", lesson: "alg8-c3-s3-n20", cwd,
    reviewer: review.reviewer,
    current_bindings: finalBindings,
    usage: binding(`${owned}/usage.json`),
    input_bindings_unchanged_through_native_gate: stable,
    complete_native_review: true,
    question_review_count: 19,
    source_review_count: 14,
    counts: usage.counts,
    inheritance: {
      question_approvals_inherited_unchanged: 17,
      affected_questions_reviewed: 2,
      original_source_solutions_inherited_verbatim: 14,
      original_source_coverage_inherited_verbatim: 12,
      affected_source_coverage_updated: 2,
      original_figure_checks_inherited_verbatim: 1,
      original_first_review_outcome: "revise",
      original_first_result_status: "REVISE",
      no_revisit_of_unchanged_questions: true,
      original_findings: provenance.historical_findings
    },
    affected_mathematics: {
      verdict: "pass", independently_checked_questions: 2,
      independently_checked_options: 8, unique_true_sets_match_keys: true,
      true_sets: { "n20-reduce-domain-table": ["C"], "n20-composed-cube-factors": ["A"] },
      target_c_cannot_be_eliminated_using_only_other_rows: provenance.target_c_pair_checks
    },
    findings: provenance.new_findings,
    losses: provenance.losses,
    validation: {
      ...validation,
      receipt: binding(`${owned}/validation.receipt.json`)
    },
    ownership: `Writes only in ${path.join(cwd, owned)}. Originals, repaired draft, retained content and other workers' files untouched.`,
    stop: "Finite affected-only semantic gate stopped. F1/F2 c targets resolved; new F3 requires revision. No draft repair, extra validator call, integration or publication. Parent owns any next action.",
    finalized_at: new Date().toISOString()
  };
  write(`${owned}/result.json`, result);
  console.log(JSON.stringify({
    status, outcome: review.outcome,
    result: binding(`${owned}/result.json`),
    review: finalBindings.review,
    native_invocation_count: 1,
    actual_exit_code: child.status,
    actual_stdout: stdout.toString("utf8"),
    actual_stderr: stderr.toString("utf8"),
    bindings_unchanged: stable,
    images_opened: 0,
    inherited_questions: 17,
    reviewed_questions: 2,
    resolved_historical_findings: ["F1", "F2"],
    unresolved_new_findings: ["F3"]
  }, null, 2));
} else {
  throw new Error("Expected compose or validate; no native command has run.");
}
