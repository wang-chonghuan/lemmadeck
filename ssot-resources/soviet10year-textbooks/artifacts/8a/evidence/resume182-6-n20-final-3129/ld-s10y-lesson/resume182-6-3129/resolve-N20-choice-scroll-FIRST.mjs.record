import assert from 'node:assert/strict';
import fs from 'node:fs';
import crypto from 'node:crypto';

const root = '/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck';
assert.equal(process.cwd(), root);
const config = JSON.parse(fs.readFileSync(process.argv[2]));
const runtime = JSON.parse(fs.readFileSync(config.runtime));
assert.equal(config.captureReport, runtime.report.path);
const bytes = fs.readFileSync(config.captureReport);
assert.equal(crypto.createHash('sha256').update(bytes).digest('hex'), runtime.report.sha256);
assert.ok(Array.isArray(JSON.parse(bytes).screenshots));
let code = fs.readFileSync(`${root}/.tmp/ld-s10y-lesson/resume182-6-3129/resolve-N20-scroll-FIRST.mjs`, 'utf8');
const once = (before, after) => {
  assert.equal(code.split(before).length, 2);
  code = code.replace(before, after);
};
once('const runtime = read(config.runtime);',
  'const runtime = read(config.runtime);\nruntime.screenshots = read(config.captureReport).screenshots;');
once('runtime: entry(config.runtime), configuration: entry(configPath),',
  'runtime: entry(config.runtime), captureReport: entry(config.captureReport), configuration: entry(configPath),');
await import(`data:text/javascript;base64,${Buffer.from(code).toString('base64')}`);
