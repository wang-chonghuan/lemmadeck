    stdout_text: fs.readFileSync(path.join(root, "validation.stdout.txt"), "utf8"),
    stderr_text: fs.readFileSync(path.join(root, "validation.stderr.txt"), "utf8"),
    receipt: binding(`${relativeRoot}/validation.receipt.json`, true),
