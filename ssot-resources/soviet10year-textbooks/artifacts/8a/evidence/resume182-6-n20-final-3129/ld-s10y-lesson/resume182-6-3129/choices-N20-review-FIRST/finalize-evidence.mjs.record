  },
  evidence_files: [...evidenceFiles, binding(`${relativeRoot}/usage.json`, true)],
  ownership: "Parent owns fixes, affected-review, retention and rendering. No candidate edits or review reruns. Finite review stopped here.",
  finalized_at: new Date().toISOString()
};
fs.writeFileSync(path.join(root, "result.json"), JSON.stringify(result, null, 2) + "\n", { flag: "wx" });
console.log(JSON.stringify({
