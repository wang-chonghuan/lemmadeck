import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";

const cwd = "/Users/yong/.codex/worktrees/stemrobin-182-six-3129/lemmadeck";
const relativeRoot = ".tmp/ld-s10y-lesson/resume182-6-3129/choices-N20-review-FIRST";
const root = path.join(cwd, relativeRoot);
if (process.cwd() !== cwd) throw new Error("Wrong cwd");
if (fs.existsSync(path.join(root, "result.json"))) throw new Error("Evidence already finalized");

function ordered(value) {
  if (Array.isArray(value)) return value.map(ordered);
  if (value && typeof value === "object") {
    return Object.fromEntries(Object.keys(value).sort().map((key) => [key, ordered(value[key])]));
  }
  return value;
}

function binding(relativePath, json = false) {
  const absolutePath = path.join(cwd, relativePath);
  const bytes = fs.readFileSync(absolutePath);
  const record = {
    path: absolutePath,
    bytes_sha256: crypto.createHash("sha256").update(bytes).digest("hex"),
    bytes: bytes.length
  };
  if (json) {
    const text = JSON.stringify(ordered(JSON.parse(bytes))).replace(/[\u007f-\uffff]/g,
      (character) => "\\u" + character.charCodeAt(0).toString(16).padStart(4, "0"));
    record.canonical_sha256 = crypto.createHash("sha256").update(text).digest("hex");
  }
  return record;
}

const receipt = JSON.parse(fs.readFileSync(path.join(root, "validation.receipt.json"), "utf8"));
const review = JSON.parse(fs.readFileSync(path.join(root, "review.json"), "utf8"));
const current = receipt.bindings_after.map((record) => binding(record.path, true));
const intact = current.every((record, index) =>
  record.bytes_sha256 === receipt.bindings_before[index].bytes_sha256 &&
  record.bytes_sha256 === receipt.bindings_after[index].bytes_sha256 &&
  record.canonical_sha256 === receipt.bindings_before[index].canonical_sha256 &&
  record.canonical_sha256 === receipt.bindings_after[index].canonical_sha256);
const status = intact && receipt.exit_code === 3 && review.outcome === "revise" ? "REVISE" : "BLOCKED";
const findings = [
  {
    id: "F1",
    source_number: "314",
    subtask: "c",
