    verdict: "revise",
    evidence: "All four options supply exactly (x-1)(x^2+10x+37). The complete correct factorization is unanimous and needs no base extraction or trinomial judgment. The specific omission is not declared."
  }
];
const evidenceFiles = [
  "blind-source-solutions.md",
  "visible-task-fidelity.md",
  "visible-independent-solutions.md",
  "observations.md",
  "validation.stdout.txt",
  "validation.stderr.txt",
  "validation.receipt.json",
  "run-validation.mjs",
  "finalize-evidence.mjs"
].map((name) => binding(`${relativeRoot}/${name}`, name.endsWith(".json")));
const assets = [
  "ssot-resources/soviet10year-textbooks/artifacts/8a/figures/fig-32.png",
  ".tmp/ld-s10y-lesson/resume182-6-3129/figure-N20-author-FIRST/actual-complete-640.preview.png",
  "ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/figures/fig-32.svg",
  "ssot-resources/soviet10year-textbooks/artifacts/6a/lessons/alg6-c2-s1-n8/lesson.json"
].map((name) => binding(name));
const usage = {
  cwd,
  reviewer_kind: "independent_agent",
  scope: "Finite NEW N20 semantic review, 182-6/STEMROBIN-182",
  source_count: 14,
  independently_solved_source_tasks_including_bundled_subtasks: 55,
  question_count: 19,
  independently_checked_option_count: 80,
  independently_true_option_count: 24,
  independently_false_option_count: 56,
  total_image_opens: 2,
  image_batches: 1,
  image_opens_each: [
    { ...assets[0], opens: 1 },
    { ...assets[1], opens: 1 }
  ],
  extra_image_opens: 0,
  crops: 0,
  renders: 0,
  figure_reapprovals: 0,
  new_figures: 0,
  native_validation_invocations: 1,
  native_validation_exit_code: receipt.exit_code,
  author_candidate_writes: 0,
  durable_writes: 0,
  network_calls: 0,
  database_calls: 0,
  env_file_reads: 0,
  installs: 0,
