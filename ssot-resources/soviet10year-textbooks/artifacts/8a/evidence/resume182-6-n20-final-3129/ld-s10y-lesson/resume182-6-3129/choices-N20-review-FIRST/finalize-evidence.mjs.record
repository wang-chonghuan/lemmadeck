  git_operations: 0,
  created_agents_or_chats: 0,
  paused_worker_operations: 0,
  old_answer_or_choice_reads: 0,
  technical_recoveries: [
    { stage: "source-only Node hash probe", first_exit_code: 1, corrected_exit_code: 0,
      cause: "Parenthesis syntax error before any file read; no content or image stage repeated." }
  ],
  token_usage: null,
  token_usage_note: "No authoritative per-turn token usage counter was available; no estimate presented as measurement.",
  current_bindings: current,
  evidence_files: evidenceFiles,
  finalized_at: new Date().toISOString()
};
fs.writeFileSync(path.join(root, "usage.json"), JSON.stringify(usage, null, 2) + "\n", { flag: "wx" });
const result = {
  status,
  semantic_outcome: review.outcome,
  cwd,
  ticket: "182-6/STEMROBIN-182",
  book: "8a",
  lesson: "alg8-c3-s3-n20",
  reviewer: review.reviewer,
  current_bindings: { seed: current[0], draft: current[1], review: current[2] },
  bindings_unchanged_before_validation_after_validation_and_finalization: intact,
  source_coverage_count: review.source_reviews.length,
  question_review_count: review.question_reviews.length,
  mathematics: {
