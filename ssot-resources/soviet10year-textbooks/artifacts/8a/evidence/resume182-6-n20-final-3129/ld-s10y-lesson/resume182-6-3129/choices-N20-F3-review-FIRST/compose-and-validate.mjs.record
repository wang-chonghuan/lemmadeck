];
const commandText = [command, ...argv].join(" ");
outputBindings.once_marker = write("validation.once.json", {
  cwd, command, argv, invocation_count: 1,
  created_at: new Date().toISOString(),
  review: outputBindings.review,
  no_separate_structural_invocation: true,
});
const startedAt = new Date().toISOString();
const child = spawnSync(command, argv, {
  cwd,
  env: { ...process.env, PYTHONDONTWRITEBYTECODE: "1" },
  maxBuffer: 4 * 1024 * 1024,
});
const endedAt = new Date().toISOString();
const stdout = child.stdout ?? Buffer.alloc(0);
const stderr = child.stderr ?? Buffer.alloc(0);
fs.writeFileSync(path.join(own, "validation.stdout.txt"), stdout, { flag: "wx" });
fs.writeFileSync(path.join(own, "validation.stderr.txt"), stderr, { flag: "wx" });
const stableInputs = Object.entries(inputBindings).every(([name, before]) =>
  canonical(before) === canonical(binding(files[name])));
const stableReview = canonical(outputBindings.review) ===
  canonical(binding(outputBindings.review.path));
const receipt = {
  schema: "stemrobin-182/native-choice-validation-receipt@1",
  invocation_count: 1, cwd, command, argv,
  command_text: commandText,
  command_sha256: digest({ cwd, command, argv }),
  argv_canonical_sha256: digest(argv),
  environment_overrides: { PYTHONDONTWRITEBYTECODE: "1" },
  started_at: startedAt, ended_at: endedAt,
  exit_code: child.status, signal: child.signal,
  process_error: child.error ? String(child.error) : null,
  stdout: binding(path.join(own, "validation.stdout.txt")),
  stderr: binding(path.join(own, "validation.stderr.txt")),
  input_bindings: inputBindings,
  review: outputBindings.review,
  input_bindings_unchanged: stableInputs,
  review_binding_unchanged: stableReview,
  no_separate_structural_invocation: true,
  scope: "Mechanical complete-package validation only; semantic work was F3 affected-only.",
};
outputBindings.validation_receipt = write("validation.receipt.json", receipt);
const approved = child.status === 0 && !child.error && !child.signal
  && stableInputs && stableReview;
const status = approved ? "PASS" : "BLOCKED";
const finalObservation = [
  "", "## Actual once-only native result", "",
  `Command: \`${commandText}\`.`,
