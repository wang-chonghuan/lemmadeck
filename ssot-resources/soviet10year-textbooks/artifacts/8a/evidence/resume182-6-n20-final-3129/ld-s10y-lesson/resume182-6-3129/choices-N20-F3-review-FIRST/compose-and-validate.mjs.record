}

const changes = [];
function diff(before, after, pointer = "") {
  if (canonical(before) === canonical(after)) return;
  if (before !== null && after !== null
      && typeof before === "object" && typeof after === "object"
      && Array.isArray(before) === Array.isArray(after)) {
    for (const key of new Set([...Object.keys(before), ...Object.keys(after)])) {
      diff(before[key], after[key], `${pointer}/${key}`);
    }
  } else {
    changes.push({ path: pointer, before, after });
  }
}
diff(priorDraft, draft);
const questionIndex = draft.questions.findIndex(q => q.id === target);
assert.equal(questionIndex, 13);
assert.deepEqual(changes.map(change => change.path), [
  "/questions/13/view/options/2/text",
  "/questions/13/key/rationales/2/derivation",
  "/questions/13/key/rationales/2/misconception",
]);
assert.equal(changes[0].after,
  changes[0].before.replace("I: $(a+5)(a^2+13a+43)$", "I: $(a+5)(a^2+a+43)$"));
assert.deepEqual(draft.coverage, priorDraft.coverage);
