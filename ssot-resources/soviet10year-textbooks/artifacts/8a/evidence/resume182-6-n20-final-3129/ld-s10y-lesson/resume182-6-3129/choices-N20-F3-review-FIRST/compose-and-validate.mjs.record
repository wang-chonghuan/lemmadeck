  `Actual exit code: ${child.status}; signal: ${child.signal ?? "none"}.`,
  `stdout: \`${JSON.stringify(stdout.toString("utf8"))}\`.`,
  `stderr: \`${JSON.stringify(stderr.toString("utf8"))}\`.`,
  `Inputs unchanged: ${stableInputs}; composed review unchanged: ${stableReview}.`,
  `Actual finite result: ${status}. Native invocations here: 1.`,
  "No structural repeat, repair, image/source rerun, integration or external action follows.",
  "",
].join("\n");
fs.appendFileSync(path.join(own, "observations.md"), finalObservation);
outputBindings.observations = binding(path.join(own, "observations.md"));
