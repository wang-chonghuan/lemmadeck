};
const sha = value => crypto.createHash("sha256").update(value).digest("hex");
const sorted = value => Array.isArray(value)
  ? value.map(sorted)
  : value !== null && typeof value === "object"
    ? Object.fromEntries(Object.keys(value).sort().map(key => [key, sorted(value[key])]))
    : value;
const canonical = value => JSON.stringify(sorted(value))
  .replace(/[\u0080-\uffff]/g, char => `\\u${char.charCodeAt(0).toString(16).padStart(4, "0")}`);
const digest = value => sha(canonical(value));
const read = file => JSON.parse(fs.readFileSync(file, "utf8"));
const binding = file => {
  const bytes = fs.readFileSync(file);
  const result = { path: file, bytes: bytes.length, bytes_sha256: sha(bytes) };
  try {
    result.canonical_sha256 = digest(JSON.parse(bytes.toString("utf8")));
  } catch {}
  return result;
};
const write = (name, value) => {
  const file = path.join(own, name);
  assert.equal(path.dirname(file), own);
  fs.writeFileSync(file, `${JSON.stringify(value, null, 2)}\n`, { flag: "wx" });
  return binding(file);
};
const inputBindings = Object.fromEntries(
  Object.entries(files).map(([name, file]) => [name, binding(file)]),
);
assert.equal(inputBindings.new_draft.canonical_sha256,
  "935f316a5a1657eb0b404c0d9052c5a02f1250cc191f0d28270ddb93e9f42877");
assert.equal(inputBindings.new_draft.bytes_sha256,
