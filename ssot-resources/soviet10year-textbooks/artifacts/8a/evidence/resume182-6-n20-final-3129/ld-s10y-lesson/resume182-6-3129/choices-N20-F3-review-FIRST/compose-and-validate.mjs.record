const reviewer = {
  kind: "independent_agent",
  identity: "Authorized designated independent F3 FIRST reviewer for 182-6/STEMROBIN-182; did not author any input draft. Seed 317 prose and new view, then view-first.md, preceded key/rationale/inherited-math disclosure. Exactly 18 unchanged question approvals (including 314/F1), all 14 independent source solutions, 13 source coverage checks and the one figure check inherited verbatim from RECOVERY1; only 317 F3 and affected relationships reviewed. No new agent/chat, image opening or whole-source solving. Historical FIRST F1/F2 and RECOVERY1 F3 failures retained, not rewritten.",
};
const review = {
  schema: inherited.schema,
  seed_sha256: inherited.seed_sha256,
  draft_sha256: digest(draft),
  reviewer,
  source_reviews: inherited.source_reviews.map(source => source.source_number === "317"
    ? { ...source, coverage: source317Coverage } : source),
  figure_checks: inherited.figure_checks,
