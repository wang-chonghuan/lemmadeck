    writes_only: own, input_drafts_or_historical_reviews_modified: false,
    durable_changes: false, external_actions: false,
  },
  stop: {
    finite_task_complete: true, no_further_action_authorized: true,
    no_draft_repair_or_integration: true,
  },
  finalized_at: finalizedAt,
};
const resultBinding = write("result.json", result);
console.log(JSON.stringify({
  status, approved, review: outputBindings.review, result: resultBinding,
  usage: outputBindings.usage, observations: outputBindings.observations,
  validation_receipt: outputBindings.validation_receipt,
  stdout: receipt.stdout, stderr: receipt.stderr,
  actual_exit_code: child.status,
  native_validator_invocations: 1,
  inherited_questions: 18, reviewed_questions: 1,
  images_here: 0, cumulative_content_repairs: 2,
  finite_task_stopped: true,
}, null, 2));
if (!approved) process.exitCode = 1;
