};
const inheritedQuestions = draft.questions.filter(q => q.id !== target).map(question => {
  const prior = priorDraft.questions.find(q => q.id === question.id);
  assert.deepEqual(question, prior);
  const oldReview = inherited.question_reviews.find(q => q.question_id === question.id);
  const newReview = review.question_reviews.find(q => q.question_id === question.id);
  assert.deepEqual(newReview, oldReview);
  for (const check of [oldReview.task_fidelity, oldReview.redundancy,
    oldReview.answer_leakage, oldReview.mathematics]) assert.equal(check.verdict, "pass");
  return {
    question_id: question.id,
    question_canonical_sha256: digest(question),
    review_canonical_sha256: digest(oldReview),
    inherited_verbatim: true,
  };
});
