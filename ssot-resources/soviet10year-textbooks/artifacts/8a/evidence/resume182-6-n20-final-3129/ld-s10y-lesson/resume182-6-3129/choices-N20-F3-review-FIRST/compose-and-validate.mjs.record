assert.deepEqual(changed.intent, priorQuestion.intent);
assert.deepEqual(changed.view.options[1], priorQuestion.view.options[1]);
const rows = text => text.split("\n\n");
const aRows = rows(changed.view.options[0].text);
const bRows = rows(changed.view.options[1].text);
assert.deepEqual([aRows[0], aRows[1], aRows[3]], [bRows[0], bRows[1], bRows[3]]);
assert.notEqual(aRows[2], bRows[2]);
assert.equal(new Set(changed.view.options.map(option => rows(option.text)[0])).size, 2);

const oldQuestionReview = inherited.question_reviews.find(q => q.question_id === target);
const optionChecks = structuredClone(oldQuestionReview.mathematics.option_checks);
optionChecks.find(option => option.option_id === "C").evidence =
