+def offset_system(ink, y, rows=2, column=120, pitch=90):
+    for index in range(rows):
+        text_row(ink, y + pitch * index, x=column, count=7)
+    brace(ink, column - 22, y, y + pitch * (rows - 1) + 30)
+    glyph(ink, column - 60, y + pitch // 2)
+
