+    def test_paired_two_equations_with_one_shared_offset_label_baseline(self):
+        ink = np.zeros((400, 900), dtype=bool)
+        text_row(ink, 15)
+        for column in (120, 450):
+            offset_system(ink, 100, column=column)
+        text_row(ink, 320, count=2, height=20)
+        bands = self.assert_rows(ink, 5)
+        self.assertTrue(any(a <= 145 and b >= 174 for a, b in bands), bands)
+
+    def test_mixed_three_and_two_equations_with_one_offset_label_baseline(self):
+        ink = np.zeros((500, 900), dtype=bool)
+        text_row(ink, 15)
+        for index in range(3):
+            text_row(ink, 100 + 90 * index, x=120, count=7)
+        brace(ink, 98, 100, 310)
+        glyph(ink, 60, 190)
+        offset_system(ink, 100, column=450)
+        text_row(ink, 400, count=2, height=20)
+        bands = self.assert_rows(ink, 6)
+        self.assertTrue(any(a <= 145 and b >= 174 for a, b in bands), bands)
+
+    def test_multiple_offset_label_events_are_not_collapsed(self):
+        ink = np.zeros((650, 900), dtype=bool)
+        text_row(ink, 15)
+        for y in (100, 300):
+            for column in (120, 450):
+                offset_system(ink, y, column=column)
+        text_row(ink, 550, count=2, height=20)
+        self.assert_rows(ink, 8)
+
