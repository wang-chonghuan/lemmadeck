+def _independent_offset_label_rows(
+    ink: np.ndarray, content_w: int, glyph_h: float, bounds_list: list
+) -> list[tuple[int, int]]:
+    """Keep label-only baselines, not labels sharing any equation's ink row."""
+    braces = [
+        (rows, columns)
+        for bounds in bounds_list if bounds is not None
+        for rows, columns in [bounds]
+        if 2 * glyph_h < rows.stop - rows.start < 6 * glyph_h
+        and columns.stop - columns.start < 0.6 * glyph_h
+    ]
+    if not braces:
+        return []
+    labels = [
+        (rows, columns)
+        for bounds in bounds_list if bounds is not None
+        for rows, columns in [bounds]
+        if 0.6 * glyph_h <= rows.stop - rows.start <= 1.5 * glyph_h
+        and 0.2 * glyph_h <= columns.stop - columns.start <= 1.3 * glyph_h
+        and any(
+            brace_rows.start <= rows.start and rows.stop <= brace_rows.stop
+            and brace_columns.start - 2 * glyph_h <= columns.start
+            and columns.stop <= brace_columns.start
+            for brace_rows, brace_columns in braces
+        )
+    ]
+    if not labels:
+        return []
+    equations = ink.copy()
+    for rows, columns in braces + labels:
+        equations[rows, columns] = False
+    equation_rows = _merge_close(_row_fragments(equations, content_w), 0.4 * glyph_h)
+    label_rows = _merge_close(
+        sorted((rows.start, rows.stop - 1) for rows, _ in labels), 0.25 * glyph_h
     )
+    return [
+        (a, b) for a, b in label_rows
+        if ink[a:b + 1].any()
+        and any(rows.start < a <= b < rows.stop for rows, _ in braces)
+        and not any(c <= b and a <= d for c, d in equation_rows)
+    ]
 
 
