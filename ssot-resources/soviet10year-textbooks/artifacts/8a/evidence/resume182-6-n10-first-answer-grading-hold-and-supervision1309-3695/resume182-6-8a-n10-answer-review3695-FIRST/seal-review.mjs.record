  mathematicalCorrectness: 'PASS',
  provenance: 'PASS_DERIVED_MATCHES_HASH_BOUND_CURRENT_PREPARE_TEMPLATE',
  coverage: `PASS_ALL_${independent.parts.length}_LABELED_SUBQUESTIONS_IN_DISPLAY`,
  units: independent.exercise === '137' ? 'PASS_TWO_KM_PER_HOUR_AND_TWO_M_PER_SECOND_TARGETS' : 'NOT_APPLICABLE',
  displaySufficiency: 'PASS_CONCRETE_RESULTS_AND_NECESSARY_BOUNDARIES_OR_REASONING',
