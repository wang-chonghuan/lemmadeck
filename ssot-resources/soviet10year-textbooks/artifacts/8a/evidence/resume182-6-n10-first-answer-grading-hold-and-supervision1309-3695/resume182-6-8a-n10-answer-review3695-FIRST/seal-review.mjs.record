import fs from 'node:fs';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';

const R = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
const W = `${R}/.tmp/resume182-6-8a-n10-answer-review3695-FIRST`;
const A = `${R}/.tmp/resume182-6-8a-n10-answer-author3695-FIRST`;
assert.equal(process.cwd(), R);
const hash = path => crypto.createHash('sha256').update(fs.readFileSync(path)).digest('hex');
const bind = path => ({ path, sha256: hash(path) });
const read = path => JSON.parse(fs.readFileSync(path, 'utf8'));
const derivation = read(`${W}/independent.derivation.json`);
const freeze = read(`${W}/independent.freeze.record`);
assert.equal(hash(freeze.derivation.path), freeze.derivation.sha256);
assert.equal(freeze.status, 'FROZEN_BEFORE_AUTHOR_CANDIDATE_READ');
assert.equal(hash(`${A}/answers.draft.json`), 'b1ee4c245193b5d0ceb24e93f761da1415dad0b21b804a60af08cb661f0b018d');
assert.equal(hash(`${A}/ready.record`), 'bc123d270a0b16187a8cb41273957c363021b2d53fabad20ad4816b41731adfc');
const author = read(`${A}/ready.record`);
const candidate = read(`${A}/answers.draft.json`);
for (const input of derivation.inputs) assert.equal(hash(input.path), input.sha256, input.path);
assert.equal(hash(author.template.path), author.template.sha256);
const template = read(author.template.path);
assert.ok(template.answers.every(a => a.source === 'derived' && !a.bookRaw));
