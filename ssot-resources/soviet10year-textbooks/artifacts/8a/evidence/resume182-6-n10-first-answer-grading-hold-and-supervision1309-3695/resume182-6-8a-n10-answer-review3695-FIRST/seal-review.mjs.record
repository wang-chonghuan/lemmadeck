      : independent.exercise === '136'
        ? 'PASS_UNGRADED_KNOWN_EQUIVALENT_INEQUALITY_SYSTEMS_NOT_RELIABLY_CANONICALIZED_BY_EXISTING_JUDGES'
        : 'PASS_UNGRADED_REQUESTED_DRAWING_WITH_COMPLETE_STANDARD_CONSTRUCTION'
  ),
  candidateGrading: candidate.answers[index].grading,
  comparisonMethod: 'Reviewer semantic comparison against independently frozen derivation; not automated equivalence of prose.',
  checkedParts: independent.parts,
}));
const executions = fs.readdirSync(W, { withFileTypes: true })
  .filter(entry => entry.isDirectory() && fs.existsSync(`${W}/${entry.name}/start.record`))
  .map(entry => {
    const directory = `${W}/${entry.name}`;
    const receiptPath = `${directory}/receipt.record`;
    return {
      name: entry.name,
      start: bind(`${directory}/start.record`),
      receipt: fs.existsSync(receiptPath) ? bind(receiptPath) : null,
      result: fs.existsSync(receiptPath) ? read(receiptPath) : null,
    };
  });
const failures = executions.filter(e => e.result && e.result.returncode !== 0).map(e => ({
  ...e,
  classification: 'TECHNICAL_PATH_DISCOVERY_FAILURE_NOT_SCIENTIFIC_CONTENT_FAILURE',
  stderr: bind(`${W}/${e.name}/stderr.txt`),
  recovery: e.name === 'rules-read2'
