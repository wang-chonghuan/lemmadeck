    id: 'GRADING-132',
    exercise: '132',
    affectedParts: ['a', 'b', 'c', 'd'],
    category: 'GRADING_CONTRACT_EVIDENCE_GAP',
    status: 'HOLD',
    candidateFields: ['grading=ungraded', 'parts=[]', 'notes'],
    independentResults: ['not in F', 'in F', 'not in F', 'in F'],
    finding: 'All four membership answers are correct, including B on the included boundary. The current prompt requests closed membership judgments. Rejecting arbitrary numeric encoding or calling the answers natural-language is not evidence that the existing judges cannot reliably express them; four distinct target judgments are omitted.',
    evidence: 'The actual exact normalizer accepts equivalent literal text wrappers for membership and distinguishes belongs from does-not-belong. No candidate-specific real MathLive text editing test was supplied; lexical checks alone neither approve exact replacements nor justify ungraded.',
    resolutionRequired: 'Provide four independent reliable auto parts and any required real exact editing evidence, or demonstrate a specific current input/judge limitation supporting ungraded. Keep A/B/C/D order and the inclusive upper-bound result for B.',
  },
];
