assert.equal(candidate.answers.length, 7);
assert.equal(candidate.answers.filter(a => a.grading === 'auto').length, 1);
assert.equal(candidate.answers.flatMap(a => a.parts).length, 4);
assert.ok(candidate.answers.every(a => a.source === 'derived'));
assert.equal(derivation.images.views, 2);
const independentReceipt = read(`${W}/independent-freeze13/receipt.record`);
const authorReadStart = read(`${W}/author-read-after-freeze14/start.record`);
assert.equal(independentReceipt.returncode, 0);
assert.ok(new Date(independentReceipt.finished) <= new Date(authorReadStart.started));
const validation = read(`${W}/read-only-validation.record`);
assert.deepEqual(validation.structureErrors, []);
const numericCheck = read(`${W}/numeric-key-contract22/stdout.txt`);
assert.equal(numericCheck.status, 'pass');
assert.equal(numericCheck.checked, 4);
const lexicalCheck = read(`${W}/lexical-binary-contract23/stdout.txt`);
assert.equal(lexicalCheck.status, 'PASS_LEXICAL_ONLY_NOT_MATHLIVE_INPUT_APPROVAL');
const currentRender = read(derivation.inputs.find(i => i.path.endsWith('/modern-us-neutral/figures/fig-25.render.json')).path);
assert.equal(currentRender.output.svg.sha256, 'd2799da5e0cfaf8c90f27636ce8b0fa94038512b0aa2b8a085e3576f419cfcad');

