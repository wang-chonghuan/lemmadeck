import hashlib
import importlib.util
import json
from fractions import Fraction as F
from pathlib import Path

R = Path("/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck")
W = R / ".tmp/resume182-6-8a-n10-answer-review3695-FIRST"
A = R / ".tmp/resume182-6-8a-n10-answer-author3695-FIRST/answers.draft.json"
assert Path.cwd() == R
assert hashlib.sha256(A.read_bytes()).hexdigest() == "b1ee4c245193b5d0ceb24e93f761da1415dad0b21b804a60af08cb661f0b018d"
spec = importlib.util.spec_from_file_location(
    "review_official_lesson_answers",
    R / ".claude/skills/ld-s10y-answer/tools/lesson_answers.py",
)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
profile = json.loads(module.MODERN_US_PROFILE.read_text())
document, errors = module.validate_lesson(
    A,
    R / "ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c2-s2-n10/exercises.json",
    "8a",
    "alg8-c2-s2-n10",
    "modern-us-neutral",
    profile.get("forbidden_terms", []) + profile.get("forbidden_person_names", []),
)
assert not errors, errors
assert all(a["source"] == "derived" and not a.get("bookRaw") for a in document["answers"])

points = [(F(0), F(0)), (F(-1), F(1, 2)), (F(1), F(-1)), (F(1, 3), F(1))]
linear = [2 * x + 3 * y for x, y in points]
squares = [x * x + y * y for x, y in points]
assert linear == [F(0), F(-1, 2), F(-1), F(11, 3)]
assert squares == [F(0), F(5, 4), F(2), F(10, 9)]
assert [l > -1 and q <= 2 for l, q in zip(linear, squares)] == [True, True, False, True]
assert [abs(y - x) <= 4 for x, y in [(0, 5), (-1, 3), (-20, 20), (100, 102)]] == [False, True, False, True]
u, v = F(24, 5), F(18, 5)
assert u * u + v * v == 36
assert 4 * (u - v) == F(24, 5)
p, q = F(4, 25), F(3, 25)
assert 6 * p == 8 * q
assert (15 * p) ** 2 + (15 * q) ** 2 == 9
speed_parts = document["answers"][-1]["parts"]
assert [F(part["expected"][0]) for part in speed_parts] == [u, v, p, q]
assert all(part["judge"] == "numeric" for part in speed_parts)
report = {
    "schema": "resume182-6/read-only-answer-structure-and-rational-check@1",
    "status": "PASS_READ_ONLY_CHECK_NOT_FINALIZE",
    "book": "8a",
    "lesson": "alg8-c2-s2-n10",
    "edition": "modern-us-neutral",
    "officialPureFunction": "lesson_answers.validate_lesson",
    "officialFinalizeRuns": 0,
    "structureErrors": errors,
    "rationalAssertions": 9,
    "numericTargets": [str(u), str(v), str(p), str(q)],
    "scope": "Structural validation and exact rational verification only; grading suitability is a separate independent-review verdict.",
    "pythonBytecodeWrites": 0,
    "cost": "unknown",
}
with (W / "read-only-validation.record").open("x") as output:
    json.dump(report, output, indent=2)
    output.write("\n")
print(json.dumps(report, indent=2))
