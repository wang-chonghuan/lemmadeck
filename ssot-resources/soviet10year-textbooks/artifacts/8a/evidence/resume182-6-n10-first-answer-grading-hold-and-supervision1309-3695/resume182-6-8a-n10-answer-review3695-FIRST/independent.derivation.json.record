      "exercise": "131", "groupId": "g0",
      "method": "Substitute each pair in both 2x+3y > -1 and x^2+y^2 <= 2; conjunction, with the first bound strict.",
      "parts": [
        {"label": "a", "linear": "0", "squaredRadius": "0", "expected": "yes"},
