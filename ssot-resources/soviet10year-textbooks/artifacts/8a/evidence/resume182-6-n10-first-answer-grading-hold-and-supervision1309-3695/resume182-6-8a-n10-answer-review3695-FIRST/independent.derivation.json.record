    {
      "exercise": "133", "groupId": "g0",
      "parts": [
        {"label": "a", "set": "x >= 0; y <= 0", "geometry": "Fourth quadrant and both bounding axis rays, including O. Shade to the right of the y axis and below the x axis; solid rays."},
        {"label": "b", "set": "x >= 2; y <= -1", "geometry": "Unbounded southeast region from (2,-1). Draw x=2 and y=-1 as solid lines and shade their lower-right intersection, including its boundary rays."},
        {"label": "c", "set": "2 <= x < 4.5; 1 <= y <= 5", "geometry": "Rectangle [2,4.5) x [1,5]. Left, top and bottom edges included except both right endpoints; right edge x=4.5 wholly excluded and dashed. Right corners excluded."},
        {"label": "d", "set": "-1 < x < 2; -4 < y < -1", "geometry": "Open rectangle with vertices (-1,-4),(2,-4),(2,-1),(-1,-1). Shade interior only; all four sides dashed and all corners excluded."}
      ],
      "gradingAssessment": "Drawing is ungraded; display must specify every region and open/closed edge, not leave unknown answers."
    },
    {
      "exercise": "134", "groupId": "g0",
      "parts": [
        {"label": "a", "set": "x <= 0; 2x+6 <= y <= -2x+6", "geometry": "Closed wedge opening left, vertex (0,6), between the two solid rays. Feasibility follows from 2x+6 <= -2x+6."},
        {"label": "b", "set": "-3 <= x <= 3; |x|+2 <= y <= 5", "geometry": "Closed triangle with vertices (-3,5),(0,2),(3,5), all three edges and vertices included. Draw y=x+2, y=-x+2 and y=5; shade their common region."},
        {"label": "c", "set": "3x-1.5 <= y <= 3x+6", "geometry": "Closed infinite strip between parallel lines of slope 3 and y intercepts -1.5 and 6. Dividing 2y-6x+3 >= 0 gives y >= 3x-1.5.", "labelErratum": "Use current modern third label c only; do not alter the already-approved label erratum."},
        {"label": "d", "set": "-2 <= x <= 2; 0 <= y <= 2-|x|", "geometry": "Closed triangle with vertices (-2,0),(0,2),(2,0), bounded by y=0,y=x+2,y=2-x. All edges and vertices included."}
      ],
      "gradingAssessment": "Four drawings, ungraded with concrete constructions."
    },
    {
      "exercise": "135", "groupId": "g0",
      "parts": [
        {"label": "a", "set": "x^2+y^2 <= 0.64; y >= 0", "geometry": "Closed upper half-disk centered at O, radius sqrt(0.64)=0.8; include semicircular arc and horizontal diameter from (-0.8,0) to (0.8,0)."},
        {"label": "b", "set": "4 <= x^2+y^2 <= 16", "geometry": "Closed concentric annulus centered at O, inner radius 2 and outer radius 4. Both circles included, central open disk excluded."},
        {"label": "c", "set": "0 <= x <= 4; 4-x <= y <= sqrt(16-x^2)", "geometry": "Closed first-quadrant circular segment of the radius-4 disk above chord x+y=4. Substitution y=4-x gives 2x(x-4)=0, endpoints (0,4),(4,0). Include the chord and the first-quadrant arc, not the whole quarter-disk. (0,0) excluded; (2,3) included."},
        {"label": "d", "set": "-2 <= x <= 2; x^2 <= y <= 4", "geometry": "Closed parabolic segment between y=x^2 and y=4. Intersections (-2,4),(2,4), vertex (0,0). Include parabola, top segment, and endpoints."}
      ],
      "gradingAssessment": "Four drawings, ungraded with all radii, intersection points and included boundaries explicit."
    },
    {
      "exercise": "136", "groupId": "g0", "singleExerciseFourPanels": true,
      "parts": [
        {"label": "a", "set": "x >= 0; y <= 0", "reason": "Lower-right hatching, solid axes, quadrant unbounded; grid frame is viewport clipping, not an extra bound."},
        {"label": "b", "set": "3 <= x <= 5; 1 <= y <= 4", "reason": "Read the rectangle boundaries relative to its own O and unit grid; x axis is y=0 below its bottom. Four solid sides included."},
        {"label": "c", "set": "x >= 0; x^2+y^2 <= 16", "reason": "Right half of radius-4 disk about its own O. Hatching is on both sides of horizontal axis; closed diameter and arc included."},
        {"label": "d", "set": "16 <= x^2+y^2 <= 36", "reason": "Whole annulus with radii 4 and 6 about its own O, not a right-half annulus. Both circular boundaries included."}
      ],
      "gradingAssessment": "Known explicit inequality systems. Current exact/numeric/expression judges do not reliably judge equivalent unordered conjunctions of inequalities; ungraded is appropriate, not a substitute for solving."
