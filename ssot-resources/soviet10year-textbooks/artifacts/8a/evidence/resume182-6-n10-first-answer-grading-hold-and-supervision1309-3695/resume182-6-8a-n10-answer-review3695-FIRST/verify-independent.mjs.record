near((4 * 4.8) ** 2 + (4 * 3.6) ** 2, 24 ** 2);
near(6 * 0.16, 8 * 0.12);
near((15 * 0.16) ** 2 + (15 * 0.12) ** 2, 3 ** 2);
equal([-4.8, -3.6].every(v => v >= 0), false);
equal([-0.16, -0.12].every(v => v >= 0), false);
