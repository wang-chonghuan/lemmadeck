import fs from 'node:fs';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';

const R = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
const W = `${R}/.tmp/resume182-6-8a-n10-answer-review3695-FIRST`;
assert.equal(process.cwd(), R);
const hash = path => crypto.createHash('sha256').update(fs.readFileSync(path)).digest('hex');
const derivation = JSON.parse(fs.readFileSync(`${W}/independent.derivation.json`, 'utf8'));
for (const input of derivation.inputs) assert.equal(hash(input.path), input.sha256, input.path);
const exInput = derivation.inputs.find(input => input.path.endsWith('/exercises.json'));
const exercises = JSON.parse(fs.readFileSync(exInput.path, 'utf8'));
assert.deepEqual(exercises.exercises.map(e => e.number), derivation.exercises.map(e => e.exercise));
assert.equal(exercises.exercises.at(-1).group_id, 'g1');
assert.equal(derivation.authorCandidateReadBeforeFreeze, false);
assert.equal(derivation.images.views, 2);
let checks = 0;
const equal = (actual, expected) => {
  assert.deepEqual(actual, expected);
  checks++;
};
const near = (actual, expected) => {
  assert.ok(Math.abs(actual - expected) < 1e-10, `${actual} != ${expected}`);
  checks++;
};
const points131 = [[0, 0], [-1, 0.5], [1, -1], [1 / 3, 1]];
equal(points131.map(([x, y]) => 2 * x + 3 * y > -1 && x * x + y * y <= 2), [true, true, false, true]);
near(2 / 3 + 3, 11 / 3);
near(1 / 9 + 1, 10 / 9);
equal([[0, 5], [-1, 3], [-20, 20], [100, 102]].map(([x, y]) => Math.abs(y - x) <= 4), [false, true, false, true]);

// Boundary probes cover strict edges, solid corners, arc endpoints and excluded regions.
const sets = {
  '133a': (x, y) => x >= 0 && y <= 0,
  '133b': (x, y) => x >= 2 && y <= -1,
  '133c': (x, y) => x >= 2 && x < 4.5 && y >= 1 && y <= 5,
  '133d': (x, y) => x > -1 && x < 2 && y > -4 && y < -1,
  '134a': (x, y) => y >= 2 * x + 6 && y <= -2 * x + 6,
  '134b': (x, y) => y >= x + 2 && y >= -x + 2 && y <= 5,
  '134c': (x, y) => y - 3 * x - 6 <= 0 && 2 * y - 6 * x + 3 >= 0,
  '134d': (x, y) => x + y <= 2 && y - x <= 2 && y >= 0,
  '135a': (x, y) => x * x + y * y <= 0.64 + 1e-12 && y >= 0,
  '135b': (x, y) => x * x + y * y >= 4 && x * x + y * y <= 16,
  '135c': (x, y) => x * x + y * y <= 16 && y >= 4 - x,
  '135d': (x, y) => y >= x * x && y <= 4,
  '136a': (x, y) => x >= 0 && y <= 0,
  '136b': (x, y) => x >= 3 && x <= 5 && y >= 1 && y <= 4,
  '136c': (x, y) => x >= 0 && x * x + y * y <= 16,
  '136d': (x, y) => x * x + y * y >= 16 && x * x + y * y <= 36,
};
const probes = {
  '133a': [[0, 0, true], [0, -10, true], [10, 0, true], [-1, -1, false]],
  '133b': [[2, -1, true], [10, -20, true], [1.99, -1, false], [2, -0.99, false]],
  '133c': [[2, 1, true], [2, 5, true], [4.5, 1, false], [4.5, 5, false], [4.49, 5, true]],
  '133d': [[0, -2, true], [-1, -2, false], [2, -2, false], [0, -4, false], [0, -1, false]],
  '134a': [[0, 6, true], [-1, 4, true], [-1, 8, true], [1, 6, false], [-1, 9, false]],
  '134b': [[-3, 5, true], [0, 2, true], [3, 5, true], [0, 5, true], [0, 1, false], [4, 5, false]],
  '134c': [[0, -1.5, true], [0, 6, true], [2, 4.5, true], [2, 12, true], [0, -1.51, false], [0, 6.01, false]],
  '134d': [[-2, 0, true], [0, 2, true], [2, 0, true], [0, 0, true], [0, -1, false], [3, 0, false]],
  '135a': [[0.8, 0, true], [-0.8, 0, true], [0, 0.8, true], [0, -0.1, false], [0, 0.81, false]],
  '135b': [[2, 0, true], [0, -4, true], [0, 0, false], [5, 0, false]],
  '135c': [[0, 4, true], [4, 0, true], [2, 2, true], [2, 3, true], [0, 0, false], [-1, 4, false]],
  '135d': [[-2, 4, true], [2, 4, true], [0, 0, true], [1, 1, true], [3, 4, false], [0, 5, false]],
  '136a': [[0, 0, true], [100, -100, true], [-1, -1, false], [1, 1, false]],
  '136b': [[3, 1, true], [3, 4, true], [5, 1, true], [5, 4, true], [4, 0, false], [0, 2, false]],
  '136c': [[0, 0, true], [0, -4, true], [0, 4, true], [4, 0, true], [-1, 0, false], [3, -3, false]],
  '136d': [[4, 0, true], [0, -6, true], [-5, 0, true], [0, 0, false], [3, 0, false], [7, 0, false]],
};
for (const [id, cases] of Object.entries(probes)) {
  for (const [x, y, expected] of cases) equal(sets[id](x, y), expected);
}
for (let x = -6; x <= 6; x += 0.5) {
  for (let y = -8; y <= 8; y += 0.5) {
    equal(sets['134a'](x, y), x <= 0 && y >= 2 * x + 6 && y <= -2 * x + 6);
    equal(sets['134b'](x, y), x >= -3 && x <= 3 && y >= Math.abs(x) + 2 && y <= 5);
    equal(sets['134c'](x, y), y >= 3 * x - 1.5 && y <= 3 * x + 6);
    equal(sets['134d'](x, y), x >= -2 && x <= 2 && y >= 0 && y <= 2 - Math.abs(x));
    equal(sets['135c'](x, y), x >= 0 && x <= 4 && y >= 4 - x && y <= Math.sqrt(16 - x * x));
    equal(sets['135d'](x, y), x >= -2 && x <= 2 && y >= x * x && y <= 4);
  }
}
const spec = JSON.parse(fs.readFileSync(derivation.inputs.find(i => i.path.endsWith('/fig-25.spec.json')).path, 'utf8'));
const object = id => spec.objects.find(o => o.id === id);
equal(object('fig-25-b-origin-label').at, [32, 27]);
equal(object('fig-25-b-rectangle-left').from.map((v, i) => v - [32, 27][i]), [3, 1]);
equal(object('fig-25-b-rectangle-right').to.map((v, i) => v - [32, 27][i]), [5, 4]);
equal(object('fig-25-v-circle').center, object('fig-25-v-origin-label').at);
equal(object('fig-25-v-circle').radius, 4);
equal(object('fig-25-g-inner-circle').center, object('fig-25-g-origin-label').at);
equal(object('fig-25-g-outer-circle').center, object('fig-25-g-origin-label').at);
equal(object('fig-25-g-inner-circle').radius, 4);
equal(object('fig-25-g-outer-circle').radius, 6);
