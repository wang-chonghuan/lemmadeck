assert.equal(process.cwd(), root);
const base = '.tmp/ld-s10y-lesson/resume182-7-C5Ex';
const source = `${base}/answer-author-FIRST/answer-keys-FIRST.json`;
const target = 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c5-ex/answer-keys.json';
assert.equal(createHash('sha256').update(fs.readFileSync(source)).digest('hex'),
  'd4fb9b5739db182f184b29c947e9e51136671e32247494c7d5ccf3a7376fa05f');
assert.ok(fs.existsSync(`${base}/math-independent-FIRST/answer-comparison-FIRST.record0444`));
