import assert from 'node:assert/strict';
import fs from 'node:fs';
import { createHash } from 'node:crypto';

const root = '/Users/yong/work/lemmadeck-ws/lemmadeck--STEMROBIN-182';
assert.equal(process.cwd(), root);
const base = '.tmp/ld-s10y-lesson/resume182-7-C5Ex';
const output = `${base}/answer-runtime-FIRST-failure`;
const input = 'ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c5-ex/answer-keys.json';
const bytes = fs.readFileSync(input);
const sha256 = createHash('sha256').update(bytes).digest('hex');
assert.equal(sha256, 'd4fb9b5739db182f184b29c947e9e51136671e32247494c7d5ccf3a7376fa05f');
assert.ok(!fs.existsSync(output));
fs.mkdirSync(output);
const document = JSON.parse(bytes);
const cases = document.answers.flatMap(answer => answer.parts
  .filter(part => (answer.exercise === '683' && part.label.startsWith('g)'))
    || (answer.exercise === '700' && part.judge === 'exact'))
  .map(part => ({
    name: `${document.lesson}/${answer.exercise}/${part.label}`,
    input: part.expected[0], expected: part.expected, reject: [],
  })));
assert.equal(cases.length, 4);
fs.writeFileSync(`${output}/scoped-cases.json`, `${JSON.stringify({ cases }, null, 2)}\n`,
  { flag: 'wx', mode: 0o444 });
fs.writeFileSync(`${output}/first-failure.record`, `${JSON.stringify({
  actualFinalizerExit: 2, caseCount: 64, failedCases: 4,
  input: { path: input, sha256 },
  unchangedFrozenCandidate: `${base}/answer-author-FIRST/answer-keys-FIRST.json`,
  passedCasesNotIndependentlyRepeated: 60,
  identifiedFailures: 'Three 683g bare-variable exponent serializations; fourth set-delimiter case is a scoped diagnostic, not yet confirmed.',
  originalOutput: 'Full finalizer stderr was returned by exec session 51774; the tool display was truncated. This record does not claim to reproduce the full stderr.',
  scope: 'Original current MathLive checker on three failed cases and one specifically suspected delimiter case only, not a mathematical source rereview.',
}, null, 2)}\n`, { flag: 'wx', mode: 0o444 });
console.log(JSON.stringify({ cases: cases.length, inputUnchanged: true, output }));
