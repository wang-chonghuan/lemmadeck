  {
    "id": "q700-linear-exponents",
    "source_numbers": [
      "700"
    ],
    "view": {
      "mode": "multiple",
      "stem": "哪些根的判断正确？各方程独立求解。",
      "figure_ids": [],
      "options": [
        {
          "id": "A",
          "text": "$3^x=1/\\sqrt[3]{9}$ 的根是 $-2/3$；$7^x=1/\\sqrt[5]{7}$ 的根是 $-1/5$。",
          "figure_ids": []
        },
        {
          "id": "B",
          "text": "$0.4^x=6\\frac14$ 的根是 $-2$；$0.2^x=125$ 的根是 $-3$。",
          "figure_ids": []
        },
        {
          "id": "C",
          "text": "$5^x=((4/5)\\cdot1.25)^{10}$ 的根是 $0$。",
          "figure_ids": []
