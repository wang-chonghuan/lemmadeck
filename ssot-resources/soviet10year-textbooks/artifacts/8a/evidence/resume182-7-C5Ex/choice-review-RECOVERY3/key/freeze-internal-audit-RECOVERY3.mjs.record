const issues = issueData.map(([q, o, suffix, evidence, repair]) => ({
  id: `C5EX-KEY-${q}-${o}-${suffix}-RECOVERY3`,
  verdict: 'revise',
  question_id: q,
  option_id: o,
  affected_field: `questions[id=${q}].key.rationales[option_id=${o}].misconception`,
  evidence,
  smallest_repair: repair,
  truth_key_effect: 'None. Frozen option truth and correct set stay unchanged.',
}));
const issueMap = new Map(issues.map(x => [`${x.question_id}/${x.option_id}`, x]));
const completedChecks = [];
const reusedChecks = [];
const sourceGroups = new Map();
for (const q of key1.question_key_comparisons) {
  const current = draft.questions.find(v => v.id === q.question_id);
  assert.ok(current, q.question_id);
  const sourceNumber = current.source_numbers[0];
  assert.equal(current.source_numbers.length, 1);
  if (!sourceGroups.has(sourceNumber)) sourceGroups.set(sourceNumber, {
    source_number: sourceNumber,
    author_solution: current.intent.source_solution,
    author_solution_sha256: hash(current.intent.source_solution),
    question_ids: [],
  });
  const sourceGroup = sourceGroups.get(sourceNumber);
  assert.equal(sourceGroup.author_solution, current.intent.source_solution);
  sourceGroup.question_ids.push(current.id);
  for (const option of q.options) {
    const author = current.key.rationales.find(r => r.option_id === option.option_id);
    const visible = current.view.options.find(v => v.id === option.option_id);
    const id = `${q.question_id}/${option.option_id}`;
    const issue = issueMap.get(id);
    const common = {
      question_id: q.question_id,
      option_id: option.option_id,
      source_number: sourceNumber,
      learner_option: visible,
      independent_truth_reused: option.independent_truth,
      independent_evidence_reused: option.independent_evidence,
      reused_truth_comparison: { record: bind(key1Path), status: option.truth_comparison },
      author_rationale: author,
      author_rationale_snapshot_sha256: hash(JSON.stringify(author)),
    };
    if (id === 'q696-one/D') {
      assert.deepEqual(author, key2.affected_review.after);
      reusedChecks.push({
        ...common,
        check_kind: 'incorrect-option-mistaken-procedure-and-refutation',
        verdict: 'pass',
        evidence: key2.affected_review.evidence,
        review_reused: bind(key2Path),
        repeated: false,
      });
      continue;
    }
    assert.deepEqual(author, option.author_rationale, id);
    if (option.independent_truth === 'correct') {
      assert.equal(author.misconception, null);
      completedChecks.push({
        ...common,
        check_kind: 'correct-option-author-derivation',
        verdict: 'pass',
        evidence: `Author derivation: ${author.derivation} Frozen independent verification: ${option.independent_evidence} The author source-solution field for source ${sourceNumber} supplies the same transformation/results and is compared below; concise option derivations are not treated as independent handwritten production evidence.`,
        issue_ids: [],
      });
    } else {
      const procedure = procedures[q.question_id]?.[option.option_id];
      assert.ok(procedure, id);
      assert.equal(procedure.startsWith('FAIL:'), Boolean(issue), id);
      completedChecks.push({
        ...common,
        check_kind: 'incorrect-option-mistaken-procedure-and-refutation',
        verdict: issue ? 'revise' : 'pass',
        mistaken_procedure_evidence: issue ? issue.evidence : procedure,
        refutation_verdict: 'pass',
        refutation_evidence: `Author refutation: ${author.derivation} Reused frozen false-option evidence: ${option.independent_evidence} These agree about why the option is false; that agreement is separate from the generative-procedure verdict.`,
        issue_ids: issue ? [issue.id] : [],
      });
    }
  }
}
assert.equal(completedChecks.length, 239);
assert.equal(reusedChecks.length, 1);
const misconceptions = completedChecks.filter(x => x.independent_truth_reused === 'incorrect');
const correctDerivations = completedChecks.filter(x => x.independent_truth_reused === 'correct');
assert.equal(misconceptions.length, 132);
assert.equal(correctDerivations.length, 107);
assert.equal(misconceptions.filter(x => x.verdict === 'revise').length, 7);
assert.equal(issues.length, 7);
assert.equal(sourceGroups.size, 43);

const authorSourceSolutionChecks = [...sourceGroups.values()].map(s => {
  const priorCoverage = key1.source_coverage_comparisons
    .find(x => x.source_number === s.source_number);
  const concreteEvidence = key1.question_key_comparisons
    .filter(q => q.source_numbers.includes(s.source_number))
    .flatMap(q => q.options.filter(o => o.independent_truth === 'correct')
      .map(o => `${q.question_id}/${o.option_id}: ${o.independent_evidence}`));
  const qualifications = s.source_number === '702'
    ? 'The initially wrong sign is explicitly retained as a historical fault and then corrected in the same field; the final result, not the obsolete intermediate claim, agrees with the frozen independent solution.'
    : s.source_number === '707'
      ? 'Both mapping directions retain the integer-index/recurrence restrictions, zero-sequence exceptions and unresolved original conventions; this is not approval of the unrestricted original proof claim.'
      : ['723', '724'].includes(s.source_number)
        ? 'Computed internal numerical values are not recast as historical-image precision; authored graph/table normalization and recognition losses remain those already frozen.'
        : 'The transformation, final responses and endpoint/domain distinctions match the already frozen independent solution. No new source solve was performed.';
  return {
    source_number: s.source_number,
    question_ids: s.question_ids,
    author_solution_sha256: s.author_solution_sha256,
    author_solution: s.author_solution,
    independent_authority_reused: {
      ...bind(sourcePath),
      section: `### ${s.source_number}`,
    },
    verdict: 'pass',
    evidence: `${qualifications} ${concreteEvidence.join(' ')} ${priorCoverage.reused_fidelity_and_response_loss_evidence}`,
  };
});
