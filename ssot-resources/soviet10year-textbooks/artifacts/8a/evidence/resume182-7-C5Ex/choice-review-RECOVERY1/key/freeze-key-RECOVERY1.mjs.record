fs.mkdirSync(own, { recursive: true });
const out = `${own}/choice-key-RECOVERY1.record0444`;
assert.equal(fs.existsSync(out), false);
fs.writeFileSync(out, `${JSON.stringify(record, null, 2)}\n`, { flag: 'wx', mode: 0o444 });
assert.equal(fs.statSync(out).mode & 0o777, 0o444);
for (const [p, expected] of frozen) assert.equal(bind(p).sha256, expected, p);
console.log(JSON.stringify({
  status: record.status,
  outcome: record.outcome,
  path: out,
  sha256: bind(out).sha256,
  mode: bind(out).mode,
  coverage: record.coverage,
  canonical_review_written: false,
  validator_exitCode: null,
  validator_executed: false,
  new_images: 0,
}, null, 2));
