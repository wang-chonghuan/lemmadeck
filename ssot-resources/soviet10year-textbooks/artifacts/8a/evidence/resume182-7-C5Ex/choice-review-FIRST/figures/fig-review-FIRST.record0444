        "authoritative_text": [
          {
            "lesson": "alg8-c5-ex",
            "exercise": "687",
            "text": "687. \u5229\u7528\u51fd\u6570 $y=2^x$ \u7684\u56fe\u8c61\uff0c\u8bf4\u660e\u5728\u4ec0\u4e48\u60c5\u51b5\u4e0b\uff0c\u51fd\u6570\u5f97\u5230\u8f83\u5927\u7684\u6539\u53d8\u91cf\uff1a\na) $x$ \u4ece 0.5 \u53d8\u5316\u5230 1.5 \u6216\u4ece 1.5 \u53d8\u5316\u5230 2.5\uff1b\nb) $x$ \u4ece 0.2 \u53d8\u5316\u5230 0.7 \u6216\u4ece 1.2 \u53d8\u5316\u5230 1.7."
          },
          {
            "lesson": "alg8-c5-ex",
            "exercise": "688",
            "text": "688. \u5728\u540c\u4e00\u5f20\u56fe\u7eb8\u4e0a\u7b80\u7565\u5730\u4f5c\u51fa\u51fd\u6570 $y=1.5^x$ \u548c $y=2^x$ \u7684\u56fe\u8c61. \u5229\u7528\u56fe\u8c61\u89e3\u65b9\u7a0b $1.5^x=2^x$ \u548c\u4e0d\u7b49\u5f0f $1.5^x<2^x$\uff1b$1.5^x>2^x$."
          },
          {
            "lesson": "alg8-c5-ex",
            "exercise": "693",
            "text": "693. \u5206\u522b\u5728 $a>1$ \u548c $0<a<1$ \u7684\u60c5\u51b5\u4e0b\uff0c\u7b80\u7565\u5730\u4f5c\u51fa\u51fd\u6570 $y=a^x$ \u548c $y=a$ \u7684\u56fe\u8c61. \u6bd4\u8f83\u8fd9\u51e0\u4e2a\u56fe\u8c61\u7684\u76f8\u4e92\u4f4d\u7f6e."
          }
        ]
