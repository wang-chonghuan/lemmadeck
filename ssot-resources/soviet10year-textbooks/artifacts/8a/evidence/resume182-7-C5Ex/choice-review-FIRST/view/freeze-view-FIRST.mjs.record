import fs from 'node:fs';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';
import path from 'node:path';

const root = '/Users/yong/work/lemmadeck-ws/lemmadeck--STEMROBIN-182';
assert.equal(process.cwd(), root);
const base = '.tmp/ld-s10y-lesson/resume182-7-C5Ex';
const author = `${base}/choices-author-FIRST`;
const own = `${base}/choice-review-FIRST/view`;
const sourcePath = `${base}/math-independent-FIRST/source-solutions-FIRST.record0444`;
const figurePath = `${base}/choice-review-FIRST/figures/fig-review-FIRST.record0444`;
const hash = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
const bind = file => ({ path: file, sha256: hash(fs.readFileSync(file)) });
const read = file => JSON.parse(fs.readFileSync(file, 'utf8'));
const sorted = value => Array.isArray(value) ? value.map(sorted)
  : value && typeof value === 'object'
    ? Object.fromEntries(Object.keys(value).sort().map(k => [k, sorted(value[k])]))
    : value;
const canonical = value => hash(Buffer.from(JSON.stringify(sorted(value))
  .replace(/[\u007f-\uffff]/g, c => `\\u${c.charCodeAt(0).toString(16).padStart(4, '0')}`)));
assert.equal(bind(sourcePath).sha256, '92ebd86c58ebab876c51b7a2ffe63d69c9f779232628483a4356c4e248a47db4');
assert.equal(fs.statSync(sourcePath).mode & 0o777, 0o444);
assert.equal(fs.statSync(figurePath).mode & 0o777, 0o444);
const figureReview = read(figurePath);
assert.equal(figureReview.status, 'PASS');
assert.equal(figureReview.image_usage.actually_viewed_total, 8);
const learnerPath = `${author}/learner-view-FIRST.json`;
const seedPath = `${author}/seed-FIRST.json`;
const learner = read(learnerPath);
const seed = read(seedPath);
assert.deepEqual(Object.keys(learner).sort(), ['figures', 'questions']);
for (const q of learner.questions) {
  assert.deepEqual(Object.keys(q).sort(), ['id', 'view']);
  assert.deepEqual(Object.keys(q.view).sort(), ['figure_ids', 'mode', 'options', 'stem']);
  for (const o of q.view.options) assert.deepEqual(Object.keys(o).sort(), ['figure_ids', 'id', 'text']);
}

