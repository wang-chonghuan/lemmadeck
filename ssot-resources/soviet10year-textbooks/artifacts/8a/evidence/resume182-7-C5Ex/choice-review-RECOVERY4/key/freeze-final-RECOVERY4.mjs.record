const repairEvidence = new Map([
  ['q683-constants/A', 'The first four comparisons are explicitly left correct. Only the last two subtractions are reversed; their reversed exponent signs yield the two displayed opposite comparisons. All six entries are now generated and the actual last-entry errors are correctly refuted.'],
  ['q685-inverse/D', 'The new rule branches on written form: copy integers, use a negative denominator for a unit fraction, and negate original subunit decimals. The six branches generate every displayed coordinate, including the previously unexplained reciprocal input. The refutation distinguishes these copied values from exponent roots.'],
  ['q693-constant-crossing/D', 'Both regimes have distinct stated mistakes: the superunit regime extends the y-axis height comparison to the whole domain, producing no crossing; the subunit regime replaces the horizontal line by y=1, producing a zero-abscissa crossing. Both false claims are generated and their actual common threshold is correctly refuted.'],
  ['q698-increasing/C', 'Restricting attention to the y axis and its left side removes the genuine right-side intersection, while miscounting the line x-intercept adds the displayed false root. The retained common intersection completes exactly the displayed two-element set. Both omission and false addition are explicit and correctly refuted.'],
  ['q707-forward-domain/C', 'The zero-ratio first-term error is now explicitly generalized to every ratio, with a further belief that adjusting c restores lost nonzero terms after choosing a=0. This produces the full universal assertion rather than only a special case. The refutation correctly notes that finite c cannot restore nonzero terms at positive indices.'],
  ['q712-nesting/C', 'The mistaken operation is now explicitly the strictly next integer, floor(v)+1, not ordinary ceiling. For every fractional residue v in [0,1), including v=0, that operation returns 1, so it generates the entire universal false claim. The actual floor-zero boundary is correctly refuted.'],
  ['q719-graph-matching/B', 'The first sum is misread as fraction-of-floor, yielding zero/B; the second nesting is misread as inverse cancellation, yielding x/A; the third expression is handled correctly as zero/B. All three graph choices are generated, and the true sequence is correctly refuted.'],
]);
const normalized = structuredClone(draft);
const affected = audit3.issues.map(issue => {
  const q = draft.questions.find(q => q.id === issue.question_id);
  const old = previousDraft.questions.find(q => q.id === issue.question_id)
    .key.rationales.find(r => r.option_id === issue.option_id);
  const after = q.key.rationales.find(r => r.option_id === issue.option_id);
  const n = normalized.questions.find(q => q.id === issue.question_id)
    .key.rationales.find(r => r.option_id === issue.option_id);
  assert.notEqual(after.derivation, old.derivation);
  assert.notEqual(after.misconception, old.misconception);
  n.derivation = old.derivation;
  n.misconception = old.misconception;
  const evidence = repairEvidence.get(`${issue.question_id}/${issue.option_id}`);
  assert.ok(evidence);
  return {
    question_id: issue.question_id,
    option_id: issue.option_id,
    affected_fields: ['key.rationales.derivation', 'key.rationales.misconception'],
    before: old,
    after,
    learner_option: q.view.options.find(o => o.id === issue.option_id),
    verdict: 'pass',
    evidence,
    refutation_verdict: 'pass',
    original_issue: issue.id,
    disposition: 'REPAIRED_IN_RECOVERY4_PRIOR_FAILURE_PRESERVED',
  };
});
assert.deepEqual(normalized, previousDraft);
const internal = new Map([
