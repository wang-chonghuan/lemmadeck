      "figures": [],
      "blocks": [
        {"kind": "ex", "number": "712", "printed_lines": 3, "lines": ["712. 计算：", "а) $\\{[17.3]\\}$；　б) $[\\{-25.7\\}]$；　в) $\\{[15]\\}$；", "г) $[\\{23\\}]$。"]},
        {"kind": "ex", "number": "713", "printed_lines": 3, "lines": ["713. 写出使下列不等式成立的变量 $a$ 的几个值：", "а) $\\{a\\}<0.15$；　б) $\\{a\\}>\\frac{2}{3}$；", "в) $\\{a\\}+0.05>\\{a+0.05\\}$。"]},
        {"kind": "ex", "number": "714", "printed_lines": 2, "lines": ["714. 解下列方程：", "а) $[2.75+x]=[2.75]$；　б) $\\{2.75+x\\}=\\{2.75\\}$。"]},
        {"kind": "ex", "number": "715", "printed_lines": 4, "lines": ["715. 解下列方程：", "а) $[0.21+x]=[0.21]$；　б) $[y-0.36]=[2.4]$；", "в) $[1.7+z]=[-8.2]$；　г) $\\{0.58+x\\}=0.58$；", "д) $\\{y-0.39\\}=0.61$；　е) $\\{1.62+x\\}=0.65$。"]},
        {"kind": "ex", "number": "716", "printed_lines": 2, "lines": ["716. 指出使下列等式不成立的变量 $x$ 的任何一个值：", "а) $\\{5.41+x\\}=\\{5.41\\}+\\{x\\}$；　б) $[2x]=2[x]$。"]},
        {"kind": "ex", "number": "717", "printed_lines": 1, "lines": ["717. 两数的积的小数部分等于因数的小数部分的积吗？"]},
        {"kind": "ex", "number": "718", "printed_lines": 1, "lines": ["718. 两数的和的整数部分等于两个加数的整数部分的和吗？"]},
        {"kind": "ex", "number": "719", "printed_lines": 2, "lines": ["719. 作出下列函数的图象：", "а) $y=[x]+\\{x\\}$；　б) $y=[\\{x\\}]$；　в) $y=\\{[x]\\}$。"]},
        {
          "kind": "ex", "number": "720", "printed_lines": 4,
          "lines": ["720. 在坐标平面上指出点的集合，设：", "а) $[x]=0$；　б) $[y]=1$；　в) 方程组：$[x]=1$，$[y]=2$。"],
          "layout_rows": [
            {"y_approx": 2520, "content": "题干"},
            {"y_approx": 2648, "content": "в) 方程组上等式 [x]=1"},
            {"y_approx": 2695, "content": "а) [x]=0；б) [y]=1；в) 标号；位于上下等式之间", "independent_labelrow": true},
            {"y_approx": 2748, "content": "в) 方程组下等式 [y]=2"}
          ],
          "formula_facts": {"single_equations": ["[x]=0", "[y]=1"], "system_equations_in_order": ["[x]=1", "[y]=2"], "one_left_brace": true, "subpart_labels": ["а", "б", "в"]},
          "note": "这是中间独立标号兼 а/б 单行公式横排，不是源缺方程；不能把 [y] 当换行可选 size，也不能删等式或伪造断点来凑数。"
        },
        {"kind": "ex", "number": "721", "printed_lines": 1, "lines": ["721. 作出方程 $[x]=[y]$ 的图象。"]},
        {"kind": "exhead", "printed_lines": 1, "lines": ["第 34 和 35 小节"]},
        {"kind": "ex", "number": "722", "open": true, "printed_lines": 1, "lines": ["722. 设 $31.5=10^a$，$0.42=10^b$，把下列各式表示成底数为 10"], "ends_mid_sentence": true},
        {"kind": "foot", "printed_lines": 1, "lines": ["222"]}
