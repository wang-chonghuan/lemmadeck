    {
      "number": "717",
      "text": "717. \u4e24\u6570\u7684\u79ef\u7684\u5c0f\u6570\u90e8\u5206\u7b49\u4e8e\u56e0\u6570\u7684\u5c0f\u6570\u90e8\u5206\u7684\u79ef\u5417\uff1f",
      "figure_ids": []
