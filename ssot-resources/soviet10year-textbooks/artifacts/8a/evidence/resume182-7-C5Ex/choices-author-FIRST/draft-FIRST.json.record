      ],
      "view": {
        "mode": "multiple",
        "stem": "哪些完整根集正确？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$81^{x-1}=243$ 的根集是 $\\{9/4\\}$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$36^{2x+3}=216$ 的根集是 $\\{-3/4\\}$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$2^{x^2-2x+1}=8^{-1}2^3$ 的根集是 $\\{1\\}$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$81^{x-1}=243$ 的根集是 $\\{5/4\\}$。",
            "figure_ids": []
          },
          {
            "id": "E",
            "text": "$2^{x^2-2x+1}=8^{-1}2^3$ 的根集是 $\\{-1,1\\}$。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "705: Task: three equations.",
        "source_solution": "705. Task: three equations.\na 3^(4x-4)=3^5 =>9/4.\nb 6^(4x+6)=6^3 =>-3/4.\nc 8^-1*2^3=1 =>(x-1)^2=0 =>{1}, one distinct root.",
        "unit_reason": "两线性指数与一个重根结构共同组成根集诊断，强调“不同根”的集合含义。",
        "concept_blocks": [],
        "limitations": [
          "选择只能显示识别与判断，不能证明学习者能独立写出推导或结果。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "A",
          "B",
          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "3^(4x-4)=3^5 =>x=9/4。",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "6^(4x+6)=6^3 =>x=-3/4。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "右端1，(x-1)^2=0仅一个不同实根。",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "解的是4(x-1)=5，必须加1。",
            "misconception": "求出x-1=5/4后直接记为x。"
          },
          {
            "option_id": "E",
            "truth": "incorrect",
            "derivation": "平方的是x-1，而非x。",
            "misconception": "把(x-1)^2=0误套为x^2=1的两个根。"
          }
        ]
      }
    },
