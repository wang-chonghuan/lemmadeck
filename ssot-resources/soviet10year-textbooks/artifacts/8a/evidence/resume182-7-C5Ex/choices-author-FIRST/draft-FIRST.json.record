          "B",
          "D"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": ".04=1/25，所以左侧25^5<25^6。",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "倒数3/2=1.5，取六次幂。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "正底数任意实指数的值为正。",
            "misconception": "把负指数直接当作负号放到幂值前。"
          },
          {
            "option_id": "D",
            "truth": "correct",
            "derivation": "1/.5=2，倒数幂规则。",
            "misconception": null
          },
          {
            "option_id": "E",
            "truth": "incorrect",
            "derivation": "倒数变底数不改变指数的绝对值5。",
            "misconception": "倒数转换后无依据把指数5增加为6。"
          }
        ]
      }
    },
