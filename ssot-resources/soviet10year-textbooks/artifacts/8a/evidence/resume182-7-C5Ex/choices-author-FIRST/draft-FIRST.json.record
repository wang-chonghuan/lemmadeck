        "task": "704: Task: three inequalities.",
        "source_solution": "704. Task: three inequalities.\na 3^(x/2+1)>3^-3 => x>-8.\nb 3^(3x+1-x)=3^(2x+1)<3^-1 =>x<-1.\nc 2^(-6x+1/3)>1 =>x<1/18.",
        "unit_reason": "三种合底不等式的完整解集，第三项保留负系数导致的反向。",
        "concept_blocks": [],
        "limitations": [
          "选择只能显示识别与判断，不能证明学习者能独立写出推导或结果。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "B"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "第一式指数x/2+1>-3，而非x/2>-3。",
            "misconception": "把左侧乘3忽略，只解根底数与右侧的比较。"
          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "分别x/2+1>-3；2x+1<-1；-6x+1/3>0。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "incorrect",
            "derivation": "除以-6要反号。",
            "misconception": "在-6x>-1/3后除负数仍保持大于。"
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "第二式指数是3x+1-x=2x+1。",
            "misconception": "漏掉3^{1-x}中常数1，仅比较2x<-1，得到x<-1/2。"
          }
        ]
      }
    },
    {
      "id": "q705-roots",
      "source_numbers": [
