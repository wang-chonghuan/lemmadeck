      "intent": {
        "task": "685: Task: six inverse exponential equations. RHS are 2^5,2^-6,2^-1,",
        "source_solution": "685. Task: six inverse exponential equations. RHS are 2^5,2^-6,2^-1,\n2^-2,2^-3,2^7; uniqueness gives x=5,-6,-1,-2,-3,7 respectively.",
        "unit_reason": "同一个逆映射的完整输出列，包括倒数和有限小数；完整结果识别替代独立求解，未按六个原答槽拆题。",
        "concept_blocks": [],
        "limitations": [
          "选择只能显示识别与判断，不能证明学习者能独立写出推导或结果。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "C"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "incorrect",
            "derivation": "小于1的右端应对应负指数。",
            "misconception": "对倒数或小数只数2的因子个数，丢掉倒数的负号。"
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": ".25=2^-2，.125=2^-3。",
            "misconception": "把.25和.125取倒数后所得4和8直接当成负指数。"
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "逐项统一为2的整数次幂，严格递增确保唯一。",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "指数不是右端本身。",
            "misconception": "用大于1保持原数、小于1取负的规则代替指数反演。"
          }
        ]
      }
    },
    {
