          },
          {
            "option_id": "B",
            "truth": "correct",
            "derivation": "25/4=(2/5)^-2，125=5^3=(1/5)^-3。",
            "misconception": null
          },
          {
            "option_id": "C",
            "truth": "correct",
            "derivation": "括号为1，右侧1，5^0=1唯一。",
            "misconception": null
          },
          {
            "option_id": "D",
            "truth": "incorrect",
            "derivation": "根指数为-2/3。",
            "misconception": "把立方根9=3^(2/3)的指数分子分母交换后取负。"
          },
          {
            "option_id": "E",
            "truth": "incorrect",
            "derivation": ".4^2=.16，并非6.25。",
            "misconception": "将右端25/4读为(.4)^2而忽略倒数。"
          }
        ]
      }
