          },
          {
            "id": "C",
            "text": "$5^x=((4/5)\\cdot1.25)^{10}$ 的根是 $0$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$3^x=1/\\sqrt[3]{9}$ 的根是 $-3/2$。",
            "figure_ids": []
          },
