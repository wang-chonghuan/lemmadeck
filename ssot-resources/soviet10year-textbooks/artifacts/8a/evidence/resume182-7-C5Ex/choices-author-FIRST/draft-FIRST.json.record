        "options": [
          {
            "id": "A",
            "text": "$3^x=1/\\sqrt[3]{9}$ 的根是 $-2/3$；$7^x=1/\\sqrt[5]{7}$ 的根是 $-1/5$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$0.4^x=6\\frac14$ 的根是 $-2$；$0.2^x=125$ 的根是 $-3$。",
