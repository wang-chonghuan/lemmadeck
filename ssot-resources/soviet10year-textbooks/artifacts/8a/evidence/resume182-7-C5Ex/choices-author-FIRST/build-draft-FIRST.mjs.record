import fs from 'node:fs'
import crypto from 'node:crypto'
import { spawnSync } from 'node:child_process'

const root = '/Users/yong/work/lemmadeck-ws/lemmadeck--STEMROBIN-182'
if (process.cwd() !== root) throw new Error('wrong cwd')
const own = '.tmp/ld-s10y-lesson/resume182-7-C5Ex/choices-author-FIRST'
const R = String.raw
const hash = p => crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex')
const canonicalHash = v => {
  const stable = x => Array.isArray(x) ? x.map(stable) : x && typeof x === 'object'
    ? Object.fromEntries(Object.keys(x).sort().map(k => [k, stable(x[k])])) : x
  // Python's ensure_ascii=True is the authoritative canonical digest.
  const r = spawnSync('python3', ['.agents/skills/ld-s10y-choice/scripts/prepare.py', 'digest', v], { cwd: root, encoding: 'utf8' })
  if (r.status) throw new Error(r.stderr)
  return r.stdout.trim()
}
const seed = JSON.parse(fs.readFileSync(`${own}/seed-FIRST.json`, 'utf8'))
const recordPath = `${own}/author-source-solutions-FIRST.record0444`
if ((fs.statSync(recordPath).mode & 0o777) !== 0o444) throw new Error('solve record not frozen')
const solving = fs.readFileSync(recordPath, 'utf8')
const solutions = Object.fromEntries([...solving.matchAll(/^(\d{3})\. ([\s\S]*?)(?=^\d{3}\. |^Freeze boundary:|$(?![\s\S]))/gm)].map(m => [m[1], m[2].trim()]))
if (Object.keys(solutions).length !== 43) throw new Error('need all 43 independently solved sources')
const seedHash = canonicalHash(`${own}/seed-FIRST.json`)
const observed = JSON.parse(fs.readFileSync(`${own}/actual-image-count-FIRST.json`, 'utf8'))
if (observed.actual_payload_count !== 8) throw new Error('expected one source, one modern, six new previews')
const observations = Object.fromEntries(observed.loads.filter(x => x.figure_id).map(x => [x.figure_id, x.observation]))
const G = 'fig-choice-growth-FIRST'
const D = 'fig-choice-decay-FIRST'
const X = 'fig-choice-intersections-FIRST'
const F = 'fig-choice-floor-functions-FIRST'
const P = 'fig-choice-floor-regions-FIRST'
const T = 'fig-choice-decimal-graph-FIRST'
const floor = R`约定 $[t]$ 是不大于实数 $t$ 的最大整数，$\{t\}=t-[t]$。`
const recognition = '选择只能显示识别与判断，不能证明学习者能独立写出推导或结果。'
const plotting = '以可见完成图的识别代替亲自绘图；不能检验取点、描线、阴影及端点标记的生产能力。'
const floorCondition = '本课正文为空；地板/小数部分定义是显式新增条件，不冒充已给出的原课定义。'
const C = (text, derivation) => ({ text, truth: 'correct', derivation, misconception: null })
const I = (text, derivation, misconception) => ({ text, truth: 'incorrect', derivation, misconception })
const questions = [], questionUnits = []
function q(id, numbers, mode, stem, opts, reason, figures = [], losses = [], units = null) {
  const nums = numbers.map(String)
  const allFigures = [...new Set([...figures, ...nums.flatMap(n => seed.exercises.find(e => e.number === n).figure_ids)])]
  const options = opts.map((o, i) => ({ id: String.fromCharCode(65 + i), text: o.text, figure_ids: [] }))
  const correct = opts.flatMap((o, i) => o.truth === 'correct' ? [options[i].id] : [])
  if ((mode === 'single' && correct.length !== 1) || !correct.length) throw new Error(`bad native mode: ${id}`)
  questions.push({
    id, source_numbers: nums,
    view: { mode, stem, figure_ids: figures, options },
    intent: {
      task: nums.map(n => `${n}: ${solutions[n].split('\n')[0]}`).join(' '),
      source_solution: nums.map(n => `${n}. ${solutions[n]}`).join('\n\n'),
      unit_reason: reason, concept_blocks: [], limitations: [recognition, ...losses],
      figure_observations: allFigures.map(figure_id => {
        if (!observations[figure_id]) throw new Error(`actual observation missing ${figure_id}`)
        return { figure_id, observation: observations[figure_id] }
      }),
    },
    key: {
      correct,
      rationales: opts.map((o, i) => ({ option_id: options[i].id, truth: o.truth, derivation: o.derivation, misconception: o.misconception })),
    },
  })
  questionUnits.push({ question_id: id, source_units: units || Object.fromEntries(nums.map(n => [n, sourceUnits[n]])) })
}

