  p = panel(s, 2, 'C: negative-x window', 'solid: 2^x; dashed: x^2 - 2', [-2, 0, -2, 4], [.1, 1])
  p.curve('exponential', x => 2 ** x); p.curve('parabola', x => x * x - 2, 2)
