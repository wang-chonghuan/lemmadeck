  p.segment('right', [2, 2], [2, 3], 2); p.segment('top', [1, 3], [2, 3], 2)
  p.point('corner-in', [1, 2]); p.point('corner-right', [2, 2], true)
  p.point('corner-top', [1, 3], true); p.point('corner-topright', [2, 3], true)
