  ;[2, 4, 6, 8].forEach(v => p.ytick(v))
  p = panel(s, 1, 'B', 'solid: 2^x; dashed: 1.5^x', [-2, 3, 0, 8], [1, 1])
  p.curve('two', x => 2 ** x); p.curve('one-half', x => 1.5 ** x, 2)
  ;[-2, -1, 0, 1, 2, 3].forEach(v => p.xtick(v)); [2, 4, 6, 8].forEach(v => p.ytick(v))
  p = panel(s, 2, 'C', 'solid: 2^x; dashed: y = 2', [-2, 3, 0, 8], [1, 1])
  p.curve('two', x => 2 ** x); p.curve('constant', () => 2, 2)
  ;[-2, -1, 0, 1, 2, 3].forEach(v => p.xtick(v)); [2, 4, 6, 8].forEach(v => p.ytick(v))
  p = panel(s, 3, 'D', 'solid: (1/2)^x; dashed: y = 1/2', [-2, 3, 0, 4], [1, .5])
  p.curve('half', x => .5 ** x); p.curve('constant', () => .5, 2)
  ;[-2, -1, 0, 1, 2, 3].forEach(v => p.xtick(v)); [.5, 2, 4].forEach(v => p.ytick(v))
  inventory(s, ['Exact increasing base-2 curve and increment coordinate grid.', 'Two specified increasing curves on a common grid.', 'Representative increasing exponential and its constant-base line.', 'Representative decreasing exponential and its constant-base line.'])
  all.push(s)
