  p = panel(s, 3, 'D: positive-x window', 'solid: 2^x; dashed: x^2 - 2', [2, 4, 2, 18], [.25, 2])
  p.curve('exponential', x => 2 ** x); p.curve('parabola', x => x * x - 2, 2)
