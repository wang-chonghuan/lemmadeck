    'New conceptual graph candidates, conditional on visible [x]=floor(x), {x}=x-floor(x). A is the complete diagonal y=x; B is the complete horizontal y=0, each continued beyond the viewport. These match mathematical definitions, not a source image. The candidate contains no holes at integers.')
  let p = panel(s, 0, 'A', 'candidate graph', [-2, 2, -2, 2], [1, 1])
  p.curve('diagonal', x => x)
  ;[-2, -1, 0, 1, 2].forEach(v => p.xtick(v)); [-2, -1, 1, 2].forEach(v => p.ytick(v))
  p = panel(s, 1, 'B', 'candidate graph', [-2, 2, -2, 2], [1, 1])
  p.curve('horizontal', () => 0)
