import fs from 'node:fs'
import crypto from 'node:crypto'
import { spawnSync } from 'node:child_process'
import { chromium } from '../../../../.agents/skills/node_modules/playwright-core/index.mjs'

const root = '/Users/yong/work/lemmadeck-ws/lemmadeck--STEMROBIN-182'
if (process.cwd() !== root) throw new Error('wrong cwd')
const own = '.tmp/ld-s10y-lesson/resume182-7-C5Ex/choices-author-FIRST'
const seed = JSON.parse(fs.readFileSync(`${own}/seed-FIRST.json`, 'utf8'))
const hash = p => crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex')
const sourceText = numbers => numbers.map(n => ({
  lesson: 'alg8-c5-ex', exercise: String(n),
  text: seed.exercises.find(e => e.number === String(n)).text,
}))
const writeNew = (p, data) => fs.writeFileSync(p, JSON.stringify(data, null, 2) + '\n', { flag: 'wx' })

function figure(id, numbers, count, basis) {
  const height = count * 390
  return {
    schema: 'ld-s10y-image/figure-spec@2', id, mode: 'deterministic',
    description: basis,
    source: { authoredBasis: basis, authoritativeText: sourceText(numbers), inventory: [] },
    canvas: { width: 640, height, boundingBox: [0, height, 640, 0], background: 'paper', keepAspectRatio: false },
    display: { purpose: 'instructional', layout: 'scroll', minTextPx: 16, widths: [640] },
    objects: [], assertions: [],
  }
}

function panel(s, index, title, legend, box, steps, plotHeight = 255) {
  const h = s.canvas.height, top = index * 390 + 95
  const [xmin, xmax, ymin, ymax] = box
  const x = v => 95 + (v - xmin) * 440 / (xmax - xmin)
  const y = v => h - top - plotHeight + (v - ymin) * plotHeight / (ymax - ymin)
  const prefix = `panel-${index}`
  const text = (id, X, Y, str, size = 19) => s.objects.push({
    id, type: 'text', at: [X, Y], text: str, fontSize: size,
    labelPlacement: { position: 'CENTER', offset: [0, 0] }, stroke: 'ink',
  })
  text(`${prefix}-title`, 320, h - index * 390 - 25, title, 20)
  text(`${prefix}-legend`, 320, h - index * 390 - 58, legend, 19)
  s.objects.push({
    id: `${prefix}-grid`, type: 'grid', bounds: [x(xmin), y(ymax), x(xmax), y(ymin)],
    xStep: steps[0] * 440 / (xmax - xmin), yStep: steps[1] * plotHeight / (ymax - ymin),
    xOffset: x(xmin), yOffset: y(ymin), stroke: 'grid', strokeWidth: 1,
  })
  s.assertions.push({
    id: `${prefix}-grid-count`, type: 'gridDimensions', grid: `${prefix}-grid`,
    columns: Math.round((xmax - xmin) / steps[0]), rows: Math.round((ymax - ymin) / steps[1]),
  })
  s.objects.push({ id: `${prefix}-xaxis`, type: 'segment', from: [x(xmin), y(Math.max(ymin, Math.min(ymax, 0)))], to: [x(xmax), y(Math.max(ymin, Math.min(ymax, 0)))], stroke: 'muted', strokeWidth: 1.5 })
  s.objects.push({ id: `${prefix}-yaxis`, type: 'segment', from: [x(Math.max(xmin, Math.min(xmax, 0))), y(ymin)], to: [x(Math.max(xmin, Math.min(xmax, 0))), y(ymax)], stroke: 'muted', strokeWidth: 1.5 })
  const xtick = (v, label = String(v)) => text(`${prefix}-xtick-${String(v).replace('.', 'p')}`, x(v), y(ymin) - 20, label, 18)
  const ytick = (v, label = String(v)) => text(`${prefix}-ytick-${String(v).replace('.', 'p')}`, 58, y(v), label, 18)
  text(`${prefix}-xlabel`, 565, y(ymin) - 20, 'x', 19)
  text(`${prefix}-ylabel`, 58, y(ymax) + 48, 'y', 19)
  const curve = (tag, fn, dash = 0) => {
    let data = '', drawing = false
    for (let i = 0; i <= 1000; i++) {
      const t = xmin + (xmax - xmin) * i / 1000, value = fn(t)
      if (value < ymin || value > ymax || !Number.isFinite(value)) { drawing = false; continue }
      data += `${drawing ? 'L' : 'M'}${x(t).toFixed(5)},${(h - y(value)).toFixed(5)} `
      drawing = true
    }
    s.objects.push({ id: `${prefix}-${tag}`, type: 'svgPath', d: data.trim(), stroke: 'ink', strokeWidth: 2.5, dash })
    const samples = [xmin, (xmin + xmax) / 2, xmax].filter(t => fn(t) >= ymin && fn(t) <= ymax)
    samples.forEach((t, j) => {
      const p = `${prefix}-${tag}-sample-${j}`
      s.objects.push({ id: p, type: 'point', at: [x(t), y(fn(t))], visible: false })
      s.assertions.push({ id: `${p}-location`, type: 'displacement', from: [0, 0], to: p, dx: x(t), dy: y(fn(t)) })
    })
  }
  const segment = (tag, p, q, dash = 0, strokeWidth = 2.5) => s.objects.push({
    id: `${prefix}-${tag}`, type: 'segment', from: [x(p[0]), y(p[1])], to: [x(q[0]), y(q[1])], stroke: 'ink', strokeWidth, dash,
  })
  const point = (tag, p, open = false) => s.objects.push({
    id: `${prefix}-${tag}`, type: 'point', at: [x(p[0]), y(p[1])], size: 4,
    fill: open ? 'paper' : 'ink', stroke: 'ink', strokeWidth: 2,
  })
  const region = (tag, xmin1, xmax1, ymin1, ymax1) => s.objects.push({
    id: `${prefix}-${tag}`, type: 'polygon',
    points: [[x(xmin1), y(ymin1)], [x(xmax1), y(ymin1)], [x(xmax1), y(ymax1)], [x(xmin1), y(ymax1)]],
    fill: 'accentSoft', fillOpacity: 0.25, strokeWidth: 0, stroke: 'paper',
  })
  return { x, y, text, xtick, ytick, curve, segment, point, region, prefix }
}

function inventory(s, descriptions) {
  descriptions.forEach((description, i) => {
    const prefix = `panel-${i}`
    const visiblePoints = s.objects.filter(o => o.id.startsWith(`${prefix}-`) && o.type === 'point' && o.visible !== false)
    if (visiblePoints.length > 1) {
      const anchor = visiblePoints[0]
      visiblePoints.slice(1).forEach(p => s.assertions.push({
        id: `${p.id}-relative-position`, type: 'displacement', from: anchor.id, to: p.id,
        dx: p.at[0] - anchor.at[0], dy: p.at[1] - anchor.at[1],
      }))
    }
    s.source.inventory.push({
      id: `${prefix}-authored-requirements`, description,
      objects: s.objects.filter(o => o.id.startsWith(`${prefix}-`) && o.visible !== false).map(o => o.id),
      assertions: s.assertions.filter(a => a.id.startsWith(`${prefix}-`)).map(a => a.id),
      requires: visiblePoints.length > 1 ? ['gridDimensions', 'pointRelationships'] : ['gridDimensions'],
    })
  })
  s.assertions.push({ id: 'all-authored-curves', type: 'objectCount', objectType: 'svgPath', count: s.objects.filter(o => o.type === 'svgPath').length })
}

const all = []
