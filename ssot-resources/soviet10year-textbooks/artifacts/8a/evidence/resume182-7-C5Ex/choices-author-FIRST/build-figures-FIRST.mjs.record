{
  const s = figure('fig-choice-floor-regions-FIRST', [720, 721], 4,
    'Authored plane-set candidates conditional on visible floor definition: A shades [0,1) times R, B shades R times [1,2), C shades [1,2) times [2,3), D shades the diagonal unit tiles [n,n+1) times [n,n+1), n integer. Solid edges are included; dashed edges excluded; filled/open corner dots resolve corner membership. Shading reaches the plot-window edge for unbounded sets; viewport borders are not set boundaries. All n tiles repeat beyond the view. No source image exists; inventory is conceptual, not pixel provenance.')
  s.canvas.height += 24
  s.canvas.boundingBox[1] += 24
  let p = panel(s, 0, 'A', 'solid included; dashed excluded', [-1, 3, -1, 4], [1, 1])
  p.region('vertical-region', 0, 1, -1, 4)
  p.segment('left', [0, -1], [0, 4]); p.segment('right', [1, -1], [1, 4], 2)
  ;[-1, 0, 1, 2, 3].forEach(v => p.xtick(v)); [0, 2, 4].forEach(v => p.ytick(v))
  p = panel(s, 1, 'B', 'solid included; dashed excluded', [-1, 3, -1, 4], [1, 1])
  p.region('horizontal-region', -1, 3, 1, 2)
  p.segment('bottom', [-1, 1], [3, 1]); p.segment('top', [-1, 2], [3, 2], 2)
  ;[-1, 0, 1, 2, 3].forEach(v => p.xtick(v)); [0, 2, 4].forEach(v => p.ytick(v))
  p = panel(s, 2, 'C', 'solid included; dashed excluded', [-1, 3, -1, 4], [1, 1])
