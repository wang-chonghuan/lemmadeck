if (process.argv[2].startsWith('repair-regions') || process.argv[2] === 'repair-decimal') {
  const s = all.find(s => s.id === (process.argv[2] === 'repair-decimal' ? 'fig-choice-decimal-graph-FIRST' : 'fig-choice-floor-regions-FIRST'))
  const base = `${own}/figures/${s.id}`
  for (const suffix of ['spec.json', 'svg', 'render.json']) {
    fs.copyFileSync(`${base}.${suffix}`, `${base}.before-${process.argv[2]}.${suffix}`, fs.constants.COPYFILE_EXCL)
  }
  fs.writeFileSync(`${base}.spec.json`, JSON.stringify(s, null, 2) + '\n')
} else if (process.argv[2].startsWith('repair-specs')) {
  all.forEach(s => {
    const p = `${own}/figures/${s.id}.spec.json`
    fs.copyFileSync(p, `${own}/figures/${s.id}.spec-before-${process.argv[2]}.json`, fs.constants.COPYFILE_EXCL)
    fs.writeFileSync(p, JSON.stringify(s, null, 2) + '\n')
  })
  for (const suffix of ['svg', 'render.json']) {
    const p = `${own}/figures/fig-choice-growth-FIRST.${suffix}`
    if (fs.existsSync(p)) fs.copyFileSync(p, `${own}/figures/fig-choice-growth-FIRST.before-${process.argv[2]}.${suffix}`, fs.constants.COPYFILE_EXCL)
  }
} else if (process.argv[2] === 'specs') {
  fs.mkdirSync(`${own}/figures`, { recursive: true })
  all.forEach(s => writeNew(`${own}/figures/${s.id}.spec.json`, s))
  writeNew(`${own}/figure-authoring-provenance-FIRST.json`, {
    source_pixels: false,
    source_object_inventory_kind: 'conceptual_dependency',
    source_seed_sha256: '5ae53656673d12bc528e3aca6a5181e165ef847d3b724a683ebe6fb62224e0d0',
    independently_solved_record: `${own}/author-source-solutions-FIRST.record0444`,
    source_solution_file_sha256: hash(`${own}/author-source-solutions-FIRST.record0444`),
    figures: all.map(s => ({ id: s.id, spec: `${own}/figures/${s.id}.spec.json`, original_image: null, authored_basis: s.source.authoredBasis, related_full_tasks: s.source.authoritativeText.map(t => t.exercise) })),
    independent_review: 'not performed; parent-authorized sole reviewer pending',
  })
} else if (process.argv[2].startsWith('render')) {
  const executions = []
  for (const s of all) {
    const base = `${own}/figures/${s.id}`
    if (process.argv[2].startsWith('render-remaining') && fs.existsSync(`${base}.render.json`)) {
      const previous = JSON.parse(fs.readFileSync(`${base}.render.json`, 'utf8'))
      if (previous.status === 'pass' && previous.spec.sha256 === hash(`${base}.spec.json`)) {
        executions.push({ reused:true, spec:`${base}.spec.json`, prior_report:`${base}.render.json`, exitCode:0 })
        continue
      }
    }
    const argv = ['.agents/skills/ld-s10y-image/scripts/render_spec.mjs', '--spec', `${base}.spec.json`, '--svg', `${base}.svg`, '--png', `${base}.preview.png`, '--report', `${base}.render.json`]
    const r = spawnSync('node', argv, { cwd: root, encoding: 'utf8' })
    executions.push({ cwd: root, command: 'node', argv, exitCode: r.status, stdout: r.stdout, stderr: r.stderr })
    if (r.status !== 0) break
  }
  writeNew(`${own}/figure-${process.argv[2]}-executions-FIRST.json`, executions)
  console.log(JSON.stringify(executions.map(e => ({ spec: e.spec || e.argv[2], reused:e.reused || false, exitCode: e.exitCode, stdout: e.stdout, stderr: e.stderr })), null, 2))
  if (executions.length !== all.length || executions.some(e => e.exitCode !== 0)) process.exitCode = 2
} else if (process.argv[2] === 'modern-preview') {
  const executable = '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
  const browser = await chromium.launch({ executablePath: executable, headless: true })
  try {
    const page = await browser.newPage({ viewport: { width: 640, height: 1400 } })
    const svg = fs.readFileSync(seed.figures[0].assets[0].path, 'utf8')
    await page.setContent(`<html><body style="margin:0;background:white">${svg}</body></html>`)
    const dimensions = await page.locator('svg').evaluate(el => {
      const vb = el.viewBox.baseVal
      el.setAttribute('width', '640')
      el.setAttribute('height', String(640 * vb.height / vb.width))
      return { width: 640, height: Math.ceil(640 * vb.height / vb.width) }
    })
    await page.setViewportSize(dimensions)
    await page.screenshot({ path: `${own}/fig-76-modern-preview-FIRST.png`, fullPage: true })
    console.log(JSON.stringify({ actual_asset: seed.figures[0].assets[0], dimensions, preview: `${own}/fig-76-modern-preview-FIRST.png`, action: 'read-only complete SVG rendering; no regeneration or review' }))
  } finally { await browser.close() }
} else throw new Error('use specs, render, or modern-preview')
