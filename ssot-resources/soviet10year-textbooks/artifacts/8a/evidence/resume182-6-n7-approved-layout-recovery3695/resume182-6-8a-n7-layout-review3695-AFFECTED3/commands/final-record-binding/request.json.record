    "const fs=require(\"node:fs\"),crypto=require(\"node:crypto\"),path=require(\"node:path\"),assert=require(\"node:assert/strict\");const root=process.cwd();const recordPath=path.resolve(\".tmp/resume182-6-8a-n7-layout-review3695-AFFECTED3/review.record\");const bytes=fs.readFileSync(recordPath),r=JSON.parse(bytes);const sha=b=>crypto.createHash(\"sha256\").update(b).digest(\"hex\");let boundFiles=0;function verify(o){if(!o||typeof o!==\"object\")return;if(typeof o.path===\"string\"&&typeof o.sha256===\"string\"){assert.ok(path.isAbsolute(o.path));assert.ok(o.path.startsWith(root+\"/\"));assert.equal(sha(fs.readFileSync(o.path)),o.sha256);boundFiles++;}for(const v of Object.values(o))verify(v);}verify(r);assert.equal(r.status,\"TEXT_PASS\");assert.equal(r.TEXT_PASS,true);assert.equal(r.wholeLessonApproval,false);assert.equal(r.book,\"8a\");assert.equal(r.lesson,\"alg8-c2-s1-n7\");assert.equal(r.edition,\"modern-us-neutral\");for(const k of [\"newImageReviews\",\"newSourceReviews\",\"newMathReviews\",\"flowCalls\",\"normalizerCalls\",\"finalizerCalls\",\"DBReads\",\"DBWrites\",\"PlaneCalls\",\"gitCalls\",\"otherChatCalls\"])assert.equal(r[k],0);assert.equal(r.totalCost,\"unknown\");const evidence=JSON.parse(fs.readFileSync(r.evidence.path));assert.equal(evidence.status,\"MECHANICAL_PASS\");assert.ok(evidence.checks.every(c=>c.pass));const candidate=JSON.parse(fs.readFileSync(r.candidate.path)),flow=JSON.parse(fs.readFileSync(r.sectionBreakReview.savedOfficialFlow.path));for(const b of r.sectionBreakReview.bindings){const a=candidate.section_breaks[b.sectionBreakIndex],before=flow.paragraphs[b.beforeParagraphIndex],after=flow.paragraphs[b.afterParagraphIndex];assert.equal(b.afterParagraphIndex,b.beforeParagraphIndex+1);assert.equal(before.text,a.before);assert.equal(after.text,a.after);assert.equal(before.blockIndex,b.beforeBlockIndex);assert.equal(after.blockIndex,b.afterBlockIndex);}console.log(JSON.stringify({status:\"TEXT_PASS\",review:{path:recordPath,sha256:sha(bytes)},candidate:r.candidate,boundFilesVerified:boundFiles,newImageReviews:0,newSourceReviews:0,newMathReviews:0,wholeLessonApproval:false,totalCost:\"unknown\"},null,2));"
