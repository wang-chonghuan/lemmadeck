    "import fs from \"node:fs\"; import crypto from \"node:crypto\"; import assert from \"node:assert/strict\"; const root=process.cwd(); const d=\".tmp/resume182-6-8a-n10-choice-author3695-FIRST\"; const sha=p=>crypto.createHash(\"sha256\").update(fs.readFileSync(p)).digest(\"hex\"); const ready=JSON.parse(fs.readFileSync(`${d}/ready.record`,\"utf8\")); for(const artifact of Object.values(ready.artifacts)) assert.equal(sha(artifact.path),artifact.path_sha256); const sort=v=>Array.isArray(v)?v.map(sort):v!==null&&typeof v===\"object\"?Object.fromEntries(Object.keys(v).sort().map(k=>[k,sort(v[k])])):v; const digest=v=>crypto.createHash(\"sha256\").update(JSON.stringify(sort(v)).replace(/[\\u007f-\\uffff]/g,c=>`\\\\u${c.charCodeAt(0).toString(16).padStart(4,\"0\")}`)).digest(\"hex\"); for(const name of [\"seed\",\"draft\"]){const a=ready.artifacts[name]; const value=JSON.parse(fs.readFileSync(a.path,\"utf8\")); const canonical=JSON.stringify(sort(value)).replace(/[\\x7f-\\uffff]/g,c=>\"\\\\u\"+c.charCodeAt(0).toString(16).padStart(4,\"0\")); const actual=crypto.createHash(\"sha256\").update(canonical).digest(\"hex\"); assert.equal(actual,a.canonical_digest); console.log(JSON.stringify({artifact:name,path:a.path,path_sha256:sha(a.path),canonical_digest:actual}));} for(const f of ready.figure_views){assert.equal(sha(f.actual_view_path),f.actual_view_sha256); assert.equal(sha(f.svg_byte_identity.scratch_path),f.svg_byte_identity.scratch_sha256); assert.equal(sha(f.svg_byte_identity.durable_path),f.svg_byte_identity.durable_sha256);} const receipts=fs.readdirSync(d,{withFileTypes:true}).filter(e=>e.isDirectory()).map(e=>`${d}/${e.name}/receipt.record`).filter(p=>fs.existsSync(p)).map(p=>JSON.parse(fs.readFileSync(p,\"utf8\"))); assert.equal(receipts.length,17); for(const r of receipts){assert.equal(r.cwd,root); assert.equal(r.returncode,0); assert.equal(r.signal,null); assert.equal(r.error,null);} assert.equal(ready.status,\"AUTHOR_READY_NOT_APPROVAL\"); console.log(JSON.stringify({ready_path:`${root}/${d}/ready.record`,ready_path_sha256:sha(`${d}/ready.record`),receipt_count_before_this_seal:receipts.length,receipt_count_on_successful_seal_completion:18,failures:[],questions:ready.coverage.question_count,covered_seeds:ready.coverage.covered_seed_count,status:ready.status,cost:ready.cost,images_viewed:ready.counters.image_view_calls}));"
