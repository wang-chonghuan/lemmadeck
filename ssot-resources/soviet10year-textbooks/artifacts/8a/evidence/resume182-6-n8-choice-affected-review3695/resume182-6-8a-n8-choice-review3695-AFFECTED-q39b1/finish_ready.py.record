path = W / "ready.record"
with path.open("x", encoding="utf-8") as stream:
    json.dump(ready, stream, ensure_ascii=True, indent=2)
    stream.write("\n")
sealed = bind(path)
print(json.dumps(
    {
        "ready": sealed,
        "status": ready["status"],
        "counts": ready["counts"],
        "actual_failures": {
            "current": "1 recovered StopIteration selector failure, exec-011 retained",
            "FIRST": "2 retained failures: semantic validator exit 3 and finish-parser exit 1",
