import hashlib
import json
from pathlib import Path

R = Path("/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck")
W = R / ".tmp/resume182-6-8a-n8-choice-review3695-AFFECTED-q39b1"
assert Path.cwd() == R


def load(path):
    return json.loads(path.read_bytes())


def bind(path, expected=None):
    data = path.read_bytes()
    actual = hashlib.sha256(data).hexdigest()
    if expected is not None:
        assert actual == expected, (str(path), actual, expected)
    return {"path": str(path), "sha256": actual, "bytes": len(data)}


def parse_receipt(path):
    result = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        if ": " in line and not line.startswith("/"):
            key, value = line.split(": ", 1)
            result[key] = value
    assert result["workdir"] == str(R), path
    assert "exit_code" in result, path
    result["exit_code"] = int(result["exit_code"])
    result["receipt"] = bind(path)
    for key in ("stdout_artifact", "stderr_artifact"):
        if key in result:
            result[key] = bind(W / result[key])
    return result


affected = load(W / "affected-review.record")
proof = load(W / "combination-proof.record")
for value in affected["inputs"].values():
    bind(Path(value["path"]), value["sha256"])
for name in ("affected_review", "review", "draft", "seed", "original_review"):
    bind(Path(proof[name]["path"]), proof[name]["sha256"])
for failure in affected["FIRST_failures"]["command_failures"]:
    bind(Path(failure["receipt"]["path"]), failure["receipt"]["sha256"])

review = load(W / "review.json")
assert review["outcome"] == "pass"
assert review["draft_sha256"] == proof["draft"]["canonical_sha256"]
assert review["seed_sha256"] == proof["seed"]["canonical_sha256"]
assert proof["originals_and_FIRST_failed_receipts_unchanged"] is True
assert len(review["source_reviews"]) == 15
assert len(review["question_reviews"]) == 41
assert sum(len(item["mathematics"]["option_checks"]) for item in review["question_reviews"]) == 126
assert all(item["coverage"]["verdict"] == "pass" for item in review["source_reviews"])
assert all(
    item[field]["verdict"] == "pass"
    for item in review["question_reviews"]
    for field in ("mathematics", "task_fidelity", "redundancy", "answer_leakage")
)

receipts = [
    parse_receipt(W / f"exec-{index:03d}.record") for index in range(1, 16)
]
failures = [item for item in receipts if item["exit_code"] != 0]
