  "stdout": "{\n  \"schema\": \"ld-s10y-image/figure-spec@2\",\n  \"id\": \"fig-14\",\n  \"book\": null,\n  \"edition\": null,\n  \"mode\": \"deterministic\",\n  \"canvas\": {\n    \"width\": 1280,\n    \"height\": 520,\n    \"boundingBox\": [\n      -20,\n      8.125,\n      20,\n      -8.125\n    ],\n    \"background\": \"paper\",\n    \"keepAspectRatio\": true\n  },\n  \"display\": {\n    \"layout\": \"scroll\",\n    \"purpose\": \"instructional\",\n    \"minTextPx\": 16,\n    \"widths\": [\n      640\n    ]\n  },\n  \"source\": {\n    \"image\": {\n      \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/ssot-resources/soviet10year-textbooks/artifacts/8a/figures/fig-14.png\",\n      \"sha256\": \"c2d2f17ea8f6f19adf4f617e29b6cfad17833f79ecc18496ad587cdba984df05\"\n    },\n    \"authoritativeText\": [\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u5728\u56fe14\u4e2d\u753b\u51fa\u4e86\u65b9\u7a0b$x^2+9y^2=81$\u7684\u56fe\u8c61\uff0c\u8fd9\u79cd\u5f62\u5f0f\u7684\u66f2\u7ebf\u53eb\u505a\u692d\u5706.\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u6bcf\u4e00\u4e2a\u542b\u4e24\u4e2a\u53d8\u91cf$x$\u548c$y$\u7684\u65b9\u7a0b\uff0c\u90fd\u786e\u5b9a\u67d0\u4e00\u4e2a\u4f5c\u4e3a\u8fd9\u4e2a\u65b9\u7a0b\u7684\u89e3\u7684\u53d8\u91cf\u53d6\u503c\u6570\u5bf9$(x,y)$\u7684\u96c6\u5408\uff0c\u4e5f\u5c31\u662f\u90fd\u5728\u53d8\u91cf$x$\u7684\u503c\u548c\u53d8\u91cf$y$\u7684\u503c\u4e4b\u95f4\u5efa\u7acb\u67d0\u79cd\u5173\u7cfb. \u5927\u5bb6\u77e5\u9053\uff0c\u4e8c\u5143\u65b9\u7a0b\u7ed9\u51fa\u7684\u5173\u7cfb\u7684\u56fe\u8c61\uff0c\u6216\u7b80\u79f0\u4e3a\u4e8c\u5143\u65b9\u7a0b\u7684\u56fe\u8c61\uff0c\u662f\u4ee5\u8fd9\u4e2a\u65b9\u7a0b\u7684\u89e3\u4e3a\u5750\u6807\u7684\u5e73\u9762\u4e0a\u70b9\u7684\u96c6\u5408.\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u6211\u4eec\u77e5\u9053\uff0c$ax+by=c(a\\\\ne0$\u6216$b\\\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\u7684\u56fe\u8c61\u662f\u76f4\u7ebf\uff0c$y=ax^2+bx+c(a\\\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\u7684\u56fe\u8c61\u662f\u629b\u7269\u7ebf\uff0c$xy=k(k\\\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\u7684\u56fe\u8c61\u662f\u53cc\u66f2\u7ebf.\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u56fe14\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u6211\u4eec\u6765\u770b\u56fe15\uff0c\u56fe\u4e2d\u753b\u51fa\u4e86\u5706\u5fc3\u5728\u5750\u6807\u539f\u70b9\u3001\u534a\u5f84\u4e3a5\u4e2a\u5355\u4f4d\u957f\u7684\u5706\u5468. \u6211\u4eec\u6765\u6c42\u56fe\u8c61\u662f\u8fd9\u4e2a\u5706\u5468\u7684\u65b9\u7a0b.\"\n      }\n    ],\n    \"inventory\": [\n      {\n        \"id\": \"fig-14-source-grid\",\n        \"description\": \"One rectangular coordinate grid: 39 vertical boundary/grid strokes and 13 horizontal strokes, hence 38 columns and 12 rows. Origin at the nineteenth column and sixth row. Unit markers on both axes establish one unit per cell.\",\n        \"objects\": [\n          \"fig-14-grid\",\n          \"fig-14-frame\"\n        ],\n        \"assertions\": [\n          \"fig-14-grid-38-by-12\"\n        ],\n        \"requires\": [\n          \"gridDimensions\"\n        ]\n      },\n      {\n        \"id\": \"fig-14-source-axes-labels\",\n        \"description\": \"Horizontal x axis with arrow to the right; vertical y axis with arrow upward; O at their intersection; unit 1 by each positive axis; equation label to the upper right of the ellipse. Source contains no numeric extrema labels.\",\n        \"objects\": [\n          \"fig-14-x-axis\",\n          \"fig-14-y-axis\",\n          \"fig-14-origin-text\",\n          \"fig-14-x-label\",\n          \"fig-14-y-label\",\n          \"fig-14-x-unit-label\",\n          \"fig-14-y-unit-label\"\n        ],\n        \"assertions\": [\n          \"fig-14-x-axis-extent\",\n          \"fig-14-y-axis-extent\",\n          \"fig-14-axes-perpendicular\"\n        ]\n      },\n      {\n        \"id\": \"fig-14-source-ellipse\",\n        \"description\": \"A continuous closed, horizontally elongated ellipse centered at O. The visible extreme intersections are (-9,0), (9,0), (0,3), (0,-3). No defining vertex markers or construction points are source ink. Unmarked extrema and O use explicitly hidden construction anchors. They are not claimed as visible source-point objects. Their displacement assertions still enforce the source-bound extrema; the visible curve and equation are the mapped ink.\",\n        \"objects\": [\n          \"fig-14-ellipse\",\n          \"fig-14-equation-label\"\n        ],\n        \"assertions\": [\n          \"fig-14-one-ellipse\",\n          \"fig-14-origin-to-left\",\n          \"fig-14-origin-to-right\",\n          \"fig-14-origin-to-top\",\n          \"fig-14-origin-to-bottom\"\n        ]\n      }\n    ]\n  },\n  \"objects\": [\n    {\n      \"id\": \"fig-14-grid\",\n      \"type\": \"grid\",\n      \"bounds\": [\n        -19,\n        6,\n        19,\n        -6\n      ],\n      \"xStep\": 1,\n      \"yStep\": 1,\n      \"xOffset\": 0,\n      \"yOffset\": 0,\n      \"stroke\": \"grid\",\n      \"strokeWidth\": 1\n    },\n    {\n      \"id\": \"fig-14-frame\",\n      \"type\": \"polygon\",\n      \"points\": [\n        [\n          -19,\n          6\n        ],\n        [\n          19,\n          6\n        ],\n        [\n          19,\n          -6\n        ],\n        [\n          -19,\n          -6\n        ]\n      ],\n      \"stroke\": \"ink\",\n      \"strokeWidth\": 1.5,\n      \"fill\": \"paper\",\n      \"fillOpacity\": 0\n    },\n    {\n      \"id\": \"fig-14-x-axis\",\n      \"type\": \"arrow\",\n      \"from\": [\n        -19,\n        0\n      ],\n      \"to\": [\n        18.7,\n        0\n      ],\n      \"stroke\": \"ink\",\n      \"strokeWidth\": 2.5\n    },\n    {\n      \"id\": \"fig-14-y-axis\",\n      \"type\": \"arrow\",\n      \"from\": [\n        0,\n        -6\n      ],\n      \"to\": [\n        0,\n        5.7\n      ],\n      \"stroke\": \"ink\",\n      \"strokeWidth\": 2.5\n    },\n    {\n      \"id\": \"fig-14-ellipse\",\n      \"type\": \"svgPath\",\n      \"d\": \"M 11 8.125 A 9 3 0 1 0 29 8.125 A 9 3 0 1 0 11 8.125 Z\",\n      \"stroke\": \"accent\",\n      \"strokeWidth\": 3,\n      \"fill\": \"paper\",\n      \"fillOpacity\": 0\n    },\n    {\n      \"id\": \"fig-14-origin\",\n      \"type\": \"point\",\n      \"at\": [\n        0,\n        0\n      ],\n      \"size\": 0,\n      \"strokeWidth\": 0,\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"SW\",\n        \"offset\": [\n          -10,\n          12\n        ]\n      },\n      \"visible\": false\n    },\n    {\n      \"id\": \"fig-14-origin-text\",\n      \"type\": \"text\",\n      \"at\": [\n        0,\n        0\n      ],\n      \"text\": \"O\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"SW\",\n        \"offset\": [\n          -10,\n          12\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-14-left-extremum\",\n      \"type\": \"point\",\n      \"at\": [\n        -9,\n        0\n      ],\n      \"size\": 0,\n      \"strokeWidth\": 0,\n      \"visible\": false\n    },\n    {\n      \"id\": \"fig-14-right-extremum\",\n      \"type\": \"point\",\n      \"at\": [\n        9,\n        0\n      ],\n      \"size\": 0,\n      \"strokeWidth\": 0,\n      \"visible\": false\n    },\n    {\n      \"id\": \"fig-14-top-extremum\",\n      \"type\": \"point\",\n      \"at\": [\n        0,\n        3\n      ],\n      \"size\": 0,\n      \"strokeWidth\": 0,\n      \"visible\": false\n    },\n    {\n      \"id\": \"fig-14-bottom-extremum\",\n      \"type\": \"point\",\n      \"at\": [\n        0,\n        -3\n      ],\n      \"size\": 0,\n      \"strokeWidth\": 0,\n      \"visible\": false\n    },\n    {\n      \"id\": \"fig-14-x-label\",\n      \"type\": \"text\",\n      \"at\": [\n        18.3,\n        0\n      ],\n      \"text\": \"x\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"S\",\n        \"offset\": [\n          0,\n          10\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-14-y-label\",\n      \"type\": \"text\",\n      \"at\": [\n        0,\n        5.4\n      ],\n      \"text\": \"y\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"W\",\n        \"offset\": [\n          -8,\n          0\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-14-x-unit-label\",\n      \"type\": \"text\",\n      \"at\": [\n        1,\n        0\n      ],\n      \"text\": \"1\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"S\",\n        \"offset\": [\n          0,\n          10\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-14-y-unit-label\",\n      \"type\": \"text\",\n      \"at\": [\n        0,\n        1\n      ],\n      \"text\": \"1\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"W\",\n        \"offset\": [\n          -8,\n          0\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-14-equation-label\",\n      \"type\": \"text\",\n      \"at\": [\n        13,\n        2.3\n      ],\n      \"text\": \"x^2+9y^2=81\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\"\n    }\n  ],\n  \"assertions\": [\n    {\n      \"id\": \"fig-14-grid-38-by-12\",\n      \"type\": \"gridDimensions\",\n      \"grid\": \"fig-14-grid\",\n      \"columns\": 38,\n      \"rows\": 12\n    },\n    {\n      \"id\": \"fig-14-x-axis-extent\",\n      \"type\": \"connects\",\n      \"arrow\": \"fig-14-x-axis\",\n      \"from\": [\n        -19,\n        0\n      ],\n      \"to\": [\n        18.7,\n        0\n      ]\n    },\n    {\n      \"id\": \"fig-14-y-axis-extent\",\n      \"type\": \"connects\",\n      \"arrow\": \"fig-14-y-axis\",\n      \"from\": [\n        0,\n        -6\n      ],\n      \"to\": [\n        0,\n        5.7\n      ]\n    },\n    {\n      \"id\": \"fig-14-axes-perpendicular\",\n      \"type\": \"perpendicular\",\n      \"a\": [\n        -19,\n        0\n      ],\n      \"b\": [\n        18.7,\n        0\n      ],\n      \"c\": [\n        0,\n        -6\n      ],\n      \"d\": [\n        0,\n        5.7\n      ]\n    },\n    {\n      \"id\": \"fig-14-one-ellipse\",\n      \"type\": \"objectCount\",\n      \"objectType\": \"svgPath\",\n      \"count\": 1\n    },\n    {\n      \"id\": \"fig-14-origin-to-left\",\n      \"type\": \"displacement\",\n      \"from\": \"fig-14-origin\",\n      \"to\": \"fig-14-left-extremum\",\n      \"dx\": -9,\n      \"dy\": 0\n    },\n    {\n      \"id\": \"fig-14-origin-to-right\",\n      \"type\": \"displacement\",\n      \"from\": \"fig-14-origin\",\n      \"to\": \"fig-14-right-extremum\",\n      \"dx\": 9,\n      \"dy\": 0\n    },\n    {\n      \"id\": \"fig-14-origin-to-top\",\n      \"type\": \"displacement\",\n      \"from\": \"fig-14-origin\",\n      \"to\": \"fig-14-top-extremum\",\n      \"dx\": 0,\n      \"dy\": 3\n    },\n    {\n      \"id\": \"fig-14-origin-to-bottom\",\n      \"type\": \"displacement\",\n      \"from\": \"fig-14-origin\",\n      \"to\": \"fig-14-bottom-extremum\",\n      \"dx\": 0,\n      \"dy\": -3\n    }\n  ]\n}\n{\n  \"schema\": \"ld-s10y-image/figure-spec@2\",\n  \"id\": \"fig-15\",\n  \"book\": null,\n  \"edition\": null,\n  \"mode\": \"deterministic\",\n  \"canvas\": {\n    \"width\": 1280,\n    \"height\": 960,\n    \"boundingBox\": [\n      -10.5,\n      8,\n      10.5,\n      -7.75\n    ],\n    \"background\": \"paper\",\n    \"keepAspectRatio\": true\n  },\n  \"display\": {\n    \"layout\": \"scroll\",\n    \"purpose\": \"instructional\",\n    \"minTextPx\": 16,\n    \"widths\": [\n      640\n    ]\n  },\n  \"source\": {\n    \"image\": {\n      \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/ssot-resources/soviet10year-textbooks/artifacts/8a/figures/fig-15.png\",\n      \"sha256\": \"e5b5a48fa35691a096dc709d2860c9f266b605c112e920a42933e457a5f72595\"\n    },\n    \"authoritativeText\": [\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u6211\u4eec\u6765\u770b\u56fe15\uff0c\u56fe\u4e2d\u753b\u51fa\u4e86\u5706\u5fc3\u5728\u5750\u6807\u539f\u70b9\u3001\u534a\u5f84\u4e3a5\u4e2a\u5355\u4f4d\u957f\u7684\u5706\u5468. \u6211\u4eec\u6765\u6c42\u56fe\u8c61\u662f\u8fd9\u4e2a\u5706\u5468\u7684\u65b9\u7a0b.\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u5b9e\u9645\u4e0a\uff0c\u8bbe\u70b9$B(x_1,y_1)$\u5728\u5706\u5185\uff08\u53c2\u770b\u56fe15\uff09\uff0c\u90a3\u4e48$|OB|<5$\uff0c$x_1^2+y_1^2<5^2$.\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u4e8e\u662f\uff0c\u5f53\u4e14\u4ec5\u5f53\u5750\u6807\u4e3a$x$\u548c$y$\u7684\u70b9\u4f4d\u4e8e\u5706\u5fc3\u5728\u5750\u6807\u539f\u70b9\u3001\u534a\u5f84\u4e3a5\u4e2a\u5355\u4f4d\u957f\u7684\u5706\u5468\u4e0a\u65f6\uff0c\u7b49\u5f0f$x^2+y^2=5^2$\u6210\u7acb. \u56e0\u6b64\uff0c\u56fe15\u4e2d\u753b\u51fa\u7684\u5706\u5468\u662f\u65b9\u7a0b$x^2+y^2=5^2$\u7684\u56fe\u8c61.\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u56fe14\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u56fe15\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u8bbe\u70b9$A(x,y)$\u662f\u8fd9\u4e2a\u5706\u5468\u4e0a\u4e0d\u5728\u4e24\u4e2a\u5750\u6807\u8f74\u4e0a\u7684\u4efb\u610f\u4e00\u70b9. \u90a3\u4e48\uff0c\u5728\u76f4\u89d2\u4e09\u89d2\u5f62$OAA_1$\u4e2d\uff0c\u6839\u636e\u52fe\u80a1\u5b9a\u7406\u5f97\uff1a\\n$|OA_1|^2+|AA_1|^2=|OA|^2$.\u663e\u7136\uff0c$|OA_1|^2=x^2$\uff0c$|AA_1|^2=y^2$\uff0c$|OA|^2=5^2$. \u4e8e\u662f\uff0c\u5706\u5468\u4e0a\u4e0d\u5728\u4e24\u4e2a\u5750\u6807\u8f74\u4e0a\u7684\u4efb\u610f\u4e00\u70b9\u7684\u5750\u6807\u6ee1\u8db3\u65b9\u7a0b$x^2+y^2=5^2$\uff1a \uff081\uff09\"\n      },\n      {\n        \"lesson\": \"alg8-c2-s1-n7\",\n        \"text\": \"\u5bb9\u6613\u9a8c\u8bc1\uff0c\u5706\u5468\u4e0e$x$\u8f74\u548c$y$\u8f74\u7684\u6bcf\u4e00\u4e2a\u4ea4\u70b9\u7684\u5750\u6807\u4e5f\u6ee1\u8db3\u65b9\u7a0b\uff081\uff09. \u4f8b\u5982\uff0c\u628a\u70b9$C(0,-5)$\u7684\u5750\u6807\u4ee3\u5165\u65b9\u7a0b\uff081\uff09\uff0c\u5f97\u5230\u771f\u7b49\u5f0f\uff1a\\n$0^2+(-5)^2=5^2$.\"\n      }\n    ],\n    \"inventory\": [\n      {\n        \"id\": \"fig-15-source-grid\",\n        \"description\": \"One rectangular coordinate grid: 39 vertical boundary/grid strokes and 28 horizontal strokes, hence 38 columns and 27 rows. Two cells span the positive unit marker on each axis. Origin is at column 19 and row 14.\",\n        \"objects\": [\n          \"fig-15-grid\",\n          \"fig-15-frame\"\n        ],\n        \"assertions\": [\n          \"fig-15-grid-38-by-27\"\n        ],\n        \"requires\": [\n          \"gridDimensions\"\n        ]\n      },\n      {\n        \"id\": \"fig-15-source-axes-labels\",\n        \"description\": \"Horizontal x axis points right, y axis points up, with O and positive unit 1 labels. A, B and D use symbolic coordinate labels; C has the explicit coordinates (0,-5).\",\n        \"objects\": [\n          \"fig-15-x-axis\",\n          \"fig-15-y-axis\",\n          \"fig-15-origin\",\n          \"fig-15-x-label\",\n          \"fig-15-y-label\",\n          \"fig-15-x-unit-label\",\n          \"fig-15-y-unit-label\"\n        ],\n        \"assertions\": [\n          \"fig-15-x-axis-extent\",\n          \"fig-15-y-axis-extent\",\n          \"fig-15-axes-perpendicular\"\n        ]\n      },\n      {\n        \"id\": \"fig-15-source-circle\",\n        \"description\": \"Closed circle centered at the origin, crossing the axes at (+/-5,0) and (0,+/-5). C(0,-5) is printed at the lower crossing. The source text independently states radius five.\",\n        \"objects\": [\n          \"fig-15-circle\",\n          \"fig-15-origin\",\n          \"fig-15-C\"\n        ],\n        \"assertions\": [\n          \"fig-15-one-circle\",\n          \"fig-15-C-on-circle\",\n          \"fig-15-origin-to-C\"\n        ],\n        \"requires\": [\n          \"pointRelationships\"\n        ]\n      },\n      {\n        \"id\": \"fig-15-source-labelled-points\",\n        \"description\": \"Eight labelled locations are O, A(x,y), A1, B(x1,y1), B1, C(0,-5), D(x2,y2), D1. Grid readings locate A on the circle at (-3,4), B inside at (2.5,3), D outside below-left at (-2,-6); feet are A1(-3,0), B1(2.5,0), D1(-2,0). Numeric coordinates for A, B, D are structural measurements, not additional source labels.\",\n        \"objects\": [\n          \"fig-15-origin\",\n          \"fig-15-A\",\n          \"fig-15-B\",\n          \"fig-15-C\",\n          \"fig-15-D\",\n          \"fig-15-A1\",\n          \"fig-15-B1\",\n          \"fig-15-D1\"\n        ],\n        \"assertions\": [\n          \"fig-15-A-on-circle\",\n          \"fig-15-C-on-circle\",\n          \"fig-15-origin-to-C\",\n          \"fig-15-origin-to-A1\",\n          \"fig-15-origin-to-B1\",\n          \"fig-15-origin-to-D1\",\n          \"fig-15-A1-to-A\",\n          \"fig-15-B1-to-B\",\n          \"fig-15-D1-to-D\",\n          \"fig-15-B-inside-sample-distance\",\n          \"fig-15-D-outside-sample-distance\"\n        ],\n        \"requires\": [\n          \"pointRelationships\"\n        ]\n      },\n      {\n        \"id\": \"fig-15-source-radial\",\n        \"description\": \"Three independently visible, solid diagonal segments run from O to A, from O to B and from O to exterior D. O-A-A1 forms the triangle invoked by the authoritative text.\",\n        \"objects\": [\n          \"fig-15-OA\",\n          \"fig-15-OB\",\n          \"fig-15-OD\"\n        ],\n        \"assertions\": [\n          \"fig-15-OA-endpoints\",\n          \"fig-15-OB-endpoints\",\n          \"fig-15-OD-endpoints\"\n        ]\n      },\n      {\n        \"id\": \"fig-15-source-projection-locations\",\n        \"description\": \"Vertical visible ink at A-A1, B-B1 and D-D1 coincides exactly with uninterrupted solid grid strokes. Foot labels and grid positions establish the endpoints and perpendicular projection roles. The pixels do not distinguish an overlaid projection stroke's dash pattern from the grid. Certify only the visible solid ink and endpoint geometry, not an invisible dashed style. The candidate certifies visible solid ink only. Muted 2.5 px solid emphasis over the pale 1 px grid is a declared modern presentation choice. Separate source projection-overlay style remains unknown, not a known solid or dashed source fact.\",\n        \"objects\": [\n          \"fig-15-AA1-guide\",\n          \"fig-15-BB1-guide\",\n          \"fig-15-DD1-guide\"\n        ],\n        \"assertions\": [\n          \"fig-15-AA1-endpoints\",\n          \"fig-15-BB1-endpoints\",\n          \"fig-15-DD1-endpoints\",\n          \"fig-15-A-right-angle\",\n          \"fig-15-B-right-angle\",\n          \"fig-15-D-right-angle\"\n        ]\n      }\n    ]\n  },\n  \"objects\": [\n    {\n      \"id\": \"fig-15-grid\",\n      \"type\": \"grid\",\n      \"bounds\": [\n        -9.5,\n        7,\n        9.5,\n        -6.5\n      ],\n      \"xStep\": 0.5,\n      \"yStep\": 0.5,\n      \"xOffset\": 0,\n      \"yOffset\": 0,\n      \"stroke\": \"grid\",\n      \"strokeWidth\": 1\n    },\n    {\n      \"id\": \"fig-15-frame\",\n      \"type\": \"polygon\",\n      \"points\": [\n        [\n          -9.5,\n          7\n        ],\n        [\n          9.5,\n          7\n        ],\n        [\n          9.5,\n          -6.5\n        ],\n        [\n          -9.5,\n          -6.5\n        ]\n      ],\n      \"stroke\": \"ink\",\n      \"strokeWidth\": 1.5,\n      \"fill\": \"paper\",\n      \"fillOpacity\": 0\n    },\n    {\n      \"id\": \"fig-15-x-axis\",\n      \"type\": \"arrow\",\n      \"from\": [\n        -9.5,\n        0\n      ],\n      \"to\": [\n        9.2,\n        0\n      ],\n      \"stroke\": \"ink\",\n      \"strokeWidth\": 2.5\n    },\n    {\n      \"id\": \"fig-15-y-axis\",\n      \"type\": \"arrow\",\n      \"from\": [\n        0,\n        -6.5\n      ],\n      \"to\": [\n        0,\n        6.8\n      ],\n      \"stroke\": \"ink\",\n      \"strokeWidth\": 2.5\n    },\n    {\n      \"id\": \"fig-15-origin\",\n      \"type\": \"point\",\n      \"at\": [\n        0,\n        0\n      ],\n      \"size\": 0,\n      \"strokeWidth\": 0,\n      \"label\": \"O\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"SE\",\n        \"offset\": [\n          10,\n          12\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-15-A\",\n      \"type\": \"point\",\n      \"at\": [\n        -3,\n        4\n      ],\n      \"size\": 3,\n      \"stroke\": \"ink\",\n      \"fill\": \"ink\",\n      \"label\": \"A(x,y)\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"NW\",\n        \"offset\": [\n          -12,\n          -12\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-15-B\",\n      \"type\": \"point\",\n      \"at\": [\n        2.5,\n        3\n      ],\n      \"size\": 3,\n      \"stroke\": \"ink\",\n      \"fill\": \"ink\",\n      \"label\": \"B(x\u2081,y\u2081)\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"NW\",\n        \"offset\": [\n          -12,\n          -12\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-15-C\",\n      \"type\": \"point\",\n      \"at\": [\n        0,\n        -5\n      ],\n      \"size\": 0,\n      \"strokeWidth\": 0,\n      \"label\": \"C(0,-5)\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"SE\",\n        \"offset\": [\n          12,\n          12\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-15-D\",\n      \"type\": \"point\",\n      \"at\": [\n        -2,\n        -6\n      ],\n      \"size\": 3,\n      \"stroke\": \"ink\",\n      \"fill\": \"ink\",\n      \"label\": \"D(x\u2082,y\u2082)\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"SE\",\n        \"offset\": [\n          12,\n          12\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-15-A1\",\n      \"type\": \"point\",\n      \"at\": [\n        -3,\n        0\n      ],\n      \"size\": 3,\n      \"stroke\": \"ink\",\n      \"fill\": \"ink\",\n      \"label\": \"A\u2081\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"SW\",\n        \"offset\": [\n          -12,\n          12\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-15-B1\",\n      \"type\": \"point\",\n      \"at\": [\n        2.5,\n        0\n      ],\n      \"size\": 3,\n      \"stroke\": \"ink\",\n      \"fill\": \"ink\",\n      \"label\": \"B\u2081\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"S\",\n        \"offset\": [\n          0,\n          24\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-15-D1\",\n      \"type\": \"point\",\n      \"at\": [\n        -2,\n        0\n      ],\n      \"size\": 3,\n      \"stroke\": \"ink\",\n      \"fill\": \"ink\",\n      \"label\": \"D\u2081\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\",\n      \"labelPlacement\": {\n        \"position\": \"N\",\n        \"offset\": [\n          0,\n          -24\n        ]\n      }\n    },\n    {\n      \"id\": \"fig-15-circle\",\n      \"type\": \"circle\",\n      \"center\": \"fig-15-origin\",\n      \"radius\": 5,\n      \"stroke\": \"accent\",\n      \"strokeWidth\": 3,\n      \"fill\": \"paper\",\n      \"fillOpacity\": 0\n    },\n    {\n      \"id\": \"fig-15-OA\",\n      \"type\": \"segment\",\n      \"from\": \"fig-15-origin\",\n      \"to\": \"fig-15-A\",\n      \"stroke\": \"ink\",\n      \"strokeWidth\": 2.5\n    },\n    {\n      \"id\": \"fig-15-OB\",\n      \"type\": \"segment\",\n      \"from\": \"fig-15-origin\",\n      \"to\": \"fig-15-B\",\n      \"stroke\": \"ink\",\n      \"strokeWidth\": 2.5\n    },\n    {\n      \"id\": \"fig-15-OD\",\n      \"type\": \"segment\",\n      \"from\": \"fig-15-origin\",\n      \"to\": \"fig-15-D\",\n      \"stroke\": \"ink\",\n      \"strokeWidth\": 2.5\n    },\n    {\n      \"id\": \"fig-15-AA1-guide\",\n      \"type\": \"segment\",\n      \"from\": \"fig-15-A\",\n      \"to\": \"fig-15-A1\",\n      \"stroke\": \"muted\",\n      \"strokeWidth\": 2.5,\n      \"dash\": 0\n    },\n    {\n      \"id\": \"fig-15-BB1-guide\",\n      \"type\": \"segment\",\n      \"from\": \"fig-15-B\",\n      \"to\": \"fig-15-B1\",\n      \"stroke\": \"muted\",\n      \"strokeWidth\": 2.5,\n      \"dash\": 0\n    },\n    {\n      \"id\": \"fig-15-DD1-guide\",\n      \"type\": \"segment\",\n      \"from\": \"fig-15-D\",\n      \"to\": \"fig-15-D1\",\n      \"stroke\": \"muted\",\n      \"strokeWidth\": 2.5,\n      \"dash\": 0\n    },\n    {\n      \"id\": \"fig-15-x-label\",\n      \"type\": \"text\",\n      \"at\": [\n        9,\n        -0.4\n      ],\n      \"text\": \"x\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\"\n    },\n    {\n      \"id\": \"fig-15-y-label\",\n      \"type\": \"text\",\n      \"at\": [\n        -0.35,\n        6.6\n      ],\n      \"text\": \"y\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\"\n    },\n    {\n      \"id\": \"fig-15-x-unit-label\",\n      \"type\": \"text\",\n      \"at\": [\n        1,\n        -0.4\n      ],\n      \"text\": \"1\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\"\n    },\n    {\n      \"id\": \"fig-15-y-unit-label\",\n      \"type\": \"text\",\n      \"at\": [\n        -0.35,\n        1\n      ],\n      \"text\": \"1\",\n      \"fontSize\": 32,\n      \"labelColor\": \"ink\"\n    }\n  ],\n  \"assertions\": [\n    {\n      \"id\": \"fig-15-grid-38-by-27\",\n      \"type\": \"gridDimensions\",\n      \"grid\": \"fig-15-grid\",\n      \"columns\": 38,\n      \"rows\": 27\n    },\n    {\n      \"id\": \"fig-15-x-axis-extent\",\n      \"type\": \"connects\",\n      \"arrow\": \"fig-15-x-axis\",\n      \"from\": [\n        -9.5,\n        0\n      ],\n      \"to\": [\n        9.2,\n        0\n      ]\n    },\n    {\n      \"id\": \"fig-15-y-axis-extent\",\n      \"type\": \"connects\",\n      \"arrow\": \"fig-15-y-axis\",\n      \"from\": [\n        0,\n        -6.5\n      ],\n      \"to\": [\n        0,\n        6.8\n      ]\n    },\n    {\n      \"id\": \"fig-15-axes-perpendicular\",\n      \"type\": \"perpendicular\",\n      \"a\": [\n        -9.5,\n        0\n      ],\n      \"b\": [\n        9.2,\n        0\n      ],\n      \"c\": [\n        0,\n        -6.5\n      ],\n      \"d\": [\n        0,\n        6.8\n      ]\n    },\n    {\n      \"id\": \"fig-15-one-circle\",\n      \"type\": \"objectCount\",\n      \"objectType\": \"circle\",\n      \"count\": 1\n    },\n    {\n      \"id\": \"fig-15-A-on-circle\",\n      \"type\": \"pointOnCircle\",\n      \"point\": \"fig-15-A\",\n      \"center\": \"fig-15-origin\",\n      \"radius\": 5\n    },\n    {\n      \"id\": \"fig-15-C-on-circle\",\n      \"type\": \"pointOnCircle\",\n      \"point\": \"fig-15-C\",\n      \"center\": \"fig-15-origin\",\n      \"radius\": 5\n    },\n    {\n      \"id\": \"fig-15-origin-to-C\",\n      \"type\": \"displacement\",\n      \"from\": \"fig-15-origin\",\n      \"to\": \"fig-15-C\",\n      \"dx\": 0,\n      \"dy\": -5\n    },\n    {\n      \"id\": \"fig-15-origin-to-A1\",\n      \"type\": \"displacement\",\n      \"from\": \"fig-15-origin\",\n      \"to\": \"fig-15-A1\",\n      \"dx\": -3,\n      \"dy\": 0\n    },\n    {\n      \"i