  "stdout": "{\n  \"schema\": \"resume182-6/native-raster@1\",\n  \"status\": \"pass\",\n  \"figure\": \"fig-14\",\n  \"cwd\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck\",\n  \"attempt\": \"NATIVEFIX1\",\n  \"classification\": \"technical native raster recovery only; no content revision\",\n  \"actualFailedRasterCheck\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1/fig-14/native-REPEAT1/stroke-check.record\",\n    \"sha256\": \"a8f5b50a2030be8d1065af9516b9e77961f8f6c4fb1ac6b3d94adc714baa4a09\",\n    \"unexpectedDarkPixelsOutsideCurveStroke\": 1256\n  },\n  \"priorNativePreview\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1/fig-14/native-REPEAT1/fig-14-native640-REPEAT1.png\",\n    \"sha256\": \"80ab0edd3b971f1b4c4994b1b04971e2480dfc6267e1583594e72fb7c0465ce8\",\n    \"status\": \"FAILED_NATIVE_STROKE_COMPATIBILITY\"\n  },\n  \"sourceSVG\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1/fig-14/render-REPEAT1/fig-14-REPEAT1.svg\",\n    \"sha256\": \"c851ada176b5f3982d5024de20266252ef843289ee62ad723048adbb6040387c\"\n  },\n  \"renderReport\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1/fig-14/render-REPEAT1/fig-14-render-REPEAT1.json\",\n    \"sha256\": \"58fc56fec0128f0a7fe5711200c90f2496a4f790adf7e17ace6d9a1bdcb327a5\",\n    \"status\": \"pass\"\n  },\n  \"renderer\": {\n    \"name\": \"@resvg/resvg-js\",\n    \"version\": \"2.6.2\"\n  },\n  \"nativePNG\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1/fig-14/native-NATIVEFIX1/fig-14-native640-NATIVEFIX1.png\",\n    \"sha256\": \"145ab8e63482cf115d747b0f26d684f421d2968601ed80b7a3b08e3dc99eb954\",\n    \"bytes\": 12645\n  },\n  \"width\": 640,\n  \"height\": 260,\n  \"nonwhitePixels\": 6851,\n  \"transparentPixels\": 0,\n  \"rasterOnlyTransformation\": {\n    \"semanticCSSFallbackSubstitutions\": 82,\n    \"vectorEffectNormalization\": [\n      {\n        \"layer\": \"ld-fig-14-raw-path-layer\",\n        \"uniformScale\": 32,\n        \"inputStrokeWidth\": 3,\n        \"rasterCompatibleStrokeWidth\": 0.09375,\n        \"effectiveFullWidthStrokePx\": 3,\n        \"pathDataChanged\": false\n      }\n    ],\n    \"normalizer\": {\n      \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1/normalize-native-stroke.py\",\n      \"sha256\": \"87272bd2394947738623d94e3e70e3869e987bf7fc4a7350419c79a3afd04b12\"\n    },\n    \"normalizedRasterInputSHA256\": \"3a90a55587da252ff48edfa7fa36df1efaafd5473a1eb4a00af09c6340480d57\",\n    \"originalSVGWritten\": false,\n    \"transformedSVGPersisted\": false,\n    \"font\": {\n      \"path\": \"/System/Library/Fonts/Supplemental/Arial.ttf\",\n      \"sha256\": \"525979822591a3447cfc49d943d6f7683508e25543407871c0ed8fed05fd2bd9\"\n    }\n  },\n  \"mathematicalCoordinatesChanged\": false,\n  \"originalPathDataChanged\": false,\n  \"specChanged\": false,\n  \"renderCalls\": 0,\n  \"nativeRasterCalls\": 1,\n  \"dependenciesInstalledOrCopied\": 0,\n  \"sourcePNGsRead\": 0,\n  \"imagesEmittedOrVisuallyInspected\": 0,\n  \"visualInspection\": \"NOT_RUN\",\n  \"independentReview\": \"PENDING\"\n}\nimport assert from 'node:assert/strict';\nimport crypto from 'node:crypto';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { createRequire } from 'node:module';\nimport { spawnSync } from 'node:child_process';\n\nconst root = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';\nconst own = path.join(root, '.tmp/resume182-6-8a-n7-figures3695-AFFECTED1');\nassert.equal(process.cwd(), root);\nconst sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');\nconst id = 'fig-14';\nconst directory = path.join(own, id, 'native-NATIVEFIX1');\nfs.mkdirSync(directory);\nconst failedCheckPath = path.join(own, id, 'native-REPEAT1/stroke-check.record');\nconst failedCheckBytes = fs.readFileSync(failedCheckPath);\nconst failedCheck = JSON.parse(failedCheckBytes);\nassert.equal(failedCheck.status, 'fail');\nassert.equal(failedCheck.unexpectedDarkPixelsOutsideCurveStroke, 1256);\nconst reportPath = path.join(own, id, 'render-REPEAT1/fig-14-render-REPEAT1.json');\nconst reportBytes = fs.readFileSync(reportPath);\nconst report = JSON.parse(reportBytes);\nassert.equal(report.status, 'pass');\nconst svgPath = path.join(own, id, 'render-REPEAT1/fig-14-REPEAT1.svg');\nconst svgBytes = fs.readFileSync(svgPath);\nassert.equal(sha(svgBytes), report.output.svg.sha256);\nlet substitutions = 0;\nconst cssResolved = svgBytes.toString('utf8').replace(\n  /var\\((--ld-figure-[a-z-]+),\\s*(#[0-9a-fA-F]{3,8})\\)/g,\n  (_match, _role, fallback) => { substitutions++; return fallback; },\n);\nassert.ok(substitutions > 0 && !cssResolved.includes('var('));\nconst python = '/Users/yong/work/lemmadeck-ws/lemmadeck/.claude/skills/ld-s10y-lesson/.venv/bin/python';\nconst normalizerPath = path.join(own, 'normalize-native-stroke.py');\nconst normalization = spawnSync(python, ['-B', normalizerPath], {\n  cwd: root,\n  env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1', TMPDIR: directory },\n  input: cssResolved, encoding: 'utf8', maxBuffer: 8 * 1024 * 1024,\n});\nassert.equal(normalization.status, 0, normalization.stderr || 'normalizer failed');\nconst normalized = JSON.parse(normalization.stdout);\nassert.equal(normalized.inputSHA256, sha(cssResolved));\nassert.equal(normalized.normalizedSHA256, sha(normalized.svg));\nassert.equal(normalized.changes[0].effectiveFullWidthStrokePx, 3);\nconst require = createRequire(path.join(root, '.claude/skills/ld-s10y-lesson/package.json'));\nconst { Resvg } = require('@resvg/resvg-js');\nconst font = '/System/Library/Fonts/Supplemental/Arial.ttf';\nconst image = new Resvg(normalized.svg, {\n  fitTo: { mode: 'width', value: 640 }, background: '#ffffff',\n  font: { loadSystemFonts: false, fontFiles: [font], defaultFontFamily: 'Arial' },\n}).render();\nassert.equal(image.width, 640);\nassert.equal(image.height, 260);\nconst pixels = image.pixels;\nlet nonwhite = 0;\nlet transparent = 0;\nfor (let index = 0; index < pixels.length; index += 4) {\n  if (pixels[index + 3] < 255) transparent++;\n  if (Math.min(pixels[index], pixels[index + 1], pixels[index + 2]) < 220) nonwhite++;\n}\nassert.equal(transparent, 0);\nassert.ok(nonwhite > 3000 && nonwhite < 640 * 260 * 0.4);\nconst png = image.asPng();\nconst pngPath = path.join(directory, 'fig-14-native640-NATIVEFIX1.png');\nfs.writeFileSync(pngPath, png, { flag: 'wx' });\nconst receipt = {\n  schema: 'resume182-6/native-raster@1',\n  status: 'pass',\n  figure: id, cwd: root, attempt: 'NATIVEFIX1',\n  classification: 'technical native raster recovery only; no content revision',\n  actualFailedRasterCheck: {\n    path: failedCheckPath, sha256: sha(failedCheckBytes),\n    unexpectedDarkPixelsOutsideCurveStroke: failedCheck.unexpectedDarkPixelsOutsideCurveStroke,\n  },\n  priorNativePreview: { ...failedCheck.png, status: 'FAILED_NATIVE_STROKE_COMPATIBILITY' },\n  sourceSVG: { path: svgPath, sha256: sha(svgBytes) },\n  renderReport: { path: reportPath, sha256: sha(reportBytes), status: 'pass' },\n  renderer: { name: '@resvg/resvg-js', version: require('@resvg/resvg-js/package.json').version },\n  nativePNG: { path: pngPath, sha256: sha(png), bytes: png.length },\n  width: image.width, height: image.height,\n  nonwhitePixels: nonwhite, transparentPixels: transparent,\n  rasterOnlyTransformation: {\n    semanticCSSFallbackSubstitutions: substitutions,\n    vectorEffectNormalization: normalized.changes,\n    normalizer: { path: normalizerPath, sha256: sha(fs.readFileSync(normalizerPath)) },\n    normalizedRasterInputSHA256: normalized.normalizedSHA256,\n    originalSVGWritten: false,\n    transformedSVGPersisted: false,\n    font: { path: font, sha256: sha(fs.readFileSync(font)) },\n  },\n  mathematicalCoordinatesChanged: false,\n  originalPathDataChanged: false,\n  specChanged: false, renderCalls: 0, nativeRasterCalls: 1,\n  dependenciesInstalledOrCopied: 0,\n  sourcePNGsRead: 0, imagesEmittedOrVisuallyInspected: 0,\n  visualInspection: 'NOT_RUN', independentReview: 'PENDING',\n};\nfs.writeFileSync(\n  path.join(directory, 'pixels.record'), `${JSON.stringify(receipt, null, 2)}\\n`, { flag: 'wx' },\n);\nconsole.log(JSON.stringify(receipt, null, 2));\nimport hashlib\nimport json\nimport math\nimport sys\nimport xml.etree.ElementTree as ET\n\nsource = sys.stdin.read()\nroot = ET.fromstring(source)\nchanges = []\nfor layer in root.iter():\n    if not layer.get(\"id\", \"\").endswith(\"-raw-path-layer\"):\n        continue\n    transform = layer.get(\"transform\", \"\")\n    assert transform.startswith(\"scale(\") and transform.endswith(\")\")\n    factors = [float(value) for value in transform[6:-1].split()]\n    assert len(factors) == 2 and factors[0] > 0\n    assert math.isclose(factors[0], factors[1], abs_tol=1e-9)\n    scale = factors[0]\n    for node in layer:\n        if node.get(\"vector-effect\") != \"non-scaling-stroke\":\n            continue\n        assert node.tag.endswith(\"}path\")\n        assert node.get(\"transform\") is None\n        old_width = float(node.get(\"stroke-width\"))\n        adjusted_width = old_width / scale\n        node.set(\"stroke-width\", str(adjusted_width))\n        del node.attrib[\"vector-effect\"]\n        changes.append({\n            \"layer\": layer.get(\"id\"),\n            \"uniformScale\": scale,\n            \"inputStrokeWidth\": old_width,\n            \"rasterCompatibleStrokeWidth\": adjusted_width,\n            \"effectiveFullWidthStrokePx\": adjusted_width * scale,\n            \"pathDataChanged\": False,\n        })\nassert len(changes) == 1\nresult = ET.tostring(root, encoding=\"unicode\")\nprint(json.dumps({\n    \"svg\": result,\n    \"changes\": changes,\n    \"inputSHA256\": hashlib.sha256(source.encode()).hexdigest(),\n    \"normalizedSHA256\": hashlib.sha256(result.encode()).hexdigest(),\n    \"persistedTransformedSVG\": False,\n}))\nimport assert from 'node:assert/strict';\nimport crypto from 'node:crypto';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { createRequire } from 'node:module';\n\nconst root = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';\nassert.equal(process.cwd(), root);\nconst own = path.join(root, '.tmp/resume182-6-8a-n7-figures3695-AFFECTED1');\nconst [id, attempt] = process.argv.slice(2);\nassert.ok(['fig-14', 'fig-15'].includes(id));\nassert.equal(attempt, 'REPEAT1');\nconst renderDir = path.join(own, id, `render-${attempt}`);\nconst nativeDir = path.join(own, id, `native-${attempt}`);\nconst svgPath = path.join(renderDir, `${id}-${attempt}.svg`);\nconst reportPath = path.join(renderDir, `${id}-render-${attempt}.json`);\nconst report = JSON.parse(fs.readFileSync(reportPath));\nassert.equal(report.status, 'pass');\nconst require = createRequire(path.join(root, '.claude/skills/ld-s10y-lesson/package.json'));\nconst { Resvg } = require('@resvg/resvg-js');\nconst sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');\nconst svg = fs.readFileSync(svgPath);\nassert.equal(sha(svg), report.output.svg.sha256);\nlet substitutions = 0;\nconst input = svg.toString('utf8').replace(\n  /var\\((--ld-figure-[a-z-]+),\\s*(#[0-9a-fA-F]{3,8})\\)/g,\n  (_match, _role, fallback) => { substitutions++; return fallback; },\n);\nassert.ok(substitutions > 0 && !input.includes('var('));\nconst font = '/System/Library/Fonts/Supplemental/Arial.ttf';\nconst image = new Resvg(input, {\n  fitTo: { mode: 'width', value: 640 }, background: '#ffffff',\n  font: { loadSystemFonts: false, fontFiles: [font], defaultFontFamily: 'Arial' },\n}).render();\nassert.equal(image.width, 640);\nconst pixels = image.pixels;\nlet nonwhite = 0;\nlet transparent = 0;\nfor (let index = 0; index < pixels.length; index += 4) {\n  if (pixels[index + 3] < 255) transparent++;\n  if (Math.min(pixels[index], pixels[index + 1], pixels[index + 2]) < 220) nonwhite++;\n}\nassert.equal(transparent, 0);\nassert.ok(nonwhite > 3000 && nonwhite < image.width * image.height * 0.4);\nconst png = image.asPng();\nconst pngPath = path.join(nativeDir, `${id}-native640-${attempt}.png`);\nfs.writeFileSync(pngPath, png, { flag: 'wx' });\nconst evidence = {\n  schema: 'resume182-6/native-raster@1',\n  figure: id, cwd: root,\n  renderer: { name: '@resvg/resvg-js', version: require('@resvg/resvg-js/package.json').version },\n  sourceSVG: { path: svgPath, sha256: sha(svg) },\n  renderReport: { path: reportPath, sha256: sha(fs.readFileSync(reportPath)) },\n  nativePNG: { path: pngPath, sha256: sha(png), bytes: png.length },\n  width: image.width, height: image.height,\n  nonwhitePixels: nonwhite, transparentPixels: transparent,\n  rasterOnlyTransformation: {\n    semanticCSSFallbackSubstitutions: substitutions,\n    rasterInputSHA256: sha(input),\n    originalSVGWritten: false, transformedSVGPersisted: false,\n    font: { path: font, sha256: sha(fs.readFileSync(font)) },\n  },\n  reusedEnvironment: {\n    referenceScript: path.join(root, '.tmp/resume182-6-8a-n5-figures3695-AFFECTED1/native-preview.mjs'),\n    dataAndImagesFromReferenceNotRead: true,\n    packagesInstalledOrCopied: 0,\n  },\n  status: 'pass', visualInspection: 'NOT_RUN', independentReview: 'PENDING',\n};\nfs.writeFileSync(\n  path.join(nativeDir, 'pixels.record'), `${JSON.stringify(evidence, null, 2)}\\n`, { flag: 'wx' },\n);\nconsole.log(JSON.stringify(evidence, null, 2));\n{\n  \"schema\": \"resume182-6/native-raster@1\",\n  \"figure\": \"fig-15\",\n  \"cwd\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck\",\n  \"renderer\": {\n    \"name\": \"@resvg/resvg-js\",\n    \"version\": \"2.6.2\"\n  },\n  \"sourceSVG\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1/fig-15/render-REPEAT1/fig-15-REPEAT1.svg\",\n    \"sha256\": \"98ee8fad0618387c3c71b46629ff8db93f117cd47a32d68fbf7521fd3656a4f8\"\n  },\n  \"renderReport\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1/fig-15/render-REPEAT1/fig-15-render-REPEAT1.json\",\n    \"sha256\": \"0c402a19195f2947174582d74650d797e68e3cd5473bd6581dd82884eaa2bb8d\"\n  },\n  \"nativePNG\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1/fig-15/native-REPEAT1/fig-15-native640-REPEAT1.png\",\n    \"sha256\": \"e8254b67e2d869cdc9c5c7f7a069acf8a64203ab06dc0abf1affa9552d563acf\",\n    \"bytes\": 47841\n  },\n  \"width\": 640,\n  \"height\": 480,\n  \"nonwhitePixels\": 9739,\n  \"transparentPixels\": 0,\n  \"rasterOnlyTransformation\": {\n    \"semanticCSSFallbackSubstitutions\": 115,\n    \"rasterInputSHA256\": \"3ea78612a016b299ec2c40fc3c1d6af3faebff884c543413d942d295ad057113\",\n    \"originalSVGWritten\": false,\n    \"transformedSVGPersisted\": false,\n    \"font\": {\n      \"path\": \"/System/Library/Fonts/Supplemental/Arial.ttf\",\n      \"sha256\": \"525979822591a3447cfc49d943d6f7683508e25543407871c0ed8fed05fd2bd9\"\n    }\n  },\n  \"reusedEnvironment\": {\n    \"referenceScript\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n5-figures3695-AFFECTED1/native-preview.mjs\",\n    \"dataAndImagesFromReferenceNotRead\": true,\n    \"packagesInstalledOrCopied\": 0\n  },\n  \"status\": \"pass\",\n  \"visualInspection\": \"NOT_RUN\",\n  \"independentReview\": \"PENDING\"\n}\n",
