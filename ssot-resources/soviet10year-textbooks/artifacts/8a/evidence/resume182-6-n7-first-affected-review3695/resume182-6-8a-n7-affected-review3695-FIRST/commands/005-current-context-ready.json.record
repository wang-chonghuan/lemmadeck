  "stdout": "{\n  \"schema\": \"ld-s10y-image/context@1\",\n  \"book\": \"8a\",\n  \"edition\": \"modern-us-neutral\",\n  \"figure\": \"fig-14\",\n  \"authoritativeRule\": \"Modern-edition text is authoritative. The original PNG supplies visual structure only. Never use an answer key or derive answer annotations.\",\n  \"sourceImage\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/ssot-resources/soviet10year-textbooks/artifacts/8a/figures/fig-14.png\",\n    \"sha256\": \"c2d2f17ea8f6f19adf4f617e29b6cfad17833f79ecc18496ad587cdba984df05\",\n    \"width\": 1740,\n    \"height\": 599\n  },\n  \"suggestedSize\": \"1536x1024\",\n  \"lessons\": [\n    {\n      \"lesson\": \"alg8-c2-s1-n7\",\n      \"title\": \"7. \u4e8c\u5143\u65b9\u7a0b\u548c\u5b83\u7684\u56fe\u8c61\",\n      \"prose\": [\n        {\n          \"figureLabel\": \"\u56fe 14\",\n          \"nearbyText\": [\n            \"\u5728\u56fe14\u4e2d\u753b\u51fa\u4e86\u65b9\u7a0b$x^2+9y^2=81$\u7684\u56fe\u8c61\uff0c\u8fd9\u79cd\u5f62\u5f0f\u7684\u66f2\u7ebf\u53eb\u505a\u692d\u5706.\",\n            \"\u6bcf\u4e00\u4e2a\u542b\u4e24\u4e2a\u53d8\u91cf$x$\u548c$y$\u7684\u65b9\u7a0b\uff0c\u90fd\u786e\u5b9a\u67d0\u4e00\u4e2a\u4f5c\u4e3a\u8fd9\u4e2a\u65b9\u7a0b\u7684\u89e3\u7684\u53d8\u91cf\u53d6\u503c\u6570\u5bf9$(x,y)$\u7684\u96c6\u5408\uff0c\u4e5f\u5c31\u662f\u90fd\u5728\u53d8\u91cf$x$\u7684\u503c\u548c\u53d8\u91cf$y$\u7684\u503c\u4e4b\u95f4\u5efa\u7acb\u67d0\u79cd\u5173\u7cfb. \u5927\u5bb6\u77e5\u9053\uff0c\u4e8c\u5143\u65b9\u7a0b\u7ed9\u51fa\u7684\u5173\u7cfb\u7684\u56fe\u8c61\uff0c\u6216\u7b80\u79f0\u4e3a\u4e8c\u5143\u65b9\u7a0b\u7684\u56fe\u8c61\uff0c\u662f\u4ee5\u8fd9\u4e2a\u65b9\u7a0b\u7684\u89e3\u4e3a\u5750\u6807\u7684\u5e73\u9762\u4e0a\u70b9\u7684\u96c6\u5408.\",\n            \"\u6211\u4eec\u77e5\u9053\uff0c$ax+by=c(a\\\\ne0$\u6216$b\\\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\u7684\u56fe\u8c61\u662f\u76f4\u7ebf\uff0c$y=ax^2+bx+c(a\\\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\u7684\u56fe\u8c61\u662f\u629b\u7269\u7ebf\uff0c$xy=k(k\\\\ne0)$\u8fd9\u79cd\u5f62\u5f0f\u7684\u65b9\u7a0b\u7684\u56fe\u8c61\u662f\u53cc\u66f2\u7ebf.\",\n            \"\u56fe14\",\n            \"\u6211\u4eec\u6765\u770b\u56fe15\uff0c\u56fe\u4e2d\u753b\u51fa\u4e86\u5706\u5fc3\u5728\u5750\u6807\u539f\u70b9\u3001\u534a\u5f84\u4e3a5\u4e2a\u5355\u4f4d\u957f\u7684\u5706\u5468. \u6211\u4eec\u6765\u6c42\u56fe\u8c61\u662f\u8fd9\u4e2a\u5706\u5468\u7684\u65b9\u7a0b.\"\n          ]\n        }\n      ],\n      \"exercises\": []\n    }\n  ]\n}\n{\n  \"schema\": \"ld-s10y-image/context@1\",\n  \"book\": \"8a\",\n  \"edition\": \"modern-us-neutral\",\n  \"figure\": \"fig-15\",\n  \"authoritativeRule\": \"Modern-edition text is authoritative. The original PNG supplies visual structure only. Never use an answer key or derive answer annotations.\",\n  \"sourceImage\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/ssot-resources/soviet10year-textbooks/artifacts/8a/figures/fig-15.png\",\n    \"sha256\": \"e5b5a48fa35691a096dc709d2860c9f266b605c112e920a42933e457a5f72595\",\n    \"width\": 1753,\n    \"height\": 1296\n  },\n  \"suggestedSize\": \"1536x1024\",\n  \"lessons\": [\n    {\n      \"lesson\": \"alg8-c2-s1-n7\",\n      \"title\": \"7. \u4e8c\u5143\u65b9\u7a0b\u548c\u5b83\u7684\u56fe\u8c61\",\n      \"prose\": [\n        {\n          \"figureLabel\": \"\u56fe 15\",\n          \"nearbyText\": [\n            \"\u6211\u4eec\u6765\u770b\u56fe15\uff0c\u56fe\u4e2d\u753b\u51fa\u4e86\u5706\u5fc3\u5728\u5750\u6807\u539f\u70b9\u3001\u534a\u5f84\u4e3a5\u4e2a\u5355\u4f4d\u957f\u7684\u5706\u5468. \u6211\u4eec\u6765\u6c42\u56fe\u8c61\u662f\u8fd9\u4e2a\u5706\u5468\u7684\u65b9\u7a0b.\",\n            \"\u5b9e\u9645\u4e0a\uff0c\u8bbe\u70b9$B(x_1,y_1)$\u5728\u5706\u5185\uff08\u53c2\u770b\u56fe15\uff09\uff0c\u90a3\u4e48$|OB|<5$\uff0c$x_1^2+y_1^2<5^2$.\",\n            \"\u4e8e\u662f\uff0c\u5f53\u4e14\u4ec5\u5f53\u5750\u6807\u4e3a$x$\u548c$y$\u7684\u70b9\u4f4d\u4e8e\u5706\u5fc3\u5728\u5750\u6807\u539f\u70b9\u3001\u534a\u5f84\u4e3a5\u4e2a\u5355\u4f4d\u957f\u7684\u5706\u5468\u4e0a\u65f6\uff0c\u7b49\u5f0f$x^2+y^2=5^2$\u6210\u7acb. \u56e0\u6b64\uff0c\u56fe15\u4e2d\u753b\u51fa\u7684\u5706\u5468\u662f\u65b9\u7a0b$x^2+y^2=5^2$\u7684\u56fe\u8c61.\",\n            \"\u56fe14\",\n            \"\u56fe15\",\n            \"\u8bbe\u70b9$A(x,y)$\u662f\u8fd9\u4e2a\u5706\u5468\u4e0a\u4e0d\u5728\u4e24\u4e2a\u5750\u6807\u8f74\u4e0a\u7684\u4efb\u610f\u4e00\u70b9. \u90a3\u4e48\uff0c\u5728\u76f4\u89d2\u4e09\u89d2\u5f62$OAA_1$\u4e2d\uff0c\u6839\u636e\u52fe\u80a1\u5b9a\u7406\u5f97\uff1a\\n$|OA_1|^2+|AA_1|^2=|OA|^2$.\u663e\u7136\uff0c$|OA_1|^2=x^2$\uff0c$|AA_1|^2=y^2$\uff0c$|OA|^2=5^2$. \u4e8e\u662f\uff0c\u5706\u5468\u4e0a\u4e0d\u5728\u4e24\u4e2a\u5750\u6807\u8f74\u4e0a\u7684\u4efb\u610f\u4e00\u70b9\u7684\u5750\u6807\u6ee1\u8db3\u65b9\u7a0b$x^2+y^2=5^2$\uff1a \uff081\uff09\",\n            \"\u5bb9\u6613\u9a8c\u8bc1\uff0c\u5706\u5468\u4e0e$x$\u8f74\u548c$y$\u8f74\u7684\u6bcf\u4e00\u4e2a\u4ea4\u70b9\u7684\u5750\u6807\u4e5f\u6ee1\u8db3\u65b9\u7a0b\uff081\uff09. \u4f8b\u5982\uff0c\u628a\u70b9$C(0,-5)$\u7684\u5750\u6807\u4ee3\u5165\u65b9\u7a0b\uff081\uff09\uff0c\u5f97\u5230\u771f\u7b49\u5f0f\uff1a\\n$0^2+(-5)^2=5^2$.\"\n          ]\n        }\n      ],\n      \"exercises\": []\n    }\n  ]\n}\n{\n  \"schema\": \"resume182-6/affected-figures-ready@1\",\n  \"status\": \"READY_FOR_AFFECTED_INDEPENDENT_REVIEW_NOT_APPROVED\",\n  \"root\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck\",\n  \"outputRoot\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figures3695-AFFECTED1\",\n  \"book\": \"8a\",\n  \"lesson\": \"alg8-c2-s1-n7\",\n  \"figures\": [\n    \"fig-14\",\n    \"fig-15\"\n  ],\n  \"authorRoleOnly\": true,\n  \"createdAt\": \"2026-11-20T07:19:19.019Z\",\n  \"binding\": {\n    \"path\": \"/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck/.tmp/resume182-6-8a-n7-figure-context3695-A