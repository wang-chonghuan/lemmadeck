        {
          "id": "FIG15-SUBSCRIPT-GLYPHS",
          "conclusion": "HOLD",
          "reason": "At the only permitted native640 view, the subscript digits in A_1, B_1, D_1, B(x_1,y_1) and D(x_2,y_2) appear as empty replacement boxes. Necessary endpoint names and coordinate-pair distinctions are not legible.",
          "postObservationEvidence": "Current SVG contains U+2081/U+2082 in these exact labels. The recorded raster uses only the specified Arial.ttf, loadSystemFonts=false. This corroborates the bound text/preview mismatch without proving a renderer cause or justifying repair.",
          "requiredMathematicalRoleUnconfirmed": true
        },
        {
          "id": "FIG15-Y-ARROW-CLEARANCE",
          "conclusion": "HOLD",
          "reason": "The sealed native640 observation cannot distinguish clean separation between the y glyph and vertical arrowhead. The current SVG y text starts at full-width x=633.0667, y=70.9333 close to the x=640 axis; a zero-collision report does not resolve this observed uncertainty.",
          "requiredVisualClearanceUnconfirmed": true
        }
      ],
