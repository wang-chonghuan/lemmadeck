    {
      "number": "90",
      "source_number": "90",
      "group": null,
      "group_id": "g0",
      "text": "90. 求下列方程的任何两个解：а) $x-3y=1$；　б) $5x+y=2$；в) $x-xy=15$；　г) $x^2+3y=1$；д) $(x-1)(y-2)=0$；е) $(x^2+1)(y-5)=0$.",
      "lines": [
