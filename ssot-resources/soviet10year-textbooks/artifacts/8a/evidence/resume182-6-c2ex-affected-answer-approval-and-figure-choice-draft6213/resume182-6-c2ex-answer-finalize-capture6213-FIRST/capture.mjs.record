import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';

const tools = new Set(['check_math_expressions.mjs', 'check_mathlive_exact.mjs']);
const tool = path.basename(process.argv[1] ?? '');
if (tools.has(tool)) {
  const repo = '/Users/yong/.codex/worktrees/stemrobin-182-six-6213/lemmadeck';
  assert.equal(process.cwd(), repo);
  const own = path.join(repo, '.tmp/resume182-6-c2ex-answer-finalize-capture6213-FIRST/captured', tool);
  fs.mkdirSync(own, { recursive: true });
  const started = new Date().toISOString();
  fs.writeFileSync(path.join(own, 'start.record'),
    `${JSON.stringify({ argv: process.argv, cwd: repo, started }, null, 2)}\n`, { flag: 'wx' });
  const descriptors = [];
  for (const [name, stream] of [['stdout', process.stdout], ['stderr', process.stderr]]) {
    const descriptor = fs.openSync(path.join(own, `${name}.txt`), 'wx');
    descriptors.push(descriptor);
    const original = stream.write.bind(stream);
    stream.write = (chunk, ...arguments_) => {
      const encoding = typeof arguments_[0] === 'string' ? arguments_[0] : 'utf8';
      const bytes = Buffer.isBuffer(chunk) || chunk instanceof Uint8Array
        ? chunk : Buffer.from(chunk, encoding);
      fs.writeSync(descriptor, bytes);
      return original(chunk, ...arguments_);
    };
  }
  process.on('exit', returncode => {
    for (const descriptor of descriptors) fs.closeSync(descriptor);
    fs.writeFileSync(path.join(own, 'receipt.record'),
      `${JSON.stringify({ argv: process.argv, cwd: repo, started,
        finished: new Date().toISOString(), returncode,
        interception: 'Byte-preserving copy before the unchanged process stream.write',
        nativeToolChanged: false }, null, 2)}\n`, { flag: 'wx' });
  });
}
