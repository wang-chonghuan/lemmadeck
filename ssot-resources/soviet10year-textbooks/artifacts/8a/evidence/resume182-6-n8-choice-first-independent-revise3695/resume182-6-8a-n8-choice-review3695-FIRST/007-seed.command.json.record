  "stdout": "{\n  \"schema\": \"s10y-choice-seed-v1\",\n  \"source\": {\n    \"book\": \"8a\",\n    \"lesson\": \"alg8-c2-s1-n8\",\n    \"concept_figure_ids\": []\n  },\n  \"exercises\": [\n    {\n      \"number\": \"102\",\n      \"text\": \"102. \\u7528\\u4ee3\\u5165\\u6d88\\u5143\\u6cd5\\u89e3\\u4e0b\\u5217\\u65b9\\u7a0b\\u7ec4\\uff1a\\na) $\\\\begin{cases}5x+11y=-1,\\\\\\\\x=3y+5;\\\\end{cases}$\\nb) $\\\\begin{cases}x=-2y-1,\\\\\\\\7x-20y=146;\\\\end{cases}$\\nc) $\\\\begin{cases}12x-y=16,\\\\\\\\5x+3y=75;\\\\end{cases}$\\nd) $\\\\begin{cases}7x+6y=2,\\\\\\\\6x-5y=93;\\\\end{cases}$\\ne) $\\\\begin{cases}4x+3y=43,\\\\\\\\5x-7y=43;\\\\end{cases}$\\nf) $\\\\begin{cases}8x-9y=4,\\\\\\\\-3x+4y=1.\\\\end{cases}$\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"103\",\n      \"text\": \"103. \\u89e3\\u4e0b\\u5217\\u65b9\\u7a0b\\u7ec4\\uff1a\\na) $\\\\begin{cases}x^2-2y^2=7,\\\\\\\\x=y+2;\\\\end{cases}$\\nb) $\\\\begin{cases}x^2-2xy=7,\\\\\\\\x=3y+2;\\\\end{cases}$\\nc) $\\\\begin{cases}x^2-5xy=10,\\\\\\\\x-5y=1;\\\\end{cases}$\\nd) $\\\\begin{cases}5xy-y^2=9,\\\\\\\\2x-y=3;\\\\end{cases}$\\ne) $\\\\begin{cases}x^2+y^2=100,\\\\\\\\3x-2y=2;\\\\end{cases}$\\nf) $\\\\begin{cases}2x^2-3y^2=24,\\\\\\\\2x-3y=0;\\\\end{cases}$\\ng) $\\\\begin{cases}4x^2-9y^2=15,\\\\\\\\2x+3y=5;\\\\end{cases}$\\nh) $\\\\begin{cases}x^2+xy-y^2=11,\\\\\\\\x-2y=1;\\\\end{cases}$\\ni) $\\\\begin{cases}x^2+xy-3y=9,\\\\\\\\3x+2y=-1.\\\\end{cases}$\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"104\",\n      \"text\": \"104. \\u7528\\u56fe\\u89e3\\u6cd5\\u89e3\\u4e0b\\u5217\\u65b9\\u7a0b\\u7ec4\\uff1a\\na) $\\\\begin{cases}x^2+y^2=25,\\\\\\\\x-y=5;\\\\end{cases}$\\nb) $\\\\begin{cases}x^2+y^2=20,\\\\\\\\xy=-8;\\\\end{cases}$\\nc) $\\\\begin{cases}x^2+y^2=100,\\\\\\\\y=\\\\frac{1}{2}x^2-10.\\\\end{cases}$\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"105\",\n      \"text\": \"105. \\u6c42\\u4e09\\u4e2a\\u65b9\\u7a0b\\u7684\\u65b9\\u7a0b\\u7ec4\\u7684\\u89e3\\u96c6\\u5408\\uff1a\\na) $\\\\begin{cases}x+y=0,\\\\\\\\x-y-10=0,\\\\\\\\x^2-y^2=40;\\\\end{cases}$\\nb) $\\\\begin{cases}3x-4y=3,\\\\\\\\x-2y=1,\\\\\\\\x^2+y^2=2.\\\\end{cases}$\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"106\",\n      \"text\": \"106. \\u89e3\\u4e0b\\u5217\\u65b9\\u7a0b\\u7ec4\\uff1a\\na) $\\\\begin{cases}x+y=10,\\\\\\\\\\\\frac{1}{x}+\\\\frac{1}{y}=\\\\frac{5}{12};\\\\end{cases}$\\nb) $\\\\begin{cases}x-y=6,\\\\\\\\\\\\frac{1}{y}-\\\\frac{1}{x}=\\\\frac{3}{20};\\\\end{cases}$\\nc) $\\\\begin{cases}2x+y=5,\\\\\\\\\\\\frac{1}{x}+\\\\frac{1}{y}=1.2;\\\\end{cases}$\\nd) $\\\\begin{cases}y-2x=3,\\\\\\\\\\\\frac{1}{x}-\\\\frac{1}{y}=0.1.\\\\end{cases}$\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"107\",\n      \"text\": \"107.\\na) \\u4e24\\u6570\\u7684\\u548c\\u7b49\\u4e8e20\\uff0c\\u800c\\u5b83\\u4eec\\u7684\\u79ef\\u7b49\\u4e8e96. \\u6c42\\u8fd9\\u4e24\\u4e2a\\u6570.\\nb) \\u4e24\\u6570\\u7684\\u5dee\\u7b49\\u4e8e6\\uff0c\\u800c\\u5b83\\u4eec\\u7684\\u79ef\\u7b49\\u4e8e216. \\u6c42\\u8fd9\\u4e24\\u4e2a\\u6570.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"108\",\n      \"text\": \"108.\\na) \\u77e9\\u5f62\\u7684\\u5468\\u957f\\u7b49\\u4e8e82m\\uff0c\\u800c\\u5b83\\u7684\\u5bf9\\u89d2\\u7ebf\\u957f\\u7b49\\u4e8e29m.\\u6c42\\u8fd9\\u4e2a\\u77e9\\u5f62\\u7684\\u8fb9\\u957f.\\nb) \\u76f4\\u89d2\\u4e09\\u89d2\\u5f62\\u7684\\u5468\\u957f\\u7b49\\u4e8e84cm\\uff0c\\u800c\\u5b83\\u7684\\u659c\\u8fb9\\u957f\\u7b49\\u4e8e37cm. \\u6c42\\u8fd9\\u4e2a\\u4e09\\u89d2\\u5f62\\u7684\\u9762\\u79ef.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"109\",\n      \"text\": \"109.\\na) \\u4e00\\u5757\\u957f\\u65b9\\u5f62\\u7684\\u5730\\uff0c\\u957f\\u7b49\\u4e8e60m\\uff0c\\u5bbd\\u7b49\\u4e8e8m. \\u4e3a\\u4e86\\u4f7f\\u5b83\\u7684\\u9762\\u79ef\\u7f29\\u5c0f\\u4e00\\u534a\\uff0c\\u5468\\u957f\\u51cf\\u5c1144m\\uff0c\\u8fd9\\u5757\\u5730\\u7684\\u957f\\u548c\\u5bbd\\u5404\\u5e94\\u5f53\\u51cf\\u5c11\\u591a\\u5c11\\u7c73\\uff1f\\nb) \\u77e9\\u5f62\\u7684\\u5468\\u957f\\u7b49\\u4e8e80m. \\u5982\\u679c\\u5b83\\u7684\\u957f\\u548c\\u5bbd\\u4e00\\u4e2a\\u589e\\u59278m\\uff0c\\u53e6\\u4e00\\u4e2a\\u589e\\u59272m\\uff0c\\u90a3\\u4e48\\u5b83\\u7684\\u9762\\u79ef\\u5c31\\u589e\\u52a0\\u534a\\u500d. \\u8fd9\\u4e2a\\u77e9\\u5f62\\u7684\\u957f\\u548c\\u5bbd\\u5404\\u7b49\\u4e8e\\u591a\\u5c11\\uff1f\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"110\",\n      \"text\": \"110.\\na) \\u60f3\\u51fa\\u4e00\\u4e2a\\u4e24\\u4f4d\\u6570. \\u5982\\u679c\\u5c06\\u8fd9\\u4e2a\\u6570\\u52a0\\u4e0a\\u5b83\\u7684\\u6570\\u5b57\\u7684\\u548c\\u7684\\u4e24\\u500d\\uff0c\\u5c31\\u5f9796. \\u5982\\u679c\\u5c06\\u6240\\u60f3\\u51fa\\u7684\\u6570\\u4e58\\u4ee5\\u5b83\\u7684\\u6570\\u5b57\\u7684\\u548c\\uff0c\\u5c31\\u5f97952. \\u6c42\\u6240\\u60f3\\u51fa\\u7684\\u6570.\\nb) \\u6240\\u60f3\\u51fa\\u7684\\u4e24\\u4f4d\\u6570\\u7684\\u6570\\u5b57\\u7684\\u5e73\\u65b9\\u548c\\u7b49\\u4e8e65. \\u5982\\u679c\\u5c06\\u6240\\u60f3\\u51fa\\u7684\\u6570\\u52a0\\u4e0a27\\uff0c\\u90a3\\u4e48\\u6240\\u5f97\\u5230\\u7684\\u6570\\u7684\\u6570\\u5b57\\u548c\\u6240\\u60f3\\u51fa\\u7684\\u6570\\u76f8\\u540c. \\u6240\\u60f3\\u51fa\\u7684\\u6570\\u662f\\u4ec0\\u4e48\\uff1f\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"111\",\n      \"text\": \"111.\\na) \\u4e24\\u4eba\\u9a91\\u81ea\\u884c\\u8f66\\u540c\\u65f6\\u4ece\\u76f8\\u8ddd28\\u516c\\u91cc\\u7684$A$\\u5730\\u548c$B$\\u5730\\u51fa\\u53d1\\uff0c\\u76f8\\u5411\\u800c\\u884c\\uff0c\\u7ecf\\u8fc71\\u5c0f\\u65f6\\u540e\\u76f8\\u9047. \\u5982\\u679c\\u4ece$A$\\u5730\\u51fa\\u53d1\\u7684\\u7b2c\\u4e00\\u4eba\\u5230\\u8fbe$B$\\u5730\\u6bd4\\u7b2c\\u4e8c\\u4eba\\u5230\\u8fbe$A$\\u5730\\u8fdf35\\u5206\\u949f\\uff0c\\u6bcf\\u4e2a\\u9a91\\u81ea\\u884c\\u8f66\\u7684\\u4eba\\u7528\\u591a\\u5927\\u7684\\u901f\\u5ea6\\u884c\\u9a76\\uff1f\\nb) \\u4e24\\u5217\\u706b\\u8f66\\u540c\\u65f6\\u4ece\\u76f8\\u8ddd45\\u516c\\u91cc\\u7684$M$\\u7ad9\\u548c$N$\\u7ad9\\u5bf9\\u5f00\\uff0c\\u7ecf\\u8fc720\\u5206\\u949f\\u540e\\u76f8\\u9047. \\u4ece$M$\\u7ad9\\u5f00\\u51fa\\u7684\\u706b\\u8f66\\u5230\\u8fbe$N$\\u7ad9\\u6bd4\\u53e6\\u4e00\\u5217\\u706b\\u8f66\\u5230\\u8fbe$M$\\u7ad9\\u65e99\\u5206\\u949f. \\u6bcf\\u5217\\u706b\\u8f66\\u7684\\u901f\\u5ea6\\u662f\\u591a\\u5c11\\uff1f\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"112\",\n      \"text\": \"112.\\na) \\u4e24\\u6839\\u6c34\\u7ba1\\u540c\\u65f6\\u653e\\u6c34\\u65f6\\uff0c\\u572812\\u5206\\u949f\\u5185\\u53ef\\u704c\\u6ee1\\u6c34\\u7bb1. \\u5982\\u679c\\u9996\\u5148\\u7528\\u4e00\\u6839\\u6c34\\u7ba1\\u704c\\u6c34\\u534a\\u7bb1\\uff0c\\u7136\\u540e\\u7528\\u53e6\\u4e00\\u6839\\u6c34\\u7ba1\\u704c\\u6c34\\u534a\\u7bb1\\uff0c\\u90a3\\u4e48\\u7ecf\\u8fc725\\u5206\\u949f\\u540e\\u53ef\\u704c\\u6ee1\\u6c34\\u7bb1. \\u6bcf\\u6839\\u6c34\\u7ba1\\u5355\\u72ec\\u653e\\u6c34\\u65f6\\uff0c\\u5728\\u591a\\u5c11\\u5206\\u949f\\u5185\\u53ef\\u704c\\u6ee1\\u6c34\\u7bb1\\uff1f\\nb) \\u4e00\\u53f0\\u8054\\u5408\\u6536\\u5272\\u673a\\u4ece\\u5730\\u91cc\\u6536\\u5272\\u5c0f\\u9ea6\\u53ef\\u6bd4\\u53e6\\u4e00\\u53f0\\u8054\\u5408\\u6536\\u5272\\u673a\\u5feb24\\u5c0f\\u65f6. \\u5f53\\u4e24\\u53f0\\u8054\\u5408\\u6536\\u5272\\u673a\\u4e00\\u540c\\u5de5\\u4f5c\\u65f6\\uff0c\\u752835\\u5c0f\\u65f6\\u5c31\\u53ef\\u4ee5\\u6536\\u5b8c\\u5e84\\u7a3c. \\u6bcf\\u53f0\\u8054\\u5408\\u6536\\u5272\\u673a\\u5355\\u72ec\\u5de5\\u4f5c\\uff0c\\u7528\\u51e0\\u5c0f\\u65f6\\u80fd\\u6536\\u5b8c\\u5e84\\u7a3c\\uff1f\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"113\",\n      \"text\": \"113. \\u4e0b\\u5217\\u53d8\\u91cf$x$\\u548c$y$\\u7684\\u53d6\\u503c\\u6570\\u5bf9\\u662f\\u65b9\\u7a0b$x^2+3xy+y^2=41$\\u7684\\u89e3\\u5417\\uff1f\\na) $(5,1)$\\uff1b\\nb) $(1,5)$.\\u8bc1\\u660e\\uff1a\\u5982\\u679c\\u6570\\u5bf9$(a,b)$\\u662f\\u8fd9\\u4e2a\\u65b9\\u7a0b\\u7684\\u89e3\\uff0c\\u90a3\\u4e48\\u6570\\u5bf9$(b,a)$\\u4e5f\\u662f\\u8fd9\\u4e2a\\u65b9\\u7a0b\\u7684\\u89e3.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"114\",\n      \"text\": \"114. \\u4e0b\\u5217\\u6570\\u5bf9\\u662f\\u65b9\\u7a0b$x^2+xy+y^2=29$\\u7684\\u89e3\\u5417\\uff1f\\na) $x=\\\\sqrt{12}$\\uff0c$y=\\\\sqrt{3}$\\uff1b\\nb) $x=3+\\\\sqrt{2}$\\uff0c$y=3-\\\\sqrt{2}$.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"115\",\n      \"text\": \"115. \\u6c42\\u4e0b\\u5217\\u65b9\\u7a0b\\u7684\\u4efb\\u610f\\u4e24\\u4e2a\\u89e3\\uff1a\\na) $\\\\sqrt{x}-\\\\sqrt{y}=1$\\uff1b\\nb) $\\\\sqrt{x+y}-\\\\sqrt{y}=1$.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"116\",\n      \"text\": \"116. \\u4e0d\\u4f5c\\u56fe\\uff0c\\u6307\\u51fa\\u4e0b\\u5217\\u65b9\\u7a0b\\u7684\\u56fe\\u8c61\\u5728\\u54ea\\u4e2a\\u8c61\\u9650\\u5185\\uff1a\\na) $y=x^2+4$\\uff1b\\nb) $y=9-x^2$\\uff1b\\nc) $xy=6$\\uff1b\\nd) $xy=-12$.\",\n      \"figure_ids\": []\n    }\n  ],\n  \"concepts\": [\n    {\n      \"block\": 1,\n      \"text\": \"\\u89e3\\u4e8c\\u5143\\u65b9\\u7a0b\\u7ec4\\uff0c\\u5c31\\u662f\\u8981\\u627e\\u51fa\\u4f7f\\u65b9\\u7a0b\\u7ec4\\u7684\\u6bcf\\u4e00\\u4e2a\\u65b9\\u7a0b\\u6210\\u4e3a\\u771f\\u7b49\\u5f0f\\u7684\\u53d8\\u91cf\\u53d6\\u503c\\u6570\\u5bf9\\u7684\\u96c6\\u5408.\"\n    },\n    {\n      \"block\": 2,\n      \"text\": \"\\u6362\\u53e5\\u8bdd\\u8bf4\\uff0c\\u89e3\\u65b9\\u7a0b\\u7ec4\\u5c31\\u662f\\u8981\\u627e\\u51fa\\u8fd9\\u4e2a\\u65b9\\u7a0b\\u7ec4\\u4e2d\\u5404\\u65b9\\u7a0b\\u7684\\u89e3\\u96c6\\u5408\\u7684\\u4ea4\\u96c6.\"\n    },\n    {\n      \"block\": 16,\n      \"text\": \"\\u6211\\u4eec\\u6240\\u91c7\\u7528\\u7684\\u8fd9\\u4e2a\\u89e3\\u65b9\\u7a0b\\u7ec4\\u7684\\u65b9\\u6cd5\\u53eb\\u505a\\u4ee3\\u5165\\u6d88\\u5143\\u6cd5. \\u5229\\u7528\\u8fd9\\u4e2a\\u65b9\\u6cd5\\u53ef\\u4ee5\\u89e3\\u4e24\\u4e2a\\u4e8c\\u5143\\u65b9\\u7a0b\\u7684\\u4efb\\u4f55\\u65b9\\u7a0b\\u7ec4\\uff0c\\u5176\\u4e2d\\u4e00\\u4e2a\\u65b9\\u7a0b\\u662f\\u4e8c\\u6b21\\u65b9\\u7a0b\\uff0c\\u53e6\\u4e00\\u4e2a\\u65b9\\u7a0b\\u662f\\u4e00\\u6b21\\u65b9\\u7a0b.\"\n    },\n    {\n      \"block\": 25,\n      \"text\": \"\\u4ee3\\u5165\\u6d88\\u5143\\u6cd5\\u548c\\u56fe\\u89e3\\u6cd5\\u3001\\u52a0\\u51cf\\u6d88\\u5143\\u6cd5\\u4e00\\u6837\\uff0c\\u4e5f\\u53ef\\u4ee5\\u7528\\u6765\\u89e3\\u4e8c\\u5143\\u7ebf\\u6027\\u65b9\\u7a0b\\u7ec4.\"\n    },\n    {\n      \"block\": 26,\n      \"text\": \"\\u5982\\u679c\\u65b9\\u7a0b\\u7ec4\\u662f\\u7531\\u4e24\\u4e2a\\u4e8c\\u6b21\\u65b9\\u7a0b\\u7ec4\\u6210\\u7684\\uff0c\\u90a3\\u4e48\\u53ea\\u6709\\u5728\\u7279\\u6b8a\\u60c5\\u51b5\\u4e0b\\uff0c\\u624d\\u80fd\\u7ed9\\u51fa\\u5b83\\u7684\\u7b80\\u5355\\u89e3\\u6cd5.\"\n    }\n  ],\n  \"figures\": [],\n  \"trace\": [\n    {\n      \"path\": \"ssot-resources/soviet10year-textbooks/artifacts/8a/book.json\",\n      \"sha256\": \"e5a06d420af454f7857d180919598c0986754fc64c4037083e5041a3f1bff0ae\"\n    },\n    {\n      \"path\": \"ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c2-s1-n8/lesson.json\",\n      \"sha256\": \"418ca4c69f7f65519846f246073157577d829f20690ef804c2c8b437ec76526c\"\n    },\n    {\n      \"path\": \"ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c2-s1-n8/exercises.json\",\n      \"sha256\": \"8d931dcddc7e02c947ac1efd8eb7028a624965be2880ed049a065319e7fdb867\"\n    },\n    {\n      \"path\": \"ssot-resources/soviet10year-textbooks/artifacts/8a/editions/modern-us-neutral/lessons/alg8-c2-s1-n8/figures.json\",\n      \"sha256\": \"15503d8161c28893e1d1b60b8b7cb9278cafe44a94389e57fa74e694402ad35e\"\n    }\n  ]\n}\n",
