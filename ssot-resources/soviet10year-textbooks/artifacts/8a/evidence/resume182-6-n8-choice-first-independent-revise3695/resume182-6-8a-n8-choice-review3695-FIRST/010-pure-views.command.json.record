   \"figure_ids\": [],\n      \"options\": [\n        {\n          \"id\": \"a\",\n          \"text\": \"$\\\\{(6,9),(-5/2,-8)\\\\}$\",\n          \"figure_ids\": []\n        },\n        {\n          \"id\": \"b\",\n          \"text\": \"$\\\\{(6,15),(-5/2,-2)\\\\}$\",\n          \"figure_ids\": []\n        },\n        {\n          \"id\": \"c\",\n          \"text\": \"$\\\\{(6,15),(5/2,8)\\\\}$\",\n          \"figure_ids\": []\n        }\n      ]\n    }\n  },\n  {\n    \"id\": \"q25\",\n    \"view\": {\n      \"mode\": \"single\",\n      \"stem\": \"两个实数的和是 $20$，积是 $96$。这两个数是什么？\",\n      \"figure_ids\": [],\n      \"options\": [\n        {\n          \"id\": \"a\",\n          \"text\": \"$10$ 和 $10$\",\n          \"figure_ids\": []\n        },\n        {\n          \"id\": \"b\",\n          \"text\": \"$-8$ 和 $-12$\",\n          \"figure_ids\": []\n        },\n        {\n          \"id\": \"c\",\n          \"text\": \"$8$ 和 $12$\",\n          \"figure_ids\": []\n        }\n      ]\n    }\n  },\n  {\n    \"id\": \"q26\",\n    \"view\": {\n      \"mode\": \"single\",\n      \"stem\": \"两个实数的差是 $6$，积是 $216$。以较大数为 $x$、较小数为 $y$，所有可能的数对 $(x,y)$ 组成哪个集合？\",\n      \"figure_ids\": [],\n      \"options\": [\n        {\n          \"id\": \"a\",\n          \"text\": \"$\\\\{(18,12),(-12,-18)\\\\}$\",\n          \"figure_ids\": []\n        },\n        {\n          \"id\": \"b\",\n          \"text\": \"$\\\\{(12,18),(-18,-12)\\\\}$\",\n          \"figure_ids\": []\n        },\n        {\n          \"id\": \"c\",\n          \"text\": \"$\\\\{(18,12),(-18,-12)\\\\}$\",\n          \"figure_ids\": []\n        }\n      ]\n    }\n  },\n  {\n    \"id\": \"q27\",\n    \"view\": {\n      \"mode\": \"single\",\n      \"stem\": \"矩形的周长是 $82\\\\text{ m}$，对角线长 $29\\\\text{ m}$。这个矩形的两条不同方向的边长是什么？\",\n      \"figure_ids\": [],\n      \"options\": [\n        {\n          \"id\": \"a\",\n          \"text\": \"$40\\\\text{ m}$ 和 $42\\\\text{ m}$\",\n          \"figure_ids\": []\n        },\n    