    "const fs=require(\"fs\"),d=JSON.parse(fs.readFileSync(\".tmp/resume182-6-8a-n8-choice-author3695-FIRST/draft.json\"));for(const q of d.questions.filter(q=>Number(q.id.slice(1))>=14&&Number(q.id.slice(1))<=26)){console.log(JSON.stringify({id:q.id,source_numbers:q.source_numbers,intent:q.intent,key:q.key},null,2));}"
