  "stdout": "{\n  \"id\": \"q14\",\n  \"source_numbers\": [\n    \"103\"\n  ],\n  \"intent\": {\n    \"task\": \"Solve the mixed quadratic with the correct affine correspondence.\",\n    \"source_solution\": \"x=2y+1 gives 5y^2+5y-10=0, y=1,-2; x=3,-3.\",\n    \"unit_reason\": \"Both solutions of this independent quadratic are one complete set.\",\n    \"concept_blocks\": [\n      1,\n      16\n    ],\n    \"limitations\": [\n      \"Writing the expansion and factorization is not assessed.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"a\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"correct\",\n        \"derivation\": \"9+3-1=11 and 9+6-4=11; both satisfy x-2y=1.\",\n        \"misconception\": null\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Use the correct y roots but reconstruct x=2y-1, producing 1,-5.\",\n        \"misconception\": \"Transpose the constant with the wrong sign.\"\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Cross-pair x=3,-3 with y=-2,1 rather than the corresponding roots.\",\n        \"misconception\": \"Ignore the affine relation while forming the set.\"\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q15\",\n  \"source_numbers\": [\n    \"103\"\n  ],\n  \"intent\": {\n    \"task\": \"Find both x roots and reconstruct their negative y coordinates.\",\n    \"source_solution\": \"y=(-1-3x)/2 gives x^2-8x+15=0, x=3,5; y=-5,-8.\",\n    \"unit_reason\": \"The solution set keeps both branches and coordinate correspondence together.\",\n    \"concept_blocks\": [\n      1,\n      16\n    ],\n    \"limitations\": [\n      \"Written elimination and root finding are deferred.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"b\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Cross-pair x=3,5 with the opposite computed y values.\",\n        \"misconception\": \"Treat reconstructed coordinates as interchangeable.\"\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"correct\",\n        \"derivation\": \"9-15+15=9 and 25-40+24=9; 9-10=-1 and 15-16=-1.\",\n        \"misconception\": null\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Keep roots x=3,5 but use y=(1-3x)/2, obtaining -4,-7.\",\n        \"misconception\": \"Change the constant -1 to +1 during back-substitution.\"\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q16\",\n  \"source_numbers\": [\n    \"104\"\n  ],\n  \"intent\": {\n    \"task\": \"Recognize all common points of the circle and line.\",\n    \"source_solution\": \"y=x-5 gives 2x(x-5)=0; intersections (0,-5),(5,0). The line is a secant.\",\n    \"unit_reason\": \"All intersections constitute one whole graphical relationship, not point-by-point clicks.\",\n    \"concept_blocks\": [\n      1,\n      2\n    ],\n    \"limitations\": [\n      \"No evidence of drawing both curves, reading coordinates from a plotted graph, or executing the source graphical method.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"c\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Solve x-y=5 for the two axis intercepts but replace y=-5 at x=0 by +5.\",\n        \"misconception\": \"Use unsigned intercept distances as signed coordinates.\"\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Replace x-y=5 with x-y=-5; y=x+5 gives the circle intersections (-5,0),(0,5).\",\n        \"misconception\": \"Reverse the sign of the entire line's constant.\"\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"correct\",\n        \"derivation\": \"x=0,5 yields y=-5,0; both have squared radius 25 and difference 5.\",\n        \"misconception\": null\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q17\",\n  \"source_numbers\": [\n    \"104\"\n  ],\n  \"intent\": {\n    \"task\": \"Preserve all four circle-hyperbola intersections and the opposite-sign condition.\",\n    \"source_solution\": \"(x+y)^2=4, (x-y)^2=36 give (4,-2),(-2,4),(2,-4),(-4,2).\",\n    \"unit_reason\": \"One complete set captures sign branches and all intersections together.\",\n    \"concept_blocks\": [\n      1,\n      2,\n      26\n    ],\n    \"limitations\": [\n      \"Drawing the circle and hyperbola and extracting their intersections graphically remain deferred.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"a\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"correct\",\n        \"derivation\": \"The four sign combinations of sums ±2 and differences ±6 give precisely these points; each product is -8 and squared radius 20.\",\n        \"misconception\": null\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Replace xy=-8 by xy=8 while keeping the circle; magnitudes 4,2 paired with matching signs give these four points.\",\n        \"misconception\": \"Drop the negative product sign.\"\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Find squared magnitudes 16,4 but interpret xy<0 as requiring y<0 alone; allow either sign for x and always choose negative y.\",\n        \"misconception\": \"Fail to link the two coordinate signs in a negative product.\"\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q18\",\n  \"source_numbers\": [\n    \"104\"\n  ],\n  \"intent\": {\n    \"task\": \"Recognize every intersection, including the bottom tangency rather than losing its zero root.\",\n    \"source_solution\": \"For u=x^2>=0, u+(u/2-10)^2=100 gives u(u-36)=0. Thus (0,-10),(±6,8). At (0,-10) both tangents are horizontal y=-10 and the parabola remains above the lower circle nearby; the other intersections are transverse.\",\n    \"unit_reason\": \"The full intersection configuration with its tangency is one coherent response; a count alone would omit the key geometry.\",\n    \"concept_blocks\": [\n      1,\n      2,\n      26\n    ],\n    \"limitations\": [\n      \"Recognizing the analytic configuration is not producing or inspecting a drawn graph.\",\n      \"Accurate plotting and graphical location of all intersections and the tangent contact are deferred.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"b\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Retain correct abscissas 0,±6 but reconstruct y using x^2-10 instead of x^2/2-10, giving -10,26,26.\",\n        \"misconception\": \"Omit the coefficient 1/2 only when converting abscissas to ordinates.\"\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"correct\",\n        \"derivation\": \"u=0,36 yields all three points. Near zero the circle lower branch is -10+x^2/20+..., versus -10+x^2/2; at ±6 the circle and parabola have distinct slopes, so only the bottom contact is tangent.\",\n        \"misconception\": null\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Find the three common points and classify every equality point as a crossing without checking local side changes; this misclassifies the double contact at x=0.\",\n        \"misconception\": \"Equate being a common point with crossing through, ignoring tangency.\"\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q19\",\n  \"source_numbers\": [\n    \"105\"\n  ],\n  \"intent\": {\n    \"task\": \"Intersect all three equations rather than accept a pair satisfying only two.\",\n    \"source_solution\": \"First two force (5,-5), for which x^2-y^2=0≠40; the full system has no solution.\",\n    \"unit_reason\": \"The whole three-equation intersection, including inconsistency, is the response.\",\n    \"concept_blocks\": [\n      1,\n      2\n    ],\n    \"limitations\": [\n      \"Writing the consistency argument independently is deferred.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"c\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Solve x+y=0 and x-y=10 only, obtaining x=5,y=-5.\",\n        \"misconception\": \"Ignore the third equation after solving the first two.\"\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Use x-y=10 and (x-y)(x+y)=40 to get x+y=4, hence (7,-3).\",\n        \"misconception\": \"Ignore the required first equation x+y=0.\"\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"correct\",\n        \"derivation\": \"The unique pair from the first two fails the third, so their three-way intersection is empty.\",\n        \"misconception\": null\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q20\",\n  \"source_numbers\": [\n    \"105\"\n  ],\n  \"intent\": {\n    \"task\": \"Enforce simultaneous truth of three equations.\",\n    \"source_solution\": \"x=1+2y substituted into 3x-4y=3 forces y=0,x=1, which has x^2+y^2=1, not 2.\",\n    \"unit_reason\": \"One whole intersection tests inconsistency rather than separate equation checks.\",\n    \"concept_blocks\": [\n      1,\n      2\n    ],\n    \"limitations\": [\n      \"Written proof of inconsistency is not demonstrated.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"a\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"correct\",\n        \"derivation\": \"The only common point of the two lines, (1,0), is not on the circle of squared radius 2.\",\n        \"misconception\": null\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Solve only the two linear equations, obtaining (1,0), and stop.\",\n        \"misconception\": \"Assume satisfying two equations settles a three-equation system.\"\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Use x=1+2y in x^2+y^2=2, giving 5y^2+4y-1=0, y=1/5,-1 and x=7/5,-1.\",\n        \"misconception\": \"Drop 3x-4y=3 while intersecting the other two equations.\"\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q21\",\n  \"source_numbers\": [\n    \"106\"\n  ],\n  \"intent\": {\n    \"task\": \"Solve the reciprocal system within its nonzero domain and retain both coordinate assignments.\",\n    \"source_solution\": \"Multiplying by xy≠0 gives x+y=(5/12)xy, so xy=24. The roots of t^2-10t+24=0 are 4,6, giving (4,6),(6,4).\",\n    \"unit_reason\": \"One full set preserves the sum, product, domain and both assignments.\",\n    \"concept_blocks\": [\n      1,\n      2\n    ],\n    \"limitations\": [\n      \"Selection does not demonstrate writing the domain restriction and reciprocal elimination.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"b\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Find scalar roots 4 and 6 but put each root in both coordinate positions, producing (4,4),(6,6).\",\n        \"misconception\": \"Assume both variables take the same root instead of enforcing their sum.\"\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"correct\",\n        \"derivation\": \"Both nonzero pairs have sum 10 and product 24; (x+y)/(xy)=10/24=5/12.\",\n        \"misconception\": null\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Negate the roots x=4,6 to -4,-6, then enforce y=10-x to obtain 14,16.\",\n        \"misconception\": \"Negate the roots of the quadratic without changing its coefficients.\"\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q22\",\n  \"source_numbers\": [\n    \"106\"\n  ],\n  \"intent\": {\n    \"task\": \"Retain the negative solution of the reciprocal difference system.\",\n    \"source_solution\": \"(1/y-1/x)=(x-y)/(xy) gives xy=40. With x=y+6, y^2+6y-40=0 gives y=4,-10 and x=10,-4.\",\n    \"unit_reason\": \"The full solution set keeps the negative branch and the directed difference together.\",\n    \"concept_blocks\": [\n      1,\n      2\n    ],\n    \"limitations\": [\n      \"Independent writing of denominator restrictions, elimination and negative-root verification is deferred.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"c\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Solve (10,4),(-4,-10) and reverse the coordinates of each pair.\",\n        \"misconception\": \"Treat a directed difference as unchanged by coordinate reversal.\"\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Keep x=10 but replace the second x root -4 by |−4|=4; reconstruct y=x-6 to get -2.\",\n        \"misconception\": \"Discard a negative x root by taking its absolute value instead of testing it.\"\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"correct\",\n        \"derivation\": \"Both pairs have difference 6 and nonzero product 40, hence reciprocal difference 6/40=3/20.\",\n        \"misconception\": null\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q23\",\n  \"source_numbers\": [\n    \"106\"\n  ],\n  \"intent\": {\n    \"task\": \"Solve the decimal reciprocal system with exact fractions and matching coordinates.\",\n    \"source_solution\": \"1.2=6/5 and y=5-2x give 12x^2-35x+25=0. Roots x=5/3,5/4 correspond to y=5/3,5/2; all denominators are nonzero.\",\n    \"unit_reason\": \"Both paired solutions are one complete result rather than independent coordinate questions.\",\n    \"concept_blocks\": [\n      1,\n      2\n    ],\n    \"limitations\": [\n      \"Written reciprocal transformation and quadratic derivation remain deferred.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"a\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"correct\",\n        \"derivation\": \"The reciprocal sums are 3/5+3/5 and 4/5+2/5; both equal 6/5, and 2x+y=5.\",\n        \"misconception\": null\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Find the two x roots and two y values correctly, then cross the correspondence.\",\n        \"misconception\": \"Pair roots independently instead of obeying y=5-2x.\"\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Keep x=5/3,5/4 but reconstruct y=5-x rather than 5-2x, giving 10/3,15/4.\",\n        \"misconception\": \"Omit the coefficient 2 during back-substitution.\"\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q24\",\n  \"source_numbers\": [\n    \"106\"\n  ],\n  \"intent\": {\n    \"task\": \"Preserve both real branches, including negative coordinates, with a nonzero domain.\",\n    \"source_solution\": \"y=2x+3, (y-x)/(xy)=1/10 lead to 2x^2-7x-30=0. x=6,-5/2 gives y=15,-2; both pairs are nonzero.\",\n    \"unit_reason\": \"One complete set represents both branches and the directed reciprocal relation.\",\n    \"concept_blocks\": [\n      1,\n      2\n    ],\n    \"limitations\": [\n      \"Does not demonstrate writing the denominator exclusions or checking the negative branch independently.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"b\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Find x=6,-5/2, then use y=2x-3 rather than 2x+3 to obtain 9,-8.\",\n        \"misconception\": \"Transpose 3 with the wrong sign.\"\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"correct\",\n        \"derivation\": \"1/6-1/15=1/10 and -2/5-(-1/2)=1/10; both have y-2x=3.\",\n        \"misconception\": null\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Replace the second root -5/2 by its absolute value 5/2, then calculate y=2(5/2)+3=8.\",\n        \"misconception\": \"Assume real reciprocal solutions must have positive x.\"\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q25\",\n  \"source_numbers\": [\n    \"107\"\n  ],\n  \"intent\": {\n    \"task\": \"Determine an unordered number pair from both sum and product.\",\n    \"source_solution\": \"The two numbers are the roots of t^2-20t+96=(t-8)(t-12)=0.\",\n    \"unit_reason\": \"Both numbers jointly determine the answer; their order is irrelevant.\",\n    \"concept_blocks\": [\n      1\n    ],\n    \"limitations\": [\n      \"Independently modeling and solving the quadratic is not demonstrated.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"c\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Split the sum equally, 20/2=10, and assign both numbers 10.\",\n        \"misconception\": \"Use the sum alone and assume equal numbers, neglecting the product 96.\"\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Use t^2+20t+96=(t+8)(t+12) instead of t^2-20t+96.\",\n        \"misconception\": \"Reverse the sign connecting the quadratic coefficient to the required sum.\"\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"correct\",\n        \"derivation\": \"8+12=20 and 8·12=96; the quadratic fixes this unordered pair.\",\n        \"misconception\": null\n      }\n    ]\n  }\n}\n{\n  \"id\": \"q26\",\n  \"source_numbers\": [\n    \"107\"\n  ],\n  \"intent\": {\n    \"task\": \"Find both signed number pairs with a directed difference.\",\n    \"source_solution\": \"x=y+6 gives y^2+6y-216=(y-12)(y+18)=0, yielding (18,12),(-12,-18).\",\n    \"unit_reason\": \"The two signed possibilities form one complete set; restricting to positive numbers would lose a source solution.\",\n    \"concept_blocks\": [\n      1\n    ],\n    \"limitations\": [\n      \"Written modeling and solving both branches are deferred.\"\n    ],\n    \"figure_observations\": []\n  },\n  \"key\": {\n    \"correct\": [\n      \"a\"\n    ],\n    \"rationales\": [\n      {\n        \"option_id\": \"a\",\n        \"truth\": \"correct\",\n        \"derivation\": \"Both products are 216 and differences x-y are 6; -12 is greater than -18.\",\n        \"misconception\": null\n      },\n      {\n        \"option_id\": \"b\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Reverse each correct ordered pair without rechecking the directed difference.\",\n        \"misconception\": \"Treat x-y=6 as symmetric in x and y.\"\n      },\n      {\n        \"option_id\": \"c\",\n        \"truth\": \"incorrect\",\n        \"derivation\": \"Find the positive pair (18,12), then negate both coordinates in place to create a second pair.\",\n        \"misconception\": \"Assume simultaneous negation preserves a nonzero difference; it actually changes 6 to -6.\"\n      }\n    ]\n  }\n}\n",
