import { spawnSync } from 'node:child_process';
import { writeFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';
const R = '/Users/yong/.codex/worktrees/stemrobin-182-six-3695/lemmadeck';
const own = resolve(R, '.tmp/resume182-6-8a-n8-choice-review3695-FIRST');
const [name, command, ...args] = process.argv.slice(2);
if (!name || !command || /[^a-zA-Z0-9_-]/.test(name)) throw new Error('Invalid receipt or command');
const receipt = resolve(own, `${name}.command.json`);
if (existsSync(receipt)) throw new Error('Receipt already exists');
const start = new Date().toISOString();
const result = spawnSync(command, args, { cwd: R, encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 });
writeFileSync(receipt, JSON.stringify({
  schema: 'independent-review-command-v1', cwd: R, command: [command, ...args],
  started_at: start, ended_at: new Date().toISOString(), status: result.status,
  signal: result.signal, error: result.error?.message ?? null,
  stdout: result.stdout ?? '', stderr: result.stderr ?? ''
}, null, 2) + '\n', { flag: 'wx' });
process.stdout.write(result.stdout ?? '');
process.stderr.write(result.stderr ?? '');
process.exitCode = result.status ?? 1;
