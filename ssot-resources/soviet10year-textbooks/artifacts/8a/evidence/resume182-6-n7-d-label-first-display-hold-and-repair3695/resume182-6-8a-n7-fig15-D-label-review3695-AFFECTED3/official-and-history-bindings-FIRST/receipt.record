    "const fs=require(\"node:fs\"),path=require(\"node:path\"),crypto=require(\"node:crypto\"),assert=require(\"node:assert/strict\"); const root=process.cwd(),own=path.join(root,\".tmp/resume182-6-8a-n7-fig15-D-label-review3695-AFFECTED3\"),hash=p=>crypto.createHash(\"sha256\").update(fs.readFileSync(p)).digest(\"hex\");const lineage=JSON.parse(fs.readFileSync(path.join(own,\"binding-check-FIRST/stdout.txt\"),\"utf8\"));const inherited=lineage.inheritedReview;assert.equal(inherited.spec.sha256,lineage.bindings.originalSpec.sha256);const officialPath=path.join(own,\"fig-15.review.json\"),official=JSON.parse(fs.readFileSync(officialPath,\"utf8\"));assert.equal(official.status,\"pass\");assert.equal(official.figure,\"fig-15\");assert.equal(official.spec.sha256,lineage.bindings.spec.sha256);assert.equal(official.render.sha256,lineage.bindings.render.sha256);assert.equal(official.outputs.svg.sha256,lineage.bindings.svg.sha256);const bindings={}; for(const [name,record] of Object.entries(lineage.bindings)){assert.equal(hash(record.path),record.sha256,name);bindings[name]=record;} const histories=[lineage.inheritedReviewBinding,inherited.inheritedFirstReview,inherited.inheritedChromiumReview,inherited.review,...inherited.preservedFailureRecords]; for(const record of histories)assert.equal(hash(record.path),record.sha256,record.path);const receipts={};for(const name of [\"rules-skill-FIRST\",\"rules-gate-FIRST\",\"rules-resume-FIRST\",\"session-entry-FIRST\",\"ready-read-FIRST\",\"official-script-FIRST\",\"operations-FIRST\",\"binding-check-FIRST\",\"failure-history-FIRST\",\"official-review-ONCE\"]){const p=path.join(own,name,\"receipt.record\");const r=JSON.parse(fs.readFileSync(p,\"utf8\"));assert.equal(r.returncode,0,name);assert.equal(r.cwd,root);receipts[name]={path:p,sha256:hash(p)};}console.log(JSON.stringify({bindings,official:{path:officialPath,sha256:hash(officialPath)},observations:{path:path.join(own,\"observations.record\"),sha256:hash(path.join(own,\"observations.record\"))},inheritedEvidenceVerified:histories,receipts,officialRecord:official},null,2));"
