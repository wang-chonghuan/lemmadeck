  "chapter": "第五章 指数函数",
  "section": "§ 12. 底数为10的指数函数",
  "number": "35",
  "title": "函数 $y=10^x$ 的数值表",
  "printed_title": "35. 函数 $y=10^x$ 的数值表",
  "start_page": 222,
  "start_printed": 215,
  "figures": [
