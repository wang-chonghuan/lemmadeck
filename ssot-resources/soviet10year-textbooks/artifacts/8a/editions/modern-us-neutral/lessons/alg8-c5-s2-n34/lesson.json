          "printed_page": 213,
          "source_refs": [
            "p0220#2"
          ]
        },
        {
          "kind": "p",
          "text": "$-1.73=-2+0.27$.",
          "id": null,
          "label": null,
          "printed_page": 213,
          "source_refs": [
            "p0220#4"
          ]
        },
        {
          "kind": "p",
          "text": "于是",
          "id": null,
          "label": null,
