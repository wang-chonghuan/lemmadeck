  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u5b9a\u4e49 \u5982\u679c\u4e00\u4e2a\u6570\u5217\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u7b49\u4e8e\u5b83\u7684\u524d\u9762\u4e00\u9879\u52a0\u4e0a\u4e00\u4e2a\u5e38\u6570\uff0c\u90a3\u4e48\u8fd9\u4e2a\u6570\u5217\u5c31\u53eb\u505a\u7b49\u5dee\u6570\u5217."
    },
    {
      "block": 4,
      "text": "\u7531\u5b9a\u4e49\u5f97\u51fa\uff0c\u5728\u7b49\u5dee\u6570\u5217$(a_n)$\u4e2d\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u4efb\u4f55\u4e00\u9879\u4e0e\u5b83\u524d\u9762\u4e00\u9879\u7684\u5dee\u90fd\u7b49\u4e8e\u4e00\u4e2a\u5e38\u6570\uff0c\u5c31\u662f\uff1a\n$a_2-a_1=a_3-a_2=\\cdots=a_n-a_{n-1}=a_{n+1}-a_n=\\cdots$."
    },
    {
      "block": 5,
      "text": "\u6211\u4eec\u628a\u8fd9\u4e2a\u5e38\u6570\u53eb\u505a\u7b49\u5dee\u6570\u5217\u7684\u516c\u5dee.\n\u7b49\u5dee\u6570\u5217\u7684\u516c\u5dee\u901a\u5e38\u7528\u5b57\u6bcd$d$\u8868\u793a."
    },
    {
      "block": 7,
      "text": "1) $a_1=a$\uff0c\u5176\u4e2d$a$\u662f\u67d0\u4e00\u4e2a\u6570\uff1b\n2) \u9012\u63a8\u516c\u5f0f$a_{n+1}=a_n+d$."
    },
    {
      "block": 13,
      "text": "\u7b49\u5dee\u6570\u5217\u5177\u6709\u4e0b\u8ff0\u6027\u8d28\uff1a\u4ece\u7b2c2\u9879\u8d77\uff0c\u7b49\u5dee\u6570\u5217\u7684\u4efb\u4f55\u4e00\u9879\u90fd\u662f\u5b83\u524d\u9762\u4e00\u9879\u548c\u968f\u540e\u4e00\u9879\u7684\u7b97\u672f\u5e73\u5747\u503c."
    },
    {
      "block": 18,
      "text": "\u56e0\u6b64\uff0c\u4e0b\u8ff0\u5b9a\u7406\u6210\u7acb\uff1a\u5f53\u4e14\u4ec5\u5f53\u4ece\u7b2c2\u9879\u8d77\uff0c\u6570\u5217\u7684\u6bcf\u4e00\u9879\u662f\u524d\u9762\u4e00\u9879\u548c\u968f\u540e\u4e00\u9879\u7684\u7b97\u672f\u5e73\u5747\u503c\u65f6\uff0c\u8fd9\u4e2a\u6570\u5217\u624d\u662f\u7b49\u5dee\u6570\u5217."
    }
  ],
