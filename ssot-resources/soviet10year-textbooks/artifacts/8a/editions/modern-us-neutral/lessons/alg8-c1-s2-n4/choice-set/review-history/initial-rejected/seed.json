  "exercises": [
    {
      "number": "24",
      "text": "24. \u5199\u51fa\u51fd\u6570$y=8x^2$\u7684\u56fe\u8c61\u5728\u5e73\u79fb$\\overrightarrow{OO'}$\u4e0b\u7684\u8c61\u7684\u65b9\u7a0b\uff0c\u5176\u4e2d$O$\u662f\u5750\u6807\u539f\u70b9\uff0c$O'$\u7684\u5750\u6807\u5982\u4e0b\uff1a\na) $(9,4)$\uff1b\nb) $(-2,-16)$\uff1b\nc) $(0,5)$\uff1b\nd) $(1,0)$.",
      "figure_ids": []
    },
    {
      "number": "25",
      "text": "25. \u629b\u7269\u7ebf$\\Phi$\u5728\u5e73\u79fb\uff08\u628a\u70b9$O(0,0)$\u6620\u5c04\u5230\u70b9$O'(-3,5)$\uff09\u4e0b\u7684\u8c61\u5177\u6709\u4ec0\u4e48\u6837\u7684\u65b9\u7a0b\uff1f\u8bbe\u5df2\u77e5\u629b\u7269\u7ebf$\\Phi$\u662f\u4e0b\u5217\u51fd\u6570\u7684\u56fe\u8c61\uff1a\na) $y=x^2$\uff1b\nb) $y=-2.5x^2$.",
      "figure_ids": []
    },
    {
      "number": "26",
      "text": "26. \u6c42\u70b9$O'$\u7684\u5750\u6807\uff0c\u5df2\u77e5\u51fd\u6570$y=5x^2$\u7684\u56fe\u8c61\u5728\u5e73\u79fb$\\overrightarrow{OO'}$\uff08$O$\u662f\u5750\u6807\u539f\u70b9\uff09\u4e0b\u6620\u5c04\u5230\u4e0b\u5217\u51fd\u6570\u7684\u56fe\u8c61\uff1a\na) $y=5(x-4)^2+2$\uff1b\nb) $y=5(x+9)^2-8$\uff1b\nc) $y=5(x+27)^2$\uff1b\nd) $y=5x^2-6.3$.",
      "figure_ids": []
    },
    {
      "number": "27",
      "text": "27. \u5e73\u79fb$\\overrightarrow{OO'}$\u628a\u51fd\u6570$y=ax^2$\u7684\u56fe\u8c61\u6620\u5c04\u5230\u4e0b\u5217\u65b9\u7a0b\u7684\u56fe\u8c61\uff1a\na) $y=3(x-2)^2+10$\uff1b\nb) $y=-8(x-1)^2-6$\uff1b\nc) $y=1.5x^2-2$\uff1b\nd) $y=(x-2)^2$\uff1b\ne) $y=-x^2+6$\uff1b\nf) $y=-(x+7)^2$.\u6307\u51fa\u65b9\u7a0b$y=ax^2$\u4e2d\u7cfb\u6570$a$\u7684\u503c\u548c\u70b9$O'$\u7684\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "28",
      "text": "28. \u5236\u4f5c\u4e00\u4e2a\u629b\u7269\u7ebf$y=0.5x^2$\u7684\u6a21\u578b\u677f. \u62ec\u53f7\u4e2d\u7684\u9017\u53f7\u662f\u5c0f\u6570\u5206\u9694\u7b26\u3002\u5229\u7528\u8fd9\u4e2a\u6a21\u578b\u677f\u4f5c\u51fa\u4e0b\u5217\u65b9\u7a0b\u7684\u56fe\u8c61\uff1a\na) $y=0.5(x-1)^2+2$\uff1b\nb) $y=0.5(x+2,5)^2-3$\uff1b\nc) $y=0.5x^2+4$\uff1b\nd) $y=0.5(x+4.5)^2$.",
      "figure_ids": []
    },
    {
      "number": "29",
      "text": "29. \u5229\u7528\u629b\u7269\u7ebf$y=2x^2$\u7684\u6a21\u578b\u677f\u4f5c\u51fa\u4e0b\u5217\u65b9\u7a0b\u7684\u56fe\u8c61\uff1a\na) $y=-2x^2$\uff1b\nb) $y=-2(x+3)^2$\uff1b\nc) $y=-2(x-4)^2-6$\uff1b\nd) $y=-2x^2+8$.",
      "figure_ids": []
    },
    {
      "number": "30",
      "text": "30. \u6307\u51fa\u4f5c\u4e3a\u4e0b\u5217\u65b9\u7a0b\u56fe\u8c61\u7684\u629b\u7269\u7ebf\u9876\u70b9\u7684\u5750\u6807\uff1a\na) $y=3(x-5)^2-2$\uff1b\nb) $y=-2(x+1)^2+3$\uff1b\nc) $y=2x^2-1$\uff1b\nd) $y=(x-5)^2$.\u753b\u51fa\u8fd9\u4e9b\u629b\u7269\u7ebf\u7684\u8349\u56fe.",
      "figure_ids": []
    },
    {
      "number": "31",
      "text": "31. \u628a\u4e0b\u5217\u65b9\u7a0b\u5199\u6210$y=a(x-m)^2+n$\u7684\u5f62\u5f0f\uff1a\na) $y=x^2-6x+1$\uff1b\nb) $y=x^2-4x+4$\uff1b\nc) $y=x^2+3x$\uff1b\nd) $y=x^2+4$.\u5728\u5750\u6807\u5e73\u9762\u4e0a\u5206\u522b\u4f5c\u51fa\u4f5c\u4e3a\u8fd9\u4e9b\u65b9\u7a0b\u56fe\u8c61\u7684\u629b\u7269\u7ebf\u7684\u9876\u70b9\u548c\u5bf9\u79f0\u8f74. \u8fd9\u4e9b\u629b\u7269\u7ebf\u7684\u201c\u5f00\u53e3\u201d\u5411\u4e0a\u8fd8\u662f\u5411\u4e0b\uff1f",
      "figure_ids": []
    },
    {
      "number": "32",
      "text": "32.\na) \u5df2\u77e5\u65b9\u7a0b$10x^2+26x+c=0$\u6709\u4e24\u4e2a\u6839\uff0c\u6c42\u53d8\u6570$c$\u503c\u7684\u96c6\u5408.\nb) \u5df2\u77e5\u65b9\u7a0b$ax^2+18x+3=0$\u6ca1\u6709\u6839\uff0c\u6c42\u53d8\u6570$a$\u503c\u7684\u96c6\u5408.",
      "figure_ids": []
    },
    {
      "number": "33",
      "text": "33. \u6c42\u4e0b\u5217\u591a\u9879\u5f0f\u7684\u6839\uff1a\na) $2y^3+5y^2-3y$\uff1b\nb) $p^4-16$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 22,
      "text": "\u7c7b\u4f3c\u5730\uff0c\u53ef\u4ee5\u8bc1\u660e\uff0c\u65b9\u7a0b$y=a(x-m)^2+n$\u7684\u56fe\u8c61\u4e00\u822c\u662f\u629b\u7269\u7ebf$y=ax^2$\u5728\u5e73\u79fb\uff08\u5750\u6807\u539f\u70b9\u6620\u5c04\u5230\u5750\u6807\u4e3a$(m,n)$\u7684\u70b9\uff09\u4e0b\u7684\u8c61.\n\u8fd9\u91cc\u4e8c\u6b21\u9879\u7cfb\u6570\u4e0d\u4e3a\u96f6\uff0c\u53d8\u91cf\u53d6\u5b9e\u6570\u3002"
    },
    {
      "block": 23,
      "text": "\u629b\u7269\u7ebf\u6709\u5bf9\u79f0\u8f74. \u629b\u7269\u7ebf\u548c\u5b83\u7684\u5bf9\u79f0\u8f74\u7684\u4ea4\u70b9\u53eb\u505a\u629b\u7269\u7ebf\u7684\u9876\u70b9. \u5bf9\u4e8e\u629b\u7269\u7ebf$y=ax^2$\u6765\u8bf4\uff0c\u5bf9\u79f0\u8f74\u662f$y$\u8f74\uff0c\u9876\u70b9\u662f\u70b9$O(0,0)$. \u5f53$a>0$\u65f6\uff0c\u629b\u7269\u7ebf\u7684\u201c\u5f00\u53e3\u201d\u5411\u4e0a\uff0c\u5f53$a<0$\u65f6\u5411\u4e0b."
    },
    {
      "block": 24,
      "text": "\u7531\u5e73\u79fb\u7684\u6027\u8d28\u5f97\u51fa\uff0c\u51fd\u6570$y=a(x-m)^2+n$\u7684\u56fe\u8c61\u662f\u548c\u629b\u7269\u7ebf$y=ax^2$\u5408\u540c\u7684\u629b\u7269\u7ebf\uff0c\u5b83\u7684\u9876\u70b9\u662f\u5750\u6807\u4e3a$(m,n)$\u7684\u70b9\uff0c\u5bf9\u79f0\u8f74\u662f\u76f4\u7ebf$x=m$. \u5f53$a>0$\u65f6\u629b\u7269\u7ebf\u7684\u201c\u5f00\u53e3\u201d\u5411\u4e0a\uff0c\u5f53$a<0$\u65f6\u5411\u4e0b."
    },
    {
      "block": 25,
      "text": "\u524d\u9762\u7684\u8bc1\u660e\u8bf4\u660e\u51fd\u6570$y=a(x-m)^2+n$\u7684\u56fe\u8c61\u662f\u51fd\u6570$y=ax^2$\u7684\u56fe\u8c61\u5728\u5e73\u79fb$\\overrightarrow{OO'}$\u4e0b\u7684\u8c61\uff0c\u5176\u4e2d$O$\u662f\u5750\u6807\u539f\u70b9\uff0c$O'$\u662f\u5750\u6807\u4e3a$(m,n)$\u7684\u70b9. \u7c7b\u4f3c\u5730\u53ef\u4ee5\u8bc1\u660e\u4e00\u822c\u7684\u7ed3\u8bba\uff0c\u5728\u7ed9\u5b9a\u7684\u5e73\u79fb\u4e0b\uff0c\u51fd\u6570$y=f(x-m)+n$\u7684\u56fe\u8c61\u662f\u51fd\u6570$y=f(x)$\u7684\u56fe\u8c61\u7684\u8c61.\n\n\u539f\u51fd\u6570\u7684\u5b9a\u4e49\u57df\u4e5f\u968f\u6a2a\u5411\u4f4d\u79fb\u5e73\u79fb\uff0c\u4e0d\u80fd\u8865\u5165\u539f\u6765\u672a\u5b9a\u4e49\u7684\u70b9\u3002"
    }
  ],
