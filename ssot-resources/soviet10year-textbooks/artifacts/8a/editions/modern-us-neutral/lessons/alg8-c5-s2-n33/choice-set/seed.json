  "concepts": [
    {
      "block": 1,
      "text": "\u5b9a\u4e491 \u4e0d\u8d85\u8fc7\u6570 $x$ \u7684\u6700\u5927\u6574\u6570\u53eb\u505a $x$ \u7684\u6574\u6570\u90e8\u5206\u3002"
    },
    {
      "block": 2,
      "text": "\u6211\u4eec\u7528\u7b26\u53f7 $[x]$ \u8868\u793a\u6570 $x$ \u7684\u6574\u6570\u90e8\u5206\u3002"
    },
    {
      "block": 8,
      "text": "$[x]\\leqslant x<[x]+1$\u3002"
    },
    {
      "block": 12,
      "text": "\u5b9a\u4e492 \u6570 $x$ \u4e0e\u5b83\u7684\u6574\u6570\u90e8\u5206\u7684\u5dee\u53eb\u505a $x$ \u7684\u5c0f\u6570\u90e8\u5206\u3002"
    },
    {
      "block": 13,
      "text": "\u6211\u4eec\u7528\u7b26\u53f7 $\\{x\\}$ \u8868\u793a\u6570 $x$ \u7684\u5c0f\u6570\u90e8\u5206\u3002\n\u56e0\u6b64\uff0c"
    },
    {
      "block": 14,
      "text": "$\\{x\\}=x-[x]$\u3002"
    },
    {
      "block": 17,
      "text": "\u56e0\u4e3a $[x]\\leqslant x<[x]+1$\uff0c\u90a3\u4e48 $0\\leqslant x-[x]<1$\uff0c\u4e5f\u5c31\u662f\u5f53 $x$\u662f\u4efb\u4f55\u6570\u65f6\uff0c\u4e0d\u7b49\u5f0f $0\\leqslant\\{x\\}<1$ \u6210\u7acb\u3002\n\u8fd9\u5c31\u662f\u8bf4\uff0c\u4e00\u4e2a\u6570\u7684\u5c0f\u6570\u90e8\u5206\u662f\u5c0f\u4e8e1\u7684\u975e\u8d1f\u6570\u3002"
    },
    {
      "block": 18,
      "text": "\u6839\u636e\u6570\u7684\u5c0f\u6570\u90e8\u5206\u7684\u5b9a\u4e49\uff0c$\\{x\\}=x-[x]$\u3002\n\u56e0\u6b64 $x=[x]+\\{x\\}$\uff0c\u4e5f\u5c31\u662f\u8bf4\uff0c\u4efb\u4f55\u4e00\u4e2a\u6570 $x$ \u53ef\u4ee5\u5199\u6210\u5b83\u7684\u6574\u6570\u90e8\u5206\u4e0e\u5c0f\u6570\u90e8\u5206\u7684\u548c\u3002"
    }
  ],
