  "concepts": [
    {
      "block": 1,
      "text": "\u5b9a\u4e49 \u5982\u679c\u4e00\u4e2a\u6570\u5217\uff0c\u5b83\u7684\u7b2c1\u9879\u4e0d\u7b49\u4e8e\u96f6\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u6bcf\u4e00\u9879\u90fd\u7b49\u4e8e\u5b83\u524d\u9762\u4e00\u9879\u4e58\u4e0a\u4e00\u4e2a\u4e0d\u7b49\u4e8e\u96f6\u7684\u5e38\u6570\uff0c\u90a3\u4e48\u8fd9\u4e2a\u6570\u5217\u5c31\u53eb\u505a\u7b49\u6bd4\u6570\u5217."
    },
    {
      "block": 3,
      "text": "\u7531\u5b9a\u4e49\u5f97\u51fa\uff0c\u5728\u7b49\u6bd4\u6570\u5217$(b_n)$\u91cc\uff0c\u4ece\u7b2c2\u9879\u8d77\uff0c\u5b83\u7684\u4efb\u4f55\u4e00\u9879\u4e0e\u524d\u9762\u4e00\u9879\u7684\u6bd4\u90fd\u7b49\u4e8e\u4e00\u4e2a\u5e38\u6570\uff1a\n$b_2\\div b_1=b_3\\div b_2=\\cdots=b_n\\div b_{n-1}=b_{n+1}\\div b_n=\\cdots$.\u6211\u4eec\u628a\u8fd9\u4e2a\u5e38\u6570\u53eb\u7b49\u6bd4\u6570\u5217\u7684\u516c\u6bd4\uff0c\u901a\u5e38\u7528\u5b57\u6bcd$q$\u8868\u793a\u5b83."
    },
    {
      "block": 4,
      "text": "\u56e0\u6b64\uff0c\u7b49\u6bd4\u6570\u5217$(b_n)$\u7531\u4e0b\u5217\u4e24\u4e2a\u6761\u4ef6\u786e\u5b9a\uff1a1) $b_1=b(b\\ne0)$\uff1b\n2) \u9012\u63a8\u516c\u5f0f$b_{n+1}=b_n\\cdot q(q\\ne0)$."
    },
    {
      "block": 7,
      "text": "\u6211\u4eec\u53d1\u73b0\uff0c\u5728$q<0$\u7684\u60c5\u51b5\u4e0b\uff0c\u6570\u5217\u7684\u5947\u6570\u9879\u548c\u7b2c1\u9879\u7684\u7b26\u53f7\u76f8\u540c\uff0c\u800c\u6570\u5217\u7684\u5076\u6570\u9879\u548c\u7b2c1\u9879\u7684\u7b26\u53f7\u76f8\u53cd. \u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u6570\u5217\u65e2\u4e0d\u662f\u589e\u6570\u5217\uff0c\u53c8\u4e0d\u662f\u51cf\u6570\u5217."
    },
    {
      "block": 9,
      "text": "\u5982\u679c$q=1$\uff0c\u90a3\u4e48\u6570\u5217\u6240\u6709\u7684\u9879\u5f7c\u6b64\u76f8\u7b49. \u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u6570\u5217\u5c31\u662f\u5e38\u6570\u5217."
    },
    {
      "block": 10,
      "text": "\u7b49\u6bd4\u6570\u5217\u5177\u6709\u4e0b\u8ff0\u6027\u8d28\uff1a\u4ece\u7b2c2\u9879\u8d77\uff0c\u7b49\u6bd4\u6570\u5217\u4efb\u4f55\u4e00\u9879\u90fd\u7b49\u4e8e\u5b83\u7684\u524d\u9762\u4e00\u9879\u4e0e\u968f\u540e\u4e00\u9879\u7684\u6bd4\u4f8b\u4e2d\u9879."
    },
    {
      "block": 16,
      "text": "\u56e0\u6b64\uff0c\u4e0b\u8ff0\u5b9a\u7406\u6210\u7acb\uff1a\u5f53\u4e14\u4ec5\u5f53\u4ece\u7b2c2\u9879\u8d77\uff0c\u6570\u5217\u7684\u4efb\u4f55\u4e00\u9879\u90fd\u7b49\u4e8e\u5b83\u524d\u9762\u4e00\u9879\u4e0e\u968f\u540e\u4e00\u9879\u7684\u6bd4\u4f8b\u4e2d\u9879\u65f6\uff0c\u8fd9\u4e2a\u6570\u5217\u624d\u662f\u7b49\u6bd4\u6570\u5217."
    }
  ],
