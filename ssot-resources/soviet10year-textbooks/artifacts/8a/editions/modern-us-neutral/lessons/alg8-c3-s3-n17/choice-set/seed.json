    {
      "number": "276",
      "text": "276. \u4e3e\u51fa\u7b26\u5408\u4e0b\u5217\u6761\u4ef6\u7684\u7b49\u6bd4\u6570\u5217\u7684\u4f8b\u5b50\uff1a\na) $b_1>0$\uff0c$q>1$\uff1b\nb) $b_1>0$\uff0c$0<q<1$\uff1b\nc) $b_1<0$\uff0c$q>1$\uff1b\nd) $b_1<0$\uff0c$0<q<1$.\u6570\u5217\u662f\u589e\u6570\u5217\u8fd8\u662f\u51cf\u6570\u5217\uff1f",
