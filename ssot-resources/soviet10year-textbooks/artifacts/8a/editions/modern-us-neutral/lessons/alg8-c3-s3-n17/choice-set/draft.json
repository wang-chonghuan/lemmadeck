          {"option_id": "B", "truth": "correct", "derivation": "0.01/0.1=0.001/0.01=0.0001/0.001=1/10。", "misconception": null},
          {"option_id": "C", "truth": "incorrect", "derivation": "首比(1/8)/(1/16)=2，末比16/8=2，中间比为4，不能取统一公比4。", "misconception": "只计算中间的(1/2)/(1/8)=4、2/(1/2)=4、8/2=4，然后将4推广到全列，漏检首尾转换。"},
          {"option_id": "D", "truth": "correct", "derivation": "10/(-1)=(-100)/10=1000/(-100)=(-10000)/1000=-10。", "misconception": null},
          {"option_id": "E", "truth": "incorrect", "derivation": "1.1/1=11/10，但1.11/1.1=111/110，二者不等；若公比为1.1，第三项应为1.21。", "misconception": "只由第二项除第一项得到1.1，见到重复数字便不再检验后续相邻比，将第一比当作全列公比。"},
          {"option_id": "F", "truth": "correct", "derivation": "相邻指数相差1，5^(r+1)/5^r=5，每一比相同且非零。", "misconception": null}
