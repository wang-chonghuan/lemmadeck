      "lines": [
        "434. 约分：",
        "а) $\\frac{(b+4)^2-1}{b^3+125}$； б) $\\frac{(p-5)^2-4}{27-p^3}$；",
        "в) $\\frac{(x-2)^3+27}{x^3+1}$； г) $\\frac{(a+1)^3+1}{a^3-1}$."
      ]
    },
    {
      "kind": "ex",
      "label": "435",
