      "kind": "p",
      "label": null,
      "box": null,
      "owner_exercise": null,
      "cont": false,
      "open": true,
      "samerow": false,
      "lines": [
        "因为这样得到的每一个区",
        "域中的两点及其连线都属于该"
      ]
    },
