  "exercises": [
    {
      "number": "479",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n479. \u5728\u56fe 230 \u4e0a\uff0c\u5df2\u77e5\u4e24\u6761\u5e73\u884c\u7684\u76f4\u7ebf\u4e0e\u53e6\u4e00\u6761\u76f4\u7ebf\u76f8\u4ea4\u3002\u6307\u51fa\u4e24\u8fb9\u7684\u65b9\u5411\u5bf9\u5e94\u76f8\u540c\u7684\u89d2\u3002",
      "figure_ids": [
        "fig-230"
      ]
    },
    {
      "number": "480",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n480. \u5df2\u77e5\u89d2 $AOB$\u3002\u4f5c\u4e00\u4e2a\u89d2\uff0c\u5b83\u7684\u4e24\u6761\u8fb9\u4e0e\u89d2 $AOB$ \u7684\u4e24\u4e2a\u8fb9\u65b9\u5411\u76f8\u540c\uff08\u6216\u65b9\u5411\u76f8\u53cd\uff09\uff0c\u800c\u5b83\u7684\u9876\u70b9\u662f\u5df2\u77e5\u7684\u70b9 $M$\uff1a\n1) $M$ \u5728\u89d2 $AOB$ \u7684\u4e00\u6761\u8fb9\u4e0a\uff1b\n2) $M$ \u4e0d\u5728\u89d2 $AOB$ \u7684\u4e00\u6761\u8fb9\u4e0a\u3002",
      "figure_ids": []
    },
    {
      "number": "481",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n481. \u70b9 $B$ \u5728\u70b9 $A$ \u548c $C$ \u4e4b\u95f4\u3002\u6c42\u51fa\u4e0b\u5217\u5c04\u7ebf\u4e24\u65b9\u5411\u4e4b\u95f4\u7684\u5939\u89d2\uff1a\n1) $[AB)$ \u548c $[BC)$\uff1b\n2) $[AB)$ \u548c $[CB)$\u3002",
      "figure_ids": []
    },
    {
      "number": "482",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n482. \u4f5c\u5c04\u7ebf $AB$ \u548c\u5c04\u7ebf $CD$\uff0c\u5e76\u4f5c\u4e00\u4e2a\u89d2\uff0c\u5b83\u7684\u9876\u70b9\u5728\u5df2\u77e5\u70b9 $M$\uff0c\u5b83\u7684\u5927\u5c0f\u7b49\u4e8e\u8fd9\u4e24\u6761\u5c04\u7ebf\u65b9\u5411\u4e4b\u95f4\u7684\u5939\u89d2\u3002",
      "figure_ids": []
    },
    {
      "number": "483",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n483. \u6c42\u8bc1\uff1a\u5982\u679c\u4e24\u4e2a\u51f8\u89d2\u7684\u8fb9\u65b9\u5411\u76f8\u53cd\uff0c\u8fd9\u4e24\u4e2a\u89d2\u5168\u7b49\u3002",
      "figure_ids": []
    },
    {
      "number": "484",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n484. \u5df2\u77e5\u4e24\u4e2a\u51f8\u89d2\u7684\u4e24\u6761\u8fb9\u65b9\u5411\u76f8\u540c\uff0c\u53e6\u4e24\u6761\u8fb9\u65b9\u5411\u76f8\u53cd\u3002\u6c42\u8bc1\uff1a\u8fd9\u4e24\u4e2a\u89d2\u5927\u5c0f\u7684\u548c\u7b49\u4e8e $180^\\circ$\u3002",
      "figure_ids": []
    },
    {
      "number": "485",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n485. \u4e0b\u5217\u65b9\u5411\u4e4b\u95f4\u7684\u5939\u89d2\u7684\u5927\u5c0f\u7b49\u4e8e\u591a\u5c11\u5ea6\uff1f\n1) \u5357\u65b9\u548c\u897f\u65b9\uff1b\n2) \u5357\u65b9\u548c\u5317\u65b9\uff1b\n3) \u4e1c\u65b9\u548c\u4e1c\u5357\u65b9\u3002",
      "figure_ids": []
    },
    {
      "number": "486",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n486.\n1) \u5982\u56fe 231\uff0c$(AC)\\parallel(FE)$\uff0c\u6307\u51fa\u5927\u5c0f\u7b49\u4e8e $\\alpha$ \u7684\u5404\u89d2\u3002\n2) \u6c42\u51fa\u4e0b\u5217\u5c04\u7ebf\u65b9\u5411\u4e4b\u95f4\u7684\u5939\u89d2\uff1a\na) $BC$ \u548c $DE$\uff1b\nb) $BC$ \u548c $DF$\uff1b\nc) $BA$ \u548c $DR$\uff1b\nd) $BR$ \u548c $DE$\u3002",
      "figure_ids": [
        "fig-231"
      ]
    },
    {
      "number": "487",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n487* \u6c42\u8bc1\uff1a\u5982\u679c\u4e24\u4e2a\u9510\u89d2\uff08\u6216\u949d\u89d2\uff09\u7684\u8fb9\u5f7c\u6b64\u5782\u76f4\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u89d2\u5168\u7b49\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u53d6\u4e24\u4e2a\u65b9\u5411\u3002\n\u4ee5\u5e73\u9762\u4e0a\u4efb\u610f\u4e00\u70b9 $O$ \u4e3a\u59cb\u70b9\uff0c\u4f5c\u5176\u4e2d\u4e00\u4e2a\u65b9\u5411\u7684\u5c04\u7ebf $OA$ \u548c\u53e6\u4e00\u4e2a\u65b9\u5411\u7684\u5c04\u7ebf $OB$\uff08\u56fe 229\uff09\u3002\n\u53e6\u53d6\u4efb\u610f\u4e00\u70b9 $O_1$\uff0c\u5e76\u4e14\u4f5c\u5c04\u7ebf $O_1A_1$ \u548c\u5c04\u7ebf $O_1B_1$\uff0c\u5206\u522b\u4e0e\u5c04\u7ebf $OA$ \u548c $OB$ \u6709\u76f8\u540c\u7684\u65b9\u5411\u3002\n\n\u6211\u4eec\u8ba8\u8bba\u5c06\u70b9 $O$ \u6620\u5c04\u5230\u70b9 $O_1$ \u7684\u5e73\u79fb\u3002\n\u5728\u8fd9\u4e2a\u5e73\u79fb\u4e0b\uff0c\u5c04\u7ebf $OA$ \u7684\u50cf\u662f\u59cb\u70b9\u5728 $O_1$ \u4e14\u4e0e\u5b83\u65b9\u5411\u76f8\u540c\u7684\u5c04\u7ebf\uff08\u89c1\u7b2c 36 \u5c0f\u8282\uff09\uff0c\u5373\u5c04\u7ebf $O_1A_1$\uff0c\u800c\u5c04\u7ebf $OB$ \u7684\u50cf\u662f\u5c04\u7ebf $O_1B_1$\u3002\n\u6240\u4ee5\u51f8\u89d2 $AOB$ \u6620\u5c04\u5230\u51f8\u89d2 $A_1O_1B_1$\uff0c\u56e0\u800c $\\widehat{AOB}=\\widehat{A_1O_1B_1}$\u3002"
    },
    {
      "block": 3,
      "text": "\u56e0\u6b64\uff0c\u4e0d\u8bba\u5728\u5e73\u9762\u4e0a\u600e\u6837\u53d6\u70b9 $O$\uff0c\u6240\u4f5c\u4e24\u6761\u5df2\u77e5\u65b9\u5411\u7684\u5c04\u7ebf $OA$ \u548c $OB$ \u6240\u6210\u7684\u51f8\u89d2\u7684\u5927\u5c0f\u76f8\u540c\u3002\n\u8fd9\u4e2a\u89d2\u7684\u5927\u5c0f\u53eb\u505a\u4e24\u65b9\u5411\u4e4b\u95f4\u7684\u5939\u89d2\u3002\n\u6bcf\u4e00\u4e2a\u65b9\u5411\u548c\u5b83\u672c\u8eab\u7ec4\u6210\u7684\u89d2\u53ef\u4ee5\u770b\u4f5c\u662f $0^\\circ$\u3002"
    },
    {
      "block": 4,
      "text": "\u4ece\u4e0a\u9762\u6240\u4f5c\u8ba8\u8bba\u53ef\u4ee5\u5f97\u51fa\u4e0b\u9762\u7684\u7ed3\u8bba\uff1a\u5982\u679c\u4e24\u4e2a\u51f8\u89d2\u5bf9\u5e94\u8fb9\u7684\u65b9\u5411\u76f8\u540c\uff0c\u8fd9\u4e24\u4e2a\u89d2\u5168\u7b49\u3002"
    },
    {
      "block": 5,
      "text": "\u6ce8\u610f\uff0c\u4e24\u65b9\u5411\u4e4b\u95f4\u7684\u5939\u89d2\u662f\u6307\u5b83\u7684\u5927\u5c0f\uff0c\u800c\u4e0d\u662f\u56fe\u5f62\u3002\n\u5c04\u7ebf $OA$ \u548c $OB$ \u7ec4\u6210\u4e86\u4e24\u4e2a\u89d2 $AOB$\u3002\n\u5c04\u7ebf $OA$ \u548c $OB$ \u4e4b\u95f4\u7684\u5939\u89d2\u662f\u6307\u51f8\u89d2 $AOB$ \u7684\u5927\u5c0f\u3002\n\n\u4e24\u65b9\u5411\u4e4b\u95f4\u7684\u5939\u89d2\u7b49\u4e8e\u8fd9\u4e24\u4e2a\u65b9\u5411\u7684\u4efb\u610f\u7684\u4e24\u6761\u5c04\u7ebf\u4e4b\u95f4\u7684\u5939\u89d2\uff0c\u53ea\u8981\u8fd9\u4e24\u6761\u5c04\u7ebf\u6709\u5171\u540c\u7684\u59cb\u70b9\u3002"
    }
  ],
