  },
  "exercises": [
    {
      "number": "450",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n\u76f4\u7ebf$AB$\u548c\u76f4\u7ebf$CD$\u5e73\u884c\u3002\n1) \u56fe 218 \u4e0a\u54ea\u51e0\u6761\u5c04\u7ebf\u7684\u65b9\u5411\u76f8\u540c\uff1f\n2) \u54ea\u51e0\u6761\u5c04\u7ebf\u7684\u65b9\u5411\u76f8\u53cd\uff1f",
      "figure_ids": [
        "fig-218"
      ]
    },
    {
      "number": "451",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n\u5df2\u77e5\u5c04\u7ebf$AB$\u3002\n1) \u4e0e\u5c04\u7ebf$AB$\u540c\u65b9\u5411\u3001\u8d77\u70b9\u5728\u70b9$M$\u7684\u5c04\u7ebf\u6709\u51e0\u6761\uff1f\n2) \u4e0e\u5c04\u7ebf$AB$\u65b9\u5411\u76f8\u53cd\u3001\u8d77\u70b9\u5728\u70b9$M$\u7684\u5c04\u7ebf\u6709\u51e0\u6761\uff1f",
      "figure_ids": []
    },
    {
      "number": "452",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n1) \u5206\u522b\u4f5c\u4e24\u6761\u65b9\u5411\u76f8\u540c\u7684\u5c04\u7ebf$MA$\u548c$KB$\uff1a\na) \u5b83\u4eec\u4e0d\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\uff1b\nb) \u5b83\u4eec\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\u3002\n2) \u5206\u522b\u4f5c\u4e24\u6761\u65b9\u5411\u76f8\u53cd\u7684\u5c04\u7ebf$MC$\u548c$KD$\uff1a\na) \u5b83\u4eec\u4e0d\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\uff1b\nb) \u5b83\u4eec\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\u3002\n3) \u5229\u7528\u89c4\u5b9a\u7684\u8868\u793a\u65b9\u6cd5\u5199\u51fa\uff1a\u5c04\u7ebf$MA$\u548c\u5c04\u7ebf$KB$\u65b9\u5411\u76f8\u540c\uff0c\u5c04\u7ebf$MC$\u548c\u5c04\u7ebf$KD$\u65b9\u5411\u76f8\u53cd\u3002",
      "figure_ids": []
    },
    {
      "number": "453",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n1) \u65b9\u5411\u76f8\u540c\u7684\u4e24\u6761\u5c04\u7ebf$AB$\u548c$CD$\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\u3002\na) \u8fd9\u4e24\u6761\u5c04\u7ebf\u7684\u5e76\u53ef\u4ee5\u662f\u600e\u6837\u7684\u56fe\u5f62\uff1f\nb) \u8fd9\u4e24\u6761\u5c04\u7ebf\u7684\u4ea4\u53ef\u4ee5\u662f\u600e\u6837\u7684\u56fe\u5f62\uff1f\n2) \u65b9\u5411\u76f8\u53cd\u7684\u4e24\u6761\u5c04\u7ebf$AM$\u548c$BD$\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\u3002\na) \u8fd9\u4e24\u6761\u5c04\u7ebf\u7684\u5e76\u53ef\u4ee5\u662f\u600e\u6837\u7684\u56fe\u5f62\uff1f\nb) \u8fd9\u4e24\u6761\u5c04\u7ebf\u7684\u4ea4\u53ef\u4ee5\u662f\u600e\u6837\u7684\u56fe\u5f62\uff1f\n\n\u4f5c\u56fe\u8868\u793a\u5404\u79cd\u53ef\u80fd\u7684\u60c5\u51b5\uff0c\u5e76\u4e14\u7528\u89c4\u5b9a\u7684\u7b26\u53f7\u5199\u51fa\u7b54\u6848\u3002",
      "figure_ids": []
    },
    {
      "number": "454",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n$454^{\\bullet}.$ \u4e0e\u5df2\u77e5\u5c04\u7ebf\u65b9\u5411\u76f8\u540c\u7684\u5c04\u7ebf\u6709\u591a\u5c11\u6761\uff1f",
      "figure_ids": []
    },
    {
      "number": "455",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n455. \u7ed9\u51fa\u7684\u5c04\u7ebf\u53ef\u4ee5\u6709\u591a\u5c11\u4e2a\u4e0d\u540c\u7684\u65b9\u5411\uff1f\n1) \u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\uff1b\n2) \u5728\u4e24\u6761\u76f8\u4ea4\u7684\u76f4\u7ebf\u4e0a\uff1b\n3) \u5728\u4e09\u89d2\u5f62\u7684\u4e09\u6761\u8fb9\u4e0a\u3002",
      "figure_ids": []
    },
    {
      "number": "456",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n$456^{\\bullet}.$ \u5728\u4e00\u4e2a\u5e73\u9762\u7684\u5c04\u7ebf\u7684\u96c6\u5408\u4e0a\uff0c\u65b9\u5411\u76f8\u53cd\u7684\u5173\u7cfb\u662f\u7b49\u4ef7\u5173\u7cfb\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "457",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n457. \u5df2\u77e5\u5c04\u7ebf $OM$\u3002\u4f5c\u4e00\u6761\u5c04\u7ebf\uff0c\u4f7f\u5b83\u4e0e\u5c04\u7ebf $OM$ \u5173\u4e8e\u4e2d\u5fc3$P$ \u6210\u4e2d\u5fc3\u5bf9\u79f0\uff0c\u800c\u4e14\n1) \u8fd9\u6761\u5c04\u7ebf\u5728\u76f4\u7ebf $OM$ \u4e0a\uff1b\n2) \u8fd9\u6761\u5c04\u7ebf\u4e0d\u5728\u76f4\u7ebf $OM$ \u4e0a\u3002",
      "figure_ids": []
    },
    {
      "number": "458",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n458.\n1) \u6c42\u8bc1\uff1a\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\u65b9\u5411\u76f8\u53cd\u7684\u4e24\u6761\u5c04\u7ebf\u662f\u4e2d\u5fc3\u5bf9\u79f0\u7684\u3002\u600e\u6837\u6c42\u51fa\u8fd9\u4e24\u6761\u5c04\u7ebf\u7684\u5bf9\u79f0\u4e2d\u5fc3\uff1f\n2) \u6c42\u8bc1\uff1a\u5728\u4e2d\u5fc3\u5bf9\u79f0\u4e0b\uff0c\u5e73\u9762\u4e0a\u6bcf\u4e00\u6761\u5c04\u7ebf\u6620\u5c04\u5230\u4e0e\u5b83\u65b9\u5411\u76f8\u53cd\u7684\u5c04\u7ebf\u3002",
      "figure_ids": []
    },
    {
      "number": "459",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n$459^{*}.$\n1) \u4e0b\u9762\u7684\u56fe\u5f62\u5206\u522b\u6709\u591a\u5c11\u5bf9\u4e92\u76f8\u5e73\u884c\u7684\u8fb9\uff1f\na) \u51f8\u56db\u8fb9\u5f62\uff1b\nb) \u51f8\u4e94\u8fb9\u5f62\uff1b\nc) \u51f8\u516d\u8fb9\u5f62\u3002\n2) \u8fb9\u6570\u662f\u5947\u6570\u7684\u591a\u8fb9\u5f62\u6709\u5bf9\u79f0\u4e2d\u5fc3\u5417\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "a) \u8bbe\u5c04\u7ebf$AB$\u548c$CD$\u5728\u4e0d\u540c\u7684\u5e73\u884c\u76f4\u7ebf\u4e0a*\u3002\n\u7ecf\u8fc7\u70b9$A$\u548c\u70b9$C$\u4f5c\u4e00\u76f4\u7ebf\uff0c\u5f97\u5230\u4ee5$AC$\u4e3a\u754c\u7684\u4e24\u4e2a\u534a\u5e73\u9762\u3002\n\u5982\u679c\u5c04\u7ebf$AB$\u548c\u5c04\u7ebf$CD$\u5728\u540c\u4e00\u4e2a\u534a\u5e73\u9762\u4e0a\uff0c\u90a3\u4e48\u5b83\u4eec\u53eb\u505a\u65b9\u5411\u76f8\u540c\uff08\u56fe 214\uff0ca\uff09\u3002\n\n\u5982\u679c\u5c04\u7ebf$AB$\u548c\u5c04\u7ebf$CD$\u5728\u4e0d\u540c\u7684\u534a\u5e73\u9762\u4e0a\uff0c\u90a3\u4e48\u5b83\u4eec\u53eb\u505a\u65b9\u5411\u76f8\u53cd\uff08\u56fe 214\uff0cb\uff09\u3002"
    },
    {
      "block": 2,
      "text": "* \u5982\u679c\u4e24\u6761\u5c04\u7ebf\uff08\u7ebf\u6bb5\uff09$AB$\u548c$CD$\u5728\u4e92\u76f8\u5e73\u884c\u7684\u76f4\u7ebf\u4e0a\uff0c\u90a3\u4e48\u5c31\u8bf4\u8fd9\u4e24\u6761\u5c04\u7ebf\uff08\u7ebf\u6bb5\uff09\u5e73\u884c\u3002"
    },
    {
      "block": 7,
      "text": "b) \u8bbe\u5c04\u7ebf$AB$\u548c\u5c04\u7ebf$CD$\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\u3002\n\u5982\u679c\u8fd9\u4e24\u6761\u5c04\u7ebf\u4e2d\u7684\u4e00\u6761\u5c04\u7ebf\u5305\u542b\u53e6\u4e00\u6761\uff0c\u90a3\u4e48\u5b83\u4eec\u53eb\u505a\u65b9\u5411\u76f8\u540c\uff08\u56fe 215\uff0ca\uff09\u3002\n\u5982\u679c\u5c04\u7ebf$AB$\u548c\u5c04\u7ebf$CD$\u4e2d\u7684\u4efb\u4e00\u6761\u5c04\u7ebf\u90fd\u4e0d\u5305\u542b\u53e6\u4e00\u6761\u65f6\uff0c\u90a3\u4e48\u5b83\u4eec\u53eb\u505a\u65b9\u5411\u76f8\u53cd\uff08\u56fe 215\uff0cb\uff09\u3002"
    },
    {
      "block": 8,
      "text": "\u5c04\u7ebf$AB$\u548c$CD$\u65b9\u5411\u76f8\u540c\u8bb0\u4f5c\uff1a\n$[AB)\\uparrow\\uparrow[CD)$\u3002\n\u5982\u679c\u5c04\u7ebf$AB$\u548c$CD$\u65b9\u5411\u76f8\u53cd\uff0c\u90a3\u4e48\u8bb0\u4f5c\uff1a\n$[AB)\\uparrow\\downarrow[CD)$\u3002"
    },
    {
      "block": 9,
      "text": "\u89c2\u5bdf\u56fe 216\uff0ca\uff0c\u53ef\u4ee5\u53d1\u73b0\u5c04\u7ebf\u65b9\u5411\u76f8\u540c\u8fd9\u4e00\u5173\u7cfb\u5177\u6709\u81ea\u53cd\u6027\u3001\u5bf9\u79f0\u6027\u548c\u4f20\u9012\u6027\uff1a\n1) $[A_1B_1)\\uparrow\\uparrow[A_1B_1)$\uff1b\n2) \u5982\u679c$[A_1B_1)\\uparrow\\uparrow[A_2B_2)$\uff0c\u90a3\u4e48$[A_2B_2)\\uparrow\\uparrow[A_1B_1)$\uff1b\n\n3) \u5982\u679c$[A_1B_1)\\uparrow\\uparrow[A_2B_2)$\u548c$[A_2B_2)\\uparrow\\uparrow[A_3B_3)$\uff0c\u90a3\u4e48$[A_1B_1)$ $\\uparrow\\uparrow[A_3B_3)$\u3002"
    },
    {
      "block": 12,
      "text": "\u5c31\u662f\u8bf4\uff0c\u5c04\u7ebf\u65b9\u5411\u76f8\u540c\u7684\u5173\u7cfb\u662f\u7b49\u4ef7\u5173\u7cfb\u3002"
    },
    {
      "block": 13,
      "text": "\u4efb\u610f\u4e00\u6761\u5c04\u7ebf\u786e\u5b9a\u4e0e\u5b83\u65b9\u5411\u76f8\u540c\u7684\u5c04\u7ebf\u7684\u96c6\u5408\uff08\u56fe 216\uff0cb\uff09\u3002\n\u4e0e\u540c\u4e00\u6761\u5c04\u7ebf\u65b9\u5411\u76f8\u540c\u7684\u6240\u6709\u5c04\u7ebf\u7684\u96c6\u5408\uff0c\u53eb\u505a\u65b9\u5411\u3002\n\u65b9\u5411\u53ef\u4ee5\u5229\u7528\u4e00\u6761\u5c04\u7ebf\u7ed9\u51fa\u5e76\u8bf4\u6210\u662f\u8fd9\u6761\u5c04\u7ebf\u7684\u65b9\u5411\u3002"
    },
    {
      "block": 14,
      "text": "\u5b9a\u7406 43\uff08\u5173\u4e8e\u65b9\u5411\u76f8\u53cd\u7684\u5c04\u7ebf\u7684\u5bf9\u79f0\u6027\uff09\u3002\n\u4e24\u6761\u65b9\u5411\u76f8\u53cd\u7684\u5c04\u7ebf\u5173\u4e8e\u8fde\u63a5\u5b83\u4eec\u8d77\u70b9\u7684\u7ebf\u6bb5\u7684\u4e2d\u70b9\u5bf9\u79f0\u3002"
    },
    {
      "block": 20,
      "text": "\u8fd8\u6709\u5982\u4e0b\u7ed3\u8bba\uff1a\u4e24\u6761\u4e2d\u5fc3\u5bf9\u79f0\u7684\u5c04\u7ebf\u65b9\u5411\u76f8\u53cd\u3002"
    }
  ],
