    "figure_ids":[],
    "options":[
      {"id":"a","text":"任取 $X,Y\\in A\\cap B$，由 $A$ 凸得 $[X,Y]\\subseteq A$，从而整段也在 $B$ 中，故在交集中。","figure_ids":[]},
      {"id":"b","text":"任取 $X,Y\\in A\\cap B$，二者在 $A$ 或 $B$ 中，故整段在 $A$ 或 $B$ 中，也就全在交集中。","figure_ids":[]},
      {"id":"c","text":"任取 $X,Y\\in A\\cap B$，二者同时在 $A,B$ 中，各自的凸性使整段同时在 $A,B$ 中，故在交集中。","figure_ids":[]},
      {"id":"d","text":"任取 $X,Y\\in A\\cap B$，交集是凸集 $A$ 的子集，而凸集的每个子集也凸，所以整段在交集中。","figure_ids":[]}
    ]
