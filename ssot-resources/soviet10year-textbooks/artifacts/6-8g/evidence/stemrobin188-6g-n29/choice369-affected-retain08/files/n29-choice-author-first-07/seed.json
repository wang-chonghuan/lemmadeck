  "exercises": [
    {
      "number": "364",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n364. \u5df2\u77e5\u5706\u5468 $(O,r)$ \u548c\u76f4\u7ebf $a$\u3002\u5f53\u76f4\u7ebf $a$ \u5230\u5706\u5fc3 $O$ \u7684\u8ddd\u79bb\u5206\u522b\u6ee1\u8db3\u4e0b\u5217\u6761\u4ef6\u65f6\uff0c\u5706\u5468\u4e0e\u76f4\u7ebf\u7684\u76f8\u5173\u4f4d\u7f6e\u600e\u6837\uff1f\n1) \u5927\u4e8e $r$\uff1b\n2) \u5c0f\u4e8e $r$\uff1b\n3) \u7b49\u4e8e $r$\u3002",
      "figure_ids": []
    },
    {
      "number": "365",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n365. \u5728\u5df2\u77e5\u89d2 $AOB$ \u7684\u4e24\u6761\u8fb9\u4e0a\uff0c\u5206\u522b\u4f5c\u51fa\u6ee1\u8db3\u4e0b\u5217\u6761\u4ef6\u7684\u70b9\uff1a\n1) \u5230\u89d2\u7684\u9876\u70b9\u7684\u8ddd\u79bb\u4e3a $a$\uff1b\n2) \u5230\u89d2 $AOB$ \u5185\u90e8\u533a\u57df\u4e2d\u4e00\u70b9 $M$ \u7684\u8ddd\u79bb\u4e3a $a$\u3002",
      "figure_ids": []
    },
    {
      "number": "366",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n366. \u5df2\u77e5\u76f4\u7ebf $a$ \u548c\u76f4\u7ebf\u4e0a\u7684\u4e00\u70b9 $M$\u3002\u6c42\u4f5c\u534a\u5f84\u4e3a $r$ \u7684\u5706\u5468\uff0c\u4f7f\u5b83\u4e0e\u76f4\u7ebf $a$ \u76f8\u5207\u4e8e\u70b9 $M$\u3002",
      "figure_ids": []
    },
    {
      "number": "367",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n367. \u7ecf\u8fc7\u5df2\u77e5\u5706\u5468\u4e0a\u7684\u4e00\u4e2a\u5df2\u77e5\u70b9\uff0c\u4f5c\u8fd9\u4e2a\u5706\u5468\u7684\u5207\u7ebf\u3002",
      "figure_ids": []
    },
    {
      "number": "368",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n368.\n1) \u6c42\u4f5c\u4e00\u4e2a\u5706\u5468\uff0c\u4f7f\u5b83\u4e0e\u5df2\u77e5\u89d2\u7684\u4e24\u6761\u8fb9\u90fd\u76f8\u5207\u3002\n2) \u6c42\u4f5c\u4e00\u4e2a\u5706\u5468\uff0c\u4f7f\u5b83\u4e0e\u5df2\u77e5\u89d2\u7684\u4e24\u6761\u8fb9\u90fd\u76f8\u5207\uff0c\u5e76\u7ecf\u8fc7\u5176\u4e2d\u4e00\u6761\u8fb9\u4e0a\u7684\u4e00\u4e2a\u5df2\u77e5\u70b9\u3002",
      "figure_ids": []
    },
    {
      "number": "369",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n369. \u6c42\u4e0e\u5df2\u77e5\u89d2\u7684\u4e24\u6761\u8fb9\u90fd\u76f8\u5207\u7684\u5706\u5468\u7684\u5706\u5fc3\u96c6\u5408\u3002",
      "figure_ids": []
    },
    {
      "number": "370",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n370. \u4e24\u4e2a\u5706\u5468\u76f8\u5207\u4e8e\u70b9 $A$\u3002\u662f\u5426\u5b58\u5728\u4e00\u6761\u7ecf\u8fc7\u70b9 $A$\uff0c\u5e76\u4e14\u4e0e\u8fd9\u4e24\u4e2a\u5706\u5468\u90fd\u76f8\u5207\u7684\u76f4\u7ebf\uff1f",
      "figure_ids": []
    },
    {
      "number": "371",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n371. \u6c42\u4f5c\u4e00\u4e2a\u5706\u5468\uff0c\u4f7f\u5b83\u4e0e\u5df2\u77e5\u4e09\u89d2\u5f62\u7684\u4e09\u6761\u8fb9\u90fd\u76f8\u5207\u3002",
      "figure_ids": []
    },
    {
      "number": "372",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n372. \u70b9 $O(O\\in p)$ \u662f\u76f4\u7ebf $p$ \u4e0a\u79bb\u70b9 $A(A\\notin p)$ \u6700\u8fd1\u7684\u70b9\u3002\n\u6c42\u8bc1\uff1a$(OA)\\perp p$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 5,
      "text": "1) \u5982\u679c\u5706\u5fc3\u5230\u76f4\u7ebf\u7684\u8ddd\u79bb\u5927\u4e8e\u534a\u5f84\uff0c\u90a3\u4e48\u76f4\u7ebf\u4e0e\u5706\u5468\u6ca1\u6709\u4ea4\u70b9\u3002"
    },
    {
      "block": 7,
      "text": "2) \u5982\u679c\u5706\u5fc3\u5230\u76f4\u7ebf\u7684\u8ddd\u79bb\u7b49\u4e8e\u534a\u5f84\uff0c\u90a3\u4e48\u76f4\u7ebf\u4e0e\u5706\u5468\u6709\u4e14\u4ec5\u6709\u4e00\u4e2a\u4ea4\u70b9\u3002"
    },
    {
      "block": 10,
      "text": "35 \u5b9a\u7406\u3002\n\u7ecf\u8fc7\u534a\u5f84\u5728\u5706\u5468\u4e0a\u7684\u7aef\u70b9\uff0c\u5e76\u4e14\u5782\u76f4\u4e8e\u8fd9\u6761\u534a\u5f84\u7684\u76f4\u7ebf\uff0c\u662f\u8fd9\u4e2a\u5706\u5468\u7684\u5207\u7ebf\uff08\u56fe $188$\uff09\u3002"
    },
    {
      "block": 11,
      "text": "3) \u5982\u679c\u5706\u5fc3\u5230\u76f4\u7ebf\u7684\u8ddd\u79bb\u5c0f\u4e8e\u534a\u5f84\uff08$h<r$\uff09\uff0c\u90a3\u4e48\u76f4\u7ebf\u4e0e\u5706\u5468\u6709\u4e24\u4e2a\u4ea4\u70b9\uff08\u56fe $187$\uff0c(c)\uff09\u3002\n\u8fd9\u4e2a\u7ed3\u8bba\u7684\u8bc1\u660e\u8f83\u590d\u6742\uff0c\u8fd9\u91cc\u7565\u53bb\u3002"
    },
    {
      "block": 15,
      "text": "36 \u5706\u5468\u4e0e\u76f4\u7ebf\u53ef\u80fd\u6ca1\u6709\u4ea4\u70b9\uff0c\u4e5f\u53ef\u80fd\u6709\u4e00\u4e2a\u6216\u4e24\u4e2a\u4ea4\u70b9\u3002"
    },
    {
      "block": 17,
      "text": "**37** \u5b9a\u7406\u3002\n**\u5706\u5468\u7684\u5207\u7ebf\u5782\u76f4\u4e8e\u7ecf\u8fc7\u5207\u70b9\u7684\u534a\u5f84\u3002\n**"
    }
  ],
