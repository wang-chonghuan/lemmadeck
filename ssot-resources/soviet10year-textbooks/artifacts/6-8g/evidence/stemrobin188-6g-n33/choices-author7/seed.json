  "exercises": [
    {
      "number": "441",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n441\uff0e\u6c42\u8bc1\u4e0b\u9762\u7684\u547d\u9898 $A$ \u4e0e\u547d\u9898 $B$ \u7b49\u4ef7\uff1a\n\u547d\u9898\uff08$B$\uff09\uff1a\u5982\u679c\u76f4\u7ebf $a$ \u4e0e $c$ \u5782\u76f4\uff0c\u800c\u76f4\u7ebf $b$ \u4e0e $c$ \u76f8\u4ea4\uff0c\u4f46\u4e0d\u4e0e\u5b83\u5782\u76f4\uff0c\u90a3\u4e48\u76f4\u7ebf $a$ \u4e0e $b$ \u76f8\u4ea4\uff0e\n\u547d\u9898\uff08$A$\uff09\uff1a\u7ecf\u8fc7\u4efb\u610f\u4e00\u70b9\u81f3\u591a\u53ef\u4ee5\u5f15\u4e00\u6761\u76f4\u7ebf\uff0c\u4e0e\u5df2\u77e5\u76f4\u7ebf\u5e73\u884c\uff0e",
      "figure_ids": []
    },
    {
      "number": "442",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n442. \u4e3e\u51fa\u4e00\u4e9b\u5b9a\u7406\u4f5c\u4e3a\u4f8b\u5b50\uff0c\u5728\u8bc1\u660e\u8fd9\u4e9b\u5b9a\u7406\u65f6\u5e94\u7528\u4e86\u5e73\u884c\u516c\u7406\uff0e",
      "figure_ids": []
    },
    {
      "number": "443",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n443. \u4e3e\u51fa\u4e00\u4e9b\u5b9a\u7406\u4f5c\u4e3a\u4f8b\u5b50\uff0c\u8bc1\u660e\u8fd9\u4e9b\u5b9a\u7406\u4e0d\u4f9d\u8d56\u5e73\u884c\u516c\u7406\uff0e",
      "figure_ids": []
    },
    {
      "number": "444",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n444. \u6c42\u8bc1\uff1a\u5982\u679c\u4e24\u6761\u76f4\u7ebf\u4e0e\u7b2c\u4e09\u6761\u76f4\u7ebf\u76f8\u4ea4\uff0c\u5176\u540c\u4f4d\u89d2\u5408\u540c\uff0c\u90a3\u4e48\u8fd9\u4e24\u6761\u76f4\u7ebf\u5e73\u884c\uff0e",
      "figure_ids": []
    },
    {
      "number": "445",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n445**. \u4e0d\u5229\u7528\u5e73\u884c\u516c\u7406\uff0c\u8bc1\u660e\u4e09\u89d2\u5f62 $ABC$ \u4e2d\u89d2 $A$ \u7684\u90bb\u8865\u89d2\u5927\u4e8e\u89d2 $B$ \u6216\u89d2 $C$ \u4e2d\u7684\u4efb\u4e00\u4e2a\uff0e",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5229\u7528\u4f60\u4eec\u5df2\u77e5\u7684\u51e0\u4f55\u547d\u9898\uff0c\u53ef\u4ee5\u8bc1\u660e\u6211\u4eec\u6240\u91c7\u7528\u7684\u5e73\u884c\u516c\u7406 $A$\uff08\u201c\u7ecf\u8fc7\u4efb\u610f\u4e00\u70b9\u81f3\u591a\u53ef\u4ee5\u5f15\u4e00\u6761\u76f4\u7ebf\uff0c\u4e0e\u5df2\u77e5\u76f4\u7ebf\u5e73\u884c\u201d\uff09\u53ef\u4ee5\u7528\u4e0e\u5b83\u7b49\u4ef7\u7684\u5176\u4ed6\u8bba\u65ad\u6765\u4ee3\u66ff\uff0e\n\n\uff08\u8bba\u65ad $A$ \u4e0e\u8bba\u65ad $B$ \u7b49\u4ef7\u7684\u610f\u601d\u662f\uff1a\u4ece $A$ \u53ef\u4ee5\u63a8\u51fa $B$\uff0c\u4ece $B$ \u4e5f\u53ef\u4ee5\u63a8\u51fa $A$\uff0e\uff09\u4f8b\u5982\uff0c\u4f5c\u4e3a\u8fd9\u6837\u7684\u8bba\u65ad $E$ \u53ef\u4ee5\u91c7\u7528\u4e0b\u8ff0\u547d\u9898\uff1a\u5782\u76f4\u7ebf\u4e0e\u659c\u7ebf\u76f8\u4ea4\uff0c\u6216\u8005\u66f4\u7cbe\u786e\u5730\u8bf4\uff0c\u5982\u679c\u76f4\u7ebf $a$ \u4e0e $c$ \u5782\u76f4\uff0c\u800c\u76f4\u7ebf $b$ \u4e0e $c$ \u76f8\u4ea4\uff0c\u4f46\u4e0d\u4e0e\u76f4\u7ebf $c$ \u5782\u76f4\uff0c\u90a3\u4e48\u76f4\u7ebf $a$ \u548c $b$ \u76f8\u4ea4\uff08\u56fe 209\uff09\uff0e"
    }
