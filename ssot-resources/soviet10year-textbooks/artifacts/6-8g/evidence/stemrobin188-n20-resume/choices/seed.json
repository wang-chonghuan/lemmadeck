  "exercises": [
    {
      "number": "242",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n242. \u5728\u5e73\u9762\u4e0a\u53d6\u70b9 $O$ \u548c\u70b9 $A,B,C$.\n1) \u6c42\u4f5c\u70b9 $M=Z_O(A)$\uff0c$P=Z_O(B),D=Z_O(C)$.\n2) \u5728\u8fd9\u4e2a\u56fe\u4e0a\u6807\u51fa\u70b9 $Z_O(M)$\uff0c$Z_O(P),Z_O(D),Z_O(O)$.",
      "figure_ids": []
    },
    {
      "number": "243",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n243.\n1) \u5e73\u9762\u4e0a\u4ec0\u4e48\u6837\u7684\u70b9\u5728\u4e2d\u5fc3\u5bf9\u79f0\u4e0b\u88ab\u6620\u5c04\u5230\u5b83\u81ea\u8eab\uff1f\n2) \u54ea\u4e9b\u76f4\u7ebf\u5728\u4e2d\u5fc3\u5bf9\u79f0\u4e0b\u88ab\u6620\u5c04\u5230\u5b83\u81ea\u8eab\u4e0a\uff1f\n3) \u5df2\u77e5\u4e2d\u5fc3\u5bf9\u79f0\u7531\u4e00\u5bf9\u5bf9\u5e94\u70b9\u7ed9\u51fa\uff1a$A\\to A_1$\uff0c\u8fd9\u65f6\u600e\u6837\u6c42\u5176\u5bf9\u79f0\u4e2d\u5fc3\uff1f",
      "figure_ids": []
    },
    {
      "number": "244",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n244. \u4ee5\u4e0b\u5404\u662f\u4ec0\u4e48\u56fe\u5f62\uff1f\n1) \u76f4\u7ebf $AB$ \u5728\u5173\u4e8e\u70b9 $O[O\\in(AB)]$\u5bf9\u79f0\u4e0b\u7684\u8c61\uff1b\n2) \u5c04\u7ebf $OC$ \u5728\u5173\u4e8e\u4e2d\u5fc3 $O$ \u5bf9\u79f0\u4e0b\u7684\u8c61\uff1b\n3) \u89d2 $ABC$ \u5728\u5173\u4e8e\u70b9 $B$ \u5bf9\u79f0\u4e0b\u7684\u8c61.",
      "figure_ids": []
    },
    {
      "number": "245",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n245.\n1) \u5728\u4e0b\u5217\u60c5\u51b5\u4e0b\uff0c\u5206\u522b\u6c42\u4f5c\u4e0e\u5df2\u77e5\u7ebf\u6bb5 $AB$ \u5173\u4e8e\u5df2\u77e5\u4e2d\u5fc3 $O$ \u5bf9\u79f0\u7684\u7ebf\u6bb5\uff1a\na) $O\\in(AB)$\uff1b\nb) $O\\notin(AB)$.\n2) \u6c42\u4f5c\u4e0e\u5df2\u77e5\u76f4\u7ebf $AB$ \u5173\u4e8e\u5df2\u77e5\u4e2d\u5fc3 $O\\notin(AB)$ \u5bf9\u79f0\u7684\u76f4\u7ebf.\n3) \u5728\u4e0b\u5217\u60c5\u51b5\u4e0b\uff0c\u5206\u522b\u7528\u7ec6\u659c\u7ebf\u8868\u793a\u51fa\u4ee5 $AB$ \u4e3a\u8fb9\u754c\u7684\u5df2\u77e5\u534a\u5e73\u9762\u5728\u5bf9\u79f0 $Z_O$ \u4e0b\u7684\u8c61\uff1a\na) $O\\in(AB)$\uff1b\nb) $O\\notin(AB)$.",
      "figure_ids": []
    },
    {
      "number": "246",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n246. \u4ec0\u4e48\u6837\u7684\u56fe\u5f62\u53eb\u505a\u4e2d\u5fc3\u5bf9\u79f0\u56fe\u5f62\uff1f\u4e3e\u4e00\u4e9b\u4e2d\u5fc3\u5bf9\u79f0\u56fe\u5f62\u7684\u4f8b\u5b50.",
      "figure_ids": []
    },
    {
      "number": "247",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n247.\n1) \u7ebf\u6bb5\uff0c\u76f4\u7ebf\uff0c\u5c04\u7ebf\uff0c\u5706\u5468\uff0c\u4e24\u6761\u76f8\u4ea4\u76f4\u7ebf\u7684\u5e76\u96c6\u5404\u6709\u65e0\u5bf9\u79f0\u4e2d\u5fc3\uff1f\n2) \u662f\u5426\u5b58\u5728\u5177\u6709\u5bf9\u79f0\u4e2d\u5fc3\u7684\u4e09\u89d2\u5f62\uff08\u56db\u8fb9\u5f62\uff0c\u4e94\u8fb9\u5f62\uff09\uff1f\n3) \u662f\u5426\u5b58\u5728\u5177\u6709\u4e24\u4e2a\u4ee5\u4e0a\u7684\u5bf9\u79f0\u4e2d\u5fc3\u7684\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "252",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n252. \u5df2\u77e5\u70b9 $O$ \u662f\u7ebf\u6bb5 $AA_1$ \u7684\u4e2d\u70b9\uff0c\u5728\u4e0b\u5217\u60c5\u51b5\u4e0b\uff0c\u7528\u4e00\u4e2a\u5706\u89c4\u5206\u522b\u4f5c\u70b9 $B$ \u5728\u5bf9\u79f0 $Z_O$ \u4e0b\u7684\u8c61\uff1a\n1) $B\\in[AA_1]$\uff1b\n2) $B\\notin[AA_1]$.",
      "figure_ids": []
    },
    {
      "number": "253",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n253.* \u6c42\u8bc1\uff1a\u5bf9\u9876\u89d2\u7684\u5e73\u5206\u7ebf\u5728\u540c\u4e00\u6761\u76f4\u7ebf\u4e0a.",
      "figure_ids": []
    },
    {
      "number": "254",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n254.* \u6c42\u8bc1\uff1a\n1) \u534a\u5f84\u76f8\u7b49\u7684\u4e24\u4e2a\u5706\u5468\u5408\u540c\uff1b\n2) \u5177\u6709\u516c\u5171\u8fb9\u754c\u7684\u4e24\u4e2a\u534a\u5e73\u9762\u5408\u540c.",
      "figure_ids": []
    },
    {
      "number": "255",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n255. \u5df2\u77e5\u76f4\u7ebf $a$ \u4e0e\u70b9 $B\\notin a$. \u6c42\u4f5c\u51e0\u4e2a\u8fd9\u6837\u7684\u70b9 $M$\uff0c\u4f7f\u5f97\u70b9$B$ \u5728\u5173\u4e8e\u4e2d\u5fc3 $M$ \u7684\u5bf9\u79f0\u4e0b\u7684\u8c61\u5728\u76f4\u7ebf $a$ \u4e0a.",
      "figure_ids": []
    },
    {
      "number": "256",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n256.* \u7ebf\u6bb5 $A_1B_1$ \u4e0e $A_2B_2$ \u90fd\u4ee5 $O$ \u4e3a\u4e2d\u70b9. \u6c42\u8bc1\uff1a\n1) \u7ebf\u6bb5 $A_1A_2$\u4e0e $B_1B_2$\uff0c$A_1B_2$ \u4e0e $A_2B_1$ \u5206\u522b\u5408\u540c\uff1b\n2) \u7ebf\u6bb5 $A_1A_2$ \u4e0e $B_1B_2$\u7684\u4e2d\u70b9\u5728\u8fc7\u70b9 $O$ \u7684\u540c\u4e00\u6761\u76f4\u7ebf\u4e0a.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 5,
      "text": "\u4ece\u4f5c\u56fe\u770b\u5230\uff08\u770b\u56fe 113\uff09\uff0c\u5e73\u9762\u4e0a\u4efb\u4e00\u70b9 $X$ \u5728\u4e0a\u8ff0\u65cb\u8f6c\u4e0b\u7684\u8c61\u662f\u8fd9\u6837\u7684\u70b9 $X_1$\uff0c\u4f7f\u5f97\u4e2d\u5fc3 $O$ \u4e3a\u7ebf\u6bb5 $XX_1$ \u7684\u4e2d\u70b9.\n\u6b63\u5982\u6211\u4eec\u6240\u77e5\uff0c$X$ \u4e0e $X_1$ \u8fd9\u6837\u7684\u4e24\u70b9\u53eb\u505a\u5173\u4e8e\u4e2d\u5fc3 $O$ \u5bf9\u79f0\u7684\u70b9.\n\u65cb\u8f6c\u89d2\u4e3a $180^\\circ$ \u7684\u65cb\u8f6c\u53eb\u505a\u4e2d\u5fc3\u5bf9\u79f0\uff0c\u5e76\u7528 $Z_O$ \u6765\u8868\u793a\u5173\u4e8e\u4e2d\u5fc3 $O$\u7684\u5bf9\u79f0."
    },
    {
      "block": 7,
      "text": "22 \u4e2d\u5fc3\u5bf9\u79f0\u662f\u4f4d\u79fb."
    },
    {
      "block": 17,
      "text": "\u5728\u5173\u4e8e\u67d0\u4e2a\u4e2d\u5fc3 $O$ \u7684\u5bf9\u79f0\u4e0b\u88ab\u6620\u5c04\u5230\u5b83\u81ea\u8eab\u4e0a\u7684\u56fe\u5f62\u53eb\u505a\u4e2d\u5fc3\u5bf9\u79f0\u56fe\u5f62\uff08\u4e5f\u53ef\u4ee5\u8bf4\uff0c\u8fd9\u4e2a\u56fe\u5f62\u5177\u6709\u5bf9\u79f0\u4e2d\u5fc3\uff09."
    }
  ],
