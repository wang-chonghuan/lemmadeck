{
  "exercises": [
    {
      "number": "432",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n432\uff0e\u6c42\u8bc1\uff1a\u7ecf\u8fc7\u5e73\u9762\u4e0a\u4efb\u610f\u4e00\u70b9\uff0c\u6709\u4e00\u6761\u800c\u4e14\u4ec5\u6709\u4e00\u6761\u76f4\u7ebf\uff0c\u4e0e\u5df2\u77e5\u7684\u76f4\u7ebf\u5e73\u884c\uff0e",
      "figure_ids": []
    },
    {
      "number": "433",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n433\uff0e\u80fd\u4e0d\u80fd\u4f5c\u4e00\u6761\u76f4\u7ebf\u4e0e\u4e24\u6761\u76f8\u4ea4\u76f4\u7ebf$a$\u548c$b$\u4e2d\u7684\u4efb\u610f\u4e00\u6761\u76f4\u7ebf\u90fd\u5e73\u884c\uff1f",
      "figure_ids": []
    },
    {
      "number": "434",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n434\uff0e\u5df2\u77e5\u76f4\u7ebf$a$\uff0c$b$\u548c$c$\uff0e\u4e0b\u9762\u7684\u547d\u9898\u662f\u5426\u6b63\u786e\uff1a\n1\uff09$a\\parallel a$\uff1b\n2\uff09\u5982\u679c$a\\parallel b$\uff0c\u90a3\u4e48$b\\parallel a$\uff1b\n3\uff09\u5982\u679c$a\\parallel b$\uff0c$a\\parallel c$\uff0c\u90a3\u4e48$b\\parallel c$\uff1b\n4\uff09\u5982\u679c$a\\perp b$\uff0c$b\\perp c$\uff0c\u90a3\u4e48$a\\perp c$\uff1b\n5\uff09\u5982\u679c$a$\u548c$b$\u76f8\u4ea4\uff0c$b$\u548c$c$\u76f8\u4ea4\uff0c\u90a3\u4e48$a$\u548c$c$\u76f8\u4ea4\uff0e",
      "figure_ids": []
    },
    {
      "number": "435",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n435\uff0e\u5728\u76f4\u7ebf\u7684\u96c6\u5408\u4e0a\uff0c\u5e73\u884c\u5173\u7cfb\u5177\u6709\u53cd\u5c04\u6027\u3001\u5bf9\u79f0\u6027\u548c\u4f20\u9012\u6027\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "436",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n436\uff0e\u5df2\u77e5\u76f4\u7ebf$a$\uff0c$b$\u548c$c$\uff0e\u5982\u679c$a\\parallel b$\uff0c\u5e76\u4e14$b$\u548c$c$\u76f8\u4ea4\uff0c\u90a3\u4e48\u76f4\u7ebf$a$\u548c$c$\u7684\u4f4d\u7f6e\u5173\u7cfb\u662f\u600e\u6837\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "437",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n437\uff0e\u6c42\u8bc1\uff1a\u5982\u679c\u4e00\u6761\u76f4\u7ebf\u5782\u76f4\u4e8e\u9510\u89d2\u7684\u4e00\u8fb9\uff0c\u90a3\u4e48\u5b83\u4e0e\u9510\u89d2\u7684\u53e6\u4e00\u8fb9\u4e00\u5b9a\u76f8\u4ea4\uff0e",
      "figure_ids": []
    },
    {
      "number": "438",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n438\uff0e\u5df2\u77e5\u76f4\u7ebf $a$ \u548c $b$ \u5e73\u884c\uff0c\u800c\u76f4\u7ebf $c$ \u4e0e\u5b83\u4eec\u76f8\u4ea4\uff08\u56fe 208\uff09\uff0e\u6c42\u8bc1*\uff1a\n1) $\\hat{1}=\\hat{3}$\uff1b\n2) $\\hat{1}=\\hat{8}$\uff1b\n3) $\\hat{6}=\\hat{7}$\uff1b\n4) $\\hat{3}=\\hat{5}$\uff1b\n5) $\\hat{4}=\\hat{6}$\uff1b\n6) $\\hat{7}=\\hat{2}$\uff1b\n7) $\\hat{5}=\\hat{8}$\uff1b\n8) $\\hat{2}=\\hat{4}$\uff1b\n9) $\\hat{2}+\\hat{8}=180^\\circ$\uff1b\n10) $\\hat{7}+\\hat{1}=180^\\circ$\uff0e\n\n* \u8c61\u89d2 1 \u548c\u89d2 8\uff0c\u89d2 7 \u548c\u89d2 2\uff0c\u2026\u2026\u8fd9\u6837\u7684\u89d2\u901a\u5e38\u53eb\u505a\u540c\u4f4d\u89d2\uff0e\u89d2 2 \u548c\u89d2 4\uff0c\u89d2 8 \u548c\u89d2 5 \u53eb\u505a\u5e73\u884c\u7ebf $a$ \u548c $b$ \u4e0e\u5272\u7ebf $c$ \u7684\u5185\u9519\u89d2\uff0e",
      "figure_ids": [
        "fig-208"
      ]
    },
    {
      "number": "439",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n439\uff0e\u4e0b\u9762\u7684\u56fe\u5f62\u6709\u591a\u5c11\u4e2a\u5bf9\u79f0\u4e2d\u5fc3\uff1a\n1\uff09\u4e24\u6761\u5e73\u884c\u7684\u76f4\u7ebf\u7684\u5e76\u96c6\uff1b\n2\uff09\u4e09\u6761\u76f4\u7ebf\uff08\u5176\u4e2d\u6709\u4e24\u6761\u76f4\u7ebf\u5e73\u884c\uff09\u7684\u5e76\u96c6\uff1b\n3\uff09\u4e24\u6761\u76f4\u7ebf\u7684\u5e76\u96c6\uff0e",
      "figure_ids": []
    },
    {
      "number": "440",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n440*\uff0e\u5df2\u77e5\u56db\u8fb9\u5f62 $ABCD$ \u5bf9\u8fb9\u5e73\u884c\uff0e\u5982\u679c $\\hat{A}=30^\\circ$\uff0c$|AB|=2\\mathrm{cm}$\uff0c$|BC|=4\\mathrm{cm}$\uff0e\u6c42\u51fa\u8fd9\u4e2a\u56db\u8fb9\u5f62\u6bcf\u4e2a\u89d2\u7684\u5927\u5c0f\u548c\u6bcf\u8fb9\u7684\u957f\uff0e",
      "figure_ids": []
    }
  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "1\uff0e\n\u6211\u4eec\u5df2\u7ecf\u8bc1\u660e\uff1a\u7ecf\u8fc7\u4efb\u610f\u4e00\u70b9\u81f3\u5c11\u53ef\u4ee5\u5f15\u4e00\u6761\u76f4\u7ebf\uff0c\u4e0e\u5df2\u77e5\u7684\u76f4\u7ebf\u5e73\u884c\uff0e\n\u5b9e\u9645\u4e0a\u8fd9\u6837\u7684\u76f4\u7ebf\u6709\u591a\u5c11\u6761\u5462\uff1f\n\n\u6211\u4eec\u77e5\u9053\uff1a\u5b83\u4e0d\u5c11\u4e8e\u4e00\u6761\uff0e\n\u6211\u4eec\u4e0d\u52a0\u8bc1\u660e\u5c31\u627f\u8ba4\u4ee5\u4e0b\u7684\u547d\u9898\uff0e"
    },
    {
      "block": 1,
      "text": "41 \u5e73\u884c\u516c\u7406\uff0e\n\u7ecf\u8fc7\u4e00\u70b9\u81f3\u591a\u53ef\u4ee5\u5f15\u4e00\u6761\u76f4\u7ebf\u4e0e\u5df2\u77e5\u76f4\u7ebf\u5e73\u884c\uff0e"
    },
    {
      "block": 2,
      "text": "\u63a8\u8bba 1\uff0e\n\u5982\u679c\u4e00\u6761\u76f4\u7ebf\u4e0e\u4e24\u6761\u5e73\u884c\u76f4\u7ebf\u4e2d\u7684\u4e00\u6761\u76f4\u7ebf\u76f8\u4ea4\uff0c\u90a3\u4e48\u5b83\u4e0e\u53e6\u4e00\u6761\u76f4\u7ebf\u4e5f\u76f8\u4ea4\uff0e"
    },
    {
      "block": 3,
      "text": "\u8bc1\u660e\uff0e\n\u8bbe $a\\parallel b$\uff0c$c\\cap a=A$\uff08\u56fe 204\uff09\uff0e\n\u5982\u679c\u76f4\u7ebf $c$ \u4e0e $b$ \u4e0d\u76f8\u4ea4\uff0c\u90a3\u4e48\uff0c\u7ecf\u8fc7\u70b9 $A$ \u6709\u4e24\u6761\u76f4\u7ebf\uff08$a$ \u548c $c$\uff09\u4e0e\u76f4\u7ebf $b$ \u5e73\u884c\uff0e\n\n\u8fd9\u4e0e\u5e73\u884c\u516c\u7406\u76f8\u77db\u76fe\uff0e\n\u5c31\u662f\u8bf4\uff0c\u76f4\u7ebf$c$\u4e0e$b$\u76f8\u4ea4\uff0e\n\u25a0"
    },
    {
      "block": 6,
      "text": "\u63a8\u8bba2\uff0e\n\u4e00\u6761\u76f4\u7ebf\u7684\u5782\u7ebf\u548c\u659c\u7ebf\u76f8\u4ea4\uff0e"
    },
    {
      "block": 7,
      "text": "\u8bc1\u660e\uff0e\n\u8bbe\u76f4\u7ebf$a$\u662f\u76f4\u7ebf$c$\u7684\u5782\u7ebf\uff0c\u76f4\u7ebf$b$\u662f\u76f4\u7ebf$c$\u7684\u659c\u7ebf\uff08\u56fe205\uff09\uff0e\n\u7ecf\u8fc7\u76f4\u7ebf$b$\u548c$c$\u7684\u4ea4\u70b9$B$\u4f5c\u76f4\u7ebf$p$\u4e0e\u76f4\u7ebf$c$\u5782\u76f4\uff0e\n\n\u90a3\u4e48\uff0c\u76f4\u7ebf$p$\u4e0e\u76f4\u7ebf$a$\u5e73\u884c\uff08\u89c131\u8282\uff09\uff0e\n\u5c31\u662f\u8bf4\uff0c\u76f4\u7ebf$b$\u4e0d\u53ef\u80fd\u4e0e\u76f4\u7ebf$a$\u5e73\u884c\uff0c\u56e0\u4e3a\u5426\u5219\u7ecf\u8fc7\u70b9$B$\u53ef\u4ee5\u6709\u4e24\u6761\u76f4\u7ebf\uff08$b$\u548c$p$\uff09\u4e0e\u76f4\u7ebf$a$\u5e73\u884c\uff0c\u8fd9\u4e0e\u5e73\u884c\u516c\u7406\u76f8\u77db\u76fe\uff0e\n\u4e8e\u662f\uff0c\u76f4\u7ebf$a$\u548c\u76f4\u7ebf$b$\u76f8\u4ea4\uff0e\n\n\u25a0"
    },
    {
      "block": 8,
      "text": "\u63a8\u8bba3\uff0e\n\u5982\u679c\u76f4\u7ebf$a$\u548c$b$\u4e0e\u76f4\u7ebf$c$\u5e73\u884c\uff0c\u90a3\u4e48\u76f4\u7ebf$a$\u548c$b$\u5e73\u884c\uff0e"
    },
    {
      "block": 13,
      "text": "\u8bc1\u660e\uff0e\n\u5047\u8bbe\u76f8\u53cd\uff1a\u76f4\u7ebf$a$\u548c$b$\u4e0d\u5e73\u884c\uff0c\u5c31\u662f\u8bf4\u5b83\u4eec\u76f8\u4ea4\u4e8e\u67d0\u70b9$P$\uff08\u56fe206\uff09\uff0e\n\u90a3\u4e48\u7ecf\u8fc7\u70b9$P$\u53ef\u4ee5\u6709\u4e24\u6761\u76f4\u7ebf\uff08$a$\u548c$b$\uff09\u4e0e\u76f4\u7ebf$c$\u5e73\u884c\uff0e\n\n\u4f46\u662f\uff0c\u8fd9\u4e0e\u5e73\u884c\u516c\u7406\u76f8\u77db\u76fe\uff0c\u56e0\u800c\u6211\u4eec\u7684\u5047\u8bbe\u662f\u4e0d\u6b63\u786e\u7684\uff0e\n\u6240\u4ee5$a\\parallel b$\uff0e\n\u25a0"
    },
    {
      "block": 14,
      "text": "2\uff0e\n\u5728\u7b2c31\u5c0f\u8282\u91cc\uff0c\u6211\u4eec\u66fe\u7ecf\u8bc1\u660e\u4e86\u5173\u4e8e\u4e2d\u5fc3\u5bf9\u79f0\u7684\u76f4\u7ebf\u4e92\u76f8\u5e73\u884c\u7684\u5b9a\u7406\uff0e\n\u5b83\u7684\u9006\u547d\u9898\u4e5f\u662f\u6b63\u786e\u7684\uff0e"
    },
    {
      "block": 15,
      "text": "42 \u25a0 \u5b9a\u7406\uff0e\n\u5982\u679c\u4e24\u6761\u76f4\u7ebf\u5e73\u884c\uff0c\u90a3\u4e48\u5b83\u4eec\u4e2d\u5fc3\u5bf9\u79f0\uff0e"
    },
    {
      "block": 16,
      "text": "\u8bc1\u660e\uff0e\n\u8bbe$a\\parallel b$\uff0e\n\u8bc1\u660e\u5b58\u5728\u4e00\u70b9$O$\uff0c\u4f7f\u8fd9\u4e24\u6761\u76f4\u7ebf\u5173\u4e8e\u70b9$O$\u5bf9\u79f0\uff0e\n\n\u5728\u76f4\u7ebf$a$\u548c$b$\u4e0a\u5206\u522b\u53d6\u4e00\u70b9$A$\u548c$A_1$\uff08\u56fe207\uff09\uff0e\n\u7ebf\u6bb5$AA_1$\u7684\u4e2d\u70b9\u7528$O$\u8868\u793a\uff0e"
    },
    {
      "block": 17,
      "text": "\u5728\u4e2d\u5fc3\u5bf9\u79f0$Z_{\\text{UNKNOWN}}$\u4e0b\uff0c\u70b9$A$\u6620\u5c04\u5230\u70b9$A_1$\uff0c\u76f4\u7ebf$a$\u6620\u5c04\u5230\u76f4\u7ebf$Z_{\\text{UNKNOWN}}(a)$\uff0c\u5b83\u7ecf\u8fc7\u70b9$A_1$\u5e76\u4e0e\u76f4\u7ebf$a$\u5e73\u884c\uff08\u6839\u636e\u5b9a\u740639\uff09\uff0e\n\u6839\u636e\u5e73\u884c\u516c\u7406\uff0c\u8fd9\u6837\u7684\u76f4\u7ebf\u662f\u552f\u4e00\u7684\uff0e\n\u4f46\u662f\u6839\u636e\u6761\u4ef6\uff0c$b\\parallel a$\uff0c\u800c\u4e14$A_1\\in b$\uff0e\n\n\u5c31\u662f\u8bf4\uff0c\u5728\u4e2d\u5fc3\u5bf9\u79f0$Z_{\\text{UNKNOWN}}$\u4e0b\u76f4\u7ebf$a$\u7684\u8c61\u53ef\u4ee5\u800c\u4e14\u4ec5\u4ec5\u662f\u76f4\u7ebf$b$\uff0e\n\u4e8e\u662f\uff0c$Z_{\\text{UNKNOWN}}(a)=b$\uff0c\u4e5f\u5c31\u662f\u76f4\u7ebf$a$\u548c$b$\u4e2d\u5fc3\u5bf9\u79f0\uff0e\n\u25a0"
    }
