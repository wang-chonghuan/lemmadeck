      "sha256": "8a65b33371439963ce97fcd56e24a9898ef2a26a274ac4b9db701fa11e4fe404"
    },
    {
      "path": "/Users/yong/.codex/worktrees/stemrobin-188-six/lemmadeck/.intentfold/tickets/STEMROBIN-188/tmp/n30-draft-first-18/artifacts/6-8g/pages/0139/page.json",
