  "exercises": [
    {
      "number": "488",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n488. \u5982\u679c\u4e09\u89d2\u5f62\u4e09\u4e2a\u5185\u89d2\u7684\u5927\u5c0f\u4e0e\u4e0b\u5217\u4e09\u4e2a\u6570\u6210\u6bd4\u4f8b\uff0c\u6c42\u5404\u89d2\u7684\u5927\u5c0f\uff1a\n1) 1\uff0c2\uff0c3\uff1b\n2) 3\uff0c7\uff0c8\uff1b\n3) 1\uff0c1\uff0c3\u3002",
      "figure_ids": []
    },
    {
      "number": "489",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n489. \u6c42\u8bc1\uff1a\u5982\u679c\u4e00\u4e2a\u4e09\u89d2\u5f62\u7684\u4e24\u4e2a\u5185\u89d2\u5206\u522b\u4e0e\u53e6\u4e00\u4e2a\u4e09\u89d2\u5f62\u7684\u4e24\u4e2a\u5185\u89d2\u5bf9\u5e94\u5168\u7b49\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u4e09\u89d2\u5f62\u5269\u4e0b\u7684\u4e00\u4e2a\u5185\u89d2\u4e5f\u5168\u7b49\u3002",
      "figure_ids": []
    },
    {
      "number": "490",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n490. \u5728\u4e09\u89d2\u5f62 $ABC$ \u4e2d\uff0c$\\hat{A}=25^\\circ$\uff0c$\\hat{B}=68^\\circ$\u3002\u8fc7\u8fd9\u4e2a\u4e09\u89d2\u5f62\u7684\u4e09\u4e2a\u9876\u70b9\uff0c\u5206\u522b\u4f5c\u5bf9\u8fb9\u7684\u5e73\u884c\u7ebf\u3002\u6c42\u8fd9\u4e09\u6761\u76f4\u7ebf\u7ec4\u6210\u7684\u4e09\u89d2\u5f62\u7684\u4e09\u4e2a\u5185\u89d2\u7684\u5927\u5c0f\u3002",
      "figure_ids": []
    },
    {
      "number": "491",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n491. \u6307\u51fa\u8bc1\u660e\u4e09\u89d2\u5f62\u5185\u89d2\u548c\u5b9a\u7406\u65f6\u7528\u5230\u7684\u516c\u7406\u548c\u5df2\u7ecf\u8bc1\u660e\u7684\u5b9a\u7406\u3002",
      "figure_ids": []
    },
    {
      "number": "492",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n492. \u4e09\u89d2\u5f62\u7684\u4e00\u4e2a\u5916\u89d2\u662f\u5426\u53ef\u80fd\u5c0f\u4e8e\u5b83\u7684\u4e00\u4e2a\u5185\u89d2\uff1f",
      "figure_ids": []
    },
    {
      "number": "493",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n493.\n1\uff09\u7ed9\u51fa\u949d\u89d2\u4e09\u89d2\u5f62\u3001\u76f4\u89d2\u4e09\u89d2\u5f62\u548c\u9510\u89d2\u4e09\u89d2\u5f62\u7684\u5b9a\u4e49\u3002\n2\uff09\u5982\u679c\u4e09\u89d2\u5f62\u7684\u4e00\u4e2a\u5185\u89d2\uff1a\n\n[UNKNOWN:493-2-1]\uff09\u7b49\u4e8e\u53e6\u5916\u4e24\u4e2a\u5185\u89d2\u7684\u548c\uff1b\n[UNKNOWN:493-2-2]\uff09\u5927\u4e8e\u53e6\u5916\u4e24\u4e2a\u5185\u89d2\u7684\u548c\uff1b\n[UNKNOWN:493-2-3]\uff09\u5c0f\u4e8e\u53e6\u5916\u4e24\u4e2a\u5185\u89d2\u7684\u548c\u3002\n\u6309\u89d2\u5206\u7c7b\uff0c\u786e\u5b9a\u8fd9\u4e9b\u4e09\u89d2\u5f62\u7684\u7c7b\u578b\u3002",
      "figure_ids": []
    },
    {
      "number": "494",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n494. \u5982\u679c\u4e00\u4e2a\u4e09\u89d2\u5f62\u4e2d\u4efb\u610f\u4e24\u4e2a\u5185\u89d2\u7684\u548c\u5927\u4e8e $90^\\circ$\uff0c\u8fd9\u4e2a\u4e09\u89d2\u5f62\u5c5e\u4e8e\u54ea\u79cd\u7c7b\u578b\uff1f",
      "figure_ids": []
    },
    {
      "number": "495",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n495*. \u4e09\u89d2\u5f62\u7684\u4e24\u4e2a\u5185\u89d2\u5206\u522b\u7b49\u4e8e $60^\\circ$ \u548c $72^\\circ$\u3002\u6c42\uff1a\n1\uff09\u4e09\u89d2\u5f62\u6bcf\u4e24\u6761\u9ad8\u6240\u5728\u76f4\u7ebf\u7684\u5939\u89d2\uff08\u53d6\u8f83\u5c0f\u7684\u4e00\u4e2a\uff09\uff1b\n2\uff09\u4e09\u89d2\u5f62\u6bcf\u4e24\u6761\u89d2\u5e73\u5206\u7ebf\u6240\u5728\u76f4\u7ebf\u7684\u5939\u89d2\uff08\u53d6\u8f83\u5c0f\u7684\u4e00\u4e2a\uff09\u3002",
      "figure_ids": []
    },
    {
      "number": "496",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n496. \u7b49\u8170\u4e09\u89d2\u5f62\u7684\u4e00\u4e2a\u5916\u89d2\u7b49\u4e8e $100^\\circ$\u3002\u6c42\u8fd9\u4e2a\u4e09\u89d2\u5f62\u4e09\u4e2a\u5185\u89d2\u7684\u5927\u5c0f\u3002",
      "figure_ids": []
    },
    {
      "number": "497",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n497. \u8bc1\u660e\uff1a\u4e09\u89d2\u5f62\u4e0d\u53ef\u80fd\u6709\u4e24\u4e2a\u9510\u89d2\u5916\u89d2\u3002",
      "figure_ids": []
    },
    {
      "number": "498",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n498. \u5982\u679c\u4e09\u89d2\u5f62\u7684\u4e00\u4e2a\u5916\u89d2\u6ee1\u8db3\u4e0b\u5217\u6761\u4ef6\uff0c\u8fd9\u4e2a\u4e09\u89d2\u5f62\u5c5e\u4e8e\u54ea\u79cd\u7c7b\u578b\uff1f\n1\uff09\u662f\u9510\u89d2\uff1b\n2\uff09\u7b49\u4e8e\u4e00\u4e2a\u5185\u89d2\u3002",
      "figure_ids": []
    },
    {
      "number": "499",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n499. \u5df2\u77e5\uff1a$(MN)\\parallel(KL)$\uff08\u56fe 238\uff09\u3002\n\u6c42\u8bc1\uff1a$\\widehat{ABC}=\\widehat{NAB}+\\widehat{BCL}$\u3002",
      "figure_ids": [
        "fig-238"
      ]
    },
    {
      "number": "500",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n500. \u6c42\u4e0b\u5217\u5404\u591a\u8fb9\u5f62\u7684\u5185\u89d2\u548c\uff1a\n1\uff09\u5341\u8fb9\u5f62\uff1b\n2\uff09\u5341\u4e8c\u8fb9\u5f62\uff1b\n3\uff09\u4e09\u5341\u8fb9\u5f62\uff1b\n4\uff09\u4e5d\u5341\u516d\u8fb9\u5f62\u3002",
      "figure_ids": []
    },
    {
      "number": "501",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n501. \u5982\u679c\u591a\u8fb9\u5f62\u7684\u5185\u89d2\u548c\u7b49\u4e8e\u4e0b\u5217\u6570\u503c\uff0c\u6c42\u5404\u591a\u8fb9\u5f62\u7684\u8fb9\u6570\uff1a\n1\uff09$1080^\\circ$\uff1b\n2\uff09$1620^\\circ$\uff1b\n3\uff09$3960^\\circ$\uff1b\n4\uff09$1800^\\circ$\u3002",
      "figure_ids": []
    },
    {
      "number": "502",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n502. \u5982\u679c\u591a\u8fb9\u5f62\u7684\u6bcf\u4e2a\u5185\u89d2\u90fd\u7b49\u4e8e\u4e0b\u5217\u6570\u503c\uff0c\u6c42\u5404\u591a\u8fb9\u5f62\u7684\u8fb9\u6570\uff1a\n1\uff09$144^\\circ$\uff1b\n2\uff09$150^\\circ$\uff1b\n3\uff09$170^\\circ$\uff1b\n4\uff09$171^\\circ$\u3002",
      "figure_ids": []
    },
    {
      "number": "503",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n503. \u6c42\u8bc1\uff1a\u4e0d\u5b58\u5728\u6ee1\u8db3\u4e0b\u5217\u6761\u4ef6\u7684\u591a\u8fb9\u5f62\uff1a\n1\uff09\u6709\u591a\u4e8e\u56db\u4e2a\u76f4\u89d2\u5916\u89d2\uff1b\n2\uff09\u6709\u591a\u4e8e\u4e09\u4e2a\u949d\u89d2\u5916\u89d2\u3002",
      "figure_ids": []
    },
    {
      "number": "504",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n504. \u591a\u8fb9\u5f62\u7684\u5185\u89d2\u548c\u80fd\u5426\u7b49\u4e8e\u4e0b\u5217\u6570\u503c\uff1f\n1\uff09$9180^\\circ$\uff1b\n2\uff09$3600^\\circ$\uff1b\n3\uff09$2040^\\circ$\uff1b\n4\uff09$11d$\uff1b\n5\uff09$18d$\u3002",
      "figure_ids": []
    },
    {
      "number": "505",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n505*. \u7528\u4e0d\u540c\u4e8e\u7b2c 38 \u5c0f\u8282\u7684\u8bc1\u660e\u65b9\u6cd5\uff0c\u8bc1\u660e\u4e0b\u5217\u5b9a\u7406\uff1a\n1\uff09\u4e09\u89d2\u5f62\u7684\u5185\u89d2\u548c\u5b9a\u7406\uff1b\n2\uff09\u51f8\u591a\u8fb9\u5f62\u7684\u5185\u89d2\u548c\u5b9a\u7406\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u8bbe $[AB]$ \u548c $[AF]$ \u662f\u51f8\u591a\u8fb9\u5f62\u7684\u4e24\u6761\u8fb9\uff08\u56fe 232\uff09\u3002\n\u5c04\u7ebf $AB$ \u548c $AF$ \u7ec4\u6210\u4e24\u4e2a\u89d2\u3002\n\u5176\u4e2d\u4f4d\u4e8e\u591a\u8fb9\u5f62\u5185\u90e8\u7684\u4e00\u4e2a\u89d2\uff0c\u53eb\u505a\u8fd9\u4e2a\u591a\u8fb9\u5f62\u7684\u5185\u89d2\u3002\n\n\u591a\u8fb9\u5f62\u5185\u89d2\u7684\u90bb\u8865\u89d2\uff0c\u4f8b\u5982\u89d2 $BAG$\uff0c\u53eb\u505a\u8fd9\u4e2a\u591a\u8fb9\u5f62\u7684\u5916\u89d2\u3002\n*"
    },
    {
      "block": 4,
      "text": "47 \u5b9a\u7406\u3002\n\u4e09\u89d2\u5f62\u7684\u5185\u89d2\u548c\u7b49\u4e8e $180^\\circ$\u3002"
    },
    {
      "block": 14,
      "text": "\u63a8\u8bba 1\u3002\n\u5982\u679c\u4e09\u89d2\u5f62\u6709\u4e00\u4e2a\u5185\u89d2\u662f\u76f4\u89d2\u6216\u949d\u89d2\uff0c\u90a3\u4e48\u53e6\u5916\u4e24\u4e2a\u5185\u89d2\u90fd\u662f\u9510\u89d2\u3002"
    },
    {
      "block": 15,
      "text": "\u63a8\u8bba 2\u3002\n\u7b49\u8fb9\u4e09\u89d2\u5f62\u7684\u6bcf\u4e2a\u5185\u89d2\u90fd\u7b49\u4e8e $60^\\circ$\u3002"
    },
    {
      "block": 16,
      "text": "\u63a8\u8bba 3\u3002\n\u4e09\u89d2\u5f62\u7684\u5916\u89d2\u7b49\u4e8e\u4e0e\u5b83\u4e0d\u76f8\u90bb\u7684\u4e24\u4e2a\u5185\u89d2\u4e4b\u548c\uff08\u56fe 234\uff09\u3002"
    },
    {
      "block": 20,
      "text": "48 $\\blacksquare$ \u5b9a\u7406\u3002\n\u51f8 $n$ \u8fb9\u5f62\u7684\u5185\u89d2\u548c\u7b49\u4e8e $2d(n-2)$\u3002"
    },
    {
      "block": 24,
      "text": "\u7279\u522b\u5730\uff0c\u56db\u8fb9\u5f62\u7684\u5185\u89d2\u548c\u7b49\u4e8e $4d$\u3002"
    },
    {
      "block": 25,
      "text": "49 $\\blacksquare$ \u5b9a\u7406\u3002\n\u5728\u51f8\u591a\u8fb9\u5f62\u7684\u6bcf\u4e2a\u9876\u70b9\u53d6\u4e00\u4e2a\u5916\u89d2\uff0c\u8fd9\u4e9b\u5916\u89d2\u7684\u548c\u7b49\u4e8e $4d$\u3002"
    }
  ],
