    {
      "kind": "p",
      "text": "先证明三角形内角和定理。",
      "id": null,
      "label": null,
      "printed_page": 164,
      "source_refs": [
        "p0174#5"
      ],
      "source_text": "首先证明关于三角形内角和的定理.",
      "changes": [
        "translation",
        "layout"
      ],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "47 定理。\n三角形的内角和等于 $180^\\circ$。",
      "id": null,
      "label": null,
      "printed_page": 164,
      "source_refs": [
        "p0174#6"
      ],
      "source_text": "47 定理. 三角形的内角和等于 $180^\\circ$.",
      "changes": [
        "translation",
        "layout"
      ],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "fig",
      "text": "",
      "id": "fig-233",
      "label": "图 233",
      "printed_page": 164,
      "source_refs": [
        "p0174#7"
      ],
      "source_text": "",
      "changes": [],
      "numeric_changes": [],
