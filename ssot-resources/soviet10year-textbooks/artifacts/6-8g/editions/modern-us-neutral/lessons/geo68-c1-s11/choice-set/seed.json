    },
    {
      "number": "114",
      "text": "$114^{\\circ}$. \u4e0b\u5217\u56fe\u5f62\u662f\u51f8\u56fe\u5f62\u5417\uff1f\n1) \u4e09\u89d2\u5f62\uff1b\n2) \u56db\u8fb9\u5f62.",
      "figure_ids": []
    },
    {
      "number": "115",
      "text": "$115^{\\circ}$. \u4e0b\u5217\u56fe\u5f62\u662f\u51f8\u56fe\u5f62\u5417\uff1f\n1) \u5706\u73af(\u56fe 59, a)\uff1b\n2) \u53bb\u6389\u5706\u5fc3\u4ee5\u540e\u7684\u5706\uff1b\n3) \u53bb\u6389\u4e00\u70b9\u4ee5\u540e\u7684\u5e73\u9762\uff1b\n4) \u534a\u5706(\u56fe 59, b).",
