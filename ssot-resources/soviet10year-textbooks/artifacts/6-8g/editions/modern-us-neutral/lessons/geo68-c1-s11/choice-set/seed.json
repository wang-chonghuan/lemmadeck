  "concepts": [
    {
      "block": 3,
      "text": "\u5b9a\u4e49 \u7b80\u5355\u95ed\u6298\u7ebf\u548c\u5b83\u7684\u5185\u90e8\u7684\u5e76\u96c6\u53eb\u505a\u591a\u8fb9\u5f62."
    },
    {
      "block": 4,
      "text": "\u591a\u8fb9\u5f62\u4e0d\u5c5e\u4e8e\u8fb9\u754c\u7684\u70b9\u53eb\u505a\u8fd9\u4e2a\u591a\u8fb9\u5f62\u7684\u5185\u70b9. \u8fb9\u754c\u4e0a\u7684\u70b9\u53eb\u505a\u8fb9\u754c\u70b9. \u591a\u8fb9\u5f62\u5b9a\u4e49\u4e2d\u63d0\u5230\u7684\u6298\u7ebf\u7684\u9876\u70b9\u53eb\u505a\u591a\u8fb9\u5f62\u7684\u9876\u70b9\uff0c\u800c\u6298\u7ebf\u7684\u5404\u6bb5\u53eb\u505a\u591a\u8fb9\u5f62\u7684\u8fb9. \u591a\u8fb9\u5f62\u5404\u8fb9\u957f\u5ea6\u7684\u548c\u53eb\u505a\u591a\u8fb9\u5f62\u7684\u5468\u957f."
    },
    {
      "block": 11,
      "text": "2. \u5b9a\u4e49 \u5982\u679c\u4e00\u4e2a\u56fe\u5f62\u5305\u542b\u56fe\u5f62\u4e0a\u4efb\u4f55\u4e24\u70b9\u7684\u8fde\u7ed3\u7ebf\u6bb5\uff0c\u90a3\u4e48\u8fd9\u4e2a\u56fe\u5f62\u53eb\u505a\u51f8\u56fe\u5f62."
    },
    {
      "block": 18,
      "text": "\u7531\u4e00\u70b9\u7ec4\u6210\u7684\u56fe\u5f62\u4ee5\u53ca\u7a7a\u96c6\uff0c\u90fd\u88ab\u770b\u4f5c\u51f8\u56fe\u5f62."
    }
  ],
