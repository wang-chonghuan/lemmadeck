  "exercises": [
    {
      "number": "373",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n373. \u6c42\u4f5c\u76f4\u89d2\u4e09\u89d2\u5f62:\n1) \u4ee5$c$\u4e3a\u659c\u8fb9\u548c\u4ee5$b$\u4e3a\u76f4\u89d2\u8fb9;\n2) \u4ee5$a$\u548c$b$\u4e3a\u76f4\u89d2\u8fb9;\n3) \u4ee5$a$\u4e3a\u76f4\u89d2\u8fb9\u548c\u4ee5\u89d2$\\beta$\u4e3a\u4e0e\u8fd9\u4e2a\u8fb9\u76f8\u90bb\u7684\u9510\u89d2;\n4) \u4ee5$a$\u4e3a\u76f4\u89d2\u8fb9\u548c\u4ee5$h$\u4e3a\u659c\u8fb9\u4e0a\u7684\u9ad8.",
      "figure_ids": []
    },
    {
      "number": "374",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n374. \u6c42\u4f5c\u7b49\u8170\u4e09\u89d2\u5f62:\n1) \u4ee5$b$\u4e3a\u8170, $h$\u4e3a\u5e95\u4e0a\u7684\u9ad8;\n2) \u4ee5$a$\u4e3a\u5e95, $h$\u4e3a\u4e00\u8170\u4e0a\u7684\u9ad8.",
      "figure_ids": []
    },
    {
      "number": "375",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n375. \u8fc7\u5df2\u77e5\u70b9$A$\u53ef\u4ee5\u4f5c\u5df2\u77e5\u5706\u5468$(O,r)$\u7684\u51e0\u6761\u5207\u7ebf?",
      "figure_ids": []
    },
    {
      "number": "376",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n376. \u8fc7\u5df2\u77e5\u70b9\u4f5c\u5df2\u77e5\u5706\u5468\u7684\u5207\u7ebf.",
      "figure_ids": []
    },
    {
      "number": "377",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n377. \u8fc7\u4e00\u70b9\u6240\u4f5c\u7684\u5df2\u77e5\u5706\u5468\u7684\u5207\u7ebf\u4e3a\u5b9a\u957f$a$.\n\u6240\u6709\u8fd9\u6837\u7684\u70b9\u7684\u96c6\u5408\u7ec4\u6210\u4ec0\u4e48\u6837\u7684\u56fe\u5f62?",
      "figure_ids": []
    },
    {
      "number": "378",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n378. \u6c42\u4f5c\u5706\u5468, \u4f7f\u5728\u5df2\u77e5\u89d2\u4e24\u8fb9\u4e0a\u6240\u622a\u53d6\u7684\u7ebf\u6bb5\u4e3a\u5b9a\u957f.",
      "figure_ids": []
    },
    {
      "number": "379",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n379*. \u5df2\u77e5\u76f4\u7ebf$a$\u662f\u5df2\u77e5\u5706\u5468$(O,r)$\u7684\u5207\u7ebf.\n\u6c42\u4f5c\u5706\u5468:\n1) \u548c\u5df2\u77e5\u5706\u5468\u76f8\u5207, \u4e14\u4e0e\u5df2\u77e5\u76f4\u7ebf\u76f8\u5207\u4e8e\u76f4\u7ebf\u4e0a\u7684\u5df2\u77e5\u70b9$M$;\n2) \u548c\u5df2\u77e5\u76f4\u7ebf\u76f8\u5207, \u4e14\u4e0e\u5df2\u77e5\u5706\u5468\u5207\u4e8e\u5df2\u77e5\u70b9$M$.",
      "figure_ids": []
    },
    {
      "number": "380",
      "text": "\u95ee\u9898\u548c\u4e60\u9898\n380*. \u4e24\u5706\u5468$(O_1,r_1)$\u4e0e$(O_2,r_2)$\u76f8\u5916\u5207.\n1) \u6c42\u8fd9\u6837\u7684\u70b9$M$, \u5b83\u5230\u4e24\u4e2a\u5706\u5468\u7684\u5207\u7ebf\u7b49\u957f.\n2) \u5230\u4e24\u4e2a\u5706\u5468\u6240\u4f5c\u5207\u7ebf\u7b49\u957f\u7684\u6240\u6709\u70b9\u7684\u96c6\u5408\u7ec4\u6210\u4ec0\u4e48\u6837\u7684\u56fe\u5f62?",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 16,
      "text": "38 \u5982\u679c\u4e00\u4e2a\u76f4\u89d2\u4e09\u89d2\u5f62\u7684\u659c\u8fb9\u548c\u4e00\u6761\u76f4\u89d2\u8fb9\u4e0e\u53e6\u4e00\u4e2a\u76f4\u89d2\u4e09\u89d2\u5f62\u7684\u659c\u8fb9\u548c\u4e00\u6761\u76f4\u89d2\u8fb9\u5408\u540c\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u76f4\u89d2\u4e09\u89d2\u5f62\u5408\u540c."
    }
  ],
