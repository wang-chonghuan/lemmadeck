      },
      "key": {
        "correct": [
          "A"
        ],
        "rationales": [
          {
            "option_id": "A",
            "truth": "correct",
            "derivation": "新数值是a除新单位，xe除(e/10)=10x，xe除(100e)=x/100。",
            "misconception": null
          },
          {
            "option_id": "B",
            "truth": "incorrect",
            "derivation": "以非零量为例，两次均反向；如x=1应为10和0.01，而不是0.1和100。",
            "misconception": "让数值跟着单位同向缩放，分别乘1/10和100。"
