  "exercises": [
    {
      "number": "1",
      "text": "1\u00b0 1) \u8bf4\u51fa\u4f60\u6240\u77e5\u9053\u7684\u51e0\u4f55\u56fe\u5f62\uff0e2) \u8bf4\u51fa\u5177\u6709\u4e0b\u5217\u5f62\u72b6\u7684\u7269\u4f53\uff1aa) \u957f\u65b9\u4f53\uff1bb) \u7403\uff1bc)\u5706\u67f1\uff0e",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u6c42\u4f5c\u4ee5\u5df2\u77e5\u70b9$O$\u4e3a\u4e2d\u5fc3\u3001\u534a\u5f84\u4e3a$4\\mathrm{cm}$\u7684\u5706\u5468\uff0e\u5728\u4f5c\u51fa\u7684\u56fe\u4e0a\uff08\u4e0d\u7528\u5706\u89c4\u548c\u523b\u5ea6\u5c3a\uff09\u6807\u51fa\uff1a1) \u70b9$A$\u3001$B$\u3001$C$\uff0c\u4e14$|OA|<4\\mathrm{cm}$\uff0c$|OB|<4\\mathrm{cm}$\uff0c$|OC|<$ $4\\mathrm{cm}$\uff1b2) \u70b9$D$\u3001$E$\u3001$F$\uff0c\u4e14$|OD|=4\\mathrm{cm}$\uff0c$|OE|=4\\mathrm{cm}$\uff0c$|OF|=$ $4\\mathrm{cm}$\uff1b3) \u70b9$L$\u3001$M$\u3001$N$\uff0c\u4e14$|OL|>4\\mathrm{cm}$\uff0c$|OM|>4\\mathrm{cm}$\uff0c$|ON|>$ $4\\mathrm{cm}$\uff1b4) \u7528\u7b26\u53f7$\\in$\u548c$\\notin$\u5199\u51fa\uff1aa) \u70b9$A$\u4e0d\u5c5e\u4e8e\u5706\u5468$(O,r)$\uff1bb)\u70b9$D$\u5c5e\u4e8e\u5706\u5468$(O,r)$\uff1bc) \u70b9$L$\u4e0d\u5c5e\u4e8e\u5706\u5468$(O,r)$\uff0e",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3\u00b0\n1) \u5706\u5468\u7684\u4e2d\u5fc3\u5c5e\u4e8e\u5706\u5468\u5417\uff1f\n2) \u5706\u5fc3\u5c5e\u4e8e\u5706\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u5229\u7528\u7b26\u53f7$\\in$\u548c$\\notin$\u8868\u793a\u56fe4\u4e0a\u6807\u51fa\u7684\u5404\u70b9\u662f\u5426\u5c5e\u4e8e\u5df2\u77e5\u5706\uff0e",
      "figure_ids": [
        "fig-04"
      ]
    },
    {
      "number": "5",
      "text": "5. \u5df2\u77e5\u70b9$A$\u3001$B$\u548c$C$\uff0e\u5c31\u56fe\u5f62\n1) $\\{A,B\\}$\u548c\n2) $\\{A,B,C\\}$\uff0c\u5206\u522b\u5199\u51fa\u5b83\u4eec\u6240\u5305\u542b\u7684\u5404\u4e2a\u51e0\u4f55\u56fe\u5f62\uff0e",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "6. \u4f5c\u534a\u5f84\u4e3a$3\\mathrm{cm}$\u7684\u5706\u5468\uff0e\u5728\u8fd9\u4e2a\u5706\u5468\u4e0a\u53ef\u4ee5\u627e\u5230\u6ee1\u8db3\u4e0b\u5217\u6761\u4ef6\u7684\u70b9$M$\u548c$N$\u5417\uff1f\n1) $|MN|=2\\mathrm{cm}$\uff1b\n2) $|MN|=3\\mathrm{cm}$\uff1b\n3) $|MN|=6\\mathrm{cm}$\uff1b\n4) $|MN|=7\\mathrm{cm}$\uff0e",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "7\u00b0\n1) \u5728\u4e00\u4e2a\u5e73\u9762\u4e0a\u4ee5\u5df2\u77e5\u70b9$O$\u4e3a\u4e2d\u5fc3\u3001\u4e14\u534a\u5f84$r$\u4e00\u5b9a\u7684\u5706\u5468\u6709\u591a\u5c11\u4e2a\uff1f\n2) \u5728\u7a7a\u95f4\u4e2d\u5462\uff1f",
      "figure_ids": []
    },
    {
      "number": "8",
      "text": "8\u00b0 \u5730\u7403\u53ef\u4ee5\u8fd1\u4f3c\u5730\u770b\u4f5c\u7403\uff0e\n1) \u8bf4\u51fa\u4f60\u4eec\u5728\u5730\u7406\u8bfe\u4e2d\u5b66\u8fc7\u7684\u4e2d\u5fc3\u5728\u5730\u7403\u4e2d\u5fc3\u7684\u5706\u5468\u7684\u540d\u79f0\uff0e\n2) \u8bf4\u51fa\u5730\u7403\u4eea\u4e0a\u753b\u51fa\u7684\u5706\u5468\uff0e",
      "figure_ids": []
    },
    {
      "number": "9",
      "text": "9* \u5730\u7403\u4eba\u9020\u536b\u661f\u7684\u8f68\u9053\u901a\u5e38\u8fd1\u4f3c\u4e8e\u5706\u5f62\uff0e\u5047\u8bbe\u4eba\u9020\u536b\u661f\u6cbf\u7740\u4e2d\u5fc3\u5728\u5730\u7403\u4e2d\u5fc3\u7684\u5706\u5f62\u8f68\u9053\u8fd0\u884c\uff0c\u56de\u7b54\u4e0b\u5217\u95ee\u9898\uff0e\n1) \u80fd\u4e0d\u80fd\u53d1\u5c04$1000$\u4e2a\u4eba\u9020\u536b\u661f\u800c\u53c8\u4e0d\u81f4\u4e8e\u4f7f\u5b83\u4eec\u7684\u8f68\u9053\u76f8\u4ea4\uff1f\n2) \u80fd\u4e0d\u80fd\u53d1\u5c04\u4e24\u4e2a\u4eba\u9020\u536b\u661f\uff0c\u4f7f\u5b83\u4eec\u6309\u534a\u5f84\u76f8\u540c\u800c\u53c8\u4e0d\u76f8\u4ea4\u4e24\u4e2a\u4e0d\u540c\u7684\u8f68\u9053\u8fd0\u884c\uff1f",
      "figure_ids": []
    },
    {
      "number": "10",
      "text": "10. \u4ee5$O$\u4e3a\u4e2d\u5fc3\u5206\u522b\u4f5c\u534a\u5f84\u4e3a$r_1$\u548c$r_2$\uff08$r_1<r_2$\uff09\u7684\u4e24\u4e2a\u5706\u5468\uff0c\u7528\u9634\u5f71\u7ebf\u5206\u522b\u8868\u793a\u7531\u6ee1\u8db3\u4e0b\u5217\u6761\u4ef6\u7684\u70b9$X$\u7ec4\u6210\u7684\u56fe\u5f62\uff1a\n1) $|OX|\\ge r_1$\uff1b\n2) $|OX|\\le r_1$\uff1b\n3) $r_1\\le|OX|\\le r_2$\uff0e",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 12,
      "text": "\u5b9a\u4e49 \u5728\u540c\u4e00\u5e73\u9762\u4e0a\uff0c\u548c\u5df2\u77e5\u70b9\u7684\u8ddd\u79bb\u4e3a\u5df2\u77e5\u6b63\u6570\u7684\u70b9\u7684\u96c6\u5408\uff0c\u53eb\u505a\u5706\u5468\uff0e"
    },
    {
      "block": 13,
      "text": "\u5706\u5fc3\u4e3a$O$\u3001\u534a\u5f84\u4e3a$r$\u7684\u5706\u5468\u8bb0\u4f5c\uff1a\u5706\u5468$(O,r)$\uff0e"
    },
    {
      "block": 15,
      "text": "\u5b9a\u4e49 \u4efb\u4e00\u70b9\u96c6\u53eb\u505a\u51e0\u4f55\u56fe\u5f62*\uff0e"
    },
    {
      "block": 18,
      "text": "* \u901a\u5e38\u4e5f\u628a\u7a7a\u96c6\u770b\u4f5c\u662f\u51e0\u4f55\u56fe\u5f62\uff0e"
    },
    {
      "block": 19,
      "text": "\u5b9a\u4e49 \u5728\u540c\u4e00\u5e73\u9762\u4e0a\uff0c\u548c\u5df2\u77e5\u70b9\u7684\u8ddd\u79bb\u4e0d\u5927\u4e8e\u5df2\u77e5\u6b63\u6570$r$\u7684\u70b9\u7684\u96c6\u5408\uff0c\u53eb\u505a\u5706\uff0e"
    },
    {
      "block": 20,
      "text": "\u5706\u5fc3\u4e3a$O$\u3001\u534a\u5f84\u4e3a$r$\u7684\u5706\u8bb0\u4f5c\uff1a\u5706$(O,r)$\uff0e"
    },
    {
      "block": 26,
      "text": "\u5b9a\u4e49 \u7a7a\u95f4\u4e2d\u548c\u5df2\u77e5\u70b9\u7684\u8ddd\u79bb\u7b49\u4e8e\u5df2\u77e5\u6b63\u6570\u7684\u70b9\u7684\u96c6\u5408\uff0c\u53eb\u505a\u7403\u9762\uff0e"
    },
    {
      "block": 27,
      "text": "\u7403\u9762\u7684\u5b9a\u4e49\u548c\u5706\u5468\u7684\u5b9a\u4e49\u5341\u5206\u76f8\u4f3c\uff0c\u552f\u4e00\u7684\u5dee\u522b\u5728\u4e8e\u5706\u5468\u7684\u5b9a\u4e49\u4e2d\u53ea\u8003\u8651\u4e00\u4e2a\u5e73\u9762\u7684\u70b9\uff0c\u800c\u7403\u9762\u7684\u5b9a\u4e49\u662f\u5c31\u7a7a\u95f4\u7684\u70b9\u800c\u8a00\u7684\uff0e"
    },
    {
      "block": 28,
      "text": "\u51e0\u4f55\u91cc\u5168\u4f53\u70b9\u7684\u96c6\u5408\u53eb\u505a\u7a7a\u95f4\uff0e\n\u6bcf\u4e00\u4e2a\u51e0\u4f55\u56fe\u5f62\u662f\u7a7a\u95f4\u7684\u5b50\u96c6\uff0e"
    }
