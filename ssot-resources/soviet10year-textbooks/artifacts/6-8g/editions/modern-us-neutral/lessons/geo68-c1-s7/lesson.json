      "text": "$|AB|=|AO|+|OB|=x_A-x_B=|x_B-x_A|$．",
      "id": null,
      "label": null,
      "printed_page": 22,
      "source_refs": [
        "p0032#5"
      ],
      "source_text": "$|AB|=|AO|+|OB|=x_A-x_B=|x_B-x_A|$.",
      "changes": [
        "layout"
      ],
