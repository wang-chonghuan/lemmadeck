  "exercises": [
    {
      "number": "26",
      "text": "26. \u6d4b\u91cf\u8ddd\u79bb\u65f6\u5f97\u5230\u7684\u7ed3\u679c\u5982\u4e0b\uff1a$|XY|=5\\mathrm{dm}$\uff0c$|AB|=7\\mathrm{dm}$\uff0c$|CD|=1\\mathrm{dm}$\uff0e\n1) \u5982\u679c\u53d6a) \u7c73\u6216b) \u5398\u7c73\u4f5c\u4e3a\u5ea6\u91cf\u5355\u4f4d\uff0c\u5199\u51fa\u4e0a\u9762\u6d4b\u91cf\u7684\u7ed3\u679c\uff1b\n2) \u5982\u679c\u53d6\u6beb\u7c73\u4f5c\u4e3a\u5ea6\u91cf\u5355\u4f4d\uff0c\u5199\u51fa\u4e0a\u8ff0\u8ddd\u79bb\u7684\u6570\u503c\uff0e",
      "figure_ids": []
    },
    {
      "number": "27",
      "text": "27. \u5df2\u77e5\uff1a$|AB|=8\\mathrm{cm}$\uff0c$|BC|=4\\mathrm{cm}$\uff0e\n1) \u8fd9\u65f6\u8ddd\u79bb$|AC|$\u53ef\u80fd\u7b49\u4e8ea) $20\\mathrm{cm}$\uff0cb) $4.5\\mathrm{cm}$\uff0cc) $12\\mathrm{cm}$\uff0cd) $4\\mathrm{cm}$\uff0ce) $3\\mathrm{cm}$\uff0cf) $6\\mathrm{cm}$\u5417\uff1f\n2) \u518d\u968f\u4fbf\u6307\u51fa\u8ddd\u79bb$|AC|$\u53ef\u80fd\u53d6\u7684\u51e0\u4e2a\u6570\u503c\uff0e",
      "figure_ids": []
    },
    {
      "number": "28",
      "text": "28. \u8ddd\u79bb$|AB|$\u7b49\u4e8e$2\\mathrm{cm}$\uff0e\n1) \u8bbe$X$\u662f\u5706\u5468$(B,3\\mathrm{cm})$\u4e0a\u4e00\u4efb\u610f\u70b9\uff0c\u8ddd\u79bb$|AX|$\u53ef\u80fd\u662f\u591a\u5927\uff1f\n2) \u5728\u8fd9\u4e2a\u5706\u5468\u4e0a\u662f\u5426\u5b58\u5728\u8fd9\u6837\u7684\u70b9$C$\uff0c\u4f7f\u5f97$A$\u3001$B$\u3001$C$\u4e09\u70b9\u5728\u4e00\u6761\u76f4\u7ebf\u4e0a\uff1f",
      "figure_ids": []
    },
    {
      "number": "29",
      "text": "29. \u4e0b\u9762\u5217\u51fa\u4e86\u51e0\u4e2a\u7b49\u5f0f\u548c\u4e0d\u7b49\u5f0f\uff0e\u4ece\u4e2d\u6307\u51fa\uff1a\n1) \u5bf9\u4e8e\u4efb\u610f\u70b9$X$\u3001$Y$\u3001$Z$\u90fd\u6210\u7acb\u7684\u5f0f\u5b50\uff1b\n2) \u5bf9\u4e8e\u4efb\u610f$X$\u3001$Y$\u3001$Z$\u90fd\u4e0d\u6210\u7acb\u7684\u5f0f\u5b50\uff1b\n3) \u5bf9\u4e8e\u67d0\u4e9b$X$\u3001$Y$\u3001$Z$\u6210\u7acb\u7684\u5f0f\u5b50\uff1a\na) $|XZ|\\leqslant|XY|+|YZ|$\uff1b\nb) $|XY|\\leqslant|ZX|+|ZY|$\uff1b\nc) $|YZ|\\geqslant|XY|+|XZ|$\uff1b\nd) $|XZ|>|XY|+|YZ|$\uff1b\ne) $|XY|=|YX|$\uff1b\nf) $|YZ|<0$\uff1b\ng) $|YZ|>0$\uff1b\nh) $|XZ|-|YZ|>|XY|$\uff1b\ni) $|XY|+|YZ|\\leqslant|XZ|$\uff1b\nj) $|XY|=|YZ|=|ZX|$\uff0e",
      "figure_ids": []
    },
    {
      "number": "30",
      "text": "30. \u7528\u89c4\u5b9a\u7684\u7b26\u53f7\u8868\u793a\uff1a\n1) \u70b9$M$\u5c5e\u4e8e\u76f4\u7ebf$(AB)$\uff1b\n2) \u70b9$C$\u4e0d\u5c5e\u4e8e\u76f4\u7ebf$AB$\uff0e",
      "figure_ids": []
    },
    {
      "number": "31",
      "text": "31.\u00b0 \u8bfb\u51fa\u4e0b\u5217\u8bb0\u53f7\uff1a\n1) $A\\in(TP)$\uff1b\n2) $B\\notin(TN)$\uff1b\n3) $M\\notin(AB)$\uff1b\n4) $N\\in(CD)$\uff0e",
      "figure_ids": []
    },
    {
      "number": "32",
      "text": "32.\u00b0\n1) \u5305\u542b\u4e00\u4e2a\u5df2\u77e5\u70b9\u7684\u76f4\u7ebf\u6709\u591a\u5c11\u6761\uff1f\u4e24\u4e2a\u5df2\u77e5\u70b9\u5462\uff1f\u4e09\u4e2a\u5df2\u77e5\u70b9\u5462\uff1f\n2) \u901a\u8fc7\u4e24\u4e2a\u5df2\u77e5\u70b9\u53ef\u4ee5\u4f5c\u591a\u5c11\u6761\u4e0d\u540c\u7684\u76f4\u7ebf\u5462\uff1f",
      "figure_ids": []
    },
    {
      "number": "33",
      "text": "33.\u00b0\n1) \u4e24\u6761\u76f4\u7ebf\u53ea\u53ef\u80fd\u6709\u4e00\u4e2a\u516c\u5171\u70b9\u5417\uff1f\n2) \u4e24\u6761\u76f4\u7ebf\u53ef\u80fd\u53ea\u6709\u4e24\u4e2a\u516c\u5171\u70b9\u5417\uff1f\u8bf4\u660e\u7406\u7531\uff0e",
