  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/6-8g/evidence/stemrobin188-6g-source139140/author-first04/files/source6g139140-author-first-04/work/6-8g/pages/0140/figures/fig-192.png",
