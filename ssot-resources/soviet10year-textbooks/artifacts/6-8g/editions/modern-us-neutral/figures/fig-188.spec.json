    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/6-8g/evidence/stemrobin188-6g-source135136/author-first03/files/source6g135136-author-first-01/work/6-8g/pages/0136/figures/fig-188.png",
