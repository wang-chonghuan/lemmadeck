    "authoritativeText": [
      {
        "lesson": "geo68-c1-s1",
        "text": "1. 线段、圆、三角形——这些都是你们熟悉的几何图形．你们还学过图1中画出的那些图形．"
      },
      {
        "lesson": "geo68-c1-s1",
        "text": "什么是“几何图形”呢？\n我们从一个例子讲起．"
      },
      {
        "lesson": "geo68-c1-s1",
        "text": "上面我们把圆周定义为一个点集．每一个几何图形都是点集．几何中对于“几何图形”的概念有如下定义．"
      },
      {
        "lesson": "geo68-c1-s1",
        "text": "定义 任一点集叫做几何图形*．"
      }
    ],
    "inventory": [
      {
        "id": "source-a-segment",
        "description": "Upper-left source а): one solid rising-right segment with unmarked named ends A and B. Thick touching ink at A is ambiguous, so no extra dot is invented. Modern label a) replaces Cyrillic а). No length or arrow.",
        "objects": ["a-edge", "a-A-label", "a-B-label", "a-part-label"],
