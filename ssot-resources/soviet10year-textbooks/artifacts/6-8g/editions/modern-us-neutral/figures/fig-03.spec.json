    },
    "authoritativeText": [
      {
        "lesson": "geo68-c1-s1",
        "text": "图3上的圆周的半径记作$r$．对于这个圆周的任意一点$X$，有$|XO|=r$．如果点$M$不属于圆周，那么$|MO|\\ne r$．"
      },
      {
        "lesson": "geo68-c1-s1",
        "text": "定义 在同一平面上，和已知点的距离为已知正数的点的集合，叫做圆周．"
      },
      {
        "lesson": "geo68-c1-s1",
        "text": "圆心为$O$、半径为$r$的圆周记作：圆周$(O,r)$．"
      }
    ],
    "inventory": [
      {
        "id": "source-circumference-O-X-M",
        "description": "Single unfilled circumference with exactly three marked points O, X, M and four Latin labels O, X, M, r. O is its center, X is on the upper-right boundary, and M is strictly interior below and right of O and below the shallow OX radius. One solid OX segment with r above it. No subfigures, axes, grid, ticks or arrows. Inventory recorded in source-inventory.md before spec construction.",
        "objects": ["circle", "O", "X", "M", "radius-OX"],
        "assertions": ["X-on-circle", "OX-is-radius", "M-inside-distance", "radius-connects-O-X", "three-source-points"],
        "requires": ["pointRelationships"]
      }
