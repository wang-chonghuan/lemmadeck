    {
      "kind": "p",
      "text": "当 $x>0$，公式(1)对任何有理指数 $r$ 都成立(这一点将在十年级给予证明)：",
      "id": null,
      "label": null,
      "printed_page": 163,
      "source_refs": [
        "p0170#3"
      ],
      "source_text": "当 $x>0$，公式(1)对任何有理指数 $r$ 都成立(这一点将在十年级给予证明)：",
      "changes": [],
