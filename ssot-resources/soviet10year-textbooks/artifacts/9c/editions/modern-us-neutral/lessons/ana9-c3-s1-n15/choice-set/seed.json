  "exercises": [
    {
      "number": "118",
      "text": "\u4e60\u9898\n118. \u8bc1\u660e\uff1a2.6\u548c2.7\u5206\u522b\u662f $\\sqrt{7}$ \u7684\u7cbe\u786e\u52300.1\u7684\u4e0d\u8db3\u8fd1\u4f3c\u503c\u548c\u8fc7\u5269\u8fd1\u4f3c\u503c.",
      "figure_ids": []
    },
    {
      "number": "119",
      "text": "\u4e60\u9898\n119. \u6c42\u4e0b\u5217\u5404\u6570\u7684\u7cbe\u786e\u52300.1\u7684\u4e0d\u8db3\u8fd1\u4f3c\u503c\u548c\u8fc7\u5269\u8fd1\u4f3c\u503c\uff1a\na) $0.2664$\uff1b\nb) $-1.27$\uff1b\nc) $2-\\frac{5}{6}$\uff1b\nd) $\\sqrt{11}$\u3002",
      "figure_ids": []
    },
    {
      "number": "120",
      "text": "\u4e60\u9898\n120. \u8bbe $x$ \u662f\u4e00\u4e2a\u5b9e\u6570\uff0c\u800c\u4e14\n$3<x<4$\uff0c\n$3.6<x<3.7$\uff0c\n$3.60<x<3.61$\uff0c\n$3.609<x<3.610$\uff0c\n$3.6091<x<3.6092$\u3002\n\u5199\u51fa\u8868\u793a\u5b9e\u6570 $x$ \u7684\u8fd9\u4e2a\u65e0\u7a77\u5c0f\u6570\u7684\u524d\u56db\u4f4d\u5c0f\u6570\uff0c\u4e0d\u4f5c\u56db\u820d\u4e94\u5165\u3002",
      "figure_ids": []
    },
    {
      "number": "121",
      "text": "\u4e60\u9898\n121. \u6c42\u51fa\u4e0b\u5217\u5404\u6570\u7684\u524d\u4e09\u7ec4\u4e0d\u8db3\u8fd1\u4f3c\u5c0f\u6570\u548c\u8fc7\u5269\u8fd1\u4f3c\u5c0f\u6570\uff0c\u4f9d\u6b21\u7cbe\u786e\u5230\u4e2a\u4f4d\u3001\u5341\u5206\u4f4d\u548c\u767e\u5206\u4f4d\u3002\n\u5e76\u6309\u672c\u8bfe\u6574\u6570\u90e8\u5206\u53ef\u4e3a\u8d1f\u3001\u5c0f\u6570\u5c3e\u6570\u975e\u8d1f\u7684\u8bb0\u6cd5\uff0c\u5199\u51fa\u5c0f\u6570\u5c3e\u6570\u7684\u524d\u4e09\u4f4d\u6570\u5b57\uff0c\u4e0d\u4f5c\u56db\u820d\u4e94\u5165\uff1b\u6574\u6570\u90e8\u5206\u4e0a\u65b9\u7684\u6a2a\u7ebf\u53ea\u8868\u793a\u6574\u6570\u90e8\u5206\u7684\u8d1f\u53f7\u3002\na) $\\frac{3}{14}$\uff1b\nb) $-\\frac{10}{3}$\uff1b\nc) $\\sqrt{3}$\uff1b\nd) $-\\sqrt{3}$\u3002",
      "figure_ids": []
    },
    {
      "number": "122",
      "text": "\u4e60\u9898\n122. \u5df2\u77e5\uff1a$x=0.5638413\\cdots,\\quad y=1.3414825\\cdots$. \u6c42\u51fa\u548c $x+y$\u7684\u524d\u4e94\u4e2a\u5c0f\u6570\u4f4d.",
      "figure_ids": []
    },
    {
      "number": "123",
      "text": "\u4e60\u9898\n123. \u5df2\u77e5\uff1a$x=2.1468\\cdots,\\quad y=1.5431\\cdots$. \u6c42\u51fa\u79ef $xy$ \u7684\u524d\u4e8c\u4e2a\u5c0f\u6570\u4f4d.",
      "figure_ids": []
    },
    {
      "number": "124",
      "text": "\u4e60\u9898\n124. \u7528\u56db\u820d\u4e94\u5165\u5c06\u4e0b\u5217\u5404\u548c\u6570\u8fd1\u4f3c\u5230\u56db\u4f4d\u6709\u6548\u6570\u5b57\uff0c\u4fdd\u7559\u8868\u8fbe\u7cbe\u5ea6\u6240\u9700\u7684\u672b\u5c3e\u96f6\uff1a\na) $\\frac{1}{3}+\\sqrt{2}$\uff1b\nb) $\\sqrt{2}+\\sqrt{5}$\u3002",
      "figure_ids": []
    },
    {
      "number": "125",
      "text": "\u4e60\u9898\n125.* \u6c42\u4e0b\u5217\u5404\u79ef\u7684\u524d\u4e09\u4e2a\u5c0f\u6570\u4f4d\uff0c\u4e0d\u4f5c\u56db\u820d\u4e94\u5165\uff1a\na) $\\frac{1}{7}\\times\\sqrt{3}$\uff1b\nb) $\\sqrt{2}\\times\\sqrt{5}$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u4e00\u822c\u5730\u8bf4\uff0c\u6570$x=a_0.a_1a_2a_3\\cdots$\u7684\u7cbe\u786e\u5230 $10^{-n}$ \u7684\u8fd1\u4f3c\u5c0f\u6570\uff0c\u5177\u6709\u5982\u4e0b\u5f62\u5f0f\u3002\n\u8fd9\u91cc\u6cbf\u7528\u6574\u6570\u90e8\u5206\u53ef\u4e3a\u8d1f\u3001\u5c0f\u6570\u5c3e\u6570\u975e\u8d1f\u7684\u8bb0\u6cd5\uff1b\n\u8d1f\u6570\u6574\u6570\u90e8\u5206\u4e0a\u65b9\u7684\u6a2a\u7ebf\u53ea\u8868\u793a\u6574\u6570\u90e8\u5206\u7684\u8d1f\u53f7\uff0c\u4e0d\u8868\u793a\u6574\u4e2a\u5c0f\u6570\u7684\u8d1f\u53f7\u3002\n\n\u4e0d\u8db3\u8fd1\u4f3c\u503c\u4ece\u4e0b\u65b9\u903c\u8fd1\uff0c\u4e0d\u80fd\u5bf9\u666e\u901a\u8d1f\u5c0f\u6570\u76f4\u63a5\u5411\u96f6\u622a\u65ad\u3002"
    },
    {
      "block": 2,
      "text": "\u4e0d\u8db3\u8fd1\u4f3c\u5c0f\u6570\uff1a\n$x_n=a_0.a_1a_2a_3\\cdots a_n$\uff0c"
    },
    {
      "block": 3,
      "text": "\u8fc7\u5269\u8fd1\u4f3c\u5c0f\u6570\uff1a\n$x'_n=a_0.a_1a_2a_3\\cdots a_n+10^{-n}$."
    },
    {
      "block": 5,
      "text": "2. \u5047\u8bbe\u7ed9\u5b9a\u4e24\u4e2a\u5b9e\u6570 $x$ \u548c $y$. \u5b83\u4eec\u7684\u7cbe\u786e\u5230 $10^{-n}$ \u7684\u4e0d\u8db3\u548c\u8fc7\u5269\u8fd1\u4f3c\u5c0f\u6570\u6ee1\u8db3\u4e0d\u7b49\u5f0f\uff1a\n$x_n\\leqslant x<x'_n,\\quad y_n\\leqslant y<y'_n$."
    },
    {
      "block": 8,
      "text": "\u5b9a\u4e49 \u5982\u679c\u5bf9\u4e8e\u4efb\u610f\u975e\u8d1f\u6574\u6570 $n$\uff0c\u5b9e\u6570 $z$ \u6ee1\u8db3\u4e0d\u7b49\u5f0f$x_n+y_n\\leqslant z<x'_n+y'_n$\uff0c\u90a3\u4e48\uff0c$z$ \u53eb\u505a\u5b9e\u6570 $x$ \u548c $y$ \u7684\u548c."
    },
    {
      "block": 15,
      "text": "\u5b9a\u4e49 \u5982\u679c\u5bf9\u4e8e\u4efb\u610f\u975e\u8d1f\u6574\u6570 $n$\uff0c\u5b9e\u6570 $z$ \u6ee1\u8db3\u4e0d\u7b49\u5f0f$x_ny_n\\leqslant z<x'_ny'_n$\uff0c\u90a3\u4e48\uff0c$z$ \u53eb\u505a\u5b9e\u6570 $x$ \u548c $y$ \u7684\u4e58\u79ef."
    },
    {
      "block": 16,
      "text": "\u53ef\u4ee5\u8bc1\u660e\uff0c\u8fd9\u6837\u7684\u6570\u5b58\u5728\u800c\u4e14\u53ea\u6709\u4e00\u4e2a\u3002\n\u4e0a\u8ff0\u4e58\u79ef\u533a\u95f4\u53ea\u76f4\u63a5\u7528\u4e8e\u975e\u8d1f\u56e0\u5b50\uff1b\n\u5b83\u7684\u5bbd\u5ea6\u968f\u7cbe\u5ea6\u63d0\u9ad8\u8d8b\u4e8e\u96f6\uff0c\u4f46\u4e00\u822c\u4e0d\u7b49\u4e8e\u5355\u4e2a\u56e0\u5b50\u7684\u7cbe\u5ea6\u5355\u4f4d\u3002\n\n\u5982\u679c\u5176\u4e2d\u6709\u4e00\u4e2a\u6216\u8005\u4e24\u4e2a\u6570\u662f\u8d1f\u6570\uff0c\u5148\u5bf9\u7edd\u5bf9\u503c\u5efa\u7acb\u975e\u8d1f\u4e58\u79ef\uff0c\u518d\u4f7f\u7528\u7b26\u53f7\u89c4\u5219\uff0c\u4e0d\u80fd\u76f4\u63a5\u628a\u5e26\u7b26\u53f7\u7684\u4e0a\u4e0b\u754c\u9010\u9879\u76f8\u4e58\u3002"
    }
  ],
