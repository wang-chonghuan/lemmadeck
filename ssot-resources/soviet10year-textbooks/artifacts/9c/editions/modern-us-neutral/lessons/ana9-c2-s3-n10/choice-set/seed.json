  "concepts": [
    {
      "block": 2,
      "text": "\u5f53\u57fa\u672c\u7ed3\u679c\u6709\u9650\u4e14\u603b\u6570\u975e\u96f6\uff0c\u5f7c\u6b64\u4e92\u65a5\u3001\u8986\u76d6\u5168\u90e8\u53ef\u80fd\uff0c\u5e76\u4e14\u6bcf\u4e2a\u57fa\u672c\u7ed3\u679c\u7b49\u53ef\u80fd\u65f6\uff0c\u67d0\u4e8b\u4ef6\u7684\u6982\u7387\u7b49\u4e8e\u6709\u5229\u7ed3\u679c\u6570\u4e0e\u57fa\u672c\u7ed3\u679c\u603b\u6570\u4e4b\u6bd4\u3002\n\u8fd9\u91cc\u8ba1\u6570\u7684\u662f\u57fa\u672c\u7ed3\u679c\uff0c\u4e0d\u662f\u9ed8\u8ba4\u628a\u989c\u8272\u3001\u4ef7\u683c\u6216\u70b9\u6570\u548c\u7b49\u7c7b\u522b\u770b\u6210\u7b49\u53ef\u80fd\u3002"
