    {
      "number": "79",
      "text": "\u4e60 \u9898\n79. \u57288\u5f20\u5927\u5c0f\u5f62\u72b6\u76f8\u540c\u7684\u5361\u7247\u4e0a\u5206\u522b\u5199\u7740\u65702\u30014\u30016\u30017\u30018\u300111\u300112\u548c13\u3002\u968f\u673a\u53d6\u51fa\u4e24\u5f20\u4e0d\u540c\u5361\u7247\uff0c\u6bcf\u4e00\u5bf9\u88ab\u53d6\u51fa\u7684\u673a\u4f1a\u76f8\u7b49\u3002\u4ee5\u8fd9\u4e24\u4e2a\u6570\u5206\u522b\u4f5c\u4e3a\u5206\u5b50\u548c\u5206\u6bcd\uff0c\u6240\u6210\u5206\u6570\u4e0d\u53ef\u7ea6\u7684\u6982\u7387\u662f\u591a\u5c11\uff1f",
