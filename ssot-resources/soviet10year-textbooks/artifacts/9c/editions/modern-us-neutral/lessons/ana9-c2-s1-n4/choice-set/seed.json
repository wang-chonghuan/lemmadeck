  "exercises": [
    {
      "number": "32",
      "text": "\u4e60\u9898\n32. \u7528\u96c6\u5408$A$\u7684\u5143\u7d20\u7ec4\u6210\u4e00\u5207\u53ef\u80fd\u7684\u5168\u6392\u5217\uff0c\u5982\u679c\uff1a\na) $A=\\{1\\}$;\nb) $A=\\{7,8\\}$;\nc) $A=\\{a,b,c\\}$;\nd) $A=\\{m,n,p,q\\}$.",
      "figure_ids": []
    },
    {
      "number": "33",
      "text": "\u4e60\u9898\n33. \u7528\u7ea2\u3001\u84dd\u3001\u767d\u4e09\u79cd\u989c\u8272\u7684\u6a2a\u5e03\u6761\uff0c\u53ef\u4ee5\u62fc\u6210\u591a\u5c11\u79cd\u4e0d\u540c\u7684\u4e09\u8272\u65d7\uff1f",
      "figure_ids": []
    },
    {
      "number": "34",
      "text": "\u4e60\u9898\n34. \u8bc1\u660e\u516c\u5f0f\uff08\u8bbe$n>m$\uff09\uff1a\na) $\\frac{(m+3)!}{m!}=(m+1)(m+2)(m+3)$;\nb) $\\frac{n!}{(n-m)!}=n(n-1)\\cdots(n-m+2)(n-m+1)$.",
      "figure_ids": []
    },
    {
      "number": "35",
      "text": "\u4e60\u9898\n35. \u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\na) $8!+9!$\uff1b\nb) $10!-11!$\uff1b\nc) $\\frac{102!}{100!}$\uff1b\nd) $\\frac{6!-5!}{120}$.",
      "figure_ids": []
    },
    {
      "number": "36",
      "text": "\u4e60\u9898\n36. \u5316\u7b80\u5206\u5f0f\uff1a\na) $\\frac{n!}{(n-1)!}$\uff1b\nb) $\\frac{(n-2)!}{n!}$\uff1b\nc) $\\frac{(n-1)!}{(n-3)!}$\uff1b\nd) $\\frac{2k(2k-1)}{(2k)!}$\uff08$k\\in N$\uff09.",
      "figure_ids": []
    },
    {
      "number": "37",
      "text": "\u4e60\u9898\n37. \u8ba1\u7b97\uff1a\na) $\\frac{1}{n!}-\\frac{1}{(n+1)!}$\uff1b\nb) $\\frac{1}{(k-1)!}-\\frac{1}{k!}$\uff1b\nc) $\\frac{p(p-1)(p-2)(p-3)(p-4)!}{(p-2)!}$\uff1b\nd) $\\frac{m(m-1)(m-2)\\cdots(m-(k-1))}{m!}$\uff0c\uff08$m\\geqslant k$\uff09.",
      "figure_ids": []
    },
    {
      "number": "38",
      "text": "\u4e60\u9898\n38. \u4e00\u4e2a\u96c6\u5408\u5e94\u8be5\u5305\u542b\u591a\u5c11\u4e2a\u5143\u7d20\uff0c\u624d\u80fd\u4f7f\u5f97\u5b83\u7684\u5143\u7d20\u7684\u5168\u6392\u5217\u603b\u6570\uff1a\na) \u4e0d\u5927\u4e8e$1000$\uff1b\nb) \u4e0d\u5c0f\u4e8e$500$\uff1f",
      "figure_ids": []
    },
    {
      "number": "39",
      "text": "\u4e60\u9898\n39. \u4e5d\u4e2a\u5b66\u751f\u7684\u540d\u5355\u6709\u591a\u5c11\u79cd\u6392\u6cd5\uff1f",
      "figure_ids": []
    },
    {
      "number": "40",
      "text": "\u4e60\u9898\n40. \u4e00\u5217\u5ba2\u8f66\u6709$14$\u8282\u8f66\u53a2. $14$\u4f4d\u4e58\u52a1\u5458\u5206\u914d\u5230\u8fd9\u4e9b\u8f66\u53a2\uff0c\u5982\u679c\u6bcf\u4e2a\u8f66\u53a2\u4e00\u4f4d\uff0c\u4e00\u5171\u6709\u591a\u5c11\u79cd\u53ef\u80fd\u7684\u5206\u914d\u65b9\u6cd5\uff1f",
      "figure_ids": []
    },
    {
      "number": "41",
      "text": "\u4e60\u9898\n41. \u7531\u6570\u5b57$0$\u3001$1$\u3001$2$\u3001$3$\u53ef\u4ee5\u7ec4\u6210\u591a\u5c11\u4e2a\u6ca1\u6709\u91cd\u590d\u6570\u5b57\u7684\u56db\u4f4d\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "42",
      "text": "\u4e60\u9898\n42. \u7531\u6570\u5b57$1$\u3001$2$\u3001$3$\u3001$4$\u3001$5$\u7ec4\u6210\u4e00\u5207\u6ca1\u6709\u91cd\u590d\u6570\u5b57\u7684\u4e94\u4f4d\u6570\u4e2d\uff0c\na) \u6709\u591a\u5c11\u4e2a\u4ee5\u6570\u5b57$3$\u5f00\u59cb\u7684\u6570\uff1f\nb) \u6709\u591a\u5c11\u4e2a\u4e0d\u4ee5\u6570\u5b57$5$\u5f00\u59cb\u7684\u6570\uff1f\nc) \u6709\u591a\u5c11\u4e2a\u4ee5$54$\u5f00\u59cb\u7684\u6570\uff1f\nd) \u6709\u591a\u5c11\u4e2a\u4e0d\u4ee5$543$\u5f00\u59cb\u7684\u6570\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 6,
      "text": "\u5229\u7528\u9012\u63a8\u516c\u5f0f$P_n=nP_{n-1}$ $(1)$\u4f9d\u6b21\u8ba1\u7b97$P_n$\u5f88\u65b9\u4fbf\u3002"
    },
    {
      "block": 10,
      "text": "\u7531\u516c\u5f0f(1)\u5f97\u51fa\uff08\u53c2\u770b\u7b2c19\u9898\uff09\uff0c\u4e00\u822c\u5730\u8bf4\uff0c$n$\u4e2a\u5143\u7d20\u7684\u5168\u6392\u5217\u603b\u6570$P_n$\u7b49\u4e8e\u524d$n$\u4e2a\u81ea\u7136\u6570\u7684\u4e58\u79ef\uff1a\n$P_n=1\\times2\\times3\\times\\cdots\\times n$. $(2)$"
    },
    {
      "block": 11,
      "text": "\u524d$n$\u4e2a\u81ea\u7136\u6570\u7684\u4e58\u79ef\uff0c\u901a\u5e38\u7528\u4e00\u79cd\u7279\u6b8a\u7684\u7b26\u53f7\u8868\u793a\uff1a\n$n!$\uff08\u8bfb\u4f5c\u201c$n$\u7684\u9636\u4e58\u201d\uff09. \u5229\u7528\u8fd9\u4e2a\u7b26\u53f7\uff0c\u516c\u5f0f(2)\u53ef\u4ee5\u6539\u5199\u6210$P_n=n!$ $(3)$"
    },
    {
      "block": 12,
      "text": "\u4e3a\u4f7f\u4ee5\u540e\u53d9\u8ff0\u7b80\u4fbf\uff0c\u89c4\u5b9a\u7a7a\u96c6\u53ea\u80fd\u7528\u4e00\u79cd\u65b9\u6cd5\u6392\u5217\uff0c\u5373$P_0=1$."
    }
  ],
