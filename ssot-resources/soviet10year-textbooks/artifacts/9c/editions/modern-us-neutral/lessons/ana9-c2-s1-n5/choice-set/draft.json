    {
      "id": "q43",
      "source_numbers": [
        "43"
      ],
      "view": {
        "mode": "single",
        "stem": "设 $n$ 为正整数，采用 $0!=1$。利用排列数的阶乘公式证明 $A_n^{n-1}=A_n^n=n!$，下面哪一组代入式对每一个 $n\\ge1$ 都正确？",
        "figure_ids": [],
        "options": [
          {
            "id": "a",
            "text": "$A_n^{n-1}=\\frac{n!}{(n-1)!}$，$A_n^n=\\frac{n!}{0!}$。",
            "figure_ids": []
          },
          {
            "id": "b",
            "text": "$A_n^{n-1}=\\frac{n!}{n!}$，$A_n^n=\\frac{n!}{n!}$。",
            "figure_ids": []
          },
          {
            "id": "c",
            "text": "$A_n^{n-1}=\\frac{n!}{1!}$，$A_n^n=\\frac{n!}{n!}$。",
            "figure_ids": []
          },
          {
            "id": "d",
            "text": "$A_n^{n-1}=\\frac{n!}{1!}$，$A_n^n=\\frac{n!}{0!}$。",
            "figure_ids": []
          }
        ]
      },
      "intent": {
        "task": "在 m=n-1 与 m=n 两个边界情况下，正确代入 n-m，并解释两数都为 n!。",
        "source_solution": "A_n^m=n!/(n-m)!。m=n-1 时 n-m=1；m=n 时 n-m=0。1!=0!=1，故两排列数都为 n!。n=1 也成立：空排列数和一元素全排列数都为1；n=0 时 m=n-1 不在定义域。",
        "unit_reason": "两次相互关联的边界代入组成一个完整证明步骤，不拆成两个公式选择。",
        "concept_blocks": [
          11,
          12
        ],
        "limitations": [
          "判断证明的关键代入，不验证自主写出完整证明。",
          "把整数 n>=1 和0!=1明确显示，不对 n=0 的未定义上指标作断言。"
        ],
        "figure_observations": []
      },
      "key": {
        "correct": [
          "d"
        ],
        "rationales": [
          {
            "option_id": "a",
            "truth": "incorrect",
            "derivation": "在第一式把分母(n-m)!错写为m!，n=3时给6/2=3而实际A_3^2=6；非普遍成立。",
            "misconception": "把剩余未选元素的阶乘误作被选元素的阶乘。"
          },
          {
            "option_id": "b",
            "truth": "incorrect",
            "derivation": "两分母都写成n!，得到1，漏掉有序排列的n!种次序。",
            "misconception": "把排列数当成选择全部元素时的一个无序集合。"
          },
          {
            "option_id": "c",
            "truth": "incorrect",
            "derivation": "第一式正确，第二式却把全排列的分母误写n!，得1；例如n=3时实际全排列有6种。",
            "misconception": "在全取情况下误除去所有排列顺序。"
          },
          {
            "option_id": "d",
            "truth": "correct",
            "derivation": "n-(n-1)=1、n-n=0，分母分别为1!与0!，均为1。",
            "misconception": null
          }
        ]
      }
    },
