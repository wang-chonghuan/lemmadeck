  "exercises": [
    {
      "number": "116",
      "text": "\u4e60 \u9898\n116. \u6307\u51fa\u4e0b\u5217\u6570\u90a3\u4e9b\u662f\u6709\u7406\u6570\uff1a\n$-\\frac{2}{3}$\uff0c$5$\uff0c$4.2$\uff0c$-1.6$\uff0c\n$\\sqrt{6}$\uff0c$\\sqrt{2}$\uff0c$0$\uff0c$0.757557555755557\\cdots$\n(\u6700\u540e\u4e00\u4e2a\u6570\uff0c\u7b2c\u4e00\u4e2a $7$\u540e\u9762\u6709\u4e00\u4e2a $5$\uff0c\u7b2c\u4e8c\u4e2a $7$ \u540e\u9762\u6709\u4e24\u4e2a $5$\uff0c\u7b2c\u4e09\u4e2a $7$ \u540e\u9762\u6709\u4e09\u4e2a $5$\uff0c\u7b49\u7b49).\n\u5c06\u6bcf\u4e2a\u6709\u7406\u6570\u8868\u793a\u4e3a $\\frac{m}{n}$\uff0c\u5176\u4e2d $m\\in Z$\uff0c$n\\in N$.\n\u5206\u6bcd n \u4e0d\u4e3a\u96f6\u3002",
      "figure_ids": []
    },
    {
      "number": "117",
      "text": "\u4e60 \u9898\n117.* \u4e3e\u51fa\u53d8\u91cf $a$ \u7684\u51e0\u4e2a\u6b63\u6570\u503c\uff0c\u4f7f\u5f97\u8868\u8fbe\u5f0f $\\sqrt{a}$ \u7684\u503c\u662f\uff1a\na) \u65e0\u7406\u6570\uff0c\nb) \u6709\u7406\u6570.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u57fa\u672c\u7684\u601d\u8def\u5f88\u7b80\u5355.\n\u9664\u4e86\u65e0\u7a77\u5faa\u73af\u5c0f\u6570\uff0c\u8fd8\u6709\u65e0\u7a77\u4e0d\u5faa\u73af\u5c0f\u6570.\n\u4f8b\u5982\n$0.101001000100001000001\\cdots$\n\n\uff08\u7b2c\u4e00\u4e2a $1$ \u540e\u9762\u6709\u4e00\u4e2a\u96f6\uff0c\u7b2c\u4e8c\u4e2a $1$ \u540e\u9762\u6709\u4e24\u4e2a\u96f6\uff0c\u4ee5\u540e\u4f9d\u6b64\u7c7b\u63a8\uff09.\n\u73b0\u5728\u6211\u4eec\u91c7\u7528\u8fd9\u6837\u7684\u8bf4\u6cd5\uff1a\u6bcf\u4e00\u4e2a\u65e0\u7a77\u4e0d\u5faa\u73af\u5c0f\u6570\u8868\u793a\u67d0\u4e00\u4e2a\u65b0\u7684\u6570.\n\u6240\u6709\u8fd9\u79cd\u6570\u7684\u96c6\u5408\u5c31\u662f\u6240\u6709\u65e0\u7406\u6570\u7684\u96c6\u5408.\n\n\u65e0\u7406\u6570\u548c\u6709\u7406\u6570\u4e00\u8d77\u6784\u6210\u5168\u4f53\u5b9e\u6570\u7684\u96c6\u5408 $R$.\n\u8fd9\u91cc\u7684\u4e0d\u5faa\u73af\u662f\u6307\u4ece\u4efb\u4f55\u4e00\u4f4d\u5f00\u59cb\uff0c\u540e\u9762\u7684\u6570\u5b57\u90fd\u4e0d\u4f1a\u6309\u56fa\u5b9a\u5468\u671f\u91cd\u590d\u3002"
    },
    {
      "block": 3,
      "text": "\u8fd9\u6837\u4e00\u6765\uff0c\u4efb\u610f\u5b9e\u6570\u90fd\u53ef\u4ee5\u7528\u65e0\u7a77\u5c0f\u6570\u6765\u8868\u793a.\n\u5b9e\u6570\u548c\u65e0\u7a77\u5c0f\u6570\uff08\u4e0d\u5305\u62ec\u4ee5 $9$ \u4e3a\u5faa\u73af\u8282\u7684\u5faa\u73af\u5c0f\u6570\uff09\u4e4b\u95f4\u7684\u5bf9\u5e94\u5173\u7cfb\n$x\\to a_0.a_1a_2a_3\\cdots$\n\n\u662f\u4e00\u5bf9\u4e00\u7684\uff1a\u6bcf\u4e00\u4e2a\u5b9e\u6570 $x$ \u5bf9\u5e94\u4e00\u4e2a\u5b8c\u5168\u786e\u5b9a\u7684\u8fd9\u6837\u7684\u5c0f\u6570\uff1b\n\u6bcf\u4e00\u4e2a\u8fd9\u6837\u7684\u5c0f\u6570\u8868\u793a\u4e00\u4e2a\u5b8c\u5168\u786e\u5b9a\u7684\u5b9e\u6570.\n\u6709\u9650\u5c0f\u6570\u6cbf\u7528\u8865\u96f6\u7684\u5199\u6cd5\uff1b\n\n\u6392\u9664\u7684\u662f\u6700\u7ec8\u5168\u4e3a\u4e5d\u7684\u53e6\u4e00\u79cd\u7b49\u503c\u5c55\u5f00\u3002\n\u8fd9\u91cc\u6cbf\u7528\u524d\u4e24\u5c0f\u8282\u7684\u8bb0\u6cd5\uff1a\u6574\u6570\u90e8\u5206\u7684\u4e0a\u6a2a\u7ebf\u53ea\u8868\u793a\u6574\u6570\u90e8\u5206\u7684\u8d1f\u53f7\uff0c\u5c0f\u6570\u90e8\u5206\u4ecd\u4e3a\u975e\u8d1f\uff1b\n\u8fd9\u4e0d\u540c\u4e8e\u653e\u5728\u6574\u4e2a\u5c0f\u6570\u524d\u7684\u666e\u901a\u8d1f\u53f7\u3002"
    },
    {
      "block": 5,
      "text": "\u5bf9\u4e8e\u65b0\u5f15\u8fdb\u7684\u6570\uff0c\u8fd8\u8981\u5b9a\u4e49\u52a0\u6cd5\u8fd0\u7b97\u548c\u4e58\u6cd5\u8fd0\u7b97. \u8fd9\u4e9b\u8fd0\u7b97\u600e\u4e48\u6837\u8fdb\u884c\uff0c\u5c06\u5728\u4e0b\u4e00\u5c0f\u8282\u91cc\u4ecb\u7ecd. \u81f3\u4e8e\u51cf\u6cd5\u8fd0\u7b97\u548c\u9664\u6cd5\u8fd0\u7b97\uff0c\u8ddf\u4ee5\u524d\u4e00\u6837\uff0c\u5206\u522b\u5b9a\u4e49\u4e3a\u52a0\u6cd5\u548c\u4e58\u6cd5\u7684\u9006\u8fd0\u7b97.\n\u9664\u6cd5\u7684\u9664\u6570\u5fc5\u987b\u4e0d\u4e3a\u96f6\u3002"
    }
  ],
