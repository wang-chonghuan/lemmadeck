        },
        {
          "source_ref": "p0052#4",
          "block_index_zero_based": 3,
          "json_pointer": "/blocks/3",
          "n12_scope": true,
          "scope_note": "n12 source context; this is not a full-page glyph/science review.",
          "block": {
            "kind": "p",
