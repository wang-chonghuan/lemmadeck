  "exercises": [
    {
      "number": "115",
      "text": "\u4e60 \u9898\n115. \u7528\u65e0\u7a77\u5c0f\u6570\u7684\u5f62\u5f0f\u8868\u793a\u4e0b\u5217\u5404\u6570\uff0c\u5e76\u89e3\u91ca\u4e3a\u4ec0\u4e48\u8fd9\u4e9b\u65e0\u7a77\u5c0f\u6570\u662f\u5faa\u73af\u5c0f\u6570\uff1a\na) $\\frac{7}{3}$\uff1b\nb) $\\frac{23}{30}$\uff1b\nc) $-\\frac{3}{7}$\uff1b\nd) $-\\frac{29}{11}$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u5b9a\u4e49 \u5bf9\u4e8e\u65e0\u7a77\u5c0f\u6570 $a_0.a_1a_2a_3\\ldots$\uff0c\u5982\u679c\u5b58\u5728\u8fd9\u6837\u7684\u81ea\u7136\u6570 $N$ \u548c $p$\uff0c\u4f7f\u5f97\n$a_{n+p}=a_n$\uff0c\n\u5bf9\u4e00\u5207 $n\\geqslant N$\uff0c\u90a3\u4e48\u5c31\u628a\u5b83\u53eb\u505a\u5faa\u73af\u5c0f\u6570\uff08\u65e0\u7a77\u5faa\u73af\u5c0f\u6570\uff09\u3002\n\n\u8fd9\u91cc N \u548c p \u90fd\u53d6\u6b63\u6574\u6570\uff1b\np \u662f\u5468\u671f\u957f\u5ea6\uff0c\u4e0d\u662f\u91cd\u590d\u6570\u5b57\u672c\u8eab\u3002"
    },
    {
      "block": 3,
      "text": "\u5b9a\u7406 1. \u6bcf\u4e00\u4e2a\u6709\u7406\u6570\u90fd\u53ef\u4ee5\u7528\u4e00\u4e2a\u65e0\u7a77\u5faa\u73af\u5c0f\u6570\u6765\u8868\u793a\u3002"
    },
    {
      "block": 5,
      "text": "\u8bc1\u660e\u8fd9\u4e2a\u5b9a\u7406\u65f6\uff0c\u53ea\u8981\u8003\u8651\u975e\u8d1f\u7684\u6570\u5c31\u591f\u4e86\uff0c\u56e0\u4e3a\u8868\u793a\u6570$r$ \u7684\u65e0\u7a77\u5c0f\u6570$a_0.a_1a_2a_3\\cdots$\u548c\u8868\u793a $r$ \u7684\u5c0f\u6570\u90e8\u5206\u7684\u65e0\u7a77\u5c0f\u6570\uff0c\u5c0f\u6570\u70b9\u540e\u9762\u7684\u6570\u5b57\u5b8c\u5168\u76f8\u540c\uff0c\u800c\u6709\u7406\u6570\u7684\u5c0f\u6570\u90e8\u5206\u662f\u975e\u8d1f\u6709\u7406\u6570\u3002"
    },
    {
      "block": 8,
      "text": "\u4e00\u822c\u7684\u60c5\u51b5\uff1a\u5f53\u9664\u4ee5\u4efb\u610f\u81ea\u7136\u6570 $n$ \u65f6\uff0c\u53ea\u80fd\u6709 $n$ \u79cd\u4f59\u6570\uff1a\n$0,1,2,\\cdots,(n-1)$\u3002\n\u56e0\u6b64\uff0c\u9664\u6cd5\u8fd0\u7b97\u4e0d\u8d85\u8fc7 $n$ \u6b65\u5c31\u5fc5\u6709\u5176\u4e2d\u4e00\u4e2a\u4f59\u6570\u91cd\u590d\u51fa\u73b0\u3002\n\n\u8fd9\u91cc\u9664\u6570 n \u53d6\u6b63\u6574\u6570\uff0c\u8ba1\u6570\u5305\u62ec\u5f00\u59cb\u8ba1\u7b97\u5c0f\u6570\u4f4d\u4e4b\u524d\u7684\u4f59\u6570\u3002\n\u6bcf\u6b65\u7531\u5f53\u524d\u4f59\u6570\u552f\u4e00\u51b3\u5b9a\u4e0b\u4e00\u4f4d\u6570\u5b57\u548c\u65b0\u4f59\u6570\u3002"
    },
    {
      "block": 9,
      "text": "\u6ce8 \u5982\u679c\u5728\u9664\u6cd5\u8fd0\u7b97\u4e2d\uff0c\u51fa\u73b0\u7b49\u4e8e\u96f6\u7684\u4f59\u6570\uff0c\u81ea\u7136\u6b64\u540e\u4e00\u5207\u4f59\u6570\u4e5f\u90fd\u7b49\u4e8e\u96f6\uff0c\u90a3\u4e48\u6211\u4eec\u5c31\u5f97\u5230\u4ee5\u96f6\u4e3a\u5faa\u73af\u8282\u7684\u65e0\u7a77\u5c0f\u6570\u3002"
    }
  ],
