{
  "exercises": [
    {
      "number": "363",
      "text": "\u5229\u7528\u7b2c 43 \u5c0f\u8282\u4e2d\u7684\u4f8b\u5b50\u548c\u7b2c 352 \u548c 354 \u9898\uff0c\u6c42\u4e0b\u5217\u5404\u51fd\u6570\u7684\u5bfc\u6570\uff1a\na) $f(x)=x+5$\uff1b\nb) $g(x)=x^2+3.$",
      "figure_ids": []
    },
    {
      "number": "364",
      "text": "\u5229\u7528\u7b2c 43 \u5c0f\u8282\u4e2d\u7684\u4f8b\u5b50\u548c\u7b2c 352 \u548c 354 \u9898\uff0c\u6c42\u4e0b\u5217\u5404\u51fd\u6570\u7684\u5bfc\u6570\uff1a\na) $h(x)=x^2+x$\uff1b\nb) $u(x)=x^2+x+7.$",
      "figure_ids": []
    },
    {
      "number": "365",
      "text": "\u5229\u7528\u7b2c 43 \u5c0f\u8282\u4e2d\u7684\u4f8b\u5b50\u548c\u7b2c 352 \u548c 354 \u9898\uff0c\u6c42\u4e0b\u5217\u5404\u51fd\u6570\u7684\u5bfc\u6570\uff1a\na) $v(x)=x^2+\\frac{1}{x}+5$\uff1b\nb) $y(x)=x^2+\\frac{1}{x}+\\sqrt{x}$\u3002",
      "figure_ids": []
    },
    {
      "number": "366",
      "text": "\u8bc1\u660e\uff1a\u5982\u679c\u4e24\u4e2a\u51fd\u6570\u90fd\u6709\u5bfc\u6570\uff0c\u90a3\u4e48\u5b83\u4eec\u7684\u5dee\u7684\u5bfc\u6570\u7b49\u4e8e\u5b83\u4eec\u7684\u5bfc\u6570\u7684\u5dee\u3002",
      "figure_ids": []
    }
  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "\u8bbe $u$ \u548c $v$ \u662f\u5b9a\u4e49\u5728\u540c\u4e00\u4e2a\u533a\u95f4\u4e0a\u7684\u4e24\u4e2a\u51fd\u6570."
    },
    {
      "block": 1,
      "text": "\u5b9a\u7406. \u5982\u679c\u4e24\u4e2a\u51fd\u6570\u90fd\u6709\u5bfc\u6570\uff0c\u90a3\u4e48\u5b83\u4eec\u7684\u548c\u7684\u5bfc\u6570\u7b49\u4e8e\u5b83\u4eec\u7684\u5bfc\u6570\u7684\u548c\uff0c\u5373"
    },
    {
      "block": 2,
      "text": "$(u(x)+v(x))'=u'(x)+v'(x)$."
    },
    {
      "block": 3,
      "text": "\u8bc1\u660e \u7528 $w(x)$ \u8868\u793a\u8fd9\u4e24\u4e2a\u51fd\u6570\u7684\u548c $u(x)+v(x)$\uff0c\u5e76\u8ba1\u7b97 $w(x)$ \u7684\u5bfc\u6570\uff1a"
    },
    {
      "block": 4,
      "text": "$\\frac{\\Delta w(x)}{\\Delta x}=\\frac{w(x+\\Delta x)-w(x)}{\\Delta x}=\\frac{u(x+\\Delta x)+v(x+\\Delta x)-u(x)-v(x)}{\\Delta x}=\\frac{u(x+\\Delta x)-u(x)+v(x+\\Delta x)-v(x)}{\\Delta x}=\\frac{\\Delta u}{\\Delta x}+\\frac{\\Delta v}{\\Delta x}$\uff0c"
    },
    {
      "block": 5,
      "text": "\u4e8e\u662f\uff0c"
    },
    {
      "block": 6,
      "text": "$(u+v)'=w'=\\lim_{\\Delta x\\to0}\\frac{\\Delta w(x)}{\\Delta x}=\\lim_{\\Delta x\\to0}\\left(\\frac{\\Delta u}{\\Delta x}+\\frac{\\Delta v}{\\Delta x}\\right)=\\lim_{\\Delta x\\to0}\\frac{\\Delta u}{\\Delta x}+\\lim_{\\Delta x\\to0}\\frac{\\Delta v}{\\Delta x}=u'+v'$."
    },
    {
      "block": 7,
      "text": "\u5b9a\u7406\u8bc1\u6bd5."
    },
    {
      "block": 8,
      "text": "\u6ce8 \u7528\u6570\u5b66\u5f52\u7eb3\u6cd5\u53ef\u4ee5\u8bc1\u660e\uff0c\u8fd9\u4e2a\u5b9a\u7406\u5bf9\u4efb\u610f\u6709\u9650\u4e2a\u51fd\u6570\u7684\u548c\u4e5f\u6b63\u786e\uff1a\n$(u_1+u_2+\\cdots+u_n)'=u_1'+u_2'+\\cdots+u_n'$\u3002"
    }
  ],
  "figures": []
}
