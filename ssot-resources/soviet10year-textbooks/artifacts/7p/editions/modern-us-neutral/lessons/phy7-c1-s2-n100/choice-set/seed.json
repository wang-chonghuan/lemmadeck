  "exercises": [
    {
      "number": "1",
      "text": "(1) \u5728\u538b\u5f3a\u4fdd\u6301\u4e0d\u53d8\u3001\u7eaf\u6676\u4f53\u7684\u56fa\u6001\u548c\u6db2\u6001\u5171\u5b58\u7684\u7194\u5316\u8fc7\u7a0b\u4e2d\uff0c\u600e\u6837\u89e3\u91ca\u6e29\u5ea6\u59cb\u7ec8\u4fdd\u6301\u4e0d\u53d8\u7684\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "(2) \u6676\u4f53\u6b63\u5728\u7194\u5316\u65f6\uff0c\u52a0\u70ed\u5668\u4e2d\u71c3\u70e7\u7684\u71c3\u6599\u91ca\u653e\u7684\u80fd\u91cf\u90fd\u7528\u5230\u54ea\u91cc\u53bb\u4e86\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "(3) \u4ec0\u4e48\u662f\u7194\u89e3\u70ed\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "(4) \u7194\u89e3\u70ed\u6709\u54ea\u4e9b\u8ba1\u91cf\u5355\u4f4d\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u60f3\u4e00\u60f3\u6676\u4f53\u7194\u5316\u65f6\u7684\u5fae\u7c92\u6392\u5217\u53d8\u5316\uff0c\u5c31\u80fd\u7406\u89e3\u8fd9\u4e2a\u95ee\u9898\u3002\n\u7194\u5316\u9700\u8981\u7834\u574f\u539f\u6765\u7684\u957f\u7a0b\u6709\u5e8f\u6392\u5217\uff0c\u6539\u53d8\u5fae\u7c92\u95f4\u7684\u76f8\u4e92\u4f5c\u7528\u72b6\u6001\uff0c\u8fd9\u9700\u8981\u80fd\u91cf\u3002"
    },
    {
      "block": 2,
      "text": "\u6676\u4f53\u5df2\u7ecf\u8fbe\u5230\u7194\u70b9\u540e\uff0c\u5728\u4e0d\u53d1\u751f\u5316\u5b66\u53d8\u5316\u3001\u5e76\u4e14\u53ef\u4ee5\u5ffd\u7565\u4f53\u79ef\u53d8\u5316\u5bf9\u5916\u505a\u529f\u7b49\u5f71\u54cd\u7684\u8fd1\u4f3c\u4e0b\uff0c\u7ee7\u7eed\u5438\u6536\u7684\u70ed\u91cf\u7528\u4e8e\u7194\u5316\uff0c\u5185\u80fd\u968f\u4e4b\u589e\u52a0\u3002\n**\u6e29\u5ea6\u4fdd\u6301\u4e0d\u53d8\uff0c\u5e76\u4e0d\u8868\u793a\u5185\u80fd\u4fdd\u6301\u4e0d\u53d8\u3002\n**"
    },
    {
      "block": 3,
      "text": "**\u5728\u4e00\u5b9a\u538b\u5f3a\u4e0b\uff0c\u628a\u5df2\u7ecf\u5904\u5728\u7194\u70b9\u76841\u5343\u514b\u7eaf\u6676\u4f53\u5b8c\u5168\u53d8\u6210\u540c\u6e29\u5ea6\u7684\u6db2\u4f53\uff0c\u6240\u9700\u7684\u70ed\u91cf\u53eb\u4f5c\u8fd9\u79cd\u7269\u8d28\u7684\u7194\u89e3\u70ed\u3002\n**\u672c\u8bfe\u6cbf\u7528\u539f\u4e66\u7684\u540d\u79f0\u201c\u7194\u89e3\u70ed\u201d\uff1b\n\u8fd9\u4e2a\u6309\u6bcf\u5343\u514b\u7ed9\u51fa\u7684\u91cf\uff0c\u4e5f\u53eb\u6bd4\u7194\u5316\u70ed\u3002"
    },
    {
      "block": 5,
      "text": "**\u7126\u8033/\u5343\u514b\u3001\u5343\u5361/\u5343\u514b\u548c\u5361/\u514b\u3002\n**"
    }
  ],
