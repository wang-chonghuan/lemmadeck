  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u5728\u7269\u4f53\u5185\u90e8\u72b6\u6001\u4e0d\u53d8\u3001\u53ea\u6539\u53d8\u5176\u6574\u4f53\u8fd0\u52a8\u6216\u76f8\u5bf9\u4e8e\u5176\u4ed6\u7269\u4f53\u7684\u4f4d\u7f6e\u65f6\uff0c\u7269\u4f53\u7684\u5185\u80fd\u4e0e\u5b83\u6574\u4f53\u7684\u52a8\u80fd\u548c\u52bf\u80fd\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u7ed3\u5408\u672c\u8bfe\u7684\u953b\u9524\u548c\u6c22\u6c14\u6bd4\u8f83\u60c5\u5883\uff0c\u673a\u68b0\u80fd\u548c\u5185\u80fd\u8fd9\u4e24\u79cd\u80fd\u91cf\uff0c\u54ea\u4e00\u79cd\u8f83\u5bb9\u6613\u76f4\u63a5\u5229\u7528\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5982\u4e0a\u8282\u6240\u8ff0\uff0c\u4e00\u4e2a\u7269\u4f53\u6240\u6709\u5206\u5b50\u7684\u70ed\u8fd0\u52a8\u52a8\u80fd\uff0c\u4ee5\u53ca\u8fd9\u4e9b\u5206\u5b50\u4e4b\u95f4\u76f8\u4e92\u4f5c\u7528\u7684\u52bf\u80fd\uff0c\u5171\u540c\u7ec4\u6210\u672c\u8bfe\u6240\u8ba8\u8bba\u7684\u7269\u4f53\u5185\u80fd\u3002"
    },
    {
      "block": 1,
      "text": "**\u5728\u7269\u4f53\u5185\u90e8\u72b6\u6001\u4e0d\u53d8\u7684\u6761\u4ef6\u4e0b\uff0c\u7269\u4f53\u7684\u5185\u80fd\u4e0d\u7531\u5b83\u6574\u4f53\u7684\u8fd0\u52a8\u53ca\u5176\u76f8\u5bf9\u4e8e\u5176\u4ed6\u7269\u4f53\u7684\u4f4d\u7f6e\u51b3\u5b9a**\u3002\n\u7269\u4f53\u5728\u5177\u6709\u5185\u80fd\u7684\u540c\u65f6\uff0c\u4e5f\u53ef\u4ee5\u5177\u6709\u673a\u68b0\u80fd\u3002\n\u4f8b\u5982\uff0c\u5728\u5730\u9762\u4e0a\u65b9\u67d0\u4e00\u9ad8\u5ea6\u98de\u884c\u7684\u98de\u673a\uff0c\u9664\u4e86\u5185\u80fd\uff0c\u8fd8\u5177\u6709\u4e0e\u6574\u4f53\u8fd0\u52a8\u548c\u4f4d\u7f6e\u6709\u5173\u7684\u673a\u68b0\u80fd\uff0c\u4e5f\u5c31\u662f\u52a8\u80fd\u548c\u52bf\u80fd\u3002"
    },
    {
      "block": 5,
      "text": "\u5229\u7528\u7269\u4f53\u7684\u5185\u80fd\u5e76\u4e0d\u50cf\u4e0a\u8ff0\u953b\u9524\u7684\u60c5\u5f62\u90a3\u6837\u7b80\u5355\uff0c\u4e5f\u4e0d\u603b\u80fd\u5728\u7ed9\u5b9a\u6761\u4ef6\u4e0b\u76f4\u63a5\u5229\u7528\u3002\n\u79d1\u5b66\u7814\u7a76\u5341\u5206\u5173\u6ce8\u5982\u4f55\u5229\u7528\u5185\u80fd\uff1b\n\u8bb8\u591a\u6280\u672f\u8fdb\u6b65\u90fd\u4e0e\u4eba\u4eec\u638c\u63e1\u5229\u7528\u5185\u80fd\u505a\u529f\u7684\u65b9\u5f0f\u6709\u5173\u3002\n\n\u56e0\u6b64\uff0c\u5229\u7528\u7269\u4f53\u5185\u80fd\u5177\u6709\u91cd\u8981\u610f\u4e49\uff1b\n\u8fd9\u5e76\u4e0d\u662f\u8bf4\u5185\u80fd\u5728\u4efb\u4f55\u60c5\u51b5\u4e0b\u90fd\u4e0d\u80fd\u5229\u7528\u3002"
    }
  ],
