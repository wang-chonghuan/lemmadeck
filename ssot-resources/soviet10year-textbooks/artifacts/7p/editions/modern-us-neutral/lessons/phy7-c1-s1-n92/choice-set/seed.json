  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u4ec0\u4e48\u662f\u7269\u8d28\u7684\u6bd4\u70ed\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5f53\u5206\u522b\u4ee5$\\frac{\\text{\u7126\u8033}}{\\text{\u5343\u514b}\\cdot{}^\\circ\\mathrm{C}}$\u53ca$\\frac{\\text{\u5361}}{\\text{\u514b}\\cdot{}^\\circ\\mathrm{C}}$\u4e3a\u5355\u4f4d\u65f6\uff0c\u6c34\u7684\u6bd4\u70ed\u5404\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u94c5\u7684\u6bd4\u70ed\u662f$140\\frac{\\text{\u7126\u8033}}{\\text{\u5343\u514b}\\cdot{}^\\circ\\mathrm{C}}$\uff0c\u8fd9\u610f\u5473\u7740\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u7269\u8d28\u7684\u6bd4\u70ed\u4e0e\u5176\u5185\u80fd\u53d8\u5316\u4e4b\u95f4\u5b58\u5728\u7740\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u4e3a\u4ec0\u4e48\u8ddd\u79bb\u6c34\u57df\u8fd1\u6c14\u6e29\u5c31\u53d7\u5f71\u54cd\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u4f7f1\u5343\u514b\u6c34\u7684\u6e29\u5ea6\u5347\u9ad8$1^\\circ\\mathrm{C}$\u6240\u9700\u7684\u70ed\u91cf\u662f4200\u7126\u8033\u62161\u5343\u5361.\n\u4f46\u82e5\u4f7f1\u5343\u514b\u522b\u7684\u7269\u8d28\u7684\u6e29\u5ea6\u4e5f\u5347\u9ad8$1^\\circ\\mathrm{C}$\u6240\u9700\u8981\u7684\u70ed\u91cf\u5c31\u4e0d\u518d\u662f\u8fd9\u4e48\u591a\u4e86\uff08\u53c2\u770b\u00a790\uff09."
    },
    {
      "block": 1,
      "text": "\u4f7f\u5355\u4f4d\u8d28\u91cf\uff081\u514b\u62161\u5343\u514b\uff09\u7684\u67d0\u79cd\u7269\u8d28\u6e29\u5ea6\u5347\u9ad8$1^\\circ\\mathrm{C}$\u6240\u9700\u7684\u70ed\u91cf\u53eb\u505a\u8fd9\u79cd\u7269\u8d28\u7684**\u6bd4\u70ed**.\n\n\u7269\u8d28\u7684\u6bd4\u70ed\u7528\u5b57\u6bcd$c$\u6765\u8868\u793a\uff0c\u5176\u91cf\u5ea6\u5355\u4f4d\u662f$\\frac{\\text{\u7126\u8033}}{\\text{\u5343\u514b}\\cdot{}^\\circ\\mathrm{C}}$\u3001$\\frac{\\text{\u5343\u5361}}{\\text{\u5343\u514b}\\cdot{}^\\circ\\mathrm{C}}$\u6216$\\frac{\\text{\u5361}}{\\text{\u514b}\\cdot{}^\\circ\\mathrm{C}}$."
    },
    {
      "block": 5,
      "text": "\u94c5\u7684\u6bd4\u70ed\u662f$140\\frac{\\text{\u7126\u8033}}{\\text{\u5343\u514b}\\cdot{}^\\circ\\mathrm{C}}$.\n\u8fd9\u5c31\u662f\u8bf4\uff0c\u8981\u4f7f1\u5343\u514b\u7684\u94c5\u6e29\u5ea6\u5347\u9ad8$1^\\circ\\mathrm{C}$\u6240\u9700\u7684\u70ed\u91cf\u4e3a140\u7126\u8033.\n\uff08\u6216\u8005\u8bf4\u4f7f1\u5343\u514b\u94c5\u6e29\u5ea6\u964d\u4f4e$1^\\circ\\mathrm{C}$\u65f6\u6240\u653e\u51fa\u7684\u70ed\u91cf\u662f140\u7126\u8033.\uff09"
    },
    {
      "block": 6,
      "text": "**\u6bd4\u70ed\u8868\u793a\u5f531\u5343\u514b\u7269\u8d28\u7684\u6e29\u5ea6\u5347\u9ad8$1^\\circ\\mathrm{C}$\u65f6\uff0c\u5176\u5185\u80fd\u589e\u52a0\u4e86\u591a\u5c11\u7126\u8033\uff08\u6216\u5343\u5361\uff09.**"
    },
    {
      "block": 8,
      "text": "\u6211\u4eec\u53d1\u73b0\uff0c\u6c34\u7684\u6bd4\u70ed\u662f\u76f8\u5f53\u5927\u7684\uff0c\u6240\u4ee5\u6d77\u6d0b\u4e2d\u7684\u6c34\u5728\u590f\u5929\u6e29\u5ea6\u5347\u9ad8\u65f6\uff0c\u53ef\u4ee5\u5438\u6536\u5927\u91cf\u7684\u70ed.\n\u4e8e\u662f\u51e1\u4f4d\u4e8e\u5927\u578b\u6c34\u57df\u9644\u8fd1\u7684\u5730\u65b9\u5728\u590f\u5b63\u90fd\u4e0d\u8c61\u79bb\u6c34\u5f88\u8fdc\u7684\u5730\u65b9\u90a3\u6837\u708e\u70ed.\n\u800c\u5230\u4e86\u51ac\u5b63\u6c34\u7684\u6e29\u5ea6\u4e0b\u964d\uff0c\u53c8\u653e\u51fa\u4e86\u5927\u91cf\u7684\u70ed\uff0c\u6240\u4ee5\u8fd9\u4e9b\u5730\u65b9\u4e5f\u4e0d\u81f3\u5341\u5206\u5bd2\u51b7."
    }
  ],
