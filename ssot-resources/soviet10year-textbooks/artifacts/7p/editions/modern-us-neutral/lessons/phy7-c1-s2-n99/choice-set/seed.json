  "exercises": [
    {
      "number": "1",
      "text": "(1) \u600e\u6837\u7528\u7269\u8d28\u7ed3\u6784\u7684\u539f\u5b50-\u5206\u5b50\u8bba\u89e3\u91ca\u6676\u4f53\u7684\u7194\u5316\u548c\u51dd\u56fa\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "(2) \u7269\u8d28\u5728\u4ec0\u4e48\u6761\u4ef6\u4e0b\u5f00\u59cb\u7ed3\u6676\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u6676\u4f53\u4e2d\u7684\u5fae\u7c92\u6392\u5217\u5f97\u5f88\u6709\u89c4\u5219\u3002\n\u5728\u5408\u9002\u7684\u751f\u957f\u6761\u4ef6\u4e0b\uff0c\u540c\u4e00\u79cd\u7269\u8d28\u7684\u540c\u79cd\u6676\u4f53\u7ed3\u6784\u5e38\u4f1a\u5f62\u6210\u5177\u6709\u4e00\u5b9a\u89c4\u5219\u7684\u5916\u5f62\uff0c\u8fd9\u4e0e\u5185\u90e8\u5fae\u7c92\u7684\u6709\u5e8f\u6392\u5217\u6709\u5173\u3002\n\u5fae\u7c92\u867d\u7136\u6392\u5217\u5f97\u6574\u9f50\uff0c\u5374\u5e76\u6ca1\u6709\u505c\u6b62\u8fd0\u52a8\u3002\n\n\u4e0e\u7a00\u8584\u6c14\u4f53\u4e2d\u7684\u5fae\u7c92\u53ef\u4ee5\u6bd4\u8f83\u81ea\u7531\u5730\u79fb\u52a8\u4e0d\u540c\uff0c\u6676\u4f53\u4e2d\u7684\u5fae\u7c92\u901a\u5e38\u5728\u5404\u81ea\u7684\u5e73\u8861\u4f4d\u7f6e\u9644\u8fd1\u632f\u52a8\uff0c\u76f8\u90bb\u5fae\u7c92\u7684\u8fd0\u52a8\u4e5f\u4f1a\u76f8\u4e92\u5f71\u54cd\u3002"
    },
    {
      "block": 2,
      "text": "\u7269\u4f53\u7684\u6e29\u5ea6\u4e0e\u5fae\u7c92\u70ed\u8fd0\u52a8\u7684\u5e73\u5747\u52a8\u80fd\u6709\u5173\u3002\n\u5728\u6676\u4f53\u8fd8\u6ca1\u6709\u5f00\u59cb\u7194\u5316\u3001\u52a0\u70ed\u4f7f\u5b83\u5347\u6e29\u7684\u9636\u6bb5\uff0c\u5fae\u7c92\u70ed\u8fd0\u52a8\u7684\u5e73\u5747\u52a8\u80fd\u589e\u52a0\uff0c\u8fd0\u52a8\u901a\u5e38\u4e5f\u66f4\u5267\u70c8\u3002\n\u8fd9\u65f6\uff0c\u5fae\u7c92**\u632f\u52a8\u7684\u5e45\u5ea6\u901a\u5e38\u4f1a\u589e\u5927**\uff0c\u66f4\u5bb9\u6613\u6446\u8131\u539f\u6765\u4f4d\u7f6e\u7684\u7ea6\u675f\uff1b\n\n\u8fd9\u4e0d\u7b49\u4e8e\u5fae\u7c92\u95f4\u7684\u4f5c\u7528\u529b\u90fd\u7b80\u5355\u5730\u51cf\u5c0f\u4e86\u3002\n\u5bf9\u4e8e\u7eaf\u6676\u4f53\uff0c\u5728\u538b\u5f3a\u4fdd\u6301\u4e0d\u53d8\u7684\u6761\u4ef6\u4e0b\uff0c\u6e29\u5ea6\u8fbe\u5230\u7194\u70b9\u540e\u7ee7\u7eed\u5438\u70ed\uff0c**\u539f\u6709\u7684\u957f\u7a0b\u6709\u5e8f\u6392\u5217\u4f1a\u88ab\u7834\u574f**\uff0c\u5fae\u7c92\u4e0d\u518d\u53ea\u80fd\u5728\u539f\u6765\u7684\u4f4d\u7f6e\u9644\u8fd1\u632f\u52a8\u3002\n\u6676\u4f53\u4e8e\u662f\u7194\u5316\uff0c\u7531\u56fa\u6001\u53d8\u6210\u6db2\u6001\uff0c\u4e5f\u4e0d\u518d\u4fdd\u6301\u539f\u6765\u56fa\u5b9a\u7684\u5f62\u72b6\u3002\n\n\u5fae\u7c92\u4e4b\u95f4\u4ecd\u6709\u76f8\u4e92\u4f5c\u7528\uff1b\n\u5728\u7194\u5316\u8fc7\u7a0b\u4e2d\u7ee7\u7eed\u5438\u70ed\uff0c\u5e76\u4e0d\u4e00\u5b9a\u7ee7\u7eed\u5347\u6e29\u3002"
    },
    {
      "block": 3,
      "text": "**\u6db2\u4f53\u51dd\u56fa\u5f62\u6210\u6676\u4f53\u65f6\uff0c\u5fae\u7c92\u4f1a\u91cd\u65b0\u5f62\u6210\u6709\u5e8f\u6392\u5217\uff0c\u8fd9\u4e0e\u7194\u5316\u65f6\u7684\u53d8\u5316\u65b9\u5411\u76f8\u53cd\u3002\n**\u7194\u5316\u540e\u7684\u6db2\u4f53\u5728\u5f00\u59cb\u7ed3\u6676\u524d\u9010\u6e10\u51b7\u5374\uff0c\u6e29\u5ea6\u964d\u4f4e\uff0c\u5fae\u7c92\u70ed\u8fd0\u52a8\u7684\u5e73\u5747\u52a8\u80fd\u4e5f\u968f\u4e4b\u51cf\u5c0f\u3002\n\u5728\u9002\u5408\u7ed3\u6676\u7684\u6761\u4ef6\u4e0b\uff0c\u6db2\u4f53\u5411\u5468\u56f4\u653e\u51fa\u70ed\u91cf\uff0c\u5fae\u7c92\u5728\u76f8\u4e92\u4f5c\u7528\u4e0b\u91cd\u65b0\u6392\u5217\uff0c**\u5f62\u6210\u6709\u89c4\u5219\u7684\u6676\u4f53\u7ed3\u6784**\u3002\n\n\u5b83\u4eec\u5e76\u6ca1\u6709\u505c\u6b62\u8fd0\u52a8\uff0c\u800c\u662f\u5728\u5404\u81ea\u7684\u5e73\u8861\u4f4d\u7f6e\u9644\u8fd1\u632f\u52a8\u3002\n\u5bf9\u4e8e\u7eaf\u7269\u8d28\uff0c\u5728\u538b\u5f3a\u4e0d\u53d8\u3001\u6db2\u4f53\u548c\u6676\u4f53\u5171\u5b58\u7684\u51dd\u56fa\u9636\u6bb5\uff0c\u6e29\u5ea6\u901a\u5e38\u4fdd\u6301\u4e0d\u53d8\u3002\n\u56e0\u6b64\uff0c\u4e0d\u80fd\u628a\u51dd\u56fa\u8fc7\u7a0b\u8bf4\u6210\u5fae\u7c92\u7684\u5e73\u5747\u52a8\u80fd\u548c\u901f\u5ea6\u59cb\u7ec8\u4e0d\u65ad\u51cf\u5c0f\u3002"
    },
    {
      "block": 4,
      "text": "\u6db2\u4f53\u4e2d\u5982\u679c\u6709\u9002\u5408\u5e2e\u52a9\u7ed3\u6676\u7684\u5916\u6765\u5fae\u7c92\uff0c\u4f8b\u5982\u67d0\u4e9b\u5c18\u57c3\uff0c\u7ed3\u6676\u5c31\u53ef\u80fd\u66f4\u5bb9\u6613\u53d1\u751f\u3002\n\u8fd9\u4e9b\u5fae\u7c92\u53ef\u4ee5\u63d0\u4f9b\u5f62\u6210\u6676\u6838\u7684\u4f4d\u7f6e\uff0c\u6676\u6838\u5c31\u662f\u6676\u4f53\u5f00\u59cb\u751f\u957f\u7684\u5c0f\u6838\u5fc3\u3002\n\u5728\u5e38\u89c1\u7684\u6761\u4ef6\u4e0b\uff0c\u6db2\u4f53\u4e2d\u5f80\u5f80\u6709\u8bb8\u591a\u8fd9\u6837\u7684\u6210\u6838\u4f4d\u7f6e\uff0c\u5c0f\u6676\u4f53\u4fbf\u5728\u8fd9\u4e9b\u4f4d\u7f6e\u5468\u56f4\u9010\u6e10\u5f62\u6210\u3002\n\n\u8fd9\u9700\u8981\u9002\u5408\u7684\u6e29\u5ea6\u3001\u6563\u70ed\u548c\u6210\u6838\u6761\u4ef6\uff0c\u5e76\u4e0d\u662f\u4efb\u4f55\u5c18\u57c3\u5728\u4efb\u4f55\u6db2\u4f53\u4e2d\u90fd\u4e00\u5b9a\u80fd\u4f7f\u5b83\u7ed3\u6676\u3002"
    }
  ],
