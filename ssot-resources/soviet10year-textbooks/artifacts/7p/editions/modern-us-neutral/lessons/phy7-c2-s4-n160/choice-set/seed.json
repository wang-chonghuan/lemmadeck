  "exercises": [
    {
      "number": "1",
      "text": "\u600e\u6837\u901a\u8fc7\u5b9e\u9a8c\u8868\u660e\u5b58\u5728\u7740\u4f5c\u7528\u4e8e\u901a\u7535\u5bfc\u4f53\u7684\u529b\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u4f5c\u7528\u4e8e\u901a\u7535\u5bfc\u4f53\u4e0a\u7684\u529b\u7684\u65b9\u5411\u4e0e\u4ec0\u4e48\u6709\u5173\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u88c5\u5728\u7ad6\u76f4\u8f74\u4e0a\u7684\u77e9\u5f62\u6846\u67b6\u7f6e\u4e8e\u78c1\u573a\u4e2d\uff0c\u521d\u59cb\u65f6\u6846\u67b6\u5e73\u9762\u4e0e\u78c1\u529b\u7ebf\u5e73\u884c\u3002\u5f53\u5b83\u7684\u7ed5\u7ec4\u4e2d\u6709\u7535\u6d41\u901a\u8fc7\u65f6\uff0c\u5b83\u5c06\u600e\u6837\u8fd0\u52a8\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\u600e\u6837\u624d\u80fd\u4f7f\u4e0a\u4e00\u4e2a\u95ee\u9898\u4e2d\u6240\u8bf4\u7684\u6846\u67b6\u505a\u6301\u7eed\u8f6c\u52a8\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\u5229\u7528\u4ec0\u4e48\u6837\u7684\u88c5\u7f6e\u53ef\u4ee5\u81ea\u52a8\u53d8\u6362\u6846\u67b6\u7ed5\u7ec4\u4e2d\u7535\u6d41\u7684\u65b9\u5411\uff1f",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "\u6700\u7b80\u5355\u7684\u6362\u5411\u5668\u7684\u6784\u9020\u5982\u4f55\uff1f\u5b83\u662f\u600e\u6837\u5de5\u4f5c\u7684\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u6982\u62ec\u8bf4\u6765\uff0c**\u5728\u672c\u8bfe\u5b9e\u9a8c\u7684\u5e03\u7f6e\u4e2d\uff0c\u78c1\u573a\u4f1a\u5bf9\u5176\u4e2d\u7684\u901a\u7535\u5bfc\u4f53\u65bd\u529b\u3002**\n\u5bfc\u4f53\u4e0e\u78c1\u573a\u65b9\u5411\u5e73\u884c\u65f6\uff0c\u8fd9\u79cd\u78c1\u529b\u4e3a\u96f6\uff1b\n\u4e0d\u80fd\u628a\u7ed3\u8bba\u7406\u89e3\u4e3a\u4efb\u4f55\u4f4d\u7f6e\u548c\u65b9\u5411\u90fd\u4f1a\u53d7\u5230\u975e\u96f6\u78c1\u529b\u3002\n\n\u53ef\u4ee5\u901a\u8fc7\u5b9e\u9a8c\u8868\u660e\u8fd9\u79cd\u529b\u7684\u5b58\u5728\uff0c\u5b9e\u9a8c\u88c5\u7f6e\u5982\u56fe 345\uff0c*a* \u6240\u793a\u3002"
    },
    {
      "block": 4,
      "text": "\u5728\u8fd9\u5957\u88c5\u7f6e\u4e2d\uff0c\u5bfc\u4f53 $AB$ \u60ac\u5728\u4e24\u6839\u4e0e\u7535\u6e90\u76f8\u63a5\u7684\u67d4\u8f6f\u5bfc\u7ebf\u4e0a\uff0c\u5e76\u4e14\u88ab\u7f6e\u4e8e\u8e44\u5f62\u78c1\u94c1\u7684\u4e24\u4e2a\u78c1\u6781\u4e4b\u95f4\uff0c\u4e5f\u5c31\u662f\u653e\u5728\u78c1\u94c1\u7684\u78c1\u573a\u4e2d\u3002"
    },
    {
      "block": 7,
      "text": "\u5b9e\u9a8c\u8868\u660e\uff0c**\u5f53\u7535\u6d41\u7684\u65b9\u5411\u6539\u53d8\u65f6\uff0c\u5bfc\u4f53\u7684\u8fd0\u52a8\u65b9\u5411\u4e5f\u6539\u53d8**\uff0c\u8fd9\u8bf4\u660e\u4f5c\u7528\u5728\u5bfc\u4f53\u4e0a\u7684\u529b\u7684\u65b9\u5411\u4e5f\u6539\u53d8\u4e86\u3002"
    },
    {
      "block": 8,
      "text": "\u5982\u679c\u5728\u5b9e\u9a8c\u4e2d\uff08\u56fe 345\uff09\u4e0d\u6539\u53d8\u7535\u6d41\u7684\u65b9\u5411\uff0c\u800c\u662f\u8c03\u6362\u78c1\u94c1\u7684\u4e24\u4e2a\u78c1\u6781\u7684\u4f4d\u7f6e\uff0c**\u4e5f\u5c31\u662f\u6539\u53d8\u78c1\u573a\u7684\u65b9\u5411\uff0c\u90a3\u4e48\u4f5c\u7528\u5728\u5bfc\u4f53\u4e0a\u7684\u529b\u7684\u65b9\u5411\u4e5f\u53d8\u4e3a\u4e0e\u539f\u6765\u76f8\u53cd\u3002**"
    },
    {
      "block": 10,
      "text": "\u56fe 346 \u4e0a\u6240\u793a\u7684\u4eea\u5668\u53ef\u4ee5\u7528\u6765\u5b9e\u73b0\u8fd9\u79cd\u8f6c\u52a8\u3002\n\u5728\u8fd9\u4e2a\u4eea\u5668\u4e2d\uff0c$ABCD$ \u662f\u4e00\u4e2a\u88c5\u5728\u7ad6\u76f4\u8f74\u4e0a\u7684\u77e9\u5f62\u8f7b\u6846\u67b6\u3002\n\u6846\u67b6\u4e0a\u914d\u6709\u7531\u51e0\u5341\u531d\u5305\u7740\u7edd\u7f18\u5c42\u7684\u5bfc\u7ebf\u7ec4\u6210\u7684\u7ed5\u7ec4\u3002\n\n\u7ed5\u7ec4\u7684\u7ebf\u7aef\u63a5\u5230\u91d1\u5c5e\u73af 1 \u4e0a\u3002\n\u4e00\u4e2a\u7ebf\u7aef\u63a5\u5230\u5176\u4e2d\u4e00\u4e2a\u73af\u4e0a\uff0c\u53e6\u4e00\u4e2a\u7ebf\u7aef\u63a5\u5230\u53e6\u4e00\u4e2a\u73af\u4e0a\u3002\n\u8fd9\u4e24\u4e2a\u73af\u4e5f\u88c5\u5728\u5e26\u7ed5\u7ec4\u7684\u6846\u67b6\u7684\u8f74\u4e0a\u3002\n\n\u5c31\u662f\u501f\u52a9\u4e8e\u73af\u548c\u5c0f\u91d1\u5c5e\u7247\u2014\u2014\u7535\u5237 2\uff0c\u628a\u6846\u67b6\u4e0a\u7684\u7ed5\u7ec4\u63a5\u5165\u7535\u6e90\u7535\u8def\u4e2d\u3002\n\u6846\u67b6\u653e\u5728\u78c1\u94c1\u7684\u4e24\u4e2a\u78c1\u6781 $\\mathrm{N}$ \u548c $\\mathrm{S}$ \u4e4b\u95f4\uff0c\u4e5f\u5c31\u662f\u88ab\u653e\u5728\u78c1\u573a\u4e2d\u3002"
    },
    {
      "block": 13,
      "text": "\u5728\u56fe 346 \u4e0a\uff0c\u6846\u67b6 $ABCD$ \u7684\u5e73\u9762\u5904\u4e8e\u4e0e\u78c1\u94c1\u78c1\u573a\u7684\u78c1\u529b\u7ebf\u5e73\u884c\u7684\u4f4d\u7f6e\u3002\n\u5f53\u7535\u8def\u95ed\u5408\u65f6\uff0c\u6846\u67b6\u5c06\u4f7f\u5176\u7ed5\u7ec4\u5e73\u9762\u4e0e\u78c1\u529b\u7ebf\u76f8\u5782\u76f4\u3002\n\u6846\u67b6\u7684\u8fd9\u4e00\u4e2a\u4f4d\u7f6e\u53eb\u505a**\u5e73\u8861\u4f4d\u7f6e**\uff08\u5728\u56fe 346 \u4e0a\u7528\u865a\u7ebf\u8868\u793a\uff09\u3002"
    },
    {
      "block": 14,
      "text": "\u6846\u67b6\u56e0\u60ef\u6027\u901a\u8fc7\u5e73\u8861\u4f4d\u7f6e\u540e\uff0c\u9002\u65f6\u6539\u53d8\u7ed5\u7ec4\u4e2d\u7535\u6d41\u7684\u65b9\u5411\uff0c\u53ef\u4ee5\u4f7f\u5b83\u7ee7\u7eed\u6cbf\u539f\u65b9\u5411\u8f6c\u8fc7 $180^\\circ$\uff0c\u5e76\u8d8a\u8fc7\u4e0b\u4e00\u4e2a\u5e73\u8861\u4f4d\u7f6e\u3002\n\u4e3a\u4e86\u4f7f\u6846\u67b6\u518d\u4e00\u6b21\u65cb\u8f6c $180^\\circ$\uff0c\u5e94\u5f53\u5728\u5b83\u7531\u4e8e\u60ef\u6027\u800c\u5df2\u7ecf\u901a\u8fc7\u5e73\u8861\u4f4d\u7f6e\u65f6\u6539\u53d8\u7ed5\u7ec4\u4e2d\u7535\u6d41\u7684\u65b9\u5411\u3002\n\n\u8fd9\u5c31\u662f\u8bf4\uff0c\u5982\u679c\u80fd\u5728\u5fc5\u8981\u7684\u65f6\u523b\uff08\u6846\u67b6\u6bcf\u8f6c\u8fc7 $180^\\circ$ \u4e4b\u540e\uff09\u6539\u53d8\u7ed5\u7ec4\u4e2d\u7535\u6d41\u7684\u65b9\u5411\uff0c\u90a3\u4e48\u53ea\u8981\u7ed5\u7ec4\u4e2d\u4fdd\u6301\u6709\u7535\u6d41\u901a\u8fc7\uff0c\u6846\u67b6\u5c31\u80fd\u5728\u78c1\u573a\u4e2d\u7ee7\u7eed\u8f6c\u52a8\u3002"
    },
    {
      "block": 16,
      "text": "\u6700\u7b80\u5355\u7684\u6362\u5411\u5668\u7531\u4e24\u4e2a\u5f7c\u6b64\u7edd\u7f18\u7684\u534a\u73af\u7ec4\u6210\u3002\n\u5b83\u4eec\u548c\u6846\u67b6\u88c5\u5728\u540c\u4e00\u4e2a\u8f74\u4e0a\uff0c\u56e0\u6b64\u603b\u662f\u548c\u6846\u67b6\u4e00\u8d77\u65cb\u8f6c\u3002\n\u6846\u67b6\u7ed5\u7ec4\u7684\u4e24\u4e2a\u7ebf\u7aef\u5c31\u5206\u522b\u8fde\u5728\u8fd9\u4e24\u4e2a\u534a\u73af\u4e0a\u3002\n\n\u901a\u8fc7\u534a\u73af\u5e76\u501f\u52a9\u4e8e\u7535\u5237\u5c06\u7ed5\u7ec4\u63a5\u5165\u7535\u6e90\u7535\u8def\u3002\n\u88c5\u6709\u8fd9\u79cd\u6362\u5411\u5668\u7684\u6846\u67b6\u5982\u56fe 347 \u6240\u793a\u3002"
    }
  ],
