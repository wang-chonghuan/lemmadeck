  "exercises": [
    {
      "number": "1",
      "text": "(1) \u5728\u7528\u7535\u5668\u7684\u8bf4\u660e\u4e66\u4e2d\u901a\u5e38\u90fd\u8981\u6807\u660e\u54ea\u4e00\u4e2a\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5728\u529f\u7387\u4e0d\u53d8\uff0c\u6216\u5df2\u77e5\u8fd9\u6bb5\u65f6\u95f4\u5185\u5e73\u5747\u529f\u7387\u7684\u60c5\u51b5\u4e0b\uff0c\u600e\u6837\u7528\u7535\u529f\u7387\u53ca\u65f6\u95f4\u8868\u793a\u7535\u529f\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "(3) \u5728\u5b9e\u8df5\u4e2d\u7ecf\u5e38\u4f7f\u7528\u54ea\u4e9b\u7535\u529f\u7684\u5355\u4f4d\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u4e00\u53ea\u7535\u71a8\u6597\u8fd0\u884c\u65f6\u7684\u529f\u7387\u662f 0.6 \u5343\u74e6\u3002\n\u5047\u8bbe\u5b83\u5728\u6240\u7ed9\u65f6\u95f4\u5185\u6301\u7eed\u4ee5\u8fd9\u4e00\u529f\u7387\u8fd0\u884c\uff0c\u7b97\u4e00\u7b97\u5b83\u5728 1.5 \u5c0f\u65f6\u5185\u6d88\u8017\u591a\u5c11\u80fd\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u4e00\u6240\u4f4f\u5b85\u4e2d\uff0c60 \u74e6\u7279\u548c 40 \u74e6\u7279\u7684\u7535\u706f\u5404\u6709\u4e24\u76cf\u3002\n\u6bcf\u76cf\u706f\u6bcf\u5929\u5927\u7ea6\u70b9\u4eae 3 \u5c0f\u65f6\uff0c\u70b9\u4eae\u65f6\u4ee5\u9898\u7ed9\u529f\u7387\u8fd0\u884c\u3002\n\u5047\u8bbe\u6bcf\u6d88\u8017 1 \u5343\u74e6\u5c0f\u65f6\u7535\u80fd\u6536\u8d39 4 \u7f8e\u5206\uff0c\u8fd9\u53ea\u662f\u9898\u8bbe\u4ef7\u683c\uff0c\u4e0d\u662f\u5b9e\u9645\u7535\u4ef7\uff1b\u53ea\u8ba1\u7b97\u8fd9\u4e9b\u7535\u706f\u7684\u7535\u80fd\u8d39\u7528\uff0c\u4e0d\u8ba1\u56fa\u5b9a\u8d39\u7528\u3002\n\u4e00\u4e2a\u6708\uff0830 \u5929\uff09\u7684\u7535\u8d39\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "q1",
      "text": "\u5728\u6210\u4eba\u5e2e\u52a9\u4e0b\uff0c\u67e5\u6e05\u5bb6\u4e2d\u5404\u79cd\u7528\u7535\u5668\u7684\u7535\u529f\u7387\uff0c\u8bb0\u5f55\u5b83\u4eec\u5728\u540c\u4e00\u5468\u5185\u7684\u5927\u7ea6\u4f7f\u7528\u65f6\u95f4\u3002\n\u6839\u636e\u8fd9\u4e9b\u4fe1\u606f\u548c\u5bb6\u4e2d\u7684\u5b9e\u9645\u8ba1\u4ef7\u65b9\u5f0f\uff0c\u4f30\u7b97\u8fd9\u4e9b\u7535\u5668\u5728\u8fd9\u4e00\u5468\u5185\u6d88\u8017\u7684\u7535\u80fd\u8d39\u7528\uff0c\u5e76\u4e0e\u540c\u4e00\u5468\u7535\u5ea6\u8868\u8bfb\u6570\u5bf9\u5e94\u7684\u7535\u80fd\u8d39\u7528\u6bd4\u8f83\u3002\n\u82e5\u7535\u5668\u4f1a\u81ea\u52a8\u505c\u6b62\u52a0\u70ed\u3001\u6539\u53d8\u529f\u7387\u6216\u8fdb\u5165\u5f85\u673a\uff0c\u8981\u8bf4\u660e\u4f30\u7b97\u91c7\u7528\u4e86\u4ec0\u4e48\u8fd0\u884c\u529f\u7387\u548c\u65f6\u95f4\uff1b\u6bd4\u8f83\u65f6\u5c06\u56fa\u5b9a\u8d39\u7528\u4e0e\u7535\u80fd\u8d39\u7528\u533a\u5206\u5f00\u3002\n\u53ea\u67e5\u770b\u80fd\u591f\u5b89\u5168\u8bfb\u5230\u7684\u8bf4\u660e\u4e66\u3001\u94ed\u724c\u548c\u8868\u8bfb\u6570\uff0c\u4e0d\u62c6\u5378\u7535\u5668\u6216\u63a5\u89e6\u7535\u7ebf\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u7535\u706f\u3001\u7535\u7089\u3001\u7535\u52a8\u673a\u7b49\u7528\u7535\u5668\u7684\u8bf4\u660e\u4e66\u6216\u94ed\u724c\u4e0a\uff0c\u901a\u5e38\u6807\u6709\u989d\u5b9a\u7535\u529f\u7387\u3002\n\u989d\u5b9a\u529f\u7387\u5bf9\u5e94\u89c4\u5b9a\u7684\u5de5\u4f5c\u6761\u4ef6\uff0c\u4e0d\u8868\u793a\u673a\u5668\u5728\u4efb\u4f55\u65f6\u5019\u90fd\u4ee5\u8fd9\u4e2a\u529f\u7387\u8fd0\u884c\u3002\n\u8fd9\u91cc\u7684 A \u8868\u793a\u7535\u529f\uff0c\u4e5f\u5c31\u662f\u7528\u7535\u5668\u6d88\u8017\u7684\u7535\u80fd\uff1b\n\nP \u8868\u793a\u7535\u529f\u7387\u3002\n\u7531\u516c\u5f0f $P=\\frac{A}{t}$\uff0c\u53ef\u4ee5\u8ba1\u7b97\u4e00\u6bb5\u65f6\u95f4 $t$ \u5185\u7684\u7535\u529f\u3002\n\u672c\u8bfe\u7684\u8ba1\u7b97\u91c7\u7528\u529f\u7387\u4e0d\u53d8\u7684\u60c5\u51b5\uff1b\n\n\u5982\u679c\u529f\u7387\u53d8\u5316\uff0c\u4e5f\u53ef\u4ee5\u4f7f\u7528\u8fd9\u4e00\u6574\u6bb5\u65f6\u95f4\u7684\u5e73\u5747\u529f\u7387\u3002\n\u628a\u516c\u5f0f\u6539\u5199\uff0c\u5c31\u5f97\u5230\uff1a"
    },
    {
      "block": 1,
      "text": "$A=Pt$\u3002\n\u7535\u529f\u7b49\u4e8e\u7535\u529f\u7387\u4e0e\u4f7f\u7528\u65f6\u95f4\u7684\u4e58\u79ef\uff0c\u8ba1\u7b97\u65f6\u8981\u8ba9\u5355\u4f4d\u76f8\u4e92\u914d\u5408\u3002"
    },
    {
      "block": 2,
      "text": "\u5982\u679c\u7535\u529f\u7387\u7528\u74e6\u7279\u8868\u793a\uff0c\u65f6\u95f4\u7528\u79d2\u8868\u793a\uff0c\u7b97\u51fa\u7684\u7535\u529f\u5c31\u7528\u7126\u8033\u8868\u793a\u3002\n\u8fd9\u4e9b\u5355\u4f4d\u7684\u5173\u7cfb\u662f\uff1a"
    },
    {
      "block": 3,
      "text": "**$1$ \u74e6\u7279$=\\frac{1\\text{ \u7126\u8033}}{1\\text{ \u79d2}}$\uff0c\u6240\u4ee5 $1$ \u7126\u8033$=1$ \u74e6\u7279$\\times1$ \u79d2**\u3002"
    },
    {
      "block": 4,
      "text": "\u7528\u7535\u5668\u4f7f\u7528\u8f83\u957f\u65f6\u95f4\u65f6\uff0c\u7535\u80fd\u7528\u74e6\u7279\u5c0f\u65f6\u6216\u5343\u74e6\u5c0f\u65f6\u8868\u793a\uff0c\u8ba1\u7b97\u548c\u8bb0\u5f55\u5e38\u5e38\u66f4\u65b9\u4fbf\u3002\n\u5343\u74e6\u5c0f\u65f6\u662f\u80fd\u91cf\u7684\u5355\u4f4d\uff0c\u4e0d\u662f\u529f\u7387\u7684\u5355\u4f4d\u3002\n\u4e0b\u9762\u4fdd\u7559\u539f\u4e66\u4ecb\u7ecd\u7684\u4e09\u79cd\u5355\u4f4d\u53ca\u5176\u6362\u7b97\uff0c\u5176\u4e2d\u767e\u74e6\u5c0f\u65f6\u4e5f\u4f5c\u4e3a\u539f\u4e66\u7684\u5355\u4f4d\u4f8b\u5b50\u4fdd\u7559\uff1a"
    },
    {
      "block": 5,
      "text": "**$1$ \u74e6\u7279\u5c0f\u65f6$=3600$ \u7126\u8033**\uff1b\n**$1$ \u767e\u74e6\u5c0f\u65f6$=100$ \u74e6\u7279$\\times1$ \u5c0f\u65f6$=360000$ \u7126\u8033**\uff1b\n**$1$ \u5343\u74e6\u5c0f\u65f6$=1000$ \u74e6\u7279$\\times1$ \u5c0f\u65f6$=3600000$ \u7126\u8033**\u3002"
    },
    {
      "block": 6,
      "text": "\u5982\u679c\u7535\u706f\u5728\u89c4\u5b9a\u7684\u5de5\u4f5c\u6761\u4ef6\u4e0b\uff0c\u4ee5\u989d\u5b9a\u529f\u7387\u6301\u7eed\u70b9\u4eae\uff0c\u77e5\u9053\u5b83\u7684\u989d\u5b9a\u529f\u7387\u548c\u70b9\u4eae\u65f6\u95f4\uff0c\u5c31\u80fd\u8ba1\u7b97\u6d88\u8017\u7684\u7535\u80fd\u3002\n\u5982\u679c\u5de5\u4f5c\u529f\u7387\u6216\u5f00\u5173\u72b6\u6001\u4f1a\u53d8\u5316\uff0c\u5c31\u9700\u8981\u5206\u522b\u8003\u8651\u5404\u6bb5\u65f6\u95f4\uff0c\u4e0d\u80fd\u628a\u94ed\u724c\u529f\u7387\u4e58\u4e0a\u5305\u62ec\u5173\u673a\u65f6\u95f4\u5728\u5185\u7684\u5168\u90e8\u65f6\u95f4\u3002"
    }
  ],
