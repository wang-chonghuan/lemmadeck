  "concepts": [
    {
      "block": 5,
      "text": "**\u70ed\u673a\u662f\u4e00\u79cd\u80fd\u628a\u71c3\u6599\u7684\u5185\u80fd\u8f6c\u6362\u4e3a\u673a\u68b0\u80fd\u7684\u673a\u5668.**"
    },
    {
      "block": 6,
      "text": "\u70ed\u673a\u6709\u5f88\u591a\u79cd\uff0c\u5982**\u84b8\u6c7d\u673a\u3001\u5185\u71c3\u673a\u3001\u6c7d\u8f6e\u673a\u548c\u71c3\u6c14\u8f6e\u673a\u3001\u706b\u7bad\u53d1\u52a8\u673a\u7b49.**"
    },
    {
      "block": 7,
      "text": "\u6240\u6709\u8fd9\u4e9b\u70ed\u673a\u90fd\u662f\u5148\u628a\u71c3\u6599\u7684\u80fd\u91cf\u8f6c\u6362\u4e3a\u71c3\u6c14\uff08\u6216\u84b8\u6c7d\uff09\u7684\u80fd\u91cf.\n\u6ca1\u6709\u8fd9\u4e9b\u6c14\u4f53\u70ed\u673a\u662f\u4e0d\u80fd\u5de5\u4f5c\u7684\uff0c\u6c14\u673a\u81a8\u80c0\u800c\u505a\u529f\uff0c\u505a\u529f\u540e\u6c14\u4f53\u7684\u6e29\u5ea6\u4e0b\u964d\uff0c\u5176\u5185\u80fd\u8f6c\u6362\u6210\u4e86\u673a\u68b0\u80fd."
    }
