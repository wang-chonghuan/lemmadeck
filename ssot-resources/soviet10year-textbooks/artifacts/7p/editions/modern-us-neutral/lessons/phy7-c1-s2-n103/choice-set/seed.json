  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u540c\u4e00\u79cd\u6db2\u4f53\u7684\u6e29\u5ea6\u4e0e\u5206\u5b50\u70ed\u8fd0\u52a8\u7684\u5feb\u6162\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4ec0\u4e48\u73b0\u8c61\u53eb\u505a\u84b8\u53d1\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u6db2\u4f53\u5728\u4f4e\u4e8e\u6cb8\u70b9\u7684\u6e29\u5ea6\u4e0b\u4e5f\u80fd\u84b8\u53d1\uff0c\u600e\u6837\u4ece\u5206\u5b50\u8fd0\u52a8\u89e3\u91ca\u8fd9\u4e00\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u84b8\u6c14\u53d8\u6210\u6db2\u4f53\u7684\u8fc7\u7a0b\u53eb\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u5217\u4e3e\u5f71\u54cd\u6db2\u4f53\u84b8\u53d1\u5feb\u6162\u7684\u56e0\u7d20\uff0c\u5e76\u89e3\u91ca\u5b83\u4eec\u4e3a\u4ec0\u4e48\u4f1a\u4ea7\u751f\u5f71\u54cd\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u4ee5\u6c34\u8fd9\u6837\u7684\u5206\u5b50\u7269\u8d28\u4e3a\u4f8b\uff0c\u6e29\u5ea6\u4e0e\u5206\u5b50\u7684\u70ed\u8fd0\u52a8\u6709\u5173\u3002\n\u5bf9\u4e8e\u540c\u4e00\u79cd\u6db2\u4f53\uff0c\u6e29\u5ea6\u8d8a\u9ad8\uff0c\u5206\u5b50\u70ed\u8fd0\u52a8\u7684\u5e73\u5747\u52a8\u80fd\u901a\u5e38\u8d8a\u5927\uff1b\n\u52a8\u80fd\u5c31\u662f\u7269\u4f53\u7531\u4e8e\u8fd0\u52a8\u800c\u5177\u6709\u7684\u80fd\u91cf\u3002\n\n\u4e0d\u8fc7\uff0c\u5206\u5b50\u5e76\u4e0d\u662f\u90fd\u4ee5\u540c\u6837\u7684\u901f\u5ea6\u8fd0\u52a8\uff0c\u6709\u7684\u5feb\uff0c\u6709\u7684\u6162\u3002\n\u6db2\u9762\u4e0a\u7684\u67d0\u4e2a\u5206\u5b50\u5982\u679c\u6709\u8db3\u591f\u7684\u80fd\u91cf\uff0c\u5c31\u53ef\u80fd\u514b\u670d\u9644\u8fd1\u5206\u5b50\u7684\u5438\u5f15\uff0c\u79bb\u5f00\u6db2\u4f53\u3002\n\u8fd9\u4e9b\u5206\u5b50\u5728\u6db2\u9762\u4e0a\u65b9\u5f62\u6210\u8fd9\u79cd\u7269\u8d28\u7684\u84b8\u6c14\uff0c\u4e5f\u5c31\u662f\u5b83\u7684\u6c14\u6001\u3002\n\n**\u5206\u5b50\u4ece\u6db2\u4f53\u8868\u9762\u8fdb\u5165\u6c14\u6001\u7684\u73b0\u8c61\u53eb\u505a\u84b8\u53d1**\u3002"
    },
    {
      "block": 2,
      "text": "1. \u539f\u4e66\u4e3e\u4e86\u4e00\u4e2a\u89c2\u5bdf\u4f8b\u5b50\uff1a\u540c\u4e00\u5c0f\u5757\u7eb8\u4e0a\uff0c\u6cbe\u6709\u4e59\u919a\u7684\u90e8\u4f4d\u6bd4\u6cbe\u6709\u6c34\u7684\u90e8\u4f4d\u5e72\u5f97\u5feb\u3002\n\u4e59\u919a\u6613\u71c3\uff0c\u4e0d\u80fd\u7531\u513f\u7ae5\u53d6\u7528\uff0c\u4e5f\u4e0d\u80fd\u6d82\u5728\u76ae\u80a4\u4e0a\uff1b\n\u8fd9\u91cc\u4fdd\u7559\u7684\u662f\u89c2\u5bdf\u7ed3\u679c\uff0c\u4e0d\u662f\u52a8\u624b\u5b9e\u9a8c\u3002\n\n**\u84b8\u53d1\u7684\u5feb\u6162\u4e0e\u6db2\u4f53\u7684\u79cd\u7c7b\u6709\u5173**\u3002\n\u5728\u6e29\u5ea6\u7b49\u6761\u4ef6\u76f8\u540c\u65f6\uff0c\u5206\u5b50\u8d8a\u5bb9\u6613\u514b\u670d\u5f7c\u6b64\u7684\u5438\u5f15\u3001\u79bb\u5f00\u6db2\u9762\uff0c\u6db2\u4f53\u901a\u5e38\u5c31\u84b8\u53d1\u5f97\u8d8a\u5feb\u3002"
    },
    {
      "block": 3,
      "text": "2. \u6db2\u4f53\u4e2d\u603b\u6709\u4e00\u4e9b\u5206\u5b50\u8fd0\u52a8\u5f97\u6bd4\u8f83\u5feb\uff0c\u8868\u9762\u4e0a\u7684\u90e8\u5206\u5206\u5b50\u80fd\u591f\u79bb\u5f00\u6db2\u4f53\u3002\n**\u53ea\u8981\u7269\u8d28\u4ecd\u662f\u6db2\u4f53\uff0c\u4f4e\u4e8e\u6cb8\u70b9\u65f6\u4e5f\u53ef\u4ee5\u53d1\u751f\u84b8\u53d1**\uff1b\n\u84b8\u53d1\u53d1\u751f\u5728\u6db2\u9762\uff0c\u4e0d\u9700\u8981\u7b49\u5230\u6db2\u4f53\u6cb8\u817e\u3002\n\n\u96e8\u540e\u7684\u6c34\u6d3c\u5728\u708e\u70ed\u7684\u590f\u5b63\u548c\u8f83\u51b7\u7684\u79cb\u5b63\u90fd\u80fd\u6162\u6162\u53d8\u5e72\u3002\n\u5176\u4ed6\u6761\u4ef6\u76f8\u8fd1\u65f6\uff0c\u590f\u5b63\u901a\u5e38\u5e72\u5f97\u66f4\u5feb\u3002\n\u6e29\u5ea6\u8f83\u9ad8\u65f6\uff0c\u540c\u4e00\u79cd\u6db2\u4f53\u4e2d\u901a\u5e38\u6709\u66f4\u591a\u8868\u9762\u5206\u5b50\u80fd\u591f\u514b\u670d\u5468\u56f4\u5206\u5b50\u7684\u5438\u5f15\u800c\u79bb\u5f00\u6db2\u4f53\u3002\n\n**\u5176\u4ed6\u6761\u4ef6\u76f8\u540c\u65f6\uff0c\u6db2\u4f53\u6e29\u5ea6\u8d8a\u9ad8\uff0c\u84b8\u53d1\u901a\u5e38\u8d8a\u5feb**\u3002"
    },
    {
      "block": 4,
      "text": "3. \u6db2\u4f53\u84b8\u53d1\u65f6\uff0c\u6db2\u9762\u4e0a\u65b9\u7684\u84b8\u6c14\u5206\u5b50\u4ecd\u5728\u4e0d\u505c\u5730\u505a\u65e0\u89c4\u5219\u8fd0\u52a8\u3002\n\u5b83\u4eec\u6709\u7684\u8fdc\u79bb\u6db2\u9762\uff0c\u6709\u7684\u53c8\u56de\u5230\u6db2\u4f53\u4e2d\u3002\n**\u5206\u5b50\u4ece\u84b8\u6c14\u8fdb\u5165\u6db2\u4f53\u7684\u73b0\u8c61\u53eb\u505a\u51dd\u7ed3**\u3002\n\n\u84b8\u53d1\u548c\u51dd\u7ed3\u53ef\u4ee5\u540c\u65f6\u8fdb\u884c\u3002"
    },
    {
      "block": 7,
      "text": "\u5f00\u53e3\u5bb9\u5668\u4e2d\u7684\u6db2\u4f53\u5e38\u4f1a\u9010\u6e10\u51cf\u5c11\uff0c\u56e0\u4e3a\u5468\u56f4\u7a7a\u6c14\u4e2d\u7684\u8fd9\u7c7b\u84b8\u6c14\u8fd8\u4e0d\u591f\u591a\uff0c\u79bb\u5f00\u6db2\u4f53\u7684\u5206\u5b50\u591a\u4e8e\u8fd4\u56de\u7684\u5206\u5b50\u3002\n\u6db2\u4f53\u7684\u51c0\u51cf\u5c11\uff0c\u8981\u770b\u84b8\u53d1\u548c\u51dd\u7ed3\u4e24\u4e2a\u8fc7\u7a0b\u76f8\u51cf\u540e\u7684\u7ed3\u679c\uff0c\u4e0d\u80fd\u53ea\u770b\u84b8\u53d1\u3002\n\u5982\u679c\u6db2\u4f53\u6e29\u5ea6\u7b49\u5176\u4ed6\u6761\u4ef6\u76f8\u8fd1\uff0c**\u6709\u98ce\u65f6**\uff0c\u6db2\u9762\u9644\u8fd1\u7684\u84b8\u6c14\u66f4\u5bb9\u6613\u88ab\u5e26\u8d70\uff0c\u8fd4\u56de\u6db2\u4f53\u7684\u5206\u5b50\u51cf\u5c11\uff0c**\u6db2\u4f53\u901a\u5e38\u5c31\u5e72\u5f97\u66f4\u5feb**\u3002\n\n\u7a7a\u6c14\u4e2d\u8fd9\u7c7b\u84b8\u6c14\u5df2\u7ecf\u8db3\u591f\u591a\u65f6\uff0c\u6db2\u4f53\u4e5f\u53ef\u80fd\u4e0d\u518d\u51c0\u51cf\u5c11\uff0c\u751a\u81f3\u51fa\u73b0\u51c0\u51dd\u7ed3\u3002"
    },
    {
      "block": 9,
      "text": "4. \u540c\u6837\u591a\u7684\u6c34\uff0c\u653e\u5728\u5f00\u53e3\u8f83\u5bbd\u7684\u5bb9\u5668\u91cc\uff0c\u901a\u5e38\u6bd4\u653e\u5728\u5f00\u53e3\u8f83\u7a84\u7684\u5bb9\u5668\u91cc\u5e72\u5f97\u5feb\uff1b\n\u6bd4\u8f83\u65f6\uff0c\u6c34\u6e29\u548c\u7a7a\u6c14\u6d41\u52a8\u7b49\u6761\u4ef6\u5e94\u76f8\u8fd1\u3002\n\u76d8\u5b50\u4e2d\u7684\u6c34\u6bd4\u676f\u5b50\u4e2d\u7684\u6c34\u63a5\u89e6\u7a7a\u6c14\u7684\u8868\u9762\u5927\uff0c\u5c55\u5f00\u60ac\u6302\u7684\u6e7f\u5e8a\u5355\u4e5f\u6bd4\u63c9\u6210\u4e00\u56e2\u7684\u6e7f\u5e8a\u5355\u5bb9\u6613\u667e\u5e72\u3002\n\n**\u6db2\u4f53\u84b8\u53d1\u7684\u5feb\u6162\u8fd8\u4e0e\u6db2\u9762\u7684\u9762\u79ef\u6709\u5173**\u3002\n\u5728\u5176\u4ed6\u6761\u4ef6\u76f8\u540c\u65f6\uff0c\u6db2\u9762\u9762\u79ef\u8d8a\u5927\uff0c\u540c\u4e00\u6bb5\u65f6\u95f4\u91cc\u80fd\u591f\u79bb\u5f00\u6db2\u4f53\u7684\u8868\u9762\u5206\u5b50\u901a\u5e38\u8d8a\u591a\u3002"
    },
    {
      "block": 10,
      "text": "\u539f\u4e66\u8fd8\u63d0\u5230\uff0c\u51b0\u7b49\u56fa\u4f53\u4e5f\u80fd\u76f4\u63a5\u53d8\u6210\u6c14\u4f53\u3002\n\u6309\u73b0\u4ee3\u7269\u7406\u672f\u8bed\uff0c**\u56fa\u4f53\u4e0d\u7ecf\u8fc7\u6db2\u6001\u800c\u76f4\u63a5\u53d8\u6210\u6c14\u6001\uff0c\u53eb\u505a\u5347\u534e**\uff0c\u4e0d\u53eb\u6db2\u4f53\u7684\u84b8\u53d1\u3002\n\u4e25\u51ac\u91cc\uff0c\u5e8a\u5355\u4e2d\u7684\u6c34\u7ed3\u6210\u51b0\u540e\uff0c\u51b0\u4e5f\u53ef\u4ee5\u901a\u8fc7\u5347\u534e\u9010\u6e10\u51cf\u5c11\uff0c\u5e8a\u5355\u4fbf\u4ecd\u53ef\u80fd\u667e\u5e72\u3002\n\n\u95fb\u5230\u56fa\u4f53\u7684\u6c14\u5473\uff0c\u53ef\u80fd\u4e0e\u5176\u4e2d\u80fd\u6325\u53d1\u7684\u7269\u8d28\u8fdb\u5165\u7a7a\u6c14\u6709\u5173\uff0c\u5e76\u4e0d\u8bf4\u660e\u6240\u6709\u56fa\u4f53\u90fd\u4f1a\u660e\u663e\u5347\u534e\u3002"
    }
  ],
