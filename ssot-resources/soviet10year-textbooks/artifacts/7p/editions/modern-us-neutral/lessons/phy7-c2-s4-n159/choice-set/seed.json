  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u4ec0\u4e48\u662f\u53d7\u8bdd\u5668\u548c\u9001\u8bdd\u5668\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u9001\u8bdd\u5668\u7684\u6784\u9020\u5982\u4f55\uff1f\u5b83\u662f\u600e\u6837\u5de5\u4f5c\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u53d7\u8bdd\u5668\u7684\u6784\u9020\u5982\u4f55\uff1f\u5b83\u662f\u600e\u6837\u5de5\u4f5c\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u7528\u7535\u8bdd\u8c08\u8bdd\u662f\u600e\u6837\u8fdb\u884c\u7684\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u672c\u8bfe\u8ba8\u8bba\u65e9\u671f\u6709\u7ebf\u7535\u8bdd\u7684\u5de5\u4f5c\u539f\u7406\u3002\n\u7535\u8bdd\u7b52\u7684\u4e00\u7aef\u88c5\u7740\u8d34\u8fd1\u8033\u6735\u6536\u542c\u7684**\u53d7\u8bdd\u5668**$\\textcircled{1}$\uff0c\u53e6\u4e00\u7aef\u88c5\u7740\u9760\u8fd1\u5634\u90e8\u8bb2\u8bdd\u7684**\u9001\u8bdd\u5668**$\\textcircled{2}$\u3002\n\u5728\u672c\u8bfe\u7684\u7b80\u5316\u7535\u8def\u4e2d\uff0c\u7535\u8bdd\u7ebf\u628a\u4e00\u7aef\u9001\u8bdd\u5668\u5f15\u8d77\u7684\u7535\u6d41\u53d8\u5316\u4f20\u5230\u53e6\u4e00\u7aef\u7684\u53d7\u8bdd\u5668\uff0c\u5bf9\u65b9\u4f7f\u7528\u76f8\u540c\u4f5c\u7528\u7684\u88c5\u7f6e\u901a\u8bdd\u3002"
    },
    {
      "block": 1,
      "text": "\u56fe342\u6240\u793a\u7684\u662f\u78b3\u7c92\u9001\u8bdd\u5668\u7684\u6784\u9020\u793a\u610f\u56fe\u3002\n\u539f\u4e66\u8fd9\u5957\u88c5\u7f6e\u7684\u4e3b\u8981\u96f6\u4ef6\u662f\u632f\u819c6\uff08\u94a2\u6216\u7ecf\u8fc7\u538b\u5236\u7684\u78b3\u8584\u7247\uff09\uff0c\u4ee5\u53ca\u88c5\u5728\u78b3\u97742\u51f9\u69fd\u4e2d\u7684\u78b3\u7c895\u3002\n\u78b3\u9774\u88c5\u5728\u5916\u58f31\u4e0a\uff0c\u7528\u886c\u57ab4\u4e0e\u5916\u58f3\u7edd\u7f18\uff1b\n\n\u56fa\u5b9a\u7535\u67813\u88c5\u5728\u5916\u58f3\u5e95\u90e8\uff0c\u4e5f\u4e0e\u5916\u58f3\u7edd\u7f18\u3002"
    },
    {
      "block": 2,
      "text": "$\\textcircled{1}$ **\u53d7\u8bdd\u5668**\u628a\u4f20\u6765\u7684\u7535\u6d41\u53d8\u5316\u8f6c\u6362\u4e3a\u632f\u819c\u548c\u7a7a\u6c14\u7684\u632f\u52a8\uff0c\u4f7f\u4eba\u542c\u5230\u58f0\u97f3\u3002"
    },
    {
      "block": 3,
      "text": "$\\textcircled{2}$ **\u9001\u8bdd\u5668**\u53c8\u53eb\u5fae\u97f3\u5668\uff0c\u628a\u58f0\u97f3\u5f15\u8d77\u7684\u632f\u52a8\u8f6c\u6362\u4e3a\u7535\u4fe1\u53f7\u7684\u53d8\u5316\u3002"
    },
    {
      "block": 8,
      "text": "\u5728\u6709\u7535\u6e90\u4f9b\u7535\u7684\u7b80\u5316\u7535\u8def\u4e2d\uff0c\u7535\u6d41\u7ecf\u8fc7\u632f\u819c\u3001\u78b3\u9774\u3001\u78b3\u7c89\u548c\u7535\u67813\u3002\n\u78b3\u7c92\u9001\u8bdd\u5668\u901a\u8fc7\u7535\u963b\u53d8\u5316\u8c03\u5236\u7535\u6e90\u63d0\u4f9b\u7684\u7535\u6d41\uff0c\u5e76\u4e0d\u662f\u7531\u58f0\u97f3\u76f4\u63a5\u63d0\u4f9b\u8fd9\u80a1\u7535\u6d41\u7684\u80fd\u91cf\u3002"
    },
    {
      "block": 10,
      "text": "\u5f53\u6211\u4eec\u8bf4\u8bdd\u6216\u5531\u6b4c\u65f6\uff0c\u58f0\u5e26\u632f\u52a8\uff0c\u5f15\u8d77\u5468\u56f4\u7a7a\u6c14\u7684\u632f\u52a8\u3002\n\u58f0\u6ce2\u4f20\u64ad\u5230\u8033\u6735\u5e76\u88ab\u542c\u89c9\u7cfb\u7edf\u611f\u77e5\uff0c\u5c31\u4f7f\u4eba\u542c\u5230\u58f0\u97f3\u3002"
    },
    {
      "block": 11,
      "text": "\u5728\u7535\u6e90\u548c\u5176\u4ed6\u6761\u4ef6\u4fdd\u6301\u4e0d\u53d8\u7684\u7b80\u5316\u6a21\u578b\u4e2d\uff0c\u632f\u819c\u6ca1\u6709\u53d7\u5230\u58f0\u632f\u52a8\u4f5c\u7528\u65f6\uff0c\u78b3\u7c89\u7684\u7535\u963b\u4fdd\u6301\u4e0d\u53d8\uff0c\u7535\u8def\u4e2d\u7684\u7535\u6d41\u5f3a\u5ea6\u4e5f\u4fdd\u6301\u4e0d\u53d8\u3002\n\u56fe343\u8868\u793a\u9001\u8bdd\u5668\u7535\u8def\u4e2d\u7535\u6d41\u968f\u65f6\u95f4\u7684\u53d8\u5316\uff0c\u4e0a\u8ff0\u60c5\u51b5\u7528\u56fe\u7ebf\u7684$AB$\u6bb5\u8868\u793a\u3002"
    },
    {
      "block": 12,
      "text": "\u7a7a\u6c14\u7684\u58f0\u632f\u52a8\u4f20\u5230\u632f\u819c\uff0c\u4f7f\u632f\u819c\u632f\u52a8\uff0c\u6539\u53d8\u78b3\u7c89\u9897\u7c92\u4e4b\u95f4\u7684\u63a5\u89e6\u548c\u538b\u529b\uff0c\u4ece\u800c\u6539\u53d8\u78b3\u7c89\u7684\u7535\u963b\u3002\n\u7535\u963b\u7684\u53d8\u5316\u5f15\u8d77\u7535\u8def\u4e2d\u7535\u6d41\u5f3a\u5ea6\u7684\u53d8\u5316\uff0c\u7535\u6d41\u7684\u53d8\u5316\u53cd\u6620\u4e86\u632f\u819c\u7684\u632f\u52a8\u3002\n\u8fd9\u79cd\u8109\u52a8\u7535\u6d41\u662f\u5728\u76f4\u6d41\u57fa\u7840\u4e0a\u7684\u5f3a\u5f31\u53d8\u5316\uff0c\u5e76\u4e0d\u8868\u793a\u7535\u6d41\u65b9\u5411\u4e0d\u65ad\u53cd\u8f6c\uff1b\n\n\u56fe343\u4e2d\u7684$BC$\u6bb5\u8868\u793a\u8fd9\u79cd\u60c5\u51b5\u3002"
    },
    {
      "block": 13,
      "text": "\u8fd9\u6837\u4e00\u6765\uff0c**\u9001\u8bdd\u5668\u5904\u7684\u58f0\u632f\u52a8\u5c31\u5f15\u8d77\u4e86\u53e6\u4e00\u7aef\u53d7\u8bdd\u5668\u7535\u8def\u4e2d\u7535\u6d41\u7684\u53d8\u5316**\u3002"
    },
    {
      "block": 15,
      "text": "\u53d7\u8bdd\u5668\u7684\u5916\u58f3$2$\u4e2d\u88c5\u6709\u5e26\u4e24\u4e2a\u6781\u9774\u7684\u6c38\u78c1\u94c1$3$\uff0c\u6781\u9774\u4e0a\u5957\u7740\u7528\u7ec6\u5bfc\u7ebf\u7ed5\u6210\u7684\u7ebf\u5708$4$\u3002\n\u632f\u819c$1$\u662f\u5706\u5f62\u94a2\u8584\u7247\uff0c\u653e\u5728\u5916\u58f3$2$\u4e0a\uff0c\u4e0e\u6781\u9774\u4e4b\u95f4\u7559\u6709\u5f88\u5c0f\u7684\u7a7a\u9699\u3002\n\u76d6\u677f$5$\u5c06\u632f\u819c$1$\u538b\u5728\u5916\u58f3$2$\u4e0a\u3002"
    },
    {
      "block": 18,
      "text": "\u53d7\u8bdd\u5668\u7ebf\u5708\u4e2d\u6ca1\u6709\u7535\u6d41\u65f6\uff0c\u6c38\u78c1\u94c1\u5bf9\u94a2\u8d28\u632f\u819c\u7684\u5438\u5f15\u4f7f\u5b83\u7a0d\u7a0d\u4e0b\u51f9\uff1b\n\u7535\u6d41\u6052\u5b9a\u65f6\uff0c\u7ebf\u5708\u78c1\u573a\u4e0e\u6c38\u78c1\u94c1\u78c1\u573a\u53e0\u52a0\uff0c\u632f\u819c\u4fdd\u6301\u4e00\u4e2a\u9759\u6001\u4f4d\u7f6e\u3002\n\u7535\u6d41\u5f3a\u5ea6\u53d1\u751f\u53d8\u5316\u65f6\uff0c\u7ebf\u5708\u4ea7\u751f\u7684\u9644\u52a0\u78c1\u573a\u4e5f\u76f8\u5e94\u53d8\u5316\uff0c\u4e0e\u6c38\u78c1\u94c1\u5171\u540c\u4f5c\u7528\uff0c\u6539\u53d8\u632f\u819c\u53d7\u5230\u7684\u5438\u5f15\u529b\u3002\n\n\u7531\u4e8e\u7535\u6d41\u53d8\u5316\u53cd\u6620\u4e86\u9001\u8bdd\u5668\u5904\u7684\u58f0\u632f\u52a8\uff0c\u632f\u819c\u53d7\u5230\u7684\u53d8\u5316\u4f5c\u7528\u4e5f\u53cd\u6620\u4e86\u58f0\u632f\u52a8\u3002"
    },
    {
      "block": 19,
      "text": "\u53d8\u5316\u7684\u78c1\u573a\u4f5c\u7528\u4f7f\u53d7\u8bdd\u5668\u632f\u819c\u632f\u52a8\uff0c\u632f\u819c\u518d\u4f7f\u8d34\u8fd1\u5b83\u7684\u7a7a\u6c14\u632f\u52a8\u3002\n\u4eba\u542c\u5230\u7684\u662f\u53d7\u8bdd\u5668\u5728\u5f53\u5730\u91cd\u65b0\u4ea7\u751f\u7684\u58f0\u97f3\uff0c\u800c\u4e0d\u662f\u7a7a\u6c14\u4e2d\u7684\u58f0\u97f3\u76f4\u63a5\u6cbf\u7535\u8bdd\u7ebf\u4f20\u6765\u3002"
    }
  ],
