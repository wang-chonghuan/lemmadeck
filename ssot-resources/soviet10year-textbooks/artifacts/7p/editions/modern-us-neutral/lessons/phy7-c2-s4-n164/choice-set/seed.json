  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u672c\u8bfe\u6240\u8bf4\u7684\u7535\u6c14\u5316\u5e94\u5982\u4f55\u7406\u89e3\uff1f\u8bf7\u8054\u7cfb\u82cf\u8054\u8fd9\u4e00\u5386\u53f2\u5b9e\u4f8b\uff0c\u8bf4\u660e\u7535\u80fd\u7684\u83b7\u5f97\u3001\u4f20\u8f93\u548c\u5e94\u7528\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u4f60\u77e5\u9053\u54ea\u4e9b\u5927\u578b\u53d1\u7535\u7ad9\uff1f\u53ef\u4ee5\u4e3e\u51fa\u672c\u8bfe\u4e2d\u7684\u5386\u53f2\u5b9e\u4f8b\uff0c\u5e76\u8bf4\u660e\u5b83\u4eec\u5c5e\u4e8e\u70ed\u7535\u7ad9\u3001\u6c34\u7535\u7ad9\u8fd8\u662f\u539f\u5b50\u80fd\u7535\u7ad9\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "**\u7535\u6c14\u5316**\u662f\u628a\u7535\u80fd\u5e7f\u6cdb\u7528\u4e8e\u751f\u4ea7\u3001\u4ea4\u901a\u8fd0\u8f93\u548c\u65e5\u5e38\u751f\u6d3b\u7684\u8fc7\u7a0b\u3002"
    },
    {
      "block": 1,
      "text": "\u7535\u6c14\u5316\u6d89\u53ca\u4e09\u4e2a\u76f8\u4e92\u8054\u7cfb\u7684\u95ee\u9898\uff1a\u7535\u80fd\u7684\u83b7\u5f97\u3001\u4f20\u8f93\u548c\u5e94\u7528\u3002\n\u53d1\u7535\u8bbe\u65bd\u63d0\u4f9b\u7535\u80fd\uff0c\u8f93\u7535\u8bbe\u65bd\u628a\u7535\u80fd\u9001\u5230\u7528\u7535\u5730\u70b9\uff0c\u7528\u7535\u8bbe\u5907\u518d\u628a\u7535\u80fd\u8f6c\u6362\u4e3a\u6240\u9700\u7684\u5176\u4ed6\u5f62\u5f0f\u3002"
    },
    {
      "block": 6,
      "text": "\u4ee5\u71c3\u6599\u4e3a\u80fd\u6e90\u7684\u70ed\u7535\u7ad9\u628a\u71c3\u6599\u7684\u5316\u5b66\u80fd\u9010\u6b65\u8f6c\u6362\u4e3a\u70ed\u80fd\u3001\u673a\u68b0\u80fd\u548c\u7535\u80fd\u3002\n\u672c\u8bfe\u6240\u8ff0\u7684\u6c7d\u8f6e\u53d1\u7535\u673a\u7531\u84b8\u6c7d\u63a8\u52a8\u6c7d\u8f6e\u673a\uff0c\u6c7d\u8f6e\u673a\u518d\u5e26\u52a8\u53d1\u7535\u673a\u3002"
    },
    {
      "block": 8,
      "text": "\u6c34\u7535\u7ad9\u5229\u7528\u6d41\u52a8\u6c34\u63a8\u52a8\u6c34\u8f6e\u673a\uff0c\u518d\u7531\u6c34\u8f6e\u673a\u5e26\u52a8\u53d1\u7535\u673a\uff0c\u5c06\u6c34\u6d41\u7684\u673a\u68b0\u80fd\u8f6c\u6362\u4e3a\u7535\u80fd\u3002\n\u5b83\u4e0d\u662f\u628a\u6c34\u5f53\u4f5c\u71c3\u70e7\u7684\u71c3\u6599\u3002"
    },
    {
      "block": 12,
      "text": "**\u539f\u5b50\u80fd**\u53d1\u7535\u7ad9\u5229\u7528\u6838\u80fd\u4ea7\u751f\u70ed\uff0c\u901a\u5e38\u7528\u84b8\u6c7d\u63a8\u52a8\u6c7d\u8f6e\u673a\uff0c\u518d\u7531\u6c7d\u8f6e\u673a\u5e26\u52a8\u53d1\u7535\u673a\u3002\n\u539f\u4e66\u8ba4\u4e3a\uff0c\u5728\u5176\u4ed6\u80fd\u6e90\u7f3a\u4e4f\u3001\u7164\u548c\u77f3\u6cb9\u8fd0\u8f93\u6210\u672c\u8f83\u9ad8\u7684\u5730\u533a\uff0c\u6838\u7535\u53ef\u80fd\u6709\u5efa\u8bbe\u4ef7\u503c\uff1b\n\u8fd9\u4e0d\u610f\u5473\u7740\u9009\u5740\u4e0e\u7ecf\u6d4e\u6027\u53ea\u7531\u71c3\u6599\u8fd0\u8f93\u4e00\u4e2a\u56e0\u7d20\u51b3\u5b9a\u3002"
    }
  ],
