  },
  "exercises": [
    {
      "number": "1",
      "text": "(1) \u6839\u636e\u54ea\u4e9b\u73b0\u8c61\u53ef\u4ee5\u5f97\u51fa\u7535\u8def\u4e2d\u7684\u7535\u6d41\u5177\u6709\u4e00\u5b9a\u65b9\u5411\u7684\u7ed3\u8bba\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "(2) \u628a\u54ea\u79cd\u5e26\u7535\u7c92\u5b50\u7684\u8fd0\u52a8\u65b9\u5411\u53d6\u4e3a\u5bfc\u4f53\u4e2d\u7535\u6d41\u7684\u65b9\u5411\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "(3) \u7535\u6e90\u6b63\u5e38\u5411\u5916\u90e8\u91d1\u5c5e\u7535\u8def\u4f9b\u7535\u65f6\uff0c\u5bfc\u7ebf\u4e2d\u7684\u7535\u5b50\u5b9a\u5411\u79fb\u52a8\u662f\u4ece\u7535\u6e90\u7684\u54ea\u4e00\u6781\u5230\u54ea\u4e00\u6781\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u8fd9\u4e9b\u73b0\u8c61\u8868\u660e\uff0c**\u5bfc\u4f53\u4e2d\u7684\u7535\u6d41\u5177\u6709\u4e00\u5b9a\u7684\u65b9\u5411**\u3002\n\u7535\u6d41\u7684\u67d0\u4e9b\u6548\u5e94\u4e0e\u8fd9\u4e2a\u65b9\u5411\u6709\u5173\u3002"
    },
    {
      "block": 3,
      "text": "\u7535\u6d41\u662f\u5e26\u7535\u7c92\u5b50\u7684\u6709\u5e8f\u8fd0\u52a8\u3002\n\u5728\u91d1\u5c5e\u5bfc\u4f53\u4e2d\uff0c\u53c2\u4e0e\u5bfc\u7535\u7684\u662f\u5e26\u8d1f\u7535\u7684\u7535\u5b50\uff1b\n\u5728\u7535\u89e3\u8d28\u4e2d\uff0c\u6b63\u79bb\u5b50\u548c\u8d1f\u79bb\u5b50\u90fd\u53ef\u4ee5\u53c2\u4e0e\u5bfc\u7535\uff0c\u4e14\u5728\u7535\u573a\u4f5c\u7528\u4e0b\u5411\u76f8\u53cd\u65b9\u5411\u5b9a\u5411\u79fb\u52a8\u3002"
    },
    {
      "block": 6,
      "text": "\u7535\u6d41\u65b9\u5411\u7684\u7ea6\u5b9a\u5f62\u6210\u4e8e\u7535\u5b50\u548c\u79bb\u5b50\u88ab\u8ba4\u8bc6\u4ee5\u524d\u3002\n\u539f\u4e66\u8fd8\u8bb0\u8ff0\u4e86\u5f53\u65f6\u628a\u6b63\u3001\u8d1f\u7535\u8377\u90fd\u8bbe\u60f3\u4e3a\u53ef\u4ee5\u79fb\u52a8\u7684\u65e7\u89e3\u91ca\uff1b\n\u8fd9\u79cd\u89e3\u91ca\u4e0d\u80fd\u7406\u89e3\u6210\u6240\u6709\u5bfc\u4f53\u4e2d\u7684\u6b63\u7535\u8377\u548c\u8d1f\u7535\u8377\u90fd\u80fd\u81ea\u7531\u79fb\u52a8\u3002\n\n\u6cbf\u7528\u81f3\u4eca\u7684\u89c4\u5b9a\u662f\uff1a**\u628a\u6b63\u7535\u8377\u79fb\u52a8\u6216\u53ef\u80fd\u79fb\u52a8\u7684\u65b9\u5411\u89c4\u5b9a\u4e3a\u7535\u6d41\u65b9\u5411**\u3002\n\u56e0\u6b64\uff0c\u5728\u7535\u6e90\u6b63\u5e38\u5411\u5916\u90e8\u7535\u8def\u4f9b\u7535\u65f6\uff0c\u5916\u90e8\u7535\u8def\u4e2d\u7684\u7535\u6d41\u65b9\u5411\u4ece\u7535\u6e90\u6b63\u6781\u6307\u5411\u8d1f\u6781\u3002\n\u5728\u540c\u4e00\u5916\u90e8\u91d1\u5c5e\u5bfc\u7ebf\u4e2d\uff0c\u7535\u5b50\u7684\u5b9a\u5411\u79fb\u52a8\u65b9\u5411\u4e0e\u89c4\u5b9a\u7684\u7535\u6d41\u65b9\u5411\u76f8\u53cd\u3002"
    }
  ],
