  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u4e3a\u4ec0\u4e48\u53ef\u4ee5\u65ad\u5b9a\uff0c\u80fd\u91cf\u4ece\u592a\u9633\u4f20\u5230\u5730\u7403\u4e0d\u53ef\u80fd\u901a\u8fc7\u5bf9\u6d41\u548c\u70ed\u4f20\u5bfc\u6765\u5b9e\u73b0\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u9a8c\u6e29\u5668\u662f\u600e\u6837\u6784\u6210\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u600e\u6837\u7528\u5b9e\u9a8c\u8868\u660e\u8f90\u5c04\u53ef\u4ee5\u4f20\u9012\u80fd\u91cf\uff1f\u53d9\u8ff0\u6559\u6750\u6f14\u793a\u7684\u88c5\u7f6e\u3001\u89c2\u5bdf\u548c\u6bd4\u8f83\u6761\u4ef6\uff0c\u4e0d\u8981\u6c42\u81ea\u884c\u64cd\u4f5c\u9ad8\u6e29\u91d1\u5c5e\u5757\u6216\u73bb\u7483\u88c5\u7f6e\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u5728\u672c\u8bfe\u8ba8\u8bba\u7684\u76f8\u5173\u8f90\u5c04\u6ce2\u6bb5\u548c\u6bd4\u8f83\u6761\u4ef6\u4e0b\uff0c\u4ec0\u4e48\u6837\u7684\u7269\u4f53\u8f83\u5584\u4e8e\u5438\u6536\u8f90\u5c04\u80fd\uff1f\u4ec0\u4e48\u6837\u7684\u7269\u4f53\u8f83\u4e0d\u5584\u4e8e\u5438\u6536\u8f90\u5c04\u80fd\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u4eba\u4eec\u5728\u5b9e\u9645\u6d3b\u52a8\u4e2d\uff0c\u9700\u4e0d\u9700\u8981\u8003\u8651\u5404\u79cd\u7269\u4f53\u5438\u6536\u8f90\u5c04\u80fd\u7684\u80fd\u529b\u4e0d\u540c\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u590f\u5929\uff0c\u5efa\u7b51\u7269\u5185\u7684\u7a7a\u6c14\u53ef\u80fd\u901a\u8fc7\u591a\u79cd\u6e20\u9053\u53d7\u70ed\u800c\u5347\u6e29\uff0c\u4f8b\u5982\u901a\u8fc7\u5899\u58c1\u3001\u901a\u8fc7\u8ba9\u70ed\u7a7a\u6c14\u6d41\u5165\u7684\u655e\u5f00\u7a97\u6237\uff0c\u4ee5\u53ca\u901a\u8fc7\u8ba9\u592a\u9633\u80fd\u900f\u5165\u7684\u73bb\u7483\u3002\u5728\u4e0a\u8ff0\u6bcf\u4e00\u79cd\u60c5\u51b5\u4e2d\uff0c\u53d1\u751f\u4e86\u54ea\u4e9b\u5f62\u5f0f\u7684\u70ed\u4f20\u9012\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u5f53\u6211\u4eec\u7ad9\u5728\u7bdd\u706b\u6216\u655e\u5f00\u7684\u7089\u95e8\u9644\u8fd1\u65f6\uff0c\u4f1a\u611f\u5230\u8eab\u4f53\u88ab\u70e4\u5f97\u5f88\u70ed\u3002\u80fd\u91cf\u4e3b\u8981\u4ee5\u4ec0\u4e48\u65b9\u5f0f\u4ece\u706b\u7130\u4f20\u5230\u8eab\u4f53\u4e0a\uff1f\u8bf4\u660e\u5224\u65ad\u7684\u6761\u4ef6\u548c\u6839\u636e\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u5728\u672c\u8bfe\u8ba8\u8bba\u7684\u6750\u6599\u3001\u76f8\u5173\u8f90\u5c04\u6ce2\u6bb5\u548c\u5176\u4ed6\u6bd4\u8f83\u6761\u4ef6\u4e0b\uff0c\u4e3e\u51e0\u4e2a\u80fd\u8bf4\u660e\u8868\u9762\u9ed1\u6697\u7684\u7269\u4f53\u6bd4\u8868\u9762\u5149\u4eae\u7684\u7269\u4f53\u8f83\u5584\u4e8e\u5438\u6536\u8f90\u5c04\u70ed\u7684\u4f8b\u5b50\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u8ba9\u6211\u4eec\u7528\u539f\u4e66\u63cf\u8ff0\u7684\u5b9e\u9a8c\u6765\u8ba4\u8bc6\u53e6\u4e00\u79cd\u70ed\u4f20\u9012\u65b9\u5f0f\u3002\n\u56fe222\u4e2d\u7684\u70e7\u74f6\u6709\u4e00\u4fa7\u718f\u9ed1\uff0c\u74f6\u53e3\u7528\u585e\u5b50\u585e\u4f4f\uff0c\u4e00\u6839\u5185\u5f84\u8f83\u7ec6\u3001\u5f2f\u6210\u76f4\u89d2\u7684\u73bb\u7483\u7ba1\u7a7f\u8fc7\u74f6\u585e\u4f38\u5165\u74f6\u5185\uff0c\u73bb\u7483\u7ba1\u4e2d\u6709\u5c11\u91cf\u5e26\u989c\u8272\u7684\u6db2\u4f53\u3002\n\u7ed9\u7ec6\u7ba1\u9644\u4e0a\u523b\u5ea6\uff0c\u5c31\u6784\u6210\u4e86\u4e00\u4e2a**\u9a8c\u6e29\u5668**\u3002\n\n\u70e7\u74f6\u4e2d\u7684\u7a7a\u6c14\u7a0d\u5fae\u53d7\u70ed\u65f6\uff0c\u5c0f\u6db2\u67f1\u7684\u4f4d\u7f6e\u5c31\u4f1a\u6539\u53d8\u3002\n\u8fd9\u4e2a\u88c5\u7f6e\u7528\u6765\u663e\u793a\u70ed\u72b6\u6001\u7684\u53d8\u5316\uff1b\n\u4ec5\u9644\u4e0a\u523b\u5ea6\uff0c\u5e76\u4e0d\u7b49\u4e8e\u5236\u6210\u4e86\u80fd\u591f\u8bfb\u51fa\u51c6\u786e\u6e29\u5ea6\u7684\u6821\u51c6\u6e29\u5ea6\u8ba1\u3002\n\n\u8fd9\u91cc\u8bf4\u660e\u6559\u6750\u6f14\u793a\u7684\u88c5\u7f6e\u548c\u539f\u7406\uff0c\u4e0d\u8981\u6c42\u8bfb\u8005\u81ea\u884c\u52a0\u70ed\u91d1\u5c5e\u5757\u6216\u64cd\u4f5c\u73bb\u7483\u88c5\u7f6e\u3002"
    },
    {
      "block": 5,
      "text": "**\u4e00\u5207\u9ad8\u6e29\u7269\u4f53\u90fd\u5411\u5916\u8f90\u5c04\u80fd\u91cf**\u3002\n*\u8f90\u5c04\u4f20\u9012\u80fd\u91cf\u4e0e\u70ed\u4f20\u5bfc\u3001\u5bf9\u6d41\u7684\u533a\u522b\u5728\u4e8e\uff0c\u8f90\u5c04\u53ef\u4ee5\u5728\u771f\u7a7a\u4e2d\u8fdb\u884c*\u3002\n\u592a\u9633\u7684\u80fd\u91cf\u5c31\u662f\u901a\u8fc7\u8f90\u5c04\u4f20\u5230\u5730\u7403\u7684\u3002\n\n\u8f90\u5c04\u4f20\u9012\u80fd\u91cf\u4e0d\u9700\u8981\u4f9d\u9760\u7269\u8d28\u7684\u6574\u4f53\u6d41\u52a8\uff0c\u4e5f\u4e0d\u8981\u6c42\u4e24\u4e2a\u7269\u4f53\u76f4\u63a5\u63a5\u89e6\u3002"
    },
    {
      "block": 6,
      "text": "\u4eba\u4f53\u3001\u706b\u7089\u3001\u7535\u706f\u6ce1\u7b49\u90fd\u4f1a\u5411\u5916\u8f90\u5c04\u80fd\u91cf\uff0c\u4e0d\u8bba\u6e29\u5ea6\u5f88\u9ad8\u8fd8\u662f\u53ea\u6bd4\u5468\u56f4\u7a0d\u9ad8\u4e00\u4e9b\u3002\n\u70ed\u8f90\u5c04\u5e76\u4e0d\u9650\u4e8e\u8fd9\u4e9b\u8f83\u70ed\u7684\u7269\u4f53\uff0c\u666e\u901a\u6e29\u5ea6\u4e0b\u7684\u7269\u4f53\u4e5f\u4f1a\u8f90\u5c04\u80fd\u91cf\u3002\n\u5728\u9762\u79ef\u548c\u8868\u9762\u72b6\u6001\u76f8\u540c\u7684\u6bd4\u8f83\u4e2d\uff0c\u6e29\u5ea6\u8f83\u9ad8\u7684\u7269\u4f53\u901a\u5e38\u5411\u5916\u8f90\u5c04\u66f4\u591a\u80fd\u91cf\u3002\n\n\u7269\u4f53\u540c\u65f6\u8fd8\u4f1a\u5438\u6536\u5468\u56f4\u4f20\u6765\u7684\u8f90\u5c04\uff0c\u56e0\u6b64\u5224\u65ad\u8f90\u5c04\u7684\u51c0\u4f20\u70ed\uff0c\u8981\u628a\u5411\u5916\u8f90\u5c04\u548c\u5438\u6536\u7684\u80fd\u91cf\u4e00\u8d77\u8003\u8651\u3002\n\u5728\u672c\u8bfe\u8ba8\u8bba\u7684\u8f83\u70ed\u7269\u4f53\u4e0e\u8f83\u51b7\u73af\u5883\u7684\u6761\u4ef6\u4e0b\uff0c\u51c0\u8f90\u5c04\u4f20\u70ed\u4f7f\u8f83\u70ed\u7269\u4f53\u5931\u53bb\u80fd\u91cf\uff1b\n\u4e0d\u80fd\u628a\u5411\u5916\u8f90\u5c04\u7684\u603b\u91cf\u76f4\u63a5\u5f53\u6210\u5b83\u51c0\u5931\u53bb\u7684\u80fd\u91cf\u3002"
    },
    {
      "block": 7,
      "text": "\u7167\u5230\u7269\u4f53\u4e0a\u7684\u8f90\u5c04\u80fd\u91cf\uff0c\u4e00\u90e8\u5206\u53ef\u4ee5\u88ab\u7269\u4f53\u5438\u6536\uff0c\u589e\u52a0\u5b83\u7684\u5185\u80fd\u3002\n\u5404\u7269\u4f53\u88ab\u52a0\u70ed\u7684\u7a0b\u5ea6\u53ef\u80fd\u4e0d\u540c\uff0c\u8fd9\u4e0e\u8868\u9762\u72b6\u6001\u6709\u5173\uff0c\u4e5f\u4e0e\u6750\u6599\u548c\u5165\u5c04\u8f90\u5c04\u7684\u6ce2\u6bb5\u7b49\u6761\u4ef6\u6709\u5173\u3002\n\u5438\u6536\u8f90\u5c04\u5e76\u4e0d\u5fc5\u7136\u4f7f\u6e29\u5ea6\u4e0a\u5347\uff0c\u8fd8\u8981\u8003\u8651\u5bf9\u5916\u6563\u70ed\u3001\u505a\u529f\u548c\u7269\u6001\u53d8\u5316\u7b49\u3002\n\n\u5728\u7269\u6001\u4e0d\u53d8\u3001\u83b7\u5f97\u7684\u80fd\u91cf\u8d85\u8fc7\u603b\u6563\u51fa\u7684\u80fd\u91cf\u7b49\u6761\u4ef6\u4e0b\uff0c\u7269\u4f53\u624d\u4f1a\u5347\u6e29\u3002"
    },
    {
      "block": 8,
      "text": "\u5728\u539f\u4e66\u7684\u9a8c\u6e29\u5668\u6bd4\u8f83\u4e2d\uff0c\u5148\u628a\u70e7\u74f6\u718f\u9ed1\u7684\u4e00\u9762\u671d\u5411\u9ad8\u6e29\u91d1\u5c5e\u5757\uff0c\u518d\u628a\u672a\u718f\u9ed1\u7684\u4e00\u9762\u8f6c\u5411\u91d1\u5c5e\u5757\u3002\n\u4fdd\u6301\u91d1\u5c5e\u5757\u3001\u8ddd\u79bb\u3001\u89c2\u5bdf\u65f6\u95f4\u548c\u9a8c\u6e29\u5668\u7684\u521d\u59cb\u72b6\u6001\u7b49\u6761\u4ef6\u76f8\u540c\uff0c\u524d\u4e00\u79cd\u60c5\u51b5\u4e0b\u5c0f\u6db2\u67f1\u5411\u53f3\u79fb\u52a8\u7684\u8ddd\u79bb\u6bd4\u540e\u4e00\u79cd\u5927\uff0c\u8bf4\u660e\u718f\u9ed1\u8868\u9762\u5728\u8fd9\u4e2a\u5b9e\u9a8c\u7684\u76f8\u5173\u8f90\u5c04\u6ce2\u6bb5\u4e2d\u5438\u6536\u4e86\u66f4\u591a\u80fd\u91cf\u3002\n\u8fd9\u7c7b\u9ed1\u8272\u8868\u9762\u901a\u5e38\u4e5f\u8f83\u5584\u4e8e\u5728\u76f8\u5173\u70ed\u8f90\u5c04\u6ce2\u6bb5\u5411\u5916\u8f90\u5c04\u80fd\u91cf\u3002\n\n\u539f\u4e66\u7528\u5149\u4eae\u6c34\u58f6\u4e0e\u9ed1\u8272\u6c34\u58f6\u4e2d\u7684\u70ed\u6c34\u4f5c\u6bd4\u8f83\uff1a\u5728\u6c34\u91cf\u3001\u521d\u59cb\u6e29\u5ea6\u3001\u58f6\u7684\u5927\u5c0f\u548c\u5176\u4ed6\u6563\u70ed\u6761\u4ef6\u76f8\u540c\u7684\u60c5\u51b5\u4e0b\uff0c\u9ed1\u8272\u8868\u9762\u8f83\u5f3a\u7684\u8f90\u5c04\u6563\u70ed\u53ef\u4f7f\u70ed\u6c34\u51c9\u5f97\u66f4\u5feb\u3002\n\u8fd9\u91cc\u7684\u6bd4\u8f83\u4e0d\u80fd\u53ea\u51ed\u8089\u773c\u6240\u89c1\u7684\u989c\u8272\u63a8\u5e7f\u5230\u6240\u6709\u6750\u6599\u548c\u6ce2\u6bb5\u3002\n\u592a\u9633\u5149\u7684\u5438\u6536\u80fd\u529b\u4e0e\u7269\u4f53\u5728\u81ea\u8eab\u6e29\u5ea6\u4e0b\u7684\u70ed\u8f90\u5c04\u80fd\u529b\u4e5f\u4e0d\u80fd\u4e0d\u52a0\u533a\u522b\u5730\u5f53\u6210\u540c\u4e00\u6570\u503c\uff1b\n\n\u5b9e\u9645\u51b7\u5374\u8fd8\u53ef\u80fd\u540c\u65f6\u6d89\u53ca\u4f20\u5bfc\u548c\u5bf9\u6d41\u3002"
    },
    {
      "block": 9,
      "text": "\u5404\u79cd\u8868\u9762\u5438\u6536\u8f90\u5c04\u80fd\u7684\u80fd\u529b\u4e0d\u540c\uff0c\u53ef\u4ee5\u5728\u5b9e\u9645\u8bbe\u8ba1\u4e2d\u52a0\u4ee5\u5229\u7528\u3002\n\u539f\u4e66\u4e3e\u4f8b\uff0c\u6c14\u7403\u548c\u673a\u7ffc\u91c7\u7528\u94f6\u767d\u8272\u8868\u9762\uff0c\u4ee5\u51cf\u5c11\u592a\u9633\u8f90\u5c04\u9020\u6210\u7684\u52a0\u70ed\uff1b\n\u5982\u679c\u9700\u8981\u5229\u7528\u592a\u9633\u80fd\u7ed9\u4eba\u9020\u5730\u7403\u536b\u661f\u4e0a\u67d0\u4e9b\u4eea\u5668\u7684\u90e8\u4ef6\u52a0\u70ed\uff0c\u5219\u628a\u8fd9\u4e9b\u90e8\u4ef6\u6d82\u6210\u9ed1\u8272\u3002\n\n\u8fd9\u4e9b\u4f8b\u5b50\u8868\u8fbe\u7684\u662f\u9009\u62e9\u8868\u9762\u6750\u6599\u548c\u6d82\u5c42\u7684\u76ee\u7684\uff0c\u5e76\u4e0d\u662f\u8bf4\u6240\u6709\u6c14\u7403\u3001\u673a\u7ffc\u6216\u536b\u661f\u90e8\u4ef6\u90fd\u5fc5\u987b\u91c7\u7528\u540c\u4e00\u79cd\u989c\u8272\u3002\n\u662f\u5426\u80fd\u51cf\u5c11\u6216\u589e\u52a0\u6e29\u5347\uff0c\u8981\u770b\u6d82\u5c42\u5bf9\u592a\u9633\u8f90\u5c04\u76f8\u5173\u6ce2\u6bb5\u7684\u5438\u6536\u3001\u5411\u5916\u70ed\u8f90\u5c04\u4ee5\u53ca\u5176\u4ed6\u80fd\u91cf\u4ea4\u6362\u6761\u4ef6\uff0c\u4e0d\u80fd\u53ea\u51ed\u989c\u8272\u5224\u65ad\u51c0\u4f20\u70ed\u3002"
    }
  ],
