  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u7535\u8def\u4e2d\u6709\u7535\u6d41\u901a\u8fc7\u65f6\uff0c\u53ef\u4ee5\u89c2\u5bdf\u5230\u54ea\u4e9b\u73b0\u8c61\uff1f\u7528\u81ea\u5df1\u7684\u8bdd\u5217\u51fa\u4f60\u5b66\u8fc7\u7684\u7c7b\u522b\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4f60\u5b66\u8fc7\u54ea\u4e9b\u78c1\u73b0\u8c61\uff1f\u4e3e\u4f8b\u8bf4\u660e\u89c2\u5bdf\u5230\u7684\u7269\u4f53\u4e4b\u95f4\u53d1\u751f\u4e86\u4ec0\u4e48\u4f5c\u7528\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u5965\u65af\u7279\u5b9e\u9a8c\u600e\u6837\u6f14\u793a\u7535\u6d41\u4e0e\u78c1\u9488\u7684\u76f8\u4e92\u4f5c\u7528\uff1f\u8bf4\u660e\u6559\u5e08\u6f14\u793a\u7684\u88c5\u7f6e\u5b89\u6392\uff0c\u4ee5\u53ca\u63a5\u901a\u548c\u65ad\u5f00\u7535\u8def\u65f6\u78c1\u9488\u600e\u6837\u53d8\u5316\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u7535\u6d41\u4e0e\u78c1\u573a\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f\u7528\u81ea\u5df1\u7684\u8bdd\u8bf4\u660e\u4e3a\u4ec0\u4e48\u628a\u7535\u6d41\u770b\u505a\u78c1\u573a\u7684\u6e90\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u56de\u60f3 \u00a7 128\uff0c\u6709\u7535\u6d41\u901a\u8fc7\u7535\u8def\u65f6\uff0c\u53ef\u4ee5\u89c2\u5bdf\u5230\u70ed\u73b0\u8c61\u3001\u5316\u5b66\u73b0\u8c61\u548c\u78c1\u73b0\u8c61\u7b49\u3002\n\u7535\u6d41\u4e0e\u78c1\u573a\u76f8\u8054\u7cfb\uff0c\u6709\u7535\u6d41\u5b58\u5728\uff0c\u5c31\u6709\u5b83\u4ea7\u751f\u7684\u78c1\u573a\u3002\n\u00a7131\u4ecb\u7ecd\u7684\u78c1\u73b0\u8c61\u8fd8\u544a\u8bc9\u6211\u4eec\uff0c\u4e24\u4e2a\u901a\u7535\u5bfc\u4f53\u4e4b\u95f4\u4f1a\u4ea7\u751f\u76f8\u4e92\u4f5c\u7528\u529b\uff0c\u8fd9\u79cd\u529b\u53eb\u505a\u78c1\u529b\u3002"
    },
    {
      "block": 2,
      "text": "\u63a5\u4e0b\u6765\uff0c\u6211\u4eec\u7528\u78c1\u9488\u89c2\u5bdf\u78c1\u73b0\u8c61\uff0c\u78c1\u9488\u4e5f\u662f\u6307\u5357\u9488\u7684\u4e3b\u8981\u7ec4\u6210\u90e8\u5206\u3002\n\u5148\u8bb0\u4f4f\uff0c**\u78c1\u9488\u6709\u4e24\u4e2a\u78c1\u6781\uff1a\u5317\u6781\u548c\u5357\u6781**\u3002\n\u8fde\u63a5\u78c1\u9488\u4e24\u7aef\uff0c\u4e5f\u5c31\u662f\u8fde\u63a5\u4e24\u4e2a\u78c1\u6781\u7684\u76f4\u7ebf\uff0c\u53eb\u505a**\u78c1\u9488\u7684\u8f74\u7ebf**\u3002"
    },
    {
      "block": 4,
      "text": "\u8fd9\u662f\u7531\u6559\u5e08\u64cd\u4f5c\u7684\u4f4e\u538b\u9650\u6d41\u6559\u5b66\u7535\u8def\u6f14\u793a\uff0c\u5b66\u751f\u53ea\u89c2\u5bdf\uff0c\u4e0d\u81ea\u884c\u63a5\u7ebf\uff0c\u66f4\u4e0d\u5c1d\u8bd5\u5bb6\u7528\u7535\u8def\u3002\n\u6559\u5e08\u628a\u63a5\u5165\u7535\u8def\u7684\u5bfc\u7ebf\u653e\u5728\u78c1\u9488\u8f74\u7ebf\u7684\u4e0a\u65b9\uff08\u56fe 309\uff09\u3002\n\u63a5\u901a\u7535\u8def\u540e\uff0c\u78c1\u9488\u504f\u79bb\u539f\u6765\u7684\u4f4d\u7f6e\uff0c\u56fe\u4e2d\u7684\u865a\u7ebf\u8868\u793a\u5b83\u539f\u6765\u7684\u4f4d\u7f6e\u3002\n\n\u65ad\u5f00\u7535\u8def\u540e\uff0c\u78c1\u9488\u53c8\u8f6c\u56de\u539f\u6765\u7684\u4f4d\u7f6e\u3002\n\u63a5\u901a\u548c\u65ad\u5f00\u65f6\u7684\u53d8\u5316\u8868\u660e\uff0c\u7535\u6d41\u4e0e\u78c1\u9488\u5f7c\u6b64\u76f8\u4e92\u4f5c\u7528\u3002\n\u6559\u5e08\u53ea\u77ed\u65f6\u63a5\u901a\u7535\u8def\uff0c\u907f\u514d\u5bfc\u7ebf\u53d1\u70ed\uff0c\u5b66\u751f\u4e0d\u89e6\u78b0\u901a\u7535\u88c5\u7f6e\u3002"
    },
    {
      "block": 9,
      "text": "\u7c7b\u4f3c\u5730\uff0c\u5965\u65af\u7279\u5b9e\u9a8c\u4f7f\u5b66\u8005\u4eec\u60f3\u5230\uff0c\u901a\u7535\u5bfc\u4f53\u5468\u56f4\u5b58\u5728\u7740\u78c1\u573a\u3002\n\u78c1\u573a\u4f5c\u7528\u4e8e\u78c1\u9488\uff0c\u6240\u4ee5\u63a5\u901a\u7535\u8def\u65f6\u78c1\u9488\u4f1a\u53d1\u751f\u504f\u8f6c\u3002"
    },
    {
      "block": 10,
      "text": "\u5728\u6240\u9009\u53c2\u8003\u7cfb\u4e2d\uff0c\u4e5f\u5c31\u662f\u4ee5\u540c\u4e00\u4f4d\u89c2\u5bdf\u8005\u4e3a\u51c6\uff0c**\u5728\u6240\u6709\u7684\u7535\u6d41\u5468\u56f4\uff0c\u4e5f\u5c31\u662f\u5728\u6240\u6709\u7684\u8fd0\u52a8\u7535\u8377\u5468\u56f4\u90fd\u5b58\u5728\u6709\u78c1\u573a**\u3002\n\u8fd9\u91cc\u5173\u6ce8\u7535\u8377\u5b9a\u5411\u8fd0\u52a8\u5f62\u6210\u7684\u7535\u6d41\uff0c\u7535\u6d41\u4e0e\u5b83\u4ea7\u751f\u7684\u78c1\u573a\u8054\u7cfb\u5728\u4e00\u8d77\u3002"
    },
    {
      "block": 11,
      "text": "\u9759\u6b62\u548c\u8fd0\u52a8\u90fd\u76f8\u5bf9\u4e8e\u540c\u4e00\u53c2\u8003\u7cfb\uff0c\u5e76\u4e14\u8fd9\u91cc\u53ea\u6bd4\u8f83\u7535\u8377\u81ea\u8eab\u4ea7\u751f\u7684\u573a\uff1a**\u5728\u9759\u6b62\u7535\u8377\u7684\u5468\u56f4\u53ea\u5b58\u5728\u6709\u7535\u573a\uff0c\u800c\u5728\u8fd0\u52a8\u7535\u8377\uff0c\u5373\u7535\u6d41\u5468\u56f4\u5219\u65e2\u6709\u7535\u573a\u53c8\u6709\u78c1\u573a**\u3002\n\u8fd0\u52a8\u7535\u8377\u5b9a\u5411\u79fb\u52a8\u5f62\u6210\u7535\u6d41\u65f6\uff0c\u8981\u533a\u5206\u5355\u4e2a\u7535\u8377\u7684\u573a\u4e0e\u6574\u4e2a\u7535\u8def\u7684\u573a\u3002\n\u4e2d\u6027\u7535\u8def\u4e2d\u7684\u6b63\u8d1f\u7535\u8377\u90fd\u5bf9\u7535\u573a\u6709\u8d21\u732e\uff0c\u6240\u4ee5\u4e0d\u80fd\u65ad\u8a00\u4efb\u610f\u4e2d\u6027\u7535\u8def\u4e2d\u5904\u5904\u90fd\u6709\u975e\u96f6\u7535\u573a\u3002"
    },
    {
      "block": 12,
      "text": "\u5bfc\u4f53\u4e2d\u6709\u7535\u6d41\u65f6\uff0c\u5b83\u5468\u56f4\u5c31\u6709\u7535\u6d41\u4ea7\u751f\u7684\u78c1\u573a\uff0c\u6240\u4ee5**\u5e94\u8be5\u628a\u7535\u6d41\u770b\u505a\u662f\u78c1\u573a\u7684\u6e90**\u3002\n\u8bf4\u201c\u7535\u6d41\u7684\u78c1\u573a\u201d\u6216\u201c\u7535\u6d41\u6240\u4ea7\u751f\u7684\u78c1\u573a\u201d\uff0c\u90fd\u662f\u5728\u8bf4\u660e\u7535\u6d41\u4e0e\u5b83\u4ea7\u751f\u7684\u78c1\u573a\u4e4b\u95f4\u7684\u5173\u7cfb\u3002"
    }
  ],
