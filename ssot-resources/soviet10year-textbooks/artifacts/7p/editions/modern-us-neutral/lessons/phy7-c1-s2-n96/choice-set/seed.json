    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u540c\u4e00\u79cd\u7269\u8d28\u80fd\u591f\u5904\u4e8e\u54ea\u4e09\u79cd\u4e0d\u540c\u7684\u805a\u96c6\u6001\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5728\u5b9e\u9645\u751f\u6d3b\u548c\u751f\u4ea7\u4e2d\uff0c\u7269\u8d28\u4ece\u4e00\u79cd\u805a\u96c6\u6001\u53d8\u4e3a\u53e6\u4e00\u79cd\u805a\u96c6\u6001\u6709\u4ec0\u4e48\u610f\u4e49\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u7269\u8d28\u5904\u4e8e\u54ea\u4e00\u79cd\u805a\u96c6\u6001\uff0c\u662f\u7531\u4ec0\u4e48\u51b3\u5b9a\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u7269\u8d28\u4ece\u56fa\u6001\u53d8\u4e3a\u6db2\u6001\u3001\u4ece\u6db2\u6001\u53d8\u4e3a\u6c14\u6001\u65f6\uff0c\u5185\u80fd\u600e\u6837\u53d8\u5316\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u540c\u4e00\u79cd\u7269\u8d28\u5728\u4e0d\u540c\u6761\u4ef6\u4e0b\uff0c\u53ef\u4ee5\u5904\u4e8e\u56fa\u6001\u3001\u6db2\u6001\u6216\u6c14\u6001\u3002\n\u4f8b\u5982\uff0c\u51b0\u3001\u6db2\u6001\u6c34\u548c\u6c34\u84b8\u6c14\uff0c\u90fd\u662f\u6c34\u7684\u4e0d\u540c\u72b6\u6001\u3002\n\u8fd9\u4e9b\u72b6\u6001\u53eb\u505a\u7269\u8d28\u7684**\u805a\u96c6\u6001**\u3002"
    },
    {
      "block": 3,
      "text": "\u8981\u7406\u89e3\u8fd9\u4e9b\u8fc7\u7a0b\uff0c\u5e76\u63a7\u5236\u5176\u4e2d\u8bb8\u591a\u8fc7\u7a0b\uff0c\u5c31\u8981\u77e5\u9053\uff1a\u7269\u8d28\u5728\u4ec0\u4e48\u6761\u4ef6\u4e0b\u5904\u4e8e\u54ea\u4e00\u79cd\u805a\u96c6\u6001\uff0c\u5404\u79cd\u805a\u96c6\u6001\u6709\u4ec0\u4e48\u6027\u8d28\u3002\n\u8fd9\u91cc\u7684\u6761\u4ef6\u5305\u62ec\u6e29\u5ea6\u548c\u538b\u5f3a\u3002\n\u8fd8\u8981\u77e5\u9053\uff0c\u628a\u7269\u8d28\u4ece\u4e00\u79cd\u805a\u96c6\u6001\u53d8\u4e3a\u53e6\u4e00\u79cd\u805a\u96c6\u6001\uff0c\u9700\u8981\u600e\u6837\u6539\u53d8\u6761\u4ef6\u3001\u600e\u6837\u4f20\u9012\u80fd\u91cf\u3002"
    },
    {
      "block": 4,
      "text": "\u524d\u9762\u5b66\u8fc7\uff0c\u5bf9\u4e8e\u6c34\u8fd9\u7c7b\u7531\u5206\u5b50\u6784\u6210\u3001\u4e14\u6ca1\u6709\u53d1\u751f\u5316\u5b66\u53cd\u5e94\u7684\u7269\u8d28\uff0c*\u6539\u53d8\u805a\u96c6\u6001\u901a\u5e38\u4e0d\u6539\u53d8\u5206\u5b50\u7684\u7ec4\u6210*\uff08\u00a714\uff09\u3002\n\u51b0\u3001\u6db2\u6001\u6c34\u548c\u6c34\u84b8\u6c14\u4e2d\u7684\u6c34\u5206\u5b50\u4ecd\u662f\u540c\u4e00\u79cd\u5206\u5b50\uff0c\u4f46\u5206\u5b50\u7684\u6392\u5217\u3001\u95f4\u8ddd\u3001\u8fd0\u52a8\u548c\u76f8\u4e92\u4f5c\u7528\u7684\u60c5\u51b5\u4e0d\u540c\u3002\n\u8fd9\u4e9b\u5dee\u522b\u4f7f\u7269\u8d28\u5728\u76f8\u5e94\u7684\u6e29\u5ea6\u548c\u538b\u5f3a\u6761\u4ef6\u4e0b\u8868\u73b0\u51fa\u4e0d\u540c\u7684\u805a\u96c6\u6001\u3002\n\n\u5e76\u975e\u6240\u6709\u7269\u8d28\u90fd\u7531\u72ec\u7acb\u7684\u5206\u5b50\u6784\u6210\uff0c\u4e0b\u9762\u7684\u5206\u5b50\u63cf\u8ff0\u5148\u7528\u4e8e\u8fd9\u7c7b\u7531\u5206\u5b50\u6784\u6210\u7684\u7269\u8d28\u3002"
    },
    {
      "block": 5,
      "text": "\u5728\u5927\u6c14\u538b\u5f3a\u4e0b\uff0c\u5bf9\u901a\u5e38\u7684\u7a00\u8584\u6c14\u4f53\u6765\u8bf4\uff0c\u5206\u5b50\u95f4\u7684\u8ddd\u79bb\u8fdc\u5927\u4e8e\u5206\u5b50\u672c\u8eab\u7684\u5927\u5c0f\uff0c\u5f7c\u6b64\u7684\u5438\u5f15\u4f5c\u7528\u8f83\u5f31\u3002\n\u8fd9\u91cc\uff0c\u5206\u5b50\u7684\u5e73\u5747\u52a8\u80fd\u8db3\u4ee5\u4f7f\u5b83\u4eec\u4e0d\u88ab\u5f7c\u6b64\u7684\u5f15\u529b\u675f\u7f1a\u5728\u4e00\u8d77\u3002\n\u5982\u679c\u6ca1\u6709\u5bb9\u5668\u58c1\u963b\u6321\uff0c\u6c14\u4f53\u5206\u5b50\u5c31\u4f1a\u5411\u56db\u5468\u6563\u5f00\u3002"
    },
    {
      "block": 6,
      "text": "\u5728\u901a\u5e38\u6761\u4ef6\u4e0b\uff0c\u540c\u4e00\u79cd\u7269\u8d28\u7684\u6db2\u6001\u548c\u56fa\u6001\u5bc6\u5ea6\u6bd4\u6c14\u6001\u5927\u8bb8\u591a\u500d\uff0c\u5206\u5b50\u6392\u5217\u4e5f\u5bc6\u96c6\u5f97\u591a\u3002\n\u5728\u8fd9\u4e9b\u72b6\u6001\u4e2d\uff0c\u5206\u5b50\u7684\u5e73\u5747\u52a8\u80fd\u4e0d\u8db3\u4ee5\u4f7f\u5927\u91cf\u5206\u5b50\u514b\u670d\u76f8\u4e92\u5438\u5f15\u800c\u5f7c\u6b64\u8fdc\u79bb\u3002\n\u5206\u5b50\u4ecd\u5728\u8fd0\u52a8\uff0c\u4f46\u6db2\u4f53\u4e2d\u7684\u5206\u5b50\u901a\u5e38\u4fdd\u6301\u76f8\u8fd1\uff0c\u56fa\u4f53\u4e2d\u7684\u5206\u5b50\u53d7\u5230\u7684\u7ea6\u675f\u66f4\u5f3a\uff0c\u4e0d\u80fd\u50cf\u6c14\u4f53\u5206\u5b50\u90a3\u6837\u81ea\u7531\u6563\u5f00\u3002"
    },
    {
      "block": 7,
      "text": "\u539f\u4e66\u628a\u56fa\u4f53\u9650\u5b9a\u4e3a\u5177\u6709\u6676\u4f53\u7ed3\u6784\u7684\u7269\u4f53\uff0c\u8fd9\u662f\u672c\u8282\u8ba8\u8bba\u7684\u7b80\u5316\uff0c\u4e0d\u662f\u6240\u6709\u56fa\u4f53\u7684\u5b9a\u4e49\u3002\n\u56fa\u4f53\u65e2\u5305\u62ec\u6676\u4f53\uff0c\u4e5f\u5305\u62ec\u975e\u6676\u4f53\u3002\n\u672c\u8282\u5148\u8ba8\u8bba\u6676\u4f53\uff0c\u5176\u4e2d\u6784\u6210\u7269\u8d28\u7684\u5fae\u7c92\u6309*\u6709\u89c4\u5219\u7684\u65b9\u5f0f\u6392\u5217*\u3002\n\n\u5bf9\u7531\u5206\u5b50\u6784\u6210\u7684\u6676\u4f53\u6765\u8bf4\uff0c\u8fd9\u4e9b\u5fae\u7c92\u5c31\u662f\u5206\u5b50\uff0c\u800c\u6db2\u4f53\u548c\u6c14\u4f53\u6ca1\u6709\u8fd9\u79cd\u904d\u53ca\u6574\u4e2a\u6676\u4f53\u7684\u89c4\u5219\u6392\u5217\u3002\n\u6676\u4f53\u7194\u5316\u65f6\uff0c\u5fae\u7c92\u4e0d\u518d\u4fdd\u6301\u539f\u6765\u7684\u89c4\u5219\u6392\u5217\u3002\n\u514b\u670d\u5fae\u7c92\u95f4\u7684\u5438\u5f15\u3001\u6539\u53d8\u5b83\u4eec\u7684\u76f8\u5bf9\u4f4d\u7f6e\u9700\u8981\u80fd\u91cf\uff0c\u7269\u8d28\u7684\u5185\u80fd\u4e5f\u968f\u4e4b\u6539\u53d8\u3002\n\n**\u5728\u56fa\u6001\u53d8\u4e3a\u6db2\u6001\u3001\u6db2\u6001\u53d8\u4e3a\u6c14\u6001\u7684\u8fc7\u7a0b\u4e2d\uff0c\u5373\u4f7f\u6e29\u5ea6\u4e0d\u53d8\uff0c\u7269\u8d28\u7684\u5185\u80fd\u4e5f\u4f1a\u589e\u52a0**\u3002\n\u5728\u901a\u5e38\u7684\u5438\u70ed\u76f8\u53d8\u4e2d\uff0c\u4f20\u5165\u7684\u70ed\u91cf\u7528\u4e8e\u514b\u670d\u5fae\u7c92\u95f4\u7684\u5438\u5f15\u3001\u6539\u53d8\u6392\u5217\u6216\u589e\u5927\u95f4\u8ddd\uff0c\u4f7f\u76f8\u4e92\u4f5c\u7528\u7684\u52bf\u80fd\u589e\u52a0\uff0c\u4e0d\u5fc5\u4f7f\u6e29\u5ea6\u5347\u9ad8\u3002\n**\u5728\u76f8\u53cd\u7684\u8fc7\u7a0b\u4e2d**\uff0c\u7269\u8d28\u4ece\u6c14\u6001\u53d8\u4e3a\u6db2\u6001\u3001\u4ece\u6db2\u6001\u53d8\u4e3a\u56fa\u6001\uff0c\u4f1a\u5411\u5916\u91ca\u653e\u80fd\u91cf\u3002\n\n\u5fae\u7c92\u95f4\u76f8\u4e92\u4f5c\u7528\u7684\u52bf\u80fd\u964d\u4f4e\uff0c**\u7269\u8d28\u7684\u5185\u80fd\u51cf\u5c11**\u3002"
    }
  ],
