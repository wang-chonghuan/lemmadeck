    "lesson": "phy7-c1-s1-n85",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u901a\u8fc7\u4ec0\u4e48\u5b9e\u9a8c\u53ef\u4ee5\u89c2\u5bdf\u5230\u56fa\u4f53\u4f20\u70ed\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u70ed\u662f\u600e\u6837\u901a\u8fc7\u91d1\u5c5e\u4e1d\u4f20\u9012\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u91d1\u5c5e\u548c\u6728\u5934\u7684\u6e29\u5ea6\u76f8\u540c\uff0c\u5e76\u4e14\u90fd\u4f4e\u4e8e\u624b\u7684\u6e29\u5ea6\u3002\u77ed\u6682\u63a5\u89e6\u65f6\uff0c\u91d1\u5c5e\u4f1a\u8ba9\u4eba\u89c9\u5f97\u6bd4\u6728\u5934\u51c9\uff0c\u8fd9\u662f\u4e3a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u5728\u672c\u8bfe\u8ba8\u8bba\u7684\u7269\u8d28\u4e2d\uff0c\u54ea\u4e9b\u7269\u8d28\u5bfc\u70ed\u6027\u80fd\u6700\u5f3a\uff1f\u54ea\u4e9b\u7269\u8d28\u5bfc\u70ed\u6027\u80fd\u6700\u5dee\uff1f\u5b83\u4eec\u5404\u6709\u4ec0\u4e48\u7528\u5904\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u4e3a\u4ec0\u4e48\u539a\u5c42\u677e\u8f6f\u7684\u96ea\u6709\u52a9\u4e8e\u4fdd\u62a4\u8d8a\u51ac\u4f5c\u7269\uff0c\u51cf\u5c11\u5b83\u4eec\u53d7\u5230\u51bb\u5bb3\u7684\u98ce\u9669\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u8bd5\u89e3\u91ca\u4e3a\u4ec0\u4e48\u9ea6\u79f8\u3001\u7a3b\u8349\u3001\u5e72\u6811\u53f6\u7b49\u7684\u5bfc\u70ed\u6027\u80fd\u8f83\u5dee\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u539f\u4e66\u7ed9\u51fa\u7684\u6bd4\u8f83\u7ed3\u679c\u662f\uff1a\u677e\u6728\u677f\u7684\u5bfc\u70ed\u80fd\u529b\u662f\u677e\u6728\u952f\u672b\u76843.7\u500d\uff0c\u800c\u51b0\u7684\u5bfc\u70ed\u80fd\u529b\u662f\u65b0\u964d\u96ea\u768421.5\u500d\uff08\u96ea\u662f\u7531\u7ec6\u5c0f\u7684\u51b0\u6676\u7ec4\u6210\u7684\uff09\u3002\u8bd5\u89e3\u91ca\u4e3a\u4ec0\u4e48\u5b58\u5728\u8fd9\u79cd\u5dee\u522b\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-4",
      "text": "\uff084\uff09\u4e3a\u4ec0\u4e48\u201c\u76ae\u8884\u751f\u70ed\u201d\u7684\u8bf4\u6cd5\u662f\u9519\u8bef\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u653e\u5728\u684c\u4e0a\u7684\u526a\u5200\u548c\u94c5\u7b14\u7684\u6e29\u5ea6\u76f8\u540c\uff0c\u5e76\u4e14\u90fd\u4f4e\u4e8e\u624b\u7684\u6e29\u5ea6\u3002\u4e3a\u4ec0\u4e48\u77ed\u6682\u63a5\u89e6\u65f6\u4f1a\u89c9\u5f97\u526a\u5200\u51c9\u4e00\u4e9b\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 11,
      "text": "\u5728\u672c\u8bfe\u6bd4\u8f83\u7684\u5e38\u89c1\u6750\u6599\u4e2d\uff0c\u91d1\u5c5e\u901a\u5e38\u8f83\u5bb9\u6613\u5bfc\u70ed\uff0c\u94f6\u548c\u94dc\u7684\u5bfc\u70ed\u6027\u80fd\u5c24\u5176\u597d\u3002\n\u9664\u6db2\u6001\u91d1\u5c5e\uff08\u5982\u6c34\u94f6\uff09\u7b49\u60c5\u51b5\u5916\uff0c\u5e38\u89c1\u6db2\u4f53\u7684\u5bfc\u70ed\u6027\u80fd\u901a\u5e38\u6bd4\u826f\u5bfc\u70ed\u91d1\u5c5e\u5dee\uff1b\n\u6c14\u4f53\u7684\u5bfc\u70ed\u6027\u80fd\u4e00\u822c\u66f4\u5dee\u3002\n\n\u6309\u672c\u8bfe\u7684\u7c92\u5b50\u6a21\u578b\uff0c\u901a\u5e38\u6761\u4ef6\u4e0b\u6c14\u4f53\u5206\u5b50\u4e4b\u95f4\u7684\u8ddd\u79bb\u8f83\u5927\uff0c\u80fd\u91cf\u4e0d\u5bb9\u6613\u50cf\u5728\u76f8\u90bb\u7c92\u5b50\u7d27\u5bc6\u8054\u7cfb\u7684\u56fa\u4f53\u4e2d\u90a3\u6837\u4f20\u9012\u3002\n\u8fd9\u91cc\u6bd4\u8f83\u7684\u662f\u70ed\u4f20\u5bfc\uff0c\u4e0d\u662f\u8bf4\u6db2\u4f53\u548c\u6c14\u4f53\u4e0d\u80fd\u901a\u8fc7\u5176\u4ed6\u65b9\u5f0f\u4f20\u70ed\uff0c\u4e5f\u4e0d\u628a\u8fd9\u79cd\u6bd4\u8f83\u5f53\u6210\u6240\u6709\u6750\u6599\u3001\u6240\u6709\u6761\u4ef6\u4e0b\u7684\u7edd\u5bf9\u6392\u5e8f\u3002"
    },
    {
      "block": 12,
      "text": "\u7f8a\u6bdb\u3001\u68c9\u82b1\u3001\u7ed2\u6bdb\u3001\u6bdb\u76ae\u4ee5\u53ca\u5176\u4ed6\u591a\u5b54\u9699\u6750\u6599\u7684\u5bfc\u70ed\u6027\u80fd\u901a\u5e38\u8f83\u5dee\uff0c\u5176\u4e2d\u7ea4\u7ef4\u6216\u5b54\u9699\u95f4\u7559\u5b58\u7684\u7a7a\u6c14\u6709\u52a9\u4e8e\u51cf\u5f31\u5bfc\u70ed\u3002\n\u539f\u4e66\u628a\u542b\u6709\u6781\u7a00\u8584\u6c14\u4f53\u7684\u7a7a\u95f4\u79f0\u4e3a\u771f\u7a7a\uff0c\u5e76\u7528\u5b83\u8bf4\u660e\u6c14\u4f53\u8d8a\u7a00\u8584\uff0c\u4f9d\u9760\u6c14\u4f53\u7c92\u5b50\u4f20\u5bfc\u70ed\u91cf\u7684\u4f5c\u7528\u8d8a\u5f31\u3002\n\u8fd9\u662f\u56e0\u4e3a*\u628a\u80fd\u91cf\u4ece\u7269\u4f53\u7684\u4e00\u90e8\u5206\u4f20\u7ed9\u53e6\u4e00\u90e8\u5206\u7684\u70ed\u4f20\u5bfc\uff0c\u662f\u9760\u5206\u5b50\u6216\u5176\u4ed6\u7c92\u5b50\u5b9e\u73b0\u7684*\u3002\n\n\u5b8c\u5168\u6ca1\u6709\u7c92\u5b50\u7684\u7a7a\u95f4\u4e0d\u80fd\u53d1\u751f\u8fd9\u79cd\u70ed\u4f20\u5bfc\uff0c\u4f46\u8fd9\u5e76\u4e0d\u6392\u9664\u8f90\u5c04\u4f20\u70ed\u3002"
    }
  ],
