  "exercises": [
    {
      "number": "1",
      "text": "(1) \u6db2\u4f53\u84b8\u53d1\u65f6\uff0c\u5206\u5b50\u98de\u51fa\u6db2\u9762\u9700\u8981\u505a\u4ec0\u4e48\u529f\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "(2) \u5982\u4f55\u89e3\u91ca\u6db2\u4f53\u5728\u84b8\u53d1\u65f6\u6e29\u5ea6\u4e0b\u964d\u7684\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "(3) \u600e\u6837\u901a\u8fc7\u5b9e\u9a8c\u8868\u660e\u6db2\u4f53\u84b8\u53d1\u65f6\u6e29\u5ea6\u4e0b\u964d\u7684\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "(4) \u5728\u76f8\u540c\u6761\u4ef6\u4e0b\uff0c\u6709\u4e9b\u6db2\u4f53\u84b8\u53d1\u5f97\u5feb\uff0c\u6709\u4e9b\u6db2\u4f53\u84b8\u53d1\u5f97\u6162\u3002\u5982\u4f55\u89e3\u91ca\u8fd9\u79cd\u73b0\u8c61\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5206\u5b50\u4ece\u6db2\u4f53\u4e2d\u98de\u51fa\u65f6\uff0c\u9700\u8981\u514b\u670d\u5176\u4ed6\u6db2\u4f53\u5206\u5b50\u7684\u5f15\u529b\uff0c\u4e5f\u5c31\u662f\u8981\u514b\u670d\u8fd9\u4e9b\u5f15\u529b\u505a\u529f\u3002\n\u5e76\u4e0d\u662f\u6bcf\u4e2a\u6db2\u4f53\u5206\u5b50\u90fd\u6709\u8db3\u591f\u7684\u80fd\u91cf\u5b8c\u6210\u8fd9\u4e2a\u8fc7\u7a0b\u3002\n\u53ea\u6709\u52a8\u80fd\u8db3\u591f\u5927\u7684\u5206\u5b50\u624d\u80fd\u98de\u51fa\u6db2\u9762\u3002\n\n\u8fd9\u4e9b\u5206\u5b50\u7684\u8fd0\u52a8\u901f\u5ea6\u9ad8\u4e8e\u6db2\u4f53\u5206\u5b50\u7684\u5e73\u5747\u901f\u5ea6\u3002\n\u5728\u4efb\u4f55\u6e29\u5ea6\u4e0b\uff0c\u6db2\u4f53\u4e2d\u90fd\u6709\u8fd9\u6837\u8fd0\u52a8\u8f83\u5feb\u7684\u5206\u5b50\u3002"
    },
    {
      "block": 1,
      "text": "\u8fd0\u52a8\u8f83\u5feb\u7684\u5206\u5b50\u4ece\u6db2\u4f53\u4e2d\u98de\u51fa\uff0c\u8fdb\u5165\u84b8\u6c7d\u540e\uff0c\u7559\u5728\u6db2\u4f53\u4e2d\u7684\u5206\u5b50\u7684\u5e73\u5747\u901f\u5ea6\u51cf\u5c0f\uff0c\u5e73\u5747\u52a8\u80fd\u4e5f\u968f\u4e4b\u51cf\u5c0f\u3002\n\u56e0\u6b64\uff0c**\u6db2\u4f53\u84b8\u53d1\u65f6\uff0c\u5185\u80fd\u4f1a\u51cf\u5c11**\u3002\n\u5982\u679c\u6ca1\u6709\u4ece\u5916\u90e8\u5411\u6b63\u5728\u84b8\u53d1\u7684\u6db2\u4f53\u8865\u5145\u80fd\u91cf\uff0c**\u6db2\u4f53\u7684\u6e29\u5ea6\u5c31\u4f1a\u964d\u4f4e**\u3002"
    },
    {
      "block": 2,
      "text": "\u6db2\u4f53\u84b8\u53d1\u65f6\u7684\u964d\u6e29\u73b0\u8c61\u53ef\u4ee5\u7528\u5b9e\u9a8c\u89c2\u5bdf\u3002\n\u5728\u6f14\u793a\u5b9e\u9a8c\u4e2d\uff0c\u6e29\u5ea6\u8ba1\u7684\u8d2e\u6db2\u6ce1\u7528\u68c9\u82b1\u6216\u5e03\u5305\u4f4f\uff0c\u68c9\u82b1\u6216\u5e03\u8638\u6709\u4e59\u919a\u3002\n\u8fc5\u901f\u84b8\u53d1\u7684\u4e59\u919a\u5438\u6536\u8d2e\u6db2\u6ce1\u7684\u4e00\u90e8\u5206\u5185\u80fd\uff0c\u6e29\u5ea6\u8ba1\u7684\u793a\u6570\u968f\u4e4b\u964d\u4f4e\u3002\n\n\u4e59\u919a\u5728\u624b\u90e8\u84b8\u53d1\u65f6\u4e5f\u4f1a\u5438\u6536\u80fd\u91cf\uff0c\u4f7f\u624b\u611f\u5230\u51c9\u3002\n\u8fd9\u662f\u5bf9\u73b0\u8c61\u7684\u8bf4\u660e\uff0c\u4e0d\u8981\u628a\u4e59\u919a\u6d82\u5728\u76ae\u80a4\u4e0a\u3002"
    },
    {
      "block": 4,
      "text": "\u676f\u4e2d\u7684\u6c34\u5728\u84b8\u53d1\u65f6\uff0c\u6211\u4eec\u5f80\u5f80\u6ca1\u6709\u89c2\u5bdf\u5230\u5269\u4f59\u7684\u6c34\u660e\u663e\u964d\u6e29\u3002\n\u8fd9\u662f\u4e3a\u4ec0\u4e48\u5462\uff1f\n\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u676f\u4e2d\u7684\u6c34\u4ece\u5468\u56f4\u7a7a\u6c14\u5438\u6536\u70ed\u91cf\uff0c\u8865\u5145\u4e86\u84b8\u53d1\u6240\u9700\u7684\u80fd\u91cf\uff0c\u6240\u4ee5\u6c34\u6e29\u80fd\u591f\u4fdd\u6301\u4e0d\u53d8\u3002\n\n\u53ef\u89c1\uff0c**\u8981\u4f7f\u6db2\u4f53\u5728\u84b8\u53d1\u65f6\u4fdd\u6301\u6e29\u5ea6\u4e0d\u53d8\uff0c\u5c31\u5fc5\u987b\u5411\u6db2\u4f53\u4f20\u9012\u80fd\u91cf**\u3002"
    },
    {
      "block": 6,
      "text": "\u4e3a\u4ec0\u4e48\u5728\u76f8\u540c\u6761\u4ef6\u4e0b\uff0c\u84b8\u53d1\u6c34\u6bd4\u84b8\u53d1\u4e59\u919a\u9700\u8981\u66f4\u591a\u7684\u80fd\u91cf\u5462\uff1f\n\u8fd9\u662f\u56e0\u4e3a\u6c34\u5206\u5b50\u4e4b\u95f4\u7684\u5185\u805a\u529b\u6bd4\u4e59\u919a\u5206\u5b50\u4e4b\u95f4\u7684\u5185\u805a\u529b\u5927\u3002"
    }
  ],
