  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u5728\u672c\u8282\u6240\u8ff0\u7684\u60c5\u5883\u4e2d\uff0c\u628a\u94c5\u7403\u4e3e\u9ad8\u65f6\uff0c\u5b83\u7684\u80fd\u91cf\u53d1\u751f\u4e86\u4ec0\u4e48\u53d8\u5316\uff1f\u94c5\u7403\u4e0b\u843d\u65f6\u53c8\u5982\u4f55\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u94c5\u7403\u4e0e\u94c5\u677f\u78b0\u649e\u540e\uff0c\u5b83\u4eec\u7684\u72b6\u6001\u53d1\u751f\u4e86\u4ec0\u4e48\u53d8\u5316\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u94c5\u7403\u4e0e\u94c5\u677f\u53d1\u751f\u78b0\u649e\u65f6\uff0c\u94c5\u7403\u7684\u673a\u68b0\u80fd\u8f6c\u5316\u6210\u4e86\u54ea\u4e00\u79cd\u80fd\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u4ec0\u4e48\u662f\u7269\u4f53\u7684\u5185\u80fd\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u673a\u68b0\u80fd\u6709\u4e24\u79cd\u5f62\u5f0f\uff1a*\u52bf\u80fd*\u548c*\u52a8\u80fd*\u3002"
    },
    {
      "block": 1,
      "text": "\u7531\u4e8e\u7269\u4f53\u4e4b\u95f4\u7684**\u76f8\u4e92\u4f5c\u7528**\uff0c\u4f8b\u5982\u76f8\u4e92\u5438\u5f15\u6216\u76f8\u4e92\u6392\u65a5\uff0c\u7269\u4f53\u7ec4\u6210\u7684\u7cfb\u7edf\u53ef\u4ee5\u5177\u6709\u52bf\u80fd\u3002\n\u5730\u7403\u4e0e\u88ab\u4e3e\u9ad8\u7684\u77f3\u5757\u7ec4\u6210\u7684\u7cfb\u7edf\u3001\u538b\u7f29\u6216\u62c9\u4f38\u4e86\u7684\u5f39\u7c27\u3001\u538b\u7f29\u6c14\u4f53\u7b49\uff0c\u90fd\u662f\u4e0e\u76f8\u4e92\u4f5c\u7528\u6709\u5173\u7684\u52bf\u80fd\u7684\u4f8b\u5b50\u3002"
    },
    {
      "block": 2,
      "text": "\u76f8\u5bf9\u4e8e\u9009\u5b9a\u7684\u53c2\u8003\u7cfb\uff0c*\u8fd0\u52a8\u7684\u7269\u4f53*\u5177\u6709\u52a8\u80fd\uff0c\u4f8b\u5982\u6d41\u52a8\u7684\u6c34\u3001\u98ce\u3001\u6eda\u52a8\u7740\u7684\u7403\u548c\u98de\u884c\u4e2d\u7684\u5b50\u5f39\u3002\n\u5728\u540c\u4e00\u53c2\u8003\u7cfb\u4e2d\uff0c\u52a8\u80fd\u7684\u5927\u5c0f\u4e0e*\u8fd0\u52a8\u7269\u4f53\u7684\u8d28\u91cf\u53ca\u5176\u901f\u5ea6*\u6709\u5173\u3002"
    },
    {
      "block": 15,
      "text": "**\u7ec4\u6210\u7269\u4f53\u7684\u6240\u6709\u7c92\u5b50\u56e0\u65e0\u89c4\u5219\u8fd0\u52a8\u548c\u76f8\u4e92\u4f5c\u7528\u800c\u5177\u6709\u7684\u80fd\u91cf\u603b\u548c\uff0c\u79f0\u4e3a\u7269\u4f53\u7684\u5185\u80fd**\u3002"
    },
    {
      "block": 16,
      "text": "\u9664\u4e86\u7269\u4f53\u4f5c\u4e3a\u6574\u4f53\u8fd0\u52a8\u6216\u4e0e\u5176\u4ed6\u7269\u4f53\u76f8\u4e92\u4f5c\u7528\u65f6\u5177\u6709\u7684\u673a\u68b0\u80fd\uff0c\u4e5f\u5b58\u5728\u7531\u5185\u90e8\u7c92\u5b50\u8fd0\u52a8\u548c\u76f8\u4e92\u4f5c\u7528\u6240\u51b3\u5b9a\u7684**\u5185\u80fd**\u3002\n\u5185\u80fd\u4e0e\u7269\u4f53\u4f5c\u4e3a\u6574\u4f53\u7684\u52a8\u80fd\u548c\u52bf\u80fd\u76f8\u533a\u522b\u3002"
    }
  ],
