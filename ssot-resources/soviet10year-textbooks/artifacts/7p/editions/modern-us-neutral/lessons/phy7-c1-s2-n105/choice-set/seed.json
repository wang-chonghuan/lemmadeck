  "exercises": [
    {
      "number": "1",
      "text": "(1) \u84b8\u6c7d\u5728\u4ec0\u4e48\u6761\u4ef6\u4e0b\u4f1a\u51dd\u7ed3\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "(2) \u81ea\u7136\u754c\u4e2d\u6709\u54ea\u4e9b\u73b0\u8c61\u53ef\u4ee5\u7528\u84b8\u6c7d\u7684\u51dd\u7ed3\u6765\u89e3\u91ca\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "(1) \u96e8\u540e\u6c34\u6d3c\u91cc\u7684\u6c34\uff0c\u5728\u6709\u98ce\u8fd8\u662f\u65e0\u98ce\u7684\u5929\u6c14\u91cc\u5e72\u5f97\u66f4\u5feb\uff1f\u5728\u6c14\u6e29\u8f83\u4f4e\u8fd8\u662f\u8f83\u9ad8\u7684\u5929\u6c14\u91cc\u5e72\u5f97\u66f4\u5feb\uff1f\u8bf7\u89e3\u91ca\u4f60\u7684\u5224\u65ad\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "(2) \u4e3a\u4ec0\u4e48\u5bf9\u7740\u70ed\u8336\u5439\u6c14\uff0c\u80fd\u8ba9\u8336\u51c9\u5f97\u66f4\u5feb\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "(3) \u5929\u6c14\u708e\u70ed\u65f6\uff0c\u51fa\u6c57\u4e3a\u4ec0\u4e48\u80fd\u5e2e\u52a9\u8eab\u4f53\u964d\u6e29\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "(4) \u5728\u540c\u6837\u708e\u70ed\u7684\u5929\u6c14\u91cc\uff0c\u4e3a\u4ec0\u4e48\u7a7a\u6c14\u5e72\u71e5\u65f6\u901a\u5e38\u6bd4\u7a7a\u6c14\u6f6e\u6e7f\u65f6\u66f4\u5bb9\u6613\u5fcd\u53d7\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "(5) \u708e\u70ed\u7684\u590f\u5929\uff0c\u628a\u6c34\u88c5\u5728\u7528\u8f7b\u5ea6\u70e7\u5236\u7684\u9ecf\u571f\u505a\u6210\u7684\u5bb9\u5668\u91cc\u3002\u6c34\u80fd\u900f\u8fc7\u5bb9\u5668\u58c1\u7f13\u6162\u6e17\u51fa\uff0c\u5bb9\u5668\u91cc\u7684\u6c34\u6e29\u4f1a\u4f4e\u4e8e\u5468\u56f4\u7684\u6c14\u6e29\u3002\u8fd9\u662f\u4e3a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "(6) \u5c06\u7b49\u91cf\u7684\u6c34\u5206\u522b\u5012\u5165\u676f\u5b50\u548c\u76d8\u5b50\u3002\u54ea\u4e00\u5904\u7684\u6c34\u84b8\u53d1\u5f97\u66f4\u5feb\uff1f\u4e3a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "(7) \u89c2\u5bdf\u6559\u5e08\u5728\u5b9e\u9a8c\u5ba4\u4e2d\u7684\u6f14\u793a\uff1a\u7528\u6bdb\u7b14\u5c06\u4e59\u919a\u3001\u9152\u7cbe\u3001\u6c34\u548c\u6cb9\u7b49\u51e0\u79cd\u6db2\u4f53\uff0c\u5206\u522b\u6d82\u5728\u540c\u4e00\u5757\u73bb\u7483\u6216\u6728\u677f\u4e0a\u3002\u4f60\u4f1a\u770b\u5230\uff0c\u5404\u79cd\u6db2\u4f53\u6d82\u75d5\u7684\u84b8\u53d1\u901f\u5ea6\u4e0d\u540c\u3002\u8bf7\u89c2\u5bdf\u5e76\u89e3\u91ca\u8fd9\u4e00\u73b0\u8c61\u3002\u6f14\u793a\u53ea\u80fd\u7531\u6559\u5e08\u5728\u5177\u5907\u5316\u5b66\u5b9e\u9a8c\u5b89\u5168\u6761\u4ef6\u3001\u901a\u98ce\u4e14\u8fdc\u79bb\u706b\u6e90\u7684\u573a\u6240\u8fdb\u884c\uff0c\u4e0d\u8981\u81ea\u884c\u53d6\u7528\u8fd9\u4e9b\u6db2\u4f53\u6216\u64cd\u4f5c\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u84b8\u6c7d\u4e2d\u7684\u5206\u5b50\u8fdb\u5165\u6db2\u4f53\uff0c\u8fd9\u79cd\u8fc7\u7a0b\u53eb\u4f5c**\u51dd\u7ed3**\u3002\n\u51dd\u7ed3\u65f6\uff0c\u84b8\u6c7d\u53d8\u6210\u6db2\u4f53\u3002"
    },
    {
      "block": 1,
      "text": "**\u84b8\u6c7d\u51dd\u7ed3\u65f6\u4f1a\u91ca\u653e\u80fd\u91cf**\u3002"
    },
    {
      "block": 2,
      "text": "\u6bd4\u8f83\u6c7d\u5316\u548c\u51dd\u7ed3\u65f6\u7684\u70ed\u91cf\uff0c\u8981\u770b\u540c\u79cd\u7269\u8d28\uff0c\u5e76\u4e14\u8d28\u91cf\u548c\u6e29\u5ea6\u90fd\u76f8\u540c\u3002\n\u5728\u8fd9\u4e9b\u6761\u4ef6\u4e0b\uff0c\u6db2\u4f53\u6c7d\u5316\u5438\u6536\u591a\u5c11\u70ed\u91cf\uff0c\u5b83\u7684\u84b8\u6c7d\u51dd\u7ed3\u65f6\u5c31\u653e\u51fa\u591a\u5c11\u70ed\u91cf\u3002\n\u56e0\u6b64\uff0c**\u51dd\u7ed3\u653e\u51fa\u7684\u70ed\u91cf\u7b49\u4e8e\u6c7d\u5316\u5438\u6536\u7684\u70ed\u91cf**\u3002"
    }
  ],
