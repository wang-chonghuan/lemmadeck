  "exercises": [
    {
      "number": "1",
      "text": "(1) \u7535\u6d41\u6548\u5e94\u7684\u5f3a\u5f31\u4e0e\u4ec0\u4e48\u56e0\u7d20\u6709\u5173?",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "(2) \u5bf9\u4e8e\u7535\u8377\u7684\u6570\u91cf\u8fd8\u53ef\u4ee5\u6709\u4ec0\u4e48\u53eb\u6cd5?",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "(3) \u4ec0\u4e48\u662f\u7535\u8def\u4e2d\u7684\u7535\u6d41\u5f3a\u5ea6?",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "(4) \u5bf9\u201c\u5f3a\u7535\u6d41\u201d\u3001\u201c\u5f31\u7535\u6d41\u201d\u7b49\u8bf4\u6cd5\u5e94\u8be5\u505a\u4f55\u7406\u89e3?",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "(5) \u5bf9\u4e8e\u7b80\u5355\u7535\u8def\u4e2d\u7684\u7535\u6d41\u5f3a\u5ea6\u5904\u5904\u76f8\u7b49\u8fd9\u4e00\u4e8b\u5b9e\u5e94\u5982\u4f55\u89e3\u91ca?",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u00a7 128 \u4e2d\u6240\u8ff0\u7684\u7535\u6d41\u7684\u5404\u79cd\u6548\u5e94\u90fd\u6709\u5f3a\u5f31\u7a0b\u5ea6\u4e4b\u5206.\n\u5b9e\u9a8c\u8868\u660e\uff0c\u7535\u6d41(*\u6548\u5e94*)\u7684\u5f3a\u5f31\u7a0b\u5ea6\u4e0e\u5355\u4f4d\u65f6\u95f4(\u79d2)\u5185\u901a\u8fc7\u7535\u8def\u7684\u7535\u8377\u91cf\u6709\u5173."
    },
    {
      "block": 2,
      "text": "\u8fd9\u4e2a\u603b\u7535\u8377\u91cf\u4e5f\u53eb\u505a\u901a\u8fc7\u5bfc\u4f53\u7684**\u7535\u91cf**.\n\u4f8b\u5982\u7535\u6d41\u7684\u5316\u5b66\u6548\u5e94\u5c31\u4e0e\u7535\u91cf\u6709\u5173.\n\u5f53\u7535\u6d41\u901a\u8fc7\u7535\u89e3\u8d28\u65f6\uff0c\u7535\u91cf\u8d8a\u5927\u5219\u5728\u9634\u6781\u548c\u9633\u6781\u4e0a\u6790\u51fa\u6765\u7684\u7269\u8d28\u5c31\u8d8a\u591a.\n\n\u8fd9\u662f\u56e0\u4e3a\u6bcf\u4e00\u4e2a\u79bb\u5b50\u5c31\u662f\u7269\u8d28\u7684\u4e00\u4e2a\u7c92\u5b50.\n\u56e0\u6b64\uff0c\u82e5\u901a\u8fc7\u79f0\u91cf\u6d4b\u51fa\u5728\u4e00\u4e2a\u7535\u6781\u4e0a\u6c89\u6dc0\u51fa\u7684*\u7269\u8d28*\u7684\u8d28\u91cf\uff0c\u4e14\u5df2\u77e5\u8fd9\u79cd\u7269\u8d28\u4e00\u4e2a\u79bb\u5b50\u7684\u8d28\u91cf\u548c\u6240\u5e26\u7684\u7535\u8377\u91cf\uff0c\u5219\u7535\u91cf\u5c31\u662f\u53ef\u4ee5\u8ba1\u7b97\u7684."
    },
    {
      "block": 4,
      "text": "**\u6570\u503c\u4e0a\u4e0e $1$ \u79d2\u5185\u901a\u8fc7\u5bfc\u4f53\u622a\u9762\u7684\u7535\u91cf\u76f8\u7b49\u7684\u91cf\u53eb\u505a\u7535\u6d41\u5f3a\u5ea6**."
    },
    {
      "block": 5,
      "text": "**\u4e3a\u4e86\u6c42\u51fa\u7535\u8def\u4e2d\u7684\u7535\u6d41\u5f3a\u5ea6\uff0c\u5e94\u5c06\u901a\u8fc7\u53bb\u7684\u7535\u91cf\u9664\u4ee5\u901a\u8fc7\u8fd9\u90e8\u5206\u7535\u91cf\u6240\u9700\u7684\u65f6\u95f4**."
    },
    {
      "block": 7,
      "text": "\u7528\u5b57\u6bcd\u8868\u793a\u5404\u91cf\uff1a\n$I$\u2014\u2014\u7535\u6d41\u5f3a\u5ea6\uff0c$q$\u2014\u2014\u7535\u91cf\uff0c$t$\u2014\u2014\u65f6\u95f4\uff0c\u5219\u53ef\u7528\u516c\u5f0f\u628a\u7535\u6d41\u5f3a\u5ea6\u8868\u793a\u4e3a"
    },
    {
      "block": 8,
      "text": "$I=\\frac{q}{t}$."
    },
    {
      "block": 9,
      "text": "\u5f53\u6211\u4eec\u4f7f\u7528\u201c\u7535\u6d41\u5f3a\u5ea6\u201d\u3001\u201c\u5f3a\u7535\u6d41\u201d\u3001\u201c\u5f31\u7535\u6d41\u201d\u7b49\u5404\u79cd\u8bf4\u6cd5\u7684\u65f6\u5019\uff0c\u5fc5\u987b\u80fd\u6b63\u786e\u5730\u7406\u89e3\u5b83\u4eec\u7684\u542b\u4e49\u662f\u4ec0\u4e48.\n\u201c*\u5f3a\u7535\u6d41*\u201d\u7684\u610f\u601d\u4ec5\u4ec5\u662f\u8bf4\u5728\u5355\u4f4d\u65f6\u95f4\u5185\u901a\u8fc7\u7535\u8def\u7684\u7535\u8377\u591a.\n\u201c*\u5f31\u7535\u6d41*\u201d\u5219\u662f\u8bf4\u5728\u5355\u4f4d\u65f6\u95f4\u5185\u901a\u8fc7\u7535\u8def\u7684\u7535\u8377\u5c11.\n\n\u73b0\u5728\u6211\u4eec\u53ef\u4ee5\u8bb2\uff0c\u7535\u6d41\u7684\u5404\u79cd\u6548\u5e94\u7684\u5f3a\u5f31\u7a0b\u5ea6\u662f\u4e0e\u7535\u6d41\u5f3a\u5ea6\u6709\u5173\u7684."
    },
    {
      "block": 10,
      "text": "\u5728\u7531\u7535\u6e90\u53ca\u9996\u5c3e\u76f8\u63a5\u7684\u4e00\u4e32\u5bfc\u4f53(\u53c2\u770b\u56fe $268$)\u6240\u7ec4\u6210\u7684\u7b80\u5355\u7535\u8def\u4e2d\uff0c\u5404\u5904\u7684\u7535\u6d41\u5f3a\u5ea6\u90fd\u662f\u76f8\u7b49\u7684.\n\u8fd9\u4e00\u7ed3\u8bba\u662f\u6839\u636e\u4e0b\u9762\u7684\u7406\u7531\u5f97\u51fa\u6765\u7684.\n\u5f53\u7535\u6d41\u7a33\u5b9a\u65f6\uff0c\u5728\u5355\u4f4d\u65f6\u95f4\u5185\u901a\u8fc7\u7535\u8def\u4e2d\u5bfc\u4f53\u7684\u4efb\u4f55\u4e00\u4e2a\u622a\u9762\u5904\u7684\u7535\u91cf\u90fd\u76f8\u7b49.\n\n\u5bf9\u4e8e\u7a33\u5b9a\u7684\u7535\u6d41\uff0c\u7535\u8def\u91cc\u7684\u7535\u8377\u5728\u5bfc\u4f53\u4e2d\u7684\u4efb\u4f55\u5730\u65b9\u4e5f\u4e0d\u4f1a\u79ef\u5b58\u8d77\u6765.\n\u7535\u8def\u4e2d\u7684\u7a33\u5b9a\u7535\u6d41\u662f\u53ef\u4ee5\u548c\u6c34\u7ba1\u4e2d\u7684\u6c34\u6d41\u7c7b\u6bd4\u7684\uff1b\n\u4e00\u4e9b\u5bfc\u4f53\u8c61\u56fe 268 \u6240\u793a\u7684\u90a3\u6837\u8fde\u63a5\u8d77\u6765\uff0c\u53eb\u505a**\u4e32\u8054**.\n\n\u5173\u4e8e\u8fd9\u4e2a\u95ee\u9898\u5728 \u00a7 142 \u4e2d\u6211\u4eec\u8fd8\u8981\u8be6\u7ec6\u7814\u7a76."
    }
  ],
