  },
  "exercises": [
    {
      "number": "2",
      "text": "\uff082\uff09\u4e3e\u4f8b\u8bf4\u660e\uff0c\u600e\u6837\u8ba1\u7b97\u6e29\u5ea6\u5347\u9ad8\uff08\u6216\u964d\u4f4e\uff09\u7684\u8fc7\u7a0b\u4e2d\u7269\u4f53\u6240\u5438\u6536\uff08\u6216\u653e\u51fa\uff09\u7684\u70ed\u91cf.",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u8bd5\u5199\u51fa\u8ba1\u7b97\u70ed\u91cf\u7684\u516c\u5f0f.",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u4ece\u51b7\u3001\u70ed\u6c34\u76f8\u6df7\u5408\u7684\u5b9e\u9a8c\u4e2d\uff0c\u80fd\u5f97\u51fa\u4ec0\u4e48\u7ed3\u8bba\u6765\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u5728\u52a0\u70ed\u60c5\u51b5\u76f8\u540c\u7684\u6761\u4ef6\u4e0b\uff0c\u6bd4\u70ed\u8868\uff08\u89c1\u7b2c230\u9875\uff09\u6240\u5217\u7684\u6db2\u4f53\u4e2d\u54ea\u4e00\u79cd\u6e29\u5ea6\u4e0a\u5347\u5f97\u6700\u5feb\uff1f",
      "figure_ids": [
        "tbl-p0241-01"
      ]
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u4e3a\u4ec0\u4e48\u5728\u5404\u79cd\u6db2\u4f53\u4e2d\uff0c\u6c34\u6700\u9002\u5b9c\u505a\u51b7\u5374\u5242\uff08\u4f8b\u5982\uff0c\u7528\u6765\u51b7\u5374\u5185\u71c3\u673a\uff09\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-4",
      "text": "\uff084\uff09\u8bd5\u8ba1\u7b97\u4e3a\u4f7f$\\text{\\textcircled{1}}$ \u8d28\u91cf\u4e3a1.5\u5343\u514b\u7684\u94f8\u94c1\u71a8\u6597\u7684\u6e29\u5ea6\u5347\u9ad8$200^\\circ\\mathrm{C}$\uff1b$\\text{\\textcircled{2}}$ \u8d28\u91cf\u4e3a50\u514b\u7684\u94dd\u5319\u7684\u6e29\u5ea6\u4ece$20^\\circ\\mathrm{C}$\u5347\u9ad8\u5230$90^\\circ\\mathrm{C}$\uff0c$\\text{\\textcircled{3}}$ \u8d28\u91cf\u4e3a2\u5428\u7684\u7816\u780c\u7684\u706b\u7095\u7684\u6e29\u5ea6\u4ece$10^\\circ\\mathrm{C}$\u5347\u9ad8\u5230$60^\\circ\\mathrm{C}$\uff0c\u5404\u9700\u591a\u5c11\u70ed\u91cf\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u4e3a\u4e86\u8ba1\u7b97\u70ed\u91cf\u5fc5\u9700\u77e5\u9053\u7ec4\u6210\u7269\u4f53\u7684\u7269\u8d28\u7684\u6bd4\u70ed\uff0c\u8fd9\u4e2a\u7269\u4f53\u7684\u8d28\u91cf\u4ee5\u53ca\u8fd9\u4e2a\u7269\u4f53\u5728\u5f00\u59cb\u65f6\u7684\u6e29\u5ea6\u548c\u7ec8\u4e86\u65f6\u7684\u6e29\u5ea6\u4e4b\u5dee."
    },
    {
      "block": 7,
      "text": "\u53ef\u89c1\uff0c**\u8981\u8ba1\u7b97\u4f7f\u7269\u4f53\u6e29\u5ea6\u5347\u9ad8\u6240\u9700\u8981\u7684\u70ed\u91cf\uff0c\u53ea\u9700\u5c06\u6bd4\u70ed\u4e58\u4ee5\u8be5\u7269\u4f53\u7684\u8d28\u91cf\u4ee5\u53ca\u8be5\u7269\u4f53\u5728\u7ec8\u4e86\u65f6\u548c\u5f00\u59cb\u65f6\u7684\u6e29\u5ea6\u4e4b\u5dee.**"
    },
    {
      "block": 8,
      "text": "\u8fd9\u4e00\u89c4\u5f8b\u53ef\u4ee5\u7528\u516c\u5f0f\u8868\u793a.\n\u5f15\u7528\u7b26\u53f7\uff1a\n$Q$\u2014\u2014\u70ed\u91cf\uff0c$c$\u2014\u2014\u7269\u8d28\u7684\u6bd4\u70ed\uff0c$m$\u2014\u2014\u7269\u4f53\u7684\u8d28\u91cf\uff0c$t_1$\u2014\u2014\u7269\u4f53\u7684\u521d\u6e29\u5ea6\uff0c$t_2$\u2014\u2014\u7269\u4f53\u7684\u672b\u6e29\u5ea6\uff0c\u5219\u6709"
    },
    {
      "block": 9,
      "text": "$Q=cm(t_2-t_1)$."
    },
    {
      "block": 18,
      "text": "\u6211\u4eec\u770b\u5230\uff0c**\u70ed\u6c34\u6240\u653e\u51fa\u7684\u70ed\u91cf\u4e0e\u51b7\u6c34\u6240\u5438\u6536\u7684\u70ed\u91cf\u662f\u5f7c\u6b64\u76f8\u7b49\u7684**.\n\u5b9e\u9a8c\u8868\u660e\uff0c**\u7269\u4f53\u95f4\u82e5\u53d1\u751f\u4e86\u70ed\u4ea4\u6362\uff0c\u5219\u6240\u6709\u6e29\u5ea6\u5347\u9ad8\u4e86\u7684\u7269\u4f53\u589e\u52a0\u7684\u5185\u80fd\uff0c\u7b49\u4e8e\u6240\u6709\u6e29\u5ea6\u964d\u4f4e\u4e86\u7684\u7269\u4f53\u51cf\u5c11\u7684\u5185\u80fd**."
    },
    {
      "block": 19,
      "text": "\u4e0d\u8fc7\uff0c\u82e5\u662f\u5728\u51b7\u3001\u70ed\u6c34\u6df7\u5408\u7684\u5b9e\u9a8c\u4e2d\uff0c\u628a\u6d4b\u91cf\u8fdb\u884c\u5f97\u7cbe\u786e\u4e9b\uff0c\u90a3\u4e48\u5c31\u4f1a\u53d1\u73b0\u6240\u653e\u51fa\u7684\u80fd\u91cf\u4e0e\u6240\u5438\u6536\u7684\u80fd\u91cf\u5e76\u4e0d\u5b8c\u5168\u76f8\u7b49.\n\u539f\u56e0\u662f\u5728\u5b9e\u9a8c\u8fc7\u7a0b\u4e2d\uff0c\u4e00\u90e8\u5206\u80fd\u91cf\u4f20\u9012\u7ed9\u4e86\u5bb9\u5668\u53ca\u5468\u56f4\u7684\u7a7a\u6c14.\n\u5728\u5b9e\u9a8c\u8fc7\u7a0b\u4e2d\u4ea7\u751f\u7684\u70ed\u91cf\u635f\u5931\u8d8a\u5c11\uff0c\u5219\u653e\u51fa\u7684\u70ed\u91cf\u4e0e\u5438\u6536\u7684\u70ed\u91cf\u4e4b\u95f4\u7684\u5dee\u522b\u5c31\u8d8a\u5c0f."
    }
  ],
