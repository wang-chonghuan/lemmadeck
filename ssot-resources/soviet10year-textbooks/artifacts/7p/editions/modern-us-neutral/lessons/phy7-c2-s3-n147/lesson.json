      "historical_entities": []
    },
    {
      "kind": "cap",
      "text": "**詹姆斯·普雷斯科特·焦耳**（1818至1889），英国物理学家。\n他通过实验研究能量守恒，并在与楞次互不相知的情况下发现了电流热效应的规律。",
      "id": null,
      "label": "焦耳肖像",
      "printed_page": 363,
      "source_refs": [
        "p0374#3"
      ],
      "source_text": "**詹姆斯·普雷斯科特·焦耳**（1818—1889）——英国物理学家. 他曾用实验证明了能量守恒定律，在与楞次互不相知的情况下发现了决定电流热效应的规律.",
      "changes": [
        "clarify",
        "layout"
      ],
      "numeric_changes": [],
      "historical_entities": [
        {
          "term": "焦耳",
          "reason": "p0374#3肖像图题的真实科学家，保留原身份和生卒年。"
        },
        {
          "term": "楞次",
          "reason": "p0374#3记载两位科学家独立研究的关系。"
        },
        {
          "term": "英国",
          "reason": "p0374#3记载真实科学家的历史归属。"
        }
      ]
    },
    {
      "kind": "cap",
      "text": "**爱弥里·赫里斯齐安诺维奇·楞次**（1804至1865），俄国物理学家、电工学奠基人之一。\n电流热效应的规律和确定感应电流方向的规律，都与他的研究相联系。",
      "id": null,
      "label": "楞次肖像",
      "printed_page": 363,
      "source_refs": [
        "p0374#4",
        "p0374#5"
      ],
      "source_text": "**爱弥里·赫里斯齐安诺维奇****·楞次**（1804—1865）——俄国物理学家、电工学奠基人之一. 决定电流热效应的定律及确定感生电流方向的定律的发现都是和他的名字联系在一起的.",
      "changes": [
        "clarify",
        "layout"
      ],
      "numeric_changes": [],
      "historical_entities": [
        {
          "term": "楞次",
          "reason": "p0374#4及p0374#5肖像图题的真实科学家，保留原身份和生卒年。"
        },
        {
          "term": "俄国",
          "reason": "同一来源肖像图题记载真实科学家的历史归属。"
        }
      ]
