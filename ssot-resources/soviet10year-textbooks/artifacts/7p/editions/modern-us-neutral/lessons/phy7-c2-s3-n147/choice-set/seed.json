    "lesson": "phy7-c2-s3-n147",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "(1) \u600e\u6837\u89e3\u91ca\u7535\u6d41\u4f7f\u5bfc\u4f53\u53d8\u70ed\u7684\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "(2) \u5728\u9759\u6b62\u7684\u7eaf\u7535\u963b\u5bfc\u4f53\u4e2d\uff0c\u7535\u538b\u548c\u7535\u6d41\u4fdd\u6301\u4e0d\u53d8\u65f6\uff0c\u7528\u4ec0\u4e48\u516c\u5f0f\u8ba1\u7b97\u7535\u6d41\u4ea7\u751f\u7684\u70ed\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "(3) \u5bf9\u9075\u5b88\u6b27\u59c6\u5b9a\u5f8b\u7684\u5bfc\u4f53\uff0c\u600e\u6837\u5229\u7528\u6b27\u59c6\u5b9a\u5f8b\uff0c\u628a\u7535\u6d41\u4ea7\u751f\u7684\u70ed\u91cf\u7528\u7535\u6d41\u3001\u7535\u963b\u548c\u901a\u7535\u65f6\u95f4\u8868\u793a\uff1f\n\u5199\u51fa\u4ee3\u6362\u548c\u6574\u7406\u7684\u8fc7\u7a0b\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "(4) \u600e\u6837\u8868\u8ff0\u7126\u8033-\u695e\u6b21\u5b9a\u5f8b\uff1f\n\u6bd4\u8f83\u5404\u7269\u7406\u91cf\u5bf9\u70ed\u91cf\u7684\u5f71\u54cd\u65f6\uff0c\u9700\u8981\u4fdd\u6301\u54ea\u4e9b\u6761\u4ef6\u4e0d\u53d8\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "(1) \u7535\u963b\u4e1d\u7684\u7535\u963b\u4e3a $20$ \u6b27\u59c6\uff0c\u901a\u8fc7\u7684\u7535\u6d41\u4e3a $5$ \u5b89\u57f9\u3002\n\u5047\u8bbe\u901a\u7535\u671f\u95f4\u7535\u6d41\u548c\u7535\u963b\u4fdd\u6301\u4e0d\u53d8\uff0c\u5728 $30$ \u5206\u949f\u5185\u4ea7\u751f\u591a\u5c11\u70ed\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "(2) \u5bfc\u7ebf\u63a5\u5934\u4e0d\u80fd\u53ea\u7b80\u5355\u626d\u63a5\uff0c\u8fd8\u9700\u8981\u7262\u9760\u8fde\u63a5\uff1b\u539f\u4e66\u4ee5\u710a\u7262\u4e3a\u4f8b\u3002\n\u8bf4\u660e\u8fd9\u6837\u505a\u7684\u76ee\u7684\u548c\u7269\u7406\u4f9d\u636e\u3002\n\u8fd9\u91cc\u53ea\u5206\u6790\u539f\u7406\uff0c\u4e0d\u81ea\u884c\u710a\u63a5\u3001\u62c6\u88c5\u4f9b\u7535\u7535\u8def\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "(3) \u5982\u679c\u6ca1\u6709\u5148\u5207\u65ad\u7535\u6e90\uff0c\u5c31\u628a\u6d78\u5165\u5f0f\u7535\u70ed\u716e\u6c34\u5668\u4ece\u6c34\u4e2d\u53d6\u51fa\uff0c\u5b83\u53ef\u80fd\u5f88\u5feb\u70e7\u574f\u3002\n\u8bf4\u660e\u539f\u56e0\u3002\n\u8fd9\u662f\u6545\u969c\u60c5\u5883\u5206\u6790\uff0c\u4e0d\u8981\u8fdb\u884c\u5e26\u7535\u79bb\u6c34\u5b9e\u9a8c\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-4",
      "text": "(4) \u94dc\u3001\u94a2\u548c\u94dc\u954d\u5408\u91d1\u5236\u6210\u7684\u4e09\u6761\u5bfc\u7ebf\uff0c\u957f\u5ea6\u548c\u6a2a\u622a\u9762\u79ef\u90fd\u76f8\u540c\uff0c\u4e32\u8054\u63a5\u5165\u7535\u8def\u3002\n\u5728\u540c\u4e00\u6bb5\u901a\u7535\u65f6\u95f4\u5185\uff0c\u54ea\u4e00\u6761\u5bfc\u7ebf\u4ea7\u751f\u7684\u70ed\u91cf\u6700\u591a\uff1f\n\u8bf4\u660e\u7406\u7531\uff0c\u5e76\u5728\u6761\u4ef6\u5141\u8bb8\u65f6\uff0c\u7531\u6559\u5e08\u7528\u9002\u5408\u8bfe\u5802\u7684\u4f4e\u7535\u538b\u88c5\u7f6e\u6f14\u793a\u9a8c\u8bc1\u3002\n\u4e0d\u8981\u81ea\u884c\u8fde\u63a5\u5bb6\u5ead\u7535\u6e90\u6216\u89e6\u6478\u901a\u7535\u3001\u53d1\u70ed\u7684\u5bfc\u7ebf\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u7535\u6d41\u901a\u8fc7\u5bfc\u4f53\u65f6\uff0c\u5bfc\u4f53\u53ef\u80fd\u53d8\u70ed\u3002\n\u91d1\u5c5e\u4e2d\u7684\u81ea\u7531\u7535\u5b50\u6216\u7535\u89e3\u8d28\u4e2d\u7684\u79bb\u5b50\u5728\u7535\u573a\u4f5c\u7528\u4e0b\u5b9a\u5411\u79fb\u52a8\uff0c\u4e0e\u6784\u6210\u5bfc\u4f53\u7684\u7c92\u5b50\u76f8\u4e92\u4f5c\u7528\uff0c\u628a\u7535\u80fd\u8f6c\u5316\u4e3a\u5185\u80fd\u3002\n\u4e0b\u9762\u8ba8\u8bba\u91d1\u5c5e\u5bfc\u4f53\u7684\u7535\u6d41\u70ed\u6548\u5e94\u3002"
    },
    {
      "block": 1,
      "text": "\u672c\u8bfe\u8ba8\u8bba\u9759\u6b62\u7684\u7eaf\u7535\u963b\u91d1\u5c5e\u5bfc\u4f53\uff0c\u4e0d\u5305\u62ec\u7535\u52a8\u673a\u505a\u673a\u68b0\u529f\u6216\u7535\u89e3\u69fd\u53d1\u751f\u5316\u5b66\u53d8\u5316\u7684\u60c5\u51b5\u3002\n**\u5728\u8fd9\u6837\u7684\u5bfc\u4f53\u4e2d\uff0c\u7535\u6d41\u6240\u505a\u7684\u529f\u8f6c\u5316\u4e3a\u5185\u80fd\uff0c\u4f7f\u5bfc\u4f53\u548c\u5468\u56f4\u7269\u4f53\u53d7\u70ed\u3002\n**\n\n\u8fd9\u91cc\u6cbf\u7528\u539f\u4e66\u7684\u201c\u4ea7\u751f\u7684\u70ed\u91cf\u201d\u8bf4\u6cd5\uff0c\u8868\u793a\u7535\u6d41\u8f6c\u5316\u4e3a\u5185\u80fd\u7684\u80fd\u91cf\u3002\n\u5b83\u4e0d\u4e00\u5b9a\u7b49\u4e8e\u5bfc\u4f53\u81ea\u8eab\u5185\u80fd\u7684\u589e\u52a0\u91cf\uff0c\u56e0\u4e3a\u5bfc\u4f53\u8fd8\u53ef\u80fd\u628a\u80fd\u91cf\u4f20\u7ed9\u5468\u56f4\u73af\u5883\u3002"
    },
    {
      "block": 2,
      "text": "\u5f53\u7535\u538b\u548c\u7535\u6d41\u5728\u8ba1\u65f6\u8fc7\u7a0b\u4e2d\u4fdd\u6301\u4e0d\u53d8\u65f6\uff0c\u7535\u529f\u7684\u8ba1\u7b97\u516c\u5f0f\u662f\uff1a"
    },
    {
      "block": 3,
      "text": "$A=UIt$\u3002\n\u5176\u4e2d A \u8868\u793a\u7535\u529f\uff0cU \u8868\u793a\u7535\u538b\uff0cI \u8868\u793a\u7535\u6d41\uff0ct \u8868\u793a\u901a\u7535\u65f6\u95f4\u3002"
    },
    {
      "block": 4,
      "text": "\u4ecd\u7528\u5b57\u6bcd $Q$ \u8868\u793a\u7535\u6d41\u4ea7\u751f\u7684\u70ed\u91cf\u3002\n\u5728\u4e0a\u8ff0\u7eaf\u7535\u963b\u6761\u4ef6\u4e0b\uff0c\u6709 $Q=$ $A$\uff0c\u6216 $Q=UIt$\u3002\n\u8ba1\u7b97\u65f6\u7535\u538b\u7528\u4f0f\u7279\u3001\u7535\u6d41\u7528\u5b89\u57f9\u3001\u65f6\u95f4\u7528\u79d2\uff0c\u6240\u5f97\u70ed\u91cf\u548c\u7535\u529f\u4e00\u6837\uff0c\u90fd\u7528\u7126\u8033\u8868\u793a\u3002"
    },
    {
      "block": 8,
      "text": "**\u7535\u6d41\u5728\u5bfc\u4f53\u4e2d\u4ea7\u751f\u7684\u70ed\u91cf\uff0c\u4e0e\u7535\u6d41\u5f3a\u5ea6\u7684\u5e73\u65b9\u3001\u5bfc\u4f53\u7684\u7535\u963b\u548c\u901a\u7535\u65f6\u95f4\u6210\u6b63\u6bd4\u3002\n**\n\u6bcf\u6b21\u6bd4\u8f83\u4e00\u4e2a\u91cf\u7684\u5f71\u54cd\u65f6\uff0c\u5176\u4f59\u6761\u4ef6\u8981\u4fdd\u6301\u4e0d\u53d8\u3002\n\n\u7528\u8fd9\u4e2a\u5f0f\u5b50\u8ba1\u7b97\u4e00\u6574\u6bb5\u65f6\u95f4\u7684\u70ed\u91cf\u65f6\uff0c\u7535\u6d41\u548c\u7535\u963b\u5e94\u4fdd\u6301\u4e0d\u53d8\uff0c\u6216\u5728\u8fd9\u6bb5\u65f6\u95f4\u5185\u53ef\u4ee5\u8fd1\u4f3c\u770b\u4f5c\u4e0d\u53d8\u3002\n\u7535\u963b\u53ef\u80fd\u968f\u6e29\u5ea6\u53d8\u5316\uff0c\u4e0d\u80fd\u53ea\u51ed\u201c\u7535\u963b\u8f83\u5927\u201d\u5c31\u65ad\u5b9a\u4efb\u610f\u7535\u8def\u4e2d\u7684\u53d1\u70ed\u91cf\u8f83\u591a\u3002"
    }
  ],
