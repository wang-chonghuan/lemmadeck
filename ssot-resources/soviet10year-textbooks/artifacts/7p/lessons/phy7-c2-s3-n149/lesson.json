    },
    {
      "kind": "cap",
      "text": "图 308",
      "id": null,
      "label": "图 308",
      "printed_page": 367,
      "source_refs": [
        "p0378#10"
      ]
    },
    {
      "kind": "p",
      "text": "图 $308$ 所示的是一个收音机中使用的熔断式保险器。沿着两端带有金属帽的玻璃管的轴线张着一根细导线。玻璃管则装在一个专用的支架上。",
      "id": null,
      "label": null,
      "printed_page": 367,
      "source_refs": [
        "p0378#11",
        "p0379#1"
      ]
    }
  ]
