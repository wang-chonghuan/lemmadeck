  "chapter": "热现象",
  "section": "热传递和功",
  "number": "82",
  "title": "机械能转化为内能",
  "printed_title": "82. 机械能转化为内能",
  "start_page": 216,
  "start_printed": 205,
  "figures": [
    {
      "id": "fig-208",
      "label": "图 208",
      "page": 217
