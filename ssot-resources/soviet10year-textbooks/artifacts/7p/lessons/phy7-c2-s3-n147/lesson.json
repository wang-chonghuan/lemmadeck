      "id": "tbl-p0374-02",
      "label": "楞次肖像",
      "printed_page": 363,
      "source_refs": [
        "p0374#2"
      ]
    },
    {
      "kind": "cap",
      "text": "**詹姆斯·普雷斯科特·焦耳**（1818—1889）——英国物理学家. 他曾用实验证明了能量守恒定律，在与楞次互不相知的情况下发现了决定电流热效应的规律.",
      "id": null,
      "label": "焦耳肖像",
      "printed_page": 363,
      "source_refs": [
        "p0374#3"
      ]
    },
    {
      "kind": "cap",
      "text": "**爱弥里·赫里斯齐安诺维奇****·楞次**（1804—1865）——俄国物理学家、电工学奠基人之一. 决定电流热效应的定律及确定感生电流方向的定律的发现都是和他的名字联系在一起的.",
      "id": null,
      "label": "楞次肖像",
      "printed_page": 363,
      "source_refs": [
        "p0374#4",
        "p0374#5"
      ]
    }
  ]
}
