      ]
    },
    {
      "kind": "p",
      "text": "在电解电容器中，由于减小了两极板间的距离，其电容显著地增大(图157). 在这种电容器中，敷在一个极板(金属箔片)上的一层很薄的氧化膜作为电介质. 浸过专门物质溶液(电解液)的纸作为第二个极板.",
      "id": null,
      "label": null,
      "printed_page": 195,
      "source_refs": [
        "p0204#6"
      ]
    },
    {
      "kind": "p",
      "text": "还有其他类型的电容器.",
      "id": null,
      "label": null,
      "printed_page": 195,
      "source_refs": [
        "p0204#7"
      ]
    }
  ]
}
