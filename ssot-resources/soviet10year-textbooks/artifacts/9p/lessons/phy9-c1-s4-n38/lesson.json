  "chapter": "第四章　液体和气体的相互转变",
  "section": null,
  "number": "38",
  "title": "真实气体的等温线",
  "printed_title": "38. 真实气体的等温线",
  "start_page": 94,
  "start_printed": 85,
  "figures": [
    {
      "id": "fig-54",
      "label": "图 54",
      "page": 95
    },
    {
      "id": "fig-55",
      "label": "图 55",
      "page": 97
