  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/9p/figures/fig-40.png",
      "sha256": "2a7e0f85afa53e71e7a7a6e12b0a78e16febd594b75def3bac08d486675ca44b"
