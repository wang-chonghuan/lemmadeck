  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/9p/figures/fig-69.png",
      "sha256": "97a5e500dee96e9d4924b11a6d44a6896fa6ea1ef4214cea8fb468a9b074fedb"
