  },
  "exercises": [
    {
      "number": "1",
      "text": "\u5728\u76f8\u540c\u6e29\u5ea6\u3001\u540c\u4e00\u79cd\u7269\u7406\u6027\u8d28\u548c\u76f8\u540c\u6d4b\u91cf\u6761\u4ef6\u4e0b\uff0c\u7269\u4f53\u7684\u6027\u8d28\u968f\u6d4b\u91cf\u65b9\u5411\u800c\u6539\u53d8\u3002\u4ec5\u51ed\u8fd9\u79cd\u5404\u5411\u5f02\u6027\uff0c\u80fd\u5426\u5224\u5b9a\u5b83\u4e00\u5b9a\u662f\u6676\u4f53\uff1f\n\u8ba8\u8bba\u65f6\u5e94\u533a\u5206\u5355\u6676\u3001\u6676\u7c92\u53d6\u5411\u968f\u673a\u6216\u5177\u6709\u62e9\u4f18\u53d6\u5411\u7684\u591a\u6676\uff0c\u4ee5\u53ca\u5185\u90e8\u7ed3\u6784\u6709\u65b9\u5411\u6027\u6216\u53d7\u529b\u7684\u975e\u6676\u6750\u6599\uff0c\u4e0d\u628a\u7269\u4f53\u7684\u5916\u90e8\u5f62\u72b6\u5dee\u5f02\u5f53\u4f5c\u5185\u90e8\u6676\u4f53\u7ed3\u6784\u7684\u5224\u636e\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u5047\u8bbe\u73bb\u7483\u6539\u4e3a\u4e00\u79cd\u5177\u6709\u660e\u786e\u7194\u70b9\u3001\u5728\u7194\u70b9\u4ee5\u4e0b\u4e0d\u51fa\u73b0\u901a\u5e38\u73bb\u7483\u90a3\u6837\u8fde\u7eed\u8f6f\u5316\u533a\u95f4\u7684\u6676\u4f53\u6750\u6599\u3002\u662f\u5426\u5c31\u4e00\u5b9a\u4e0d\u5b58\u5728\u5439\u73bb\u7483\u8fd9\u4e00\u804c\u4e1a\uff1f\n\u8ba8\u8bba\u65f6\u533a\u5206\u8f6f\u5316\u72b6\u6001\u4e0b\u7684\u52a0\u5de5\u4e0e\u7194\u5316\u540e\u7684\u6db2\u6001\u52a0\u5de5\uff1b\u4ec5\u7ed9\u51fa\u201c\u6676\u4f53\u201d\u8fd9\u4e00\u5206\u7c7b\uff0c\u5e76\u672a\u6307\u5b9a\u7194\u4f53\u9ecf\u5ea6\u3001\u7ed3\u6676\u901f\u5ea6\u6216\u5439\u5236\u540e\u4fdd\u6301\u5f62\u72b6\u7684\u6761\u4ef6\u3002\u6b64\u9898\u53ea\u4f5c\u6750\u6599\u52a0\u5de5\u7684\u5047\u8bbe\u8ba8\u8bba\uff0c\u4e0d\u8fdb\u884c\u9ad8\u6e29\u5439\u5236\u64cd\u4f5c\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u901a\u5e38\u5ba4\u6e29\u4e0b\u7684\u56fa\u6001\u98df\u7cd6\u3001\u7425\u73c0\u548c\u94dd\uff0c\u5206\u522b\u5c5e\u4e8e\u6676\u4f53\u8fd8\u662f\u975e\u6676\u4f53\uff1f\n\u6309\u5e38\u89c1\u6837\u54c1\u8ba8\u8bba\uff0c\u5176\u4e2d\u98df\u7cd6\u6307\u666e\u901a\u9897\u7c92\u72b6\u6837\u54c1\uff0c\u4e0d\u5305\u62ec\u7279\u6b8a\u5236\u5907\u7684\u73bb\u7483\u6001\u7cd6\uff1b\u6676\u4f53\u8fd9\u4e00\u7c7b\u522b\u5305\u62ec\u5355\u6676\u548c\u591a\u6676\uff0c\u4e0d\u4ee5\u6837\u54c1\u6709\u65e0\u5b8c\u6574\u7684\u5916\u90e8\u6676\u9762\u4f5c\u4e3a\u552f\u4e00\u5224\u636e\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\u98df\u76d0\u6676\u4f53\u7531\u4ea4\u66ff\u6392\u5217\u7684\u94a0\u79bb\u5b50\u548c\u6c2f\u79bb\u5b50\u7ec4\u6210\uff0c\u5916\u90e8\u5e38\u5448\u7acb\u65b9\u4f53\u5f62\u72b6\uff0c\u53c2\u9605\u56fe77\u3002\u8be5\u56fe\u53ea\u793a\u610f\u6676\u4f53\u7684\u5916\u90e8\u5916\u89c2\uff0c\u4e0d\u63d0\u4f9b\u79bb\u5b50\u4f4d\u7f6e\u6216\u8ddd\u79bb\u523b\u5ea6\u3002\n\u672c\u9898\u91c7\u7528\u7406\u60f3\u5ca9\u76d0\u7ed3\u6784\u6a21\u578b\uff1a\u5c06\u4e24\u7c7b\u79bb\u5b50\u7684\u5168\u90e8\u4e2d\u5fc3\u770b\u4f5c\u7b49\u95f4\u8ddd\u7684\u4e09\u7ef4\u7b80\u5355\u7acb\u65b9\u4f4d\u70b9\uff0c\u6cbf\u5404\u6761\u7acb\u65b9\u8f74\u65b9\u5411\u4ea4\u66ff\u653e\u7f6e\u94a0\u79bb\u5b50\u548c\u6c2f\u79bb\u5b50\uff1b\u4e24\u7c7b\u4f4d\u70b9\u5206\u522b\u7ec4\u6210\u4e92\u76f8\u7a7f\u63d2\u7684\u9762\u5fc3\u7acb\u65b9\u5b50\u6676\u683c\u3002\u6c42\u6700\u8fd1\u76f8\u90bb\u7684\u5f02\u79cd\u79bb\u5b50\u4e2d\u5fc3\u4e4b\u95f4\u7684\u5e73\u5747\u8ddd\u79bb\uff0c\u4e0d\u6c42\u4efb\u610f\u4e24\u4e2a\u79bb\u5b50\u4e4b\u95f4\u7684\u5e73\u5747\u8ddd\u79bb\u3002\n\u98df\u76d0\u7684\u6469\u5c14\u8d28\u91cf\u4e3a0.058\u5343\u514b/\u6469\u5c14\uff0c\u5bc6\u5ea6\u4e3a2200\u5343\u514b/\u7c73$^3$\u3002\u6469\u5c14\u8d28\u91cf\u5bf9\u5e94\u5316\u5b66\u5f0f\u5355\u4f4d\uff0c\u6bcf\u4e2a\u5316\u5b66\u5f0f\u5355\u4f4d\u542b\u4e00\u4e2a\u94a0\u79bb\u5b50\u548c\u4e00\u4e2a\u6c2f\u79bb\u5b50\uff1b\u56e0\u6b64\u5355\u4f4d\u4f53\u79ef\u5185\u7684\u79bb\u5b50\u603b\u6570\uff0c\u7b49\u4e8e\u5bc6\u5ea6\u4e58\u963f\u4f0f\u4f3d\u5fb7\u7f57\u5e38\u91cf\u3001\u9664\u4ee5\u6469\u5c14\u8d28\u91cf\u540e\u6240\u5f97\u7ed3\u679c\u7684\u4e24\u500d\u3002\u6b64\u7ed3\u6784\u548c\u8ba1\u6570\u6761\u4ef6\u662f\u9898\u8bbe\u6a21\u578b\uff0c\u4e0d\u662f\u4ece\u5916\u89c2\u56fe\u4e2d\u8bfb\u51fa\u7684\u6d4b\u91cf\u6570\u636e\u3002",
      "figure_ids": [
        "fig-77"
      ]
    },
    {
      "number": "5",
      "text": "\u6309\u5706\u5f62\u622a\u9762\u4e0a\u8f74\u5411\u5e94\u529b\u5747\u5300\u3001\u5ffd\u7565\u68d2\u7684\u81ea\u91cd\u7684\u6a21\u578b\u8ba1\u7b97\u3002\u8981\u4f7f\u68d2\u4e2d\u7684\u5e94\u529b\u8fbe\u5230$15\\times10^7$\u725b\u987f/\u7c73$^2$\uff0c\u6cbf\u8f74\u7ebf\u65bd\u52a0\u7684\u9759\u6001\u4f5c\u7528\u529b\u5e94\u5f53\u591a\u5927\uff1f\n\u8f7d\u8377\u901a\u8fc7\u622a\u9762\u4e2d\u5fc3\uff0c\u4e0d\u8003\u8651\u5f2f\u66f2\uff1b\u68d2\u7684\u76f4\u5f84\u4e3a0.4\u5398\u7c73\u3002",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "6. \u4e00\u9762\u7ad6\u76f4\u7816\u5899\u9ad820\u7c73\u3002\u6309\u5899\u4f53\u5bc6\u5ea6\u5747\u5300\u3001\u6a2a\u622a\u9762\u79ef\u4e0d\u968f\u9ad8\u5ea6\u6539\u53d8\u4e14\u53ea\u53d7\u81ea\u8eab\u91cd\u529b\u7684\u6a21\u578b\uff0c\u5899\u5e95\u5bf9\u5730\u57fa\u4ea7\u751f\u591a\u5927\u7684\u5e73\u5747\u538b\u5e94\u529b\uff1f\n\u7816\u7684\u5bc6\u5ea6\u4e3a1800\u5343\u514b/\u7c73$^3$\uff0c\u5ffd\u7565\u7802\u6d46\u3001\u5916\u52a0\u8f7d\u8377\u548c\u5730\u57fa\u6c89\u964d\u7b49\u5f71\u54cd\u3002\u82e5\u6839\u636e\u5404\u5904\u627f\u53d7\u4e0a\u65b9\u5899\u4f53\u91cd\u91cf\u7684\u8981\u6c42\u9009\u62e9\u7816\u6750\uff0c\u5899\u5e95\u4e0e\u5899\u4e0a\u90e8\u6240\u9700\u7684\u6297\u538b\u5f3a\u5ea6\u662f\u5426\u5fc5\u987b\u76f8\u540c\uff1f\u672c\u9898\u53ea\u6bd4\u8f83\u627f\u8f7d\u6761\u4ef6\uff0c\u4e0d\u4f5c\u4e3a\u5efa\u7b51\u8bbe\u8ba1\u4f9d\u636e\u3002",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "7. \u5747\u5300\u94a2\u4e1d\u7684\u4e0a\u7aef\u56fa\u5b9a\uff0c\u4e0b\u7aef\u81ea\u7531\u7ad6\u76f4\u60ac\u6302\uff0c\u4e0d\u6302\u5176\u4ed6\u91cd\u7269\u3002\u6309\u6a2a\u622a\u9762\u79ef\u6052\u5b9a\u3001\u4ec5\u53d7\u81ea\u8eab\u91cd\u529b\u4e14\u5ffd\u7565\u7f3a\u9677\u548c\u632f\u52a8\u7684\u7406\u60f3\u6a21\u578b\uff0c\u94a2\u4e1d\u81f3\u5c11\u591a\u957f\u624d\u4f1a\u8fbe\u5230\u62c9\u65ad\u6761\u4ef6\uff1f\n\u94a2\u7684\u6297\u62c9\u5f3a\u5ea6\u6781\u9650\u4e3a$3.2\\times10^8$\u725b\u987f/\u7c73$^2$\uff0c\u5bc6\u5ea6\u4e3a7800\u5343\u514b/\u7c73$^3$\u3002\u6b64\u9898\u662f\u7406\u8bba\u4f30\u7b97\uff0c\u4e0d\u8fdb\u884c\u60ac\u6302\u957f\u94a2\u4e1d\u6216\u62c9\u65ad\u5b9e\u9a8c\u3002",
      "figure_ids": []
    },
    {
      "number": "8",
      "text": "8. \u4e00\u6839\u5747\u5300\u5bfc\u7ebf\u957f5\u7c73\uff0c\u6a2a\u622a\u9762\u79ef\u4e3a2.5\u6beb\u7c73$^2$\u3002\u6cbf\u8f74\u7ebf\u65bd\u52a0100\u725b\u987f\u7684\u9759\u6001\u62c9\u529b\u540e\uff0c\u5bfc\u7ebf\u4f38\u957f1\u6beb\u7c73\u3002\n\u5047\u8bbe\u53d8\u5f62\u5904\u4e8e\u7ebf\u6027\u5f39\u6027\u8303\u56f4\uff0c\u8f7d\u8377\u901a\u8fc7\u622a\u9762\u4e2d\u5fc3\uff0c\u5ffd\u7565\u81ea\u91cd\u548c\u6e29\u5ea6\u53d8\u5316\u3002\u6c42\u5bfc\u7ebf\u7684\u5e94\u529b\u548c\u6768\u6c0f\u6a21\u91cf\u3002",
      "figure_ids": []
    },
    {
      "number": "9",
      "text": "9. \u5728\u7406\u60f3\u80fd\u91cf\u8f6c\u5316\u6a21\u578b\u4e2d\uff0c\u5b50\u5f39\u649e\u5230\u5899\u58c1\u540e\u505c\u6b62\uff0c\u5168\u90e8\u521d\u59cb\u52a8\u80fd\u53ea\u7528\u4e8e\u5b50\u5f39\u81ea\u8eab\u5347\u6e29\u548c\u7194\u5316\uff0c\u4e0d\u5411\u5899\u58c1\u6216\u73af\u5883\u4f20\u70ed\uff0c\u4e5f\u4e0d\u8ba1\u5176\u4ed6\u80fd\u91cf\u53bb\u5411\u3002\u8981\u4f7f\u5b50\u5f39\u6070\u597d\u5b8c\u5168\u7194\u5316\uff0c\u649e\u51fb\u524d\u7684\u901f\u5ea6\u5e94\u5f53\u591a\u5927\uff1f\n\u5b50\u5f39\u6750\u6599\u7684\u7194\u70b9\u4e3a$600\\text{K}$\uff0c\u6bd4\u70ed\u5bb9\u4e3a125\u7126\u8033/(\u5343\u514b\u00b7\u5ea6)\uff0c\u5355\u4f4d\u8d28\u91cf\u7194\u5316\u70ed\u4e3a$2.5\\times10^4$\u7126\u8033/\u5343\u514b\u3002\u5b50\u5f39\u649e\u51fb\u524d\u7684\u6e29\u5ea6\u4e3a$50^\\circ\\text{C}$\u3002\n\u5047\u8bbe\u6bd4\u70ed\u5bb9\u4e0d\u968f\u6e29\u5ea6\u53d8\u5316\uff1b\u6bd4\u70ed\u5bb9\u4e2d\u7684\u201c\u5ea6\u201d\u8868\u793a\u6444\u6c0f\u6e29\u5dee\uff0c\u5176\u6570\u503c\u4e0e\u5f00\u5c14\u6587\u6e29\u5dee\u76f8\u540c\uff0c\u5347\u6e29\u8ba1\u7b97\u987b\u5148\u7edf\u4e00\u6e29\u6807\u3002\u6b64\u9898\u4ec5\u4f5c\u7406\u8bba\u8ba1\u7b97\uff0c\u4e0d\u8fdb\u884c\u5c04\u51fb\u6216\u649e\u51fb\u5b9e\u9a8c\u3002",
      "figure_ids": []
    },
    {
      "number": "10",
      "text": "10. \u8981\u5c06\u8d28\u91cf\u4e3a0.2\u5343\u514b\u3001\u521d\u6e29\u4e3a$23^\\circ\\text{C}$\u7684\u6c34\u51b7\u5374\u5230$8^\\circ\\text{C}$\uff0c\u5411\u6c34\u4e2d\u52a0\u5165\u521d\u6e29\u4e3a$-3^\\circ\\text{C}$\u7684\u5c0f\u51b0\u5757\u3002\u9700\u8981\u52a0\u5165\u591a\u5c11\u8d28\u91cf\u7684\u51b0\uff1f\n\u5047\u8bbe\u5904\u4e8e\u901a\u5e38\u5927\u6c14\u538b\u4e0b\uff0c\u5bb9\u5668\u4e0e\u5916\u754c\u7edd\u70ed\uff0c\u5bb9\u5668\u81ea\u8eab\u5438\u653e\u70ed\u53ef\u4ee5\u5ffd\u7565\uff0c\u65e0\u84b8\u53d1\u6216\u6e85\u51fa\uff0c\u6700\u7ec8\u8fbe\u5230\u70ed\u5e73\u8861\u3002\u8ba1\u7b97\u9700\u8003\u8651\u51b0\u5347\u6e29\u3001\u7194\u5316\u548c\u7194\u5316\u540e\u7684\u6c34\u5347\u6e29\uff0c\u91c7\u7528\u672c\u7ae0\u7ed9\u51fa\u7684\u6bd4\u70ed\u5bb9\u4e0e\u7194\u5316\u70ed\u3002",
      "figure_ids": []
    },
    {
      "number": "11",
      "text": "11. \u4e00\u4e2a\u7edd\u70ed\u5bb9\u5668\u5185\u6709$0^\\circ\\text{C}$\u7684\u6c34\uff0c\u8d28\u91cf\u4e3a0.5\u5343\u514b\uff0c\u4ee5\u53ca$0^\\circ\\text{C}$\u7684\u51b0\uff0c\u8d28\u91cf\u4e3a54.4\u514b\u3002\u5411\u5176\u4e2d\u901a\u51656.6\u514b\u3001\u6e29\u5ea6\u4e3a$100^\\circ\\text{C}$\u7684\u6c34\u84b8\u6c14\u3002\u8fbe\u5230\u70ed\u5e73\u8861\u540e\uff0c\u5bb9\u5668\u5185\u7684\u6e29\u5ea6\u662f\u591a\u5c11\uff1f\n\u6309\u901a\u5e38\u5927\u6c14\u538b\u4e0b\u7684\u70ed\u91cf\u8861\u7b97\u6a21\u578b\uff0c\u5047\u8bbe\u901a\u5165\u7684\u84b8\u6c7d\u5168\u90e8\u51dd\u7ed3\u5e76\u7559\u5728\u5bb9\u5668\u4e2d\uff0c\u5ffd\u7565\u5bb9\u5668\u5438\u653e\u70ed\u3001\u4e0e\u5916\u754c\u7684\u70ed\u4ea4\u6362\u53ca\u5b8f\u89c2\u673a\u68b0\u80fd\u53d8\u5316\u3002\u91c7\u7528\u672c\u7ae0\u7ed9\u51fa\u7684\u6c34\u3001\u51b0\u7684\u6bd4\u70ed\u5bb9\u4ee5\u53ca\u7194\u5316\u70ed\u3001\u6c7d\u5316\u70ed\uff1b\u662f\u5426\u4ecd\u6709\u51b0\u5e94\u7531\u80fd\u91cf\u8861\u7b97\u5224\u65ad\uff0c\u4e0d\u9884\u8bbe\u51b0\u5df2\u5168\u90e8\u7194\u5316\u3002",
      "figure_ids": []
    }
  ],
