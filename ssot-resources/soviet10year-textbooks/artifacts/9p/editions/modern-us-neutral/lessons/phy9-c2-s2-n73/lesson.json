        },
        {
          "kind": "p",
          "text": "在路程 $\\Delta d=d_1-d_2$ 上，电场做正功",
          "id": null,
          "label": null,
          "printed_page": 173,
          "source_refs": [
            "p0182#3"
          ]
        },
        {
          "kind": "p",
          "text": "$A=qE(d_1-d_2)$. (8-20)",
          "id": null,
          "label": null,
          "printed_page": 173,
          "source_refs": [
            "p0182#4"
          ]
        },
        {
          "kind": "fig",
          "text": "",
