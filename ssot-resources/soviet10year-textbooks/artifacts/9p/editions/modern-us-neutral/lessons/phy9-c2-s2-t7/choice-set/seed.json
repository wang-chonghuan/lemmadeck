  "exercises": [
    {
      "number": "3",
      "text": "3. \u80f6\u6728\u68d2\u6469\u64e6\u540e\u5e26\u8d1f\u7535\u3002\u5728\u672c\u9898\u4e2d\uff0c\u9650\u5b9a\u8d77\u7535\u53ea\u6d89\u53ca\u68d2\u5438\u6536\u7535\u5b50\uff0c\u4e0d\u4e22\u5931\u788e\u5c51\u3001\u6c34\u5206\u6216\u5176\u4ed6\u7269\u8d28\uff0c\u4e5f\u4e0d\u8ba1\u5176\u4ed6\u80fd\u91cf\u53d8\u5316\u5bf9\u8d28\u91cf\u7684\u8d21\u732e\u3002\n\u6309\u5438\u6536\u7535\u5b50\u7684\u9759\u6b62\u8d28\u91cf\u4f5c\u8fd1\u4f3c\u6838\u7b97\uff0c\u68d2\u7684\u8d28\u91cf\u662f\u5426\u6539\u53d8\uff1f\u8fd9\u4e0d\u662f\u5bf9\u771f\u5b9e\u6469\u64e6\u540e\u79f0\u91cd\u7ed3\u679c\u7684\u666e\u904d\u5224\u65ad\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u5e26\u7535\u7684\u9a8c\u7535\u5668\u7ecf\u8fc7\u8f83\u957f\u65f6\u95f4\u540e\u6062\u590d\u5230\u4e0d\u5e26\u7535\u7684\u72b6\u6001\u3002\u8fd9\u662f\u5426\u610f\u5473\u7740\u7535\u8377\u6d88\u5931\u4e86\uff1f",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "7. \u82e5\u6c22\u539f\u5b50\u4e2d\u7684\u7535\u5b50\u4e0e\u539f\u5b50\u6838\u5728\u67d0\u4e00\u77ac\u65f6\u4f4d\u7f6e\u7684\u8ddd\u79bb\u4e3a$0.5\\times10^{-8}$\u5398\u7c73\uff0c\u6c42\u5b83\u4eec\u4e4b\u95f4\u7684\u9759\u7535\u76f8\u4e92\u4f5c\u7528\u529b\u3002\n\u628a\u7535\u5b50\u548c\u539f\u5b50\u6838\u89c6\u4e3a\u771f\u7a7a\u4e2d\u7684\u70b9\u7535\u8377\uff0c\u91c7\u7528\u7ecf\u5178\u5e93\u4ed1\u6a21\u578b\u4f5c\u4f30\u7b97\uff1b\u8fd9\u4e2a\u8ddd\u79bb\u4e0d\u8868\u793a\u7535\u5b50\u5177\u6709\u786e\u5b9a\u7684\u7ecf\u5178\u5706\u8f68\u9053\u3002",
      "figure_ids": []
    },
    {
      "number": "8",
      "text": "8. \u5047\u8bbe\u4e00\u4e2a\u6700\u521d\u4e2d\u6027\u3001\u8d28\u91cf\u4e3a0.03 \u514b\u7684\u6c34\u6ef4\uff0c\u628a\u5b83\u6240\u542b\u7535\u5b50\u76841%\u8f6c\u79fb\u7ed9\u53e6\u4e00\u4e2a\u6700\u521d\u4e2d\u6027\u7684\u6c34\u6ef4\u3002\u4e24\u6ef4\u7684\u7403\u5fc3\u76f8\u8ddd1 \u5343\u7c73\uff0c\u6c42\u5b83\u4eec\u4e4b\u95f4\u7684\u9759\u7535\u76f8\u4e92\u4f5c\u7528\u529b\u3002\n\u7535\u5b50\u6570\u6309\u4e2d\u6027\u6c34\u5206\u5b50\u7684\u5168\u90e8\u6838\u5916\u7535\u5b50\u8ba1\u7b97\uff0c\u91c7\u7528\u6c34\u7684\u6469\u5c14\u8d28\u91cf\u3001\u963f\u4f0f\u4f3d\u5fb7\u7f57\u5e38\u91cf\u548c\u57fa\u672c\u7535\u8377\u3002\n\u8fd9\u662f\u5047\u60f3\u7684\u70b9\u7535\u8377\u4f30\u7b97\uff1a\u5ffd\u7565\u7a7a\u6c14\u7684\u4ecb\u7535\u6548\u5e94\u3001\u7535\u8377\u6cc4\u6f0f\u3001\u7a7a\u6c14\u51fb\u7a7f\u548c\u6c34\u6ef4\u7834\u88c2\uff0c\u4e0d\u628a\u5982\u6b64\u5927\u91cf\u7684\u7535\u5b50\u8f6c\u79fb\u5f53\u4f5c\u53ef\u5b9e\u9645\u8fdb\u884c\u7684\u6c34\u6ef4\u5b9e\u9a8c\u3002",
      "figure_ids": []
    },
    {
      "number": "9",
      "text": "9. \u4e24\u4e2a\u76f8\u540c\u7684\u91d1\u5c5e\u5c0f\u7403\u6d78\u6ca1\u5728\u7164\u6cb9\u4e2d\uff0c\u7403\u5fc3\u76f8\u8ddd40 \u5398\u7c73\u3002\u4e00\u4e2a\u5c0f\u7403\u5e26\u7535$9\\times10^{-9}$\u5e93\u4ed1\uff0c\u53e6\u4e00\u4e2a\u5e26\u7535$2\\times10^{-9}$\u5e93\u4ed1\uff0c\u6240\u5217\u7535\u91cf\u5747\u4e3a\u6b63\u503c\u3002\u4f7f\u4e24\u7403\u76f8\u63a5\u89e6\uff0c\u5f85\u7535\u8377\u91cd\u65b0\u5206\u914d\u540e\uff0c\u518d\u5206\u5f00\u5230\u539f\u6765\u7684\u7403\u5fc3\u8ddd\u79bb\u3002\u6c42\u63a5\u89e6\u524d\u548c\u63a5\u89e6\u540e\u5b83\u4eec\u7684\u9759\u7535\u76f8\u4e92\u4f5c\u7528\u529b\u3002\n\u63a5\u89e6\u8fc7\u7a0b\u4e2d\u4e24\u7403\u7ec4\u6210\u7684\u7cfb\u7edf\u4e0d\u5411\u5916\u754c\u8f6c\u79fb\u7535\u8377\uff0c\u63a5\u89e6\u5e73\u8861\u65f6\u4e24\u7403\u6240\u5904\u73af\u5883\u5bf9\u79f0\u3002\u91c7\u7528\u5747\u5300\u3001\u7ebf\u6027\u3001\u5404\u5411\u540c\u6027\u7164\u6cb9\u4e2d\u7684\u70b9\u7535\u8377\u9759\u7535\u6a21\u578b\uff0c\u5ffd\u7565\u8fb9\u754c\u3001\u7403\u7684\u6709\u9650\u5c3a\u5bf8\u548c\u5c40\u57df\u6548\u5e94\u3002\n\u7164\u6cb9\u7684\u76f8\u5bf9\u4ecb\u7535\u5e38\u6570\u672a\u7ed9\u5b9a\uff0c\u7ed3\u679c\u4fdd\u7559\u4e3a\u5305\u542b\u8be5\u53c2\u6570\u7684\u8868\u8fbe\u5f0f\u3002",
      "figure_ids": []
    },
    {
      "number": "10",
      "text": "10. \u4e24\u4e2a\u70b9\u7535\u8377\u5206\u522b\u5e26\u7535$1.0\\times10^{-8}$\u5e93\u4ed1\u548c$2.0\\times10^{-8}$\u5e93\u4ed1\uff0c\u5728\u771f\u7a7a\u4e2d\u76f8\u8ddd1 \u7c73\u3002\u5728\u5b83\u4eec\u8fde\u7ebf\u7684\u4e2d\u70b9\u653e\u4e00\u4e2a\u5e26\u7535$3\\times10^{-9}$\u5e93\u4ed1\u7684\u5c0f\u7269\u4f53\u3002\n\u6240\u5217\u7535\u91cf\u5747\u4e3a\u6b63\u503c\uff0c\u5c0f\u7269\u4f53\u4e5f\u6309\u70b9\u7535\u8377\u5904\u7406\uff0c\u4e0d\u6539\u53d8\u539f\u6709\u4e24\u70b9\u7535\u8377\u7684\u4f4d\u7f6e\u3002\u6c42\u5c0f\u7269\u4f53\u6240\u53d7\u9759\u7535\u529b\u5408\u529b\u7684\u5927\u5c0f\u548c\u65b9\u5411\u3002",
      "figure_ids": []
    },
    {
      "number": "11",
      "text": "11. \u4e24\u4e2a\u76f8\u540c\u7684\u91d1\u5c5e\u5c0f\u7403\u5206\u522b\u7528\u957f1 \u7c73\u7684\u7ec6\u7ebf\u60ac\u6302\u5728\u540c\u4e00\u70b9\uff0c\u5e76\u6d78\u6ca1\u5728\u7164\u6cb9\u4e2d\u3002\u5f53\u6bcf\u4e2a\u5c0f\u7403\u5e26\u7535$3.0\\times10^{-7}$\u5e93\u4ed1\u65f6\uff0c\u4e24\u7403\u7403\u5fc3\u76f8\u8ddd0.4 \u7c73\u3002\u6c42\u6bcf\u6839\u7ec6\u7ebf\u7684\u5f20\u529b\u3002\n\u53d6\u4e24\u7403\u5728\u540c\u4e00\u9ad8\u5ea6\u3001\u7ec6\u7ebf\u4e0e\u7ad6\u76f4\u65b9\u5411\u5939\u89d2\u76f8\u540c\u7684\u5bf9\u79f0\u9759\u6b62\u5e73\u8861\u72b6\u6001\uff1b\u8003\u8651\u91cd\u529b\u3001\u6d6e\u529b\u3001\u7ec6\u7ebf\u62c9\u529b\u548c\u9759\u7535\u529b\uff0c\u5ffd\u7565\u7ec6\u7ebf\u8d28\u91cf\u3002\n\u91c7\u7528\u5747\u5300\u3001\u7ebf\u6027\u3001\u5404\u5411\u540c\u6027\u7164\u6cb9\u4e2d\u7684\u70b9\u7535\u8377\u9759\u7535\u6a21\u578b\uff0c\u5ffd\u7565\u8fb9\u754c\u3001\u7403\u7684\u6709\u9650\u5c3a\u5bf8\u548c\u5c40\u57df\u6548\u5e94\u3002\u7164\u6cb9\u7684\u76f8\u5bf9\u4ecb\u7535\u5e38\u6570\u672a\u7ed9\u5b9a\uff0c\u7ed3\u679c\u4fdd\u7559\u4e3a\u5305\u542b\u8be5\u53c2\u6570\u7684\u8868\u8fbe\u5f0f\u3002",
