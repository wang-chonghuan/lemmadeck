  "exercises": [
    {
      "number": "3",
      "text": "3. \u5728\u9898\u8bbe\u7684\u6e29\u5ea6\u548c\u91d1\u5c5e\u8868\u9762\u72b6\u6001\u4e0b\uff0c\u7194\u5316\u7684\u9521\u6d78\u6da6\u94dc\u3001\u94f6\u3001\u9ec4\u94dc\uff0c\u4e0d\u6d78\u6da6\u4e0d\u9508\u94a2\u3001\u94dd\u3001\u94ec\u3002\u4f9d\u636e\u8fd9\u4e00\u7ed9\u5b9a\u7684\u6d78\u6da6\u60c5\u5f62\uff0c\u4e0a\u8ff0\u91d1\u5c5e\u4e2d\u54ea\u4e9b\u5177\u5907\u7528\u9521\u710a\u63a5\u6240\u9700\u7684\u6d78\u6da6\u6761\u4ef6\uff1f\u672c\u9898\u4e0d\u628a\u9898\u8bbe\u5f53\u4f5c\u5404\u79cd\u8868\u9762\u5904\u7406\u548c\u6e29\u5ea6\u4e0b\u90fd\u6210\u7acb\u7684\u6750\u6599\u89c4\u5f8b\uff0c\u4e5f\u4e0d\u8981\u6c42\u5b9e\u9645\u710a\u63a5\u3002",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5. \u4ec5\u4f5c\u7406\u8bba\u5206\u6790\uff1a\u9898\u8bbe\u7ed9\u5b9a\uff0c\u6c7d\u6cb9\u4e2d\u7684\u6cb9\u8102\u6eb6\u6db2\u6bd4\u7eaf\u6c7d\u6cb9\u7684\u8868\u9762\u5f20\u529b\u7cfb\u6570\u5927\u3002\u5728\u6e29\u5ea6\u76f8\u540c\u3001\u6db2\u4f53\u80fd\u5728\u5e03\u4e0a\u5f62\u6210\u8fde\u901a\u6db2\u819c\u7684\u7406\u60f3\u60c5\u5f62\u4e2d\uff0c\u82e5\u8ba8\u8bba\u539f\u9898\u7684\u6c7d\u6cb9\u53bb\u6c61\u8fc7\u7a0b\uff0c\u5e94\u4ece\u6cb9\u6c61\u7684\u4e2d\u5fc3\u8fd8\u662f\u8fb9\u7f18\u6d78\u6da6\uff0c\u624d\u6709\u5229\u4e8e\u6cb9\u6c61\u5411\u5916\u8fc1\u79fb\uff1f\u4f9d\u636e\u9898\u8bbe\u7684\u8868\u9762\u5f20\u529b\u5dee\u5f02\u8bf4\u660e\u7406\u7531\uff0c\u4e0d\u5b9e\u9645\u4f7f\u7528\u6c7d\u6cb9\u8fdb\u884c\u53bb\u6c61\u6216\u5b9e\u9a8c\u3002",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "7. \u539f\u9898\u4ee5\u666e\u62c9\u6258\u5b9e\u9a8c\u4e3a\u80cc\u666f\uff1a\u9152\u7cbe\u6c34\u6eb6\u6db2\u4e2d\u6709\u4e00\u6ef4\u6a44\u6984\u6cb9\uff0c\u6cb9\u7684\u5bc6\u5ea6\u7b49\u4e8e\u6eb6\u6db2\u7684\u5bc6\u5ea6\u3002\u628a\u6cb9\u548c\u6eb6\u6db2\u89c6\u4e3a\u4e92\u4e0d\u76f8\u6eb6\uff0c\u6cb9\u6ef4\u4e0d\u63a5\u89e6\u5bb9\u5668\uff0c\u754c\u9762\u5f20\u529b\u5747\u5300\uff0c\u4e14\u5df2\u8fbe\u5230\u9759\u6b62\u5e73\u8861\u3002\u5728\u8fd9\u4e9b\u7406\u60f3\u6761\u4ef6\u4e0b\uff0c\u6cb9\u6ef4\u5728\u6eb6\u6db2\u4e2d\u662f\u4ec0\u4e48\u5f62\u72b6\uff1f\u8fd9\u91cc\u53ea\u5206\u6790\u8be5\u5386\u53f2\u5b9e\u9a8c\u7684\u6a21\u578b\uff0c\u4e0d\u8981\u6c42\u4eb2\u81ea\u64cd\u4f5c\u3002",
      "figure_ids": []
    },
    {
      "number": "8",
      "text": "8. \u4ec5\u4f5c\u7406\u8bba\u8ba8\u8bba\uff0c\u4e0d\u63a5\u89e6\u6216\u64cd\u4f5c\u6c34\u94f6\uff1a\u4e00\u4e9b\u521d\u59cb\u6e29\u5ea6\u76f8\u540c\u7684\u5c0f\u6c34\u94f6\u6ef4\u5408\u5e76\u6210\u4e00\u4e2a\u8f83\u5927\u7684\u6c34\u94f6\u6ef4\u3002\u628a\u8fd9\u4e9b\u6c34\u94f6\u4f5c\u4e3a\u8d28\u91cf\u4e0d\u53d8\u7684\u5b64\u7acb\u7cfb\u7edf\uff0c\u5ffd\u7565\u5916\u754c\u505a\u529f\u4ee5\u53ca\u5176\u4ed6\u80fd\u91cf\u50a8\u5b58\u7684\u53d8\u5316\uff0c\u6bd4\u8f83\u5408\u5e76\u524d\u4e0e\u5408\u5e76\u540e\u8fd0\u52a8\u5e73\u606f\u3001\u5185\u90e8\u8fbe\u5230\u70ed\u5e73\u8861\u65f6\u7684\u6e29\u5ea6\u3002\u6c34\u94f6\u7684\u6e29\u5ea6\u5982\u4f55\u53d8\u5316\uff1f\u82e5\u5b9e\u9645\u8fc7\u7a0b\u4e2d\u6709\u80fd\u91cf\u4f20\u7ed9\u73af\u5883\uff0c\u4e0d\u80fd\u5c06\u8868\u9762\u80fd\u53d8\u5316\u4e00\u6982\u5168\u90e8\u5f52\u5165\u6c34\u94f6\u7684\u70ed\u8fd0\u52a8\u80fd\u91cf\u53d8\u5316\u3002",
      "figure_ids": []
    },
    {
      "number": "9",
      "text": "9. \u4e24\u4e2a\u76f4\u5f84\u4e0d\u540c\u7684\u80a5\u7682\u6ce1\u7528\u7ec6\u7ba1\u8fde\u901a\uff0c\u5916\u754c\u538b\u5f3a\u76f8\u540c\u3002\u5728\u7406\u60f3\u6a21\u578b\u4e2d\uff0c\u6ce1\u4fdd\u6301\u7403\u5f62\uff0c\u8584\u6db2\u819c\u6709\u5185\u3001\u5916\u4e24\u4e2a\u754c\u9762\uff0c\u4e24\u4e2a\u6ce1\u7684\u8868\u9762\u5f20\u529b\u7cfb\u6570\u76f8\u540c\u4e14\u5728\u8fc7\u7a0b\u4e2d\u4fdd\u6301\u4e0d\u53d8\uff0c\u7ec6\u7ba1\u5141\u8bb8\u7a7a\u6c14\u6d41\u52a8\u3002\u7a7a\u6c14\u662f\u5426\u4ece\u4e00\u4e2a\u6ce1\u6d41\u5411\u53e6\u4e00\u4e2a\u6ce1\uff0c\u5230\u4ec0\u4e48\u65f6\u5019\u4e3a\u6b62\uff1f\u518d\u5728\u6210\u4eba\u6307\u5bfc\u4e0b\uff0c\u4f7f\u7528\u9002\u5408\u7684\u4f4e\u98ce\u9669\u80a5\u7682\u6ce1\u8fde\u901a\u88c5\u7f6e\u8fdb\u884c\u5b9e\u9a8c\uff0c\u68c0\u9a8c\u81ea\u5df1\u7684\u9884\u6d4b\u3002\u5206\u522b\u8bb0\u5f55\u7406\u8bba\u9884\u6d4b\u4e0e\u5b9e\u9645\u89c2\u5bdf\uff0c\u6ce8\u660e\u5b9e\u9a8c\u6761\u4ef6\u548c\u672a\u5b8c\u6210\u7684\u6b65\u9aa4\uff0c\u4e0d\u628a\u9884\u6d4b\u5f53\u4f5c\u5df2\u7ecf\u89c2\u5bdf\u5230\u7684\u7ed3\u679c\uff0c\u4e5f\u4e0d\u7f16\u9020\u5b9e\u9a8c\u9a8c\u8bc1\uff1b\u5b9e\u9645\u80a5\u7682\u819c\u7684\u8868\u9762\u5f20\u529b\u53ef\u80fd\u968f\u7ec4\u6210\u548c\u8fc7\u7a0b\u6539\u53d8\u3002",
      "figure_ids": []
    },
    {
      "number": "10",
      "text": "10. \u9152\u7cbe\u6cbf\u6bdb\u7ec6\u7ba1\u4e0a\u5347 55 \u6beb\u7c73\uff0c\u800c\u6c34\u4e0a\u5347 146 \u6beb\u7c73\u3002\u6309\u5206\u522b\u4f7f\u7528\u540c\u4e00\u6839\u5747\u5300\u6bdb\u7ec6\u7ba1\u3001\u6e29\u5ea6\u76f8\u540c\u3001\u8fbe\u5230\u9759\u6b62\u5e73\u8861\u4e14\u4e24\u79cd\u6db2\u4f53\u90fd\u5b8c\u5168\u6d78\u6da6\u7ba1\u58c1\u7684\u7406\u60f3\u6a21\u578b\uff0c\u7ed3\u5408\u5339\u914d\u8be5\u6e29\u5ea6\u548c\u9152\u7cbe\u7ec4\u6210\u7684\u8868\u9762\u5f20\u529b\u7cfb\u6570\u53ca\u6c34\u7684\u5bc6\u5ea6\u8d44\u6599\uff0c\u8bd5\u6c42\u9152\u7cbe\u7684\u5bc6\u5ea6\u3002\u539f\u9898\u6ca1\u6709\u6ce8\u660e\u8fd9\u4e9b\u7269\u6027\u8d44\u6599\u53ca\u6e29\u5ea6\u3001\u9152\u7cbe\u7ec4\u6210\uff1b\u82e5\u8d44\u6599\u672a\u7ed9\u5b9a\uff0c\u5e94\u660e\u786e\u7f3a\u5c11\u7684\u6761\u4ef6\uff0c\u4e0d\u8865\u9020\u6570\u503c\uff0c\u4e5f\u4e0d\u628a\u63a5\u89e6\u89d2\u6216\u8868\u9762\u5f20\u529b\u5728\u4e0d\u540c\u6761\u4ef6\u4e0b\u89c6\u4e3a\u4e0d\u53d8\u3002",
      "figure_ids": []
    }
