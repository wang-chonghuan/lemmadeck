  "exercises": [
    {
      "number": "1",
      "text": "1. \u653e\u5728\u623f\u95f4\u91cc\u7684\u684c\u5b50\uff0c\u53d7\u4e0d\u53d7\u9759\u6469\u64e6\u529b\u7684\u4f5c\u7528\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u6839\u636e\u725b\u987f\u7b2c\u4e8c\u5b9a\u5f8b\uff0c\u53d7\u5230\u529b\u4f5c\u7528\u7684\u7269\u4f53\u5e94\u5f97\u5230\u52a0\u901f\u5ea6\u3002\u5c0f\u5b69\u7528\u4ed6\u6700\u5927\u7684\u52b2\u63a8\u4e66\u67dc\uff0c\u4f46\u6ca1\u80fd\u4f7f\u5b83\u79fb\u52a8\u3002\u8fd9\u7834\u574f\u6ca1\u7834\u574f\u725b\u987f\u7b2c\u4e8c\u5b9a\u5f8b\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u4e3a\u4e86\u4f7f\u653e\u5728\u6c34\u5e73\u9762\u4e0a\u7684\u7269\u4f53\u5728\u8fd9\u4e2a\u6c34\u5e73\u9762\u4e0a\u79fb\u52a8\uff0c\u5e94\u5f53\u5bf9\u5b83\u4f5c\u7528\u591a\u5927\u7684\u529b\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u8d28\u91cf\u4e3a 20 \u5343\u514b\u7684\u65b9\u6728\uff0c\u6cbf\u7740\u5730\u677f\u4ee5\u6052\u5b9a\u7684\u901f\u5ea6\u8fd0\u52a8\u3002\u8bd5\u8ba1\u7b97\u9700\u8981\u7528\u591a\u5927\u7684\u529b\u63a8\u5b83\u3002\u5982\u679c\u5bf9\u65b9\u6728\u7684\u4f5c\u7528\u529b\u5927\u4e8e\u8ba1\u7b97\u7684\u6570\u503c\uff0c\u5219\u65b9\u6728\u5c06\u5982\u4f55\u8fd0\u52a8\uff1f\n\u73b0\u4ee3\u7248\u660e\u786e\u91c7\u7528\u56fa\u5b9a\u6c34\u5e73\u5730\u677f\u3001\u540c\u5411\u6c34\u5e73\u63a8\u529b\u3001\u6052\u5b9a\u6cd5\u5411\u529b\u548c\u5e72\u6ed1\u52a8\u6a21\u578b\uff1b\u63a5\u89e6\u6750\u6599\u53ca\u6ed1\u52a8\u6469\u64e6\u7cfb\u6570\u672a\u7ed9\u51fa\uff0c\u8bf7\u7528\u6ed1\u52a8\u6469\u64e6\u7cfb\u6570\u8868\u793a\u6240\u9700\u63a8\u529b\uff0c\u5e76\u8bf4\u660e\u4e3a\u4f55\u4e0d\u80fd\u552f\u4e00\u786e\u5b9a\u6570\u503c\u3002\u7b2c\u4e8c\u95ee\u4e2d\u66f4\u5927\u7684\u63a8\u529b\u4fdd\u6301\u6052\u5b9a\uff0c\u5176\u4ed6\u6761\u4ef6\u4e0d\u53d8\u3002",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5. \u9a6c\u5728\u6301\u4e45\u5de5\u4f5c\u65f6\u53ef\u65bd\u529b 600 \u725b\u987f\u3002\u5982\u679c\u96ea\u6a47\u7684\u6ed1\u94c1\u548c\u96ea\u4e4b\u95f4\u7684\u6469\u64e6\u7cfb\u6570\u7b49\u4e8e 0.005\uff0c\u90a3\u4e48\u9a6c\u62c9\u8d28\u91cf\u4e3a 100 \u5343\u514b\u7684\u96ea\u6a47\uff0c\u96ea\u6a47\u91cc\u80fd\u88c5\u8f7d\u7684\u6700\u5927\u91cd\u91cf\u662f\u591a\u5c11\uff1f\n\u73b0\u4ee3\u7248\u660e\u786e\u91c7\u7528\u7684\u7406\u60f3\u6a21\u578b\u662f\uff1a\u96ea\u6a47\u5df2\u5728\u6c34\u5e73\u96ea\u9762\u4e0a\u6ed1\u52a8\uff0c\u7275\u5f15\u529b\u6c34\u5e73\uff0c\u7ed9\u5b9a\u7cfb\u6570\u662f\u6ed1\u52a8\u6469\u64e6\u7cfb\u6570\uff0c\u5ffd\u7565\u5176\u4ed6\u963b\u529b\u3002\u6c42\u53ef\u6301\u7eed\u5300\u901f\u62d6\u52a8\u7684\u8d27\u7269\u91cd\u91cf\u4e0a\u9650\uff0c\u4e0d\u636e\u6b64\u5224\u65ad\u4ece\u9759\u6b62\u8d77\u52a8\u7684\u8f7d\u91cd\u4e0a\u9650\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5728\u4e0a\u4e00\u8282\u7684\u56fa\u5b9a\u6c34\u5e73\u684c\u9762\u5b9e\u9a8c\u4e2d\uff0c\u7269\u4f53\u521d\u59cb\u9759\u6b62\uff0c\u9010\u6e10\u589e\u5927\u7684\u5176\u4ed6\u6c34\u5e73\u62c9\u529b\u8d85\u8fc7\u6700\u5927\u9759\u6469\u64e6\u529b\u540e\uff0c\u9759\u6469\u64e6\u4e0d\u80fd\u518d\u4fdd\u6301\u5e73\u8861\uff0c\u7269\u4f53\u5f00\u59cb\u6cbf\u63a5\u89e6\u9762\u6ed1\u52a8\u3002\n\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u4e5f\u6709\u6469\u64e6\u529b\u4f5c\u7528\u5728\u7269\u4f53\u4e0a\uff0c\u8fd9\u65f6\u662f\u6ed1\u52a8\u6469\u64e6\u529b\u3002\n\u539f\u6559\u6750\u628a\u5b83\u7684\u5927\u5c0f\u8fd1\u4f3c\u53d6\u4e3a\u6700\u5927\u9759\u6469\u64e6\u529b\uff0c\u5c5e\u4e8e\u7b80\u5316\u8fd1\u4f3c\uff1b\n\n\u4e24\u8005\u5e76\u4e0d\u666e\u904d\u76f8\u7b49\uff0c\u6ed1\u52a8\u6469\u64e6\u7cfb\u6570\u4e0e\u9759\u6469\u64e6\u7cfb\u6570\u901a\u5e38\u9700\u8981\u5206\u522b\u786e\u5b9a\u3002\n\n\u6ed1\u52a8\u6469\u64e6\u529b\u7684\u65b9\u5411\uff08\u4eca\u540e\u672c\u8282\u5c06\u7b80\u5355\u5730\u53eb\u6469\u64e6\u529b\uff09\u603b\u662f\u8ddf\u63a5\u89e6\u5904\u7684\u76f8\u5bf9\u6ed1\u52a8\u901f\u5ea6\u65b9\u5411\u76f8\u53cd\u3002\n\u8fd9\u662f\u6ed1\u52a8\u6469\u64e6\u529b\u7684\u91cd\u8981\u7279\u6027\u3002"
    },
    {
      "block": 1,
      "text": "**\uff08\u6ed1\u52a8\uff09\u6469\u64e6\u529b\u7684\u65b9\u5411\uff0c\u8ddf\u7269\u4f53\u76f8\u5bf9\u4e8e\u4e0e\u5176\u63a5\u89e6\u7684\u7269\u4f53\u7684\u8fd0\u52a8\u901f\u5ea6\u7684\u65b9\u5411\u76f8\u53cd\u3002**"
    },
    {
      "block": 3,
      "text": "\u5728\u6750\u6599\u914d\u5bf9\u548c\u8868\u9762\u72b6\u6001\u4e0d\u53d8\u3001\u6cd5\u5411\u529b\u5904\u4e8e\u9002\u7528\u8303\u56f4\u7684\u5e72\u6ed1\u52a8\u7ecf\u9a8c\u6a21\u578b\u4e2d\uff0c\u6ed1\u52a8\u6469\u64e6\u529b\u548c\u6cd5\u5411\u538b\u7d27\u529b\u8fd1\u4f3c\u6210\u6b63\u6bd4\uff1a\n$|\\vec{F}_{\\text{\u6469}}|=\\mu|\\vec{N}|$\u3002\n\u8fd9\u91cc\u7684\u6bd4\u4f8b\u7cfb\u6570$\\mu$\u662f\u6ed1\u52a8\u6469\u64e6\u7cfb\u6570\uff0c\u4e0d\u5e94\u4e0e\u6700\u5927\u9759\u6469\u64e6\u529b\u516c\u5f0f\u4e2d\u7684\u9759\u6469\u64e6\u7cfb\u6570\u5f53\u6210\u540c\u4e00\u4e2a\u53c2\u6570\u3002\n\n\u8fd9\u91cc\u53ea\u5206\u6790\u5df2\u7ecf\u53d1\u751f\u7684\u6ed1\u52a8\uff0c\u4e0d\u7528\u8fd9\u4e2a\u7cfb\u6570\u5355\u72ec\u5224\u65ad\u4ece\u9759\u6b62\u8d77\u52a8\u7684\u9608\u503c\u3002"
    },
    {
      "block": 4,
      "text": "\u4ece\u6469\u64e6\u529b\u7684\u516c\u5f0f\u53ef\u4ee5\u770b\u51fa\uff1a\u7cfb\u6570$\\mu$\u7b49\u4e8e\u6469\u64e6\u529b\u548c\u538b\u529b\u7684\u7edd\u5bf9\u503c\u7684\u6bd4\u503c\uff1a\n$\\mu=\\frac{|\\vec{F}_{\\text{\u6469}}|}{|\\vec{N}|}$\u3002"
    }
  ],
