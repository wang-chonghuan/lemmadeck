  "exercises": [
    {
      "number": "1",
      "text": "1. \u89d2\u901f\u5ea6\u662f\u4ec0\u4e48\uff1f\u7528\u4ec0\u4e48\u5355\u4f4d\u6d4b\u91cf\u5b83\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u89d2\u901f\u5ea6\u548c\u7ebf\u901f\u5ea6\u4e4b\u95f4\u7684\u5173\u7cfb\u662f\u600e\u6837\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u8bd5\u8ba1\u7b97\u5730\u7403\u7ed5\u592a\u9633\u8fd0\u52a8\u7684\u89d2\u901f\u5ea6\u548c\u7ebf\u901f\u5ea6\u3002\u5730\u7403\u8f68\u9053\u534a\u5f84\u7b49\u4e8e150000000 \u5343\u7c73\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u5982\u679c\u4e00\u5ea7\u949f\u697c\u7684\u5206\u9488\u957f\u5ea6\u4e3a 3.5 \u7c73\uff0c\u90a3\u4e48\uff0c\u5206\u9488\u9488\u5c16\u7684\u7ebf\u901f\u5ea6\u7b49\u4e8e\u591a\u5c11\uff1f\u8bd5\u628a\u8fd9\u4e2a\u5206\u9488\u7684\u89d2\u901f\u5ea6\u4e0e\u624b\u8868\u7684\u5206\u9488\u89d2\u901f\u5ea6\u8fdb\u884c\u6bd4\u8f83\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "**\u534a\u5f84\u8f6c\u8fc7\u7684\u89d2\u5ea6\u548c\u5b8c\u6210\u8fd9\u4e2a\u8f6c\u52a8\u6240\u7528\u7684\u65f6\u95f4\u7684\u6bd4\u503c\uff0c\u53eb\u505a\u5300\u901f\u5706\u5468\u8fd0\u52a8\u7684\u70b9\u7684\u89d2\u901f\u5ea6\u3002**"
    },
    {
      "block": 3,
      "text": "\u5982\u679c\u89d2\u5ea6 $\\varphi$ \u7528\u5f27\u5ea6\u8868\u793a\uff0c\u800c\u65f6\u95f4 $t$ \u7528\u79d2\u8868\u793a\uff0c\u5219\u89d2\u901f\u5ea6 $\\omega$ \u7528\u5f27\u5ea6\u6bcf\u79d2\uff08\u5f27\u5ea6/\u79d2\uff09\u6765\u6d4b\u91cf\u3002"
    },
    {
      "block": 4,
      "text": "\u901f\u5ea6\u8ddf\u89d2\u901f\u5ea6\u4e0d\u540c\uff0c\u901f\u5ea6\u662f\u7528\u8def\u7a0b\u7684\u957f\u5ea6 $l$ \u4e0e\u65f6\u95f4 $t$ \u7684\u6bd4\u503c\u6765\u6d4b\u91cf\uff0c\u7528\u7c73\u6bcf\u79d2\u6765\u8868\u793a\uff0c\u53eb\u505a\u7ebf\u901f\u5ea6\u3002\n\u7528\u5b57\u6bcd $V$ \u8868\u793a\u5b83\u3002\n\u5f53\u7269\u4f53\uff08\u8d28\u70b9\uff09\u4f5c\u5300\u901f\u5706\u5468\u8fd0\u52a8\u65f6\uff0c\u5b83\u7684\u7ebf\u901f\u5ea6\u4e0e\u70b9\u7684\u5373\u65f6\u901f\u5ea6\u77e2\u91cf\u7684\u7edd\u5bf9\u503c\u662f\u4e00\u81f4\u7684\u3002\n\n\u89d2\u901f\u5ea6 $\\omega$ \u548c\u7ebf\u901f\u5ea6 $V$ \u4e4b\u95f4\u7684\u5173\u7cfb\u662f\u5f88\u7b80\u5355\u7684\u3002\n\u5982\u679c\u5728\u89d2\u901f\u5ea6\u7684\u8868\u793a\u5f0f\u4e2d\uff0c\u7528 $\\frac{l}{r}$ \u4ee3\u66ff $\\varphi$\uff0c\u5219\u6211\u4eec\u5f97\u5230\uff1a\n$\\omega=\\frac{l}{r\\cdot t}$\u3002\n\n\u53c8\u56e0\u4e3a $l=Vt$\uff0c\u6240\u4ee5$\\omega=\\frac{V}{r}$\uff0c\u6216$V=\\omega r$\u3002"
    },
    {
      "block": 5,
      "text": "\u901a\u5e38\u4e5f\u7528\u5355\u4f4d\u65f6\u95f4\u5185\u7684\u8f6c\u6570\u6765\u8868\u793a\u505a\u5706\u5468\u8fd0\u52a8\u7269\u4f53\u7684\u901f\u5ea6\u3002\n\u5f88\u5bb9\u6613\u628a\u89d2\u901f\u5ea6\u4e0e\u5355\u4f4d\u65f6\u95f4\u5185\u7684\u8f6c\u6570\u8054\u7cfb\u8d77\u6765\u3002\n\u5b9e\u9645\u4e0a\uff0c\u534a\u5f84\u65cb\u8f6c\u4e00\u5708\u65f6\uff0c\u8f6c\u8fc7\u7684\u89d2\u5ea6\u4e3a $2\\pi$ \u5f27\u5ea6\u3002\n\n\u8fd9\u5c31\u662f\u8bf4\uff0c\u4f8b\u5982\u5355\u4f4d\u65f6\u95f4\u5185\u8f6c\u4e86 $n$ \u5708\uff0c\u534a\u5f84\u8f6c\u8fc7\u7684\u89d2\u5ea6\u4e3a $2\\pi n$ \u5f27\u5ea6\u3002\n\u56e0\u6b64\uff0c\u89d2\u901f\u5ea6 $\\omega$ \u548c\u5355\u4f4d\u65f6\u95f4\u5185\u7684\u8f6c\u6570 $n$ \u7684\u5173\u7cfb\u5f0f\u4e3a$\\omega=2\\pi n$\u3002"
    },
    {
      "block": 6,
      "text": "\u5355\u4f4d\u65f6\u95f4\u5185\u7684\u8f6c\u6570\uff08$n$\uff09\uff0c\u901a\u5e38\u4e5f\u53eb\u505a\u65cb\u8f6c\u7684\u9891\u7387\u3002\n\u9891\u7387\u7684\u5012\u6570\uff0c\u51b3\u5b9a\u4e86\u7269\u4f53\u8f6c\u52a8\u4e00\u5708\u6240\u7528\u7684\u65f6\u95f4\u3002\n\u8fd9\u4e2a\u65f6\u95f4\u53eb\u505a\u65cb\u8f6c\u7684\u5468\u671f\uff0c\u7528\u5b57\u6bcd $T$ \u8868\u793a\uff1a\n$T=\\frac{1}{n}=\\frac{2\\pi}{\\omega}$\u3002"
    }
  ],
