  "exercises": [
    {
      "number": "1",
      "text": "1. \u52a0\u901f\u5ea6\u662f\u4ec0\u4e48\uff1f\u4e3a\u4ec0\u4e48\u9700\u8981\u77e5\u9053\u5b83\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u5728\u4efb\u4f55\u53d8\u901f\u8fd0\u52a8\u4e2d\u901f\u5ea6\u8981\u6539\u53d8. \u52a0\u901f\u5ea6\u600e\u6837\u8868\u5f81\u8fd9\u4e2a\u53d8\u5316\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u201c\u51cf\u901f\u201d\u76f4\u7ebf\u8fd0\u52a8\u548c\u201c\u52a0\u901f\u201d\u76f4\u7ebf\u8fd0\u52a8\u7684\u533a\u522b\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u5300\u52a0\u901f\u8fd0\u52a8\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5. \u65e0\u8f68\u7535\u8f66\u4ee5\u6052\u5b9a\u7684\u52a0\u901f\u5ea6 1.5 \u7c73/\u79d2$^2$ \u7531\u9759\u6b62\u5f00\u59cb\u8fd0\u52a8. \u8bd5\u6c42\u7ecf\u8fc7\u591a\u957f\u65f6\u95f4\u5b83\u7684\u901f\u5ea6\u4e3a 54 \u5343\u7c73/\u5c0f\u65f6\uff1f",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "6. \u4ee5\u901f\u5ea6\u4e3a 36 \u5343\u7c73/\u79d2\u8fd0\u52a8\u7684\u6c7d\u8f66\uff0c\u5236\u52a8\u540e\uff0c4 \u79d2\u949f\u505c\u6b62. \u8bd5\u6c42\u5236\u52a8\u65f6\u6c7d\u8f66\u7684\u6052\u5b9a\u52a0\u901f\u5ea6\u662f\u591a\u5927\uff1f",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "7. \u8f7d\u91cd\u6c7d\u8f66\u4ee5\u6052\u5b9a\u7684\u52a0\u901f\u5ea6\u8fd0\u52a8\u65f6\uff0c\u5728\u67d0\u4e00\u6bb5\u8def\u7a0b\u4e0a\u5176\u901f\u5ea6\u4ece 15\u7c73/\u79d2\u589e\u52a0\u5230 25 \u7c73/\u79d2. \u5982\u679c\u8f7d\u91cd\u6c7d\u8f66\u7684\u52a0\u901f\u5ea6\u7b49\u4e8e 1.6 \u7c73/\u79d2$^2$\uff0c\u8bd5\u6c42\u589e\u52a0\u8fd9\u4e2a\u901f\u5ea6\u7528\u4e86\u591a\u957f\u65f6\u95f4\uff1f",
      "figure_ids": []
    },
    {
      "number": "8",
      "text": "8. \u5047\u5982\u7269\u4f53\u505a\u76f4\u7ebf\u8fd0\u52a8\uff0c\u52a0\u901f\u5ea6\u4e3a 10 \u7c73/\u79d2$^2$\uff0c\u5728 0.5 \u5c0f\u65f6\u5185\u901f\u5ea6\u53d8\u4e3a\u96f6\uff0c\u8bd5\u6c42\u8fd0\u52a8\u7684\u6700\u5927\u901f\u5ea6\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 3,
      "text": "**\u7269\u4f53\u5728\u4efb\u610f\u76f8\u7b49\u7684\u65f6\u95f4\u95f4\u9694\u5185\u901f\u5ea6\u53d8\u5316\u91cf\u90fd\u76f8\u7b49\u7684\u8fd0\u52a8\uff0c\u53eb\u505a\u5300\u52a0\u901f\u8fd0\u52a8.**"
    },
    {
      "block": 5,
      "text": "\u56e0\u4e3a\u52a0\u901f\u5ea6\u7b49\u4e8e\u77e2\u91cf $\\vec{v}-\\vec{v}_0$ \u548c\u6807\u91cf $\\frac{1}{t}$ \u7684\u4e58\u79ef\uff0c\u6240\u4ee5\uff0c\u52a0\u901f\u5ea6\u662f\u77e2\u91cf\uff08\u53c2\u9605 \u00a7 5\uff09\uff0c\u7528\u5b57\u6bcd $\\vec{a}$ \u8868\u793a\u52a0\u901f\u5ea6\uff1a\n$\\vec{a}=\\frac{\\vec{v}-\\vec{v}_0}{t}$.\n\uff081\uff09"
    },
    {
      "block": 6,
      "text": "**\u5728\u7269\u4f53\u505a\u5300\u52a0\u901f\u8fd0\u52a8\u65f6\uff0c\u7269\u4f53\u901f\u5ea6\u7684\u53d8\u5316\u91cf\u8ddf\u53d1\u751f\u8fd9\u4e2a\u6539\u53d8\u6240\u7528\u7684\u65f6\u95f4\u7684\u6bd4\u503c\uff0c\u53eb\u505a\u7269\u4f53\u7684\u52a0\u901f\u5ea6.**"
    },
    {
      "block": 8,
      "text": "\u5982\u679c\u7269\u4f53\u7684\u521d\u901f\u5ea6 $\\vec{v}_0$ \u548c\u52a0\u901f\u5ea6 $\\vec{a}$ \u662f\u5df2\u77e5\u7684\uff0c\u5219\u53ef\u4ee5\u8ba1\u7b97\u51fa\u7269\u4f53\u5728\u4efb\u610f\u65f6\u523b\u7684\u901f\u5ea6 $\\vec{v}$ \u7684\u6570\u503c.\n\u5b9e\u9645\u4e0a\uff0c\u4ece\u516c\u5f0f\uff081\uff09\u53ef\u4ee5\u5f97\u51fa$\\vec{v}=\\vec{v}_0+\\vec{a}t$.\n\uff082\uff09"
    },
    {
      "block": 15,
      "text": "\u2460 \u5982\u679c\u5728\u76f8\u7b49\u7684\u65f6\u95f4\u5185\u7269\u4f53\u901f\u5ea6\u7684\u53d8\u5316\u91cf\u4e0d\u76f8\u7b49\uff0c\u5219\u5728\u4e00\u6bb5\u8def\u7a0b\u4e0a\u901f\u5ea6\u53d8\u5316\u5f97\u5feb\uff0c\u5728\u53e6\u4e00\u6bb5\u8def\u7a0b\u4e0a\u53d8\u5316\u5f97\u6162.\n\u4e8e\u662f\uff0c\u5728\u4e0d\u540c\u7ebf\u6bb5\u4e0a\u7684\u52a0\u901f\u5ea6\u662f\u4e0d\u540c\u7684.\n\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u6839\u636e\u516c\u5f0f\uff081\uff09\u8ba1\u7b97\u5f97\u5230\u7684\u52a0\u901f\u5ea6\uff0c\u5e94\u5f53\u8ba4\u4e3a\u662f\u5728\u65f6\u95f4 $t$ \u5185\u7684\u5e73\u5747\u52a0\u901f\u5ea6."
    },
    {
      "block": 21,
      "text": "\u5982\u679c\u77e2\u91cf $\\vec{v}_0$ \u548c $\\vec{a}$ \u7684\u6295\u5f71\u7684\u7b26\u53f7\u4e00\u81f4\uff0c**\u5219\u7269\u4f53\u901f\u5ea6\u7684\u7edd\u5bf9\u503c\u968f\u7740\u65f6\u95f4\u800c\u589e\u5927**\u2014\u2014\u7269\u4f53\u88ab\u63a8\u8fdb.\n\u5982\u679c\u77e2\u91cf $\\vec{v}_0$ \u548c $\\vec{a}$ \u7684\u6295\u5f71\u7684\u7b26\u53f7\u76f8\u53cd\uff0c**\u5219\u7269\u4f53\u901f\u5ea6\u7684\u7edd\u5bf9\u503c\u968f\u65f6\u95f4\u800c\u51cf\u5c0f**\u2014\u2014\u7269\u4f53\u88ab\u963b\u788d."
    },
    {
      "block": 22,
      "text": "\u4f46\u662f\uff0c\u7269\u4f53\u65e2\u7136\u88ab\u963b\u788d\uff0c\u90a3\u4e48\u7269\u4f53\u7684\u901f\u5ea6\u5728\u67d0\u4e00\u65f6\u523b\u5e94\u5f53\u7b49\u4e8e\u96f6\uff08*\u7269\u4f53\u5e94\u5f53\u505c\u4f4f*\uff09.\n\u4ece\u516c\u5f0f\uff083\uff09\u53ef\u4ee5\u770b\u51fa\uff1a\u5f53 $at=-v_0$\u6216 $t=-\\frac{v_0}{a}$ \u65f6\uff0c$v=0$.\n\uff08\u5f53\u7136\uff0c\u65f6\u95f4 $t$ \u662f\u6b63\u7684\uff0c\u56e0\u4e3a $v_0$ \u548c $a$ \u7684\u7b26\u53f7\u76f8\u53cd\uff09\u56e0\u4e3a\u52a0\u901f\u5ea6\u7684\u5927\u5c0f\u548c\u65b9\u5411\u662f\u4e00\u5b9a\u7684\uff0c\u6240\u4ee5\uff0c\u7269\u4f53\u5728\u505c\u4f4f\u4ee5\u540e\uff0c\u53c8\u5f00\u59cb\u5411\u76f8\u53cd\u7684\u65b9\u5411\u8fd0\u52a8.\n\n\u4ece\u4e0b\u9762\u7684\u60c5\u51b5\u53ef\u4ee5\u770b\u5230\u8fd9\u70b9\uff1a\u5f53 $t>\\left|\\frac{v_0}{a}\\right|$ \u65f6\uff0c\u91cf\u503c $|at|$ \u5927\u4e8e $|v_0|$\uff0c\u4ece\u800c\u901f\u5ea6 $\\vec{v}$ \u7684\u6295\u5f71\u5177\u6709\u8ddf\u539f\u6765\u76f8\u53cd\u7684\u7b26\u53f7.\n*\u4f8b\u5982*\uff0c\u7ad6\u76f4\u4e0a\u629b\u7684\u7269\u4f53\u5c31\u662f\u8fd9\u6837\u8fd0\u52a8\uff1a*\u7269\u4f53*\u4e0a\u5347\u5230\u8f68\u8ff9\u7684\u6700\u9ad8\u70b9\u4ee5\u540e\uff0c\u53c8\u5f00\u59cb\u5f80\u4e0b\u8fd0\u52a8."
    },
    {
      "block": 23,
      "text": "\u901a\u5e38\uff0c\u628a\u901f\u5ea6\u7684\u7edd\u5bf9\u503c\u4e0d\u65ad\u589e\u5927\u7684\u8fd0\u52a8\u53eb\u505a*\u52a0\u901f\u8fd0\u52a8*\uff0c\u800c\u628a\u901f\u5ea6\u51cf\u5c0f\u7684\u8fd0\u52a8\u53eb\u505a*\u51cf\u901f\u8fd0\u52a8*.\n\u7136\u800c\u5728\u529b\u5b66\u4e2d\uff0c\u4efb\u4f55\u53d8\u901f\u76f4\u7ebf\u8fd0\u52a8\u90fd\u53eb\u505a*\u52a0\u901f\u8fd0\u52a8*.\n\u65e0\u8bba\u662f\u6c7d\u8f66\u5f00\u52a8\uff0c\u6216\u8005\u5236\u52a8\uff0c\u5728\u8fd9\u4e24\u79cd\u60c5\u51b5\u4e0b\uff0c\u6c7d\u8f66\u7684\u8fd0\u52a8\u90fd\u5177\u6709\u52a0\u901f\u5ea6.\n\n\u52a0\u901f\u76f4\u7ebf\u8fd0\u52a8\u4e0e\u51cf\u901f\u76f4\u7ebf\u8fd0\u52a8\u7684\u533a\u522b\uff0c\u53ea\u662f\u52a0\u901f\u5ea6\u77e2\u91cf\u5728\u8f74\u4e0a\u7684\u6295\u5f71\u7684\u7b26\u53f7\u4e0d\u540c."
    }
  ],
