      "id": "acceleration-meaning",
      "view": {
        "mode": "single",
        "stem": "哪一项正确说明加速度表征什么，以及知道它有什么用？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "一段时间内的平均加速度是速度矢量改变量与时间的比值；加速度恒定时，可结合初速度和时间求以后速度。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "一段时间内的平均加速度是位移矢量改变量与时间的比值；加速度恒定时，只需初位置和时间就可求以后位置。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "一段时间内的平均加速度就是速度矢量的改变量；加速度恒定时，把加速度与初速度直接相加即可求以后速度。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "一段时间内的平均加速度就是物体开始时的速度；知道初速度，就能确定加速度并求以后任一时刻的速度。",
            "figure_ids": []
          }
        ]
      }
