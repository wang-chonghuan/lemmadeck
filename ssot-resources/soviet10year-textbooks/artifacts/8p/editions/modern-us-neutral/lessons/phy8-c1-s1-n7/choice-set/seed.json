    {
      "number": "1",
      "text": "1. \u5728\u56fe 29 \u4e0a\u7528\u865a\u7ebf\u753b\u7684\u56fe\u7ebf\u76f8\u5f53\u4e8e\u4ec0\u4e48\u8fd0\u52a8\uff1f",
      "figure_ids": [
        "fig-29"
      ]
    },
    {
      "number": "2",
      "text": "2. \u5229\u7528\u56fe\u7ebf\uff08\u53c2\u9605\u56fe 29\uff09\uff0c\u8bd5\u6c42\u5728 $t=3$ \u79d2\u65f6\u7269\u4f53 2 \u548c 4 \u4e4b\u95f4\u7684\u8ddd\u79bb.",
      "figure_ids": [
        "fig-29"
      ]
    },
    {
      "number": "3",
      "text": "3. \u6839\u636e\u56fe 28 \u6240\u793a\u7684\u56fe\u7ebf\uff0c\u8bd5\u786e\u5b9a\u7269\u4f53\u901f\u5ea6\u7684\u5927\u5c0f\u548c\u65b9\u5411.",
      "figure_ids": [
        "fig-28"
      ]
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u4e3a\u4e86\u76f4\u89c2\u8d77\u89c1\uff0c\u53ef\u4ee5\u7528\u56fe\u7ebf\u6765\u63cf\u5199\u8fd0\u52a8.\n\u5982\u679c\u6cbf\u7740\u6c34\u5e73\u8f74\uff08\u6a2a\u8f74\uff09\u4ece\u65f6\u95f4\u8d77\u70b9\u5f00\u59cb\uff0c\u4ee5\u4e00\u5b9a\u6bd4\u4f8b\u6807\u51fa\u8fdb\u884c\u7684\u65f6\u95f4\uff0c\u800c\u6cbf\u7740\u7ad6\u76f4\u8f74\uff08\u7eb5\u8f74\uff09\u4e5f\u4ee5\u9002\u5f53\u7684\u6bd4\u4f8b\u6807\u51fa\u7269\u4f53\u5750\u6807\u7684\u6570\u503c\uff0c\u5219\u6240\u5f97\u5230\u7684\u56fe\u7ebf\u8868\u793a\u5750\u6807\u548c\u65f6\u95f4\u7684\u5173\u7cfb\uff08\u5b83\u4e5f\u53eb\u505a\u8fd0\u52a8\u56fe\u7ebf\uff09."
    },
    {
      "block": 9,
      "text": "\u6839\u636e\u5750\u6807\u548c\u65f6\u95f4\u56fe\u7ebf\u7684\u5f62\u5f0f\uff0c\u53ef\u4ee5\u5224\u65ad\u8fd0\u52a8\u7684\u901f\u5ea6.\n\u663e\u7136\uff0c\u56fe\u7ebf\u8d8a\u9661\uff0c\u5373\u56fe\u7ebf\u4e0e\u65f6\u95f4\u8f74\u7684\u5939\u89d2\u8d8a\u5927\uff08\u5728\u5355\u4f4d\u65f6\u95f4\u5185\u5750\u6807\u7684\u53d8\u5316\u91cf\u8d8a\u5927\uff0c\u8fd9\u4e2a\u5939\u89d2\u8d8a\u5927\uff09\uff0c\u901f\u5ea6\u8d8a\u5927."
    }
  ],
