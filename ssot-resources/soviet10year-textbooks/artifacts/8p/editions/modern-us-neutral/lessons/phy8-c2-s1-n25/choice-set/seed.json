    {
      "number": "7",
      "text": "7. \u5c0f\u8f66\u5728\u6c34\u5e73\u9762\u4e0a\u4ee5$50$\u5398\u7c73/\u79d2\u7684\u901f\u5ea6\u8fd0\u52a8. \u5728\u540c\u4e00\u65b9\u5411\u4e0a\u4ee5$150$\u5398\u7c73/\u79d2\u7684\u901f\u5ea6\u8fd0\u52a8\u7684\u7b2c\u4e8c\u4e2a\u5c0f\u8f66\u8ddf\u5b83\u76f8\u78b0. \u78b0\u649e\u540e\u4e24\u4e2a\u5c0f\u8f66\u4ee5\u76f8\u540c\u7684\u901f\u5ea6$100$\u5398\u7c73/\u79d2\u5728\u539f\u6765\u7684\u65b9\u5411\u4e0a\u7ee7\u7eed\u8fd0\u52a8. \u8bd5\u6c42\u4e24\u4e2a\u5c0f\u8f66\u8d28\u91cf\u7684\u6bd4\u503c.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6bcf\u4e2a*\u7269\u4f53*\u90fd\u5177\u6709\u60ef\u6027\uff0c\u5b83\u662f*\u7269\u4f53*\u7684\u91cd\u8981\u6027\u8d28\u4e4b\u4e00\uff0c\u56e0\u4e3a*\u7269\u4f53*\u4e0e\u53e6\u5916*\u7269\u4f53*\u76f8\u4e92\u4f5c\u7528\u65f6*\u7269\u4f53*\u5f97\u5230\u7684\u52a0\u901f\u5ea6\u4e0e\u60ef\u6027\u6709\u5173."
    },
    {
      "block": 7,
      "text": "**\u7269\u4f53\u7684\u8d28\u91cf\u2014\u2014\u8868\u793a\u7269\u4f53\u60ef\u6027\u7684\u91cf.\n\u5b83\u786e\u5b9a\u4e86\u76f8\u4e92\u4f5c\u7528\u65f6\u8d28\u91cf\u6807\u51c6\u5668\u7684\u52a0\u901f\u5ea6\u548c\u7269\u4f53\u52a0\u901f\u5ea6\u7684\u6bd4\u503c.**"
    },
    {
      "block": 3,
      "text": "**\u4e24\u4e2a\u76f8\u4e92\u4f5c\u7528\u7684\u7269\u4f53\u7684\u52a0\u901f\u5ea6\u7edd\u5bf9\u503c\u7684\u6bd4\u503c\uff0c\u7b49\u4e8e\u5b83\u4eec\u8d28\u91cf\u7684\u53cd\u6bd4**."
    },
    {
      "block": 5,
      "text": "\u8fd9\u6837\uff0c\u73b0\u5728\u6211\u4eec\u5c31\u77e5\u9053\u4e86\u5982\u4f55\u6c42\u4e24\u4e2a\u7269\u4f53\u8d28\u91cf\u7684\u6bd4\u503c.\n\u4e3a\u6b64\u9700\u8981\u6d4b\u91cf\u5b83\u4eec\u5728\u76f8\u4e92\u4f5c\u7528\u65f6\u7684\u52a0\u901f\u5ea6.\n\u800c\u5982\u4f55\u6c42\u4e00\u4e2a\u5355\u4e2a\u7269\u4f53\u7684\u8d28\u91cf\u5462\uff1f\n\n\u8fd9\u53ef\u4ee5\u50cf\u6d4b\u91cf\u5176\u4ed6\u91cf\u65f6\u90a3\u6837\u4f5c.\n\u4f8b\u5982\uff0c\u4e3a\u4e86\u6c42\u8868\u793a\u7269\u4f53\u957f\u5ea6\u7684\u6570\uff0c\u6211\u4eec\u628a\u5b83\u548c\u5355\u4f4d\u957f\u5ea6\u4e00\u7c73\u8fdb\u884c\u6bd4\u8f83.\n\u53ef\u4ee5\u7528\u540c\u6837\u7684\u65b9\u6cd5\u6765\u786e\u5b9a\u8d28\u91cf\u7684\u6570\u503c\uff1a\u4e3a\u4e86\u6c42\u51fa\u5355\u4e2a\u7269\u4f53\u7684\u8d28\u91cf\u6570\uff0c\u9996\u5148\u5e94\u5f53\u9009\u62e9\u67d0\u4e2a\u7269\u4f53\uff0c\u89c4\u5b9a*\u8be5\u7269\u4f53*\u7684\u8d28\u91cf\u4e3a 1 \u4e2a\u5355\u4f4d\u2014\u2014\u8d28\u91cf\u6807\u51c6\u5668.\n\n\u7136\u540e\u8fdb\u884c\u5b9e\u9a8c.\n\u5728\u5b9e\u9a8c\u4e2d\uff0c\u5e94\u5f53\u4f7f\u5f85\u6d4b\u8d28\u91cf\u7684\u7269\u4f53\u548c\u8d28\u91cf\u6807\u51c6\u5668\u8fdb\u884c\u67d0\u79cd\u76f8\u4e92\u4f5c\u7528.\n\n\u4e8e\u662f\uff0c*\u7269\u4f53*\u548c\u6807\u51c6\u5668\u90fd\u83b7\u5f97\u4e86\u52a0\u901f\u5ea6\uff0c\u52a0\u901f\u5ea6\u662f\u53ef\u4ee5\u6d4b\u91cf\u7684\uff0c\u4ece\u800c\uff0c\u6211\u4eec\u53ef\u4ee5\u5199\u51fa\u7b49\u5f0f$\\frac{|\\vec{a}_{\\text{\u6807\u51c6}}|}{|\\vec{a}_{\\text{\u7269\u4f53}}|}=\\frac{m_{\\text{\u7269\u4f53}}}{m_{\\text{\u6807\u51c6}}}$\u6216$m_{\\text{\u7269\u4f53}}=\\frac{|\\vec{a}_{\\text{\u6807\u51c6}}|}{|\\vec{a}_{\\text{\u7269\u4f53}}|}m_{\\text{\u6807\u51c6}}$\uff0c (2)"
    },
    {
      "block": 10,
      "text": "\u4e0d\u8981\u8ba4\u4e3a\u5f53\u9700\u8981\u6d4b\u91cf\u4efb\u4f55\u4e00\u4e2a\u7269\u4f53\u7684\u8d28\u91cf\u65f6\uff0c\u6bcf\u4e00\u6b21\u90fd\u8981\u628a\u5b83\u4e0e\u8d28\u91cf\u7684\u6807\u51c6\u5668\u76f8\u4e92\u4f5c\u7528\uff0c\u5e76\u6d4b\u91cf\u7269\u4f53\u548c\u6807\u51c6\u5668\u7684\u52a0\u901f\u5ea6.\n\u5b9e\u9645\u4e0a\uff0c\u8fd9\u79cd\u65b9\u6cd5\u5f53\u7136\u662f\u4e0d\u65b9\u4fbf\u7684.\n\u5e78\u8fd0\u7684\u662f\uff0c\u8fd8\u5b58\u5728\u53e6\u5916\u4e00\u79cd\u6d4b\u91cf\u8d28\u91cf\u7684\u65b9\u6cd5\u2014\u2014\u79f0\u91cf\u6cd5\uff08\u539f\u4e66\u79f0\u4e3a\u60ac\u79f0\u6cd5\uff09\uff0c\u8fd9\u662f\u5e38\u7528\u7684\u65b9\u6cd5.\n\n\u5173\u4e8e\u8fd9\u79cd\u6d4b\u91cf\u8d28\u91cf\u7684\u65b9\u6cd5\uff0c\u5728\u516d\u5e74\u7ea7*\u7269\u7406*\u8bfe\u7a0b\u4e2d\u5df2\u7ecf\u8bb2\u8fc7.\n\u4f46\u662f\uff0c\u5728\u4e00\u4e9b\u60c5\u51b5\u4e0b\uff0c\u6839\u636e\u76f8\u4e92\u4f5c\u7528\u65f6\u7684\u52a0\u901f\u5ea6\u6765\u786e\u5b9a\u8d28\u91cf\uff0c\u662f\u4e00\u79cd\u91cd\u8981\u7684\u65b9\u6cd5.\n\u4f8b\u5982\uff0c\u6d4b\u91cf\u884c\u661f\u3001\u6052\u661f\u548c\u5176\u4ed6\u5929\u4f53\u7684\u8d28\u91cf\uff0c\u662f\u4e0d\u80fd\u5229\u7528\u60ac\u79f0\u6cd5\u7684.\n\n\u4e5f\u4e0d\u80fd\u6309\u91cd\u91cf\u6765\u6d4b\u91cf\u5f88\u5c0f\u7684\u8d28\u91cf\uff0c\u4f8b\u5982\u7ec4\u6210\u7269\u4f53\u7684\u539f\u5b50\u548c\u7c92\u5b50\u7684\u8d28\u91cf."
    },
    {
      "block": 9,
      "text": "\u4e0b\u9762\u4ecb\u7ecd\u5343\u514b\u5355\u4f4d\u7684\u5386\u53f2\u6807\u51c6\u3002\n\u5728 1889 \u5e74\u7684\u56fd\u9645\u4f1a\u8bae\u4e0a\u89c4\u5b9a\uff0c\u53d6\u94c2\u548c\u94f1\u5408\u91d1\u7279\u5236\u7684\u5706\u67f1\u4f53\u7684\u8d28\u91cf\uff0c\u4f5c\u4e3a\u8d28\u91cf\u7684\u6807\u51c6.\n\u5f53\u65f6\u4ee5\u8fd9\u4e2a\u5706\u67f1\u4f53\u7684\u8d28\u91cf\u5b9a\u4e49\u8d28\u91cf\u7684\u56fd\u9645\u5355\u4f4d\u2014\u2014\u5343\u514b.\n\n\u8d28\u91cf\u7684\u6807\u51c6\u5668\u4fdd\u5b58\u5728\u56fd\u9645\u5ea6\u91cf\u8861\u5c40\u91cc\uff08\u5728\u6cd5\u56fd\uff09.\n\n\u65e7\u6559\u6750\u8fd8\u8bb0\u8f7d\uff0c\u5728\u82cf\u8054\uff0c\u4e0e\u4e00\u4e9b\u5176\u4ed6\u56fd\u5bb6\u4e00\u6837\uff0c\u6709\u8fd9\u4e2a\u6807\u51c6\u5668\u7684\u590d\u5236\u54c1.\n\u4f5c\u4e3a\u65e5\u5e38\u4f30\u7b97\uff0c\u53ef\u4ee5\u8fd1\u4f3c\u8ba4\u4e3a\uff1a1 \u5347\u7eaf\u6c34\u5728 $15^\\circ\\mathrm{C}$ \u65f6\u5177\u6709 1 \u5343\u514b\u7684\u8d28\u91cf.\n\u8d28\u91cf\u8ddf\u5176\u4ed6\u7684\u91cf\uff0c\u5982\u957f\u5ea6\u548c\u65f6\u95f4\uff0c\u662f\u56fd\u9645\u5355\u4f4d\u5236\u548c\u5398\u7c73\u00b7\u514b\u00b7\u79d2\u5355\u4f4d\u5236\u4e2d\u7684\u57fa\u672c\u91cf.\n\n\u5728\u5398\u7c73\u00b7\u514b\u00b7\u79d2\u5236\u4e2d\uff0c\u7528\u514b\u4f5c\u4e3a\u8d28\u91cf\u7684\u5355\u4f4d\uff1a1 \u514b $=0.001$ \u5343\u514b.\n\u6c34\u7684\u8fd9\u4e2a\u8fd1\u4f3c\u8d28\u91cf\u4e0d\u662f\u5343\u514b\u7684\u5b9a\u4e49\u3002\n\u4eca\u5929\u7684\u56fd\u9645\u5355\u4f4d\u5236\u4ee5\u56fa\u5b9a\u7684\u666e\u6717\u514b\u5e38\u91cf\u5b9a\u4e49\u5343\u514b\uff0c\u4e0d\u518d\u7528\u8fd9\u4e2a\u5706\u67f1\u4f53\u5b9a\u4e49\u5355\u4f4d\u3002"
    }
  ],
