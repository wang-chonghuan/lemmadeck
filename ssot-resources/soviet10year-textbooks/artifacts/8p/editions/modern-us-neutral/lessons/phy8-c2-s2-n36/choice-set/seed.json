  "exercises": [
    {
      "number": "1",
      "text": "1. \u4ec0\u4e48\u53eb\u505a\u91cd\u529b\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u8bd5\u8ba1\u7b97\u5728\u8d64\u9053\u6d4b\u91cf\u7684\u81ea\u7531\u843d\u4f53\u52a0\u901f\u5ea6\u548c\u5728\u6781\u5730\u6d4b\u91cf\u7684\u6570\u503c\u6709\u591a\u5927\u5dee\u5f02.",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u5728\u9ad8\u5ea6\u7b49\u4e8e $3$ \u4e2a\u5730\u7403\u534a\u5f84\u7684\u5730\u65b9\uff0c\u81ea\u7531\u843d\u4f53\u52a0\u901f\u5ea6\u7684\u6570\u503c\u662f\u591a\u5927\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u7269\u4f53\u5728\u5730\u7403\u4e0a\u65b9\u591a\u9ad8\u65f6\u91cd\u529b\u51cf\u5c0f\u4e00\u534a\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5. \u8bd5\u8ba1\u7b97\u706b\u661f\u8868\u9762\u9644\u8fd1\u81ea\u7531\u843d\u4f53\u7684\u52a0\u901f\u5ea6. \u706b\u661f\u7684\u8d28\u91cf\u7b49\u4e8e $6\\times10^{23}$ \u5343\u514b\uff0c\u5176\u534a\u5f84\u7b49\u4e8e $3300$ \u5343\u7c73.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "**\u91cd\u529b\uff0c\u5373\u5730\u7403\u5bf9\u7269\u4f53\u7684\u5438\u5f15\u529b**\uff0c\u662f\u4e07\u6709\u5f15\u529b\u7684\u8868\u73b0\u4e4b\u4e00.\n\u6211\u4eec\u7528 $M$ \u8868\u793a\u5730\u7403\u7684\u8d28\u91cf\uff0c\u7528 $R$ \u8868\u793a\u5730\u7403\u7684\u534a\u5f84\uff0c\u7528 $m$ \u8868\u793a\u67d0\u7269\u4f53\u7684\u8d28\u91cf\uff0c\u5219\u6839\u636e\u4e07\u6709\u5f15\u529b\u5b9a\u5f8b\uff0c\u5730\u7403\u4f5c\u7528\u5728\u5176\u8868\u9762\u9644\u8fd1\u7269\u4f53\u7684\u529b\u7b49\u4e8e$|\\vec F|=G\\frac{Mm}{R^2}$.\n\uff081\uff09"
    },
    {
      "block": 1,
      "text": "\u8fd9\u5c31\u662f\u91cd\u529b.\n\u5b83\u7684\u65b9\u5411\u6307\u5411\u5730\u7403\u4e2d\u5fc3."
    },
    {
      "block": 5,
      "text": "**\u4f5c\u7528\u5728\u7269\u4f53\u4e0a\u7684\u91cd\u529b\uff0c\u7b49\u4e8e\u7269\u4f53\u7684\u8d28\u91cf\u548c\u81ea\u7531\u843d\u4f53\u52a0\u901f\u5ea6\u7684\u4e58\u79ef**."
    },
    {
      "block": 9,
      "text": "\u5b9e\u9a8c\u6307\u51fa\uff1a\u5728\u5730\u7403\u8868\u9762\u4e24\u6781\u7684\u5730\u65b9\u6d4b\u5f97\u81ea\u7531\u843d\u4f53\u7684\u52a0\u901f\u5ea6\u7ea6\u7b49\u4e8e$9.83$ \u7c73/\u79d2$^2$.\n\u5728\u8d64\u9053\uff0c\u7b49\u4e8e $9.78$ \u7c73/\u79d2$^2$\uff0c\u5728\u7eac\u5ea6 $45^\\circ$\uff0c\u7b49\u4e8e $9.81$ \u7c73/\u79d2$^2$."
    },
    {
      "block": 12,
      "text": "\u6700\u540e\uff0c\u5f53\u8fdc\u79bb\u5730\u7403\u8868\u9762\u65f6\uff0c\u91cd\u529b\uff0c\u4e5f\u5c31\u662f\u8bf4\u81ea\u7531\u843d\u4f53\u52a0\u901f\u5ea6\u8981\u53d8\u5316.\n\u5982\u679c\u7269\u4f53\u4f4d\u4e8e\u5730\u7403\u8868\u9762\u4e0a\u65b9 $h$ \u9ad8\u5ea6\uff0c\u5219\u81ea\u7531\u843d\u4f53\u52a0\u901f\u5ea6\u7684\u8868\u793a\u5f0f\u5e94\u6539\u5199\u4e3a$|\\vec g|=G\\frac{M}{(R+h)^2}$."
    }
  ],
