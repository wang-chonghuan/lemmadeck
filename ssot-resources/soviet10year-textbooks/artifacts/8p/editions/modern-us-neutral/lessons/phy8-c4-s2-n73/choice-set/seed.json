  "exercises": [
    {
      "number": "1",
      "text": "1. \u6c34\u7535\u7ad9\u5411\u7535\u8def\u8f93\u9001\u7535\u80fd\uff0c\u7535\u7089\u518d\u7528\u7535\u80fd\u653e\u51fa\u70ed\u91cf\u3002\u8bf7\u4ece\u592a\u9633\u5f00\u59cb\uff0c\u8bf4\u660e\u8fd9\u4e00\u8fc7\u7a0b\u4e2d\u80fd\u91cf\u53d1\u751f\u4e86\u54ea\u4e9b\u8f6c\u6362\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u7269\u4f53\u4ece\u5730\u7403\u4e0a\u67d0\u4e00\u9ad8\u5ea6\u843d\u4e0b\u3002\u5b83\u51cf\u5c11\u7684\u91cd\u529b\u52bf\u80fd\u5230\u54ea\u91cc\u53bb\u4e86\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. Alex \u628a\u5927\u9524\u4e3e\u8d77\uff0c\u518d\u7528\u5b83\u6572\u51fb\u94c1\u7827\u3002\u5728\u4e3e\u9524\u3001\u843d\u9524\u548c\u6572\u51fb\u8fc7\u7a0b\u4e2d\uff0c\u80fd\u91cf\u600e\u6837\u8f6c\u6362\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u53ea\u4f5c\u7406\u8bba\u5206\u6790\uff1a\u4e00\u6839\u53d1\u751f\u5f39\u6027\u5f62\u53d8\u7684\u91d1\u5c5e\u5f39\u7c27\u88ab\u653e\u5165\u80fd\u591f\u6eb6\u89e3\u8fd9\u79cd\u91d1\u5c5e\u7684\u786b\u9178\u4e2d\u3002\u5f39\u7c27\u6eb6\u89e3\u540e\uff0c\u539f\u6765\u7684\u5f39\u6027\u52bf\u80fd\u5230\u54ea\u91cc\u53bb\u4e86\uff1f\u786b\u9178\u5177\u6709\u8150\u8680\u6027\uff0c\u8bf7\u52ff\u81ea\u884c\u5c1d\u8bd5\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u5b9e\u9645\u673a\u5668\u5de5\u4f5c\u65f6\uff0c\u8f93\u5165\u80fd\u91cf\u7684\u4e00\u90e8\u5206\u4f1a\u901a\u8fc7\u90e8\u4ef6\u95f4\u7684\u6469\u64e6\u7b49\u8fc7\u7a0b\u8f6c\u5316\u4e3a\u5185\u80fd\uff0c\u4f7f\u90e8\u4ef6\u548c\u5468\u56f4\u73af\u5883\u53d1\u70ed\u3002\n\u5982\u679c\u9884\u5b9a\u4efb\u52a1\u662f\u8f93\u51fa\u673a\u68b0\u529f\uff0c\u8fd9\u90e8\u5206\u53d1\u70ed\u4e0d\u5c5e\u4e8e\u8be5\u4efb\u52a1\u7684\u6709\u7528\u6210\u679c\uff0c\u56e0\u6b64\u6709\u7528\u529f\u5c0f\u4e8e\u603b\u529f\u3002\n\u8fd9\u4e0d\u8868\u793a\u6240\u6709\u6469\u64e6\u529b\u5728\u4efb\u4f55\u60c5\u51b5\u4e0b\u90fd\u505a\u8d1f\u529f\uff0c\u4e5f\u4e0d\u8868\u793a\u5185\u80fd\u6c38\u8fdc\u4e0d\u80fd\u7528\u6765\u505a\u529f\uff0c\u800c\u662f\u8bf4\u660e\u8fd9\u90e8\u5206\u80fd\u91cf\u6ca1\u6709\u6309\u5f53\u524d\u4efb\u52a1\u8f6c\u5316\u4e3a\u6709\u7528\u7684\u673a\u68b0\u8f93\u51fa\u3002"
    },
    {
      "block": 5,
      "text": "\u540c\u6837\u7684\u6548\u7387\u601d\u60f3\u4e5f\u9002\u7528\u4e8e\u53d1\u7535\u673a\u628a\u673a\u68b0\u80fd\u8f6c\u5316\u4e3a\u7535\u80fd\u7684\u8fc7\u7a0b\u3002\n\u4f8b\u5982\uff0c\u6c7d\u8f6e\u673a\u5e26\u52a8\u76f4\u6d41\u53d1\u7535\u673a\uff0c\u53d1\u7535\u673a\u5411\u7535\u8def\u8f93\u51fa\u53ef\u7528\u4e8e\u7535\u6d41\u505a\u529f\u7684\u7535\u80fd\u3002\n\u5b9e\u9645\u53d1\u7535\u673a\u5b58\u5728\u6469\u64e6\u548c\u5176\u4ed6\u635f\u8017\uff0c\u8f93\u51fa\u7684\u6709\u7528\u7535\u80fd\u5c0f\u4e8e\u8fd9\u4e00\u8fc7\u7a0b\u4e2d\u8f93\u5165\u53d1\u7535\u673a\u7684\u673a\u68b0\u80fd\u3002"
    },
    {
      "block": 8,
      "text": "\u201c\u635f\u5931\u201d\u4e0d\u662f\u8bf4\u80fd\u91cf\u6d88\u5931\uff0c\u800c\u662f\u8bf4\u4e00\u90e8\u5206\u80fd\u91cf\u6ca1\u6709\u8f6c\u5316\u4e3a\u5f53\u524d\u4efb\u52a1\u6240\u9700\u8981\u7684\u6709\u7528\u8f93\u51fa\u3002\n\u628a\u673a\u5668\u548c\u5468\u56f4\u73af\u5883\u4e00\u8d77\u8003\u8651\uff0c\u80fd\u91cf\u4ecd\u7136\u5b88\u6052\uff1b\n\u53d1\u70ed\u7b49\u8fc7\u7a0b\u53ea\u662f\u6539\u53d8\u4e86\u80fd\u91cf\u7684\u5f62\u5f0f\u548c\u5206\u5e03\u3002"
    }
  ],
