    "lesson": "phy8-c2-s2-n42",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "1. \u540c\u4e00\u9a91\u8f66\u4eba\u7528\u540c\u4e00\u81ea\u884c\u8f66\u3001\u540c\u4e00\u59ff\u52bf\u548c\u76f8\u540c\u6321\u4f4d\uff0c\u5728\u6c34\u5e73\u8def\u9762\u3001\u9759\u6b62\u7a7a\u6c14\u4e2d\u5206\u522b\u4fdd\u6301\u4e0d\u540c\u7684\u7a33\u5b9a\u901f\u5ea6\u3002\n\u5728\u6bd4\u8f83\u7684\u901f\u5ea6\u8303\u56f4\u5185\uff0c\u628a\u6eda\u52a8\u963b\u529b\u548c\u4f20\u52a8\u673a\u68b0\u963b\u529b\u8fd1\u4f3c\u770b\u4f5c\u4e0d\u53d8\uff0c\u4e0d\u628a\u5b83\u4eec\u6df7\u540c\u4e3a\u56fa\u5b9a\u5927\u5c0f\u7684\u8f6e\u80ce\u4e0e\u5730\u9762\u95f4\u7684\u9759\u6469\u64e6\u529b\u3002\n\u901f\u5ea6\u66f4\u5927\u65f6\u9700\u8981\u5728\u8e0f\u677f\u4e0a\u65bd\u52a0\u66f4\u5927\u7684\u6709\u6548\u529b\uff0c\u8fd9\u4e0e\u54ea\u79cd\u963b\u529b\u6709\u5173\uff1f\u8bf7\u8bf4\u660e\u4f5c\u7528\u5173\u7cfb\uff0c\u4e0d\u628a\u529b\u8bef\u5f53\u6210\u529f\u7387\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u5b87\u5b99\u98de\u8239\u53ea\u5728\u6ca1\u6709\u7a7a\u6c14\u7684\u592a\u7a7a\u4e2d\u98de\u884c\u65f6\uff0c\u662f\u5426\u9700\u8981\u4e3a\u4e86\u51cf\u5c0f\u7a7a\u6c14\u963b\u529b\u800c\u505a\u6210\u6d41\u7ebf\u578b\uff1f\n\u53d1\u5c04\u98de\u8239\u7684\u5916\u9732\u706b\u7bad\u548c\u6574\u6d41\u7f69\u7a7f\u8fc7\u5927\u6c14\u5c42\u65f6\u5462\uff1f\u8bf7\u5206\u522b\u8bf4\u660e\u539f\u56e0\uff1b\u4e0d\u8981\u628a\u592a\u7a7a\u98de\u884c\u7684\u6761\u4ef6\u63a8\u5e7f\u5230\u98de\u8239\u8fdb\u5165\u5927\u6c14\u5c42\u7684\u9636\u6bb5\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u666e\u901a\u519c\u7528\u62d6\u62c9\u673a\u5728\u7530\u95f4\u4f4e\u901f\u4f5c\u4e1a\uff0c\u5468\u56f4\u76f8\u5bf9\u98ce\u901f\u4e5f\u4e0d\u5927\u3002\u5728\u8fd9\u6837\u7684\u5de5\u4f5c\u6761\u4ef6\u4e0b\uff0c\u4e3a\u4ec0\u4e48\u51cf\u5c0f\u7a7a\u6c14\u963b\u529b\u901a\u5e38\u4e0d\u662f\u9020\u578b\u8bbe\u8ba1\u7684\u9996\u8981\u76ee\u6807\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6211\u4eec\u66fe\u4ecb\u7ecd\u4e86\u63a5\u89e6\u7684\u56fa\u4f53\u95f4\u7684\u5e72\u6469\u64e6\u529b\u3002\n\u56fa\u4f53\u4e5f\u4f1a\u5728\u6db2\u4f53\u6216\u6c14\u4f53\u4e2d\u8fd0\u52a8\uff0c\u4f8b\u5982\u98de\u673a\u5728\u7a7a\u6c14\u4e2d\u98de\u884c\uff0c\u8239\u5728\u6c34\u91cc\u822a\u884c\uff1b\n\u6db2\u4f53\u548c\u6c14\u4f53\u7edf\u79f0\u4e3a\u6d41\u4f53\u3002\n\n\u8fd9\u91cc\u8ba8\u8bba\u7684\u76f8\u5bf9\u8fd0\u52a8\uff0c\u662f\u7269\u4f53\u76f8\u5bf9\u4e8e\u5468\u56f4\u6765\u6d41\u6c34\u6216\u7a7a\u6c14\u7684\u8fd0\u52a8\uff0c\u800c\u4e0d\u53ea\u662f\u76f8\u5bf9\u4e8e\u5730\u9762\u7684\u8fd0\u52a8\u3002\n\n\u5cb8\u8fb9\u505c\u7740\u7684\u8239\u9047\u5230\u6c34\u6d41\uff0c\u4e5f\u53ef\u80fd\u53d7\u5230\u6d41\u4f53\u7684\u4f5c\u7528\u3002\n\u963b\u529b\u662f\u6d41\u4f53\u4f5c\u7528\u529b\u4e2d\u963b\u788d\u7269\u4f53\u76f8\u5bf9\u6765\u6d41\u8fd0\u52a8\u7684\u90a3\u4e00\u90e8\u5206\uff1b\n\u5b83\u65e2\u53ef\u6765\u81ea\u8868\u9762\u6469\u64e6\uff0c\u4e5f\u53ef\u6765\u81ea\u7269\u4f53\u5404\u5904\u538b\u529b\u5408\u8d77\u6765\u7684\u4f5c\u7528\u3002\n\n\u5404\u5904\u538b\u529b\u5782\u76f4\u4e8e\u5f53\u5730\u8868\u9762\uff0c\u6240\u4ee5\u603b\u963b\u529b\u4e0d\u80fd\u53ea\u89e3\u91ca\u6210\u5e73\u884c\u63a5\u89e6\u9762\u7684\u6469\u64e6\u529b\u3002\n\n\u98de\u673a\u8fd8\u53ef\u53d7\u5230\u5347\u529b\uff1b\n\u5347\u529b\u548c\u963b\u529b\u662f\u4e0d\u540c\u65b9\u5411\u7684\u5206\u529b\uff0c\u4e0d\u80fd\u628a\u6240\u6709\u6d41\u4f53\u4f5c\u7528\u529b\u90fd\u53eb\u505a\u963b\u529b\u3002\n\u6d41\u4f53\u963b\u529b\u4e0e\u5e72\u6469\u64e6\u7684\u8868\u73b0\u6709\u663e\u8457\u533a\u522b\uff0c\u672c\u8bfe\u628a\u5b83\u53eb\u505a\u963b\u529b\uff0c\u4e5f\u4ecb\u7ecd\u6d41\u4f53\u6469\u64e6\u529b\u8fd9\u4e00\u540d\u79f0\u3002"
    },
    {
      "block": 6,
      "text": "\u6db2\u4f53\u6216\u6c14\u4f53\u4e2d\u7684\u963b\u529b\u4e0d\u4ec5\u4e0e\u76f8\u5bf9\u8fd0\u52a8\u7684\u65b9\u5411\u6709\u5173\uff0c\u4e5f\u4e0e\u76f8\u5bf9\u901f\u7387\u7684\u5927\u5c0f\u6709\u5173\u3002\n\u76f8\u5bf9\u901f\u7387\u5c31\u662f\u7269\u4f53\u76f8\u5bf9\u4e8e\u6765\u6d41\u6c34\u6216\u7a7a\u6c14\u8fd0\u52a8\u5f97\u591a\u5feb\uff0c\u4e0d\u662f\u4e00\u4e2a\u76f8\u5bf9\u4e8e\u6574\u4e2a\u7a7a\u95f4\u7684\u7edd\u5bf9\u901f\u5ea6\u3002\n\n\u5bf9\u4e8e\u4e00\u5b9a\u5927\u5c0f\u548c\u5f62\u72b6\u7684\u7269\u4f53\uff0c\u5728\u9ecf\u6027\u4f5c\u7528\u5360\u4e3b\u5bfc\u3001\u6d41\u52a8\u7a33\u5b9a\u7684\u6761\u4ef6\u4e0b\uff0c\u963b\u529b\u5e38\u53ef\u8fd1\u4f3c\u4e0e\u76f8\u5bf9\u901f\u7387\u6210\u6b63\u6bd4\u3002\n\u8fd9\u91cc\u7684\u201c\u6162\u201d\u8fd8\u4e0e\u7269\u4f53\u5927\u5c0f\u548c\u6d41\u4f53\u6027\u8d28\u6709\u5173\uff0c\u5e76\u6ca1\u6709\u9002\u7528\u4e8e\u6240\u6709\u7269\u4f53\u548c\u6d41\u4f53\u7684\u5206\u754c\u901f\u5ea6\u3002\n\n\u5728\u53e6\u4e00\u4e9b\u7a33\u5b9a\u7684\u6d41\u52a8\u8303\u56f4\u5185\uff0c\u5982\u679c\u6d41\u4f53\u5bc6\u5ea6\u3001\u7269\u4f53\u5f62\u72b6\u3001\u8fce\u6d41\u65b9\u5411\u4ee5\u53ca\u53cd\u6620\u6d41\u52a8\u72b6\u6001\u7684\u963b\u529b\u7cfb\u6570\u7b49\u56e0\u7d20\u8fd1\u4f3c\u4e0d\u53d8\uff0c\u53ef\u4ee5\u91c7\u7528\u963b\u529b\u4e0e\u76f8\u5bf9\u901f\u7387\u5e73\u65b9\u6210\u6b63\u6bd4\u7684\u8fd1\u4f3c\u3002\n\u8fd9\u4e24\u79cd\u5173\u7cfb\u90fd\u6709\u9002\u7528\u6761\u4ef6\uff0c\u4e0d\u80fd\u4ec5\u51ed\u901f\u5ea6\u5c0f\u6216\u901f\u5ea6\u5927\uff0c\u5c31\u8ba4\u5b9a\u5176\u4e2d\u4e00\u79cd\u5173\u7cfb\u4e00\u5b9a\u6210\u7acb\u3002"
    },
    {
      "block": 9,
      "text": "\u9488\u5bf9\u9884\u5b9a\u7684\u6765\u6d41\u65b9\u5411\u548c\u901a\u5e38\u5de5\u4f5c\u6761\u4ef6\uff0c\u8ba9\u6d41\u4f53\u8f83\u987a\u7545\u5730\u7ecf\u8fc7\u3001\u51cf\u5c0f\u5c3e\u6d41\u548c\u538b\u529b\u963b\u529b\u7684\u5916\u5f62\uff0c\u53eb\u505a\u6d41\u7ebf\u578b\u3002\n\u5b83\u662f\u5728\u8fd9\u4e9b\u6761\u4ef6\u4e0b\u6709\u52a9\u4e8e\u51cf\u5c0f\u963b\u529b\u7684\u5916\u5f62\uff0c\u4e0d\u662f\u5bf9\u6240\u6709\u7269\u4f53\u548c\u6d41\u52a8\u6761\u4ef6\u90fd\u4fdd\u8bc1\u963b\u529b\u7edd\u5bf9\u6700\u5c0f\u7684\u5f62\u72b6\u3002\n\n\u56e0\u6b64\uff0c\u98de\u673a\u3001\u6c7d\u8f66\u7b49\u5728\u7a7a\u6c14\u6216\u6db2\u4f53\u4e2d\u8f83\u5feb\u8fd0\u52a8\u7684\u673a\u5668\uff0c\u5e38\u5728\u6ee1\u8db3\u5176\u5b83\u5de5\u4f5c\u8981\u6c42\u7684\u540c\u65f6\uff0c\u5c3d\u91cf\u91c7\u7528\u9002\u5408\u5176\u8fce\u6d41\u65b9\u5411\u7684\u6d41\u7ebf\u5916\u5f62\u3002\n\u5728\u76f8\u5e94\u8868\u9762\u548c\u6d41\u52a8\u6761\u4ef6\u4e0b\uff0c\u4f7f\u8868\u9762\u8f83\u5149\u6ed1\u901a\u5e38\u4e5f\u6709\u52a9\u4e8e\u51cf\u5c0f\u963b\u529b\uff0c\u4f46\u8868\u9762\u7c97\u7cd9\u5ea6\u4f1a\u5f71\u54cd\u6d41\u52a8\uff0c\u4e0d\u80fd\u4fdd\u8bc1\u4efb\u4f55\u78e8\u5149\u64cd\u4f5c\u90fd\u51cf\u5c0f\u603b\u963b\u529b\u3002"
    }
  ],
