      ],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "<span style=\"text-emphasis: filled dot; text-emphasis-position: under;\">如果两个矢量的模相等</span>，<span style=\"text-emphasis: filled dot; text-emphasis-position: under;\">而且方向相同</span>，<span style=\"text-emphasis: filled dot; text-emphasis-position: under;\">则这两个矢量相等</span>.",
      "id": null,
      "label": null,
      "printed_page": 16,
      "source_refs": [
        "p0028#7"
      ],
      "source_text": "如果两个矢量的模相等，而且方向相同，则这两个矢量相等.",
      "changes": [
