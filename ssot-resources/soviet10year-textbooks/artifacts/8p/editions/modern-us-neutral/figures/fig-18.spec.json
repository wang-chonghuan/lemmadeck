        "assertions": ["input-a-connects", "input-b-connects", "chain-a-connects", "chain-b-connects", "result-connects", "input-a-vector", "input-b-vector", "chain-a-vector", "chain-b-vector", "chain-total-vector", "result-vector", "result-start-alignment", "result-end-alignment", "chain-collinear", "a-copy-equal", "b-copy-equal", "result-copy-equal", "result-copy-parallel"],
        "requires": ["pointRelationships"]
      },
      {
        "id": "modern-vector-notation",
        "description": "Modern deterministic realization of source vector accents: ordinary letters with six mapped rightward over-arrows, including separate accents over a and b in the sum. These glyphs are not physical addends. All twelve glyph endpoints are visible, unlabelled and wholly inside this relationship group; exact coordinates are typographic regularization, not source givens.",
        "objects": ["notation-input-a-start", "notation-input-a-end", "notation-input-a", "notation-input-b-start", "notation-input-b-end", "notation-input-b", "notation-chain-a-start", "notation-chain-a-end", "notation-chain-a", "notation-chain-b-start", "notation-chain-b-end", "notation-chain-b", "notation-result-a-start", "notation-result-a-end", "notation-result-a", "notation-result-b-start", "notation-result-b-end", "notation-result-b"],
        "assertions": ["notation-input-a-connects", "notation-input-b-connects", "notation-chain-a-connects", "notation-chain-b-connects", "notation-result-a-connects", "notation-result-b-connects"],
        "requires": ["pointRelationships"]
      }
    ]
  },
