        "objects": ["notation-input-a-start", "notation-input-a-end", "notation-input-a", "notation-input-b-start", "notation-input-b-end", "notation-input-b", "notation-ab-a-start", "notation-ab-a-end", "notation-ab-a", "notation-ab-b-start", "notation-ab-b-end", "notation-ab-b", "notation-ab-result-a-start", "notation-ab-result-a-end", "notation-ab-result-a", "notation-ab-result-b-start", "notation-ab-result-b-end", "notation-ab-result-b", "notation-ba-b-start", "notation-ba-b-end", "notation-ba-b", "notation-ba-a-start", "notation-ba-a-end", "notation-ba-a", "notation-ba-result-a-start", "notation-ba-result-a-end", "notation-ba-result-a", "notation-ba-result-b-start", "notation-ba-result-b-end", "notation-ba-result-b"],
