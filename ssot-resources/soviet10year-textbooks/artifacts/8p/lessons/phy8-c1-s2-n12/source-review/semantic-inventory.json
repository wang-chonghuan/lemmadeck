      },
      "metadataSha256": "64fbe92d6d430ccef418742bda2b5f31a1af2c2a5c243bd129d88df40c3cc41b",
      "semanticBodySha256": "daa66d917e83baaa8f6b16af8e829228f7076f6fb45a547a8cc82541b33b859c",
      "formulasSha256": "a7ac97ca2a49c4259bed10cabadcbde13bdc3965999969d4153426dd4a1ac2fb",
      "blockRows": [
