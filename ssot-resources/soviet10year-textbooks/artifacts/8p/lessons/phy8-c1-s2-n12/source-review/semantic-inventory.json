      "metadataSha256": "01deb95a2329e53f5275b7a36b1db2e7e587e8e0cb45c7f9d703a86c1df3fb33",
      "semanticBodySha256": "f5efd4b88fc1c425fb83b9864e14c081c1128049945492a20ce9dc61eef7a186",
      "formulasSha256": "7b4aab41b583dadc9e06e24254114631c3c1146200ae791e9df995f0c645035c",
