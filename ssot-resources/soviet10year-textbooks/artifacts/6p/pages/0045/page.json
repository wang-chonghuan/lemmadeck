      ]
    },
    {
      "kind": "ex",
      "label": "4",
      "box": null,
      "owner_exercise": null,
      "cont": false,
      "open": false,
      "samerow": false,
      "lines": [
        "什么是在某一时间间隔内所通过的路程？"
      ]
    },
    {
      "kind": "exhead",
      "label": null,
      "box": null,
      "owner_exercise": null,
