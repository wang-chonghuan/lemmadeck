{
  "schema": "s10y-choice-seed-v1",
  "source": {
    "book": "6p",
    "lesson": "phy6-c2-s6",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "\u4e3a\u4ec0\u4e48\u56fa\u4f53\u548c\u6db2\u4f53\u4e0d\u81ea\u884c\u79bb\u6563\u6210\u4e3a\u4e00\u7fa4\u72ec\u7acb\u7684\u5355\u4e2a\u5206\u5b50\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u5728\u4ec0\u4e48\u6761\u4ef6\u4e0b\u5206\u5b50\u95f4\u7684\u5438\u5f15\u4f5c\u7528\u663e\u8457\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u4e3a\u4ec0\u4e48\u4e24\u6bb5\u7c89\u7b14\u5728\u538b\u6324\u4e0b\u4e5f\u4e0d\u80fd\u7ed3\u5408\u5728\u4e00\u8d77\uff0c\u800c\u4e24\u5757\u6cb9\u7070\u6216\u4e24\u5757\u94c5\u5c31\u53ef\u4ee5\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\u54ea\u4e9b\u73b0\u8c61\u53ef\u4ee5\u8bf4\u660e\uff0c\u5206\u5b50\u95f4\u4e0d\u4ec5\u76f8\u4e92\u5438\u5f15\uff0c\u4e5f\u76f8\u4e92\u6392\u65a5\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u7269\u4f53\u4e0d\u4f46\u4e0d\u79bb\u6563\u6210\u72ec\u7acb\u7684\u5355\u4e2a\u5206\u5b50\uff0c\u56fa\u4f53\u751a\u81f3\u5f88\u96be\u88ab\u62c9\u957f\u6216\u6298\u65ad\u3002\n\u600e\u6837\u89e3\u91ca\u7269\u4f53\u7684\u5206\u5b50\u4e0d\u4ec5\u8981\u4fdd\u6301\u5728\u5f7c\u6b64\u7684\u9644\u8fd1\uff0c\u800c\u4e14\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\u5b83\u4eec\u4e4b\u95f4\u7684\u8ddd\u79bb\u8fd8\u5f88\u96be\u589e\u52a0\u5462\uff1f\n\u95ee\u9898\u5728\u4e8e\u5206\u5b50\u4e4b\u95f4\u5b58\u5728\u7740\u76f8\u4e92\u5438\u5f15\u3002\n\n\u6bcf\u4e2a\u5206\u5b50\u90fd\u5438\u5f15\u90bb\u8fd1\u7684\u5206\u5b50\uff0c\u800c\u5b83\u672c\u8eab\u4e5f\u88ab\u90bb\u8fd1\u7684\u5206\u5b50\u6240\u5438\u5f15\u3002"
    },
    {
      "block": 3,
      "text": "\u539f\u6765\u53ea\u6709\u5f53\u5206\u5b50\u4e4b\u95f4\u76f8\u8ddd\u5f88\u8fd1\u65f6\uff0c\u5b83\u4eec\u4e4b\u95f4\u7684\u76f8\u4e92\u5438\u5f15\u624d\u662f\u663e\u8457\u7684\u3002\n\u5f53\u5206\u5b50\u95f4\u7684\u8ddd\u79bb\u6bd4\u5206\u5b50\u672c\u8eab\u7684\u5927\u5c0f\u7a0d\u5927\u4e00\u4e9b\u7684\u65f6\u5019\uff0c\u5206\u5b50\u95f4\u7684\u5438\u5f15\u5c31\u5df2\u7ecf\u663e\u8457\u5730\u53d8\u5f31\u3002\n\u4e24\u6bb5\u7c89\u7b14\u4e4b\u95f4\u6781\u5c0f\u7684\u7f1d\u9699\uff08\u5c0f\u4e8e 0.000001 \u5398\u7c73\uff09\u5df2\u8db3\u4ee5\u4f7f\u5206\u5b50\u95f4\u7684\u5438\u5f15\u5927\u5927\u51cf\u5f31\u3002\n\n\u4f46\u4e24\u5757\u67d4\u8f6f\u7684\u4e1c\u897f\uff0c\u5982\u4e24\u5757\u6cb9\u7070\u662f\u5bb9\u6613\u7c98\u5408\u5728\u4e00\u8d77\u7684\u3002\n\u8fd9\u662f\u56e0\u4e3a\u6cb9\u7070\u5757\u95f4\u53ef\u4ee5\u63a5\u8fd1\u5230\u5206\u5b50\u7684\u5438\u5f15\u80fd\u591f\u8d77\u4f5c\u7528\u7684\u8ddd\u79bb\u3002"
    },
    {
      "block": 7,
      "text": "\u4e0d\u8fc7\u8fd9\u6837\u5c31\u4ea7\u751f\u4e86\u4e00\u4e2a\u95ee\u9898\uff1a\u5206\u5b50\u4e4b\u95f4\u4e3a\u4ec0\u4e48\u4f1a\u5b58\u5728\u6709\u7a7a\u9699\u3002\n\u7167\u8bf4\uff0c\u5206\u5b50\u5e94\u8be5\u4e92\u76f8\u5438\u5f15\u5f97\u201c\u8d34\u7d27\u5728\u4e00\u8d77\u201d\u3002\n\u6240\u4ee5\u6ca1\u6709\u53d1\u751f\u8fd9\u79cd\u60c5\u51b5\uff0c\u662f\u56e0\u4e3a\u5f53\u5206\u5b50\u5f7c\u6b64\u975e\u5e38\u9760\u8fd1\u65f6\uff0c\u5206\u5b50\u95f4\u5c31\u76f8\u4e92\u6392\u65a5\u3002\n\n\u8fd9\u79cd\u76f8\u4e92\u6392\u65a5\u7684\u5b58\u5728\u53ef\u4ee5\u7531\u8bb8\u591a\u73b0\u8c61\u4e2d\u770b\u51fa\u3002\n\u5982\u4e00\u4e2a\u88ab\u538b\u7f29\u7684\u7269\u4f53\u53ef\u4ee5\u91cd\u65b0\u8212\u5c55\u5f00\u6765\uff0c\u5c31\u662f\u56e0\u4e3a\u88ab\u538b\u7f29\u65f6\u5b83\u7684\u5206\u5b50\u5c31\u5f7c\u6b64\u9760\u8fd1\uff0c\u4ece\u800c\u4ea7\u751f\u4e86\u76f8\u4e92\u6392\u65a5\u7684\u4f5c\u7528\u3002"
    }
  ],
