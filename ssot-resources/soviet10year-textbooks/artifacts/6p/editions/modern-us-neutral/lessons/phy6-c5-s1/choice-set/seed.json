{
  "schema": "s10y-choice-seed-v1",
  "source": {
    "book": "6p",
    "lesson": "phy6-c5-s1",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u5728\u672c\u8282\u8ba8\u8bba\u7684\u6052\u529b\u6a21\u578b\u4e2d\uff0c\u4e00\u4e2a\u529b\u505a\u975e\u96f6\u673a\u68b0\u529f\u6240\u5fc5\u987b\u5177\u5907\u7684\u4e24\u4e2a\u6761\u4ef6\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5728\u6052\u529b\u4e0e\u4f4d\u79fb\u540c\u65b9\u5411\u7684\u6a21\u578b\u4e2d\uff0c\u505a\u529f\u7684\u591a\u5c11\u4e0e\u54ea\u4e24\u4e2a\u56e0\u7d20\u6709\u5173\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u529f\u7684\u5355\u4f4d\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u7ed9\u51fa\u529f\u7684\u5355\u4f4d\u7126\u8033\u7684\u5b9a\u4e49\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u5224\u65ad\u4e0b\u5217\u60c5\u5f62\u4e2d\u6709\u6ca1\u6709\u505a\u673a\u68b0\u529f\uff0c\u5e76\u8bf4\u660e\u5224\u65ad\u65f6\u6240\u8003\u5bdf\u7684\u529b\u548c\u4f4d\u79fb\uff1a\na) \u7537\u5b69\u722c\u6811\u3002\nb) \u5973\u5b69\u5f39\u594f\u94a2\u7434\u3002\nc) \u4e00\u4e2a\u4eba\u80cc\u7740\u4e00\u888b\u7cae\u98df\u7ad9\u7740\u3002\nd) \u5de5\u4eba\u7528\u80a9\u5c06\u95e8\u6247\u6491\u8d77\u3002\ne) \u6c34\u538b\u5bb9\u5668\u58c1\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u672c\u6559\u6750\u5f15\u7528\u514b\u96f7\u6d1b\u592b\u5bd3\u8a00\u300a\u7334\u5b50\u300b\u4e2d\u7334\u5b50\u800d\u5f04\u6728\u5934\u7684\u60c5\u8282\u3002\n\u80fd\u4e0d\u80fd\u628a\u7334\u5b50\u800d\u5f04\u6728\u5934\u79f0\u4e3a\u505a\u673a\u68b0\u529f\uff1f\u80fd\u4e0d\u80fd\u79f0\u4e4b\u4e3a\u52b3\u52a8\uff1f\u4e3a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u94a2\u7403\u5728\u5149\u6ed1\u7684\u6c34\u5e73\u51b0\u9762\u4e0a\u6ed1\u52a8\u3002\n\u8bbe\u59a8\u788d\u94a2\u7403\u8fd0\u52a8\u7684\u963b\u529b\uff08\u51b0\u7684\u6469\u64e6\u3001\u7a7a\u6c14\u963b\u529b\uff09\u90fd\u4e0d\u5b58\u5728\uff0c\u8bd5\u95ee\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\u6709\u6ca1\u6709\u505a\u673a\u68b0\u529f\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-4",
      "text": "\uff084\uff09\u7528\u8d77\u91cd\u673a\u5c06\u8d28\u91cf\u4e3a2500 \u5343\u514b\u7684\u91cd\u7269\u63d0\u9ad8\u4e8612 \u7c73\u3002\n\u5728\u5300\u901f\u7ad6\u76f4\u63d0\u5347\u3001\u5ffd\u7565\u989d\u5916\u963b\u529b\u7684\u6a21\u578b\u4e2d\uff0c\u8d77\u91cd\u673a\u7684\u63d0\u5347\u529b\u5171\u505a\u4e86\u591a\u5c11\u529f\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u5f53\u628a\u8d28\u91cf\u4e3a20 \u5428\u7684\u6db2\u538b\u9524\u5934\u63d0\u9ad8120 \u5398\u7c73\u65f6\uff0c\u5728\u5300\u901f\u7ad6\u76f4\u63d0\u5347\u3001\u5ffd\u7565\u989d\u5916\u963b\u529b\u7684\u6a21\u578b\u4e2d\uff0c\u63d0\u5347\u529b\u505a\u4e86\u591a\u5c11\u529f\uff1f",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "\uff086\uff09\u7535\u6c14\u673a\u8f66\u7275\u5f15\u7740\u8d28\u91cf\u4e3a3000 \u5428\u7684\u5217\u8f66\uff0c\u5728\u6c34\u5e73\u8f68\u9053\u4e0a\u5300\u901f\u5730\u8fd0\u52a8\u4e865 \u5343\u7c73\u3002\n\u82e5\u6469\u64e6\u529b\u7b49\u4e8e\u5217\u8f66\u91cd\u91cf\u76840.003 \u500d\uff0c\u6309\u7275\u5f15\u529b\u6cbf\u4f4d\u79fb\u65b9\u5411\u3001\u4e14\u6469\u64e6\u662f\u552f\u4e00\u6c34\u5e73\u963b\u529b\u7684\u6a21\u578b\uff0c\u6c42\u673a\u8f66\u7275\u5f15\u529b\u5728\u8fd9\u4e00\u6bb5\u8def\u7a0b\u4e0a\u6240\u505a\u7684\u529f\u3002",
      "figure_ids": []
    },
    {
      "number": "g3-1",
      "text": "\uff081\uff09\u8bd5\u8ba1\u7b97\u5f53\u4f60\u4ece\u5b66\u6821\u6559\u5ba4\u697c\u7684\u4e00\u5c42\u5300\u901f\u5730\u4e0a\u5230\u4e09\u5c42\u65f6\uff0c\u4e3a\u514b\u670d\u91cd\u529b\u6240\u505a\u7684\u529f\u3002\n\u8fd9\u91cc\u53ea\u8003\u8651\u8eab\u4f53\u6574\u4f53\u7ad6\u76f4\u4e0a\u5347\u7684\u6a21\u578b\uff0c\u4e0d\u628a\u5176\u4ed6\u80fd\u91cf\u6d88\u8017\u8ba1\u5165\u6240\u6c42\u7684\u673a\u68b0\u529f\u3002\n\u7531\u4f60\u81ea\u5df1\u8bbe\u6cd5\u53d6\u5f97\u6240\u9700\u7684\u5404\u79cd\u6570\u636e\uff0c\u628a\u7ed3\u679c\u8bb0\u5165\u7ec3\u4e60\u672c\u4e2d\u3002",
      "figure_ids": []
    },
    {
      "number": "g3-2",
      "text": "**\uff082\uff09\u4f30\u7b97\u4f60\u5728\u6c34\u5e73\u9053\u8def\u4e0a\u524d\u8fdb1 \u5343\u7c73\u6240\u9700\u505a\u7684\u529f\uff0c\u628a\u7ed3\u679c\u8bb0\u5165\u7ec3\u4e60\u672c\u4e2d\u3002**\n**\u63d0\u793a\uff1a\u6309\u672c\u6559\u6750\u91c7\u7528\u7684\u8fd1\u4f3c\u4f30\u7b97\uff0c\u4eba\u5728\u5e73\u8def\u4e0a\u5300\u901f\u901a\u8fc7\u4e00\u6bb5\u8def\u7a0b\u65f6\u6240\u505a\u7684\u529f\uff0c\u7ea6\u7b49\u4e8e\u5c06\u8fd9\u4e2a\u4eba\u63d0\u9ad8\u5230\u4e0e\u8fd9\u6bb5\u8def\u7a0b\u957f\u5ea6\u76f8\u540c\u7684\u9ad8\u5ea6\u6240\u505a\u7684\u529f\u76840.05 \u500d\u3002**\n\u8fd9\u91cc\u6cbf\u7528\u6559\u6750\u63d0\u793a\u7684\u884c\u8d70\u8017\u529f\u4f30\u7b97\uff0c\u4e0d\u628a\u8fd9\u4e2a\u4f30\u7b97\u503c\u5f53\u4f5c\u91cd\u529b\u5728\u6c34\u5e73\u4f4d\u79fb\u4e0a\u6240\u505a\u7684\u529f\uff0c\u4e5f\u4e0d\u628a\u5b83\u5f53\u4f5c\u4eba\u4f53\u5168\u90e8\u80fd\u91cf\u6d88\u8017\u7684\u6d4b\u91cf\u503c\u3002\n\u6240\u9700\u7684\u4e2a\u4eba\u6570\u636e\u7531\u4f60\u81ea\u5df1\u53d6\u5f97\uff1b\u6ca1\u6709\u6d4b\u91cf\u6570\u636e\u65f6\uff0c\u4e0d\u7f16\u9020\u6570\u503c\u7ed3\u679c\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5728\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u5de5\u4eba\u3001\u5de5\u7a0b\u5e08\u3001\u5b66\u8005\u548c\u5b66\u751f\u7b49\u5b8c\u6210\u7684\u6709\u76ca\u52b3\u52a8\uff0c\u5e38\u88ab\u79f0\u4e3a\u201c\u5de5\u4f5c\u201d\u3002"
    },
    {
      "block": 1,
      "text": "\u7269\u7406\u5b66\u4e2d\u7684\u201c\u529f\u201d\u4e0e\u65e5\u5e38\u6240\u8bf4\u7684\u5de5\u4f5c\u4e0d\u540c\u3002\n\u529f\u662f\u4e00\u4e2a\u786e\u5b9a\u7684\u7269\u7406\u91cf\uff0c\u6709\u4e13\u7528\u7684\u6d4b\u91cf\u5355\u4f4d\u3002\n\u8fd9\u91cc\u9996\u5148\u7814\u7a76\u7684\u662f**\u673a\u68b0\u529f**\u3002"
    },
    {
      "block": 6,
      "text": "\u5f53\u6469\u64e6\u529b\u7b49\u529b\u4e0e\u7269\u4f53\u7684\u4f4d\u79fb\u53cd\u5411\uff0c\u4f7f\u7269\u4f53\u7684\u901f\u5ea6\u51cf\u5c0f\u65f6\uff0c\u8fd9\u4e2a\u529b\u4e5f\u505a\u4e86\u673a\u68b0\u529f\u3002\n\u4e0d\u8fc7\uff0c\u8fd9\u65f6\u5b83\u505a\u7684\u662f\u8d1f\u529f\u3002"
    },
    {
      "block": 7,
      "text": "\u4e0a\u8ff0\u4f8b\u5b50\u4e2d\u7684\u529b\u4e0e\u4f4d\u79fb\u5e73\u884c\uff0c\u53ef\u80fd\u540c\u5411\uff0c\u4e5f\u53ef\u80fd\u53cd\u5411\u3002\n\u5224\u65ad\u67d0\u4e2a\u529b\u662f\u5426\u505a\u4e86\u975e\u96f6\u673a\u68b0\u529f\uff0c\u8981\u770b\u4f4d\u79fb\u5728\u8fd9\u4e2a\u529b\u7684\u65b9\u5411\u4e0a\u662f\u5426\u6709\u975e\u96f6\u5206\u91cf\uff0c\u4e0d\u80fd\u53ea\u770b\u7269\u4f53\u6709\u6ca1\u6709\u8fd0\u52a8\u3002"
    },
    {
      "block": 8,
      "text": "**\u5982\u679c\u6709\u529b\u7684\u4f5c\u7528\uff0c\u4f46\u662f\u7269\u4f53\u6ca1\u6709\u53d1\u751f\u4f4d\u79fb**\uff0c\u8fd9\u4e2a\u529b\u5c31**\u6ca1\u6709\u505a\u673a\u68b0\u529f**\u3002\n\u60ac\u6302\u5728\u7ef3\u4e0a\u9759\u6b62\u7684\u91cd\u7269\u867d\u7136\u53d7\u5230\u91cd\u529b\uff0c\u4f46\u5b83\u6ca1\u6709\u4f4d\u79fb\uff0c\u6240\u4ee5\u91cd\u529b\u6ca1\u6709\u505a\u529f\u3002\n\u60f3\u642c\u52a8\u67dc\u5b50\u65f6\uff0c\u6211\u4eec\u4f1a\u7528\u529b\u63a8\u5b83\u3002\n\n\u5982\u679c\u67dc\u5b50\u6ca1\u6709\u53d1\u751f\u79fb\u52a8\uff0c\u63a8\u529b\u4e5f\u6ca1\u6709\u5bf9\u67dc\u5b50\u505a\u673a\u68b0\u529f\u3002"
    },
    {
      "block": 9,
      "text": "\u53ef\u4ee5\u8bbe\u60f3\u4e00\u4e2a\u4e0d\u53d7\u529b\u7684\u7269\u4f53\u4f9d\u60ef\u6027\u8fd0\u52a8\u3002\n\u6ca1\u6709\u529b\u4f5c\u7528\uff0c\u81ea\u7136\u4e5f\u6ca1\u6709\u529b\u5bf9\u5b83\u505a\u529f\u3002\n**\u6709\u529b\u4f5c\u7528\u548c\u7269\u4f53\u53d1\u751f\u4f4d\u79fb\uff0c\u662f\u975e\u96f6\u673a\u68b0\u529f\u7684\u5fc5\u8981\u6761\u4ef6**\uff1b\n\n\u8fd8\u5fc5\u987b\u8003\u8651\u529b\u4e0e\u4f4d\u79fb\u7684\u65b9\u5411\u5173\u7cfb\u3002\n\u7269\u4f53\u8fd0\u52a8\u65f6\uff0c\u5982\u679c\u67d0\u4e2a\u529b\u59cb\u7ec8\u4e0e\u4f4d\u79fb\u5782\u76f4\uff0c\u8fd9\u4e2a\u529b\u4e5f\u4e0d\u505a\u529f\u3002\n\u5408\u529b\u4e3a\u96f6\u5e76\u4e0d\u7b49\u4e8e\u5404\u4e2a\u529b\u90fd\u4e0d\u505a\u529f\u3002"
    },
    {
      "block": 11,
      "text": "\u8ba1\u7b97\u673a\u68b0\u529f\u7684\u91cf\u503c\u5f88\u91cd\u8981\u3002\n\u4e0b\u9762\u5148\u8ba8\u8bba\u6052\u529b\u4e0e\u4f4d\u79fb\u540c\u65b9\u5411\u7684\u60c5\u5f62\uff1b\n\u8fd9\u65f6\uff0c\u529f\u4e0e\u529b\u7684\u5927\u5c0f\u4ee5\u53ca\u6cbf\u529b\u7684\u65b9\u5411\u901a\u8fc7\u7684\u8def\u7a0b\u6709\u5173\u3002"
    },
    {
      "block": 14,
      "text": "\u4e0a\u9762\u7684\u4f8b\u5b50\u8868\u660e\uff1a\n\u5728\u6052\u529b\u4e0e\u4f4d\u79fb\u540c\u65b9\u5411\u7684\u60c5\u5f62\u4e0b\uff0c**\u4fdd\u6301\u8def\u7a0b\u4e0d\u53d8\u65f6\uff0c\u529f\u4e0e\u529b\u7684\u5927\u5c0f\u6210\u6b63\u6bd4**\uff1b\n**\u4fdd\u6301\u529b\u4e0d\u53d8\u65f6\uff0c\u529f\u4e0e\u8def\u7a0b\u6210\u6b63\u6bd4**\u3002\n\n\u7528\u529b\u4e0e\u6cbf\u529b\u7684\u65b9\u5411\u6240\u901a\u8fc7\u7684\u8def\u7a0b\u7684\u4e58\u79ef\u6765\u91cf\u5ea6\u8fd9\u65f6\u7684\u673a\u68b0\u529f\uff0c\u5373**\u529f**$=$**\u529b**$\\times$**\u8def\u7a0b**\uff0c\u6216\n$A=Fs$\u3002\n\u5f0f\u4e2d\uff0c$A$\u8868\u793a\u529f\uff1b\n\n$F$\u8868\u793a\u6052\u529b\u7684\u5927\u5c0f\uff1b\n$s$\u8868\u793a\u6cbf\u529b\u7684\u65b9\u5411\u901a\u8fc7\u7684\u8def\u7a0b\u3002\n\u5f53\u529b\u4e0e\u4f4d\u79fb\u53cd\u65b9\u5411\u65f6\uff0c\u5b83\u505a\u8d1f\u529f\uff0c\u4e0d\u80fd\u628a\u975e\u8d1f\u7684\u8def\u7a0b\u76f4\u63a5\u4ee3\u5165\u8fd9\u4e2a\u540c\u5411\u60c5\u5f62\u7684\u516c\u5f0f\u6765\u5224\u65ad\u529f\u7684\u6b63\u8d1f\u3002"
    },
    {
      "block": 16,
      "text": "**\u6211\u4eec\u628a\u5355\u4f4d\u529b\u4f7f\u7269\u4f53\u6cbf\u529b\u7684\u65b9\u5411\u901a\u8fc7\u5355\u4f4d\u8def\u7a0b\u65f6\u6240\u505a\u7684\u529f\uff0c\u4f5c\u4e3a\u529f\u7684\u5355\u4f4d**\u3002"
    },
    {
      "block": 17,
      "text": "\u82e5\u529b\u7684\u5355\u4f4d\u7528\u725b\u987f\uff0c\u8def\u7a0b\u7684\u5355\u4f4d\u7528\u7c73\uff0c\u52191 \u725b\u987f\u7684\u6052\u529b\u4f7f\u7269\u4f53\u6cbf\u529b\u7684\u65b9\u5411\u901a\u8fc71 \u7c73\u65f6\u6240\u505a\u7684\u529f\uff0c\u5c31\u662f\u8fd9\u91cc\u9009\u53d6\u7684\u529f\u7684\u5355\u4f4d\u3002\n\u82f1\u56fd\u5b66\u8005\u7126\u8033\u5728\u529f\u7684\u6d4b\u91cf\u65b9\u9762\u505a\u8fc7\u5bf9\u79d1\u5b66\u53d1\u5c55\u5341\u5206\u91cd\u8981\u7684\u5b9e\u9a8c\u3002\n\u4e3a\u4e86\u7eaa\u5ff5\u4ed6\uff0c\u8fd9\u79cd\u529f\u7684\u5355\u4f4d\u88ab\u547d\u540d\u4e3a\u7126\u8033\u3002"
    },
    {
      "block": 18,
      "text": "**1 \u7126\u8033**$=$**1 \u725b\u987f**$\\times$**1 \u7c73**\uff0c\u62161 \u7126\u8033$=$**1\u725b\u987f**$\\cdot$**\u7c73**\u3002"
    },
    {
      "block": 19,
      "text": "**1000 \u7126\u8033**$=$**1 \u5343\u7126\u8033**\u3002"
    }
  ],
