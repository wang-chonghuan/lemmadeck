  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u5f53\u6211\u4eec\u8bf4\u6d4b\u91cf\u4e00\u4e2a\u529b\u7684\u65f6\u5019\uff0c\u6211\u4eec\u6240\u6307\u7684\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u529b\u7684\u5355\u4f4d\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u4ec0\u4e48\u6837\u7684\u529b\u53eb\u505a $1$ \u725b\u987f\u529b\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09$1$ \u5343\u514b\u8d28\u91cf\u7684\u7269\u4f53\u6240\u53d7\u7684\u91cd\u529b\u662f\u591a\u5927\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u600e\u6837\u8ba1\u7b97\u4efb\u610f\u8d28\u91cf\u7684\u7269\u4f53\u6240\u53d7\u7684\u91cd\u529b\uff1f",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "\uff086\uff09\u5728\u4ec0\u4e48\u60c5\u51b5\u4e0b\u53ef\u4ee5\u7528\u8ba1\u7b97\u91cd\u529b\u7684\u516c\u5f0f\u6765\u8ba1\u7b97\u91cd\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u8d28\u91cf\u5206\u522b\u662f $2.5$ \u5343\u514b\u3001$800$ \u514b\u3001$1.2$ \u5428\u3001$50$ \u514b\u7684\u7269\u4f53\u6240\u53d7\u7684\u91cd\u529b\u5404\u7b49\u4e8e\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u8d28\u91cf\u5206\u522b\u662f $10$ \u5343\u514b\u548c $200$ \u514b\u7684\u7269\u4f53\u7684\u91cd\u91cf\u5404\u7b49\u4e8e\u591a\u5c11\u725b\u987f\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u4e00\u4e2a\u4eba\u7684\u91cd\u91cf\u662f $800$ \u725b\u987f\uff0c\u4ed6\u7684\u8d28\u91cf\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u529b\u662f\u4e00\u4e2a\u7269\u7406\u91cf.\n\u5b83\u662f\u53ef\u4ee5\u6d4b\u91cf\u7684\uff0c\u5373\u53ef\u4ee5\u4e0e\u4e00\u4e2a\u53d6\u505a\u5355\u4f4d\u7684\u529b\u8fdb\u884c\u6bd4\u8f83."
    },
    {
      "block": 2,
      "text": "**\u6839\u636e\u56fd\u9645\u4e0a\u7684\u89c4\u5b9a\uff0c\u628a\u80fd\u4f7f $1$ \u5343\u514b\u8d28\u91cf\u7684\u7269\u4f53\u5728 $1$ \u79d2\u949f\u5185\u4ea7\u751f $1$ \u7c73/\u79d2\u7684\u901f\u5ea6\u53d8\u5316\u7684\u529b\u53d6\u505a\u529b\u7684\u5355\u4f4d\uff0c\u53eb\u505a $1$ \u725b\u987f.**"
    },
    {
      "block": 6,
      "text": "\u9664\u4e86\u725b\u987f\u4ee5\u5916\u8fd8\u4f7f\u7528\u4e00\u79cd\u66f4\u5927\u7684\u529b\u7684\u5355\u4f4d\u2014\u2014\u5343\u725b\u987f.\n$1$ \u5343\u725b\u987f $=1000$ \u725b\u987f."
    },
    {
      "block": 7,
      "text": "\u8fd9\u4e9b\u5355\u4f4d\u4e0d\u4ec5\u53ef\u4ee5\u7528\u6765\u6d4b\u91cf\u91cd\u529b\uff0c\u4e5f\u53ef\u4ee5\u7528\u6765\u6d4b\u91cf\u5176\u5b83\u7684\u529b\uff0c\u4f8b\u5982\u5f39\u529b."
    },
    {
      "block": 12,
      "text": "**\u6211\u4eec\u628a $9.8$ \u725b\u987f/\u5343\u514b\u8fd9\u4e2a\u91cf\u7528\u4e00\u4e2a\u5b57\u6bcd $g$ \u6765\u8868\u793a\uff1a\n$g=9.8$ \u725b\u987f/\u5343\u514b\uff0c**"
    },
    {
      "block": 14,
      "text": "$F=gm$\uff0c"
    },
    {
      "block": 15,
      "text": "\u5f0f\u4e2d $F$\u2014\u2014\u91cd\u529b\uff0c\u4ee5\u725b\u987f\u4e3a\u5355\u4f4d\uff1b\n$m$\u2014\u2014\u8d28\u91cf\uff0c\u4ee5\u5343\u514b\u4e3a\u5355\u4f4d."
    },
    {
      "block": 16,
      "text": "\u6211\u4eec\u5df2\u7ecf\u77e5\u9053\uff0c\u7269\u4f53\u56e0\u5730\u7403\u7684\u5438\u5f15\u800c\u4f5c\u7528\u4e8e\u652f\u627f\u7269\u6216\u60ac\u6302\u7269\u4e0a\u7684\u529b\u53eb\u505a\u7269\u4f53\u7684\u91cd\u91cf."
    },
    {
      "block": 17,
      "text": "**\u5982\u679c\u652f\u627f\u7269\u662f\u6c34\u5e73\u653e\u7f6e\u7684\uff0c\u4e14\u76f8\u5bf9\u4e8e\u5730\u7403\u662f\u9759\u6b62\u4e0d\u52a8\u7684\uff0c\u5219\u7269\u4f53\u7684\u91cd\u91cf\u5c31\u4e0e\u91cd\u529b\u76f8\u7b49.**"
    },
    {
      "block": 18,
      "text": "\u5728\u672c\u4e66\u4e2d\uff0c\u4ee5\u540e\u51e1\u662f\u8c08\u5230\u7269\u4f53\u7684\u91cd\u91cf\u65f6\uff0c\u6307\u7684\u90fd\u662f\u65bd\u4e8e\u6c34\u5e73\u653e\u7f6e\u7684\u9759\u6b62\u652f\u627f\u7269\u4e0a\u7684\u91cd\u91cf.\n\u56e0\u6b64\uff0c\u4ee5\u725b\u987f\u505a\u4e3a\u5355\u4f4d\u6765\u8868\u793a\u7684\u7269\u4f53\u7684\u91cd\u91cf $P$\uff0c\u4e5f\u5c31\u53ef\u4ee5\u7528\u516c\u5f0f\uff1a"
    },
    {
      "block": 19,
      "text": "$P=gm$"
    },
    {
      "block": 20,
      "text": "\u6765\u8ba1\u7b97\uff0c\u5f0f\u4e2d\u7684\u8d28\u91cf $m$ \u8981\u4ee5\u5343\u514b\u4e3a\u5355\u4f4d."
    }
  ],
