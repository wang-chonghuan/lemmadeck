{
  "schema": "s10y-choice-seed-v1",
  "source": {
    "book": "6p",
    "lesson": "phy6-c2-s4",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "\u4ec0\u4e48\u53eb\u6269\u6563\uff1f\n\u53d9\u8ff0\u4e00\u4e2a\u80fd\u89c2\u5bdf\u5230\u6db2\u4f53\u6269\u6563\u73b0\u8c61\u7684\u5b9e\u9a8c\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u5982\u4f55\u7528\u7269\u8d28\u7684\u5206\u5b50\u7ed3\u6784\u89c2\u70b9\u89e3\u91ca\u6269\u6563\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u5728\u4eba\u548c\u52a8\u7269\u7684\u673a\u4f53\u4e2d\uff0c\u6269\u6563\u73b0\u8c61\u53d1\u751f\u5728\u54ea\u4e9b\u8fc7\u7a0b\u4e2d\uff1f\n\u662f\u600e\u6837\u8fdb\u884c\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\u814c\u5236\u9ec4\u74dc\u3001\u767d\u83dc\u3001\u9c7c\u53ca\u5176\u4ed6\u98df\u54c1\uff0c\u4f9d\u636e\u7684\u662f\u4ec0\u4e48\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\u5728\u6cb3\u3001\u6e56\u4ee5\u53ca\u5176\u4ed6\u6c34\u6c60\u4e2d\uff0c\u603b\u662f\u542b\u6709\u7a7a\u6c14\u4e2d\u7684\u5404\u79cd\u6c14\u4f53\u7684\u5206\u5b50\u3002\n\u8fd9\u4e9b\u6c14\u4f53\u5206\u5b50\u662f\u7531\u4e8e\u4ec0\u4e48\u73b0\u8c61\u800c\u8fdb\u5165\u6c34\u4e2d\u7684\uff1f\n\u4e3a\u4ec0\u4e48\u8fd9\u4e9b\u5206\u5b50\u80fd\u4e00\u76f4\u6e17\u900f\u5230\u6c34\u6c60\u7684\u5e95\u90e8\uff1f\n\u63cf\u8ff0\u4e00\u4e0b\uff0c\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\u7a7a\u6c14\u548c\u6c34\u7684\u6df7\u5408\u662f\u600e\u6837\u8fdb\u884c\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "q1",
      "text": "\u4f7f\u7528\u6e05\u6d01\u3001\u53ea\u4f9b\u98df\u54c1\u4f7f\u7528\u4e14\u672a\u63a5\u89e6\u5b9e\u9a8c\u5ba4\u8bd5\u5242\u7684\u73bb\u7483\u676f\u548c\u54c1\u5c1d\u5668\u5177\u3002\n\u5728\u676f\u4e2d\u5012\u5165\u6e05\u6d01\u7684\u51c9\u996e\u7528\u6c34\uff0c\u518d\u628a\u4e00\u5757\u98df\u7528\u7cd6\u653e\u5230\u676f\u5e95\u3002\n\u901a\u8fc7\u5c0f\u5fc3\u54c1\u5c1d\u8868\u5c42\u7684\u6c34\uff0c\u89c2\u5bdf\u8fc7\u591a\u957f\u65f6\u95f4\u540e\u8868\u5c42\u7684\u6c34\u51fa\u73b0\u751c\u5473\uff0c\u5e76\u89e3\u91ca\u8fd9\u4e2a\u73b0\u8c61\u3002\n\u54c1\u5c1d\u65f6\u4e0d\u8981\u6405\u52a8\u6c34\u3002\n\u8fd9\u9879\u4f5c\u4e1a\u53ea\u4f7f\u7528\u996e\u7528\u6c34\u548c\u98df\u7528\u7cd6\uff0c\u4e0d\u5f97\u54c1\u5c1d\u672c\u8bfe\u5b9e\u9a8c\u4e2d\u7684\u786b\u9178\u94dc\u6eb6\u6db2\u6216\u5176\u4ed6\u5b9e\u9a8c\u5ba4\u6db2\u4f53\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5927\u91cf\u5b9e\u9a8c\u8868\u660e\uff0c\u5fae\u89c2\u7c92\u5b50\u4e0d\u505c\u606f\u5730\u8fd0\u52a8\u7740\u3002\n\u672c\u8282\u5bf9\u4e8e\u7531\u5206\u5b50\u7ec4\u6210\u7684\u7269\u8d28\uff0c\u7528\u5206\u5b50\u7684\u65e0\u89c4\u5219\u8fd0\u52a8\u6765\u89e3\u91ca\u6269\u6563\u3002\n\n\u8fd9\u4e2a\u5165\u95e8\u6a21\u578b\u4e0d\u8868\u793a\u6240\u6709\u7269\u4f53\u90fd\u7531\u72ec\u7acb\u5206\u5b50\u7ec4\u6210\u3002\n\u6211\u4eec\u6765\u770b\u4e00\u4e2a\u6db2\u4f53\u5b9e\u9a8c\u3002"
    },
    {
      "block": 3,
      "text": "\u4e0d\u540c\u7684\u7269\u8d28\u81ea\u53d1\u5730\u5f7c\u6b64\u6df7\u5408\u8d77\u6765\u7684\u73b0\u8c61\u53eb\u505a\u6269\u6563\u3002"
    }
  ],
