  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u6d3b\u585e\u5f0f\u62bd\u6c34\u673a\u662f\u5229\u7528\u4ec0\u4e48\u73b0\u8c61\u5de5\u4f5c\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u8fd9\u79cd\u62bd\u6c34\u673a\u7684\u6784\u9020\u5982\u4f55\uff1f\u662f\u600e\u6837\u5de5\u4f5c\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u8fd9\u79cd\u62bd\u6c34\u673a\u62bd\u6c34\u7684\u6700\u5927\u9ad8\u5ea6\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u5728\u7406\u8bba\u8ba8\u8bba\u4e2d\uff0c\u82e5\u7528\u6d3b\u585e\u5f0f\u62bd\u6c34\u673a\uff08\u53c2\u770b\u56fe160a\uff09\u62bd\u6c34\u94f6\uff0c\u90a3\u4e48\u80fd\u62bd\u5230\u7684\u6700\u5927\u9ad8\u5ea6\u662f\u591a\u5c11\uff1f\u4e3a\u4ec0\u4e48\uff1f\n\u672c\u9898\u4e0d\u8981\u6c42\u5b9e\u9645\u64cd\u4f5c\u6c34\u94f6\u3002",
      "figure_ids": [
        "fig-160"
      ]
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u82e5\u62bd\u7684\u662f\u9152\u7cbe\uff0c\u80fd\u62bd\u5230\u7684\u6700\u5927\u9ad8\u5ea6\u53c8\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u8bd5\u8bf4\u660e\u88c5\u6709\u7a7a\u6c14\u5ba4\u7684\u6d3b\u585e\u5f0f\u62bd\u6c34\u673a\uff08\u56fe160b\uff09\u7684\u5de5\u4f5c\u8fc7\u7a0b\u3002\n\u5176\u4e2d\u7684\u7a7a\u6c14\u5ba4\u8d77\u4ec0\u4e48\u4f5c\u7528\uff1f\n\u7528\u8fd9\u79cd\u62bd\u6c34\u673a\u80fd\u628a\u6df1\u4e8e10.3\u7c73\u7684\u6c34\u62bd\u4e0a\u6765\u5417\uff1f",
      "figure_ids": [
        "fig-160"
      ]
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5728\u00a756\u4e2d\uff0c\u6559\u6750\u66fe\u4ecb\u7ecd\u5728\u5927\u6c14\u538b\u5f3a\u4f5c\u7528\u4e0b\uff0c\u73bb\u7483\u7ba1\u4e2d\u7684\u6c34\u968f\u6d3b\u585e\u800c\u5347\u9ad8\u7684\u5b9e\u9a8c\u3002\n**\u6d3b\u585e\u5f0f\u62bd\u6c34\u673a**\u5c31\u662f\u5229\u7528\u8fd9\u79cd\u73b0\u8c61\u5de5\u4f5c\u7684\u3002"
    },
    {
      "block": 1,
      "text": "\u56fe160a\u6240\u793a\u7684\u6d3b\u585e\u5f0f\u62bd\u6c34\u673a\u7531\u4e00\u4e2a\u5706\u7b52\u6784\u6210\u3002\n\u5706\u7b52\u4e2d\u6709\u4e00\u4e2a\u548c\u7b52\u58c1\u63a5\u89e6\u7d27\u5bc6\u3001\u53ef\u4ee5\u4e0a\u4e0b\u79fb\u52a8\u7684\u6d3b\u585e1\uff0c\u5728\u5706\u7b52\u7684\u5e95\u90e8\u548c\u6d3b\u585e\u4e0a\u5404\u88c5\u6709\u4e00\u4e2a\u53ea\u80fd\u5411\u4e0a\u5f00\u7684\u9600\u95e82\u3002\n\u5f53\u6d3b\u585e\u5411\u4e0a\u79fb\u52a8\u65f6\uff0c\u6c34\u5728\u5927\u6c14\u538b\u5f3a\u7684\u4f5c\u7528\u4e0b\u9876\u8d77\u4e0b\u8fb9\u7684\u9600\u95e8\u8fdb\u5165\u7ba1\u4e2d\uff0c\u968f\u7740\u6d3b\u585e\u4e00\u8d77\u4e0a\u5347\u3002"
    },
    {
      "block": 2,
      "text": "\u5f53\u6d3b\u585e\u5411\u4e0b\u79fb\u52a8\u65f6\uff0c\u6d3b\u585e\u4e0b\u9762\u7684\u6c34\u628a\u4e0b\u8fb9\u7684\u9600\u95e8\u538b\u4f4f\uff0c\u4f7f\u5b83\u5173\u95ed\u3002\n\u4f46\u5728\u6c34\u538b\u7684\u4f5c\u7528\u4e0b\uff0c\u6d3b\u585e\u4e0a\u7684\u9600\u95e8\u5374\u6253\u5f00\u4e86\uff0c\u6c34\u5c31\u8fdb\u5230\u6d3b\u585e\u7684\u4e0a\u65b9\u3002\n\u5f53\u6d3b\u585e\u518d\u6b21\u4e0a\u79fb\u65f6\uff0c\u8fd9\u90e8\u5206\u6c34\u5c31\u968f\u6d3b\u585e\u4e00\u8d77\u5347\u9ad8\u800c\u6d41\u8fdb\u51fa\u6c34\u7ba1\u4e2d\u3002\n\n\u4e0e\u6b64\u540c\u65f6\uff0c\u5728\u6d3b\u585e\u4e0b\u9762\u53c8\u91cd\u65b0\u8fdb\u5165\u4e00\u90e8\u5206\u6c34\uff0c\u800c\u8fd9\u90e8\u5206\u6c34\u5728\u6d3b\u585e\u518d\u6b21\u4e0b\u79fb\u65f6\u5c31\u53c8\u5347\u5165\u6d3b\u585e\u4e0a\u9762\uff0c\u5c31\u8fd9\u6837\u4e0d\u65ad\u5730\u628a\u6c34\u62bd\u4e0a\u6765\u3002"
    }
  ],
