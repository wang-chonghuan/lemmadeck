    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u638c\u63e1\u4e86\u5173\u4e8e\u7269\u8d28\u5185\u90e8\u7ed3\u6784\u7684\u77e5\u8bc6\u4e0d\u4ec5\u53ef\u4ee5\u4f7f\u6211\u4eec\u89e3\u91ca\u8bb8\u591a\u7269\u7406\u73b0\u8c61\uff0c\u5e76\u4e14\u53ef\u4ee5\u5e2e\u52a9\u6211\u4eec\u9884\u8a00\u73b0\u8c61\u5c06\u5982\u4f55\u53d1\u751f\uff0c\u4ee5\u53ca\u8981\u4f7f\u5176\u8fc7\u7a0b\u52a0\u5feb\u6216\u51cf\u6162\u5e94\u8be5\u600e\u4e48\u529e\uff0c\u4e5f\u5c31\u662f\u8bf4\u53ef\u4ee5\u5e2e\u52a9\u6211\u4eec\u63a7\u5236\u73b0\u8c61."
    },
    {
      "block": 3,
      "text": "\u77e5\u9053\u4e86\u5404\u79cd\u7269\u4f53\u7684\u5185\u90e8\u7ed3\u6784\u5c31\u53ef\u4ee5\u89e3\u91ca\u5b83\u4eec\u7684\u5404\u79cd\u6027\u8d28\uff0c\u8fd8\u53ef\u4ee5\u521b\u9020\u5177\u6709\u9700\u8981\u7684\u6027\u8d28\u7684\u65b0\u7269\u8d28\u2014\u2014\u786c\u800c\u575a\u56fa\u7684\u5408\u91d1\u3001\u70ed\u7a33\u6750\u6599\u7b49\u7b49. \u4f8b\u5982\uff0c\u4eba\u4eec\u5229\u7528\u79d1\u5b66\u77e5\u8bc6\u5236\u9020\u51fa\u4e86\u7535\u6728\u3001\u4eba\u9020\u6a61\u80f6\u3001\u5361\u73bb\u9686\u3001\u5c3c\u9f99\u7b49\u6750\u6599. \u6240\u6709\u8fd9\u4e9b\u6750\u6599\u5728\u5de5\u7a0b\u6280\u672f\u3001\u533b\u7597\u4e8b\u4e1a\u548c\u65e5\u5e38\u751f\u6d3b\u4e2d\u90fd\u5f97\u5230\u4e86\u5e7f\u6cdb\u7684\u5e94\u7528."
    }
  ],
