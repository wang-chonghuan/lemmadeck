      "text": "\uff081\uff09\u4ec0\u4e48\u662f\u5730\u7403\u7684\u5927\u6c14\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5927\u6c14\u538b\u5f3a\u662f\u7531\u4e8e\u4ec0\u4e48\u800c\u4ea7\u751f\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u53d9\u8ff0\u51e0\u4e2a\u8bc1\u660e\u5927\u6c14\u538b\u5f3a\u5b58\u5728\u7684\u5b9e\u9a8c\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5730\u7403\u5468\u56f4\u7684\u7a7a\u6c14\u5c42\u79f0\u4e3a**\u5927\u6c14**\u3002\n\u672c\u6559\u6750\u8bb0\u8ff0\uff0c\u901a\u8fc7\u4eba\u9020\u5730\u7403\u536b\u661f\u98de\u884c\u65f6\u7684\u89c2\u5bdf\u53d1\u73b0\uff0c\u5927\u6c14\u5c42\u5ef6\u4f38\u7684\u9ad8\u5ea6\u7ea6\u6709\u51e0\u5343\u5343\u7c73\u3002\n\u6211\u4eec\u5c31\u751f\u6d3b\u5728\u8fd9\u4e2a\u5de8\u5927\u7684\u7a7a\u6c14\u6d77\u6d0b\u7684\u6d77\u5e95\u4e0a\u3002\n\n\u5730\u7403\u7684\u8868\u9762\u5c31\u662f\u8fd9\u4e2a\u6d77\u5e95\u3002"
    },
    {
      "block": 1,
      "text": "**\u7531\u4e8e\u91cd\u529b\u7684\u4f5c\u7528\uff0c\u4e0a\u5c42\u7684\u7a7a\u6c14\u8981\u4f7f\u4e0b\u5c42\u7684\u7a7a\u6c14\u53d7\u5230\u538b\u7f29\uff0c\u5c31\u548c\u6d77\u6d0b\u4e2d\u7684\u6c34\u4e00\u6837**\u3002\n\u7d27\u9760\u7740\u5730\u7403\u8868\u9762\u7684\u7a7a\u6c14\u5c42\u88ab\u538b\u7f29\u5f97\u6700\u5389\u5bb3\u3002\n\u800c\u6839\u636e\u5e15\u65af\u5361\u5b9a\u5f8b\u53ef\u77e5\uff0c\u4f5c\u7528\u5728\u8fd9\u5c42\u7a7a\u6c14\u4e0a\u7684\u538b\u5f3a\u662f\u8981\u5411\u5404\u4e2a\u65b9\u5411\u4f20\u9012\u7684\u3002"
    },
    {
      "block": 2,
      "text": "\u4e8e\u662f\uff0c\u5730\u7403\u8868\u9762\u4ee5\u53ca\u4f4d\u4e8e\u5730\u7403\u8868\u9762\u4e0a\u7684\u7269\u4f53\u90fd\u8981\u53d7\u5230\u6574\u4e2a\u7a7a\u6c14\u5c42\u538b\u5f3a\u7684\u4f5c\u7528\u3002\n\u6216\u50cf\u901a\u5e38\u6240\u8bf4\u7684\u90a3\u6837\uff0c\u53d7\u5230**\u5927\u6c14\u538b\u5f3a**\u7684\u4f5c\u7528\u3002"
    }
  ],
