    "book": "6p",
    "lesson": "phy6-c3-s14",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u600e\u6837\u7528\u5206\u5b50\u7684\u8d28\u91cf\u53ca\u5355\u4f4d\u4f53\u79ef\u5185\u7684\u5206\u5b50\u6570\u6765\u8868\u793a\u7269\u8d28\u7684\u5bc6\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4e3a\u4ec0\u4e48\u6c14\u4f53\u7684\u5bc6\u5ea6\u6bd4\u6db2\u4f53\u53ca\u56fa\u4f53\u7684\u5bc6\u5ea6\u5c0f\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u77e5\u9053\u4e86\u4ec0\u4e48\u624d\u80fd\u6c42\u51fa $1$ \u7c73$^3$\u7269\u8d28\u6240\u5305\u542b\u7684\u5206\u5b50\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u6c34\u5728 $100^\\circ\\text{C}$ \u65f6\u7684\u5bc6\u5ea6\u662f $958$ \u5343\u514b/\u7c73$^3$\uff0c\u800c\u5728\u540c\u6837\u6e29\u5ea6\u4e0b\u7684\u6c34\u84b8\u6c7d\u7684\u6700\u5927\u5bc6\u5ea6\u662f $0.598$ \u5343\u514b/\u7c73$^3$. \u600e\u6837\u89e3\u91ca\u6c34\u548c\u6c34\u84b8\u6c7d\u5bc6\u5ea6\u95f4\u7684\u8fd9\u79cd\u5dee\u522b\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u6c22\u6c14\u7684\u5bc6\u5ea6\u662f $0.09$ \u5343\u514b/\u7c73$^3$\uff0c\u800c\u56fa\u6001\u6c22\u7684\u5bc6\u5ea6\u662f $80$ \u5343\u514b/\u7c73$^3$.\u8bd5\u6307\u51fa\u8fd9\u79cd\u5dee\u522b\u7684\u539f\u56e0.",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u4e3a\u4ec0\u4e48\u538b\u7f29\u6c14\u4f53\u7684\u5bc6\u5ea6\u6bd4\u672a\u88ab\u538b\u7f29\u7684\u6c14\u4f53\u7684\u5bc6\u5ea6\u5927\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 3,
      "text": "\u67d0\u79cd\u7269\u8d28\u7684\u5bc6\u5ea6\u7b49\u4e8e\u8fd9\u79cd\u7269\u8d28\u7684\u4e00\u4e2a\u5206\u5b50\u7684\u8d28\u91cf\u4e0e\u5355\u4f4d\u4f53\u79ef\u5185\u5206\u5b50\u6570\u7684\u4e58\u79ef."
    },
    {
      "block": 4,
      "text": "\u5f53\u7136\uff0c\u5b9e\u9645\u4e0a\u4e0d\u4f1a\u7528\u8fd9\u79cd\u65b9\u6cd5\u6765\u8ba1\u7b97\u7269\u8d28\u7684\u5bc6\u5ea6\uff0c\u800c\u662f\u7528\u66f4\u7b80\u5355\u7684\u65b9\u6cd5\u2014\u2014\u6839\u636e\u7269\u4f53\u7684\u8d28\u91cf\u53ca\u4f53\u79ef\u6765\u8ba1\u7b97\uff0c\u4e0d\u8fc7\uff0c\u82e5\u77e5\u9053\u4e86\u7269\u8d28\u7684\u5bc6\u5ea6\u53ca\u4e00\u4e2a\u5206\u5b50\u7684\u8d28\u91cf\uff0c\u5219\u53ef\u4ee5\u6c42\u51fa\u5728 $1$ \u7c73$^3$\u8fd9\u79cd\u7269\u8d28\u4e2d\u6240\u5305\u542b\u7684\u5206\u5b50\u6570. \u8fd9\u662f\u4e0d\u80fd\u7528\u522b\u7684\u65b9\u6cd5\u7b97\u51fa\u7684. \u8981\u6c42\u51fa $1$ \u7c73$^3$\u7269\u8d28\u4e2d\u6240\u5305\u542b\u7684\u5206\u5b50\u6570\uff0c\u9700\u5c06\u7269\u8d28\u7684\u5bc6\u5ea6\u9664\u4ee5\u8be5\u79cd\u7269\u8d28\u4e00\u4e2a\u5206\u5b50\u7684\u8d28\u91cf. \u81f3\u4e8e\u5206\u5b50\u7684\u8d28\u91cf\uff0c\u53ef\u7528\u5b9e\u9a8c\u65b9\u6cd5\u6c42\u51fa."
    },
    {
      "block": 7,
      "text": "\u6c27\u6c14\u7684\u5bc6\u5ea6\u662f $1.43$ \u5343\u514b/\u7c73$^3$. \u901a\u8fc7\u5267\u70c8\u5730\u964d\u6e29\u548c\u52a0\u538b\uff0c\u53ef\u4ee5\u5c06\u6c27\u6c14\u5236\u6210\u6db2\u6c27\uff0c\u800c\u6db2\u6c27\u7684\u5bc6\u5ea6\u662f $1140$ \u5343\u514b/\u7c73$^3$. \u4e0d\u8bba\u662f\u6c27\u6c14\u8fd8\u662f\u6db2\u6c27\uff0c\u90fd\u662f\u7531\u540c\u6837\u7684\u5206\u5b50\u2014\u2014\u6c27\u5206\u5b50\u6784\u6210\u7684. \u4f46\u4e3a\u4ec0\u4e48\u5b83\u4eec\u7684\u5bc6\u5ea6\u7adf\u6709\u5dee\u4e0d\u591a $1000$ \u500d\u8fd9\u4e48\u5927\u7684\u5dee\u522b\u5462\uff1f\n\n\u6211\u4eec\u8fd8\u8bb0\u5f97\uff08\u89c1\u7b2c $14$ \u8282\uff09\uff0c\u6c14\u4f53\u5206\u5b50\u95f4\u7684\u8ddd\u79bb\u6bd4\u6db2\u4f53\u7684\u5927\uff0c\u6240\u4ee5\u5728 $1$ \u7c73$^3$\u6c14\u4f53\u4e2d\u7684\u5206\u5b50\u6570\u6bd4 $1$ \u7c73$^3$\u6db2\u4f53\u4e2d\u7684\u5206\u5b50\u6570\u8981\u5c11."
    }
  ],
