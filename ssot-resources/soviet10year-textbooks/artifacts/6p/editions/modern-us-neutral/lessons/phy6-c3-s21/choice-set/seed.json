  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u4e3e\u4e00\u4e9b\u8868\u660e\u529b\u7684\u4f5c\u7528\u6548\u679c\u4e0e\u529b\u7684\u6570\u503c\u3001\u65b9\u5411\u53ca\u4f5c\u7528\u70b9\u6709\u5173\u7684\u4f8b\u5b50.",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4e3a\u4ec0\u4e48\u529b\u662f\u77e2\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u5728\u56fe\u4e0a\u600e\u6837\u8868\u793a\u529b\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u7528\u56fe\u8868\u793a\u91cd\u529b\u548c\u91cd\u91cf\u65f6\uff0c\u753b\u6cd5\u4e0a\u6709\u4ec0\u4e48\u4e0d\u540c\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u7528\u4f60\u81ea\u5df1\u9009\u5b9a\u7684\u6bd4\u4f8b\u753b\u51fa\u4ee5\u4e0b\u5404\u529b\uff1a\n$\\text{\\textcircled{1}}$\u6570\u503c\u4e3a $400$ \u725b\u987f\u7684\u7269\u4f53\u7684\u91cd\u91cf\uff1b\n$\\text{\\textcircled{2}}$\u6cbf\u6c34\u5e73\u65b9\u5411\u7684 $50$ \u725b\u987f\u7684\u51fb\u7403\u529b.",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09K-700 \u578b\u62d6\u62c9\u673a\u5de5\u4f5c\u65f6\uff0c\u7275\u5f15\u529b\u53ef\u8fbe $60000$ \u725b\u987f.\n\u8bd5\u4ee5 $1$ \u5398\u7c73\u4ee3\u8868 $10$ \u5343\u725b\u987f\u7684\u6bd4\u4f8b\uff0c\u628a\u8fd9\u4e2a\u529b\u7528\u56fe\u8868\u793a\u51fa\u6765.",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u4e00\u7bb1\u7816\u7684\u8d28\u91cf\u4e3a $3$ \u5428\uff0c\u653e\u5728\u4e00\u8f86\u9759\u6b62\u4e0d\u52a8\u7684\u677f\u8f66\u4e0a.\n\u8bd5\u6309\u7167\u4f60\u81ea\u5df1\u9009\u5b9a\u7684\u6bd4\u4f8b\uff0c\u5c06\u7bb1\u5b50\u6240\u53d7\u7684\u91cd\u529b\u548c\u5b83\u7684\u91cd\u91cf\u7528\u56fe\u8868\u793a\u51fa\u6765.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "**\u9664\u4e86\u6570\u503c\uff08\u5927\u5c0f\uff09\u4ee5\u5916\u8fd8\u5177\u6709\u65b9\u5411\u7684\u91cf\u53eb\u505a\u77e2\u91cf.**\n**\u529b\u5c31\u662f\u77e2\u91cf.**"
    },
    {
      "block": 3,
      "text": "\u901a\u8fc7\u4ee5\u4e0a\u6240\u4e3e\u5404\u4f8b\u53ef\u4ee5\u5f97\u51fa\u5982\u4e0b\u7ed3\u8bba\uff1a**\u529b\u5bf9\u7269\u4f53\u7684\u4f5c\u7528****\u6548\u679c\u4e0e\u529b\u7684\u6570\u503c\u3001\u65b9\u5411\u4ee5\u53ca\u4f5c\u7528\u70b9\u6709\u5173.**"
    }
