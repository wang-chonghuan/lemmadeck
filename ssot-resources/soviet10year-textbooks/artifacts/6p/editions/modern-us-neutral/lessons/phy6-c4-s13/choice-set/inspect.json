{
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u5982\u4f55\u89e3\u91ca\u5927\u6c14\u538b\u5f3a\u968f\u7740\u8ddd\u5730\u5e73\u9762\u7684\u9ad8\u5ea6\u7684\u589e\u52a0\u800c\u51cf\u5c0f\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4ec0\u4e48\u53eb\u505a\u6807\u51c6\u5927\u6c14\u538b\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u6839\u636e\u5927\u6c14\u538b\u5f3a\u6765\u6d4b\u91cf\u9ad8\u5ea6\u7684\u4eea\u5668\u7684\u540d\u79f0\u662f\u4ec0\u4e48\uff1f\n\u8fd9\u79cd\u4eea\u5668\u5b9e\u9645\u4e0a\u662f\u4ec0\u4e48\u4eea\u5668\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u5728\u672c\u9898\u8ba8\u8bba\u7684\u4e58\u5ba2\u5468\u56f4\u7a7a\u6c14\u538b\u5f3a\u968f\u9ad8\u5ea6\u53d8\u5316\u7684\u60c5\u5f62\u4e0b\uff0c\u8bd5\u89e3\u91ca\u4e3a\u4ec0\u4e48\u98de\u673a\u8fc5\u901f\u964d\u843d\u65f6\uff0c\u4e58\u5ba2\u7684\u8033\u4e2d\u4f1a\u611f\u5230\u75bc\u75db\uff1f\n\u8fd9\u91cc\u53ea\u8ba8\u8bba\u6559\u6750\u6240\u8bbe\u7684\u7269\u7406\u60c5\u5f62\uff0c\u4e0d\u5047\u5b9a\u6240\u6709\u73b0\u4ee3\u589e\u538b\u8231\u90fd\u5982\u6b64\uff0c\u4e5f\u4e0d\u63d0\u4f9b\u6cbb\u7597\u5efa\u8bae\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u672c\u9898\u8ba8\u8bba\u98de\u673a\u5185\u7684\u7a7a\u6c14\u538b\u5f3a\u968f\u4e0a\u5347\u800c\u964d\u4f4e\u7684\u60c5\u5f62\u3002\n\u5f53\u98de\u673a\u4e0a\u5347\u65f6\uff0c\u98de\u673a\u91cc\u88c5\u6ee1\u58a8\u6c34\u7684\u81ea\u6765\u6c34\u7b14\u4e2d\u7684\u58a8\u6c34\u5c31\u4f1a\u5f80\u51fa\u6d41\u3002\n\u8fd9\u5982\u4f55\u89e3\u91ca\uff1f\n\u8fd9\u4e0d\u662f\u5bf9\u6240\u6709\u73b0\u4ee3\u589e\u538b\u8231\u4e2d\u60c5\u51b5\u7684\u65ad\u8a00\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u6c14\u538b\u8ba1\u5728\u5c71\u811a\u4e0b\u7684\u793a\u6570\u662f760\u6beb\u7c73\u9ad8\u6c34\u94f6\u67f1\uff0c\u800c\u5728\u5c71\u9876\u4e0a\u7684\u793a\u6570\u662f722\u6beb\u7c73\u9ad8\u6c34\u94f6\u67f1\u3002\n\u8bf7\u6309\u672c\u8bfe\u7528\u4e8e\u4e0d\u592a\u9ad8\u9ad8\u5ea6\u8303\u56f4\u7684\u5e73\u5747\u8fd1\u4f3c\u5173\u7cfb\uff0c\u4f30\u7b97\u8fd9\u5ea7\u5c71\u6709\u591a\u9ad8\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u8bd5\u5c06\u6807\u51c6\u5927\u6c14\u538b\u4ee5\u5e15\u65af\u5361\u4e3a\u5355\u4f4d\u8868\u793a\u51fa\u6765\u3002\n\u63d0\u793a\uff1a\u538b\u5f3a\u53ef\u6839\u636e\u516c\u5f0f$p=g\\rho h$\u8fdb\u884c\u8ba1\u7b97\u3002\n\u5f0f\u4e2d$g=9.8$\u725b\u987f/\u5343\u514b\uff0c$h=760$\u6beb\u7c73$=0.76$\u7c73\uff0c$\\rho=13600$\u5343\u514b/\u7c73$^3$\u3002\n\u8bf7\u6309\u6559\u6750\u91c7\u7528\u7684\u53d6\u6574\u7cbe\u5ea6\u8868\u793a\u7ed3\u679c\u3002",
      "figure_ids": []
    },
    {
      "number": "q1",
      "text": "\u5206\u522b\u5728\u5b66\u6821\u4e2d\u697c\u623f\u7684\u6700\u4f4e\u5c42\u548c\u6700\u9ad8\u5c42\u7528\u65e0\u6db2\u6c14\u538b\u8ba1\u6d4b\u51fa\u5927\u6c14\u538b\u5f3a\u7684\u503c\u3002\n\u6839\u636e\u6240\u5f97\u7684\u6570\u636e\u548c\u672c\u8bfe\u9002\u7528\u7684\u8fd1\u4f3c\u5173\u7cfb\uff0c\u8ba1\u7b97\u8fd9\u4e24\u5c42\u697c\u4e4b\u95f4\u7684\u5782\u76f4\u8ddd\u79bb\u3002\n\u518d\u901a\u8fc7\u5bf9\u8fd9\u4e2a\u8ddd\u79bb\u7684\u76f4\u63a5\u6d4b\u91cf\u8fdb\u884c\u68c0\u9a8c\u3002",
      "figure_ids": []
    }
  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "\u6211\u4eec\u5df2\u7ecf\u77e5\u9053\uff08\u00a752\uff09\uff0c\u5728\u6db2\u4f53\u5185\u90e8\u4e0d\u540c\u6df1\u5ea6\u5904\u538b\u5f3a\u662f\u4e0d\u540c\u7684\u3002\n\u538b\u5f3a\u7684\u5927\u5c0f\u4e0e\u6db2\u4f53\u7684\u5bc6\u5ea6\u53ca\u6db2\u67f1\u7684\u9ad8\u5ea6\u6709\u5173\u3002\n\u7531\u4e8e\u6db2\u4f53\u7684\u53ef\u538b\u7f29\u6027\u6781\u5c0f\uff0c\u6db2\u4f53\u7684\u5bc6\u5ea6\u5728\u4e0d\u540c\u6df1\u5ea6\u5904\u51e0\u4e4e\u4e00\u6837\uff0c\u6240\u4ee5\u5728\u672c\u8bfe\u8ba8\u8bba\u7684\u6761\u4ef6\u4e0b\uff0c\u8ba1\u7b97\u538b\u5f3a\u65f6\u53ef\u4ee5\u628a\u5bc6\u5ea6\u8fd1\u4f3c\u770b\u4f5c\u6052\u91cf\uff0c\u800c\u53ea\u8003\u8651\u6df1\u5ea6\u7684\u53d8\u5316\u3002"
    },
    {
      "block": 1,
      "text": "\u5728\u6c14\u4f53\u4e2d\u95ee\u9898\u5c31\u590d\u6742\u4e86\u3002\n\u6c14\u4f53\u6781\u6613\u88ab\u538b\u7f29\u3002\n\u6309\u672c\u8bfe\u8ba8\u8bba\u7684\u538b\u7f29\u60c5\u5f62\uff0c\u6c14\u4f53\u88ab\u538b\u7f29\u5f97\u8d8a\u5389\u5bb3\uff0c\u5b83\u7684\u5bc6\u5ea6\u5c31\u8d8a\u5927\uff0c\u5b83\u6240\u4ea7\u751f\u7684\u538b\u5f3a\u4e5f\u5c31\u8d8a\u5927\u3002"
    },
    {
      "block": 2,
      "text": "\u5730\u7403\u8868\u9762\u9644\u8fd1\u7684\u4e00\u5c42\u7a7a\u6c14\u53d7\u5230\u5b83\u4e0a\u9762\u6240\u6709\u5404\u5c42\u7a7a\u6c14\u7684\u538b\u7f29\u3002\n\u800c\u8ddd\u79bb\u5730\u7403\u8868\u9762\u8d8a\u9ad8\u7684\u7a7a\u6c14\u5c42\uff0c\u88ab\u538b\u7f29\u7684\u7a0b\u5ea6\u8d8a\u8f7b\uff0c\u5bc6\u5ea6\u4e5f\u5c31\u8d8a\u5c0f\uff0c\u4ece\u800c\u6240\u4ea7\u751f\u7684\u538b\u5f3a\u4e5f\u8d8a\u5c0f\u3002\n\u4f8b\u5982\uff0c\u82e5\u628a\u4e00\u4e2a\u6c14\u7403\u5347\u5230\u5730\u9762\u7684\u4e0a\u7a7a\uff0c\u5219\u7a7a\u6c14\u5bf9\u6c14\u7403\u7684\u538b\u5f3a\u5c31\u8981\u53d8\u5c0f\u3002\n\n\u8fd9\u4e0d\u4ec5\u662f\u56e0\u4e3a\u6c14\u7403\u4e0a\u65b9\u7a7a\u6c14\u67f1\u7684\u9ad8\u5ea6\u51cf\u5c0f\u4e86\uff0c\u800c\u4e14\u4e5f\u662f\u56e0\u4e3a\u9ad8\u5904\u7684\u7a7a\u6c14\u5bc6\u5ea6\u5c0f\u4e8e\u4f4e\u5904\u7684\u7a7a\u6c14\u5bc6\u5ea6\u3002\n\u6240\u4ee5\uff0c\u7a7a\u6c14\u538b\u5f3a\u4e0e\u9ad8\u5ea6\u7684\u5173\u7cfb\u6bd4\u6db2\u4f53\u538b\u5f3a\u4e0e\u6db2\u67f1\u9ad8\u5ea6\u7684\u5173\u7cfb\u8981\u590d\u6742\u3002"
    },
    {
      "block": 3,
      "text": "\u672c\u6559\u6750\u6240\u8ff0\u89c2\u6d4b\u8868\u660e\uff0c\u5728\u6d77\u5e73\u9762\u4e0a\u5404\u5904\u7684\u5927\u6c14\u538b\u5f3a\u5e73\u5747\u4e3a760\u6beb\u7c73\u9ad8\u6c34\u94f6\u67f1\u3002\n\u8ddd\u6d77\u5e73\u9762\u8d8a\u9ad8\u7684\u5730\u65b9\u538b\u5f3a\u8d8a\u5c0f\u3002\n\u8fd9\u91cc\u8ba8\u8bba\u7684\u662f\u6559\u6750\u7ed9\u51fa\u7684\u5e73\u5747\u60c5\u51b5\uff0c\u5e76\u4e0d\u662f\u8bf4\u6bcf\u4e2a\u5730\u70b9\u3001\u6bcf\u4e2a\u65f6\u523b\u7684\u5927\u6c14\u538b\u5f3a\u90fd\u76f8\u540c\u3002"
    },
    {
      "block": 4,
      "text": "**\u4e0e$0^\\circ\\mathrm{C}$\u65f6760\u6beb\u7c73\u9ad8\u6c34\u94f6\u67f1\u6240\u4ea7\u751f\u7684\u538b\u5f3a\u76f8\u7b49\u7684\u5927\u6c14\u538b\u5f3a\u53eb\u505a\u6807\u51c6\u5927\u6c14\u538b\u3002\n**"
    },
    {
      "block": 5,
      "text": "\u6309\u672c\u6559\u6750\u91c7\u7528\u7684\u53d6\u6574\u6570\u503c\uff0c**\u4e00\u4e2a\u6807\u51c6\u5927\u6c14\u538b\u7b49\u4e8e101300\u5e15\u65af\u5361$=101.3$\u5343\u5e15\u65af\u5361$\\approx$100\u5343\u5e15\u65af\u5361\u3002\n**"
    },
    {
      "block": 6,
      "text": "\u56fe152\u6240\u793a\u7684\u5c31\u662f\u672c\u6559\u6750\u7ed9\u51fa\u7684\u5927\u6c14\u538b\u5f3a\u968f\u9ad8\u5ea6\u53d8\u5316\u7684\u60c5\u51b5\u3002\n\u672c\u8bfe\u8fd8\u7ed9\u51fa\u4e00\u4e2a\u7528\u4e8e\u4e0d\u592a\u9ad8\u9ad8\u5ea6\u8303\u56f4\u7684\u8fd1\u4f3c\u89c4\u5f8b\uff1a**\u5728\u4e0d\u592a\u9ad8\u7684\u9ad8\u5ea6\u5185\uff0c\u5e73\u5747\u6bcf\u5347\u9ad812\u7c73\uff0c\u5927\u6c14\u538b\u5f3a\u51cf\u5c111\u6beb\u7c73\u9ad8\u6c34\u94f6\u67f1**\u3002\n\u8fd9\u91cc\u7684\u5e73\u5747\u8fd1\u4f3c\u89c4\u5f8b\u5e76\u4e0d\u662f\u9002\u7528\u4e8e\u6240\u6709\u9ad8\u5ea6\u7684\u6052\u5b9a\u53d8\u5316\u7387\u3002"
    },
    {
      "block": 9,
      "text": "\u77e5\u9053\u4e86\u5927\u6c14\u538b\u5f3a\u968f\u9ad8\u5ea6\u800c\u53d8\u5316\u7684\u5173\u7cfb\uff0c\u5c31\u53ef\u4ee5\u6839\u636e\u6c14\u538b\u8ba1\u793a\u6570\u7684\u53d8\u5316\u6765\u6d4b\u5b9a\u6d77\u62d4\u9ad8\u5ea6\u3002\n\u628a\u5206\u5ea6\u76f4\u63a5\u6807\u6210\u6d77\u62d4\u9ad8\u5ea6\u7684\u65e0\u6db2\u6c14\u538b\u8ba1\uff0c\u53eb\u505a**\u9ad8\u5ea6\u8ba1**\u3002\n\u9ad8\u5ea6\u8ba1\u7528\u4e8e\u822a\u7a7a\u4e0e\u767b\u5c71\u3002\n\n\u672c\u8bfe\u7684\u9ad8\u5ea6\u4f30\u7b97\u5e94\u5728\u6240\u91c7\u7528\u538b\u5f3a\u4e0e\u9ad8\u5ea6\u5173\u7cfb\u7684\u9002\u7528\u6761\u4ef6\u4e0b\u7406\u89e3\u3002"
    }
  ],
