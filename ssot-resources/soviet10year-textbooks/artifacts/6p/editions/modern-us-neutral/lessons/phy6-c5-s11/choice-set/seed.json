  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u4ec0\u4e48\u6837\u7684\u80fd\u91cf\u53eb\u505a\u52bf\u80fd\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4e3e\u51fa\u4e00\u4e9b\u5177\u6709\u52bf\u80fd\u7684\u7269\u4f53\u7684\u4f8b\u5b50\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u5728\u4ec0\u4e48\u60c5\u51b5\u4e0b\u53ef\u4ee5\u628a\u7269\u4f53\u7684\u52bf\u80fd\u89c4\u5b9a\u4e3a\u96f6\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u7528\u4ec0\u4e48\u6765\u91cf\u5ea6\u76f8\u5bf9\u4e8e\u5730\u7403\u8868\u9762\u88ab\u4e3e\u5230\u4e00\u5b9a\u9ad8\u5ea6\u7684\u7269\u4f53\u7684\u52bf\u80fd\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u600e\u6837\u8bf4\u660e\u53d8\u5f62\u7684\u5f39\u7c27\u5177\u6709\u52bf\u80fd\uff1f\n\u7528\u4ec0\u4e48\u6765\u91cf\u5ea6\u8fd9\u79cd\u80fd\u91cf\uff1f\n\u5f53\u5f39\u7c27\u5904\u4e8e\u4ec0\u4e48\u72b6\u6001\u65f6\uff0c\u628a\u5b83\u7684\u52bf\u80fd\u89c4\u5b9a\u4e3a\u96f6\u6700\u65b9\u4fbf\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "**\uff081\uff09\u8d28\u91cf\u4e3a100\u5343\u514b\u7684\u7269\u4f53\u572810\u7c73\u9ad8\u5904\u65f6\uff0c\u76f8\u5bf9\u4e8e\u5730\u7403\u7684\u52bf\u80fd\u662f\u591a\u5c11\uff1f**",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "**\uff082\uff09\u6253\u6869\u673a\u9524\u5934\u7684\u8d28\u91cf\u662f500\u5343\u514b\uff0c\u81ea10\u7c73\u7684\u9ad8\u5904\u843d\u4e0b\u3002**\n**\u5f53\u9524\u5934\u843d\u52304\u7c73\u9ad8\u5904\u65f6\u7684\u52bf\u80fd\u662f\u591a\u5c11\uff1f**\n**\u9524\u5934\u6240\u80fd\u505a\u51fa\u7684\u529f\u4e00\u5171\u662f\u591a\u5c11\uff1f**",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "**\u7531\u7269\u4f53\u4e4b\u95f4\u7684\u76f8\u5bf9\u4f4d\u7f6e\u6216\u540c\u4e00\u7269\u4f53\u5404\u90e8\u5206\u4e4b\u95f4\u7684\u76f8\u5bf9\u4f4d\u7f6e\u6240\u51b3\u5b9a\u7684\u80fd\u91cf\uff0c\u53eb\u505a\u52bf\u80fd\u3002\n**"
    },
    {
      "block": 1,
      "text": "\u4f8b\u5982\uff0c\u76f8\u5bf9\u4e8e\u5730\u7403\u8868\u9762\u88ab\u4e3e\u9ad8\u7684\u7269\u4f53\u5177\u6709\u52bf\u80fd\u3002\n\u8fd9\u79cd\u80fd\u91cf\u4e0e\u7269\u4f53\u548c\u5730\u7403\u7684\u76f8\u5bf9\u4f4d\u7f6e\u53ca\u5b83\u4eec\u4e4b\u95f4\u7684\u5f15\u529b\u6709\u5173\u3002\n\u6211\u4eec\u7ea6\u5b9a\u653e\u5728\u5730\u9762\u4e0a\u7684\u7269\u4f53\u7684\u91cd\u529b\u52bf\u80fd\u4e3a\u96f6\u3002\n\n\u4ee5\u5730\u9762\u4e3a\u96f6\u52bf\u80fd\u53c2\u8003\u9762\u65f6\uff0c\u88ab\u4e3e\u5230\u4e00\u5b9a\u9ad8\u5ea6\u7684\u7269\u4f53\u7684\u52bf\u80fd\uff0c\u53ef\u4ee5\u7528\u91cd\u529b\u5728\u5b83\u843d\u56de\u5730\u9762\u8fc7\u7a0b\u4e2d\u6240\u505a\u7684\u529f\u6765\u91cf\u5ea6\u3002\n\u8fd9\u91cc\u7684\u96f6\u662f\u5bf9\u91cd\u529b\u52bf\u80fd\u53c2\u8003\u72b6\u6001\u7684\u7ea6\u5b9a\uff0c\u5e76\u4e0d\u662f\u8bf4\u7269\u4f53\u7684\u6240\u6709\u80fd\u91cf\u90fd\u4e3a\u96f6\u3002\n\u4f8b\u5982\uff0c\u653e\u5728\u5730\u9762\u4e0a\u7684\u538b\u7f29\u5f39\u7c27\u4ecd\u53ef\u5177\u6709\u5f39\u6027\u52bf\u80fd\u3002"
    },
    {
      "block": 4,
      "text": "\u6253\u5f00\u4e00\u6247\u5f39\u7c27\u95e8\u65f6\uff0c\u6211\u4eec\u62c9\u4f38\u6216\u538b\u7f29\u5f39\u7c27\uff0c\u5bf9\u5f39\u7c27\u505a\u529f\u3002\n\u5f39\u7c27\u83b7\u5f97\u7684\u80fd\u91cf\uff0c\u4f7f\u5b83\u80fd\u5728\u6062\u590d\u5f62\u72b6\u3001\u7f29\u77ed\u6216\u4f38\u957f\u65f6\u505a\u529f\uff0c\u628a\u95e8\u5173\u4e0a\u3002"
    },
    {
      "block": 6,
      "text": "**\u4e00\u5207\u53d1\u751f\u4e86\u5f39\u6027\u5f62\u53d8\u7684\u7269\u4f53\u90fd\u5177\u6709\u52bf\u80fd\u3002\n**\u538b\u7f29\u6c14\u4f53\u50a8\u5b58\u7684\u80fd\u91cf\u5728\u70ed\u673a\u548c\u98ce\u9550\u4e2d\u5f97\u5230\u5e94\u7528\u3002\n\u98ce\u9550\u5e7f\u6cdb\u7528\u4e8e\u77ff\u7269\u5f00\u91c7\u3001\u7b51\u8def\u548c\u6316\u6398\u786c\u571f\u7b49\u5de5\u4f5c\u3002"
    }
  ],
