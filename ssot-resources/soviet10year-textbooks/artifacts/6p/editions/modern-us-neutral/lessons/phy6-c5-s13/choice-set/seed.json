  },
  "exercises": [
    {
      "number": "1",
      "text": "1. \u600e\u6837\u7528\u5b9e\u9a8c\u8868\u660e\uff0c\u673a\u68b0\u80fd\u53ef\u4ee5\u4ece\u4e00\u79cd\u5f62\u5f0f\u8f6c\u5316\u4e3a\u53e6\u4e00\u79cd\u5f62\u5f0f\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u5f53\u4e00\u4e2a\u94a2\u7403\u548c\u4e00\u5757\u94a2\u677f\u78b0\u649e\u65f6\uff0c\u53d1\u751f\u4e86\u54ea\u4e9b\u80fd\u91cf\u8f6c\u5316\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "(1) \u5c06\u4e0b\u5217\u5404\u60c5\u51b5\u4e2d\u6240\u53d1\u751f\u7684\u80fd\u91cf\u8f6c\u5316\u6307\u51fa\u6765\uff1a\n$\\textcircled{1}$ \u7011\u5e03\u7684\u6c34\u5f80\u4e0b\u6d41\uff1b\n$\\textcircled{2}$ \u5c06\u7403\u7ad6\u76f4\u5411\u4e0a\u629b\u51fa\uff1b\n$\\textcircled{3}$ \u5c06\u624b\u8868\u7684\u6e38\u4e1d\u62e7\u7d27\uff1b\n$\\textcircled{4}$ \u524d\u8ff0\u7684\u5173\u4e8e\u5f39\u7c27\u95e8\u7684\u4f8b\u5b50.",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "(2) \u51e0\u4e2a\u843d\u4f53\u7684\u8d28\u91cf\u90fd\u76f8\u540c\u3002\u5728\u540c\u4e00\u91cd\u529b\u573a\u4e2d\uff0c\u4ee5\u540c\u4e00\u9ad8\u5ea6\u9762\u4e3a\u52bf\u80fd\u96f6\u70b9\u6bd4\u8f83\uff0c\u5b83\u4eec\u5728\u540c\u4e00\u9ad8\u5ea6\u65f6\u7684\u52bf\u80fd\u662f\u5426\u76f8\u540c\uff1f\u4ee5\u5730\u9762\u4e3a\u53c2\u8003\u7cfb\uff0c\u5b83\u4eec\u5728\u8fd9\u4e2a\u9ad8\u5ea6\u65f6\u7684\u52a8\u80fd\u662f\u5426\u76f8\u540c\uff1f\u9898\u4e2d\u6ca1\u6709\u7ed9\u51fa\u5b83\u4eec\u7684\u521d\u901f\u5ea6\u6216\u5404\u81ea\u4ece\u54ea\u91cc\u5f00\u59cb\u4e0b\u843d\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "(3) \u8bd5\u4e3e\u51fa\u4e00\u4e9b\u65e2\u5177\u6709\u52a8\u80fd\u53c8\u540c\u65f6\u5177\u6709\u52bf\u80fd\u7684\u7269\u4f53\u7684\u4f8b\u5b50.",
      "figure_ids": []
    },
    {
      "number": "q1",
      "text": "\u7528\u7ebf\u53ca\u5f39\u7c27\u5404\u505a\u4e00\u4e2a\u6446. \u89c2\u5bdf\u8fd9\u4e24\u4e2a\u6446\u7684\u632f\u52a8. \u7b80\u5355\u5730\u63cf\u8ff0\u4e00\u4e0b\u5728\u5b83\u4eec\u632f\u52a8\u7684\u8fc7\u7a0b\u4e2d\u53d1\u751f\u7684\u80fd\u91cf\u53d8\u5316.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5728\u81ea\u7136\u754c\u3001\u5de5\u7a0b\u6280\u672f\u548c\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u7ecf\u5e38\u89c1\u5230\u673a\u68b0\u80fd\u4ece\u4e00\u79cd\u5f62\u5f0f\u8f6c\u5316\u4e3a\u53e6\u4e00\u79cd\u5f62\u5f0f\uff1a\u52bf\u80fd\u8f6c\u5316\u4e3a\u52a8\u80fd\uff0c\u6216\u52a8\u80fd\u8f6c\u5316\u4e3a\u52bf\u80fd\u3002\n\u4f8b\u5982\uff0c\u6c34\u4ece\u5824\u575d\u4e0a\u843d\u4e0b\u65f6\uff0c\u6c34\u7684\u91cd\u529b\u52bf\u80fd\u8f6c\u5316\u4e3a\u52a8\u80fd\u3002"
    }
  ],
