  "concepts": [
    {
      "block": 1,
      "text": "**\u5f53\u4e00\u4e2a\u7269\u4f53\u5728\u53e6\u4e00\u4e2a\u7269\u4f53\u7684\u8868\u9762\u4e0a\u8fd0\u52a8\u65f6\u6240\u4ea7\u751f\u7684\u4e0e\u8fd0\u52a8\u65b9\u5411\u76f8\u53cd\u7684\u529b\u53eb\u505a\u6469\u64e6\u529b**\uff08\u56fe 74\uff09."
    },
    {
      "block": 5,
      "text": "**\u6469\u64e6\u529b\u4ea7\u751f\u7684\u539f\u56e0\u4e4b\u4e00\u662f\u76f8\u4e92\u63a5\u89e6\u7684\u7269\u4f53\u7c97\u7cd9\u4e0d\u5e73.**\n\u751a\u81f3\u770b\u8d77\u6765\u5f88\u5149\u6ed1\u7684\u7269\u4f53\u8868\u9762\uff0c\u5b9e\u9645\u4e0a\u4e5f\u90fd\u5177\u6709\u7a81\u8d77\u3001\u5212\u75d5\uff0c\u4e5f\u662f\u51f8\u51f9\u4e0d\u5e73\u7684.\n\u56fe 75(a) \u6240\u793a\u7684\u5c31\u662f\u628a\u8fd9\u79cd\u51f8\u51f9\u4e0d\u5e73\u653e\u5927\u4ee5\u540e\u7684\u60c5\u5f62.\n\n\u5f53\u4e00\u4e2a\u7269\u4f53\u5728\u53e6\u4e00\u4e2a\u7269\u4f53\u7684\u8868\u9762\u4e0a\u6ed1\u52a8\u6216\u6eda\u52a8\u65f6\uff0c\u8fd9\u4e9b\u51f8\u51f9\u4e0d\u5e73\u7684\u5730\u65b9\u5c31\u5f7c\u6b64\u5d4c\u5408\uff0c\u4ece\u800c\u4ea7\u751f\u4e86\u963b\u788d\u8fd0\u52a8\u7684\u529b."
    },
    {
      "block": 8,
      "text": "**\u4ea7\u751f\u6469\u64e6\u529b\u7684\u53e6\u4e00\u4e2a\u539f\u56e0\u662f\u76f8\u4e92\u63a5\u89e6\u7684\u7269\u4f53\u7684\u5206\u5b50\u4e4b\u95f4\u7684\u5f15\u529b.**"
    },
    {
      "block": 9,
      "text": "\u5f53\u76f8\u4e92\u63a5\u89e6\u7684\u7269\u4f53\u8868\u9762\u4e0d\u5e73\uff0c\u52a0\u5de5\u7c97\u7cd9\u65f6\uff0c\u6469\u64e6\u529b\u7684\u4ea7\u751f\u4e3b\u8981\u53d6\u51b3\u4e8e\u7b2c\u4e00\u79cd\u539f\u56e0.\n\u4f46\u662f\u82e5\u7269\u4f53\u7684\u8868\u9762\u78e8\u5f97\u5f88\u5149\uff0c\u5219\u5f53\u5b83\u4eec\u76f8\u4e92\u63a5\u89e6\u65f6\uff0c\u5b83\u4eec\u7684\u4e00\u90e8\u5206\u5206\u5b50\u5c31\u5f7c\u6b64\u76f8\u8ddd\u5f88\u8fd1\uff0c\u4ee5\u81f3\u8fd9\u4e9b\u5206\u5b50\u95f4\u7684\u5f15\u529b\u5c31\u663e\u8457\u5730\u8868\u73b0\u51fa\u6765\u4e86."
    },
    {
      "block": 10,
      "text": "\u5982\u679c\u5728\u6469\u64e6\u9762\u95f4\u52a0\u4e00\u4e9b\u6da6\u6ed1\u5242\uff0c\u5219\u6469\u64e6\u529b\u53ef\u4ee5\u51cf\u5c0f\u597d\u591a\u500d.\n\u6da6\u6ed1\u5c42\uff08\u56fe 75(b)\uff09\u628a\u6469\u64e6\u7269\u7684\u8868\u9762\u9694\u5f00\uff0c\u9632\u6b62\u5b83\u4eec\u5f7c\u6b64\u63a5\u89e6.\n\u8fd9\u65f6\u4e92\u76f8\u6ed1\u8fc7\u7684\u5c31\u4e0d\u662f\u7269\u4f53\u7684\u8868\u9762\uff0c\u800c\u662f\u6da6\u6ed1\u5c42\u4e86.\n\n\u5728\u591a\u6570\u60c5\u51b5\u4e0b\u6240\u7528\u7684\u6da6\u6ed1\u5242\u90fd\u662f\u6db2\u4f53\uff0c\u800c\u6db2\u4f53\u5c42\u4e4b\u95f4\u7684\u6469\u64e6\u6bd4\u56fa\u4f53\u8868\u9762\u95f4\u7684\u6469\u64e6\u5c0f.\n\u5728\u51b0\u9762\u4e0a\u6ed1\u52a8\uff0c\u4f8b\u5982\u4eba\u6ed1\u51b0\u65f6\u6469\u64e6\u5c0f\uff0c\u4e5f\u53ef\u4ee5\u7528\u6da6\u6ed1\u5242\u7684\u4f5c\u7528\u6765\u89e3\u91ca\uff1a\u5728\u51b0\u5200\u548c\u51b0\u4e4b\u95f4\u5f62\u6210\u4e00\u8584\u5c42\u6c34\uff0c\u8fd9\u6c34\u5c31\u8d77\u4e86\u6da6\u6ed1\u5242\u7684\u4f5c\u7528.\n\u5728\u5de5\u7a0b\u6280\u672f\u4e2d\u5e7f\u6cdb\u91c7\u7528\u5404\u79cd\u6cb9\u7c7b\u505a\u6da6\u6ed1\u5242."
    },
    {
      "block": 11,
      "text": "\u5f53\u4e00\u4e2a\u7269\u4f53\u5728\u53e6\u4e00\u4e2a\u7269\u4f53\u7684\u8868\u9762\u4e0a\u6ed1\u52a8\u65f6\u6240\u4ea7\u751f\u7684\u6469\u64e6\u53eb\u505a**\u6ed1\u52a8\u6469\u64e6**.\n\u4f8b\u5982\uff0c\u96ea\u6a47\u53ca\u6ed1\u96ea\u677f\u5728\u96ea\u4e0a\u6ed1\u884c\u65f6\u5c31\u4ea7\u751f\u8fd9\u79cd\u6ed1\u52a8\u6469\u64e6."
    },
    {
      "block": 12,
      "text": "\u5982\u679c\u4e00\u4e2a\u7269\u4f53\u4e0d\u662f\u5728\u53e6\u4e00\u4e2a\u7269\u4f53\u4e0a\u6ed1\u52a8\uff0c\u800c\u662f\u5728\u5b83\u4e0a\u9762\u6eda\u52a8\uff0c\u5219\u8fd9\u65f6\u4ea7\u751f\u7684\u6469\u64e6\u53eb\u505a**\u6eda\u52a8\u6469\u64e6**.\n\u4f8b\u5982\u5f53\u706b\u8f66\u6216\u6c7d\u8f66\u7684\u8f66\u8f6e\u6eda\u52a8\u65f6\uff0c\u4ee5\u53ca\u5728\u5730\u9762\u4e0a\u6eda\u52a8\u5706\u6728\u6216\u6728\u6876\u65f6\u5c31\u4ea7\u751f\u6eda\u52a8\u6469\u64e6."
    }
  ],
