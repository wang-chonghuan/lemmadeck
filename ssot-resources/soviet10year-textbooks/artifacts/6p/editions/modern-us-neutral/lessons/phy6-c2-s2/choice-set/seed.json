  "exercises": [
    {
      "number": "1",
      "text": "\u54ea\u4e9b\u73b0\u8c61\u53ef\u4ee5\u8bf4\u660e\u7269\u8d28\u662f\u7531\u5f7c\u6b64\u95f4\u6709\u7a7a\u9699\u7684\u7c92\u5b50\u7ec4\u6210\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u5f53\u7ec4\u6210\u7269\u4f53\u7684\u7c92\u5b50\u95f4\u7684\u8ddd\u79bb\u51cf\u5c0f\u6216\u589e\u5927\u65f6\uff0c\u7269\u4f53\u7684\u4f53\u79ef\u5c06\u5982\u4f55\u53d8\u5316\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u600e\u6837\u8bc1\u660e\u7ec4\u6210\u7269\u4f53\u7684\u7c92\u5b50\u662f\u5f88\u5c0f\u7684\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u7528\u624b\u538b\u4e00\u4e2a\u76ae\u7403\uff0c\u5219\u5145\u5728\u76ae\u7403\u5185\u7684\u7a7a\u6c14\u7684\u4f53\u79ef\u5c31\u8981\u51cf\u5c0f.\u901a\u8fc7\u538b\u7f29\uff0c\u540c\u6837\u53ef\u4ee5\u4f7f\u4e00\u5757\u6a61\u76ae\u6216\u4e00\u5757\u8702\u8721\u7684\u4f53\u79ef\u51cf\u5c0f."
    },
    {
      "block": 1,
      "text": "\u5f53\u7269\u4f53\u53d8\u70ed\u6216\u53d8\u51b7\u65f6\uff0c\u5b83\u7684\u4f53\u79ef\u4e5f\u4f1a\u53d1\u751f\u53d8\u5316. \u56fe 11 \u6240\u793a\u7684\u662f\u4e00\u4e2a\u73bb\u7483\u70e7\u74f6\uff0c\u74f6\u9888\u6d78\u5728\u6c34\u4e2d. \u5f53\u5bf9\u70e7\u74f6\u52a0\u70ed\u65f6\uff0c\u7a7a\u6c14\u5c31\u628a\u6c34\u4ece\u74f6\u9888\u4e2d\u6392\u51fa\uff0c\u5e76\u5f00\u59cb\u6709\u6c14\u6ce1\u5f80\u5916\u5192\uff0c\u8fd9\u8868\u660e\u7a7a\u6c14\u53d7\u70ed\u65f6\u4f53\u79ef\u589e\u5927\u4e86\uff08\u56fe 11\uff0ca\uff09. \u800c\u5f53\u70e7\u74f6\u51b7\u5374\u65f6\uff0c\u6c34\u5c31\u8fdb\u5165\u74f6\u5185\uff0c\u8fd9\u8868\u660e\u7559\u5728\u74f6\u5185\u7684\u7a7a\u6c14\u7684\u4f53\u79ef\u51cf\u5c0f\u4e86\uff08\u56fe 11\uff0cb\uff09."
    },
    {
      "block": 4,
      "text": "\u672c\u6765\u53ef\u4ee5\u81ea\u7531\u7a7f\u8fc7\u4e00\u4e2a\u73af\u7684\u94a2\u7403\uff0c\u53d7\u70ed\u540e\u81a8\u80c0\u4e86\uff0c\u5c31\u5361\u5728\u73af\u4e2d\uff08\u56fe 12\uff09. \u5f53\u7403\u51b7\u5374\u540e\uff0c\u5176\u4f53\u79ef\u53c8\u91cd\u65b0\u7f29\u5c0f\uff0c\u5c31\u53c8\u53ef\u4ee5\u4ece\u73af\u4e2d\u7a7f\u8fc7\u53bb\u4e86."
    },
    {
      "block": 7,
      "text": "\u6db2\u4f53\u53d7\u70ed\u81a8\u80c0\u7684\u73b0\u8c61\u4e5f\u53ef\u4ee5\u901a\u8fc7\u56fe 13 \u6240\u793a\u7684\u5b9e\u9a8c\uff0c\u7531\u7ba1\u4e2d\u6db2\u9762\u9ad8\u5ea6\u7684\u589e\u957f\u770b\u51fa."
    },
    {
      "block": 11,
      "text": "\u53ea\u8981\u8bbe\u60f3\u7269\u8d28\u662f\u7531\u5f7c\u6b64\u95f4\u5177\u6709\u7a7a\u9699\u7684\u7c92\u5b50\u7ec4\u6210\u7684\uff0c\u8fd9\u4e2a\u73b0\u8c61\u5c31\u53ef\u4ee5\u5f97\u5230\u89e3\u91ca. \u5f53\u7ec4\u6210\u7269\u4f53\u7684\u7c92\u5b50\u4e92\u76f8\u79bb\u5f00\u65f6\uff0c\u7269\u4f53\u7684\u4f53\u79ef\u5c31\u589e\u5927. \u800c\u5f53\u8fd9\u4e9b\u7c92\u5b50\u4e92\u76f8\u9760\u8fd1\u65f6\uff0c\u7269\u4f53\u7684\u4f53\u79ef\u5c31\u51cf\u5c0f. \u5728\u79d1\u5b66\u4e0a\uff0c\u8fd9\u79cd\u8bbe\u60f3\u53eb\u505a\u5047\u8bf4. \u5047\u8bf4\u662f\u5426\u6b63\u786e\u8981\u9760\u5b9e\u9a8c\u6765\u68c0\u9a8c."
    },
    {
      "block": 12,
      "text": "\u4f46\u4e3a\u4ec0\u4e48\u6211\u4eec\u603b\u662f\u89c9\u5f97\u5404\u79cd\u7269\u8d28\u2014\u2014\u7a7a\u6c14\u3001\u6c34\u3001\u94a2\u7b49\u2014\u2014\u90fd\u662f\u8fde\u7eed\u7684\u5462\uff1f\n\u8fd9\u662f\u56e0\u4e3a\u7ec4\u6210\u7269\u8d28\u7684\u7c92\u5b50\u592a\u5c0f\u4e86\uff0c\u5c0f\u5f97\u6211\u4eec\u6839\u672c\u770b\u4e0d\u89c1\u5b83\u4eec."
    },
    {
      "block": 14,
      "text": "\u6211\u4eec\u6765\u89c2\u5bdf\u6700\u540e\u4e00\u6b21\u7684\u6eb6\u6db2\uff0c\u6eb6\u6db2\u4f9d\u7136\u662f\u5747\u5300\u5e26\u8272\u7684\uff0c\u5c3d\u7ba1\u989c\u8272\u5df2\u7ecf\u5f88\u6d45\u4e86. \u53ef\u89c1\u5728\u6bcf\u4e00\u6ef4\u8fd9\u6837\u7684\u6eb6\u6db2\u91cc\uff0c\u4ecd\u4fdd\u6301\u6709\u989c\u6599\u7684\u7c92\u5b50. \u672c\u6765\u6eb6\u5728\u6c34\u4e2d\u7684\u989c\u6599\u5c31\u662f\u5f88\u5c0f\u7684\u4e00\u7c92\uff0c\u800c\u5728\u6700\u540e\u4e00\u676f\u6eb6\u6db2\u91cc\u7684\u989c\u6599\u53c8\u53ea\u662f\u8fd9\u4e00\u5c0f\u7c92\u7684\u4e00\u90e8\u5206. \u53ef\u89c1\u8fd9\u4e00\u7c92\u989c\u6599\u4e00\u5b9a\u662f\u7531\u8bb8\u8bb8\u591a\u591a\u6781\u5c0f\u6781\u5c0f\u7684\u7c92\u5b50\u7ec4\u6210\u7684."
    }
  ],
