  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u7528\u54ea\u4e9b\u4f8b\u5b50\u53ef\u4ee5\u8bf4\u660e\u529f\u548c\u80fd\u662f\u76f8\u4e92\u8054\u7cfb\u7740\u7684\u4e24\u4e2a\u7269\u7406\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5728\u4ec0\u4e48\u60c5\u51b5\u4e0b\u53ef\u4ee5\u8bf4\u7269\u4f53\u5177\u6709\u80fd\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u80fd\u91cf\u7684\u91cf\u5ea6\u5355\u4f4d\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u5e94\u7528\u201c\u80fd\u91cf\u201d\u7684\u6982\u5ff5\u53ef\u4ee5\u7ed9\u529f\u4e0b\u4e00\u4e2a\u4ec0\u4e48\u6837\u7684\u5b9a\u4e49\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 16,
      "text": "**\u5982\u679c\u4e00\u4e2a\u7269\u4f53\uff0c\u6216\u76f8\u4e92\u4f5c\u7528\u7684\u51e0\u4e2a\u7269\u4f53\u7ec4\u6210\u7684\u7269\u4f53\u7cfb\u80fd\u591f\u505a\u529f\uff0c\u5c31\u8bf4\u8fd9\u4e2a\u7269\u4f53\u6216\u7269\u4f53\u7cfb\u5177\u6709\u80fd\u91cf\u3002**"
    },
    {
      "block": 18,
      "text": "\u80fd\u91cf\u662f\u4e00\u79cd\u7528\u6765\u8868\u793a\u7269\u4f53\uff08\u6216\u7269\u4f53\u7cfb\uff09\u505a\u529f\u80fd\u529b\u7684\u7269\u7406\u91cf\uff0c\u53ef\u4ee5\u7528\u5b83\u6240\u80fd\u505a\u7684\u529f\u6765\u91cf\u5ea6\u3002\n\u6240\u4ee5\uff0c\u80fd\u91cf\u4e0e\u529f\u7684\u5355\u4f4d\u76f8\u540c\uff0c\u90fd\u662f\u7126\u8033\u3002"
    },
    {
      "block": 19,
      "text": "**\u7269\u4f53\u80fd\u591f\u505a\u7684\u529f\u8d8a\u591a\uff0c\u5b83\u5177\u6709\u7684\u80fd\u91cf\u5c31\u8d8a\u5927\u3002**"
    },
    {
      "block": 20,
      "text": "\u505a\u529f\u662f\u7269\u4f53\u4e4b\u95f4\u8f6c\u79fb\u80fd\u91cf\u7684\u4e00\u79cd\u65b9\u5f0f\u3002\n\u5728\u672c\u8bfe\u8fd9\u4e9b\u901a\u8fc7\u505a\u529f\u8f6c\u79fb\u80fd\u91cf\u7684\u8fc7\u7a0b\u4e2d\uff0c\u7269\u4f53\u5bf9\u5916\u505a\u529f\u65f6\u8f93\u51fa\u80fd\u91cf\uff0c\u5916\u754c\u5bf9\u7269\u4f53\u505a\u529f\u65f6\u5411\u5b83\u8f93\u5165\u80fd\u91cf\u3002\n**\u82e5\u6240\u8ba8\u8bba\u7684\u7269\u4f53\u6216\u7269\u4f53\u7cfb\u6ca1\u6709\u5176\u4ed6\u80fd\u91cf\u4f20\u9012\u9014\u5f84\uff0c\u505a\u529f\u7684\u5927\u5c0f\u7b49\u4e8e\u5176\u80fd\u91cf\u53d8\u5316\u7684\u5927\u5c0f**\u3002\n\n\u5bf9\u5916\u8f93\u51fa\u5bf9\u5e94\u80fd\u91cf\u51cf\u5c11\uff0c\u5916\u754c\u8f93\u5165\u5bf9\u5e94\u80fd\u91cf\u589e\u52a0\uff1b\n\u4e0d\u80fd\u628a\u201c\u505a\u529f\u201d\u4e00\u5f8b\u7406\u89e3\u4e3a\u7269\u4f53\u7684\u80fd\u91cf\u589e\u52a0\u3002"
    }
  ],
