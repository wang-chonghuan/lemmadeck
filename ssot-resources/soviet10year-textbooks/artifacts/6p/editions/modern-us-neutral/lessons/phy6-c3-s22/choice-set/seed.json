    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u8fd9\u91cc\u5148\u628a\u7269\u4f53\u770b\u4f5c\u8d28\u70b9\uff0c\u6216\u53ea\u7814\u7a76\u5b83\u6574\u4f53\u7684\u5e73\u52a8\uff1b\n\u51e0\u4e2a\u5916\u529b\u5bf9\u8fd9\u4e00\u8fd0\u52a8\u7684\u5408\u6210\u6548\u679c\uff0c\u53ef\u4ee5\u7528\u5b83\u4eec\u7684\u5408\u529b\u6765\u8868\u793a. \u7269\u4f53\u7684\u8f6c\u52a8\u548c\u5f62\u53d8\u4e0d\u4e00\u5b9a\u80fd\u7528\u4e00\u4e2a\u529b\u5b8c\u6574\u4ee3\u66ff."
    },
    {
      "block": 2,
      "text": "**\u5728\u4e0a\u8ff0\u53ea\u7814\u7a76\u6574\u4f53\u5e73\u52a8\u7684\u8303\u56f4\u5185\uff0c\u5982\u679c\u4e00\u4e2a\u529b\u5bf9\u7269\u4f53\u6574\u4f53\u5e73\u52a8\u7684\u4f5c\u7528\u6548\u679c\u4e0e\u51e0\u4e2a\u529b\u540c\u65f6\u4f5c\u7528\u5bf9\u7269\u4f53\u6574\u4f53\u5e73\u52a8\u7684\u4f5c\u7528\u6548\u679c\u76f8\u540c\uff0c\u5219\u8fd9\u4e2a\u529b\u5c31\u53eb\u505a\u8fd9\u51e0\u4e2a\u529b\u7684\u5408\u529b.**"
    },
    {
      "block": 3,
      "text": "\u6c42\u51e0\u4e2a\u529b\u7684\u5408\u529b\u53eb\u505a**\u628a\u8fd9\u4e9b\u529b\u5408\u6210**\uff0c\u6216\u53eb\u505a**\u6c42\u8fd9\u4e9b\u529b\u7684\u548c**.\n\u8fd9\u51e0\u4e2a\u88ab\u5408\u6210\u7684\u529b\u4e5f\u53eb\u505a**\u5206\u529b**. \u8fd9\u91cc\u7684\u548c\u8981\u540c\u65f6\u8003\u8651\u529b\u7684\u5927\u5c0f\u548c\u65b9\u5411\uff0c\u4e0d\u80fd\u4e0d\u95ee\u65b9\u5411\u5c31\u628a\u5927\u5c0f\u76f8\u52a0\uff1b\n\u6240\u5408\u6210\u7684\u662f\u4f5c\u7528\u5728\u540c\u4e00\u7269\u4f53\u4e0a\u7684\u529b\uff0c\u5408\u529b\u4e0d\u662f\u518d\u52a0\u4e0a\u7684\u4e00\u4e2a\u989d\u5916\u529b."
    }
  ],
