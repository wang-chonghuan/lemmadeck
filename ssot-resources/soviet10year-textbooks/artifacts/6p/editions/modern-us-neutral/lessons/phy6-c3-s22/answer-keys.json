    {
      "exercise": "1",
      "prompt": "（1）什么样的力叫做几个力的合力？",
      "figureEvidence": [],
      "grading": "ungraded",
      "source": "derived",
      "displayAnswer": "在把物体看作质点或只研究它整体平动的范围内，如果一个力单独作用的效果与几个力同时作用对这一运动产生的效果相同，这个力就叫作这几个力的合力。合力表示分力的合成作用，不是在原有分力之外又加上的一个真实外力。",
      "parts": [],
      "historical_entities": []
    },
    {
      "exercise": "2",
      "prompt": "（2）什么叫力的合成？",
      "figureEvidence": [],
      "grading": "ungraded",
      "source": "derived",
      "displayAnswer": "求同时作用于同一物体上的几个力的合力，叫作力的合成，也叫求这些力的和。求和要同时考虑力的大小和方向；参加合成的各个力叫作分力。",
      "parts": [],
      "historical_entities": []
    }
  ],
  "count": 2
}
