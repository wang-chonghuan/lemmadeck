    {
      "block": 3,
      "text": "\u77e5\u9053\u7269\u4f53\u505a\u5300\u901f\u8fd0\u52a8\u65f6\u901a\u8fc7\u7684\u8def\u7a0b\u548c\u901f\u5ea6\uff0c\u5c31\u80fd\u8ba1\u7b97\u8fd0\u52a8\u6240\u9700\u7684\u65f6\u95f4\u3002"
    },
    {
      "block": 7,
      "text": "\u8ba1\u7b97\u53d8\u901f\u8fd0\u52a8\u7684\u5e73\u5747\u901f\u5ea6\u65f6\uff0c\u6211\u4eec\u628a\u8fd9\u6bb5\u8fd0\u52a8\u770b\u4f5c\u5300\u901f\u8fd0\u52a8\u3002\n\u56e0\u6b64\uff0c\u5df2\u77e5\u5e73\u5747\u901f\u5ea6\uff0c\u4e5f\u53ef\u4ee5\u7528\u8ba1\u7b97\u5300\u901f\u8fd0\u52a8\u8def\u7a0b\u7684\u65b9\u6cd5\u6765\u6c42\u8def\u7a0b\u3002\n\u7269\u4f53\u505a\u53d8\u901f\u8fd0\u52a8\u65f6\uff0c\u901a\u8fc7\u7684\u8def\u7a0b\u7b49\u4e8e\u8fd9\u6bb5\u8fd0\u52a8\u7684\u5e73\u5747\u901f\u5ea6\u4e58\u4ee5\u8fd0\u52a8\u65f6\u95f4\uff1a"
    },
    {
      "block": 8,
      "text": "$s=v_{\\text{\u5e73\u5747}}t$\u3002"
