  "exercises": [
    {
      "number": "1",
      "text": "\u77e5\u9053\u7269\u4f53\u505a\u5300\u901f\u8fd0\u52a8\u7684\u901f\u5ea6\u548c\u8fd0\u52a8\u65f6\u95f4\uff0c\u600e\u6837\u6c42\u51fa\u5b83\u901a\u8fc7\u7684\u8def\u7a0b\uff1f\n\u77e5\u9053\u8def\u7a0b\u548c\u901f\u5ea6\uff0c\u53c8\u600e\u6837\u6c42\u51fa\u5300\u901f\u8fd0\u52a8\u6240\u9700\u7684\u65f6\u95f4\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u5982\u679c\u7269\u4f53\u505a\u53d8\u901f\u8fd0\u52a8\uff0c\u4e0a\u9762\u7684\u95ee\u9898\u53c8\u8be5\u600e\u6837\u56de\u7b54\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\u4e00\u67b6\u98de\u673a\u4ee5 750 \u5343\u7c73/\u5c0f\u65f6\u7684\u901f\u5ea6\u98de\u884c\uff0c\u98de\u884c 6 \u5c0f\u65f6\u901a\u8fc7\u7684\u8def\u7a0b\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\u56fe 32 \u8868\u793a\u5300\u901f\u8fd0\u52a8\u7684\u8def\u7a0b\u968f\u65f6\u95f4\u7684\u53d8\u5316\u3002\n\u56fe\u4e2d\u7684 $os$ \u8f74\u8868\u793a\u8def\u7a0b\uff0c$ot$ \u8f74\u8868\u793a\u65f6\u95f4\u3002\n\u6839\u636e\u56fe\u50cf\uff0c\u6c42\u51fa\u7269\u4f53\u5728 10 \u5c0f\u65f6\u5185\u901a\u8fc7\u7684\u8def\u7a0b\u548c\u8fd0\u52a8\u901f\u5ea6\u3002",
      "figure_ids": [
        "fig-32"
      ]
    },
    {
      "number": "5",
      "text": "\u56fe 33 \u4e2d\u7684\u4e24\u6761\u56fe\u7ebf\u5206\u522b\u8868\u793a\u5300\u901f\u8fd0\u52a8 I \u548c II \u7684\u8def\u7a0b\u968f\u65f6\u95f4\u7684\u53d8\u5316\u3002\n\u54ea\u4e00\u4e2a\u8fd0\u52a8\u7684\u901f\u5ea6\u66f4\u5927\uff1f\u8bf7\u6839\u636e\u56fe\u50cf\u8bf4\u660e\u7406\u7531\u3002",
      "figure_ids": [
        "fig-33"
      ]
    },
    {
      "number": "6",
      "text": "\u56fe 34 \u8868\u793a\u4e00\u4e2a\u505a\u5300\u901f\u8fd0\u52a8\u7684\u7269\u4f53\u7684\u901f\u5ea6\u968f\u65f6\u95f4\u7684\u53d8\u5316\u3002\n\u7269\u4f53\u7684\u8fd0\u52a8\u901f\u5ea6\u662f\u591a\u5c11\uff1f\u5b83\u5728 5 \u79d2\u5185\u901a\u8fc7\u7684\u8def\u7a0b\u662f\u591a\u5c11\uff1f",
