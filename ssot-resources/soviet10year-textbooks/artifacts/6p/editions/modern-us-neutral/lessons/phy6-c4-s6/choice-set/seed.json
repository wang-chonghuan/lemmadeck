  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u6db2\u4f53\u5bf9\u5bb9\u5668\u5e95\u7684\u538b\u5f3a\u90fd\u4e0e\u4ec0\u4e48\u91cf\u6709\u5173\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u6db2\u4f53\u5bf9\u5bb9\u5668\u5e95\u7684\u538b\u5f3a\u4e0e\u6db2\u67f1\u7684\u9ad8\u5ea6\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u6db2\u4f53\u5bf9\u5bb9\u5668\u5e95\u7684\u538b\u5f3a\u4e0e\u6db2\u4f53\u7684\u5bc6\u5ea6\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u8981\u8ba1\u7b97\u6db2\u4f53\u5bf9\u5bb9\u5668\u58c1\u7684\u538b\u5f3a\uff0c\u9700\u8981\u77e5\u9053\u54ea\u4e9b\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u7528\u4ec0\u4e48\u516c\u5f0f\u6765\u8ba1\u7b97\u6db2\u4f53\u5bf9\u5bb9\u5668\u5e95\u53ca\u5bb9\u5668\u58c1\u7684\u538b\u5f3a\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u8bd5\u5206\u522b\u8ba1\u7b97\u5728\u6c34\u4e2d\u3001\u7164\u6cb9\u4e2d\u4ee5\u53ca\u6c34\u94f6\u4e2d0.6\u7c73\u6df1\u5904\u7684\u538b\u5f3a\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u8bd5\u8ba1\u7b97\u6d77\u6c34\u5bf9\u4e8e\u6df1\u5ea6\u4e3a10900\u7c73\u7684\u6d77\u6d0b\u76c6\uff08\u6700\u6df1\u7684\u6d77\u6d0b\u76c6\u4e4b\u4e00\uff09\u5e95\u6240\u4ea7\u751f\u7684\u538b\u5f3a\u3002\n\u6d77\u6c34\u7684\u5bc6\u5ea6\u662f1030\u5343\u514b/\u7c73$^3$\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u56fe115\u6240\u793a\u7684\u662f\u4e00\u4e2a\u8db3\u7403\u80c6\uff0c\u5b83\u4e0e\u4e00\u6839\u7ad6\u76f4\u653e\u7f6e\u7684\u73bb\u7483\u7ba1\u76f8\u63a5\uff0c\u7403\u80c6\u548c\u73bb\u7483\u7ba1\u4e2d\u88c5\u4e0a\u6c34\uff0c\u5728\u7403\u80c6\u4e0a\u653e\u4e00\u5c0f\u5757\u6728\u677f\uff0c\u5728\u6728\u677f\u4e0a\u518d\u653e\u4e00\u4e2a5\u5343\u514b\u7684\u781d\u7801\uff0c\u8fd9\u65f6\u7ba1\u4e2d\u6c34\u67f1\u7684\u9ad8\u5ea6\u662f1\u7c73\u3002\n\u8bd5\u6c42\u6728\u677f\u4e0e\u7403\u80c6\u7684\u63a5\u89e6\u9762\u79ef\u3002",
      "figure_ids": [
        "fig-115"
      ]
    },
    {
      "number": "g3-1",
      "text": "\uff081\uff09\u53d6\u4e00\u4e2a\u6bd4\u8f83\u9ad8\u7684\u5bb9\u5668\uff0c\u5728\u5b83\u4fa7\u58c1\u7684\u540c\u4e00\u6761\u76f4\u7ebf\u4e0a\u7684\u4e0d\u540c\u9ad8\u5ea6\u5904\u6253\u4e09\u4e2a\u5c0f\u5b54\u3002\n\u5148\u7528\u706b\u67f4\u68cd\u628a\u5b54\u5835\u4f4f\uff0c\u5c06\u5bb9\u5668\u4e2d\u704c\u6ee1\u6c34\u3002\n\u7136\u540e\u5c06\u5b54\u6253\u5f00\uff0c\u89c2\u5bdf\u6d41\u51fa\u6765\u7684\u4e09\u80a1\u6c34\u7684\u60c5\u51b5\uff08\u56fe116\uff09\u3002\n\n\u8bd5\u56de\u7b54\u4ee5\u4e0b\u7684\u95ee\u9898\uff1a\u6c34\u4e3a\u4ec0\u4e48\u4ece\u5c0f\u5b54\u4e2d\u6d41\u51fa\uff1f\n\u5728\u5bb9\u5668\u8868\u9762\u9644\u8fd1\u5404\u80a1\u6c34\u6d41\u7684\u65b9\u5411\u662f\u600e\u6837\u7684\uff1f\n\u8fd9\u8bf4\u660e\u4ec0\u4e48\uff1f\n\n\u4e3a\u4ec0\u4e48\u5404\u80a1\u6c34\u6d41\u7684\u5f62\u72b6\u90fd\u662f\u5f2f\u66f2\u7684\uff1f\n\u5982\u4f55\u89e3\u91ca\u4ece\u5404\u5b54\u4e2d\u6d41\u51fa\u7684\u6c34\u5c04\u5f97\u8fdc\u8fd1\u4e0d\u540c\uff1f",
      "figure_ids": [
        "fig-116"
      ]
    },
    {
      "number": "g3-2",
      "text": "\uff082\uff09\u56fe117\uff0ca\u6240\u793a\u7684\u662f\u4e00\u4e2a\u73bb\u7483\u74f6\uff0c\u5176\u4e2d\u88c5\u4e86\u534a\u74f6\u6c34\uff0c\u6c34\u7684\u4e0a\u65b9\u662f\u7a7a\u6c14\u3002\n\u74f6\u53e3\u7528\u585e\u5b50\u5835\u4e25\uff0c\u901a\u8fc7\u585e\u5b50\u7a7f\u5165\u56db\u6839\u73bb\u7483\u7ba1\uff0c\u5176\u4e2d\u4e09\u6839\u7684\u4e0b\u7aef\u90fd\u6d78\u5165\u6c34\u4e2d\uff0c\u7b2c\u56db\u6839\u7684\u4e0b\u7aef\u5728\u6c34\u4e0a\uff0c\u800c\u5b83\u7684\u4e0a\u7aef\u63a5\u7740\u4e00\u4e2a\u6a61\u76ae\u7684\u6253\u6c14\u7403\u3002\n\u6d78\u5165\u6c34\u91cc\u7684\u7ba1\u5b50\u4e2d\u7684\u4e24\u6839\u662f\u5f2f\u7684\uff0c\u5176\u5f2f\u66f2\u60c5\u51b5\u5982\u56fe\u6240\u793a\u3002\n\n\u7528\u624b\u538b\u4f4f\u6253\u6c14\u7403\uff0c\u6216\u5728\u6253\u6c14\u7403\u4e0a\u653e\u4e00\u4e2a\u91cd\u7269\u3002\n\u5219\u5404\u73bb\u7483\u7ba1\u4e2d\u7684\u6c34\u9762\u5c31\u90fd\u5347\u5f97\u6bd4\u74f6\u4e2d\u7684\u6c34\u9762\u9ad8\uff0c\u800c\u4e14\u5347\u8d77\u7684\u9ad8\u5ea6\u662f\u76f8\u540c\u7684\uff08\u56fe117\uff0cb\uff09\u3002\n\u4f60\u4e5f\u5236\u4f5c\u4e00\u4e2a\u8fd9\u6837\u7684\u4eea\u5668\uff0c\u5e76\u7528\u5b83\u6765\u505a\u8fd9\u4e2a\u5b9e\u9a8c\u3002\n\n\u53ef\u4ee5\u4e0d\u7528\u6253\u6c14\u7403\u800c\u7528\u522b\u7684\u65b9\u6cd5\u6765\u5bf9\u74f6\u4e2d\u7684\u7a7a\u6c14\u52a0\u538b\uff0c\u4f8b\u5982\u53ef\u4ee5\u901a\u8fc7\u4e00\u6839\u6a61\u76ae\u7ba1\u7528\u5634\u5411\u74f6\u4e2d\u5439\u6c14\u3002\n\u600e\u6837\u89e3\u91ca\u5404\u73bb\u7483\u7ba1\u4e2d\u7684\u6c34\u5347\u5f97\u4e00\u6837\u9ad8\uff1f\n\u7528\u8fd9\u4e2a\u4eea\u5668\u53ef\u4ee5\u68c0\u9a8c\u54ea\u4e00\u6761\u5b9a\u5f8b\uff1f\n\n\u628a\u5404\u73bb\u7483\u7ba1\u4e0b\u7aef\u7684\u5f00\u53e3\u7f6e\u4e8e\u6c34\u4e2d\u4e0d\u540c\u6df1\u5ea6\u5904\uff0c\u91cd\u505a\u8fd9\u4e2a\u5b9e\u9a8c\u3002\n\u8fd9\u65f6\uff0c\u5404\u7ba1\u4e2d\u7684\u6c34\u9762\u5347\u9ad8\u5f97\u662f\u5426\u76f8\u540c\uff1f\n\u8bd5\u5bf9\u8fd9\u4e2a\u5b9e\u9a8c\u7684\u7ed3\u679c\u52a0\u4ee5\u89e3\u91ca\u3002",
      "figure_ids": [
        "fig-117"
      ]
    }
  ],
  "concepts": [
    {
      "block": 8,
      "text": "\u628a\u5bb9\u5668\u4e2d\u6db2\u67f1\u7684\u9ad8\u5ea6\u7528\u5b57\u6bcd$h$\u8868\u793a\uff0c\u6db2\u4f53\u7684\u5bc6\u5ea6\u7528$\\rho$\u8868\u793a\uff0c\u800c\u5bb9\u5668\u7684\u5e95\u9762\u79ef\u7528$S$\u8868\u793a\u3002"
    },
    {
      "block": 11,
      "text": "\u6db2\u4f53\u7684\u91cd\u91cf$P=gm$\uff0c\u6216$P=g\\rho Sh$\u3002"
    },
    {
      "block": 12,
      "text": "\u7531\u4e8e\u6db2\u67f1\u7684\u91cd\u91cf\u7b49\u4e8e\u6db2\u4f53\u5bf9\u5bb9\u5668\u5e95\u7684\u538b\u529b\uff0c\u6545\u5c06\u91cd\u91cf$P$\u9664\u4ee5\u9762\u79ef$S$\uff0c\u5c31\u5f97\u5230\u538b\u5f3a$p$\uff1a\n$p=\\frac{P}{S}$\uff0c\n\u6216$p=\\frac{g\\rho Sh}{S}$\u3002"
    },
    {
      "block": 13,
      "text": "\u5373 $p=g\\rho h$\u3002"
    },
    {
      "block": 14,
      "text": "\u8fd9\u6837\uff0c\u6211\u4eec\u5c31\u5f97\u5230\u4e86\u8ba1\u7b97\u6db2\u4f53\u5bf9\u5bb9\u5668\u5e95\u7684\u538b\u5f3a\u7684\u516c\u5f0f\u3002\n\u7531\u8fd9\u4e2a\u516c\u5f0f\u53ef\u4ee5\u770b\u51fa\uff0c**\u6db2\u4f53\u5bf9\u5bb9\u5668\u5e95\u7684\u538b\u5f3a\u4e0e\u6db2\u4f53\u7684\u5bc6\u5ea6\u53ca\u6db2\u67f1\u7684\u9ad8\u5ea6\u6210\u6b63\u6bd4**\u3002"
    },
    {
      "block": 15,
      "text": "\u6839\u636e\u8fd9\u4e2a\u516c\u5f0f\u4e5f\u53ef\u4ee5\u8ba1\u7b97\u6db2\u4f53\u5bf9\u5bb9\u5668\u58c1\u7684\u538b\u5f3a\u53ca\u6db2\u4f53\u5185\u90e8\u7684\u538b\u5f3a\uff0c\u65b9\u5411\u5411\u4e0a\u7684\u538b\u5f3a\u4e5f\u5305\u62ec\u5728\u5185\u3002\n\u8fd9\u662f\u56e0\u4e3a\u5728\u540c\u4e00\u6df1\u5ea6\u5904\u5411\u5404\u65b9\u5411\u7684\u538b\u5f3a\u90fd\u76f8\u7b49\u3002"
    },
    {
      "block": 16,
      "text": "**\u6839\u636e**\u516c\u5f0f$p=\\rho gh$**\u8ba1\u7b97\u538b\u5f3a\u65f6\uff0c\u5bc6\u5ea6**$\\rho$**\u7684\u5355\u4f4d\u5e94\u53d6\u5343\u514b/\u7c73**$^3$\uff0c**\u6db2\u67f1\u9ad8\u5ea6**$h$**\u7684\u5355\u4f4d\u5e94\u53d6\u7c73\uff0c\u800c**$g=9.8$\u725b\u987f/\u5343\u514b\uff0c**\u8fd9\u6837\u538b\u5f3a\u7684\u5355\u4f4d\u5c31\u662f**\u725b\u987f/\u7c73$^2$\u6216\u5e15\u65af\u5361\u3002"
    }
  ],
