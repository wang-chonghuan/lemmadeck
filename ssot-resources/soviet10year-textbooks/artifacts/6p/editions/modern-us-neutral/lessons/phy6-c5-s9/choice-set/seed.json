      "number": "1",
      "text": "\uff081\uff09\u4ec0\u4e48\u529f\u53eb\u4f5c\u6709\u7528\u529f\uff1f\u4ec0\u4e48\u529f\u53eb\u4f5c\u603b\u529f\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4f7f\u7528\u673a\u68b0\u63d0\u5347\u91cd\u7269\u6216\u514b\u670d\u5176\u4ed6\u7c7b\u578b\u7684\u963b\u529b\u65f6\uff0c\u4e3a\u4ec0\u4e48\u6709\u7528\u529f\u4e0e\u603b\u529f\u4e0d\u76f8\u7b49\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u4ec0\u4e48\u662f\u673a\u68b0\u6548\u7387\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u7528\u6709\u7528\u529f\u4e0e\u603b\u529f\u4e4b\u6bd4\u8868\u793a\u7684\u673a\u68b0\u6548\u7387\u80fd\u4e0d\u80fd\u5927\u4e8e1\uff1f\u4e3a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u7814\u7a76\u6760\u6746\u7684\u7ed3\u6784\u548c\u4f5c\u7528\u539f\u7406\u65f6\uff0c\u6211\u4eec\u66fe\u5ffd\u7565\u6469\u64e6\u548c\u6760\u6746\u672c\u8eab\u7684\u91cd\u91cf\u3002\n\u5728\u8fd9\u79cd\u7406\u60f3\u6761\u4ef6\u4e0b\uff0c\u65bd\u52a0\u5728\u6760\u6746\u4e0a\u7684\u52a8\u529b\u6240\u505a\u7684\u529f\uff0c\u79f0\u4e3a**\u603b\u529f**\uff1b\n\u5b83\u7b49\u4e8e\u63d0\u5347\u91cd\u7269\u6216\u514b\u670d\u67d0\u79cd\u963b\u529b\u6240\u505a\u7684**\u6709\u7528\u529f**\u3002"
    },
    {
      "block": 1,
      "text": "\u5b9e\u9645\u4f7f\u7528\u673a\u68b0\u65f6\uff0c**\u6240\u505a\u7684\u603b\u529f\u603b\u662f\u591a\u4e8e\u6709\u7528\u529f**\uff0c\u56e0\u4e3a\u4e00\u90e8\u5206\u529f\u8fd8\u8981\u7528\u4e8e\u514b\u670d\u673a\u68b0\u4e2d\u7684\u6469\u64e6\u963b\u529b\uff0c\u4ee5\u53ca\u4f7f\u673a\u68b0\u7684\u67d0\u4e9b\u90e8\u4ef6\u79fb\u52a8\u3002"
    },
    {
      "block": 2,
      "text": "\u4f8b\u5982\uff0c\u7528\u52a8\u6ed1\u8f6e\u63d0\u5347\u91cd\u7269\u65f6\uff0c\u8fd8\u8981\u505a\u4e00\u90e8\u5206\u9644\u52a0\u7684\u529f\uff0c\u7528\u6765\u63d0\u5347\u6ed1\u8f6e\u672c\u8eab\u548c\u7ef3\u5b50\uff0c\u5e76\u514b\u670d\u6ed1\u8f6e\u8f74\u5904\u7684\u6469\u64e6\u3002"
    },
    {
      "block": 3,
      "text": "\u5bf9\u4e8e\u4e0a\u8ff0\u5b9e\u9645\u673a\u68b0\uff0c\u6709\u7528\u529f\u53ea\u662f\u603b\u529f\u7684\u4e00\u90e8\u5206\u3002\n\u7528$A_{\\text{\u6709\u7528}}$\u8868\u793a\u6709\u7528\u529f\uff0c\u7528$A$\u8868\u793a\u603b\u529f\uff0c\u53ef\u4ee5\u5199\u6210"
    },
    {
      "block": 4,
      "text": "$A_{\\text{\u6709\u7528}}<A$\uff0c\n\u6216$\\frac{A_{\\text{\u6709\u7528}}}{A}<1$\u3002"
    },
    {
      "block": 5,
      "text": "**\u6709\u7528\u529f\u4e0e\u603b\u529f\u7684\u6bd4\u503c\u79f0\u4e3a\u673a\u68b0\u6548\u7387**\uff0c\u7528\u7b26\u53f7$K$\u8868\u793a\uff0c\u5373"
    },
    {
      "block": 6,
      "text": "$K=\\frac{A_{\\text{\u6709\u7528}}}{A}$\u3002"
    },
    {
      "block": 7,
      "text": "\u673a\u68b0\u6548\u7387\u901a\u5e38\u8868\u793a\u4e3a\u767e\u5206\u6570\uff0c\u5373"
    },
    {
      "block": 8,
      "text": "**$K=\\frac{A_{\\text{\u6709\u7528}}}{A}\\times100\\%$\u3002\n**"
    }
  ],
