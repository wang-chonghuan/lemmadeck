    "view": {
      "mode": "multiple",
      "stem": "均匀物体的质量为 $m$，体积为 $V$，密度为 $\\rho$，这些量均为正且单位一致。哪些关系成立？",
      "figure_ids": [],
      "options": [
        {
          "id": "A",
          "text": "已知密度和体积时，质量为 $m=\\rho V$。",
          "figure_ids": []
        },
        {
          "id": "B",
          "text": "已知质量和密度时，体积为 $V=\\frac{m}{\\rho}$。",
          "figure_ids": []
        },
        {
          "id": "C",
          "text": "密度固定时，体积变为原来的两倍，质量变为原来的一半。",
          "figure_ids": []
        },
        {
          "id": "D",
          "text": "质量固定时，密度变为原来的两倍，体积也变为原来的两倍。",
          "figure_ids": []
        }
      ]
    }
  }
]
