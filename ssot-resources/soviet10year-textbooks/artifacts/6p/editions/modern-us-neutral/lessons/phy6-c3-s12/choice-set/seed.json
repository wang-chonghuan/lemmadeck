  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u4ec0\u4e48\u53eb\u505a\u7269\u8d28\u7684\u5bc6\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5199\u51fa\u94c1\u7684\u5bc6\u5ea6\u7b49\u4e8e\u4ec0\u4e48\uff1f\u4f60\u6240\u5199\u51fa\u6765\u7684\u6570\u53ca\u5176\u5355\u4f4d\u540d\u79f0\u5404\u8868\u793a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u600e\u6837\u8ba1\u7b97\u7269\u8d28\u7684\u5bc6\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u82e5\u5bc6\u5ea6\u662f\u7528\u5343\u514b/\u7c73$^3$\u4f5c\u5355\u4f4d\u7ed9\u51fa\u7684\uff0c\u600e\u6837\u7528\u514b/\u5398\u7c73$^3$\u4f5c\u5355\u4f4d\u628a\u5b83\u8868\u793a\u51fa\u6765\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u7a00\u6709\u91d1\u5c5e\u9507\u7684\u5bc6\u5ea6\u662f $22500$ \u5343\u514b/\u7c73$^3$\uff0c\u8fd9\u4e2a\u6570\u8868\u793a\u7684\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u4e09\u4e2a\u7acb\u65b9\u4f53\u5206\u522b\u7531\u5927\u7406\u77f3\u3001\u51b0\u53ca\u9ec4\u94dc\u6784\u6210\uff0c\u5b83\u4eec\u7684\u4f53\u79ef\u90fd\u76f8\u540c\uff0c\u95ee\u5176\u4e2d\u54ea\u4e00\u5757\u7684\u8d28\u91cf\u6700\u5927\uff1f\u54ea\u4e00\u5757\u7684\u8d28\u91cf\u6700\u5c0f\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u4e24\u4e2a\u7269\u4f53\u7684\u8d28\u91cf\u90fd\u662f $2$ \u5343\u514b\uff0c\u4e00\u4e2a\u662f\u9676\u78c1\u7684\uff0c\u4e00\u4e2a\u662f\u94c1\u7684. \u95ee\u54ea\u4e00\u4e2a\u7684\u4f53\u79ef\u5927\uff1f\u4e3a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-4",
      "text": "\uff084\uff09\u6700\u8f7b\u7684\u6728\u6599\u662f\u5df4\u91cc\u8428\u6728. $100$ \u5398\u7c73$^3$\u8fd9\u79cd\u6728\u6599\u7684\u8d28\u91cf\u662f $12$\u514b. \u8bd5\u5206\u522b\u7528\u514b/\u5398\u7c73$^3$\u53ca\u5343\u514b/\u7c73$^3$\u4f5c\u5355\u4f4d\u8ba1\u7b97\u5df4\u91cc\u8428\u6728\u7684\u5bc6\u5ea6.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 6,
      "text": "**\u67d0\u79cd\u7269\u8d28\u7684\u5bc6\u5ea6\u662f\u8fd9\u6837\u7684\u4e00\u4e2a\u91cf\uff0c\u5b83\u5728\u6570\u503c\u4e0a\u7b49\u4e8e\u5355\u4f4d\u4f53\u79ef\u8be5\u7269\u8d28\u7684\u8d28\u91cf.**"
    },
    {
      "block": 8,
      "text": "**$1$ \u5343\u514b/\u7c73$^3$\u5c31\u662f\u7269\u8d28\u5bc6\u5ea6\u7684\u5355\u4f4d.**"
    },
    {
      "block": 12,
      "text": "**\u4e3a\u4e86\u6c42\u51fa\u7ec4\u6210\u7269\u4f53\u7684\u7269\u8d28\u7684\u5bc6\u5ea6\uff0c\u9700\u5c06\u7269\u4f53\u7684\u8d28\u91cf\u9664\u4ee5\u7269\u4f53\u7684\u4f53\u79ef\uff1a**"
    },
    {
      "block": 13,
      "text": "$\\text{\u5bc6\u5ea6}=\\frac{\\text{\u8d28\u91cf}}{\\text{\u4f53\u79ef}}$."
    },
    {
      "block": 14,
      "text": "\u5c06\u5404\u91cf\u7528\u5b57\u6bcd\u8868\u793a\uff1a\n$\\rho$\u2014\u2014\u7269\u8d28\u7684\u5bc6\u5ea6\uff0c$m$\u2014\u2014\u7269\u4f53\u7684\u8d28\u91cf\uff0c$V$\u2014\u2014\u7269\u4f53\u7684\u4f53\u79ef. \u5219\u8ba1\u7b97\u7269\u8d28\u5bc6\u5ea6\u7684\u516c\u5f0f\u53ef\u8868\u793a\u5982\u4e0b\uff1a"
    },
    {
      "block": 15,
      "text": "$\\rho=\\frac{m}{V}$."
    }
  ],
