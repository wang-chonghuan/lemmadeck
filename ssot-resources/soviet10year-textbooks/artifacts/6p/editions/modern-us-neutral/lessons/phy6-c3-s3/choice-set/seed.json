  "exercises": [
    {
      "number": "1",
      "text": "\u6b65\u884c\u8005\u3001\u6c7d\u8f66\u548c\u98de\u673a\u7684\u5300\u901f\u8fd0\u52a8\u5f7c\u6b64\u4e4b\u95f4\u7684\u533a\u522b\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u5300\u901f\u8fd0\u52a8\u7684\u901f\u5ea6\u8868\u793a\u7684\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u5df2\u77e5\u7269\u4f53\u6240\u901a\u8fc7\u7684\u8def\u7a0b\u548c\u8fd0\u52a8\u7684\u65f6\u95f4\uff0c\u600e\u6837\u6c42\u8fd0\u52a8\u7684\u901f\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\u600e\u6837\u4ee5\u5343\u7c73/\u5c0f\u65f6\u3001\u7c73/\u79d2\u4e3a\u5355\u4f4d\u6765\u8868\u793a\u7ed9\u5b9a\u7684\u901f\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\u7269\u4f53\u7684\u901f\u5ea6\u9664\u4e86\u6570\u503c\u4ee5\u5916\uff0c\u8fd8\u9700\u7528\u4ec0\u4e48\u6765\u8868\u5f81\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\u6d6e\u5728\u6cb3\u4e2d\u7684\u6728\u7b4f\u5728 20 \u5206\u949f\u5185\u901a\u8fc7\u4e86 900 \u7c73\u7684\u8def\u7a0b. \u8bd5\u6c42\u6728\u7b4f\u7684\u901f\u5ea6\uff0c\u7528\u7c73/\u79d2\u8868\u793a.",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\u5300\u901f\u524d\u8fdb\u7684\u9a91\u8f66\u4eba\u5728 30 \u5206\u949f\u5185\u901a\u8fc7\u4e86 9 \u5343\u7c73\u7684\u8def\u7a0b. \u8bd5\u6c42\u9a91\u8f66\u4eba\u7684\u901f\u5ea6\uff0c\u7528\u7c73/\u79d2\u8868\u793a.",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\u4e00\u53f0 23 \u578b\u7535\u6c14\u673a\u8f66\u7684\u901f\u5ea6\u662f 90 \u5343\u7c73/\u5c0f\u65f6\uff0c\u8bd5\u4ee5\u7c73/\u79d2\u4e3a\u5355\u4f4d\u8868\u793a\u8fd9\u4e2a\u901f\u5ea6.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u6b65\u884c\u8005\u3001\u6c7d\u8f66\u548c\u98de\u673a\u7684\u8fd0\u52a8\u53ef\u4ee5\u7528\u901f\u5ea6\u6765\u533a\u522b. \u54ea\u4e00\u4e2a\u7269\u4f53\u5728\u5355\u4f4d\u65f6\u95f4\u5185\u901a\u8fc7\u7684\u8def\u7a0b\u957f\uff0c\u8fd9\u4e2a\u7269\u4f53\u8fd0\u52a8\u65f6\u7684\u901f\u5ea6\u5c31\u5927."
    },
    {
      "block": 2,
      "text": "\u5300\u901f\u8fd0\u52a8\u7684\u901f\u5ea6\u662f\u8fd9\u6837\u4e00\u4e2a\u91cf\uff0c\u5b83\u5728\u6570\u503c\u4e0a\u7b49\u4e8e\u7269\u4f53\u5728\u5355\u4f4d\u65f6\u95f4\u5185\u6240\u901a\u8fc7\u7684\u8def\u7a0b."
    },
    {
      "block": 9,
      "text": "\u4e3a\u4e86\u6c42\u51fa\u505a\u5300\u901f\u8fd0\u52a8\u7269\u4f53\u7684\u901f\u5ea6\uff0c\u9700\u7528\u8be5\u7269\u4f53\u5728\u4efb\u4e00\u6bb5\u65f6\u95f4\u95f4\u9694\u5185\u6240\u901a\u8fc7\u7684\u8def\u7a0b\u9664\u4ee5\u8fd9\u6bb5\u65f6\u95f4\uff1a"
    },
    {
      "block": 19,
      "text": "\u7531\u6b64\u53ef\u89c1\uff0c\u901f\u5ea6\u4e5f\u548c\u4efb\u4f55\u5176\u5b83\u7684\u7269\u7406\u91cf\uff08\u957f\u5ea6\u3001\u4f53\u79ef\u7b49\uff09\u4e00\u6837\uff0c\u5176\u6570\u503c\u7684\u5927\u5c0f\u4e0e\u9009\u7528\u4ec0\u4e48\u6837\u7684\u6d4b\u91cf\u5355\u4f4d\u6709\u5173."
    },
    {
      "block": 20,
      "text": "\u7269\u4f53\u7684\u901f\u5ea6\u4e0d\u4ec5\u7528\u6570\u503c\uff0c\u5e76\u4e14\u8fd8\u9700\u7528\u65b9\u5411\u6765\u8868\u5f81."
    }
  ],
