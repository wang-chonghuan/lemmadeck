    "view": {
      "mode": "multiple",
      "stem": "步行者、汽车和飞机各自做匀速运动。关于速度的意义及运动快慢的比较，下列哪些说法正确？",
      "figure_ids": [],
      "options": [
        {
          "id": "a",
          "text": "速度大小的数值表示物体在单位时间内通过的路程。",
          "figure_ids": []
        },
        {
          "id": "b",
          "text": "各自做匀速运动的物体，速度大小必定相同。",
          "figure_ids": []
        },
        {
          "id": "c",
          "text": "在相同时间内，通过路程较长的物体速度大小较大。",
          "figure_ids": []
        },
        {
          "id": "d",
          "text": "通过的总路程相同的物体，速度大小必定相同。",
          "figure_ids": []
        }
      ]
    }
  },
  {
    "id": "rate-and-units",
    "source_numbers": [
      "3",
      "4"
    ],
    "view": {
      "mode": "single",
      "stem": "某物体做匀速运动。路程以km为单位的数值为s，所用时间以h为单位的数值为t，且s、t均为正数。下列哪一组速度表示对任意这样的s、t都成立？每组依次用km/h和m/s表示同一速度大小。",
      "figure_ids": [],
      "options": [
        {
          "id": "a",
          "text": "$\\dfrac{s}{t}\\text{ km/h}$；$\\dfrac{18s}{5t}\\text{ m/s}$",
          "figure_ids": []
        },
        {
          "id": "b",
          "text": "$\\dfrac{s}{t}\\text{ km/h}$；$\\dfrac{5s}{18t}\\text{ m/s}$",
          "figure_ids": []
        },
        {
          "id": "c",
          "text": "$\\dfrac{t}{s}\\text{ km/h}$；$\\dfrac{5t}{18s}\\text{ m/s}$",
          "figure_ids": []
        },
        {
          "id": "d",
          "text": "$\\dfrac{s}{t}\\text{ km/h}$；$\\dfrac{s}{t}\\text{ m/s}$",
          "figure_ids": []
        }
      ]
    }
  },
