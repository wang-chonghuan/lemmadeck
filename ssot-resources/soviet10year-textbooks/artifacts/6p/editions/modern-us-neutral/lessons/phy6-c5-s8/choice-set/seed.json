  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u6760\u6746\u4fdd\u6301\u5e73\u8861\u65f6\uff0c\u4f5c\u7528\u5728\u6760\u6746\u4e0a\u7684\u529b\u4e0e\u529b\u81c2\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u7cfb\uff08\u53c2\u770b\u56fe181\uff09\uff1f",
      "figure_ids": [
        "fig-181"
      ]
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5728\u672c\u8282\u7406\u60f3\u6760\u6746\u7f13\u6162\u8f6c\u52a8\u7684\u6a21\u578b\u4e2d\uff0c\u4e24\u529b\u4f5c\u7528\u70b9\u901a\u8fc7\u7684\u8def\u7a0b\u4e0e\u529b\u7684\u5927\u5c0f\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u4f7f\u7528\u6760\u6746\u80fd\u4e0d\u80fd\u7701\u529b\uff1f\u5982\u679c\u80fd\u591f\u7701\u529b\uff0c\u9700\u8981\u591a\u8d39\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u7528\u672c\u8282\u7684\u52a8\u6ed1\u8f6e\u63d0\u5347\u91cd\u7269\u65f6\uff0c\u7ef3\u7aef\u9700\u8981\u901a\u8fc7\u591a\u5c11\u500d\u7684\u8def\u7a0b\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u529b\u5b66\u7684\u201c\u9ec4\u91d1\u5b9a\u5f8b\u201d\u7684\u5185\u5bb9\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "**\uff081\uff09\u7528\u672c\u8282\u7684\u52a8\u6ed1\u8f6e\u5c06\u91cd\u7269\u63d0\u5347\u4e861.5\u7c73\uff0c\u7ef3\u7684\u81ea\u7531\u7aef\u88ab\u62c9\u52a8\u7684\u8ddd\u79bb\u6709\u591a\u957f\uff1f**",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "**\uff082\uff09\u7528\u672c\u8282\u7684\u52a8\u6ed1\u8f6e\u5c06\u91cd\u7269\u63d0\u5347\u4e867\u7c73\uff0c\u5de5\u4eba\u5bf9\u7ef3\u7aef\u7684\u62c9\u529b\u4e3a160\u725b\u987f\u3002\u4ed6\u5728\u63d0\u5347\u8fc7\u7a0b\u4e2d\u505a\u4e86\u591a\u5c11\u529f\uff1f\u5982\u679c\u53ea\u628a\u91cd\u7269\u63d0\u5347\u4e865\u7c73\uff0c\u4ed6\u505a\u7684\u529f\u53c8\u662f\u591a\u5c11\uff1f**",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "**\uff083\uff09\u600e\u6837\u4f7f\u7528\u52a8\u6ed1\u8f6e\u6765\u8fbe\u5230\u8282\u7701\u8ddd\u79bb\u7684\u76ee\u7684\uff1f**",
      "figure_ids": []
    },
    {
      "number": "q1",
      "text": "**\u8bd5\u8bc1\u660e\u7b49\u529f\u539f\u7406\uff08\u529b\u5b66\u7684\u201c\u9ec4\u91d1\u5b9a\u5f8b\u201d\uff09\u4e5f\u9002\u7528\u4e8e\u6db2\u538b\u673a\u3002**\n**\u63d0\u793a\uff1a\u8bc1\u660e\u65f6\u5229\u7528\u56fe100\u3002**\n**\u5f53\u5c0f\u6d3b\u585e\u5728\u529b$F_1$\u7684\u4f5c\u7528\u4e0b\u4e0b\u964d\u4e00\u6bb5\u8ddd\u79bb$h_1$\u65f6\uff0c\u5b83\u6392\u6324\u51fa\u4e00\u5b9a\u4f53\u79ef\u7684\u6db2\u4f53\uff1b\u5927\u6d3b\u585e\u4e0b\u65b9\u589e\u52a0\u76f8\u540c\u4f53\u79ef\u7684\u6db2\u4f53\uff0c\u540c\u65f6\u5927\u6d3b\u585e\u4e0a\u5347\u4e00\u6bb5\u9ad8\u5ea6$h_2$\u3002**\n**\u6309\u672c\u8282\u7684\u7406\u60f3\u6db2\u538b\u673a\u6a21\u578b\uff0c\u6db2\u4f53\u89c6\u4e3a\u4e0d\u53ef\u538b\u7f29\u4e14\u4e0d\u6cc4\u6f0f\uff1b\u5ffd\u7565\u6d3b\u585e\u4e0e\u7f38\u58c1\u4e4b\u95f4\u7684\u6469\u64e6\uff0c\u4ee5\u53ca\u6db2\u4f53\u81ea\u8eab\u91cd\u529b\u548c\u5176\u4ed6\u635f\u8017\u3002**",
      "figure_ids": [
        "fig-100"
      ]
    }
  ],
  "concepts": [
    {
      "block": 6,
      "text": "\u53ef\u89c1\uff0c\u5728\u4e0a\u8ff0\u7406\u60f3\u6a21\u578b\u4e2d\uff0c**\u628a\u529b\u65bd\u52a0\u5728\u6760\u6746\u8f83\u957f\u7684\u529b\u81c2\u4e00\u7aef\u53ef\u4ee5\u7701\u529b\uff0c\u4f46\u7701\u591a\u5c11\u500d\u7684\u529b\uff0c\u5c31\u8981\u591a\u8d70\u591a\u5c11\u500d\u7684\u8def\u7a0b**\u3002"
    },
    {
      "block": 7,
      "text": "\u8ba1\u7b97\u529f\u65f6\uff0c\u5e94\u4f7f\u7528\u529b\u7684\u5927\u5c0f\u4e0e\u6cbf\u8be5\u529b\u65b9\u5411\u7684\u4f4d\u79fb\u5927\u5c0f\uff0c\u800c\u4e0d\u80fd\u628a\u4efb\u610f\u66f2\u7ebf\u7684\u5f27\u957f\u76f4\u63a5\u5f53\u4f5c\u505a\u529f\u8ddd\u79bb\u3002\n\u56fe\u4e2d\u7684\u5f27\u5f62\u8fd0\u52a8\u793a\u610f\u4e24\u7aef\u884c\u7a0b\u7684\u5dee\u522b\uff1b\n\u5728\u672c\u8282\u7684\u7406\u60f3\u3001\u7f13\u6162\u8fd0\u52a8\u6a21\u578b\u4e2d\uff0c\u6bd4\u8f83\u52a8\u529b\u8f93\u5165\u7684\u529f\u4e0e\u8d1f\u8f7d\u83b7\u5f97\u7684\u529f\u7684\u5927\u5c0f\uff0c\u53ef\u5f97"
    },
    {
      "block": 15,
      "text": "\u52a8\u6ed1\u8f6e\u7684\u8f93\u5165\u529f\u548c\u8f93\u51fa\u529f\u4e5f\u53ef\u4ee5\u6d4b\u91cf\u3001\u6bd4\u8f83\u3002\n\u5ffd\u7565\u6469\u64e6\u3001\u6ed1\u8f6e\u548c\u7ef3\u7684\u81ea\u91cd\uff0c\u7ef3\u4e0d\u53ef\u4f38\u957f\uff0c\u91cd\u7269\u7f13\u6162\u4e0a\u5347\u65f6\uff0c\u7528\u56fe196\u7684\u52a8\u6ed1\u8f6e\u628a\u91cd\u7269\u63d0\u5347$h$\u9ad8\u5ea6\uff0c\u7cfb\u7740\u6d4b\u529b\u8ba1\u7684\u7ef3\u7aef\u5fc5\u987b\u4e0a\u5347$2h$\u3002\n\u8fd9\u8bf4\u660e\uff0c**\u7701\u4e86\u4e00\u534a\u7684\u529b\uff0c\u5374\u8981\u901a\u8fc72\u500d\u7684\u8def\u7a0b**\uff1b\n\n**\u4f7f\u7528\u52a8\u6ed1\u8f6e\u4e5f\u4e0d\u80fd\u7701\u529f**\u3002"
    },
    {
      "block": 18,
      "text": "\u5927\u91cf\u5b9e\u8df5\u8868\u660e\uff0c**\u4f7f\u7528\u4efb\u4f55\u673a\u68b0\u90fd\u4e0d\u80fd\u7701\u529f**\u3002\n\u4f7f\u7528\u4e0d\u540c\u673a\u68b0\uff0c\u662f\u4e3a\u4e86\u5728\u4e0d\u540c\u5de5\u4f5c\u6761\u4ef6\u4e0b\u7701\u529b\u6216\u7701\u8def\u7a0b\uff1b\n\u7406\u60f3\u60c5\u51b5\u4e0b\uff0c\u8f93\u5165\u529f\u7b49\u4e8e\u6709\u7528\u7684\u8f93\u51fa\u529f\uff0c\u5b9e\u9645\u673a\u68b0\u4e2d\u7684\u6469\u64e6\u4ee5\u53ca\u63d0\u5347\u673a\u68b0\u81ea\u8eab\u7b49\u8fd8\u9700\u8981\u989d\u5916\u505a\u529f\uff0c\u4e0d\u80fd\u628a\u7406\u60f3\u7b49\u529f\u5173\u7cfb\u65e0\u6761\u4ef6\u5957\u7528\u4e8e\u5b9e\u9645\u603b\u529f\u3002"
    },
    {
      "block": 19,
      "text": "\u672c\u6559\u6750\u6307\u51fa\uff0c\u53e4\u4ee3\u5b66\u8005\u5df2\u7ecf\u77e5\u9053\u8fd9\u6761\u9002\u7528\u4e8e\u673a\u68b0\u7684\u89c4\u5f8b\uff1a\u5728\u4e0a\u8ff0\u7406\u60f3\u6761\u4ef6\u4e0b\uff0c**\u7701\u591a\u5c11\u500d\u7684\u529b\uff0c\u5c31\u8981\u8d39\u591a\u5c11\u500d\u7684\u8ddd\u79bb**\u3002\n\u8fd9\u5c31\u662f**\u529b\u5b66\u7684\u201c\u9ec4\u91d1\u5b9a\u5f8b\u201d**\u3002"
    }
  ],
