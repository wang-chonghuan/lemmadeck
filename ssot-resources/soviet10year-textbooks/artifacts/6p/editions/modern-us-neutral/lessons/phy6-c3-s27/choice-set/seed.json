  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u5728\u4eba\u548c\u52a8\u7269\u7684\u751f\u6d3b\u4e2d\uff0c\u6469\u64e6\u5177\u6709\u4ec0\u4e48\u610f\u4e49\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u6469\u64e6\u5bf9\u4e8e\u4ea4\u901a\u8fd0\u8f93\u5177\u6709\u4ec0\u4e48\u610f\u4e49\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u4f60\u77e5\u9053\u54ea\u4e9b\u51cf\u5c0f\u6469\u64e6\u7684\u65b9\u6cd5\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u5728\u673a\u5668\u4e2d\u4f7f\u7528\u8f74\u627f\u7684\u76ee\u7684\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u6ed1\u52a8\u8f74\u627f\u548c\u6eda\u73e0\u8f74\u627f\u7684\u6784\u9020\u5404\u662f\u600e\u6837\u7684\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6469\u64e6\u5728\u81ea\u7136\u754c\u548c\u5de5\u7a0b\u6280\u672f\u4e2d\u6709\u91cd\u8981\u4f5c\u7528\u3002\n\u5b83\u662f\u5426\u6709\u76ca\uff0c\u53d6\u51b3\u4e8e\u6211\u4eec\u8981\u5b8c\u6210\u7684\u4efb\u52a1\u3002\n\u5e2e\u52a9\u884c\u8d70\u3001\u63e1\u4f4f\u7269\u4f53\u6216\u5236\u52a8\u7684\u6469\u64e6\u5e94\u5f53\u5229\u7528\uff1b\n\n\u4f7f\u673a\u5668\u8fd0\u52a8\u90e8\u4ef6\u53d1\u70ed\u548c\u78e8\u635f\u7684\u6469\u64e6\u5219\u5e94\u5c3d\u91cf\u51cf\u5c0f\u3002"
    },
    {
      "block": 1,
      "text": "\u4eba\u548c\u52a8\u7269\u901a\u5e38\u4f9d\u9760\u811a\u4e0e\u5730\u9762\u4e4b\u95f4\u7684\u9759\u6469\u64e6\u884c\u8d70\u3002\n\u811a\u5411\u540e\u8e6c\u5730\u65f6\uff0c\u5730\u9762\u5bf9\u811a\u7684\u6469\u64e6\u529b\u5e2e\u52a9\u8eab\u4f53\u5411\u524d\u8fd0\u52a8\uff1b\n\u978b\u5e95\u4e0e\u5730\u9762\u4e4b\u95f4\u82e5\u5bb9\u6613\u6ed1\u52a8\uff0c\u5c31\u96be\u4ee5\u8e6c\u5730\u3002\n\n\u7ed3\u51b0\u7684\u8def\u9762\u5bb9\u6613\u4f7f\u811a\u6253\u6ed1\u3002\n\u5728\u7ed3\u51b0\u7684\u4eba\u884c\u9053\u4e0a\u6492\u6c99\uff0c\u53ef\u4ee5\u6539\u5584\u978b\u5e95\u4e0e\u8def\u9762\u4e4b\u95f4\u7684\u6293\u5730\u6761\u4ef6\uff0c\u5e2e\u52a9\u9632\u6ed1\u3002"
    },
    {
      "block": 2,
      "text": "\u7528\u624b\u63e1\u4f4f\u7269\u4f53\u65f6\uff0c\u624b\u4e0e\u7269\u4f53\u4e4b\u95f4\u7684\u6469\u64e6\u53ef\u4ee5\u963b\u6b62\u7269\u4f53\u76f8\u5bf9\u624b\u6ed1\u52a8\u3002\n\u5982\u679c\u6469\u64e6\u4e0d\u8db3\uff0c\u7269\u4f53\u5c31\u53ef\u80fd\u4ece\u624b\u4e2d\u6ed1\u843d\u3002"
    },
    {
      "block": 3,
      "text": "\u6c7d\u8f66\u542f\u52a8\u65f6\uff0c\u9a71\u52a8\u8f6e\u4e0e\u8def\u9762\u4e4b\u95f4\u7684\u9759\u6469\u64e6\u5e2e\u52a9\u6c7d\u8f66\u524d\u8fdb\uff1b\n\u5982\u679c\u8f66\u8f6e\u53ea\u5728\u539f\u5730\u6253\u6ed1\uff0c\u5c31\u4e0d\u80fd\u6b63\u5e38\u9a71\u52a8\u8f66\u8f86\u3002\n\u5236\u52a8\u65f6\uff0c\u5236\u52a8\u88c5\u7f6e\u4ee5\u53ca\u8f6e\u80ce\u4e0e\u8def\u9762\u7684\u4f5c\u7528\u4f7f\u8f66\u8f86\u51cf\u901f\u3002\n\n\u8f6e\u80ce\u8868\u9762\u7684\u7eb9\u8def\uff08\u56fe 78\uff09\u548c\u9002\u5408\u51b0\u96ea\u8def\u51b5\u7684\u4e13\u7528\u9632\u6ed1\u94fe\uff0c\u53ef\u4ee5\u6539\u5584\u76f8\u5e94\u8def\u51b5\u4e0b\u7684\u6293\u5730\u80fd\u529b\u3002\n\u4e0d\u80fd\u628a\u5b83\u4eec\u7684\u4f5c\u7528\u7406\u89e3\u4e3a\u5728\u4efb\u4f55\u8def\u9762\u6761\u4ef6\u4e0b\u90fd\u80fd\u65e0\u9650\u589e\u5927\u6469\u64e6\u3002"
    },
    {
      "block": 5,
      "text": "\u673a\u5668\u4e2d\u4e0d\u9700\u8981\u7684\u6469\u64e6\u4f1a\u4f7f\u8fd0\u52a8\u90e8\u4ef6\u53d1\u70ed\u548c\u78e8\u635f\u3002\n\u5de5\u7a0b\u4e2d\u53ef\u4ee5\u901a\u8fc7\u6539\u5584\u63a5\u89e6\u8868\u9762\u3001\u4f7f\u7528\u5408\u9002\u7684\u6da6\u6ed1\u5242\u7b49\u65b9\u6cd5\u51cf\u5c0f\u8fd9\u7c7b\u6469\u64e6\u3002\n\u4e3a\u4e86\u652f\u627f\u8f6c\u8f74\u5e76\u51cf\u5c0f\u6709\u5bb3\u6469\u64e6\uff0c\u673a\u5668\u5e38\u4f7f\u7528\u8f74\u627f\u3002\n\n\u6ed1\u52a8\u8f74\u627f\u4e2d\u4e0e\u8f74\u76f4\u63a5\u914d\u5408\u7684\u96f6\u4ef6\u53eb\u4f5c\u8f74\u74e6\uff1b\n\u539f\u4e66\u5217\u4e3e\u7684\u6750\u6599\u6709\u9752\u94dc\u3001\u94f8\u94c1\u548c\u94a2\u3002\n\u8f74\u74e6\u5185\u8868\u9762\u8fd8\u53ef\u6577\u8bbe\u9002\u5408\u7684\u6750\u6599\uff0c\u539f\u4e66\u4e3e\u51fa\u7684\u4f8b\u5b50\u662f\u5df4\u6c0f\u5408\u91d1$\\text{\\textcircled{1}}$\uff0c\u540c\u65f6\u8fd8\u8981\u8fdb\u884c\u6da6\u6ed1\u3002\n\n\u56fe 79 \u4e2d\uff0c\u8f74 3 \u76f8\u5bf9\u8f74\u74e6 2 \u7684\u8868\u9762\u6ed1\u52a8\uff0c\u6240\u4ee5\u8fd9\u79cd\u8f74\u627f\u53eb\u4f5c\u6ed1\u52a8\u8f74\u627f\u3002"
    },
    {
      "block": 10,
      "text": "\u5728\u8d1f\u8377\u76f8\u8fd1\u3001\u6750\u6599\u548c\u5de5\u4f5c\u6761\u4ef6\u9002\u5408\u7684\u60c5\u51b5\u4e0b\uff0c\u7528\u6eda\u52a8\u63a5\u89e6\u4ee3\u66ff\u6ed1\u52a8\u63a5\u89e6\u901a\u5e38\u53ef\u4ee5\u51cf\u5c0f\u963b\u529b\u3002\n\u6eda\u73e0\u8f74\u627f\u548c\u6eda\u67f1\u8f74\u627f\u5229\u7528\u7684\u5c31\u662f\u8fd9\u4e00\u65b9\u6cd5\u3002\n\u5728\u8fd9\u7c7b\u8f74\u627f\u4e2d\uff0c\u94a2\u5236\u6eda\u73e0\u6216\u6eda\u67f1\u4f4d\u4e8e\u5185\u5708\u548c\u5916\u5708\u4e4b\u95f4\uff0c\u4f7f\u76f8\u5bf9\u8fd0\u52a8\u4e3b\u8981\u901a\u8fc7\u6eda\u52a8\u63a5\u89e6\u5b9e\u73b0\uff0c\u800c\u4e0d\u662f\u8ba9\u8f74\u76f4\u63a5\u5728\u8f74\u74e6\u8868\u9762\u4e0a\u6ed1\u52a8\u3002"
    },
    {
      "block": 11,
      "text": "\u56fe 80 \u8868\u793a\u539f\u4e66\u6240\u8ff0\u6eda\u73e0\u8f74\u627f\u548c\u6eda\u67f1\u8f74\u627f\u7684\u57fa\u672c\u6784\u9020\u3002\n\u786c\u94a2\u5236\u6210\u7684\u5185\u5708\u88c5\u5728\u8f74\u4e0a\uff0c\u5916\u5708\u56fa\u5b9a\u5728\u8f74\u627f\u67b6\u5185\uff1b\n\u6eda\u73e0\u6216\u6eda\u67f1\u653e\u5728\u4e24\u5708\u4e4b\u95f4\u3002\n\n\u8f74\u5e26\u52a8\u5185\u5708\u8f6c\u52a8\u65f6\uff0c\u6eda\u52a8\u4f53\u4e0e\u5185\u3001\u5916\u5708\u4e4b\u95f4\u5f62\u6210\u6eda\u52a8\u63a5\u89e6\uff0c\u8d77\u5230\u652f\u627f\u8f6c\u8f74\u5e76\u51cf\u5c0f\u963b\u529b\u7684\u4f5c\u7528\u3002"
    },
    {
      "block": 15,
      "text": "\u6c7d\u8f66\u3001\u8f66\u5e8a\u3001\u7535\u52a8\u673a\u548c\u81ea\u884c\u8f66\u7b49\u8bbe\u5907\u4e2d\uff0c\u90fd\u6709\u91c7\u7528\u6eda\u73e0\u6216\u6eda\u67f1\u8f74\u627f\u7684\u5b9e\u4f8b\u3002\n\u6eda\u52a8\u8f74\u627f\u5728\u5de5\u4e1a\u548c\u4ea4\u901a\u8fd0\u8f93\u4e2d\u5e94\u7528\u5e7f\u6cdb\uff1b\n\u5177\u4f53\u9009\u7528\u54ea\u79cd\u8f74\u627f\uff0c\u8fd8\u8981\u8003\u8651\u8d1f\u8377\u3001\u8f6c\u901f\u548c\u5de5\u4f5c\u73af\u5883\u3002"
    }
  ],
