  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u600e\u6837\u7528\u5b9e\u9a8c\u8bc1\u660e\u6c14\u4f53\u4f1a\u5bf9\u5bb9\u5668\u58c1\u4ea7\u751f\u538b\u5f3a\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4ece\u4ec0\u4e48\u5b9e\u9a8c\u73b0\u8c61\u53ef\u4ee5\u770b\u51fa\uff0c\u9759\u6b62\u5e73\u8861\u7684\u6c14\u4f53\u5411\u5404\u65b9\u5411\u4ea7\u751f\u76f8\u7b49\u7684\u538b\u5f3a\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6211\u4eec\u5df2\u7ecf\u77e5\u9053\uff0c\u6c14\u4f53\u4e0e\u56fa\u4f53\u3001\u6db2\u4f53\u4e0d\u540c\uff0c\u4f1a\u5145\u6ee1\u88c5\u7740\u5b83\u7684\u6574\u4e2a\u5bb9\u5668\uff0c\u4f8b\u5982\u6c14\u74f6\u3001\u6c7d\u8f66\u5185\u80ce\u548c\u6392\u7403\u3002\n\u6c14\u4f53\u8fd8\u4f1a\u5bf9\u4e0e\u5b83\u63a5\u89e6\u7684\u5bb9\u5668\u58c1\u4ea7\u751f\u538b\u5f3a\u3002"
    },
    {
      "block": 7,
      "text": "\u5355\u4e2a\u5206\u5b50\u649e\u51fb\u5668\u58c1\u7684\u4f5c\u7528\u5f88\u5fae\u5f31\uff0c\u4f46\u5927\u91cf\u5206\u5b50\u4e0d\u65ad\u649e\u51fb\u5668\u58c1\uff0c\u5408\u8d77\u6765\u7684\u4f5c\u7528\u5c31\u5f88\u663e\u8457\u3002\n\u5668\u58c1\u5355\u4f4d\u9762\u79ef\u6240\u53d7\u5230\u7684\u8fd9\u79cd\u5e73\u5747\u538b\u529b\uff0c\u8868\u73b0\u4e3a\u6c14\u4f53\u7684\u538b\u5f3a\u3002"
    },
    {
      "block": 8,
      "text": "\u5728\u4e0a\u9762\u7684\u5b9e\u9a8c\u4e2d\uff0c\u7a7a\u6c14\u5206\u5b50\u4e0d\u65ad\u4ece\u6c14\u7403\u5185\u5916\u649e\u51fb\u6c14\u7403\u58c1\u3002\n\u62bd\u6c14\u4f7f\u949f\u5f62\u7f69\u5185\u3001\u6c14\u7403\u5916\u7684\u7a7a\u6c14\u5206\u5b50\u9010\u6e10\u51cf\u5c11\uff0c\u5916\u90e8\u538b\u5f3a\u51cf\u5c0f\uff1b\n\u624e\u4f4f\u53e3\u3001\u4e0d\u6f0f\u6c14\u7684\u6c14\u7403\u5185\uff0c\u5206\u5b50\u603b\u6570\u5374\u4e0d\u53d8\u3002\n\n\u5728\u6c14\u7403\u8fd8\u6765\u4e0d\u53ca\u660e\u663e\u81a8\u80c0\u65f6\uff0c\u5916\u58c1\u5355\u4f4d\u9762\u79ef\u6240\u53d7\u7684\u5206\u5b50\u649e\u51fb\u4f5c\u7528\u51cf\u5f31\uff0c\u5185\u5916\u538b\u5f3a\u5dee\u589e\u5927\uff0c\u63a8\u52a8\u6c14\u7403\u81a8\u80c0\u3002\n\u968f\u7740\u6c14\u7403\u81a8\u80c0\uff0c\u7403\u5185\u6c14\u4f53\u7684\u5bc6\u5ea6\u548c\u538b\u5f3a\u4e5f\u4f1a\u6539\u53d8\uff0c\u5e76\u4e0d\u662f\u7403\u5185\u538b\u5f3a\u59cb\u7ec8\u4e0d\u53d8\u3002\n\u6700\u540e\uff0c\u5185\u5916\u6c14\u4f53\u538b\u529b\u7684\u5408\u529b\u4e0e\u6c14\u7403\u819c\u7684\u5f39\u529b\u76f8\u5e73\u8861\uff0c\u6c14\u7403\u4e0d\u518d\u7ee7\u7eed\u81a8\u80c0\u3002\n\n\u5728\u6c14\u7403\u819c\u6027\u8d28\u8fd1\u4f3c\u5747\u5300\u3001\u6c14\u4f53\u8fbe\u5230\u9759\u6b62\u5e73\u8861\u7684\u6761\u4ef6\u4e0b\uff0c\u9f13\u8d77\u7684\u6c14\u7403\u5448\u7403\u5f62\uff0c\u8bf4\u660e\u6c14\u4f53\u5bf9\u5404\u65b9\u5411\u7684\u538b\u5f3a\u76f8\u7b49\u3002\n\u4ece\u5206\u5b50\u89c2\u70b9\u770b\uff0c\u76f8\u540c\u9762\u79ef\u7684\u6c14\u7403\u58c1\u5728\u76f8\u540c\u65f6\u95f4\u5185\u53d7\u5230\u7684\u5e73\u5747\u78b0\u649e\u4f5c\u7528\u4e0d\u56e0\u65b9\u5411\u4e0d\u540c\u800c\u6539\u53d8\u3002\n**\u9759\u6b62\u5e73\u8861\u7684\u6c14\u4f53\u5728\u540c\u4e00\u4f4d\u7f6e\u5411\u5404\u65b9\u5411\u4ea7\u751f\u76f8\u7b49\u7684\u538b\u5f3a\uff0c\u8fd9\u662f\u5927\u91cf\u5206\u5b50\u65e0\u89c4\u5219\u8fd0\u52a8\u7684\u7ed3\u679c**\u3002"
    }
  ],
