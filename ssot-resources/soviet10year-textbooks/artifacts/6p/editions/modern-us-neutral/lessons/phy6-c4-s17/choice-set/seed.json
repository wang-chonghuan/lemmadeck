  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u600e\u6837\u7528\u5b9e\u9a8c\u5224\u5b9a\u6db2\u4f53\u5bf9\u5b8c\u5168\u6d78\u5165\u5176\u4e2d\u7684\u7269\u4f53\u4ea7\u751f\u591a\u5927\u7684\u6d6e\u529b\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u8fd9\u4e2a\u529b\u7b49\u4e8e\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u6d78\u5728\u6db2\u4f53\u6216\u6c14\u4f53\u4e2d\u7684\u7269\u4f53\u6240\u53d7\u7684\u6d6e\u529b\u53c8\u53eb\u505a\u4ec0\u4e48\u529b\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u600e\u6837\u8ba1\u7b97\u963f\u57fa\u7c73\u5fb7\u529b\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u5728\u5929\u5e73\u7684\u6a2a\u6881\u4e0a\u60ac\u6302\u4e24\u4e2a\u8d28\u91cf\u76f8\u540c\u7684\u5706\u67f1\u4f53\uff0c\u4e00\u4e2a\u662f\u94c5\u7684\uff0c\u4e00\u4e2a\u662f\u94dd\u7684. \u8fd9\u65f6\u5929\u5e73\u5904\u4e8e\u5e73\u8861\u72b6\u6001. \u82e5\u628a\u8fd9\u4e24\u4e2a\u5706\u67f1\u4f53\u540c\u65f6\u6d78\u5165\u6c34\u4e2d\uff0c\u5929\u5e73\u7684\u5e73\u8861\u53d7\u4e0d\u53d7\u5230\u7834\u574f\uff1f\u82e5\u6d78\u5165\u9152\u7cbe\u4e2d\u53c8\u5982\u4f55\uff1f\u8bd5\u8bf4\u660e\u7406\u7531\uff0c\u5e76\u7528\u5b9e\u9a8c\u68c0\u9a8c\u6240\u5f97\u7684\u7ed3\u8bba. \u6d6e\u529b\u7684\u5927\u5c0f\u4e0e\u7269\u4f53\u7684\u4f53\u79ef\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u5728\u5929\u5e73\u7684\u6a2a\u6881\u4e0a\u60ac\u6302\u4e24\u4e2a\u4f53\u79ef\u76f8\u540c\u7684\u94dd\u5236\u5706\u67f1\u4f53. \u82e5\u628a\u5176\u4e2d\u4e00\u4e2a\u5706\u67f1\u4f53\u6d78\u5165\u6c34\u4e2d\uff0c\u800c\u53e6\u4e00\u4e2a\u6d78\u5165\u9152\u7cbe\u4e2d\uff0c\u5929\u5e73\u7684\u5e73\u8861\u53d7\u4e0d\u53d7\u5230\u7834\u574f\uff1f\u8bd5\u8bf4\u660e\u7406\u7531\uff0c\u5e76\u7528\u5b9e\u9a8c\u8fdb\u884c\u68c0\u9a8c. \u6d6e\u529b\u4e0e\u6db2\u4f53\u7684\u5bc6\u5ea6\u6709\u5173\u7cfb\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u5728\u5929\u5e73\u7684\u6a2a\u6881\u4e0a\u60ac\u6302\u4e24\u4e2a\u4f53\u79ef\u76f8\u540c\u7684\u5706\u67f1\u4f53\uff0c\u4e00\u4e2a\u662f\u94c1\u7684\uff0c\u4e00\u4e2a\u662f\u94dd\u7684. \u589e\u6dfb\u9644\u52a0\u91cd\u91cf\u4f7f\u5929\u5e73\u5e73\u8861. \u82e5\u628a\u8fd9\u4e24\u4e2a\u5706\u67f1\u4f53\u90fd\u6d78\u5165\u6c34\u4e2d\uff0c\u5929\u5e73\u7684\u5e73\u8861\u53d7\u4e0d\u53d7\u5230\u7834\u574f\uff1f\u4e3a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-4",
      "text": "\uff084\uff09\u4e00\u5757\u94c1\u7684\u4f53\u79ef\u4e3a0.1\u5206\u7c73$^3$. \u5f53\u628a\u8fd9\u5757\u94c1\u5b8c\u5168\u6d78\u5165\u6c34\u4e2d\u65f6\uff0c\u5b83\u5c06\u53d7\u5230\u591a\u5927\u7684\u6d6e\u529b\uff1f\u6d78\u5728\u7164\u6cb9\u4e2d\u5462\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u4e3a\u4ec0\u4e48\u6f5c\u6c34\u670d\u4e0a\u8981\u52a0\u94c5\u8d28\u914d\u91cd\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u5728\u5f39\u7c27\u4e0a\u60ac\u6302\u4e00\u4e2a\u5c0f\u6876\u548c\u4e00\u4e2a**\u4f53\u79ef\u4e0e\u6876\u7684\u5bb9\u79ef\u76f8\u7b49\u7684\u5706\u67f1\u4f53**\u3002\n\u7528\u6307\u9488\u628a\u5f39\u7c27\u7684\u4f38\u957f\u60c5\u51b5\u6807\u8bb0\u5728\u652f\u67b6\u4e0a\uff0c\u8bb0\u5f55\u5706\u67f1\u4f53\u5728\u7a7a\u6c14\u4e2d\u7684\u91cd\u91cf\uff08\u56fe165\uff0ca\uff09\u3002\n\u7136\u540e\u63d0\u8d77\u5706\u67f1\u4f53\uff0c\u5728\u5b83\u4e0b\u9762\u653e\u7f6e\u4e00\u4e2a\u88c5\u6ee1\u6db2\u4f53\u3001\u5e26\u6709\u6ea2\u6db2\u7ba1\u7684\u5bb9\u5668\uff0c\u518d\u628a\u5706\u67f1\u4f53\u5168\u90e8\u6d78\u5165\u6db2\u4f53\u4e2d\uff08\u56fe165\uff0cb\uff09\u3002\n\n\u4f53\u79ef\u4e0e\u5706\u67f1\u4f53\u76f8\u540c\u7684\u6db2\u4f53\u4ece\u6ea2\u6db2\u7ba1\u6d41\u5165\u4e0b\u65b9\u7684\u70e7\u676f\u3002\n\u5706\u67f1\u4f53\u9664\u53d7\u5230\u91cd\u529b\u5916\uff0c\u8fd8\u53d7\u5230\u6db2\u4f53\u7684\u6d6e\u529b\uff0c\u56e0\u6b64\u5f39\u7c27\u7f29\u77ed\uff0c\u6307\u9488\u5347\u9ad8\u3002\n\u628a\u5706\u67f1\u4f53\u6392\u5f00\u7684\u6db2\u4f53\u5012\u5165\u60ac\u6302\u7684\u5c0f\u6876\uff0c\u8fd9\u4e9b\u6db2\u4f53\u6070\u597d\u628a\u5c0f\u6876\u88c5\u6ee1\u3002\n\n\u6b64\u65f6\u6307\u9488\u6062\u590d\u5230\u539f\u6765\u7684\u4f4d\u7f6e\uff08\u56fe165\uff0cc\uff09\u3002"
    },
    {
      "block": 4,
      "text": "\u7531\u8fd9\u4e2a\u5b9e\u9a8c\u53ef\u4ee5\u5f97\u51fa\u7ed3\u8bba\uff1a**\u5b8c\u5168\u6d78\u5728\u6db2\u4f53\u4e2d\u7684\u7269\u4f53\u6240\u53d7\u7684\u6d6e\u529b\uff0c\u7b49\u4e8e\u4e0e\u8be5\u7269\u4f53\u540c\u4f53\u79ef\u7684\u6db2\u4f53\u7684\u91cd\u91cf**\u3002"
    },
    {
      "block": 5,
      "text": "\u5bf9\u5904\u4e8e\u67d0\u79cd\u6c14\u4f53\u4e2d\u7684\u7269\u4f53\u505a\u7c7b\u4f3c\u7684\u5b9e\u9a8c\uff0c\u4e5f\u4f1a\u5f97\u5230\u76f8\u5e94\u7684\u7ed3\u8bba\uff1a**\u6c14\u4f53\u5bf9\u7269\u4f53\u7684\u6d6e\u529b\uff0c\u7b49\u4e8e\u7269\u4f53\u6240\u6392\u5f00\u7684\u6c14\u4f53\u7684\u91cd\u91cf**\u3002"
    },
    {
      "block": 6,
      "text": "\u539f\u4e66\u628a\u6db2\u4f53\u548c\u6c14\u4f53\u5177\u6709\u6d6e\u529b\u3001\u4ee5\u53ca\u6d6e\u529b\u8ba1\u7b97\u65b9\u6cd5\u7684\u53d1\u73b0\u5f52\u4e8e\u53e4\u5e0c\u814a\u5b66\u8005\u963f\u57fa\u7c73\u5fb7\u3002\n\u4e3a\u4e86\u7eaa\u5ff5\u4ed6\uff0c\u6d6e\u529b\u4e5f\u53eb\u4f5c**\u963f\u57fa\u7c73\u5fb7\u529b**\u3002"
    },
    {
      "block": 7,
      "text": "\u82e5\u7269\u4f53\u5728\u771f\u7a7a\u4e2d\u7684\u91cd\u91cf\u4e3a$P=gm$\uff0c\u5176\u4e2d$m$\u662f\u7269\u4f53\u7684\u8d28\u91cf\uff0c\u90a3\u4e48\u5b83\u5728\u6db2\u4f53\uff08\u6216\u6c14\u4f53\uff09\u4e2d\u7684\u8868\u89c2\u91cd\u91cf$P_1$\u4f1a\u51cf\u5c0f\u3002\n\u51cf\u5c0f\u7684\u91cf\u7b49\u4e8e\u963f\u57fa\u7c73\u5fb7\u529b$F_A$\uff0c\u5373\u6709"
    },
    {
      "block": 8,
      "text": "$P_1=P-F_A$\uff0c\n\u6216 $P_1=gm-gm_1$\uff0c"
    },
    {
      "block": 9,
      "text": "\u5f0f\u4e2d$m_1$\u662f\u4e0e\u6d78\u5728\u6db2\u4f53\uff08\u6216\u6c14\u4f53\uff09\u4e2d\u7684\u7269\u4f53\u540c\u4f53\u79ef\u7684\u6db2\u4f53\uff08\u6216\u6c14\u4f53\uff09\u7684\u8d28\u91cf\u3002\n\u539f\u4e66\u628a\u8868\u89c2\u91cd\u91cf\u51cf\u5c0f\u8868\u8ff0\u4e3a\uff1a**\u6d78\u5728\u6db2\u4f53\uff08\u6216\u6c14\u4f53\uff09\u4e2d\u7684\u7269\u4f53\u4f1a\u201c\u5931\u53bb\u81ea\u5df1\u7684\u4e00\u90e8\u5206\u91cd\u91cf\u201d**\u3002\n**\u5b83\u201c\u5931\u53bb\u7684\u91cd\u91cf\u201d\u7b49\u4e8e\u5b83\u6240\u6392\u5f00\u7684\u6db2\u4f53\uff08\u6216\u6c14\u4f53\uff09\u7684\u91cd\u91cf**\u3002\n\n\u8fd9\u91cc\u8bf4\u7684\u662f\u8868\u89c2\u91cd\u91cf\u7684\u51cf\u5c0f\uff0c\u5e76\u4e0d\u662f\u7269\u4f53\u7684\u8d28\u91cf\u6216\u6240\u53d7\u91cd\u529b\u51cf\u5c0f\u3002"
    },
    {
      "block": 10,
      "text": "\u73b0\u5728\u8ba1\u7b97\u4f53\u79ef\u4e3a$V$\u7684\u7269\u4f53\u5b8c\u5168\u6d78\u5165\u5bc6\u5ea6\u4e3a$\\rho$\u7684\u6db2\u4f53\u65f6\uff0c\u6240\u53d7\u5230\u7684\u963f\u57fa\u7c73\u5fb7\u529b\u3002"
    },
    {
      "block": 11,
      "text": "\u963f\u57fa\u7c73\u5fb7\u529b\u7b49\u4e8e\u4e0e\u7269\u4f53\u540c\u4f53\u79ef\u7684\u6db2\u4f53\u7684\u91cd\u91cf\uff0c\u5373\u6709"
    },
    {
      "block": 12,
      "text": "**$F_A=P=gm=g\\rho_{\\text{\u6db2}}V$**\u3002"
    },
    {
      "block": 14,
      "text": "$F_A=g\\rho_{\\text{\u6db2}}V$\u3002"
    }
