      "number": "1",
      "text": "\uff081\uff09\u5bf9\u4e8e\u4e00\u5b9a\u8d28\u91cf\u3001\u6e29\u5ea6\u4e0d\u53d8\u7684\u6c14\u4f53\uff0c\u4e3a\u4ec0\u4e48\u538b\u7f29\u65f6\u538b\u5f3a\u589e\u5927\uff0c\u800c\u81a8\u80c0\u65f6\u538b\u5f3a\u51cf\u5c0f\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u628a\u4e00\u5b9a\u8d28\u91cf\u7684\u6c14\u4f53\u5c01\u95ed\u5728\u4f53\u79ef\u4e0d\u53d8\u7684\u5bb9\u5668\u4e2d\uff0c\u51b7\u5374\u540e\u548c\u52a0\u70ed\u540e\uff0c\u54ea\u79cd\u72b6\u6001\u7684\u538b\u5f3a\u8f83\u5927\uff1f\u89e3\u91ca\u539f\u56e0\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u4e3a\u4ec0\u4e48\u538b\u7f29\u6c14\u4f53\u9700\u8981\u50a8\u5b58\u5728\u4e13\u7528\u7684\u6c14\u74f6\u4e2d\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u628a\u4e00\u4e2a\u88c5\u7740\u6c14\u4f53\u7684\u6c14\u74f6\u4e0e\u53e6\u4e00\u4e2a\u5bb9\u79ef\u76f8\u540c\u3001\u5df2\u7ecf\u62bd\u7a7a\u7684\u6c14\u74f6\u8fde\u901a\uff0c\u4e24\u74f6\u6784\u6210\u4e0d\u6f0f\u6c14\u7684\u5c01\u95ed\u7cfb\u7edf\u3002\u5728\u6c14\u4f53\u6e29\u5ea6\u6062\u590d\u5230\u521d\u59cb\u6e29\u5ea6\u540e\uff0c\u4e0e\u8fde\u901a\u524d\u88c5\u6c14\u74f6\u4e2d\u7684\u538b\u5f3a\u76f8\u6bd4\uff0c\u6c14\u4f53\u7684\u538b\u5f3a\u600e\u6837\u53d8\u5316\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6c14\u4f53\u538b\u5f3a\u6765\u81ea\u5927\u91cf\u5206\u5b50\u5bf9\u5668\u58c1\u7684\u649e\u51fb\u3002\n\u5728\u6bcf\u6b21\u78b0\u649e\u7684\u5e73\u5747\u4f5c\u7528\u76f8\u8fd1\u65f6\uff0c\u5668\u58c1\u5355\u4f4d\u9762\u79ef\u5728\u76f8\u540c\u65f6\u95f4\u5185\u53d7\u5230\u7684\u78b0\u649e\u8d8a\u591a\uff0c\u538b\u5f3a\u5c31\u8d8a\u5927\u3002"
    },
