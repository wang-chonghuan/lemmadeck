  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u6760\u6746\u5f0f\u5929\u5e73\u7684\u5e73\u8861\u6761\u4ef6\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u600e\u6837\u7528\u5929\u5e73\u548c\u781d\u7801\u7ec4\u6d4b\u91cf\u7269\u4f53\u7684\u8d28\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u7269\u7406\u5929\u5e73\u7684\u781d\u7801\u7ec4\u662f\u600e\u6837\u7ec4\u6210\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "q1",
      "text": "\u600e\u6837\u4e0d\u7528\u5929\u5e73\u800c\u80fd\u8bf4\u660e\u4e24\u4e2a\u53f0\u7403\u7684\u8d28\u91cf\u662f\u76f8\u540c\u7684\uff1f\u53c8\u5982\u4f55\u7528\u5929\u5e73\u6765\u68c0\u9a8c\u8fd9\u4e2a\u7ed3\u679c\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5728\u540c\u4e00\u60ef\u6027\u53c2\u7167\u7cfb\u4e2d\uff0c\u4e24\u4e2a\u7269\u4f53\u8d77\u521d\u90fd\u9759\u6b62\uff1b\n\u5728\u6240\u6bd4\u8f83\u7684\u8fd0\u52a8\u65b9\u5411\u4e0a\uff0c\u82e5\u4e24\u8005\u5728\u540c\u4e00\u6b21\u76f8\u4e92\u4f5c\u7528\u671f\u95f4\u5404\u81ea\u53d7\u5230\u7684\u5916\u529b\u51b2\u91cf\u90fd\u53ef\u4ee5\u5ffd\u7565\uff0c\u5c31\u53ef\u4ee5\u6839\u636e\u5b83\u4eec\u83b7\u5f97\u7684\u901f\u5ea6\u5927\u5c0f\u786e\u5b9a\u8d28\u91cf\u4e4b\u6bd4\u3002\n\u8fd9\u91cc\u6bd4\u8f83\u7684\u662f\u901f\u5ea6\u7684\u5927\u5c0f\uff0c\u4e0d\u662f\u901f\u5ea6\u7684\u65b9\u5411\u3002\n\n\u82e5\u5176\u4e2d\u4e00\u4e2a\u7269\u4f53\u7684\u8d28\u91cf\u5df2\u77e5\uff0c\u5c31\u53ef\u4ee5\u5728\u8fd9\u4e9b\u6761\u4ef6\u4e0b\u786e\u5b9a\u53e6\u4e00\u4e2a\u7269\u4f53\u7684\u8d28\u91cf\u3002"
    },
    {
      "block": 3,
      "text": "\u7b80\u5355\u7684\u6760\u6746\u5f0f\u5929\u5e73\uff08\u56fe 46\uff09\u7531\u4e00\u6839\u4f5c\u4e3a\u6760\u6746\u7684\u6a2a\u6881\u6784\u6210\uff0c\u8fd9\u6760\u6746\u53ef\u4ee5\u7ed5\u5176\u4e2d\u70b9\u81ea\u7531\u8f6c\u52a8. \u6760\u6746\u4e24\u7aef\u5404\u60ac\u6302\u4e00\u4e2a\u6258\u76d8."
    },
    {
      "block": 6,
      "text": "\u4f7f\u7528\u8fd9\u91cc\u7684\u7b49\u81c2\u5929\u5e73\u65f6\uff0c\u5148\u5c06\u5929\u5e73\u6b63\u786e\u653e\u7f6e\uff0c\u4f7f\u6258\u76d8\u60ac\u7a7a\u3001\u6a2a\u6881\u80fd\u591f\u81ea\u7531\u6446\u52a8\uff0c\u5e76\u5728\u7a7a\u76d8\u65f6\u8c03\u597d\u96f6\u4f4d\u3002\n\u79f0\u91cf\u65f6\u5e94\u7b49\u6446\u52a8\u51cf\u5c0f\uff0c\u518d\u786e\u8ba4\u6a2a\u6881\u505c\u5728\u89c4\u5b9a\u7684\u5e73\u8861\u4f4d\u7f6e\uff0c\u6216\u5728\u8be5\u4f4d\u7f6e\u4e24\u4fa7\u4f5c\u5bf9\u79f0\u7684\u5c0f\u5e45\u6446\u52a8\uff1b\n\u4e0d\u80fd\u628a\u6a2a\u6881\u88ab\u5361\u4f4f\u6216\u5728\u503e\u659c\u4f4d\u7f6e\u505c\u4f4f\u5f53\u4f5c\u5e73\u8861\u3002\n\n\u5728\u8fd9\u4e9b\u6761\u4ef6\u4e0b\uff0c**\u5f53\u5929\u5e73\u5e73\u8861\u65f6\uff0c\u653e\u5728\u4e24\u8fb9\u6258\u76d8\u4e2d\u7684\u7269\u4f53\u7684\u8d28\u91cf\u662f\u5f7c\u6b64\u76f8\u7b49\u7684.**"
    },
    {
      "block": 7,
      "text": "\u8fd9\u5c31\u662f\u5229\u7528\u5929\u5e73\u6765\u6d4b\u5b9a\u7269\u4f53\u8d28\u91cf\u7684\u6839\u636e\u3002\n\u79f0\u91cf\u524d\u5148\u6b63\u786e\u653e\u7f6e\u5929\u5e73\uff0c\u786e\u8ba4\u6258\u76d8\u60ac\u7a7a\u3001\u6a2a\u6881\u53ef\u81ea\u7531\u8fd0\u52a8\uff0c\u5e76\u5728\u7a7a\u76d8\u65f6\u8c03\u96f6\u3002\n\u628a\u5f85\u6d4b\u7269\u4f53\u653e\u5728\u4e00\u4e2a\u6258\u76d8\u91cc\uff0c\u5728\u53e6\u4e00\u4e2a\u6258\u76d8\u91cc\u9009\u914d\u8d28\u91cf\u5df2\u77e5\u7684\u781d\u7801\uff1b\n\n\u6309\u89c4\u5b9a\u5e73\u8861\u4f4d\u7f6e\u68c0\u67e5\u5e73\u8861\u8bfb\u6570\uff0c\u4e0d\u80fd\u53ea\u51ed\u6a2a\u6881\u77ac\u95f4\u7ecf\u8fc7\u67d0\u4f4d\u7f6e\u6216\u88ab\u5361\u4f4f\u505c\u4f4f\u6765\u5224\u65ad\u3002\n\u628a\u6240\u7528\u781d\u7801\u7684\u8d28\u91cf\u76f8\u52a0\uff0c\u5728\u4e0a\u8ff0\u6761\u4ef6\u4e0b\uff0c\u7269\u4f53\u7684\u8d28\u91cf\u5c31\u7b49\u4e8e\u8fd9\u4e2a\u603b\u8d28\u91cf\u3002"
    },
    {
      "block": 8,
      "text": "\u6709\u6210\u5957\u7684\u7531\u4e0d\u540c\u8d28\u91cf\u7684\u781d\u7801\u7ec4\u6210\u7684\u4e13\u7528\u781d\u7801\u7ec4\u4f9b\u79f0\u91cf\u4f7f\u7528. \u56fe 47 \u6240\u793a\u7684\u662f\u4e00\u4e2a\u7269\u7406\u5929\u5e73\u7684\u781d\u7801\u7ec4. \u5176\u4e2d\u5305\u62ec\u4e5d\u4e2a\u781d\u7801\uff0c\u8d28\u91cf\u5206\u522b\u4e3a $100$\u3001$50$\u3001$20$\u3001$20$\u3001$10$\u3001$5$\u3001$2$\u3001$2$ \u548c $1$ \u514b. \u7528\u8fd9\u4e9b\u781d\u7801\u53ef\u4ee5\u914d\u6210\u4ece $1$ \u514b\u5230 $210$ \u514b\uff08\u5305\u62ec\u4e24\u7aef\uff09\u4e4b\u95f4\u7684\u4efb\u610f\u6574\u6570\u514b\u6570."
    },
    {
      "block": 11,
      "text": "\u8d28\u91cf\u5c0f\u4e8e $1$ \u514b\u7684\u781d\u7801\u662f\u7528\u94dd\u505a\u7684\uff0c\u5236\u6210\u7247\u72b6\uff0c\u8d28\u91cf\u5206\u522b\u4e3a$500$\u3001$200$\u3001$200$\u3001$100$\u3001$50$\u3001$20$\u3001$20$ \u548c $10$ \u6beb\u514b."
    }
  ],
