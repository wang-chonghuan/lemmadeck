  },
  "exercises": [
    {
      "number": "1",
      "text": "\u5728\u672c\u8282\u8ba8\u8bba\u7684\u8fd9\u7c7b\u7269\u8d28\u4e2d\uff0c\u7ec4\u6210\u7269\u8d28\u7684\u7c92\u5b50\u53eb\u505a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u54ea\u4e9b\u73b0\u8c61\u53ef\u4ee5\u8bf4\u660e\u5206\u5b50\u975e\u5e38\u5c0f\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u5173\u4e8e\u5206\u5b50\u7684\u5927\u5c0f\u4f60\u77e5\u9053\u4e9b\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\u5173\u4e8e\u6c34\u5206\u5b50\u7684\u7ec4\u6210\u4f60\u77e5\u9053\u4e9b\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\u6cb9\u6ef4\u5728\u6c34\u9762\u4e0a\u94fa\u5c55\u5f00\u6765\uff0c\u5f62\u6210\u8584\u819c\u3002\n\u4e3a\u4ec0\u4e48\u5f53\u819c\u8584\u5230\u4e00\u5b9a\u7a0b\u5ea6\u65f6\uff0c\u6cb9\u5c31\u4e0d\u518d\u7ee7\u7eed\u94fa\u5c55\u4e86\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u672c\u8282\u5148\u7528\u5206\u5b50\u6a21\u578b\u8bf4\u660e\u6c34\u3001\u6c27\u6c14\u548c\u7cd6\u8fd9\u7c7b\u7269\u8d28\u7684\u7ed3\u6784\u3002\n\u8fd9\u91cc\u6240\u8bf4\u7684\u5206\u5b50\uff0c\u662f\u7ec4\u6210\u8fd9\u7c7b\u7269\u8d28\u7684\u5fae\u5c0f\u7c92\u5b50\u3002\n\u539f\u4e66\u8bf4\u660e\uff0c\u201c\u5206\u5b50\u201d\u4e00\u8bcd\u6700\u65e9\u51fa\u4e8e\u62c9\u4e01\u8bed\uff0c\u610f\u601d\u662f\u201c\u5c0f\u7269\u8d28\u201d\u3002"
    },
    {
      "block": 3,
      "text": "\u5bf9\u4e8e\u7531\u5206\u5b50\u6784\u6210\u7684\u7269\u8d28\uff0c\u5206\u5b50\u662f\u4fdd\u6301\u8be5\u7269\u8d28\u5316\u5b66\u6027\u8d28\u7684\u6700\u5c0f\u7c92\u5b50\u3002\n\u8fd9\u4e00\u5b9a\u4e49\u4e0d\u8868\u793a\u6240\u6709\u7269\u8d28\u90fd\u7531\u5206\u5b50\u7ec4\u6210\u3002"
    },
    {
      "block": 6,
      "text": "\u7cd6\u5757\u53ef\u4ee5\u6363\u6210\u7ec6\u672b\uff0c\u9ea6\u7c92\u53ef\u4ee5\u78e8\u6210\u9762\u7c89\u3002\n\u539f\u4e66\u8fd8\u4e3e\u51fa\u6cb9\u819c\u7684\u4f8b\u5b50\uff1a\u6d6e\u5728\u6c34\u9762\u4e0a\u7684\u6cb9\u80fd\u5f62\u6210\u5f88\u8584\u7684\u819c\uff0c\u539a\u5ea6\u53ea\u6709\u4e00\u6839\u5934\u53d1\u76f4\u5f84\u7684 40000 \u5206\u4e4b\u4e00\u3002\n\u8fd9\u662f\u539f\u4e66\u7528\u6765\u8bf4\u660e\u5fae\u5c0f\u5c3a\u5ea6\u7684\u4f8b\u5b50\uff0c\u4e0d\u662f\u8fd9\u91cc\u65b0\u6d4b\u5f97\u7684\u6cb9\u819c\u539a\u5ea6\u3002\n\n\u4e00\u7c92\u9762\u7c89\u4e0d\u662f\u4e00\u4e2a\u5206\u5b50\uff0c\u9762\u7c89\u4e5f\u4e0d\u662f\u7531\u5355\u4e00\u7269\u8d28\u7ec4\u6210\u7684\u3002\n\u5728\u539f\u4e66\u8fd9\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u4e00\u7c92\u9762\u7c89\u5185\u548c\u6cb9\u819c\u539a\u5ea6\u65b9\u5411\u4e0a\u4ecd\u5305\u542b\u8bb8\u591a\u5206\u5b50\u3002\n\u5206\u5b50\u7684\u5c3a\u5bf8\u6bd4\u8fd9\u4e9b\u7ec6\u5c0f\u9897\u7c92\u7684\u5927\u5c0f\u6216\u6cb9\u819c\u7684\u539a\u5ea6\u8fd8\u8981\u5c0f\u3002"
    },
    {
      "block": 7,
      "text": "\u539f\u4e66\u7528\u4e00\u4e2a\u6bd4\u55bb\u5e2e\u52a9\u6211\u4eec\u60f3\u8c61\u5206\u5b50\u7684\u5927\u5c0f\uff1a\u4e00\u4e2a\u5206\u5b50\u6bd4\u4e00\u4e2a\u4e2d\u7b49\u5927\u5c0f\u7684\u82f9\u679c\u5c0f\u7684\u500d\u6570\uff0c\u5927\u81f4\u76f8\u5f53\u4e8e\u8fd9\u4e2a\u82f9\u679c\u6bd4\u5730\u7403\u5c0f\u7684\u500d\u6570\u3002\n\u8fd9\u662f\u5c3a\u5ea6\u6bd4\u55bb\uff0c\u4e0d\u662f\u5bf9\u67d0\u4e2a\u5206\u5b50\u5c3a\u5bf8\u7684\u7cbe\u786e\u6d4b\u91cf\u3002"
    },
    {
      "block": 8,
      "text": "\u4e0d\u540c\u7269\u8d28\u7684\u5206\u5b50\u5927\u5c0f\u4e0d\u540c\uff0c\u4f46\u90fd\u975e\u5e38\u5c0f\u3002\n\u539f\u4e66\u63d0\u5230\uff0c\u53ef\u7528\u7535\u5b50\u663e\u5fae\u955c\u89c2\u5bdf\u6700\u5927\u7684\u5206\u5b50\u5e76\u62cd\u6444\u56fe\u50cf\uff0c\u5e76\u628a\u8fd9\u79cd\u7167\u7247\u4f5c\u4e3a\u5206\u5b50\u5b58\u5728\u7684\u8bc1\u636e\u4e4b\u4e00\u3002\n\u539f\u4e66\u7684\u201c\u53c2\u770b\u5f69\u56fe $II$\u201d\u662f\u5f53\u65f6\u7684\u56fe\u7248\u5f15\u7528\uff0c\u4e0d\u8868\u793a\u672c\u8bfe\u8fd9\u91cc\u5c55\u793a\u4e86\u65b0\u7684\u5206\u5b50\u7167\u7247\u3002"
    },
    {
      "block": 9,
      "text": "\u7531\u4e8e\u5206\u5b50\u5f88\u5c0f\uff0c\u5c11\u91cf\u6c34\u6216\u7a7a\u6c14\u4e2d\u5c31\u5305\u542b\u6781\u591a\u7684\u5206\u5b50\u3002\n\u539f\u4e66\u7528\u4e00\u6ef4\u6c34\u4f5c\u6570\u91cf\u6bd4\u8f83\uff1a\u5176\u4e2d\u7684\u5206\u5b50\u6570\u662f\u5f53\u65f6\u5730\u7403\u4eba\u53e3\u6570\u7684\u51e0\u767e\u4ebf\u500d\u3002\n\u5b83\u53c8\u7528 1 \u5398\u7c73$^3$ \u7a7a\u6c14\u4f5c\u6bd4\u55bb\uff1a\u82e5\u628a\u540c\u6837\u591a\u7684\u7ec6\u6c99\u7c92\u5806\u5728\u4e00\u8d77\uff0c\u5c31\u4f1a\u6210\u4e3a\u8db3\u4ee5\u8986\u76d6\u4e00\u4e2a\u5927\u5de5\u5382\u7684\u5c0f\u5c71\uff08\u56fe 14\uff09\u3002\n\n\u8fd9\u4e9b\u6bd4\u8f83\u7528\u6765\u8bf4\u660e\u5206\u5b50\u6570\u6781\u591a\uff0c\u4e0d\u662f\u6309\u4eca\u5929\u7684\u4eba\u53e3\u3001\u67d0\u4e2a\u5de5\u5382\u6216\u4e00\u6b21\u65b0\u7684\u7a7a\u6c14\u6d4b\u91cf\u7ed9\u51fa\u7684\u6570\u636e\u3002"
    },
    {
      "block": 16,
      "text": "\u5206\u5b50\u8fd8\u53ef\u4ee5\u53d1\u751f\u5206\u89e3\u3002\n\u4f46\u5206\u89e3\u540e\u7684\u7c92\u5b50\u4e0d\u518d\u662f\u539f\u6765\u90a3\u4e2a\u5206\u5b50\u3002"
    },
    {
      "block": 17,
      "text": "\u6784\u6210\u5206\u5b50\u7684\u7c92\u5b50\u53eb\u505a\u539f\u5b50\u3002\n\u539f\u5b50\u4e0e\u5206\u5b50\u4e0d\u662f\u540c\u4e00\u4e2a\u6982\u5ff5\u3002"
    },
    {
      "block": 18,
      "text": "\u4e00\u4e2a\u6c27\u5206\u5b50\u7531\u4e24\u4e2a\u76f8\u540c\u7684\u6c27\u539f\u5b50\u7ec4\u6210\uff0c\u4e00\u4e2a\u6c34\u5206\u5b50\u7531\u4e09\u4e2a\u539f\u5b50\u7ec4\u6210\uff1a\u4e00\u4e2a\u6c27\u539f\u5b50\u548c\u4e24\u4e2a\u6c22\u539f\u5b50\u3002\n\u56fe 15 \u7684 a \u90e8\u5206\u8868\u793a\u4e24\u4e2a\u6c34\u5206\u5b50\u3002\n\u8fd9\u6837\u7684\u56fe\u53eb\u505a\u5206\u5b50\u6a21\u578b\uff0c\u5b83\u7528\u7b80\u5316\u7684\u56fe\u50cf\u8868\u793a\u5206\u5b50\u7684\u7ec4\u6210\uff0c\u6240\u8868\u8fbe\u7684\u6027\u8d28\u5e94\u5f53\u4e0e\u7269\u7406\u5b9e\u9a8c\u7684\u8bc1\u636e\u76f8\u7b26\u3002\n\n\u5206\u5b50\u6a21\u578b\u4e0d\u662f\u5206\u5b50\u7684\u7167\u7247\u3002"
    }
  ],
