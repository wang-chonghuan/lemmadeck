{
  "schema": "s10y-choice-seed-v1",
  "source": {
    "book": "6p",
    "lesson": "phy6-c3-s23",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u4e3e\u51fa\u4e00\u4e2a\u4f5c\u7528\u5728\u540c\u4e00\u76f4\u7ebf\u4e0a\u4e14\u65b9\u5411\u76f8\u540c\u7684\u4e24\u4e2a\u529b\u5408\u6210\u7684\u4f8b\u5b50.",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u53d9\u8ff0\u4e00\u4e2a\u80fd\u786e\u5b9a\u6cbf\u540c\u4e00\u76f4\u7ebf\u4f5c\u7528\u4e14\u65b9\u5411\u76f8\u540c\u7684\u4e24\u4e2a\u529b\u7684\u5408\u529b\u7684\u5b9e\u9a8c. \u8fd9\u4e2a\u5408\u529b\u7b49\u4e8e\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u4f5c\u7528\u5728\u540c\u4e00\u76f4\u7ebf\u4e0a\u800c\u65b9\u5411\u76f8\u53cd\u7684\u4e24\u4e2a\u529b\u7684\u5408\u529b\u7b49\u4e8e\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u5728\u4e24\u4e2a\u6570\u503c\u76f8\u7b49\u800c\u65b9\u5411\u76f8\u53cd\u7684\u529b\u4f5c\u7528\u4e0b\uff0c\u7269\u4f53\u5c06\u600e\u6837\u8fd0\u52a8\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u4e00\u4e2a\u8d28\u91cf\u4e3a $70$ \u5343\u514b\u7684\u4eba\u80a9\u4e0a\u625b\u7740\u4e00\u4e2a\u8d28\u91cf\u4e3a $20$ \u5343\u514b\u7684\u7bb1\u5b50.\n\u95ee\u4eba\u5bf9\u5730\u7684\u538b\u529b\u662f\u591a\u5927\uff1f\n\u6309\u672c\u8bfe\u6bcf\u5343\u514b\u8d28\u91cf\u5bf9\u5e94\u5341\u725b\u987f\u91cd\u529b\u7684\u8fd1\u4f3c\u53e3\u5f84\u4f30\u7b97.",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u56db\u4e2a\u4eba\u53c2\u52a0\u62d4\u6cb3\u6e38\u620f.\n\u5176\u4e2d\u4e8c\u4eba\u5206\u522b\u7528 $330$ \u725b\u987f\u53ca $380$ \u725b\u987f\u7684\u529b\u5411\u4e00\u4e2a\u65b9\u5411\u62c9\u7ef3.\n\u53e6\u5916\u7684\u4e24\u4e2a\u4eba\u5206\u522b\u7528 $300$ \u725b\u987f\u53ca $400$ \u725b\u987f\u7684\u529b\u5411\u53e6\u4e00\u4e2a\u65b9\u5411\u62c9\u7ef3.\n\u95ee\u7ef3\u5c06\u5411\u54ea\u4e2a\u65b9\u5411\u79fb\u52a8\uff0c\u8fd9\u56db\u4e2a\u529b\u7684\u5408\u529b\u7b49\u4e8e\u4ec0\u4e48\uff1f\n\u5408\u529b\u7684\u65b9\u5411\u662f\u5b83\u4f7f\u7ef3\u7684\u901f\u5ea6\u53d8\u5316\uff08\u52a0\u901f\u5ea6\uff09\u7684\u65b9\u5411\uff1b\u7ef3\u5f53\u524d\u7684\u79fb\u52a8\u65b9\u5411\u8fd8\u53d6\u51b3\u4e8e\u521d\u59cb\u8fd0\u52a8\u72b6\u6001.",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u8df3\u4f1e\u4eba\u5300\u901f\u4e0b\u843d.\n\u4ed6\u548c\u4f1e\u4e00\u8d77\u6240\u53d7\u7684\u91cd\u529b\u5171\u4e3a $700$ \u725b\u987f.\n\u8bd5\u95ee\u7a7a\u6c14\u7684\u963b\u529b\u662f\u591a\u5927\uff1f\n\u6309\u4e00\u5b9a\u7684\u6bd4\u4f8b\u628a\u8fd9\u4e24\u4e2a\u529b\u7528\u56fe\u8868\u793a\u51fa\u6765.\n\u505a\u56fe\u65f6\u628a\u8fd9\u4e24\u4e2a\u529b\u753b\u5728\u5b83\u4eec\u4f5c\u7528\u7ebf\u4e0a\u7684\u540c\u4e00\u4e2a\u70b9\u4e0a.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u6839\u636e\u5b9e\u9a8c\u5f97\u51fa\u7ed3\u8bba\uff1a**\u6cbf\u540c\u4e00\u76f4\u7ebf\uff0c\u800c\u4e14\u65b9\u5411\u76f8\u540c\u7684\u4e24\u4e2a\u529b\u7684\u5408\u529b\uff0c\u5176\u65b9\u5411\u4e0e\u8fd9\u4e24\u4e2a\u529b\u7684\u65b9\u5411\u76f8\u540c\uff0c\u800c\u6570\u503c\u7b49\u4e8e\u8fd9\u4e24\u4e2a\u529b\u6570\u503c\u7684\u548c.**"
    },
    {
      "block": 12,
      "text": "\u53ef\u89c1\uff0c**\u6cbf\u540c\u4e00\u76f4\u7ebf\u800c\u65b9\u5411\u76f8\u53cd\u7684\u4e24\u4e2a\u529b\u7684\u5408\u529b\uff0c\u5176\u65b9\u5411\u4e0e\u4e8c\u5206\u529b\u4e2d\u6570\u503c\u8f83\u5927\u7684\u4e00\u4e2a\u76f8\u540c\uff0c\u800c\u6570\u503c\u7b49\u4e8e\u4e8c\u5206\u529b\u6570\u503c\u4e4b\u5dee.**"
    },
    {
      "block": 17,
      "text": "**\u7269\u4f53\u5728\u4e24\u4e2a\u6570\u503c\u76f8\u7b49\u800c\u65b9\u5411\u76f8\u53cd\u7684\u529b\u4f5c\u7528\u4e0b\uff0c\u5fc5\u5904\u4e8e\u9759\u6b62\u72b6\u6001\u6216\u505a\u5300\u901f\u76f4\u7ebf\u8fd0\u52a8.**"
    }
  ],
