    ]
  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u6839\u636e\u672c\u8bfe\u5bf9\u5927\u6c14\u4fdd\u6301\u7684\u63cf\u8ff0\uff0c\u4e3a\u4ec0\u4e48\u6c14\u4f53\u5206\u5b50\u53d7\u5230\u91cd\u529b\u4f5c\u7528\uff0c\u5374\u4e0d\u4f1a\u5168\u90e8\u843d\u5230\u5730\u7403\u8868\u9762\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u6839\u636e\u672c\u8bfe\u7684\u7b80\u5316\u89e3\u91ca\uff0c\u4e3a\u4ec0\u4e48\u6c14\u4f53\u5206\u5b50\u867d\u7136\u4e0d\u65ad\u5411\u5404\u4e2a\u65b9\u5411\u8fd0\u52a8\uff0c\u7edd\u5927\u591a\u6570\u5374\u4ecd\u4fdd\u7559\u5728\u5730\u7403\u9644\u8fd1\uff0c\u800c\u4e0d\u662f\u5168\u90e8\u98de\u6563\u5230\u5b87\u5b99\u7a7a\u95f4\u4e2d\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u672c\u8bfe\u63cf\u8ff0\u7684\u5927\u6c14\u5bc6\u5ea6\u600e\u6837\u968f\u9ad8\u5ea6\u589e\u52a0\u800c\u53d8\u5316\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u56fe143\u4e2d\u7684**\u79fb\u6db2\u7ba1**\u7528\u4e8e\u63d0\u53d6\u6db2\u4f53\u8bd5\u6837\u3002\n\u628a\u7ba1\u5b50\u63d2\u5165\u6db2\u4f53\uff0c\u7528\u624b\u6307\u5835\u4f4f\u4e0a\u7aef\u5f00\u53e3\uff0c\u518d\u628a\u7ba1\u5b50\u4ece\u6db2\u4f53\u4e2d\u63d0\u8d77\u3002\n\u6253\u5f00\u4e0a\u7aef\u5f00\u53e3\u65f6\uff0c\u6db2\u4f53\u4f1a\u4ece\u7ba1\u5b50\u4e2d\u6d41\u51fa\u3002\n\u505a\u8fd9\u4e2a\u5b9e\u9a8c\uff0c\u5e76\u89e3\u91ca\u79fb\u6db2\u7ba1\u7684\u5de5\u4f5c\u539f\u7406\u3002",
      "figure_ids": [
        "fig-143"
      ]
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u56fe144\u4e2d\u7684\u80f6\u5934**\u6ef4\u7ba1**\u7528\u4e8e\u83b7\u5f97\u6db2\u6ef4\u3002\n\u7528\u6ef4\u7ba1\u505a\u6ef4\u6db2\u5b9e\u9a8c\uff0c\u5e76\u89e3\u91ca\u5b83\u7684\u5de5\u4f5c\u539f\u7406\u3002",
      "figure_ids": [
        "fig-144"
      ]
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u7ed9\u81ea\u6765\u6c34\u7b14\u704c\u58a8\u6c34\u65f6\uff0c\u5229\u7528\u4e86\u4ec0\u4e48\u7269\u7406\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u56fe145\u662f\u4f9b\u5bb6\u79bd\u996e\u6c34\u7528\u7684\u81ea\u52a8\u5582\u6c34\u5668\uff0c\u7531\u88c5\u6c34\u7684\u74f6\u5b50\u5012\u7f6e\u5728\u996e\u6c34\u69fd\u4e2d\u6784\u6210\u3002\n\u653e\u7f6e\u74f6\u5b50\u65f6\uff0c\u8ba9\u74f6\u53e3\u6bd4\u69fd\u4e2d\u7684\u6c34\u9762\u4f4e\u4e00\u4e9b\u3002\n\u5728\u88c5\u7f6e\u7a33\u5b9a\u540e\uff0c\u4e3a\u4ec0\u4e48\u74f6\u4e2d\u7684\u6c34\u505c\u6b62\u5916\u6d41\uff1f\n\u82e5\u69fd\u4e2d\u6c34\u9762\u964d\u4f4e\uff0c\u74f6\u53e3\u9732\u51fa\u6c34\u9762\uff0c\u74f6\u4e2d\u7684\u6c34\u4f1a\u6d41\u51fa\u4e00\u90e8\u5206\uff0c\u4e3a\u4ec0\u4e48\uff1f\n\u4ec0\u4e48\u65f6\u5019\u74f6\u4e2d\u7684\u6c34\u53c8\u4f1a\u505c\u6b62\u5916\u6d41\uff1f",
      "figure_ids": [
        "fig-145"
      ]
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u548c\u5176\u4ed6\u7269\u4f53\u4e00\u6837\uff0c\u7ec4\u6210\u5730\u7403\u7a7a\u6c14\u5c42\u7684\u5404\u79cd\u6c14\u4f53\u5206\u5b50\u4e5f\u53d7\u5230\u5730\u7403\u7684\u5438\u5f15\u3002"
    },
    {
      "block": 1,
      "text": "\u65e2\u7136\u53d7\u5230\u5730\u7403\u5438\u5f15\uff0c\u4e3a\u4ec0\u4e48\u8fd9\u4e9b\u5206\u5b50\u4e0d\u4f1a\u5168\u90e8\u843d\u5230\u5730\u7403\u8868\u9762\uff1f\n\u5730\u7403\u7684\u7a7a\u6c14\u5c42\uff0c\u4e5f\u5c31\u662f\u5927\u6c14\uff0c\u662f\u600e\u6837\u4fdd\u6301\u7684\uff1f\n\u7406\u89e3\u8fd9\u4e2a\u95ee\u9898\uff0c\u9700\u8981\u8003\u8651\u6c14\u4f53\u5206\u5b50\u59cb\u7ec8\u5904\u4e8e\u4e0d\u505c\u606f\u7684\u65e0\u89c4\u5219\u8fd0\u52a8\u4e2d\u3002\n\n\u53e6\u4e00\u4e2a\u95ee\u9898\u662f\uff1a\u8fd9\u4e9b\u5206\u5b50\u4e3a\u4ec0\u4e48\u4e0d\u4f1a\u5168\u90e8\u98de\u6563\u5230\u5b87\u5b99\u7a7a\u95f4\u4e2d\uff1f\n\u672c\u6559\u6750\u7528\u9760\u8fd1\u5730\u8868\u3001\u53ea\u8003\u8651\u5730\u7403\u5f15\u529b\u7684\u7406\u60f3\u5316\u901f\u5ea6\u6bd4\u8f83\u6765\u8bf4\u660e\u8fd9\u4e2a\u95ee\u9898\uff1a\u4e0e\u5b87\u5b99\u98de\u8239\u6216\u5b87\u5b99\u706b\u7bad\u4e00\u6837\uff0c\u5206\u5b50\u8981\u5b8c\u5168\u79bb\u5f00\u5730\u7403\uff0c\u9700\u8981\u5177\u6709\u4e0d\u5c0f\u4e8e$11.2$\u5343\u7c73/\u79d2\u7684\u901f\u5ea6\u3002\n\u8fd9\u4e2a\u901f\u5ea6\u79f0\u4e3a*\u7b2c\u4e8c\u5b87\u5b99\u901f\u5ea6*\u3002\n\n\u672c\u6559\u6750\u6307\u51fa\uff0c\u5730\u7403\u7a7a\u6c14\u5c42\u5206\u5b50\u7684\u5e73\u5747\u901f\u5ea6\u8fdc\u5c0f\u4e8e\u8fd9\u4e2a\u901f\u5ea6\uff0c\u6240\u4ee5\u7edd\u5927\u591a\u6570\u7a7a\u6c14\u5206\u5b50\u53d7\u5230\u91cd\u529b\u7684\u675f\u7f1a\uff0c\u4fdd\u7559\u5728\u5730\u7403\u9644\u8fd1\u3002\n\u8fd9\u662f\u672c\u8bfe\u5bf9\u5927\u6c14\u4fdd\u6301\u7684\u7b80\u5316\u89e3\u91ca\uff0c\u4e0d\u8868\u793a\u6bcf\u4e2a\u5206\u5b50\u5728\u4efb\u610f\u9ad8\u5ea6\u548c\u6761\u4ef6\u4e0b\u90fd\u4e0d\u80fd\u9003\u9038\u3002"
    },
    {
      "block": 2,
      "text": "\u5728\u672c\u8bfe\u7684\u7b80\u5316\u63cf\u8ff0\u4e2d\uff0c\u5206\u5b50\u7684\u65e0\u89c4\u5219\u8fd0\u52a8\u548c\u4f5c\u7528\u5728\u5206\u5b50\u4e0a\u7684\u91cd\u529b\u5171\u540c\u4f7f\u7edd\u5927\u591a\u6570\u6c14\u4f53\u5206\u5b50\u4fdd\u6301\u5728\u5730\u7403\u9644\u8fd1\u7684\u7a7a\u95f4\u4e2d\uff0c\u5f62\u6210\u5305\u56f4\u5730\u7403\u7684\u7a7a\u6c14\u5c42\uff0c\u4e5f\u5c31\u662f\u5927\u6c14\u3002"
    },
    {
      "block": 3,
      "text": "\u672c\u6559\u6750\u6839\u636e\u6d4b\u91cf\u8bf4\u660e\uff0c\u7a7a\u6c14\u5bc6\u5ea6\u968f\u9ad8\u5ea6\u589e\u52a0\u800c\u8fc5\u901f\u51cf\u5c0f\uff0c\u8d8a\u9ad8\u5904\u7684\u7a7a\u6c14\u8d8a\u7a00\u8584\u3002\n\u6559\u6750\u5217\u4e3e\u7684\u8fd1\u4f3c\u4f8b\u5b50\u662f\uff1a\u5730\u8868\u4e0a\u65b9$5.4$\u5343\u7c73\u5904\u7684\u7a7a\u6c14\u5bc6\u5ea6\u7ea6\u4e3a\u5730\u8868\u5904\u7684$\\frac{1}{2}$\uff0c\u5728$11$\u5343\u7c73\u5904\u7ea6\u4e3a$\\frac{1}{4}$\u3002\n\u8fd9\u4e9b\u6570\u503c\u7528\u4e8e\u8bf4\u660e\u672c\u8bfe\u7684\u53d8\u5316\u8d8b\u52bf\uff0c\u4e0d\u662f\u4efb\u610f\u5730\u70b9\u548c\u6761\u4ef6\u4e0b\u7684\u7cbe\u786e\u5bc6\u5ea6\u6bd4\u4f8b\u3002\n\n\u6309\u6559\u6750\u5bf9\u6700\u4e0a\u5c42\u7684\u8fd1\u4f3c\u63cf\u8ff0\uff0c\u5728\u5730\u7403\u4e0a\u65b9\u51e0\u767e\u5343\u7c73\u6216\u51e0\u5343\u5343\u7c73\u5904\uff0c\u5927\u6c14\u9010\u6e10\u8fc7\u6e21\u4e3a\u771f\u7a7a\uff0c\u5e76\u6ca1\u6709\u660e\u663e\u754c\u7ebf\u3002\n\u8fd9\u4e0d\u662f\u628a\u67d0\u4e00\u4e2a\u9ad8\u5ea6\u89c4\u5b9a\u4e3a\u5927\u6c14\u7a81\u7136\u7ec8\u6b62\u7684\u4f4d\u7f6e\u3002\n\u56fe142\u793a\u610f\u5730\u7403\u5927\u6c14\u4e2d\u6c14\u4f53\u5206\u5b50\u7684\u5206\u5e03\u3002"
    },
    {
      "block": 4,
      "text": "\u5728\u672c\u8bfe\u8ba8\u8bba\u7684\u6709\u91cd\u529b\u3001\u6c14\u4f53\u5904\u4e8e\u9759\u6b62\u7684\u7b80\u5316\u6a21\u578b\u4e2d\uff0c\u5bc6\u95ed\u5bb9\u5668\u5185\u7684\u6c14\u4f53\u5bc6\u5ea6\u4e5f\u4e0d\u662f\u5904\u5904\u76f8\u540c\u3002\n\u7531\u4e8e\u91cd\u529b\u4f5c\u7528\uff0c\u5e95\u90e8\u7684\u6c14\u4f53\u5bc6\u5ea6\u5927\u4e8e\u4e0a\u90e8\uff0c\u5e95\u90e8\u7684\u538b\u5f3a\u4e5f\u5927\u4e8e\u4e0a\u90e8\u3002\n\u672c\u6559\u6750\u6307\u51fa\uff0c\u4e00\u822c\u5bb9\u5668\u5185\u7684\u8fd9\u79cd\u5bc6\u5ea6\u548c\u538b\u5f3a\u5dee\u522b\u5f88\u5c0f\uff0c\u5728\u8bb8\u591a\u60c5\u51b5\u4e0b\u53ef\u4ee5\u5ffd\u7565\u3002\n\n\u4f46\u5728\u6559\u6750\u6240\u8ba8\u8bba\u7684\u8de8\u8d8a\u6570\u5343\u5343\u7c73\u9ad8\u5ea6\u8303\u56f4\u7684\u5927\u6c14\u4e2d\uff0c\u8fd9\u79cd\u968f\u9ad8\u5ea6\u7684\u53d8\u5316\u5c31\u5f88\u91cd\u8981\uff0c\u4e0d\u80fd\u540c\u6837\u5ffd\u7565\u3002"
    }
  ],
