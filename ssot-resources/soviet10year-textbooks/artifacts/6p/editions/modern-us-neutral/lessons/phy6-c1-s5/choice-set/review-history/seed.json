    },
    {
      "number": "2",
      "text": "\u4f60\u77e5\u9053\u54ea\u4e9b\u957f\u5ea6\u3001\u9762\u79ef\u53ca\u4f53\u79ef\u7684\u5355\u4f4d\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 3,
      "text": "\u7269\u7406\u91cf\u603b\u662f\u53ef\u4ee5\u6d4b\u91cf\u7684. \u6d4b\u91cf\u67d0\u4e00\u4e2a\u91cf\uff0c\u5c31\u662f\u628a\u8be5\u91cf\u4e0e\u53d6\u505a\u8fd9\u79cd\u91cf\u7684\u5355\u4f4d\u7684\u540c\u7c7b\u91cf\u8fdb\u884c\u6bd4\u8f83. \u4f8b\u5982\uff0c\u6d4b\u91cf\u684c\u5b50\u7684\u957f\u5ea6\uff0c\u5c31\u662f\u628a\u5b83\u4e0e\u53d6\u505a\u957f\u5ea6\u5355\u4f4d\u7684\u53e6\u4e00\u4e2a\u957f\u5ea6\uff0c\u6bd4\u5982\u7c73\u6765\u8fdb\u884c\u6bd4\u8f83. \u7528\u6240\u9009\u53d6\u7684\u5355\u4f4d\u8868\u793a\u7684\u6570\u503c\u4f5c\u4e3a\u6d4b\u91cf\u7684\u7ed3\u679c."
    },
    {
      "block": 4,
      "text": "\u6bcf\u4e00\u4e2a\u7269\u7406\u91cf\u90fd\u6709\u5176\u7279\u6709\u7684\u5355\u4f4d. \u4f8b\u5982\uff0c\u4e3a\u4e86\u6d4b\u91cf\u9762\u79ef\uff0c\u800c\u9009\u53d6\u4e86\u9762\u79ef\u7684\u5355\u4f4d\uff081 \u7c73^2\uff09\uff1b\n\u4e3a\u4e86\u6d4b\u91cf\u65f6\u95f4\uff0c\u800c\u9009\u53d6\u4e86\u65f6\u95f4\u7684\u5355\u4f4d\uff081 \u79d2\uff09\uff1b\n\u4e3a\u4e86\u6d4b\u91cf\u4f53\u79ef\uff0c\u800c\u9009\u53d6\u4e86\u4f53\u79ef\u7684\u5355\u4f4d\uff081 \u7c73^3\uff09."
    }
  ],
