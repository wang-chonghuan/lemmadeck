        "unit_reason": "\u539f\u9898\u7684\u4e00\u6b21\u6bd4\u8f83\u5305\u542b\u8bf4\u660e\u6240\u9700\u6d41\u901f\u6761\u4ef6\u548c\u6761\u4ef6\u6210\u7acb\u65f6\u7684\u7ed3\u8bba\u3002\u66f4\u5feb\u3001\u4e00\u6837\u5feb\u4ee5\u53ca\u672a\u77e5\u5173\u7cfb\u7684\u5224\u65ad\u53ef\u4ee5\u540c\u65f6\u6210\u7acb\uff0c\u56e0\u6b64\u4e00\u6b21\u539f\u751f\u591a\u9009\u6bd4\u786c\u9009\u552f\u4e00\u65e0\u6761\u4ef6\u7ed3\u8bba\u5408\u9002\uff1b\u4e0d\u628a\u5404\u901f\u5ea6\u60c5\u51b5\u62c6\u6210\u91cd\u590d\u5c0f\u9898\u3002\u53cd\u5411\u901f\u5ea6\u6761\u4ef6\u5728 B \u4e2d\u4f5c\u4e3a\u9700\u8981\u72ec\u7acb\u5426\u5b9a\u7684\u5224\u65ad\u51fa\u73b0\u3002",
