  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u6db2\u538b\u673a\u68b0\u7684\u5de5\u4f5c\u539f\u7406\u4e2d\u5e94\u7528\u4e86\u4ec0\u4e48\u5b9a\u5f8b\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5728\u5ffd\u7565\u6469\u64e6\u548c\u6d3b\u585e\u81ea\u91cd\u3001\u4e24\u4fa7\u5916\u754c\u538b\u5f3a\u76f8\u540c\uff0c\u5e76\u628a\u4e24\u6d3b\u585e\u4e0b\u8868\u9762\u770b\u4f5c\u7b49\u9ad8\u7684\u7406\u60f3\u60c5\u51b5\u4e0b\uff0c\u6db2\u538b\u673a\u68b0\u80fd\u5f97\u5230\u591a\u5927\u7684\u529b\u7684\u589e\u76ca\uff1f\u8bf7\u8bf4\u660e\u8fd9\u4e2a\u589e\u76ca\u4e0e\u4ec0\u4e48\u6709\u5173\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u4f7f\u7528\u6db2\u538b\u673a\u68b0\u53ef\u4ee5\u5f97\u5230\u529b\u7684\u589e\u76ca\uff0c\u4f46\u5fc5\u5b9a\u8981\u5728\u4ec0\u4e48\u65b9\u9762\u4ed8\u51fa\u4ee3\u4ef7\uff1f\u8bf7\u7ed3\u5408\u4e24\u4e2a\u6d3b\u585e\u7684\u8fd0\u52a8\u8bf4\u660e\u7406\u7531\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u80fd\u5426\u5236\u9020\u4e00\u53f0\u50cf\u6db2\u538b\u673a\u68b0\u90a3\u6837\u4f20\u9012\u538b\u5f3a\u3001\u4f46\u7528\u7a7a\u6c14\u4ee3\u66ff\u6db2\u4f53\u5de5\u4f5c\u7684\u673a\u5668\uff1f\u8bf7\u8bf4\u660e\u4f60\u7684\u5224\u65ad\u548c\u7406\u7531\uff0c\u5e76\u6bd4\u8f83\u7a7a\u6c14\u4e0e\u6db2\u4f53\u4f5c\u4e3a\u5de5\u4f5c\u4ecb\u8d28\u65f6\u7684\u533a\u522b\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6db2\u538b\u673a\u68b0$\\text{\\textcircled{1}}$\u7684\u5de5\u4f5c\u539f\u7406\u4ee5\u5e15\u65af\u5361\u5b9a\u5f8b\u4e3a\u4f9d\u636e\u3002"
    },
    {
      "block": 1,
      "text": "$\\text{\\textcircled{1}}$ \u6db2\u538b\u673a\u68b0\uff1a\u5229\u7528\u6db2\u4f53\u7684\u8fd0\u52a8\u548c\u5e73\u8861\u89c4\u5f8b\u5de5\u4f5c\u7684\u673a\u5668\u3002"
    },
    {
      "block": 2,
      "text": "\u6db2\u538b\u673a\u68b0\u7684\u4e3b\u8981\u90e8\u5206\u662f\u4e24\u4e2a\u76f4\u5f84\u4e0d\u540c\u3001\u7528\u7ba1\u9053\u8fde\u901a\u7684\u538b\u529b\u7f38\uff08\u56fe100\uff09\u3002\n\u6bcf\u4e2a\u7f38\u5185\u90fd\u6709\u4e0e\u7f38\u58c1\u7d27\u5bc6\u914d\u5408\u3001\u80fd\u591f\u79fb\u52a8\u7684\u6d3b\u585e\u3002\n\u6d3b\u585e\u4e0b\u65b9\u7684\u8fde\u901a\u7a7a\u95f4\u901a\u5e38\u88c5\u6ee1\u6cb9\uff0c\u5e38\u7528\u7684\u662f\u77ff\u7269\u6cb9\u3002"
    },
    {
      "block": 5,
      "text": "\u5728\u4e0d\u53e6\u52a0\u5916\u529b\u3001\u4e24\u4fa7\u5916\u754c\u538b\u5f3a\u76f8\u540c\uff0c\u5e76\u5ffd\u7565\u6d3b\u585e\u81ea\u91cd\u548c\u6469\u64e6\u7684\u7406\u60f3\u60c5\u51b5\u4e0b\uff0c\u4e24\u4e2a\u538b\u529b\u7f38\u4e2d\u7684\u6db2\u67f1\uff08$A$ \u548c $B$\uff09\u9ad8\u5ea6\u76f8\u540c\u3002"
    },
    {
      "block": 9,
      "text": "\u6bd4\u503c $\\frac{F_2}{F_1}$ \u8868\u793a\u529b $F_2$ \u662f\u529b $F_1$ \u7684\u591a\u5c11\u500d\uff0c\u8fd9\u5c31\u662f\u673a\u5668\u7684**\u529b\u7684\u589e\u76ca**\u3002"
    },
    {
      "block": 10,
      "text": "**\u5927\u6d3b\u585e\u7684\u9762\u79ef\u662f\u5c0f\u6d3b\u585e\u9762\u79ef\u7684\u591a\u5c11\u500d\uff0c\u6db2\u538b\u673a\u68b0\u5c31\u80fd\u83b7\u5f97\u591a\u5c11\u500d\u7684\u529b\u7684\u589e\u76ca**\u3002\n\u8fd9\u4e2a\u7ed3\u8bba\u91c7\u7528\u524d\u9762\u8bf4\u660e\u7684\u7406\u60f3\u6761\u4ef6\uff0c\u7279\u522b\u662f\u5ffd\u7565\u6d3b\u585e\u4e0e\u7f38\u58c1\u4e4b\u95f4\u7684\u6469\u64e6\u3002\n\u5982\u679c\u4e24\u6d3b\u585e\u4e0b\u8868\u9762\u7684\u9ad8\u5ea6\u5dee\u6240\u9020\u6210\u7684\u6db2\u67f1\u538b\u5f3a\u4e0d\u80fd\u5ffd\u7565\uff0c\u6c42\u5e73\u8861\u529b\u65f6\u8fd8\u5fc5\u987b\u8003\u8651\u8fd9\u4e00\u5dee\u522b\u3002"
    }
  ],
