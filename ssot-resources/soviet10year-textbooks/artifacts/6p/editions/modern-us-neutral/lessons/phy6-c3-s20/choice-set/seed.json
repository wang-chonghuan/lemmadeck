  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u7528\u4ec0\u4e48\u4eea\u5668\u6765\u6d4b\u91cf\u529b\uff1f\n\u4eea\u5668\u7684\u6784\u9020\u539f\u7406\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u600e\u6837\u5236\u505a\u4e00\u4e2a\u6700\u7b80\u5355\u7684\u6d4b\u529b\u8ba1\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u600e\u6837\u5728\u4e00\u4e2a\u6d4b\u529b\u8ba1\u7684\u523b\u5ea6\u76d8\u4e0a\u6807\u51fa\u4e0e $0.1$ \u725b\u987f\u76f8\u5bf9\u5e94\u7684\u5206\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u63e1\u529b\u8ba1\u548c\u7275\u5f15\u6d4b\u529b\u8ba1\u5404\u662f\u505a\u4ec0\u4e48\u7528\u7684\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6d4b\u91cf\u529b\u7684\u4eea\u5668\u53eb\u505a**\u6d4b\u529b\u8ba1**.\n**\u6d4b\u529b\u8ba1\u662f\u6839\u636e\u5f39\u7c27\u7684\u5f62\u53d8\u589e****\u52a0\u591a\u5c11\u500d\uff0c\u5219\u5f39\u7c27\u7684\u5f39\u529b\u5c31\u589e\u52a0\u591a\u5c11\u500d**\u8fd9\u4e00\u539f\u7406\u505a\u6210\u7684."
    },
    {
      "block": 1,
      "text": "\u6700\u7b80\u5355\u7684\u5f39\u7c27\u6d4b\u529b\u8ba1\u5236\u6cd5\u5982\u4e0b.\n\u5728\u4e00\u5757\u7cca\u7740\u767d\u7eb8\u7684\u5c0f\u6728\u677f\u4e0a\u88c5\u4e00\u6839\u5f39\u7c27\uff0c\u5f39\u7c27\u4e0b\u7aef\u662f\u4e00\u6839\u5e26\u94a9\u7684\u7ec6\u6746\uff08\u56fe 65\uff0ca\uff09.\n\u5728\u7ec6\u6746\u4e0a\u90e8\u5b89\u4e0a\u4e00\u4e2a\u6307\u9488\uff0c\u5e76\u5c06\u5f39\u7c27\u672a\u4f38\u957f\u65f6\u6307\u9488\u7684\u4f4d\u7f6e\u5728\u7eb8\u4e0a\u6807\u51fa\u6765\uff0c\u8fd9\u5c31\u662f\u96f6\u5206\u5ea6.\n\n\u7136\u540e\u5728\u94a9\u4e0a\u6302\u4e00\u4e2a $\\frac{1}{9.8}$ \u5343\u514b\uff0c\u5373 $102$ \u514b\u8d28\u91cf\u7684\u781d\u7801.\n\u8fd9\u4e2a\u781d\u7801\u6240\u53d7\u7684\u91cd\u529b\u5c31\u662f $1$ \u725b\u987f.\n\u5728 $1$ \u725b\u987f\u529b\u7684\u4f5c\u7528\u4e0b\uff0c\u5f39\u7c27\u88ab\u62c9\u4f38\uff0c\u6307\u9488\u5411\u4e0b\u964d.\n\n\u518d\u628a\u6307\u9488\u7684\u65b0\u4f4d\u7f6e\u6807\u5728\u7eb8\u4e0a\uff0c\u5e76\u5728\u8fd9\u4e2a\u6807\u8bb0\u7684\u65c1\u8fb9\u6ce8\u4e0a\u6570\u5b57 $1$\uff08\u56fe 65\uff0cb\uff09.\n\u7136\u540e\u518d\u6302\u4e0a $204$ \u514b\u8d28\u91cf\u7684\u781d\u7801\uff0c\u628a\u6307\u9488\u7684\u4f4d\u7f6e\u6807\u4e3a $2$\uff0c\u8868\u793a\u6307\u9488\u5728\u8fd9\u4e2a\u4f4d\u7f6e\u65f6\u5f39\u7c27\u7684\u5f39\u529b\u662f $2$ \u725b\u987f.\n\u4f9d\u6b64\u7c7b\u63a8\uff0c\u518d\u7528 $306$ \u514b\u7684\u781d\u7801\u6807\u51fa $3$\uff0c\u7b49\u7b49."
    },
    {
      "block": 4,
      "text": "\u8fd8\u80fd\u628a\u4e0e\u5341\u5206\u4e4b\u51e0\u725b\u987f\u76f8\u5bf9\u5e94\u7684\u5404\u5206\u5ea6\uff1a\n$0.1$\u3001$0.2$\u3001$0.3$ \u725b\u987f\u7b49\u6807\u51fa\u6765\uff0c\u8fd9\u53ea\u9700\u628a\u7531 $0$ \u5230 $1$\u3001\u7531 $1$ \u5230 $2$\u3001\u7531 $2$ \u5230 $3$ \u7b49\u5404\u6807\u8bb0\u95f4\u7684\u8ddd\u79bb\u5341\u7b49\u5206\u5c31\u53ef\u4ee5\u4e86."
    },
    {
      "block": 5,
      "text": "\u7ecf\u8fc7\u8fd9\u6837\u523b\u5ea6\u7684\u5f39\u7c27\u5c31\u6210\u4e86\u4e00\u4e2a\u6700\u7b80\u5355\u7684\u6d4b\u529b\u8ba1.\n\uff08\u7ed9\u4eea\u5668\u523b\u5ea6\u7684\u610f\u601d\u5c31\u662f\u5728\u4eea\u5668\u4e0a\u6807\u51fa\u6240\u6709\u7684\u5206\u5ea6\u6765.\uff09"
    },
    {
      "block": 6,
      "text": "\u5f53\u7136\uff0c\u6d4b\u529b\u8ba1\u4e0d\u4ec5\u53ef\u4ee5\u7528\u6765\u6d4b\u91cf\u91cd\u529b\uff0c\u4e5f\u53ef\u4ee5\u7528\u6765\u6d4b\u91cf\u6469\u64e6\u529b\u3001\u5f39\u529b\u7b49\u5176\u5b83\u7c7b\u578b\u7684\u529b."
    },
    {
      "block": 7,
      "text": "\u8981\u6d4b\u91cf\u624b\u7684\u63e1\u529b\u53ef\u4ee5\u4f7f\u7528\u624b\u63e1\u5f0f\u6d4b\u529b\u8ba1\u2014\u2014**\u63e1\u529b\u8ba1**\uff08\u56fe 66\uff09.\n\u8fd9\u79cd\u6d4b\u529b\u8ba1\u7684\u4e3b\u8981\u90e8\u5206\u662f\u4e00\u4e2a\u88c5\u6709\u793a\u6570\u673a\u6784\u7684\u692d\u5706\u5f62\u5f39\u7c27.\n\u5f53\u5f39\u7c27\u88ab\u538b\u7f29\u65f6\uff0c\u793a\u6570\u673a\u6784\u5c31\u4f7f\u6307\u9488\u504f\u8f6c\uff0c\u6307\u51fa\u529b\u7684\u5927\u5c0f\u6240\u5bf9\u5e94\u7684\u5206\u5ea6\u6570."
    },
    {
      "block": 10,
      "text": "\u8981\u6d4b\u91cf\u5f88\u5927\u7684\u529b\uff0c\u4f8b\u5982\u62d6\u62c9\u673a\u7684\u7275\u5f15\u529b\uff0c\u5c31\u8981\u7528\u4e13\u95e8\u7684**\u7275****\u5f15\u6d4b\u529b\u8ba1**\uff08\u56fe 67\uff09.\n\u7528\u8fd9\u79cd\u6d4b\u529b\u8ba1\u53ef\u4ee5\u6d4b\u91cf\u51e0\u4e07\u725b\u987f\u7684\u529b."
    }
  ],
