    },
    {
      "number": "3",
      "text": "\uff083\uff09\u600e\u6837\u627e\u51fa\u4e00\u4e2a\u529b\u7684\u529b\u81c2\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u65bd\u4e8e\u6760\u6746\u4e0a\u7684\u529b\u8d77\u4ec0\u4e48\u4f5c\u7528\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u6760\u6746\u5e73\u8861\u7684\u89c4\u5f8b\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "\uff086\uff09\u6760\u6746\u5e73\u8861\u7684\u89c4\u5f8b\u662f\u8c01\u53d1\u73b0\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "q1",
      "text": "**\u5c06\u4e00\u628a\u5c3a\u5b50\u7684\u4e2d\u70b9\u653e\u5728\u4e00\u4e2a\u652f\u627f\u9762\u5f88\u5c0f\u7684\u652f\u627f\u7269\u4e0a\uff0c\u5e76\u4f7f\u5c3a\u5b50\u4fdd\u6301\u5e73\u8861**\u3002\n**\u8fd9\u6837\u5c31\u505a\u6210\u4e86\u4e00\u4e2a\u6760\u6746**\u3002\n**\u5c06\u4e00\u4e2a5 \u514b\u7684\u5b9e\u9a8c\u781d\u7801\u548c\u4e00\u4e2a1 \u514b\u7684\u5b9e\u9a8c\u781d\u7801\u653e\u5728\u6760\u6746\u4e0a\uff0c\u5e76\u4f7f\u5b83\u4eec\u5f7c\u6b64\u5e73\u8861**\u3002\n**\u91cf\u51fa\u529b\u81c2\u7684\u957f\u77ed\uff0c\u68c0\u9a8c\u6760\u6746\u7684\u5e73\u8861\u6761\u4ef6**\u3002\n**\u75282 \u514b\u548c3 \u514b\u7684\u5b9e\u9a8c\u781d\u7801\u518d\u628a\u5b9e\u9a8c\u91cd\u505a\u4e00\u904d**\u3002\n**\u4ecd\u7528\u8fd9\u6837\u7684\u6760\u6746\u6c42\u51fa\u4e00\u4e2a\u706b\u67f4\u76d2\u7684\u91cd\u91cf**\u3002\n**\u9644\u6ce8\uff1a1\u30012\u30013 \u548c5 \u514b\u7684\u5b9e\u9a8c\u781d\u7801\uff0c\u5176\u8d28\u91cf\u5206\u522b\u4e3a1\u30012\u30013 \u548c5 \u514b**\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "**\u6760\u6746\u662f\u53ef\u4ee5\u7ed5\u56fa\u5b9a\u652f\u70b9\u8f6c\u52a8\u7684\u56fa\u4f53**\u3002"
    },
    {
      "block": 4,
      "text": "\u56fe180\u4e2d\u7684\u6760\u6746\uff0c\u5176\u8f6c\u52a8\u8f74\u7ebf$O$\uff08\u652f\u70b9\uff09\u4f4d\u4e8e\u529b\u7684\u4f5c\u7528\u70b9$A$\u548c$B$\u4e4b\u95f4\u3002\n\u56fe181\u662f\u8fd9\u6839\u6760\u6746\u7684\u793a\u610f\u56fe\u3002\n\u5728\u8fd9\u5e45\u793a\u610f\u56fe\u4e2d\uff0c\u4f5c\u7528\u5728\u6760\u6746\u4e0a\u7684\u4e24\u4e2a\u529b$F_1$\u548c$F_2$\u90fd\u6307\u5411\u4e0b\u65b9\u3002"
    },
    {
      "block": 9,
      "text": "**\u652f\u70b9\u5230\u65bd\u4e8e\u6760\u6746\u7684\u529b\u7684\u4f5c\u7528\u7ebf\u4e4b\u95f4\u7684\u6700\u77ed\u8ddd\u79bb\uff0c\u53eb\u505a\u529b\u81c2**\u3002"
    },
    {
      "block": 10,
      "text": "\u627e\u529b\u81c2\u65f6\uff0c**\u8981\u4ece\u652f\u70b9\u5411\u529b\u7684\u4f5c\u7528\u7ebf\u4f5c\u5782\u7ebf**\uff0c\u8fd9\u6761\u5782\u7ebf\u7684\u957f\u5ea6\u5c31\u662f\u529b\u81c2\u3002\n\u7531\u56fe181\u53ef\u89c1\uff0c$OA$\u662f$F_1$\u7684\u529b\u81c2\uff0c$OB$\u662f$F_2$\u7684\u529b\u81c2\u3002"
    },
    {
      "block": 11,
      "text": "\u4f5c\u7528\u5728\u6760\u6746\u4e0a\u7684\u529b\uff0c\u53ef\u4ee5\u4f7f\u6760\u6746\u7ed5\u8f74\u7ebf\u987a\u65f6\u9488\u6216\u9006\u65f6\u9488\u8f6c\u52a8\u3002\n\u56fe181\u4e2d\uff0c\u529b$F_1$\u6709\u4f7f\u6760\u6746\u987a\u65f6\u9488\u8f6c\u52a8\u7684\u4f5c\u7528\uff0c\u800c\u529b$F_2$\u6709\u4f7f\u5b83\u9006\u65f6\u9488\u8f6c\u52a8\u7684\u4f5c\u7528\u3002"
    },
    {
      "block": 12,
      "text": "\u901a\u8fc7\u5b9e\u9a8c\u53ef\u4ee5\u627e\u5230\u6760\u6746\u5728\u6240\u53d7\u529b\u7684\u4f5c\u7528\u4e0b\u4fdd\u6301\u5e73\u8861\u7684\u6761\u4ef6\u3002\n\u6ce8\u610f\uff0c\u529b\u7684\u4f5c\u7528\u6548\u679c\u4e0d\u4ec5\u4e0e\u529b\u7684\u5927\u5c0f\u6709\u5173\uff0c\u8fd8\u4e0e\u4f5c\u7528\u70b9\u7684\u4f4d\u7f6e\u548c\u529b\u7684\u65b9\u5411\u6709\u5173\u3002"
    },
    {
      "block": 14,
      "text": "\u6839\u636e\u8fd9\u6837\u7684\u5b9e\u9a8c\uff0c\u53ef\u4ee5\u5f97\u5230\u6760\u6746\u7684\u5e73\u8861\u89c4\u5f8b\u3002\n**\u5f53\u4e24\u4e2a\u529b\u7684\u8f6c\u52a8\u6548\u679c\u76f8\u53cd\uff0c\u4e14\u529b\u7684\u5927\u5c0f\u4e0e\u5404\u81ea\u7684\u529b\u81c2\u6210\u53cd\u6bd4\u65f6\uff0c\u6760\u6746\u5c31\u5e73\u8861**\u3002"
    },
    {
      "block": 16,
      "text": "$\\frac{F_1}{F_2}=\\frac{l_2}{l_1}$\u3002"
    },
    {
      "block": 17,
      "text": "\u5f0f\u4e2d\uff0c$F_1$\u548c$F_2$\u662f\u4f5c\u7528\u5728\u6760\u6746\u4e0a\u7684\u529b\uff0c$l_1$\u548c$l_2$\u662f\u8fd9\u4e9b\u529b\u7684\u529b\u81c2\uff08\u56fe181\uff09\u3002"
    },
    {
      "block": 18,
      "text": "\u672c\u6559\u6750\u4ecb\u7ecd\uff0c\u6760\u6746\u5e73\u8861\u7684\u8fd9\u4e2a\u89c4\u5f8b\u662f**\u963f\u57fa\u7c73\u5fb7**\u53d1\u73b0\u7684\u3002"
    }
  ],
