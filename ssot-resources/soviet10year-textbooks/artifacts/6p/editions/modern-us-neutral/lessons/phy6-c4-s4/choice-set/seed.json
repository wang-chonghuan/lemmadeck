  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u6db2\u4f53\u7684\u4ec0\u4e48\u8868\u9762\u53eb\u505a\u81ea\u7531\u8868\u9762\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5728\u9759\u6b62\u7684\u5bbd\u655e\u5bb9\u5668\u4e2d\uff0c\u6db2\u4f53\u8fbe\u5230\u9759\u6b62\u5e73\u8861\uff0c\u81ea\u7531\u8868\u9762\u4e0a\u65b9\u7684\u6c14\u4f53\u538b\u5f3a\u8fd1\u4f3c\u76f8\u540c\uff0c\u5e76\u5ffd\u7565\u5668\u58c1\u9644\u8fd1\u7684\u8868\u9762\u5f2f\u66f2\u65f6\uff0c\u600e\u6837\u89e3\u91ca\u6db2\u4f53\u7684\u81ea\u7531\u8868\u9762\u662f\u6c34\u5e73\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u68c0\u9a8c\u5e73\u9762\u662f\u5426\u6c34\u5e73\u7684\u4eea\u5668\u7684\u540d\u79f0\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u600e\u6837\u89e3\u91ca\u901a\u5e38\u60c5\u51b5\u4e0b\u6c14\u4f53\u4e0d\u50cf\u6db2\u4f53\u90a3\u6837\u5177\u6709\u81ea\u7531\u8868\u9762\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u7528\u94c5\u5782\u7ebf\uff08\u60ac\u6302\u91cd\u7269\u7684\u7ec6\u7ebf\uff09\u548c\u4e09\u89d2\u677f\uff0c\u68c0\u67e5\u9759\u6b62\u5bb9\u5668\u4e2d\u6db2\u4f53\u8fbe\u5230\u9759\u6b62\u5e73\u8861\u540e\u7684\u81ea\u7531\u8868\u9762\u662f\u5426\u6c34\u5e73\uff0c\u5e76\u753b\u51fa\u5b9e\u9a8c\u793a\u610f\u56fe\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u56fe 108 \u6240\u793a\u7684\u662f\u7528\u539a\u7eb8\u6216\u786c\u7eb8\u677f\u5236\u4f5c\u7684\u6c34\u5e73\u4eea\u3002\n\u8bf7\u7167\u56fe\u5236\u4f5c\u4e00\u4e2a\uff0c\u5e76\u7528\u5b83\u68c0\u67e5\u7a97\u53f0\u3001\u684c\u9762\u548c\u5730\u677f\u662f\u5426\u6c34\u5e73\u3002",
      "figure_ids": [
        "fig-108"
      ]
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u7528\u6c34\u5e73\u4eea\u548c\u5c0f\u6728\u6954\u628a\u4e00\u5757\u80f6\u5408\u677f\u6216\u4e00\u5c0f\u5757\u6728\u677f\u8c03\u5230\u6c34\u5e73\uff08\u56fe 109\uff09\u3002\n\u5728\u677f\u9762\u5e73\u6574\u3001\u6ca1\u6709\u660e\u663e\u632f\u52a8\u7684\u6761\u4ef6\u4e0b\uff0c\u8f7b\u8f7b\u653e\u4e0a\u4e00\u4e2a\u539f\u5148\u9759\u6b62\u7684\u6eda\u73e0\uff0c\u89c2\u5bdf\u5b83\u662f\u5426\u6eda\u52a8\u3002\n\u7406\u60f3\u60c5\u51b5\u4e0b\uff0c\u6c34\u5e73\u677f\u9762\u4e0d\u4f1a\u4f7f\u539f\u5148\u9759\u6b62\u7684\u6eda\u73e0\u56e0\u503e\u659c\u800c\u81ea\u884c\u6eda\u52a8\u3002",
      "figure_ids": [
        "fig-109"
      ]
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "**\u4e0d\u4e0e\u5bb9\u5668\u58c1\u63a5\u89e6\u7684\u6db2\u4f53\u8868\u9762\u53eb\u505a\u6db2\u4f53\u7684\u81ea\u7531\u8868\u9762**\u3002\n\u8fd9\u91cc\u8ba8\u8bba\u7684\u662f\u4e0e\u6c14\u4f53\u76f8\u63a5\u7684\u6db2\u4f53\u8868\u9762\u3002"
    },
    {
      "block": 1,
      "text": "\u5bb9\u5668\u4e2d\u7684\u6db2\u4f53\u4e5f\u53d7\u5230\u91cd\u529b\u4f5c\u7528\u3002\n\u5728\u91cd\u529b\u4f5c\u7528\u4e0b\uff0c\u6db2\u4f53\u4ece\u9ad8\u5904\u6d41\u5411\u4f4e\u5904\uff0c\u76f4\u5230\u8fbe\u5230\u9759\u6b62\u5e73\u8861\u3002\n\u5bf9\u4e8e\u9759\u6b62\u7684\u5bbd\u655e\u5bb9\u5668\uff0c\u5982\u679c\u81ea\u7531\u8868\u9762\u4e0a\u65b9\u7684\u6c14\u4f53\u538b\u5f3a\u8fd1\u4f3c\u76f8\u540c\uff0c\u5e76\u5ffd\u7565\u5668\u58c1\u9644\u8fd1\u7684\u8868\u9762\u5f2f\u66f2\u548c\u5fae\u5c0f\u8d77\u4f0f\uff0c\u4ece\u5b8f\u89c2\u4e0a\u770b\uff0c\u81ea\u7531\u8868\u9762\u5404\u5904\u4f4d\u4e8e\u540c\u4e00\u9ad8\u5ea6\uff0c\u4e5f\u5c31\u662f\u5904\u4e8e\u540c\u4e00**\u6c34\u5e73\u9762**\u5185\u3002"
    },
    {
      "block": 2,
      "text": "**\u6c34\u5e73\u9762\u5c31\u662f\u6cbf\u6c34\u5e73\u65b9\u5411\u5ef6\u4f38\u7684\u5e73\u9762**\u3002\n\u7528\u6765\u68c0\u9a8c\u5e73\u9762\u662f\u5426\u6c34\u5e73\u7684\u4eea\u5668\u53eb\u505a**\u6c34\u5e73\u4eea**\uff08\u56fe 107\uff09\u3002"
    },
    {
      "block": 5,
      "text": "\u901a\u5e38\u60c5\u51b5\u4e0b\uff0c\u6c14\u4f53\u4e0d\u50cf\u6db2\u4f53\u90a3\u6837\u5177\u6709\u81ea\u7531\u8868\u9762\u3002\n\u6c14\u4f53\u5206\u5b50\u4e4b\u95f4\u7684\u8ddd\u79bb\u901a\u5e38\u6bd4\u6db2\u4f53\u5206\u5b50\u4e4b\u95f4\u7684\u8ddd\u79bb\u5927\u5f97\u591a\uff08\u00a714\uff09\uff0c\u5206\u5b50\u95f4\u7684\u76f8\u4e92\u5438\u5f15\u4f5c\u7528\u8f83\u5f31\u3002\n\u6c14\u4f53\u5206\u5b50\u53ef\u4ee5\u5411\u5404\u4e2a\u65b9\u5411\u8fd0\u52a8\uff0c\u6240\u4ee5**\u6c14\u4f53\u5c31\u8981\u5360\u6ee1\u5b83\u6240\u80fd\u5360\u6709\u7684\u5168\u90e8\u4f53\u79ef**\u3002"
    }
  ],
