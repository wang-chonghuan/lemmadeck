  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u4e3e\u51fa\u4e00\u4e9b\u901a\u8fc7\u589e\u5927\u652f\u627f\u9762\u79ef\u6765\u51cf\u5c0f\u538b\u5f3a\u7684\u4f8b\u5b50\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4e3a\u4ec0\u4e48\u8bb8\u591a\u519c\u4e1a\u673a\u68b0\u7684\u884c\u8d70\u8f6e\u91c7\u7528\u5f88\u5bbd\u7684\u8f6e\u7f18\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u4e3a\u4ec0\u4e48\u5203\u53e3\u6216\u5c16\u7aef\u950b\u5229\u7684\u5207\u5272\u3001\u7a7f\u523a\u5de5\u5177\u80fd\u5bf9\u7269\u4f53\u4ea7\u751f\u5f88\u5927\u7684\u538b\u5f3a\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u89c2\u5bdf\u5e73\u53e3\u94b3\u5b50\u548c\u8001\u864e\u94b3\u5b50\uff08\u56fe 88\uff09\u7684\u6784\u9020\u3002\u5047\u8bbe\u4e24\u79cd\u94b3\u5b50\u5bf9\u88ab\u5939\u7269\u4f53\u65bd\u52a0\u7684\u538b\u529b\u5927\u5c0f\u76f8\u540c\uff0c\u7528\u54ea\u4e00\u79cd\u94b3\u5b50\u4f1a\u5bf9\u7269\u4f53\u4ea7\u751f\u66f4\u5927\u7684\u5e73\u5747\u538b\u5f3a\uff1f\u8fd9\u91cc\u6bd4\u8f83\u7684\u662f\u94b3\u53e3\u5bf9\u7269\u4f53\u7684\u538b\u529b\uff0c\u4e0d\u662f\u624b\u5bf9\u94b3\u67c4\u65bd\u52a0\u7684\u529b\u3002",
      "figure_ids": [
        "fig-88"
      ]
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u4e3a\u4ec0\u4e48\u8019\u575a\u786c\u7684\u571f\u58e4\u65f6\u8981\u5728\u8019\u4e0a\u538b\u4e0a\u914d\u91cd\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u5728\u53ea\u6bd4\u8f83\u652f\u627f\u9762\u79ef\u7684\u7b80\u5316\u6a21\u578b\u4e2d\uff0c\u5047\u8bbe\u4eba\u5bf9\u5730\u677f\u7684\u538b\u529b\u5927\u5c0f\u76f8\u540c\uff1a\u6bd4\u8f83\u53cc\u811a\u7ad9\u7acb\u548c\u5954\u8dd1\u4e2d\u53ea\u6709\u4e00\u53ea\u811a\u63a5\u89e6\u5730\u677f\u7684\u9636\u6bb5\uff0c\u54ea\u4e00\u79cd\u5bf9\u5730\u677f\u4ea7\u751f\u7684\u5e73\u5747\u538b\u5f3a\u8f83\u5927\uff1f\u4e0d\u6bd4\u8f83\u53cc\u811a\u79bb\u5730\u7684\u9636\u6bb5\uff0c\u4e5f\u4e0d\u8ba1\u5954\u8dd1\u5f15\u8d77\u7684\u538b\u529b\u53d8\u5316\u3002",
      "figure_ids": []
    },
    {
      "number": "g3-1",
      "text": "\uff081\uff09\u6d4b\u51fa\u4f60\u7684\u8d28\u91cf\u548c\u978b\u5e95\u7684\u652f\u627f\u9762\u79ef\uff0c\u4f30\u7b97\u884c\u8d70\u65f6\u4e0e\u7ad9\u7acb\u4e0d\u52a8\u65f6\u5bf9\u5730\u9762\u7684\u5e73\u5747\u538b\u5f3a\u3002\u7528\u4f53\u91cd\u8fd1\u4f3c\u5bf9\u5730\u9762\u7684\u538b\u529b\uff0c\u4e0d\u8ba1\u884c\u8d70\u4e2d\u7684\u7ad6\u76f4\u52a0\u901f\uff1b\u884c\u8d70\u53d6\u5355\u811a\u652f\u627f\u9636\u6bb5\uff0c\u7ad9\u7acb\u53d6\u53cc\u811a\u652f\u627f\u72b6\u6001\uff0c\u4f7f\u7528\u5404\u81ea\u5b9e\u9645\u8d77\u652f\u627f\u4f5c\u7528\u7684\u9762\u79ef\u3002\n\u978b\u5e95\u652f\u627f\u9762\u79ef\u53ef\u8fd9\u6837\u6d4b\u91cf\uff1a\u628a\u811a\u8e0f\u5728\u65b9\u683c\u7eb8\u4e0a\uff0c\u52fe\u753b\u978b\u5e95\u8d77\u652f\u627f\u4f5c\u7528\u90e8\u5206\u7684\u8f6e\u5ed3\uff08\u56fe 89\uff09\u3002\u6570\u51fa\u8f6e\u5ed3\u5185\u5b8c\u6574\u7684\u65b9\u683c\u6570\uff0c\u518d\u52a0\u4e0a\u88ab\u8f6e\u5ed3\u7ebf\u7a7f\u8fc7\u7684\u4e0d\u5b8c\u6574\u65b9\u683c\u6570\u7684\u4e00\u534a\u3002\u628a\u6240\u5f97\u6570\u5b57\u4e58\u4ee5\u6bcf\u4e2a\u65b9\u683c\u7684\u9762\u79ef\uff0c\u5c31\u5f97\u5230\u8fd1\u4f3c\u652f\u627f\u9762\u79ef\u3002\u82e5\u4f7f\u7528\u8bfe\u6587\u6240\u8ff0\u7ec3\u4e60\u672c\u65b9\u683c\u7eb8\uff0c\u6bcf\u683c\u9762\u79ef\u4e3a $\\frac{1}{4}$ \u5398\u7c73$^2$\uff1b\u4f7f\u7528\u5176\u4ed6\u65b9\u683c\u7eb8\u65f6\uff0c\u5e94\u5148\u6d4b\u5b9a\u6bcf\u683c\u9762\u79ef\u3002",
      "figure_ids": [
        "fig-89"
      ]
    },
    {
      "number": "g3-2",
      "text": "\uff082\uff09\u6d4b\u91cf\u4e00\u5757\u7816\u7684\u957f\u3001\u5bbd\u3001\u9ad8\uff0c\u6c42\u51fa\u4f53\u79ef\u3002\u4ece\u5bc6\u5ea6\u8868\u67e5\u51fa\u7816\u7684\u5bc6\u5ea6\uff0c\u7b97\u51fa\u5b83\u7684\u91cd\u91cf\u3002\u8ba1\u7b97\u7816\u7684\u5404\u4e2a\u9762\u7684\u9762\u79ef\uff0c\u518d\u6c42\u51fa\u7816\u5e73\u653e\u3001\u4fa7\u653e\u3001\u7ad6\u653e\u5728\u6c34\u5e73\u9762\u4e0a\u65f6\u4ea7\u751f\u7684\u5e73\u5747\u538b\u5f3a\u3002\u628a\u8fd9\u51e0\u79cd\u4e0d\u540c\u653e\u6cd5\u5206\u522b\u753b\u51fa\u6765\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "**\u5728\u540c\u6837\u5927\u5c0f\u7684\u538b\u529b\u4f5c\u7528\u4e0b\uff0c\u652f\u627f\u9762\u79ef\u8d8a\u5927\uff0c\u5e73\u5747\u538b\u5f3a\u5c31\u8d8a\u5c0f**\u3002"
    },
    {
      "block": 2,
      "text": "\u5728\u538b\u529b\u5927\u5c0f\u76f8\u540c\u7684\u6761\u4ef6\u4e0b\uff0c\u8981\u51cf\u5c0f\u538b\u5f3a\uff0c\u53ef\u4ee5\u589e\u5927\u652f\u627f\u9762\u79ef\uff1b\n\u8981\u589e\u5927\u538b\u5f3a\uff0c\u53ef\u4ee5\u51cf\u5c0f\u652f\u627f\u9762\u79ef\u3002"
    },
    {
      "block": 11,
      "text": "\u53e6\u4e00\u65b9\u9762\uff0c**\u53d7\u538b\u9762\u79ef\u5f88\u5c0f\u65f6\uff0c\u4e0d\u5927\u7684\u538b\u529b\u4e5f\u80fd\u4ea7\u751f\u5f88\u5927\u7684\u538b\u5f3a**\u3002\n\u5200\u5b50\u3001\u526a\u5b50\u3001\u5404\u79cd\u5200\u5177\u3001\u952f\u548c\u9488\u7b49\u5207\u5272\u3001\u7a7f\u523a\u5de5\u5177\uff0c\u5e38\u628a\u5203\u53e3\u6216\u5c16\u7aef\u505a\u5f97\u950b\u5229\uff0c\u51cf\u5c0f\u4e0e\u88ab\u52a0\u5de5\u7269\u4f53\u7684\u63a5\u89e6\u9762\u79ef\u3002"
    }
  ],
