  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u91cd\u529b\u5bf9\u7269\u4f53\u4f5c\u7528\u7684\u7ed3\u679c\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4ec0\u4e48\u6837\u7684\u529b\u53eb\u505a\u5f39\u529b\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6211\u4eec\u5df2\u7ecf\u77e5\u9053\uff0c\u5730\u7403\u4e0a\u7684\u4e00\u5207\u7269\u4f53\u90fd\u8981\u53d7\u5230\u91cd\u529b\u7684\u4f5c\u7528.\n\u91cd\u529b\u662f\u5931\u53bb\u652f\u6301\u7684\u7269\u4f53\u843d\u5411\u5730\u9762\u7684\u539f\u56e0.\n\u5728\u91cd\u529b\u7684\u4f5c\u7528\u4e0b\uff0c\u96e8\u6ef4\u3001\u96ea\u82b1\u3001\u4ece\u6811\u679d\u4e0a\u8131\u843d\u7684\u6811\u53f6\u7b49\u90fd\u843d\u5411\u5730\u9762."
    },
    {
      "block": 1,
      "text": "\u4f46\u662f\u5f53\u96ea\u843d\u5230\u4e86\u5c4b\u9876\u4e0a\uff0c\u5c3d\u7ba1\u91cd\u529b\u4ecd\u65e7\u4f5c\u7528\u7740\uff0c\u53ef\u662f\u5b83\u4e0d\u518d\u4e0b\u843d\u4e86\uff0c\u800c\u662f\u4fdd\u6301\u9759\u6b62.\n\u6211\u4eec\u5c31\u6765\u7814\u7a76\u4e00\u4e0b\uff0c\u4e3a\u4ec0\u4e48\u653e\u5728\u652f\u627f\u7269\u4e0a\u7684\u7269\u4f53\u6216\u60ac\u6302\u5728\u7ef3\u4e0a\u7684\u7269\u4f53\u80fd\u4fdd\u6301\u9759\u6b62."
    },
    {
      "block": 6,
      "text": "\u4f46\u8fd9\u53e6\u5916\u7684\u4e00\u4e2a\u529b\u662f\u4ece\u54ea\u513f\u4ea7\u751f\u7684\u5462\uff1f\n\u4e3a\u4e86\u56de\u7b54\u8fd9\u4e2a\u95ee\u9898\uff0c\u8ba9\u6211\u4eec\u6765\u770b\u4e00\u770b\u5f53\u6728\u677f\u5411\u4e0b\u8fd0\u52a8\u65f6\uff0c\u6728\u677f\u53d1\u751f\u4e86\u4ec0\u4e48\u53d8\u5316\uff1f\n\n\u539f\u6765\u5728\u8fd0\u52a8\u7684\u65f6\u5019\u6728\u677f\uff08\u6216\u5176\u5b83\u4efb\u4f55\u652f\u627f\u7269\uff0c\u56fe 58\uff0cb\uff09\u5f2f\u66f2\u4e86\u2014\u2014\u53d1\u751f\u4e86\u5f62\u53d8.\n\u8fd9\u65f6\u5c31\u4ea7\u751f\u4e86\u652f\u627f\u7269\uff08\u5728\u6211\u4eec\u7684\u4f8b\u5b50\u4e2d\u5c31\u662f\u6728\u677f\uff09\u4f5c\u7528\u4e8e\u653e\u5728\u652f\u627f\u7269\u4e0a\u7684\u7269\u4f53\u7684\u529b\uff0c\u8fd9\u4e2a\u529b\u7684\u65b9\u5411\u662f\u5411\u4e0a\u7684\uff0c\u5373\u4e0e\u91cd\u529b\u7684\u65b9\u5411\u76f8\u53cd.\n\u6211\u4eec\u5c31\u628a\u8fd9\u4e2a\u529b\u53eb\u505a\u5f39\u529b.\n\n**\u652f\u627f\u7269\u5f2f\u66f2\u5f97\u8d8a\u5389\u5bb3\uff0c\u5f39\u529b\u7684\u6570\u503c\u5c31\u8d8a\u5927.**\n\u5f53\u5f39\u529b\u53d8\u5f97\u4e0e\u4f5c\u7528\u5728\u7269\u4f53\u4e0a\u7684\u91cd\u529b\u76f8\u7b49\u65f6\uff0c\u652f\u627f\u7269\u4e0e\u7269\u4f53\u5c31\u505c\u6b62\u4e86\u8fd0\u52a8."
    }
  ],
