  "exercises": [
    {
      "number": "1",
      "text": "\u4f60\u77e5\u9053\u54ea\u4e9b\u70ed\u73b0\u8c61\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u5728\u8f83\u9ad8\u548c\u8f83\u4f4e\u7684\u6e29\u5ea6\u4e0b\uff0c\u6269\u6563\u5404\u662f\u600e\u4e48\u8fdb\u884c\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u7269\u4f53\u7684\u6e29\u5ea6\u4e0e\u7269\u4f53\u5206\u5b50\u8fd0\u52a8\u7684\u901f\u5ea6\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\u51b7\u6c34\u548c\u70ed\u6c34\u5206\u5b50\u7684\u8fd0\u52a8\u6709\u4ec0\u4e48\u4e0d\u540c\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\u4e3a\u4ec0\u4e48\u7cd6\u548c\u76d0\u5728\u70ed\u6c34\u4e2d\u6bd4\u5728\u51b7\u6c34\u4e2d\u6eb6\u89e3\u5f97\u5feb\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\u662f\u5728\u70ed\u7684\u8fd8\u662f\u5728\u51c9\u7684\u76d0\u6c64\u91cc\u80fd\u8f83\u5feb\u5730\u628a\u9ec4\u74dc\u814c\u900f\uff1f\u4e3a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u7a7a\u6c14\u7684\u53d7\u70ed\u548c\u9047\u51b7\u3001\u51b0\u7684\u878d\u5316\u3001\u91d1\u5c5e\u7684\u7194\u89e3\u3001\u6c34\u7684\u6cb8\u817e\u7b49\u73b0\u8c61\uff0c\u53eb\u505a\u70ed\u73b0\u8c61."
    },
    {
      "block": 2,
      "text": "\u6211\u4eec\u7528\u201c\u51b7\u201d\u3001\u201c\u6e29\u201d\u3001\u201c\u70ed\u201d\u8fd9\u6837\u4e00\u4e9b\u8bcd\u6765\u8868\u793a\u7269\u4f53\u7684\u70ed\u72b6\u6001. \u6e29\u5ea6\u5c31\u662f\u4e00\u4e2a\u63cf\u5199\u7269\u4f53\u70ed\u72b6\u6001\u7684\u91cf."
    },
    {
      "block": 5,
      "text": "\u82e5\u5206\u522b\u5728\u4e24\u4e2a\u5bb9\u5668\u4e2d\u89c2\u5bdf\u6db2\u4f53\u7684\u6269\u6563\u73b0\u8c61\uff0c\u4e14\u5728\u5b9e\u9a8c\u5f00\u59cb\u65f6\u5c06\u4e00\u4e2a\u5bb9\u5668\u653e\u5728\u51b7\u5904\uff0c\u800c\u5c06\u53e6\u4e00\u4e2a\u653e\u5728\u6696\u5904\uff0c\u5219\u6211\u4eec\u5c06\u4f1a\u770b\u5230\uff0c\u6269\u6563\u5728\u6e29\u5ea6\u9ad8\u7684\u60c5\u51b5\u4e0b\u8fdb\u884c\u5f97\u5feb. \u8fd9\u5c31\u662f\u8bf4\uff0c\u5206\u5b50\u8fd0\u52a8\u7684\u901f\u5ea6\u4e0e\u7269\u4f53\u7684\u6e29\u5ea6\u4e4b\u95f4\u6709\u5173\u7cfb."
    },
    {
      "block": 6,
      "text": "\u7269\u4f53\u7684\u5206\u5b50\u8fd0\u52a8\u5f97\u8d8a\u5feb\uff0c\u7269\u4f53\u7684\u6e29\u5ea6\u5c31\u8d8a\u9ad8."
    },
    {
      "block": 7,
      "text": "\u70ed\u6c34\u548c\u51b7\u6c34\u90fd\u662f\u7531\u540c\u6837\u7684\u5206\u5b50\u7ec4\u6210\uff0c\u4e24\u8005\u7684\u533a\u522b\u5c31\u5728\u4e8e\u70ed\u6c34\u7684\u5206\u5b50\u8fd0\u52a8\u5f97\u6bd4\u51b7\u6c34\u7684\u5feb."
    }
  ],
