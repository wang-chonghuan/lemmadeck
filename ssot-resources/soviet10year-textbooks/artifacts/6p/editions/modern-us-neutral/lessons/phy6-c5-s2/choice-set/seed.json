  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u529f\u7387\u8868\u793a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u5df2\u77e5\u529f\u548c\u65f6\u95f4\uff0c\u600e\u6837\u8ba1\u7b97\u529f\u7387\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u529f\u7387\u7684\u5355\u4f4d\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u5728\u5de5\u7a0b\u6280\u672f\u4e2d\u5e38\u7528\u7684\u529f\u7387\u5355\u4f4d\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u5df2\u77e5\u53d1\u52a8\u673a\u7684\u529f\u7387\u548c\u5b83\u5de5\u4f5c\u7684\u65f6\u95f4\uff0c\u600e\u6837\u8ba1\u7b97\u6240\u505a\u7684\u529f\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "**\uff081\uff09\u6c34\u4ece22\u7c73\u9ad8\u7684\u575d\u9876\u843d\u4e0b\uff0c\u6bcf10\u5206\u949f\u843d\u4e0b500\u5428\u6c34\u3002**\n**\u843d\u4e0b\u7684\u6c34\u7684\u529f\u7387\u662f\u591a\u5c11\uff1f**",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "**\uff082\uff09\u884c\u8def\u7684\u4eba\u57282\u5c0f\u65f6\u5185\u8d70\u4e8610000\u6b65\uff0c\u6bcf\u8d70\u4e00\u6b65\u8981\u505a40\u7126\u8033\u7684\u529f\u3002**\n**\u6c42\u8fd9\u4e2a\u4eba\u7684\u529f\u7387\u3002**",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "**\uff083\uff09\u529f\u7387\u4e3a100\u5343\u74e6\u7684\u53d1\u52a8\u673a\u572820\u5206\u949f\u5185\u80fd\u505a\u591a\u5c11\u529f\uff1f**",
      "figure_ids": []
    },
    {
      "number": "g2-4",
      "text": "**\uff084\uff09\u4f20\u9001\u5e26\u57281\u5c0f\u65f6\u5185\u628a30\u7c73$^3$\u6c99\u5b50\u8f93\u9001\u52306\u7c73\u9ad8\u5904\u3002**\n**\u6c42\u5b8c\u6210\u8fd9\u9879\u5de5\u4f5c\u6240\u9700\u7684\u4f20\u9001\u5e26\u53d1\u52a8\u673a\u529f\u7387\u3002**\n**\u6c99\u5b50\u7684\u5bc6\u5ea6\u4e3a1500\u5343\u514b/\u7c73$^3$\u3002**",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "**\u6211\u4eec\u628a\u5728\u6570\u503c\u4e0a\u7b49\u4e8e\u5355\u4f4d\u65f6\u95f4\u5185\u6240\u505a\u7684\u529f\u7684\u7269\u7406\u91cf\uff0c\u53eb\u505a\u529f\u7387\u3002**"
    },
    {
      "block": 3,
      "text": "\u529f\u7387\u8868\u793a\u5355\u4f4d\u65f6\u95f4\u5185\u6240\u505a\u529f\u7684\u591a\u5c11\uff0c\u53ef\u4ee5\u628a\u5b83\u770b\u6210\u201c\u505a\u529f\u7684\u901f\u5ea6\u201d\u3002\n\u8fd9\u91cc\u8bf4\u7684\u662f\u505a\u529f\u7684\u5feb\u6162\uff0c\u4e0d\u662f\u7269\u4f53\u8fd0\u52a8\u7684\u901f\u5ea6\u3002"
    },
    {
      "block": 4,
      "text": "**\u8ba1\u7b97\u529f\u7387\u65f6\uff0c\u8981\u7528\u529f\u9664\u4ee5\u505a\u8fd9\u4e2a\u529f\u6240\u7528\u7684\u65f6\u95f4\uff1a**"
    },
    {
      "block": 5,
      "text": "**\u529f\u7387**$=\\frac{\\textbf{\u529f}}{\\textbf{\u65f6\u95f4}}$\uff0c\u6216$N=\\frac{A}{t}$\u3002"
    },
    {
      "block": 6,
      "text": "$N$\u662f\u529f\u7387\uff0c$A$\u662f\u529f\uff0c$t$\u662f\u505a\u529f\u7684\u65f6\u95f4\u3002"
    },
    {
      "block": 8,
      "text": "\u5982\u679c\u529f\u7684\u5355\u4f4d\u53d6\u7126\u8033\uff0c\u65f6\u95f4\u7684\u5355\u4f4d\u53d6\u79d2\uff0c\u529f\u7387\u7684\u5355\u4f4d\u5c31\u662f\u7126\u8033/\u79d2\u3002\n\u8fd9\u4e2a\u5355\u4f4d\u53eb\u505a**\u74e6\u7279**\uff0c\u7b80\u79f0\u74e6\u3002"
    },
    {
      "block": 9,
      "text": "**1 \u74e6\u7279**$=\\frac{\\textbf{1 \u7126\u8033}}{\\textbf{1 \u79d2}}$\uff0c**\u6216 1 \u74e6\u7279$=$1\u7126/\u79d2\u3002\n**"
    },
    {
      "block": 10,
      "text": "\u5728\u5de5\u7a0b\u6280\u672f\u4e2d\uff0c\u8fd8\u4f7f\u7528\u5343\u74e6\u3001\u5146\u74e6\u3001\u9a6c\u529b\u7b49\u8f83\u5927\u7684\u529f\u7387\u5355\u4f4d\u3002\n1 \u5343\u74e6$=1000$\u74e6\u7279\uff0c1 \u5146\u74e6$=1000000$\u74e6\u7279\uff0c\u6309\u672c\u6559\u6750\u91c7\u7528\u7684\u6362\u7b97\uff0c1 \u9a6c\u529b$=736$\u74e6\u7279\u3002"
    },
    {
      "block": 26,
      "text": "\u5728\u53d1\u52a8\u673a\u4ee5\u7ed9\u5b9a\u529f\u7387\u5de5\u4f5c\u65f6\uff0c\u77e5\u9053\u5b83\u7684\u529f\u7387\u548c\u5de5\u4f5c\u7684\u65f6\u95f4\uff0c\u5c31\u53ef\u4ee5\u8ba1\u7b97\u6240\u505a\u7684\u529f\u3002\n\u7531\u516c\u5f0f$N=\\frac{A}{t}$\u53ef\u5f97\uff1a"
    },
    {
      "block": 27,
      "text": "$A=Nt$\u3002"
    }
  ],
