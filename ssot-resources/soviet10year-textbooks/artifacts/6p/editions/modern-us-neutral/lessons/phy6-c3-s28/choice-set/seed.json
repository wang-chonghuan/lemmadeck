  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u4e3e\u51fa\u4e00\u4e2a\u514b\u670d\u5206\u5b50\u5f15\u529b\u7684\u4f8b\u5b50\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u4e3a\u4ec0\u4e48\u7ec4\u6210\u7269\u4f53\u7684\u5206\u5b50\u4e0d\u80fd\u5f7c\u6b64\u201c\u7d27\u7d27\u5730\u201d\u9760\u5728\u4e00\u8d77\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u5f53\u5206\u5b50\u95f4\u7684\u8ddd\u79bb\u9010\u6e10\u51cf\u5c0f\u65f6\uff0c\u5206\u5b50\u95f4\u7684\u5f15\u529b\u548c\u65a5\u529b\u662f\u600e\u6837\u53d8\u5316\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u4e3a\u4ec0\u4e48\u62c9\u4f38\u94a2\u7d22\u7684\u529b\u505c\u6b62\u4f5c\u7528\u540e\uff0c\u94a2\u7d22\u5c31\u6536\u7f29\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u800c\u6211\u4eec\u5c06\u7269\u4f53\u538b\u7f29\u65f6\uff0c\u5c31\u8981\u514b\u670d\u5206\u5b50\u95f4\u7684\u65a5\u529b\u3002\n\u5f53\u5206\u5b50\u95f4\u7684\u8ddd\u79bb\u6bd4\u5f15\u529b\u8d77\u4f5c\u7528\u7684\u8ddd\u79bb\u8fd8\u8981\u5c0f\u65f6\uff0c\u65a5\u529b\u5c31\u53d8\u5f97\u5f88\u5927\u4e86\u3002"
    },
    {
      "block": 6,
      "text": "\u8bbe\u60f3\u4e24\u4e2a\u5206\u5b50\u4e4b\u95f4\u7684\u8ddd\u79bb\u662f\u5206\u5b50\u672c\u8eab\u5927\u5c0f\u7684\u51e0\u500d\uff08\u56fe 82\u7684\u4e0a\u56fe\uff09\u3002\n\u76f8\u9694\u8fd9\u6837\u7684\u8ddd\u79bb\uff0c\u4e24\u4e2a\u5206\u5b50\u95f4\u7684\u5f15\u529b\u5f88\u5c0f\uff0c\u800c\u65a5\u529b\u6bd4\u5f15\u529b\u66f4\u5c0f\u3002\n\u5f53\u5206\u5b50\u95f4\u7684\u8ddd\u79bb\u51cf\u5c0f\u65f6\uff0c\u4e0d\u7ba1\u662f\u5f15\u529b\u8fd8\u662f\u65a5\u529b\u90fd\u589e\u5927\uff0c\u4e0d\u8fc7\u65a5\u529b\u589e\u52a0\u5f97\u5feb\u3002\n\n\u82e5\u5206\u5b50\u95f4\u7684\u8ddd\u79bb\u8fdb\u4e00\u6b65\u51cf\u5c0f\uff0c\u65a5\u529b\u53ef\u4ee5\u8fbe\u5230\u5728\u6570\u503c\u4e0a\u548c\u5f15\u529b\u76f8\u7b49\uff08\u56fe 82 \u7684\u4e2d\u56fe\uff09\u3002\n\u5982\u679c\u5206\u5b50\u95f4\u7684\u8ddd\u79bb\u518d\u7ee7\u7eed\u51cf\u5c0f\uff0c\u5219\u8fd9\u4e24\u79cd\u529b\u4e5f\u7ee7\u7eed\u589e\u52a0\u3002\n\u4e0d\u8fc7\u56e0\u65a5\u529b\u589e\u52a0\u5f97\u5feb\uff0c\u8fd9\u65f6\u5b83\u7684\u6570\u503c\u5c31\u8d85\u8fc7\u4e86\u5f15\u529b\u7684\u6570\u503c\uff0c\u4e8e\u662f\u5206\u5b50\u95f4\u5c31\u4e92\u76f8\u63a8\u65a5\uff08\u56fe 82 \u7684\u4e0b\u56fe\uff09\u3002"
    },
    {
      "block": 7,
      "text": "\u4f8b\u5982\uff0c\u5f53\u4e00\u6839\u94a2\u7d22\u53d7\u5230\u62c9\u4f38\u65f6\uff0c\u5176\u5206\u5b50\u95f4\u7684\u8ddd\u79bb\u5c31\u589e\u5927\u3002\n\u5206\u5b50\u95f4\u7684\u5f15\u529b\u80dc\u8fc7\u65a5\u529b\uff0c\u8fd9\u65f6\u82e5\u94a2\u7d22\u6240\u53d7\u7684\u62c9\u4f38\u4f5c\u7528\u505c\u6b62\u4e86\uff0c\u5219\u5b83\u5c31\u4f1a\u91cd\u65b0\u7f29\u77ed\u3002\n\u82e5\u5c06\u8fd9\u6839\u94a2\u7d22\u538b\u7f29\uff0c\u5176\u5206\u5b50\u5c31\u5f7c\u6b64\u9760\u8fd1\uff0c\u65a5\u529b\u8d85\u8fc7\u4e86\u5f15\u529b\u3002\n\n\u8fd9\u65f6\u82e5\u94a2\u7d22\u6240\u53d7\u7684\u538b\u7f29\u4f5c\u7528\u505c\u6b62\u4e86\uff0c\u5219\u5b83\u5c31\u4f1a\u8212\u5c55\u5f00\u3002\n\u7531\u6b64\u53ef\u89c1\uff0c\u94a2\u7d22\u4e2d\u5f39\u529b\u4ea7\u751f\u7684\u539f\u56e0\u5c31\u662f\u94a2\u7d22\u7684\u5206\u5b50\u95f4\u7684\u76f8\u4e92\u4f5c\u7528\u529b\u3002"
    }
  ],
