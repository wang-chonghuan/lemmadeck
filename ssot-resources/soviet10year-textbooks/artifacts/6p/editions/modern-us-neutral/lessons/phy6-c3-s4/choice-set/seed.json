  "exercises": [
    {
      "number": "1",
      "text": "\u5f53\u6211\u4eec\u8c08\u5230\u706b\u8f66\u6216\u6c7d\u8f66\u7684\u8fd0\u52a8\u901f\u5ea6\u65f6\uff0c\u6211\u4eec\u6240\u6307\u7684\u662f\u4ec0\u4e48\u901f\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u600e\u6837\u6c42\u51fa\u53d8\u901f\u8fd0\u52a8\u7684\u5e73\u5747\u901f\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\u5728\u8fd9\u9053\u7ec3\u4e60\u7684\u6bd4\u8d5b\u60c5\u5883\u4e2d\uff0c\u6ed1\u51b0\u8fd0\u52a8\u5458 Alex \u5728 1963 \u5e74\u6ed1\u5b8c 500 \u7c73\u901f\u6ed1\u8d5b\u7a0b\uff0c\u7528\u65f6 39.5 \u79d2\u3002\u6c42 Alex \u6ed1\u884c\u7684\u5e73\u5747\u901f\u5ea6\u3002\n\u8fd0\u52a8\u5458 Morgan \u5728 1975 \u5e74\u7684\u4e00\u6b21\u6bd4\u8d5b\u4e2d\u6ed1\u5b8c\u540c\u6837\u7684\u8d5b\u7a0b\uff0c\u7528\u65f6 37.0 \u79d2\u3002\u6bd4\u8f83 Morgan \u4e0e Alex \u6ed1\u884c\u7684\u5e73\u5747\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "g2-2",
      "text": "\u6ed1\u96ea\u4eba\u4ece\u5c71\u4e0a\u6ed1\u4e0b\uff0c\u5728 6 \u79d2\u949f\u5185\u901a\u8fc7\u4e86 50 \u7c73\u7684\u8ddd\u79bb. \u6ed1\u4e0b\u5c71\u540e\u4ed6\u7ee7\u7eed\u8fd0\u52a8\u76f4\u5230\u5b8c\u5168\u505c\u6b62\uff0c\u53c8\u524d\u8fdb\u4e86 30 \u7c73\uff0c\u7528\u4e86 15 \u79d2\u949f. \u8bd5\u6c42\u6ed1\u96ea\u4eba\u6cbf\u5c71\u5761\u8fd0\u52a8\u65f6\u7684\u5e73\u5747\u901f\u5ea6\u53ca\u5728\u6574\u4e2a\u8fd0\u52a8\u65f6\u95f4\u5185\u7684\u5e73\u5747\u901f\u5ea6.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u5f53\u8c08\u5230\u53d8\u901f\u8fd0\u52a8\u7684\u901f\u5ea6\u65f6\uff0c\u6240\u6307\u7684\u662f\u5728\u8fd0\u52a8\u7684\u67d0\u4e00\u6bb5\u7ed9\u5b9a\u7684\u8def\u7a0b\u4e0a\u6216\u5728\u8fd0\u52a8\u4e2d\u7684\u67d0\u4e00\u7ed9\u5b9a\u7684\u65f6\u95f4\u95f4\u9694\u5185\u7684\u5e73\u5747\u901f\u5ea6. \u8981\u8ba1\u7b97\u5e73\u5747\u901f\u5ea6\uff0c\u5c31\u7528\u6240\u901a\u8fc7\u7684\u8def\u7a0b\u9664\u4ee5\u8fd0\u52a8\u7684\u65f6\u95f4\uff0c\u4e5f\u5c31\u662f\u8bf4\u8c61\u8ba1\u7b97\u5300\u901f\u8fd0\u52a8\u7684\u901f\u5ea6\u90a3\u6837\u6765\u5904\u7406."
    },
    {
      "block": 7,
      "text": "$\\text{\u5e73\u5747\u901f\u5ea6}=\\frac{\\text{\u8def\u7a0b}}{\\text{\u65f6\u95f4}}$\uff0c\n\u6216 $v_{\\text{\u5e73\u5747}}=\\frac{s}{t}$."
    }
  ],
