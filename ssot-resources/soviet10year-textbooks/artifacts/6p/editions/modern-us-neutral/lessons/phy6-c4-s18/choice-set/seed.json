{
  "schema": "s10y-choice-seed-v1",
  "source": {
    "book": "6p",
    "lesson": "phy6-c4-s18",
    "concept_figure_ids": []
  },
  "exercises": [
    {
      "number": "1",
      "text": "\uff081\uff09\u600e\u6837\u901a\u8fc7\u5b9e\u9a8c\u9a8c\u8bc1\uff1a\u9759\u6b62\u6f02\u6d6e\u7684\u7269\u4f53\u6392\u5f00\u7684\u6db2\u4f53\u91cd\u91cf\u7b49\u4e8e\u6d6e\u4f53\u5728\u7a7a\u6c14\u4e2d\u79f0\u5f97\u7684\u91cd\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\uff082\uff09\u9759\u6b62\u6f02\u6d6e\u5728\u6db2\u4f53\u8868\u9762\u7684\u7269\u4f53\uff0c\u6240\u53d7\u7684\u6d6e\u529b\u7b49\u4e8e\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\uff083\uff09\u5728\u672c\u8282\u7684\u57fa\u672c\u6a21\u578b\u4e2d\uff0c\u653e\u5165\u6db2\u4f53\u7684\u7269\u4f53\u5728\u4ec0\u4e48\u6761\u4ef6\u4e0b\u4f1a\u4e0a\u6d6e\uff1f\u5728\u4ec0\u4e48\u6761\u4ef6\u4e0b\u4f1a\u6f02\u6d6e\u5728\u6db2\u9762\uff1f\u5728\u4ec0\u4e48\u6761\u4ef6\u4e0b\u4f1a\u4e0b\u6c89\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\uff084\uff09\u6bd4\u8f83\u5728\u540c\u4e00\u79cd\u6db2\u4f53\u4e2d\u9759\u6b62\u6f02\u6d6e\u3001\u5f62\u72b6\u548c\u59ff\u6001\u76f8\u540c\u7684\u7269\u4f53\uff0c\u6d78\u5165\u6db2\u4f53\u7684\u6df1\u5ea6\u4e0e\u7269\u4f53\u5bc6\u5ea6\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-1",
      "text": "\uff081\uff09\u628a\u4e00\u4e2a\u88c5\u6ee1\u6c34\u3001\u5e26\u6ea2\u6db2\u7ba1\u7684\u5bb9\u5668\u653e\u5728\u5929\u5e73\u4e0a\uff0c\u6dfb\u52a0\u781d\u7801\u4f7f\u5929\u5e73\u5e73\u8861\uff08\u56fe168\uff0cb\uff09\u3002\n\u7136\u540e\u628a\u4e00\u4e2a\u6728\u5757\u653e\u5165\u5bb9\u5668\uff0c\u5929\u5e73\u6682\u65f6\u5931\u53bb\u5e73\u8861\uff08\u56fe168\uff0cb\uff09\u3002\n\u5f53\u6f02\u6d6e\u6728\u5757\u6392\u5f00\u7684\u6c34\u5168\u90e8\u6d41\u51fa\u540e\uff0c\u5929\u5e73\u53c8\u6062\u590d\u5e73\u8861\uff08\u56fe168\uff0cc\uff09\u3002\n\u89e3\u91ca\u8fd9\u4e00\u73b0\u8c61\u3002",
      "figure_ids": [
        "fig-168"
      ]
    },
    {
      "number": "g2-2",
      "text": "\uff082\uff09\u4e3a\u4ec0\u4e48\u5f88\u91cd\u7684\u5927\u8239\u80fd\u6d6e\u5728\u6c34\u9762\u4e0a\uff0c\u800c\u843d\u5165\u6c34\u4e2d\u7684\u5c0f\u9489\u5b50\u5374\u4f1a\u6c89\u5e95\uff1f",
      "figure_ids": []
    },
    {
      "number": "g2-3",
      "text": "\uff083\uff09\u56fe169\u8868\u793a\u540c\u4e00\u4e2a\u7269\u4f53\u5206\u522b\u6d6e\u5728\u4e24\u79cd\u4e0d\u540c\u6db2\u4f53\u4e2d\u7684\u60c5\u51b5\u3002\n\u54ea\u4e00\u79cd\u6db2\u4f53\u7684\u5bc6\u5ea6\u8f83\u5927\uff1f\u4e3a\u4ec0\u4e48\uff1f\n\u5728\u8fd9\u4e24\u79cd\u60c5\u51b5\u4e0b\uff0c\u4f60\u80fd\u5bf9\u7269\u4f53\u6240\u53d7\u7684\u91cd\u529b\u548c\u963f\u57fa\u7c73\u5fb7\u529b\u4f5c\u51fa\u4ec0\u4e48\u5224\u65ad\uff1f",
      "figure_ids": [
        "fig-169"
      ]
    },
    {
      "number": "g2-4",
      "text": "\uff084\uff09\u628a\u5e26\u6709\u94c5\u5760\u7684\u6728\u5236\u6d6e\u5b50\u5148\u653e\u5165\u6c34\u4e2d\uff0c\u518d\u653e\u5165\u7164\u6cb9\u4e2d\uff1b\u4e24\u79cd\u60c5\u51b5\u4e0b\u6d6e\u5b50\u90fd\u6ca1\u6709\u4e0b\u6c89\u3002\n\u6d6e\u5b50\u5728\u54ea\u4e00\u79cd\u6db2\u4f53\u4e2d\u6d78\u5165\u5f97\u66f4\u6df1\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\uff085\uff09\u9e21\u86cb\u5728\u6de1\u6c34\u4e2d\u4e0b\u6c89\uff0c\u5728\u76d0\u6c34\u4e2d\u6d6e\u5728\u4e0a\u9762\u3002\u4e3a\u4ec0\u4e48\uff1f\n\u4eb2\u81ea\u52a8\u624b\u505a\u5b9e\u9a8c\uff0c\u89c2\u5bdf\u8fd9\u4e00\u73b0\u8c61\u3002",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "\uff086\uff09\u5206\u522b\u753b\u51fa\u4ee5\u4e0b\u7269\u4f53\u6240\u53d7\u529b\u7684\u793a\u610f\u56fe\uff1a\u5728\u6c34\u4e2d\u4efb\u610f\u6df1\u5ea6\u5904\u4fdd\u6301\u5e73\u8861\u7684\u7269\u4f53\u3001\u6d6e\u5728\u6c34\u9762\u4e0a\u7684\u7269\u4f53\uff0c\u4ee5\u53ca\u4e0b\u6c89\u7684\u7269\u4f53\u3002",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "\uff087\uff09\u5229\u7528\u5bc6\u5ea6\u8868\u5224\u65ad\uff1a\u54ea\u4e9b\u91d1\u5c5e\u4f1a\u6d6e\u5728\u6c34\u94f6\u9762\u4e0a\uff1f\u54ea\u4e9b\u4f1a\u4e0b\u6c89\uff1f",
      "figure_ids": []
    },
    {
      "number": "8",
      "text": "\uff088\uff09\u51b0\u5757\u4f1a\u4e0d\u4f1a\u6d6e\u5728\u6c7d\u6cb9\u3001\u7164\u6cb9\u548c\u7518\u6cb9\u4e2d\uff1f",
      "figure_ids": []
    },
    {
      "number": "9",
      "text": "\uff089\uff09\u6c34\u3001\u7164\u6cb9\u548c\u6c34\u94f6\u8fd9\u4e09\u79cd\u5f7c\u6b64\u4e0d\u76f8\u6df7\u7684\u6db2\u4f53\u653e\u5728\u540c\u4e00\u5bb9\u5668\u4e2d\uff0c\u4f1a\u600e\u6837\u5206\u5e03\uff1f\n\u753b\u51fa\u793a\u610f\u56fe\uff0c\u5e76\u89e3\u91ca\u3002",
      "figure_ids": []
    },
    {
      "number": "10",
      "text": "\uff0810\uff09\u5b9e\u5fc3\u7684\u8f6f\u6728\u7403\u3001\u77f3\u8721\u7403\u548c\u94a2\u7403\u5206\u522b\u653e\u5165\u88c5\u6709\u6c34\u3001\u7164\u6cb9\u548c\u6c34\u94f6\u7684\u5bb9\u5668\uff0c\u5b83\u4eec\u5404\u4f1a\u5904\u4e8e\u4ec0\u4e48\u4f4d\u7f6e\uff1f\n\u8bf4\u660e\u5224\u65ad\u4f9d\u636e\uff0c\u5e76\u753b\u56fe\u3002",
      "figure_ids": []
    },
    {
      "number": "q1",
      "text": "\u672c\u6559\u6750\u8bb0\u8ff0\uff0c\u6cd5\u56fd\u5b66\u8005\u7b1b\u5361\u513f\uff081596\u20141650\uff09\u8bbe\u8ba1\u4e86\u4ee5\u4e0b\u4eea\u5668\uff0c\u7528\u6765\u6f14\u793a\u6d41\u4f53\u9759\u529b\u5b66\u73b0\u8c61\u3002\n\u5728\u7ec6\u957f\u7684\u73bb\u7483\u5bb9\u5668\uff08\u7f50\uff09\u4e2d\u88c5\u6c34\uff0c\u4f7f\u9876\u90e8\u53ea\u5269\u4e0b\u4f53\u79ef\u5f88\u5c0f\u7684\u4e00\u90e8\u5206\u7a7a\u6c14\u3002\n\u653e\u5165\u4e00\u4e2a\u7a7a\u5fc3\u73bb\u7483\u4eba\u50cf\uff1b\u4eba\u50cf\u5185\u90e8\u4e5f\u88c5\u5165\u4e00\u90e8\u5206\u6c34\u5e76\u4fdd\u7559\u4e00\u90e8\u5206\u7a7a\u6c14\uff0c\u4f7f\u5b83\u9759\u6b62\u65f6\u80fd\u6d6e\u5728\u6c34\u9762\u5e76\u7a0d\u5fae\u9732\u51fa\u6c34\u9762\u3002\n\u7528\u4e00\u5757\u8584\u76ae\u628a\u5bb9\u5668\u53e3\u8499\u7d27\u3002\u624b\u538b\u8584\u76ae\uff0c\u53ef\u4ee5\u6539\u53d8\u4eba\u50cf\u7684\u72b6\u6001\uff0c\u4f7f\u5b83\u505c\u7559\u5728\u6c34\u4e2d\u4efb\u610f\u6df1\u5ea6\u3001\u6d6e\u5728\u6c34\u9762\uff0c\u6216\u6c89\u5230\u6c34\u5e95\u3002\n\u8bf7\u5236\u4f5c\u8fd9\u6837\u4e00\u4ef6\u4eea\u5668\uff0c\u5e76\u7528\u5b83\u505a\u5b9e\u9a8c\u3002\n\u53ef\u4ee5\u7528\u5c0f\u6d6e\u5b50\u4ee3\u66ff\u73bb\u7483\u4eba\u50cf\uff0c\u7528\u6a61\u76ae\u819c\u8499\u4f4f\u5bb9\u5668\u53e3\uff08\u56fe170\uff09\u3002\n\u672c\u6559\u6750\u8fd8\u63cf\u8ff0\u4e86\u56fe171\u7684\u53e6\u4e00\u79cd\u5236\u4f5c\u65b9\u6cd5\uff1a\u901a\u8fc7\u6a61\u76ae\u7ba1\u7528\u5634\u5411\u74f6\u4e2d\u5439\u5165\u7a7a\u6c14\u3002\n\u4ee5\u4e0a\u4fdd\u7559\u7684\u662f\u672c\u6559\u6750\u7684\u5386\u53f2\u88c5\u7f6e\u548c\u64cd\u4f5c\u53d9\u8ff0\uff0c\u4e0d\u6784\u6210\u5b9e\u9a8c\u5b89\u5168\u6307\u5bfc\u3002\n\u8bf4\u660e\u4eea\u5668\u7684\u5de5\u4f5c\u539f\u7406\u3002\n\u7528\u8fd9\u4e2a\u4eea\u5668\u6f14\u793a\u5e15\u65af\u5361\u5b9a\u5f8b\u3001\u963f\u57fa\u7c73\u5fb7\u529b\u548c\u7269\u4f53\u6d6e\u6c89\u89c4\u5f8b\u3002",
      "figure_ids": [
        "fig-170",
        "fig-171"
      ]
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6d78\u5728\u6db2\u4f53\u4e2d\u7684\u7269\u4f53\uff0c\u53d7\u5230\u7ad6\u76f4\u5411\u4e0b\u7684\u91cd\u529b\u548c\u7ad6\u76f4\u5411\u4e0a\u7684\u963f\u57fa\u7c73\u5fb7\u529b\uff08\u6d6e\u529b\uff09\u3002\n\u5728\u672c\u8282\u53ea\u8003\u8651\u8fd9\u4e24\u4e2a\u529b\u7684\u57fa\u672c\u6a21\u578b\u4e2d\uff0c\u82e5\u7269\u4f53\u8d77\u521d\u9759\u6b62\uff0c\u5c31\u4f1a\u5f00\u59cb\u5411\u8f83\u5927\u7684\u529b\u6240\u6307\u7684\u65b9\u5411\u8fd0\u52a8\uff1b\n\u4e24\u529b\u76f8\u7b49\u65f6\u53ef\u4ee5\u4fdd\u6301\u9759\u6b62\u3002\n\n\u6709\u4ee5\u4e0b\u4e09\u79cd\u60c5\u51b5\uff1a"
    },
    {
      "block": 1,
      "text": "1\uff09**\u91cd\u529b\u5927\u4e8e\u963f\u57fa\u7c73\u5fb7\u529b\u65f6\uff0c\u7269\u4f53\u4e0b\u6c89**\u3002\n2\uff09**\u91cd\u529b\u7b49\u4e8e\u963f\u57fa\u7c73\u5fb7\u529b\u65f6\uff0c\u7269\u4f53\u53ef\u4ee5\u5728\u5747\u5300\u6db2\u4f53\u5185\u90e8\u7684\u4efb\u610f\u6df1\u5ea6\u5904\u4fdd\u6301\u5e73\u8861**\u3002\n3\uff09**\u91cd\u529b\u5c0f\u4e8e\u963f\u57fa\u7c73\u5fb7\u529b\u65f6\uff0c\u7269\u4f53\u4e0a\u6d6e**\u3002"
    },
    {
      "block": 3,
      "text": "\u7269\u4f53\u4e0a\u6d6e\u5230\u6db2\u4f53\u8868\u9762\u540e\uff0c\u968f\u7740\u5b83\u7ee7\u7eed\u4e0a\u6d6e\uff0c\u963f\u57fa\u7c73\u5fb7\u529b\u9010\u6e10\u51cf\u5c0f\u3002\n\u8fd9\u662f\u56e0\u4e3a\u7269\u4f53\u6d78\u5165\u6db2\u4f53\u7684\u4f53\u79ef\u9010\u6e10\u51cf\u5c0f\uff0c\u800c\u963f\u57fa\u7c73\u5fb7\u529b\u7b49\u4e8e\u4e0e\u6d78\u5165\u90e8\u5206\u540c\u4f53\u79ef\u7684\u6db2\u4f53\u6240\u53d7\u7684\u91cd\u529b\u3002"
    },
    {
      "block": 4,
      "text": "\u7269\u4f53\u7ee7\u7eed\u4e0a\u6d6e\uff0c\u6700\u7ec8\u53ef\u4ee5\u5728\u6db2\u9762\u4e0a\u9759\u6b62\u6f02\u6d6e\uff0c\u4ecd\u6709\u4e00\u90e8\u5206\u6d78\u5728\u6db2\u4f53\u4e2d\u3002\n\u8fd9\u65f6\u963f\u57fa\u7c73\u5fb7\u529b\u4e0e\u7269\u4f53\u6240\u53d7\u7684\u91cd\u529b\u76f8\u7b49\u3002"
    },
    {
      "block": 11,
      "text": "\u7528\u80fd\u5728\u6c34\u3001\u9152\u7cbe\u3001\u98df\u76d0\u6eb6\u6db2\u7b49\u4e0d\u540c\u6db2\u4f53\u4e2d\u6f02\u6d6e\u7684\u5176\u4ed6\u7269\u4f53\u91cd\u590d\u5b9e\u9a8c\uff0c\u7ed3\u679c\u540c\u6837\u6ee1\u8db3\uff1a\n**\u5728\u5ffd\u7565\u7a7a\u6c14\u6d6e\u529b\u7684\u6a21\u578b\u4e0b\uff0c\u9759\u6b62\u6f02\u6d6e\u7269\u4f53\u5728\u7a7a\u6c14\u4e2d\u7684\u91cd\u91cf\u7b49\u4e8e\u5b83\u6392\u5f00\u7684\u6db2\u4f53\u7684\u91cd\u91cf**\u3002"
    },
    {
      "block": 12,
      "text": "\u5bf9\u4e8e\u5747\u5300\u3001\u5b9e\u5fc3\u7684\u56fa\u4f53\uff0c\u5728\u672c\u8282\u7684\u57fa\u672c\u6a21\u578b\u4e2d\uff1a\n**\u7269\u4f53\u5bc6\u5ea6\u5927\u4e8e\u6db2\u4f53\u5bc6\u5ea6\u65f6\u4e0b\u6c89**\uff1b\n**\u5bc6\u5ea6\u5c0f\u4e8e\u6db2\u4f53\u5bc6\u5ea6\u65f6\u4e0a\u6d6e**\uff1b\n\n**\u5bc6\u5ea6\u76f8\u7b49\u65f6\u53ef\u5728\u6db2\u4f53\u5185\u90e8\u4fdd\u6301\u5e73\u8861**\u3002\n\u4f8b\u5982\uff0c\u94c1\u5757\u5728\u6c34\u4e2d\u4e0b\u6c89\uff0c\u5728\u6c34\u94f6\u4e2d\u4e0a\u6d6e\u3002"
    }
  ],
