  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/6p/figures/fig-190.png",
      "sha256": "7eca576829432b4c9f4d602ab4e65c6826f63302e13a4c024abb131a22a72906"
