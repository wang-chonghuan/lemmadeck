    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/6p/figures/fig-107.png",
      "sha256": "a68bc9ccec96a4a489e94d4f92484010eb8468bafb9000d3ab34c39239ce5d0a"
