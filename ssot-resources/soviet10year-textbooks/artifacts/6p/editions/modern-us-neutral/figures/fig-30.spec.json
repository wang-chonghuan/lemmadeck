    "image": {"path": "ssot-resources/soviet10year-textbooks/artifacts/6p/figures/fig-30.png", "sha256": "45287e90545bef5c95263b719e4e0a5f9be187423d349a9a71d75e2589d80bb7"},
    "authoritativeText": [
      {"lesson": "phy6-c3-s2", "text": "做变速运动时，物体在相等的时间间隔内通过的路程不等."},
      {"lesson": "phy6-c3-s2", "text": "也可以通过实验来观察小车的变速运动（图 30）. 根据相隔同样时间滴落下来的液滴所留下的滴痕可以看出，小车的运动是变速的. 因为液滴每次滴落所隔的时间相等，而滴痕之间的距离却不相等."}
    ],
    "inventory": [
      {"id": "source-cart-bottle", "description": "One capped, shouldered upright bottle, partly filled, on a thin rectangular cart with two visible wheels resting on a raised running surface and a bottom outlet. No apparatus label, number or unit is printed.", "objects": ["cart", "wheel-left", "wheel-right", "running-surface", "bottle", "liquid", "liquid-level", "bottle-cap", "outlet", "falling-drop"], "assertions": ["outlet-to-current-trace"]},
      {"id": "source-traces", "description": "Five deposited short dark traces to the left of the outlet, plus a current trace below it, on one paper strip. The strip's far-left vertical boundary is not counted as a droplet. Deposits are crowded on the left and gaps generally widen toward the bottle/right; the first small gaps look similar, not a source guarantee of strict increase at every step. No exact lengths are given.", "objects": ["d0", "d1", "d2", "d3", "d4", "d5", "paper"], "assertions": ["trace-gap-1", "trace-gap-2", "trace-gap-3", "trace-gap-4", "trace-gap-5"], "requires": ["pointRelationships"]},
      {"id": "source-motion", "description": "One horizontal motion arrow points right above and right of the bottle.", "objects": ["motion"], "assertions": ["motion-right"]},
      {"id": "source-traction", "description": "Cart right-end attachment connects via horizontal rope to a right-hand pulley outside the table edge; rope turns down to a hook and one rectangular hanging weight. Diagonal support bracket, thick table top, apron and right leg are visible.", "objects": ["cart-attachment", "rope-horizontal", "pulley", "rope-turn", "rope-vertical", "hook-upper", "hook-lower", "weight-eye", "hanging-weight", "bracket-top", "bracket-bottom", "table", "table-apron", "table-leg"], "assertions": ["cart-rope", "rope-hanger", "hook-connection", "weight-connection"]},
      {"id": "modern-regularization", "description": "Modern addition/regularization: use a flat side view and isolate traces from wheels/borders. Choose increasing unlabelled schematic gaps 15, 22, 32, 42, 54 drawing units to make the source's overall widening trend readable at 300px. These values are modern layout choices, not recovered source distances or a quantitative acceleration claim.", "objects": ["d0", "d1", "d2", "d3", "d4", "d5", "paper"], "assertions": ["trace-gap-1", "trace-gap-2", "trace-gap-3", "trace-gap-4", "trace-gap-5"]}
    ]
