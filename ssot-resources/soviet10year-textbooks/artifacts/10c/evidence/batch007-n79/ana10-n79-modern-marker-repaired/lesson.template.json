      "label": "图 6",
      "printed_page": 14,
      "source_refs": [
        "p0020#3"
      ],
      "source_text": "",
      "changes": [],
      "numeric_changes": [],
      "historical_entities": []
    },
    {
      "kind": "cap",
      "text": "图 5",
