  "exercises": [
    {
      "number": "52",
      "text": "52. \u5199\u51fa\u632f\u5e45\u7b49\u4e8e3.5\u3001\u5468\u671f\u7b49\u4e8e $\\frac{3}{2}\\pi$\u3001\u521d\u76f8\u7b49\u4e8e $\\frac{\\pi}{3}$ \u7684\u8c10\u632f\u52a8\u516c\u5f0f\u3002\n\u8fd9\u4e2a\u632f\u52a8\u7684\u89d2\u9891\u7387\u7b49\u4e8e\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "53",
      "text": "53. \u70b9\u7684\u8fd0\u52a8\u65b9\u7a0b\u662f\n$y(t)=0.8\\sin\\left(\\frac{1}{3}t+\\pi\\right)$\u3002\n\u632f\u52a8\u7684\u5468\u671f\u3001\u632f\u5e45\u3001\u521d\u76f8\u548c\u89d2\u9891\u7387\u7b49\u4e8e\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "54",
      "text": "54. \u628a\u65b9\u7a0b\n$y=2\\sin\\frac{\\pi}{6}\\cos x+2\\sin x\\cos\\frac{\\pi}{6}$\n\u7684\u53f3\u8fb9\u53d8\u6362\u6210 $A\\cos(\\omega x+\\varphi)$ \u7684\u5f62\u5f0f\u3002\n\u632f\u52a8\u7684\u5468\u671f\u3001\u632f\u5e45\u3001\u521d\u76f8\u548c\u89d2\u9891\u7387\u7b49\u4e8e\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "55",
      "text": "55. \u628a\u65b9\u7a0b\n$y=3\\frac{1}{2}\\cos2x+3\\frac{\\sqrt{3}}{2}\\sin2x$\n\u7684\u53f3\u8fb9\u53d8\u5f62\uff0c\u4f7f\u8fd9\u4e2a\u65b9\u7a0b\u8868\u793a\u8c10\u632f\u52a8\u3002\n\u6307\u51fa\u5b83\u7684\u53c2\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "56",
      "text": "56. \u6c42\u5fae\u5206\u65b9\u7a0b $y''=-25y$ \u7684\u4efb\u610f\u4e00\u4e2a\u4e0e $y\\equiv0$ \u4e0d\u540c\u7684\u89e3\u3002",
      "figure_ids": []
    },
    {
      "number": "57",
      "text": "57. \u68c0\u9a8c\u51fd\u6570 $x=3\\cos(2t+\\pi)$ \u662f\u5426\u4e3a\u5fae\u5206\u65b9\u7a0b $x''=-4x$ \u7684\u89e3\u3002",
      "figure_ids": []
    },
    {
      "number": "58",
      "text": "58. \u8bc1\u660e\u51fd\u6570 $x=2\\cos4t$ \u662f\u5fae\u5206\u65b9\u7a0b $x''=-16x$ \u7684\u89e3\u3002",
      "figure_ids": []
    },
    {
      "number": "59",
      "text": "59. \u51fd\u6570 $x=7\\cos(3t+5)$ \u662f\u5fae\u5206\u65b9\u7a0b $x''=-9x$ \u7684\u89e3\u5417\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 13,
      "text": "$f(t)=A\\cos(\\omega t+\\varphi)\\qquad(2)$\n\u662f\u6240\u9700\u51fd\u6570\u7684\u5f62\u5f0f\uff0c\u5176\u4e2d $A$\u3001$\\omega$ \u548c $\\varphi$ \u90fd\u662f\u5e38\u6570\u3002\n\u7531\uff082\uff09\u6c42\u5bfc\uff0c\u5f97\u5230\uff1a\n$f'(t)=-A\\omega\\sin(\\omega t+\\varphi)\\qquad(3)$\uff0c\n$f''(t)=-A\\omega^2\\cos(\\omega t+\\varphi)\\qquad(4)$\u3002"
    },
    {
      "block": 14,
      "text": "\u7531\uff082\uff09\u548c\uff084\uff09\u5f97\u5230\uff1a\n$f''(t)=-\\omega^2f(t)\\qquad(5)$\uff0c"
    },
    {
      "block": 15,
      "text": "\u5373\u65b9\u7a0b\uff081\uff09\u7684\u5f62\u5f0f\uff0c\u5176\u4e2d\n$c=\\omega^2\\qquad(6)$\u3002"
    },
    {
      "block": 16,
      "text": "\u53ef\u89c1\uff0c\u6309\u7167\u89c4\u5f8b\uff082\uff09\u968f\u65f6\u95f4\u53d8\u5316\u7684\u7269\u7406\u91cf\u4f5c\u8c10\u632f\u52a8\u3002\n\u53cd\u8fc7\u6765\uff0c\u5728\u5b9e\u6570\u96c6 $R$ \u4e0a\u5b9a\u4e49\u7684\u4efb\u4f55\u6ee1\u8db3\u65b9\u7a0b\uff081\uff09\u7684\u51fd\u6570 $f$\uff0c\u90fd\u53ef\u4ee5\u5199\u6210\uff082\uff09\u7684\u5f62\u5f0f\uff0c\u5176\u4e2d\n$\\omega=\\sqrt{c},\\ A\\geqslant0,\\ \\varphi\\in[0,2\\pi[\\qquad(7)$\u3002"
    },
    {
      "block": 18,
      "text": "\u56e0\u6b64\uff0c\u516c\u5f0f\uff082\uff09\u662f\u8c10\u632f\u52a8\u7684\u4e00\u822c\u516c\u5f0f\u3002"
    },
    {
      "block": 19,
      "text": "\u51fd\u6570 $f$ \u7684\u7edd\u5bf9\u503c\u7684\u6700\u5927\u503c\u7b49\u4e8e $A$\u3002\n\u5e38\u6570 $A$ \u79f0\u4e3a\u632f\u52a8\u7684\u632f\u5e45\u3002\n\u7531\u516c\u5f0f\uff082\uff09\u7ed9\u51fa\u7684\u51fd\u6570 $f$ \u5177\u6709\u5468\u671f\n$T=\\frac{2\\pi}{\\omega}$\u3002\n\n\u9664 $A=0$ \u7684\u60c5\u5f62\u5916\uff0c\u8fd9\u4e2a\u5468\u671f\u662f\u6700\u5c0f\u6b63\u5468\u671f\uff1b\n\u632f\u5e45\u4e3a\u96f6\u65f6\u51fd\u6570\u662f\u5e38\u51fd\u6570\uff0c\u6ca1\u6709\u6700\u5c0f\u6b63\u5468\u671f\u3002\n\u5e38\u6570 $\\omega$ \u662f\u76f8\u4f4d\u968f\u65f6\u95f4\u7684\u53d8\u5316\u7387\uff0c\u79f0\u4e3a\u89d2\u9891\u7387\u3002\n\n\u672c\u8282\u53ca\u4e60\u9898\u6240\u8bf4\u7684\u201c\u9891\u7387\u201d\u5747\u6307\u8fd9\u4e2a\u89d2\u9891\u7387\uff1b\n\u5b83\u4e0d\u540c\u4e8e\u8868\u793a\u5355\u4f4d\u65f6\u95f4\u5185\u5b8c\u6574\u632f\u52a8\u6b21\u6570\u7684\u666e\u901a\u9891\u7387\uff0c\u540e\u8005\u662f\u5468\u671f\u7684\u5012\u6570\u3002\n\u5e38\u6570 $\\varphi$ \u79f0\u4e3a\u632f\u52a8\u7684\u521d\u76f8\u3002"
    },
    {
      "block": 23,
      "text": "* \u5bb9\u6613\u9a8c\u8bc1\uff0c\u9650\u5236 $A\\geqslant0$\u3001$\\varphi\\in[0,2\\pi[$ \u5e76\u4e0d\u5f71\u54cd\u89e3\u7684\u96c6\u5408\uff1b\n\u53d6\u6d88\u8fd9\u4e9b\u9650\u5236\uff0c\u516c\u5f0f\uff082\uff09\u4e5f\u4e0d\u4f1a\u7ed9\u51fa\u65b0\u7684\u89e3\u3002"
    }
  ],
