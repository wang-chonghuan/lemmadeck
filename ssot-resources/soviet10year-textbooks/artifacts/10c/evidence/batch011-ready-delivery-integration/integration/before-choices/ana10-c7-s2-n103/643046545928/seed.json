  "exercises": [
    {
      "number": "440",
      "text": "440. \u5c06\u77f3\u5757\u4e0a\u629b\uff0c\u5982\u679c\u5ffd\u7565\u7a7a\u6c14\u7684\u963b\u529b\u5e76\u4e14\u8ba4\u4e3a\u91cd\u529b\u52a0\u901f\u5ea6$g\\approx9.8$\uff0c\u6c42\uff1a\n1) \u77f3\u5757\u4e0a\u5347\u7684\u6700\u5927\u9ad8\u5ea6\u4e0e\u521d\u901f\u5ea6$v_0$\u7684\u5173\u7cfb\uff1b\n2) \u77f3\u5757\u5728\u6700\u9ad8\u4f4d\u7f6e\u65f6\u7684\u901f\u5ea6\uff1b\n3) \u7ecf\u8fc7\u591a\u5c11\u65f6\u95f4\u77f3\u5757\u843d\u5230\u5730\u9762\uff1f",
      "figure_ids": []
    },
    {
      "number": "441",
      "text": "441. \u5982\u679c\u8d28\u70b9\u7684\u901f\u5ea6\u6309$v=9.8t-0.003t^2$\u7684\u89c4\u5f8b\u53d8\u5316\uff0c\u6c42\u7531$t=0$\u5230$t=5$\u7684\u65f6\u95f4\u95f4\u9694\u5185\u8d28\u70b9\u6240\u901a\u8fc7\u7684\u8def\u7a0b\u3002\n\u6c42\u8d28\u70b9\u5728\u8def\u7a0b\u7ec8\u70b9(\u5c31\u662f\u5f53$t=5$\u65f6)\u7684\u52a0\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "442",
      "text": "442. \u8bbe\u52a8\u70b9\u7684\u901f\u5ea6\u6309$v=Rt+a\\sqrt{t}$\u7684\u89c4\u5f8b\u53d8\u5316\u3002\n\u6c42\u7531$t=0$\u5230$t=4$\u7684\u65f6\u95f4\u95f4\u9694\u5185\u8fd9\u4e2a\u52a8\u70b9\u6240\u901a\u8fc7\u7684\u8def\u7a0b\u548c\u5b83\u5728\u8def\u7a0b\u7ec8\u70b9\u7684\u52a0\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "443",
      "text": "443.\na) \u8bbe\u8d28\u70b9\u6cbf\u629b\u7269\u7ebf$y=x^2-2x+3$\u8fd0\u52a8\uff0c\u4f7f\u5f97\u5b83\u5728\u6a2a\u8f74\u4e0a\u7684\u6295\u5f71\u5177\u6709\u6052\u5b9a\u901f\u5ea6$v$\u3002\u6c42\u8fd9\u4e2a\u8d28\u70b9\u5728\u7eb5\u5750\u6807\u8f74\u4e0a\u7684\u6295\u5f71\u7684\u901f\u5ea6\u548c\u52a0\u901f\u5ea6(\u7528$x$\u8868\u793a)\u3002\nb) \u8bbe\u8d28\u70b9\u6cbf\u51fd\u6570$y=x^3-2x^2$\u7684\u56fe\u8c61\u8fd0\u52a8\uff0c\u4f7f\u5f97\u5b83\u5728\u6a2a\u8f74\u4e0a\u7684\u6295\u5f71\u5177\u6709\u6052\u5b9a\u901f\u5ea6$v$\u3002\u6c42\u8fd9\u4e2a\u8d28\u70b9\u5728\u7eb5\u5750\u6807\u8f74\u4e0a\u7684\u6295\u5f71\u7684\u901f\u5ea6\u548c\u52a0\u901f\u5ea6\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u73b0\u5728\uff0c\u6211\u4eec\u6765\u89e3\u51b3\u5728\u672c\u7ae0\u5f00\u5934\u65f6\u6240\u63d0\u51fa\u7684\u95ee\u9898\u3002\n\u8bbe\u8d28\u70b9\u6cbf\u76f4\u7ebf\u8fd0\u52a8\u3002\n\u540c\u65f6\u8d28\u70b9\u7684\u5750\u6807$x$\u662f\u8fd0\u52a8\u65f6\u95f4$t$\u7684\u51fd\u6570\uff0c\u5c31\u662f$x=x(t)$\u3002\n\n\u5df2\u7ecf\u786e\u5b9a\uff0c\u8d28\u70b9\u7684\u8fd0\u52a8\u901f\u5ea6$v(t)=x'(t)$\u3002\n\u56e0\u6b64\uff0c\u5982\u679c\u6211\u4eec\u5df2\u77e5\u901f\u5ea6\u662f\u65f6\u95f4\u7684\u51fd\u6570$v(t)$\uff0c\u90a3\u4e48\u7531\u725b\u987f-\u83b1\u5e03\u5c3c\u5179\u516c\u5f0f\u5f97\uff1a\n$\\int_{t_0}^tv(t)dt=x(t)-x(t_0)$ (1)\u3002"
    },
    {
      "block": 1,
      "text": "\u6570$x(t_0)$\u53eb\u505a\u521d\u59cb\u5750\u6807\u5e76\u4e14\u7528$x_0$\u8868\u793a\u3002\n\u4e8e\u662f(1)\u5f0f\u53ef\u4ee5\u5199\u6210\n$x(t)=x_0+\\int_{t_0}^tv(z)dz$ (2)\u3002"
    },
    {
      "block": 4,
      "text": "\u52a0\u901f\u5ea6$a(t)=v'(t)$\uff0c\u5982\u679c\u5df2\u77e5\u7684\u8d28\u70b9\u7684\u8fd0\u52a8\u52a0\u901f\u5ea6\u662f\u65f6\u95f4\u7684\u51fd\u6570\uff0c\u90a3\u4e48\u6839\u636e\u725b\u987f-\u83b1\u5e03\u5c3c\u5179\u516c\u5f0f\uff1a\n$\\int_{t_0}^ta(z)dz=v(t)-v(t_0)$ (3)\u3002"
    },
    {
      "block": 5,
      "text": "\u6570$v(t_0)$\u53eb\u505a\u521d\u901f\u5ea6\u5e76\u4e14\u7528$v_0$\u8868\u793a\u3002\n\u4e8e\u662f\u7b49\u5f0f(3)\u53ef\u4ee5\u5199\u6210\n$v(t)=v_0+\\int_{t_0}^ta(z)dz$ (4)\u3002"
    }
  ],
