      "inventory": {
        "path": "/Users/yong/.codex/worktrees/a07e/lemmadeck/.intentfold/tickets/STEMROBIN-184/tmp/production-source10c168-171-author/inventory-0169.md",
        "bytes": 2999,
        "sha256": "a387a08a7259d654753a915ec6528bde454d9c8f3ae7ad000d616ee4c7002932"
      },
      "observedMdBodyLinesIncludingFolio": 22,
      "observedContinuationMarkers": 0,
