  "exercises": [
    {
      "number": "206",
      "text": "**\u4e60 \u9898**\n206.\n1) \u5706\u9525\u7684\u8f74\u622a\u9762\uff1b\n2) \u5e73\u884c\u4e8e\u5706\u9525\u5e95\u9762\u7684\u622a\u9762\uff1b\n3)\u901a\u8fc7\u5706\u9525\u9876\u70b9\u7684\u622a\u9762\uff0c\u5404\u662f\u4ec0\u4e48\u6837\u7684\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "207",
      "text": "**\u4e60 \u9898**\n207\u00b0.\n1) \u5706\u9525\u6709\u5bf9\u79f0\u4e2d\u5fc3\u5417\uff1f\n2) \u5706\u9525\u6709\u591a\u5c11\u5bf9\u79f0\u8f74\u548c\u5bf9\u79f0\u9762\uff1f",
      "figure_ids": []
    },
    {
      "number": "208",
      "text": "**\u4e60 \u9898**\n208.\n1) \u5706\u9525\u7684\u6bcd\u7ebf\u957f\u7b49\u4e8e$l$\uff0c\u8f74\u622a\u9762\u7684\u9876\u89d2\u7b49\u4e8e$\\varphi$. \u6c42\u5e95\u9762\u79ef\uff1b\n2) \u5706\u9525\u7684\u5e95\u9762\u79ef\u662f$Q$\uff0c\u6bcd\u7ebf\u662f$l$. \u6c42\u8f74\u622a\u9762\u7684\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "209",
      "text": "**\u4e60 \u9898**\n209. \u5706\u9525\u7684\u5e95\u9762\u534a\u5f84\u662f$R$\uff0c\u6bcd\u7ebf\u5bf9\u4e8e\u5e95\u9762\u7684\u503e\u659c\u89d2\u662f$\\alpha$. \u4e00\u4e2a\u5e73\u9762\u7ecf\u8fc7\u5706\u9525\u9876\u70b9\uff0c\u4e0e\u5e95\u9762\u76f8\u4ea4\u6240\u6210\u7684\u89d2\u662f$\\varphi$. \u6c42\u622a\u9762\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "210",
      "text": "**\u4e60 \u9898**\n210. \u9752\u8d2e\u5854\u5706\u9525\u5f62\u7684\u9876\u90e8\u7684\u76f4\u5f84\u662f$6\\mathrm{m}$\uff0c\u9ad8$2\\mathrm{m}$. \u5982\u679c\u7528$0.7\\mathrm{m}\\times1.4\\mathrm{m}$\u7684\u94c1\u7247\u82eb\u5c4b\u9876\uff0c\u5e76\u4e14\u63a5\u7f1d\u5904\u548c\u635f\u8017\u5360\u5c4b\u9876\u9762\u79ef\u7684$10\\%$\uff0c\u95ee\u9700\u591a\u5c11\u5f20\u94c1\u7247\uff1f",
      "figure_ids": []
    },
    {
      "number": "211",
      "text": "**\u4e60 \u9898**\n211.\n1) \u6709\u4e00\u6761\u76f4\u89d2\u8fb9\u7b49\u4e8e$a$\u3001\u5b83\u6240\u5bf9\u7684\u89d2\u662f$30^{\\circ}$\u7684\u76f4\u89d2\u4e09\u89d2\u5f62\u7ed5\u659c\u8fb9\u65cb\u8f6c. \u6c42\u7531\u8fd9\u4e2a\u4e09\u89d2\u5f62\u4e24\u6761\u76f4\u89d2\u8fb9\u7ec4\u6210\u7684\u6298\u7ebf\u65cb\u8f6c\u6240\u5f97\u5230\u7684\u56fe\u5f62\u7684\u9762\u79ef.\n2) \u5e95\u8fb9\u8fb9\u957f\u662f$b$\uff0c\u9876\u89d2\u662f$\\varphi$\u7684\u7b49\u8170\u4e09\u89d2\u5f62\u7ed5\u5e95\u8fb9\u65cb\u8f6c.\u6c42\u7531\u4e24\u8170\u7ec4\u6210\u7684\u6298\u7ebf\u65cb\u8f6c\u6240\u5f97\u5230\u7684\u56fe\u5f62\u7684\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "212",
      "text": "**\u4e60 \u9898**\n212. \u901a\u8fc7\u5939\u89d2\u4e3a$\\alpha$\u7684\u4e24\u6761\u6bcd\u7ebf\u5f15\u5e73\u9762\uff0c\u5f97\u5230\u7684\u622a\u9762\u9762\u79ef\u7b49\u4e8e$S$. \u5706\u9525\u7684\u5e95\u9762\u9762\u79ef\u7b49\u4e8e$Q$. \u6c42\u4fa7\u9762\u79ef. \u5982\u679c$\\alpha=28^{\\circ}42'$\uff0c$S=12.56\\mathrm{cm}^2$\uff0c$Q=15.31\\mathrm{cm}^2$\uff0c\u6c42\u4fa7\u9762\u79ef\u7684\u503c.",
      "figure_ids": []
    },
    {
      "number": "213",
      "text": "**\u4e60 \u9898**\n213.\n1) \u5706\u53f0\u7684\u9ad8\u7b49\u4e8e$6\\mathrm{cm}$\uff0c\u5e95\u9762\u534a\u5f84\u7b49\u4e8e$10\\mathrm{cm}$\u548c$2\\mathrm{cm}$. \u6c42\u5b83\u7684\u4fa7\u9762\u79ef\u548c\u5168\u9762\u79ef.\n2) \u5706\u53f0\u7684\u9ad8\u4e3a$h$\uff0c\u5e95\u9762\u534a\u5f84\u7684\u6bd4\u4e3a$1:3$\uff0c\u6bcd\u7ebf\u4e0e\u5e95\u9762\u5939\u89d2\u7b49\u4e8e$45^{\\circ}$. \u6c42\u5706\u53f0\u7684\u8868\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "214",
      "text": "**\u4e60 \u9898**\n214. \u76f4\u89d2\u68af\u5f62\u7ed5\u5b83\u8f83\u5c0f\u7684\u4e00\u8170\u65cb\u8f6c. \u5982\u679c\u68af\u5f62\u8f83\u5c0f\u7684\u5e95\u8fb9\u957f\u7b49\u4e8e$2\\mathrm{cm}$\uff0c\u5e76\u4e14\u4e0e\u5e95\u8fb9\u6210$60^{\\circ}$\u89d2\u7684\u8170\u957f\u662f$12\\mathrm{cm}$\uff0c\u6c42\u8fd9\u4e2a\u65cb\u8f6c\u56fe\u5f62\u7684\u8868\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "215",
      "text": "**\u4e60 \u9898**\n215.\n1) \u5706\u53f0\u7684\u5e95\u9762\u534a\u5f84\u662f$5\\mathrm{cm}$\u548c$2\\mathrm{cm}$\uff0c\u9ad8\u662f$4\\mathrm{cm}$. \u6c42\u4fa7\u9762\u5c55\u5f00\u56fe(\u56fe 88)\u7684\u5927\u5c0f(\u534a\u5f84\u548c\u5f27\u7684\u503c).\n2) \u5982\u679c\u6c34\u6876\u7684\u5e95\u9762\u76f4\u5f84\u662f$28\\mathrm{cm}$\u548c$20\\mathrm{cm}$\uff0c\u9ad8\u662f$24\\mathrm{cm}$\uff0c\u5b83\u7684\u4fa7\u9762\u5c55\u5f00\u56fe\u7684\u5927\u5c0f\u662f\u591a\u5c11\uff1f\u8981\u5236\u9020\u8fd9\u4e2a\u6c34\u6876\u9700\u8981\u591a\u5c11\u5e73\u65b9\u7c73\u7684\u6750\u6599(\u63a5\u7f1d\u5904\u6240\u7528\u53bb\u7684\u6599\u5ffd\u7565\u4e0d\u8ba1)\uff1f",
      "figure_ids": [
        "fig-g10-88"
      ]
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "1. \u5b9a\u4e49. \u76f4\u89d2\u4e09\u89d2\u5f62\u4ee5\u5b83\u7684\u4e00\u6761\u76f4\u89d2\u8fb9\u6240\u5728\u7684\u76f4\u7ebf\u4e3a\u8f74\u65cb\u8f6c\u5f97\u5230\u7684\u56fe\u5f62\u53eb\u5706\u9525\uff08\u56fe 83\uff09."
    },
    {
      "block": 1,
      "text": "\u659c\u8fb9\u548c\u4e0d\u5728\u65cb\u8f6c\u8f74\u4e0a\u7684\u76f4\u89d2\u8fb9\u7ec4\u6210\u7684\u6298\u7ebf\uff0c\u7ed5\u540c\u4e00\u6761\u8f74\u65cb\u8f6c\u5f97\u5230\u7684\u56fe\u5f62\u53eb\u505a\u5706\u9525\u7684\u8868\u9762."
    },
    {
      "block": 7,
      "text": "**\u6211\u4eec\u77e5\u9053\uff0c\u5706\u9525\u4fa7\u9762\u7684\u5c55\u5f00\u56fe\u662f\u4e00\u4e2a\u6247\u5f62**(\u56fe 84).\n**\u6211\u4eec****\u628a\u8fd9\u4e2a\u5c55\u5f00\u56fe\u7684\u9762\u79ef\u4f5c\u4e3a\u5706\u9525\u7684\u4fa7\u9762\u79ef\uff1b\n\u5b83\u7b49\u4e8e**$\\pi RL$\uff0c**\u5373**$S_{\u4fa7}=\\pi RL$\uff0c**\u8fd9\u91cc**$L$\u662f\u5df2\u77e5\u5706\u9525\u7684**\u6bcd\u7ebf**."
    },
    {
      "block": 8,
      "text": "**\u5706\u9525**\u5168\u90e8\u5c55\u5f00\u56fe(\u56fe 85)**\u7684\u9762\u79ef\u5c31\u662f\u5706\u9525\u7684\u8868\u9762\u79ef**\uff1a\n$S_{\u5706\u9525}=\\pi RL+\\pi R^2$."
    },
    {
      "block": 13,
      "text": "**2.** \u56fe 86 **\u753b\u51fa\u7684\u662f\u5706\u53f0\u7684\u56fe\u5f62**.\n**\u8fd9\u662f\u5939\u5728\u5706\u9525\u7684\u5e95\u9762\u548c**\u5e73\u884c\u4e8e\u5e95\u9762\u7684\u622a\u9762\u4e4b\u95f4\u7684**\u90e8\u5206**.\n**\u5706\u53f0\u7684\u5e95\u9762\u662f\u4f4d\u4f3c\u56fe\u5f62**\uff1b\n\n**\u4f4d****\u4f3c\u4e2d\u5fc3\u662f**\u539f\u5706\u9525\u7684**\u9876\u70b9**$S$(\u56fe 87).\n**\u5706\u53f0\u7684\u6bcd\u7ebf\u548c\u9ad8**(\u56fe 86 \u548c**87 \u4e2d\u7684**$[A_1,A]$**\u548c**$[O_1,O]$)**\u662f\u539f\u5706\u9525\u7684\u6bcd\u7ebf\u548c\u9ad8\u7684\u4e00\u90e8\u5206**."
    },
    {
      "block": 18,
      "text": "**\u7b49\u8170\u68af\u5f62\u7ed5\u7740\u5b83\u7684\u5bf9\u79f0\u8f74\u65cb\u8f6c\u65f6\u80fd\u591f\u5f97\u5230\u5706\u53f0**(\u56fe 86).\n**\u8fd9\u4e2a\u68af\u5f62\u7684\u8fb9\u65cb\u8f6c\u5f97\u5230\u7684\u56fe\u5f62\u5c31\u662f\u5706\u53f0\u7684\u8868\u9762**."
    },
    {
      "block": 19,
      "text": "**\u56fe 88 \u753b\u51fa\u7684\u662f\u5706\u53f0\u8868\u9762\u7684**\u5c55\u5f00\u56fe.\n**\u6211\u4eec\u628a\u5706\u53f0\u7684\u4fa7\u9762**\u548c\u5168\u90e8\u8868\u9762\u7684\u5c55\u5f00\u56fe\u7684\u9762\u79ef**\u4f5c\u4e3a\u5706\u53f0\u7684\u4fa7\u9762\u79ef\u548c\u5168\u9762\u79ef**."
    }
  ],
