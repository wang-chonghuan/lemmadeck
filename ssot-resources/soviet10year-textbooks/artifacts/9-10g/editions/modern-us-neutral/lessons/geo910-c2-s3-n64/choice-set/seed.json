  "exercises": [
    {
      "number": "229",
      "text": "\u4e60\u9898\n$^\\circ$. \u7ecf\u8fc7\u4e00\u4e2a\u70b9\u80fd\u591f\u4f5c\u591a\u5c11\u4e2a\u4e0e\u7403\u9762\u76f8\u5207\u7684\u5e73\u9762\uff1a\n1)\u70b9\u5728\u7403\u9762\u4e0a\uff1b\n2) \u70b9\u5728\u7403\u9762\u5916\uff1f",
      "figure_ids": []
    },
    {
      "number": "230",
      "text": "\u4e60\u9898\n$^\\circ$. \u7ecf\u8fc7\u4e00\u4e2a\u70b9\u80fd\u591f\u4f5c\u591a\u5c11\u6761\u7403\u9762\u7684\u5207\u7ebf\uff1a\n1) \u70b9\u5728\u8fd9\u4e2a\u7403\u9762\u4e0a\uff1b\n2) \u70b9\u5728\u7403\u9762\u5916\uff1f",
      "figure_ids": []
    },
    {
      "number": "231",
      "text": "\u4e60\u9898\n$^\\circ$. \u6c42\u7403\u5fc3\u7684\u96c6\u5408\uff1a\n1) \u7403\u9762\u4e0e\u5df2\u77e5\u5e73\u9762\u76f8\u5207\u4e8e\u5df2\u77e5\u70b9$O$\uff1b\n2) \u4e0e\u5df2\u77e5\u5e73\u9762\u76f8\u5207\uff0c\u534a\u5f84\u7b49\u4e8e\u5df2\u77e5\u534a\u5f84.",
      "figure_ids": []
    },
    {
      "number": "232",
      "text": "\u4e60\u9898\n1) \u7403\u9762\u7684\u534a\u5f84\u662f $R$\uff0c\u5b83\u7684\u4e24\u4e2a\u5207\u9762\u6240\u6210\u7684\u4e8c\u9762\u89d2\u7b49\u4e8e $\\varphi$. \u6c42\u7403\u5fc3\u5230\u4e8c\u9762\u89d2\u7684\u68f1\u7684\u8ddd\u79bb.\n$2^*$) \u6c42\u534a\u5f84\u7b49\u4e8e $R$\uff0c\u5e76\u4e14\u4e0e\u4e09\u4e2a\u5750\u6807\u5e73\u9762\u90fd\u76f8\u5207\u7684\u7403\u7684\u65b9\u7a0b. \u5047\u5b9a\u5df2\u77e5\u8fd9\u4e2a\u7403\u5fc3\u7684\u5750\u6807\u662f\u6b63\u6570.",
      "figure_ids": []
    },
    {
      "number": "233",
      "text": "\u4e60\u9898\n\u4f5c\u534a\u5f84\u662f $R$ \u7684\u7403\u4f53\u7684\u5207\u9762. \u6c42\u7ecf\u8fc7\u5207\u70b9\u4e0e\u5207\u9762\u6240\u6210\u7684\u89d2\u7b49\u4e8e $\\varphi$ \u7684\u7403\u4f53\u7684\u622a\u9762\u7684\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "234",
      "text": "\u4e60\u9898\n\u4e00\u5e73\u9762\u4e0e\u7403\u9762 $x^2+y^2+z^2=9$ \u76f8\u5207\u4e8e\u5df2\u77e5\u70b9\uff0c\u6c42\u5e73\u9762\u7684\u65b9\u7a0b. \u8bbe\u5df2\u77e5\u70b9\u7684\u5750\u6807\u662f\uff1a\n1) $(0, 3, 0)$\uff1b\n2) $(0, 2,-\\sqrt{5})$\uff1b\n3) $(2, -2, -1)$.",
      "figure_ids": []
    },
    {
      "number": "235",
      "text": "\u4e60\u9898\n\u8bc1\u660e\uff1a\u4e0e\u7403\u9762 $x^2+y^2+z^2=R^2$ \u76f8\u5207\u4e8e\u70b9 $A(m, p,q)$ \u7684\u5e73\u9762\u65b9\u7a0b\u662f $mx+py+qz=R^2$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "**\u5b9a\u4e49\uff1a\u4e0e\u7403\u9762\u53ea\u6709\u4e00\u4e2a\u516c\u5171\u70b9\u7684\u5e73\u9762\uff0c\u53eb\u505a\u7403\u9762\uff08\u7403\u4f53\uff09\u7684\u5207\u9762\u3002\n**"
    },
    {
      "block": 2,
      "text": "**\u5b9a\u740637\uff1a\u5e73\u9762\u4e0e\u7403\u9762\u76f8\u5207\u7684\u5145\u5206\u5fc5\u8981\u6761\u4ef6\u662f\uff1a\u8fd9\u4e2a\u5e73\u9762\u7ecf\u8fc7\u7403\u9762\u4e00\u6761\u76f4\u5f84\u7684\u7aef\u70b9\uff0c\u5e76\u4e14\u5782\u76f4\u4e8e\u8fd9\u6761\u76f4\u5f84\u3002\n**"
    },
    {
      "block": 6,
      "text": "\u5728\u5207\u9762\u5185\uff0c\u7ecf\u8fc7\u5207\u70b9\u4f5c\u4e00\u6761\u76f4\u7ebf\uff08\u56fe$96$\uff09\u3002\n\u8fd9\u6761\u76f4\u7ebf\u4e0e\u7403\u9762\u53ea\u6709\u4e00\u4e2a\u516c\u5171\u70b9\u3002\n\u8fd9\u6837\u7684\u76f4\u7ebf\u53eb\u505a\u7403\u9762\uff08\u7403\u4f53\uff09\u7684\u5207\u7ebf\u3002"
    }
  ],
