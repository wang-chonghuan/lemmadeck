  "section": null,
  "number": "64",
  "title": "与球面相切的平面",
  "printed_title": "§64. 与球面相切的平面",
  "start_page": 226,
  "start_printed": 219,
  "figures": [
    {
      "id": "fig-g10-96",
      "label": "图 96",
