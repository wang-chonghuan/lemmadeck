  "exercises": [
    {
      "number": "77",
      "text": "$77^{\\bullet}$\u3002\u5206\u522b\u8003\u8651\u4ee5\u4e0b\u4e24\u79cd\u60c5\u51b5\uff1a\n\n\u67d0\u4e00\u6761\u76f4\u7ebf $a$ \u5728\u5e73\u9762 $\\alpha$ \u5185\uff0c\u4f46\u4e0d\u5728\u5e73\u9762 $\\beta$ \u5185\uff1b\n\n2) \u5e73\u9762 $\\alpha$ \u5185\u7684\u4efb\u610f\u4e00\u6761\u76f4\u7ebf\u90fd\u4e0d\u5728\u5e73\u9762 $\\beta$ \u5185\u3002\n\n\u5e73\u9762 $\\alpha$ \u548c $\\beta$ \u7684\u4f4d\u7f6e\u5173\u7cfb\u600e\u6837\uff1f",
      "figure_ids": []
    },
    {
      "number": "78",
      "text": "78. \u5224\u65ad\u4e0b\u5217\u4e24\u79cd\u8bba\u65ad\u662f\u5426\u6b63\u786e\uff1a\n1) \u5982\u679c\u4e00\u4e2a\u5e73\u9762\u5185\u7684\u4e00\u6761\u76f4\u7ebf\u5e73\u884c\u4e8e\u53e6\u4e00\u4e2a\u5e73\u9762\u5185\u7684\u4e00\u6761\u76f4\u7ebf\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u5e73\u9762\u5e73\u884c\u3002\n2) \u5982\u679c\u4e00\u4e2a\u5e73\u9762\u5185\u7684\u4e24\u6761\u76f4\u7ebf\u5206\u522b\u5e73\u884c\u4e8e\u53e6\u4e00\u4e2a\u5e73\u9762\u5185\u7684\u4e24\u6761\u76f4\u7ebf\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u5e73\u9762\u5e73\u884c\u3002",
      "figure_ids": []
    },
    {
      "number": "79",
      "text": "$79^{\\bullet}$\u3002\u4ece\u6559\u5ba4\u91cc\u7684\u5bb6\u5177\u4e2d\u627e\u51fa\u5e73\u884c\u5e73\u9762\u7684\u6a21\u578b\u3002",
      "figure_ids": []
    },
    {
      "number": "80",
      "text": "80. \u8bc1\u660e\uff1a\u5e73\u884c\u516d\u9762\u4f53\u7684\u76f8\u5bf9\u9762\u6240\u5728\u7684\u5e73\u9762\u5e73\u884c\u3002",
      "figure_ids": []
    },
    {
      "number": "81",
      "text": "81. \u5206\u522b\u8003\u8651\u4ee5\u4e0b\u5404\u7c7b\u591a\u8fb9\u5f62\uff1a\n1) \u56db\u8fb9\u5f62\uff1b\n2) \u4e94\u8fb9\u5f62\uff1b\n3) $n$ \u8fb9\u5f62\uff08$(n>5)$\uff09\u3002\n\n\u5982\u679c\u591a\u8fb9\u5f62\u7684\u4e00\u6761\u5bf9\u89d2\u7ebf\u548c\u4e00\u6761\u8fb9\u90fd\u4e0e\u5e73\u9762 $\\alpha$ \u5e73\u884c\uff0c\u90a3\u4e48\u591a\u8fb9\u5f62\u6240\u5728\u7684\u5e73\u9762\u4e0e\u5e73\u9762 $\\alpha$ \u5e73\u884c\u3002\u5224\u65ad\u8fd9\u4e2a\u8bba\u65ad\u662f\u5426\u6b63\u786e\u3002",
      "figure_ids": []
    },
    {
      "number": "82",
      "text": "82. \u5df2\u77e5\u56db\u9762\u4f53 $ABCD$\uff0c\u70b9 $M$\u3001$N$\u3001$P$ \u5206\u522b\u662f\u68f1 $DA$\u3001$DB$\u3001$DC$ \u7684\u4e2d\u70b9\u3002\n\n\u8bc1\u660e\uff1a$(MNP)\\mathbin{//}(ABC)$\u3002",
      "figure_ids": []
    },
    {
      "number": "83",
      "text": "83. \u76f4\u7ebf $a$\u3001$b$\u3001$c$ \u4e0d\u5171\u9762\uff0c\u4e14\u6709\u516c\u5171\u70b9 $O$\u3002\n\u5728\u6bcf\u6761\u76f4\u7ebf\u4e0a\uff0c\u5206\u522b\u5728\u70b9 $O$ \u7684\u4e24\u4fa7\u53d6\u4e24\u70b9\uff0c\u4f9d\u6b21\u8bb0\u4e3a $A_1$ \u548c $A_2$\u3001$B_1$ \u548c $B_2$\u3001$C_1$ \u548c $C_2$\u3002\n\n\u82e5 $|OA_1|=|OA_2|$\uff0c$|OB_1|=|OB_2|$\uff0c$|OC_1|=|OC_2|$\uff0c\u8bc1\u660e\uff1a\u5e73\u9762 $A_1B_1C_1$ \u548c $A_2B_2C_2$ \u5e73\u884c\u3002",
      "figure_ids": []
    },
    {
      "number": "84",
      "text": "84.\n1) \u5982\u679c\u5e73\u9762 $\\alpha$ \u5185\u7684\u4e24\u6761\u76f8\u4ea4\u76f4\u7ebf\u4e2d\u7684\u6bcf\u4e00\u6761\u90fd\u4e0e\u5e73\u9762 $\\beta$ \u5e73\u884c\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u5e73\u9762\u5e73\u884c\u3002\n2) \u4e3a\u4e86\u68c0\u67e5\u6d4b\u89d2\u4eea\u5668\u7684\u5ea6\u76d8\u662f\u5426\u6c34\u5e73\uff0c\u53ef\u4ee5\u5728\u540c\u4e00\u5e73\u9762\u4e0a\u5b89\u653e\u4e24\u4e2a\u6c34\u51c6\u5668\uff08\u56fe 32\uff09\u3002\u4e3a\u4ec0\u4e48\u8981\u628a\u4e24\u4e2a\u6c34\u51c6\u5668\u5206\u522b\u6cbf\u76f4\u5f84\u65b9\u5411\u653e\u7f6e\uff1f",
      "figure_ids": [
        "fig-32"
      ]
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6211\u4eec\u5df2\u7ecf\u77e5\u9053\u4e24\u4e2a\u5e73\u9762\u7684\u4e24\u79cd\u4f4d\u7f6e\u5173\u7cfb\uff1a\n1) \u5982\u679c\u4e24\u4e2a\u5e73\u9762\u6709\u4e09\u4e2a\u4e0d\u5171\u7ebf\u7684\u516c\u5171\u70b9\uff0c\u5b83\u4eec\u5c31\u91cd\u5408\uff08\u516c\u74064\uff09\uff1b\n2) \u5982\u679c\u4e24\u4e2a\u5e73\u9762\u4e0d\u540c\u4e14\u6709\u4e00\u4e2a\u516c\u5171\u70b9\uff0c\u5b83\u4eec\u5c31\u76f8\u4ea4\uff08\u516c\u7406 5\uff09\u3002"
    },
    {
      "block": 7,
      "text": "\u56e0\u6b64\uff0c\u4e24\u4e2a\u5e73\u9762 $\\alpha$ \u548c $\\beta$ \u53ea\u6709\u4e09\u79cd\u4f4d\u7f6e\u5173\u7cfb\uff1a\n1) \u91cd\u5408\uff0c$\\alpha=\\beta$\uff1b\n2) \u76f8\u4ea4\uff0c$\\alpha\\cap\\beta=a$\uff1b\n\n3) \u6ca1\u6709\u516c\u5171\u70b9\uff0c$\\alpha\\cap\\beta=\\phi$\u3002"
    },
    {
      "block": 9,
      "text": "\u5b9a\u4e49\u3002\n\u5982\u679c\u4e24\u4e2a\u5e73\u9762\u6ca1\u6709\u516c\u5171\u70b9\uff0c\u6216\u8005\u4e24\u4e2a\u5e73\u9762\u91cd\u5408\uff0c\u5c31\u79f0\u8fd9\u4e24\u4e2a\u5e73\u9762\u5e73\u884c\u3002"
    },
    {
      "block": 11,
      "text": "\u5b9a\u7406 6\uff08\u4e24\u4e2a\u5e73\u9762\u5e73\u884c\u7684\u5224\u5b9a\uff09\u3002\n\u5982\u679c\u4e00\u4e2a\u5e73\u9762\u5185\u7684\u4e24\u6761\u76f8\u4ea4\u76f4\u7ebf\u5206\u522b\u5e73\u884c\u4e8e\u53e6\u4e00\u4e2a\u5e73\u9762\u5185\u7684\u4e24\u6761\u76f4\u7ebf\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u5e73\u9762\u5e73\u884c\u3002"
    }
  ],
