    {
      "number": "216",
      "text": "\u4e60\u9898\n216.\n1\u00b0) \u8bc1\u660e\uff1a\u7403\u5fc3\u662f\u7403\u7684\u5bf9\u79f0\u4e2d\u5fc3\uff1b\n2\u00b0) \u7403\u9762\u6709\u591a\u5c11\u5bf9\u79f0\u8f74\u548c\u5bf9\u79f0\u9762\uff1f",
      "figure_ids": []
    },
    {
      "number": "217",
      "text": "\u4e60\u9898\n217\u00b0.\n\u7403\u9762\u4e0e\u7ecf\u8fc7\u7403\u5fc3\u7684\u5e73\u9762\u7684\u4ea4\u96c6\u662f\u4ec0\u4e48\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "218",
      "text": "\u4e60\u9898\n218.\n\u5df2\u77e5\u70b9$A(1,-2,3)$\u3001$B(3,-3,1)$\u3001$C(1,1,\\sqrt{2})$\u3001$D(0,-3,\\sqrt{7})$\u3002\n\u8fd9\u4e9b\u70b9\u4e2d\uff0c\u54ea\u4e9b\u70b9\u5c5e\u4e8e\u7403\u5fc3\u662f$S(1,-2,0)$\u3001\u534a\u5f84\u7b49\u4e8e3\u7684\u7403\u9762\uff1f",
      "figure_ids": []
    },
    {
      "number": "219",
      "text": "\u4e60\u9898\n219.\n\u6c42\u7403\u9762$x^2+y^2+z^2=R^2$\u4e0e\u5750\u6807\u8f74\u4ea4\u70b9\u7684\u5750\u6807\u3002",
      "figure_ids": []
    },
    {
      "number": "220",
      "text": "\u4e60\u9898\n220.\n\u5df2\u77e5\u7403\u9762$x^2+y^2+z^2=200$\u548c\u70b9$S(3,4,5)$\u3002\n\u6c42\u8fd9\u4e2a\u7403\u9762\u4e0e\u76f4\u7ebf$SO$\uff08$O$\u70b9\u662f\u5750\u6807\u539f\u70b9\uff09\u4ea4\u70b9\u7684\u5750\u6807\u3002",
      "figure_ids": []
    },
    {
      "number": "221",
      "text": "\u4e60\u9898\n221.\n\u6c42\u70b9$A(3p,-2p,6p)$\u5230\u7403\u9762$x^2+y^2+z^2=p^2(p>0)$\u7684\u8ddd\u79bb\u3002",
      "figure_ids": []
    },
    {
      "number": "222",
      "text": "\u4e60\u9898\n222*.\n\u6c42\u4ee5$S$\u4e3a\u7403\u5fc3\u3001$R$\u4e3a\u534a\u5f84\u7684\u7403\u9762\u7684\u65b9\u7a0b\uff1a\n1) $S(2,$ $-1,3)$\uff0c$R=4$\uff1b\n2) $S(-5,0,7)$\uff0c$R=\\sqrt{3}$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "1.\n**\u5b9a\u4e491. \u7a7a\u95f4\u4e2d\u5230\u5df2\u77e5\u70b9\u7684\u8ddd\u79bb\u7b49\u4e8e\u5df2\u77e5\u6b63\u6570$R$\u7684\u6240\u6709\u70b9\u7684\u96c6\u5408\uff0c\u53eb\u505a\u7403\u9762**\u3002"
    },
    {
      "block": 7,
      "text": "**\u5b9a\u4e492. \u7a7a\u95f4\u4e2d\u5230\u5df2\u77e5\u70b9\u7684\u8ddd\u79bb\u4e0d\u5927\u4e8e\u5df2\u77e5\u6b63\u6570$R$\u7684\u6240\u6709\u70b9\u7684\u96c6\u5408\uff0c\u53eb\u505a\u7403\u4f53**\u3002"
    },
    {
      "block": 9,
      "text": "2.\n\u7ed9\u5b9a\u4e00\u4e2a\u76f4\u89d2\u5750\u6807\u7cfb\uff0c\u6765\u5efa\u7acb\u4ee5$S(a,b,c)$\u4e3a\u4e2d\u5fc3\u3001$R$\u4e3a\u534a\u5f84\u7684\u7403\u9762\u65b9\u7a0b\uff08\u56fe91\uff09\u3002\n\u7403\u9762\u4e0a\u7684\u4efb\u4e00\u70b9$M$ $(x,y,z)$\u90fd\u6ee1\u8db3\u7b49\u5f0f$|SM|=R$\u3002\n\n\u56e0\u6b64\uff0c\u5229\u7528\u4e24\u70b9\u95f4\u8ddd\u79bb\u516c\u5f0f\uff08\u00a744\uff09\uff0c\u5f97\u5230\uff1a\n$(x-a)^2+(y-b)^2+(z-c)^2=R^2$\u3002"
    },
    {
      "block": 12,
      "text": "\u5982\u679c$a=b=c=0$\uff0c\u5c31\u5f97\u5230\u7403\u5fc3\u5728\u5750\u6807\u539f\u70b9\u7684\u7403\u9762\u65b9\u7a0b\uff1a\n$x^2+y^2+z^2=R^2$\u3002"
    }
  ],
