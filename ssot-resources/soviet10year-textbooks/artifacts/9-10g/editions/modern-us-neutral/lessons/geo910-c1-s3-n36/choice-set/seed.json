  },
  "exercises": [
    {
      "number": "331",
      "text": "331. \u4ee5\u4e0b\u7684\u8bba\u65ad\u6b63\u786e\u5417\uff1f\n1) \u5982\u679c\u76f4\u7ebf\u5782\u76f4\u4e8e\u659c\u7ebf\u7684\u5c04\u5f71\uff0c\u90a3\u4e48\u8fd9\u6761\u76f4\u7ebf\u5782\u76f4\u4e8e\u659c\u7ebf\u672c\u8eab\uff1b\n2) \u5982\u679c\u76f4\u7ebf\u5782\u76f4\u4e8e\u659c\u7ebf\u548c\u5b83\u7684\u5c04\u5f71\uff0c\u90a3\u4e48\u76f4\u7ebf\u5728\u5c04\u5f71\u5e73\u9762\u5185.",
      "figure_ids": []
    },
    {
      "number": "332",
      "text": "332\u00b0. \u5982\u679c\u5728\u4e09\u5782\u7ebf\u5b9a\u7406\u4e2d\u7528\u8bcd\u201c\u5e73\u884c\u4e8e\u5c04\u5f71\u5e73\u9762\u7684\u201d\u4ee3\u66ff\u8bcd\u201c\u5e73\u9762\u5185\u7684\u201d\uff0c\u5f97\u5230\u7684\u547d\u9898\u6b63\u786e\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "333",
      "text": "333. \u5229\u7528\u5411\u91cf\u7684\u6570\u6027\u79ef\u8bc1\u660e\u4e09\u5782\u7ebf\u5b9a\u7406(\u56fe132).",
      "figure_ids": [
        "fig-132"
      ]
    },
    {
      "number": "334",
      "text": "334. \u76f4\u7ebf$a$\u548c\u5e73\u9762$\\alpha$\u76f8\u4ea4. \u5728\u5e73\u9762$\\alpha$\u5185\u8fc7\u5df2\u77e5\u70b9\u4f5c\u76f4\u7ebf\u5782\u76f4\u4e8e\u76f4\u7ebf$a$.",
      "figure_ids": []
    },
    {
      "number": "335",
      "text": "335\u00b0. \u4ece\u77e9\u5f62$ABCD$\u7684\u9876\u70b9$A$(\u56fe133)\u4f5c\u5b83\u6240\u5728\u5e73\u9762\u7684\u5782\u7ebf\uff0c\u70b9$M$\u662f\u8fd9\u6761\u5782\u7ebf\u4e0a\u7684\u4e00\u70b9\uff0c\u8fde\u7ed3\u70b9$M$\u548c\u70b9$B$\u3001$C$\u3001$D$.\n1) \u8bc1\u660e\uff1a\u4e09\u89d2\u5f62$MBC$\u548c$MDC$\u662f\u76f4\u89d2\u4e09\u89d2\u5f62\uff1b\n2) \u5728\u7ebf\u6bb5$MA$\u3001$MB$\u3001$MC$\u3001$MD$\u4e2d\u6307\u51fa\u6700\u957f\u7684\u548c\u6700\u77ed\u7684\u7ebf\u6bb5.",
      "figure_ids": [
        "fig-133"
      ]
    },
    {
      "number": "336",
      "text": "336. \u5982\u56fe134\uff0c\u4e09\u89d2\u5f62$ABC$\u8868\u793a\u6b63\u4e09\u89d2\u5f62\uff0c\u7ebf\u6bb5$MN$\u8868\u793a\u8fc7\u70b9$N$\u5782\u76f4\u4e8e\u4e09\u89d2\u5f62\u6240\u5728\u5e73\u9762\u7684\u5782\u7ebf. \u6c42\u4f5c\u8fc7\u70b9$M$\u3001$N$\u4e14\u5782\u76f4\u4e8e\u4e09\u89d2\u5f62\u5404\u8fb9\u7684\u5782\u7ebf.",
      "figure_ids": [
        "fig-134"
      ]
    },
    {
      "number": "337",
      "text": "337.\n1) \u76f4\u89d2\u4e09\u89d2\u5f62\u7684\u76f4\u89d2\u8fb9\u4e3a$a$\u548c$b$\uff0c\u4ece\u76f4\u89d2\u9876\u70b9\u4f5c\u4e09\u89d2\u5f62\u6240\u5728\u5e73\u9762\u7684\u5782\u7ebf\uff0c\u5782\u7ebf\u957f\u4e3a$h$. \u6c42\u4ece\u5782\u7ebf\u4e0d\u5728\u4e09\u89d2\u5f62\u6240\u5728\u5e73\u9762\u5185\u7684\u7aef\u70b9\u5230\u659c\u8fb9\u7684\u8ddd\u79bb.\n2) \u4e09\u89d2\u5f62\u7684\u8fb9\u957f\u7b49\u4e8e20cm\u300165cm\u300175cm. \u4ece\u4e09\u89d2\u5f62\u5927\u89d2\u7684\u9876\u70b9\u4f5c\u5b83\u6240\u5728\u5e73\u9762\u7684\u957f\u4e3a60cm\u7684\u5782\u7ebf. \u6c42\u4ece\u5782\u7ebf\u7aef\u70b9\u5230\u4e09\u89d2\u5f62\u7684\u5927\u8fb9\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "338",
      "text": "338.\n1) \u5728\u5e73\u9762$\\alpha$\u5185\u4f5c\u4e24\u6761\u76f8\u4e92\u8ddd\u79bb\u4e3a$m$\u7684\u5e73\u884c\u7ebf. \u70b9$s$\u548c\u5e73\u9762$\\alpha$\u7684\u8ddd\u79bb\u4e3a$h$\uff0c\u4e14\u548c\u4e24\u6761\u76f4\u7ebf\u7b49\u8ddd. \u6c42\u8fd9\u4e2a\u8ddd\u79bb.\n2) \u5728\u5e73\u9762$\\alpha$\u5185\u4f5c\u5e73\u884c\u76f4\u7ebf$a$\u548c$b$\uff0c\u5b83\u4eec\u4e4b\u95f4\u7684\u8ddd\u79bb\u4e3a44cm. \u76f4\u7ebf$c$\u5e73\u884c\u4e8e\u5df2\u77e5\u76f4\u7ebf\uff0c\u548c\u5e73\u9762$\\alpha$\u7684\u8ddd\u79bb\u4e3a15cm\uff0c\u548c\u76f4\u7ebf$a$\u7684\u8ddd\u79bb\u4e3a39cm. \u6c42\u76f4\u7ebf$b$\u548c$c$\u4e4b\u95f4\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "339",
      "text": "339. \u70b9$M$\u548c\u8fb9\u957f\u4e3a$a$\u7684\u6b63\u4e09\u89d2\u5f62\u7684\u6240\u6709\u9876\u70b9\u7b49\u8ddd\uff0c\u4e0e\u4e09\u89d2\u5f62\u6240\u5728\u5e73\u9762\u7684\u8ddd\u79bb\u4e3a$b$. \u6c42\u70b9$M$\u4e0e\u4e09\u89d2\u5f62\u7684\u8fb9\u6240\u5728\u7684\u76f4\u7ebf\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "340",
      "text": "340\u00b0. \u5728\u83f1\u5f62\u6240\u5728\u5e73\u9762\u5916\u7684\u4e00\u70b9\u4e0e\u83f1\u5f62\u5404\u8fb9\u6240\u5728\u7684\u76f4\u7ebf\u7b49\u8ddd. \u8fd9\u4e2a\u70b9\u4e0e\u83f1\u5f62\u6240\u6709\u9876\u70b9\u7684\u8ddd\u79bb\u76f8\u7b49\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "341",
      "text": "341\u00b0.\n1) \u7a7a\u95f4\u4e00\u70b9\u5230\u4e09\u89d2\u5f62\u7684\u9876\u70b9\u7b49\u8ddd\uff0c\u4e5f\u540c\u5b83\u7684\u8fb9\u6240\u5728\u7684\u76f4\u7ebf\u7b49\u8ddd. \u8fd9\u4e2a\u4e09\u89d2\u5f62\u662f\u4ec0\u4e48\u4e09\u89d2\u5f62\uff1f.\n2) \u5bf9\u4e8e\u56db\u8fb9\u5f62\u89e3\u7b54\u4e0a\u9898.",
      "figure_ids": []
    }
  ],
  "concepts": [
