  "exercises": [
    {
      "number": "8",
      "text": "\u4e60\u9898\n8. \u8ba1\u7b97\u4e0b\u5217\u5411\u91cf\u7684\u957f\u5ea6\uff1a\n1) $\\vec a=\\vec i-\\vec j+\\vec k$\uff1b\n2) $\\vec b=2\\vec i+\\vec j-3\\vec k$\uff1b\n3) $\\vec c=\\vec j-\\vec k$\uff1b\n4) $\\vec d=-2\\vec j$.",
      "figure_ids": []
    },
    {
      "number": "9",
      "text": "\u4e60\u9898\n9. \u5411\u91cf\u7684\u957f\u5ea6\u7b49\u4e8e3. \u5982\u679c\u5df2\u77e5\u5411\u91cf\u7684\u5750\u6807\u90fd\u76f8\u7b49. \u8ba1\u7b97\u5411\u91cf\u7684\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "10",
      "text": "\u4e60\u9898\n10. \u5982\u679c\uff1a\n1) $\\vec a=(1,2,-1)$\uff0c$\\vec b=(3,0,-2)$\uff1b\n2) $\\vec a=(1,-1,3)$\uff0c$\\vec b=(-1,1,-3)$\uff0c\u8ba1\u7b97\u5411\u91cf $\\vec a+\\vec b$ \u7684\u957f\u5ea6.",
      "figure_ids": []
    },
    {
      "number": "11",
      "text": "\u4e60\u9898\n11. \u5982\u679c\uff1a\n1) $\\vec a=(1,1,-1)$\uff0c$\\vec b=(2,0,0)$\uff1b\n2) $\\vec a=(3,1,0)$\uff0c$\\vec b=(0,1,-1)$\uff0c\u8ba1\u7b97\u5411\u91cf $2\\vec a+3\\vec b$ \u7684\u957f\u5ea6.",
      "figure_ids": []
    },
    {
      "number": "12",
      "text": "\u4e60\u9898\n12. \u6c42\u5411\u91cf $\\vec a=(-1,2,-2)$ \u548c $\\vec b=(6,3,-6)$ \u7684\u5939\u89d2.",
      "figure_ids": []
    },
    {
      "number": "13",
      "text": "\u4e60\u9898\n13. \u5982\u679c $\\vec a=(1,2,1)$ \u548c $\\vec b=(2,-1,0)$\uff0c\u6c42\u5411\u91cf $\\vec a-\\vec b$ \u548c$\\vec a+\\vec b$ \u7684\u5939\u89d2\u7684\u4f59\u5f26.",
      "figure_ids": []
    },
    {
      "number": "14",
      "text": "\u4e60\u9898\n14. \u5411\u91cf $\\vec a=(p,q,r)$ \u540c\u57fa\u5e95\u5411\u91cf $\\vec i$\u3001$\\vec j$\u3001$\\vec k$ \u7684\u5939\u89d2\u5206\u522b\u662f $\\alpha$\u3001$\\beta$\u3001$\\gamma$\uff08\u56fe5\uff09.\n1) \u8bc1\u660e\uff1a\u65b9\u5411\u4e0e\u5411\u91cf $\\vec a$ \u76f8\u540c\u7684\u5355\u4f4d\u5411\u91cf\u7684\u5750\u6807\u4e3a $(\\cos\\alpha,\\cos\\beta,\\cos\\gamma)$.\n2) \u8bc1\u660e\u7b49\u5f0f\uff1a$\\cos^2\\alpha+\\cos^2\\beta+\\cos^2\\gamma=1$.\n3) \u5982\u679c $\\alpha=\\beta=60^\\circ$\uff0c\u8ba1\u7b97 $\\gamma$.",
      "figure_ids": [
        "fig-g10-05"
      ]
    },
    {
      "number": "15",
      "text": "\u4e60\u9898\n15. \u6c42\u4e0b\u5217\u5411\u91cf\u4e0e\u57fa\u5e95\u5411\u91cf\u7684\u5939\u89d2\u7684\u4f59\u5f26\uff1a\n1) $\\vec a=\\vec i+\\vec j+\\vec k$\uff1b\n2) $\\vec b=-3\\vec j-\\vec k$\uff1b\n3) $\\vec c=-5\\vec i$\uff1b\n4) $\\vec d=(0,3,4)$.",
      "figure_ids": []
    }
  ],
  "concepts": [
