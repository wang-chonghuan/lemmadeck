  "exercises": [
    {
      "number": "310",
      "text": "310\u00b0. \u76f4\u7ebf$a$\u5728\u5e73\u9762$\\alpha$\u5185\uff0c\u70b9$M$\u4e0d\u5c5e\u4e8e\u8fd9\u4e2a\u5e73\u9762. \u6bd4\u8f83$M$\u5230$\\alpha$\u7684\u8ddd\u79bb\u548c$M$\u5230$a$\u7684\u8ddd\u79bb. \u5728\u4ec0\u4e48\u60c5\u51b5\u4e0b\u4e24\u4e2a\u8ddd\u79bb\u76f8\u7b49.",
      "figure_ids": []
    },
    {
      "number": "311",
      "text": "311. \u5df2\u77e5\uff1a\n1) \u6b63\u65b9\u4f53\u4e00\u4e2a\u9762\u7684\u5bf9\u89d2\u7ebf\u7b49\u4e8e$m$\uff1b\n2) \u6b63\u65b9\u4f53\u7684\u5bf9\u89d2\u7ebf\u7b49\u4e8e$d$. \u6c42\u4ece\u6b63\u65b9\u4f53\u7684\u9876\u70b9\u5230\u5b83\u76f8\u5bf9\u7684\u9762\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "312",
      "text": "312. \u8bc1\u660e\uff1a\n1) \u5982\u679c\u7ebf\u6bb5\u548c\u5e73\u9762\u4e0d\u76f8\u4ea4\uff0c\u4ece\u7ebf\u6bb5\u4e2d\u70b9\u5230\u5e73\u9762\u7684\u8ddd\u79bb\uff0c\u7b49\u4e8e\u4ece\u7ebf\u6bb5\u4e24\u7aef\u70b9\u5230\u5e73\u9762\u7684\u8ddd\u79bb\u4e4b\u548c\u7684\u4e00\u534a\uff1b\n2) \u5982\u679c\u7ebf\u6bb5\u548c\u5e73\u9762\u76f8\u4ea4\uff0c\u4ece\u7ebf\u6bb5\u4e2d\u70b9\u5230\u5e73\u9762\u7684\u8ddd\u79bb\uff0c\u7b49\u4e8e\u7ebf\u6bb5\u4e24\u7aef\u70b9\u5230\u5e73\u9762\u7684\u8ddd\u79bb\u7684\u5dee\u7684\u4e00\u534a\u7684\u7edd\u5bf9\u503c.",
      "figure_ids": []
    },
    {
      "number": "314",
      "text": "314.\n1) \u76f4\u89d2\u4e09\u89d2\u5f62\u7684\u76f4\u89d2\u8fb9\u7b49\u4e8e$a$\u548c$b$. \u70b9$M$\u4e0e\u4e09\u89d2\u5f62\u6240\u5728\u7684\u5e73\u9762\u7684\u8ddd\u79bb\u4e3a$h$\uff0c\u4e0e\u4e09\u89d2\u5f62\u5404\u4e2a\u9876\u70b9\u7684\u8ddd\u79bb\u90fd\u76f8\u540c.\u6c42\u8fd9\u4e2a\u8ddd\u79bb.\n2) \u70b9$M$\u548c\u4e09\u89d2\u5f62$ABC$\u5404\u4e2a\u9876\u70b9\u7684\u8ddd\u79bb\u90fd\u662f$l$. \u5982\u679c$|BC|=a$\uff0c$\\widehat{BAC}=\\alpha$\uff0c\u6c42\u70b9$M$\u5230\u4e09\u89d2\u5f62\u6240\u5728\u5e73\u9762\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "315",
      "text": "315. \u5df2\u77e5\uff1a\n1) \u76f4\u89d2\u4e09\u89d2\u5f62\uff1b\n2) \u7b49\u8170\u68af\u5f62\uff1b\n3) \u4e0d\u662f\u6b63\u65b9\u5f62\u7684\u83f1\u5f62. \u6c42\u548c\u4ee5\u4e0a\u56fe\u5f62\u7684\u9876\u70b9\u7b49\u8ddd\u7684\u70b9\u7684\u96c6\u5408.",
      "figure_ids": []
    },
    {
      "number": "316",
      "text": "316.\n1) \u8bc1\u660e\uff1a\u76f4\u7ebf\u548c\u5e73\u884c\u4e8e\u5b83\u7684\u5e73\u9762\u7684\u8ddd\u79bb\u7b49\u4e8e\u76f4\u7ebf\u4e0a\u4efb\u610f\u4e00\u70b9\u5230\u5e73\u9762\u7684\u8ddd\u79bb.\n2) \u4e00\u76f4\u7ebf\u548c\u4e00\u5e73\u9762\u76f8\u4ea4\uff0c\u5b83\u4eec\u4e4b\u95f4\u7684\u8ddd\u79bb\u7b49\u4e8e\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "317",
      "text": "317. \u7ebf\u6bb5$AB$\u7684\u957f\u4e3a$a$\uff0c\u5b83\u5e73\u884c\u4e8e\u5e73\u9762$\\alpha$\uff0c\u4e14\u4e0e\u5e73\u9762\u7684\u8ddd\u79bb\u4e3a$b$. \u659c\u7ebf$[AC]$\u548c$[BD]$(\u5176\u4e2d$\\{C,D\\}\\subset\\alpha$)\u90fd\u5782\u76f4\u4e8e$[AB]$.\u5982\u679c$|AC|=|BD|=C$\uff0c\u6c42$[CD]$.",
      "figure_ids": []
    },
    {
      "number": "318",
      "text": "318.\n1) \u8bc1\u660e\uff1a\u4e24\u4e2a\u5e73\u884c\u5e73\u9762\u4e4b\u95f4\u7684\u8ddd\u79bb\u7b49\u4e8e\u4e00\u4e2a\u5e73\u9762\u5185\u7684\u4efb\u610f\u4e00\u70b9\u5230\u53e6\u4e00\u4e2a\u5e73\u9762\u7684\u8ddd\u79bb.\n2\u00b0) \u4e24\u4e2a\u76f8\u4ea4\u5e73\u9762\u95f4\u7684\u8ddd\u79bb\u7b49\u4e8e\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "319",
      "text": "319\u00b0. \u6c42\u540c\u5df2\u77e5\u5e73\u9762$\\alpha$\u7684\u8ddd\u79bb\u4e3a$l$\u7684\u6240\u6709\u70b9\u7684\u96c6\u5408.",
      "figure_ids": []
    },
    {
      "number": "320",
      "text": "320\u00b0. \u6c42\u4e0e\u5df2\u77e5\u5e73\u9762\u7684\u8ddd\u79bb\n1) \u5c0f\u4e8e$l$\uff1b\n2) \u5927\u4e8e$l$\u7684\u6240\u6709\u70b9\u7684\u96c6\u5408.",
      "figure_ids": []
    },
    {
      "number": "321",
      "text": "321. \u6c42\u4e0e\u4e24\u4e2a\u4e0d\u540c\u7684\u5e73\u884c\u5e73\u9762\u8ddd\u79bb\u76f8\u540c\u7684\u6240\u6709\u70b9\u7684\u96c6\u5408.",
      "figure_ids": []
    },
    {
      "number": "322",
      "text": "322. \u5df2\u77e5\u4e24\u4e2a\u4e0d\u540c\u7684\u5e73\u884c\u5e73\u9762$\\alpha$\u548c$\\beta$. \u6307\u51fa\u5c06$\\alpha$\u6620\u5c04\u5230$\\beta$\u7684\u5bf9\u79f0\u8f74. \u6240\u6709\u8fd9\u6837\u7684\u8f74\u7684\u5e76\u96c6\u662f\u4ec0\u4e48\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "323",
      "text": "323. \u7ebf\u6bb5$AB$\u548c$CD$\u7684\u7aef\u70b9\u5c5e\u4e8e\u4e0d\u540c\u7684\u5e73\u884c\u5e73\u9762\uff0c\u5e76\u6295\u5f71\u5728\u4e24\u4e2a\u5e73\u9762\u4e2d\u7684\u4e00\u4e2a\u4e0a. \u5982\u679c\u5df2\u77e5\uff1a\n1) $|AB|:|CD|=10:17$\uff0c\u8fd9\u4e9b\u7ebf\u6bb5\u5c04\u5f71\u7684\u957f\u5206\u522b\u4e3a12cm\u548c3dm\uff1b\n2) $|AB|=a$\uff0c$|CD|=b$\uff0c\u4e14\u5b83\u4eec\u5c04\u5f71\u957f\u7684\u6bd4\u662f$m:n$\uff1b\n3) $|AB|=a$\uff0c$|CD|=b$\uff0c\u4e14\u5b83\u4eec\u5c04\u5f71\u957f\u7684\u548c\u7b49\u4e8e$c$. \u6c42\u5e73\u9762\u95f4\u7684\u8ddd\u79bb.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u5982\u679c\u4e24\u4e2a\u70b9\u5206\u522b\u5c5e\u4e8e\u56fe\u5f62$\\Phi_1$\u548c$\\Phi_2$\uff0c\u6240\u6709\u8fd9\u6837\u7684\u4e24\u4e2a\u70b9\u95f4\u7684\u8ddd\u79bb\u4e2d\u6700\u5c0f\u7684\u8ddd\u79bb\uff0c\u53eb\u505a**\u56fe\u5f62$\\Phi_1$\u548c$\\Phi_2$\u7684\u8ddd\u79bb**(\u56fe125)."
