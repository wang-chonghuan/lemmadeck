  "exercises": [
    {
      "number": "324",
      "text": "324. \u6307\u51fa\u957f\u65b9\u4f53$ABCDA_1B_1C_1D_1$\u4e2d\uff0c\u4e0b\u5217\u4e24\u76f4\u7ebf\u7684\u516c\u5782\u7ebf(\u56fe129)\uff1a\n1) $A_1D_1$\u548c$BB_1$\uff1b\n2) $DC$\u548c$B_1C_1$\uff1b\n3) $CC_1$\u548c$AB$.",
      "figure_ids": [
        "fig-129"
      ]
    },
    {
      "number": "325",
      "text": "325. \u4e24\u6761\u5f02\u9762\u76f4\u7ebf\u4e2d\u7684\u4e00\u6761\u5728\u5e73\u9762$\\alpha$\u5185\uff0c\u53e6\u4e00\u6761\u5782\u76f4\u4e8e$\\alpha$.\u5df2\u77e5\u76f4\u7ebf\u7684\u516c\u5782\u7ebf\u4e0e\u5e73\u9762$\\alpha$\u7684\u76f8\u5173\u4f4d\u7f6e\u5982\u4f55\uff1f",
      "figure_ids": []
    },
    {
      "number": "326",
      "text": "326.\n1) \u5728\u6b63\u65b9\u4f53$ABCDA_1B_1C_1D_1$\u7684\u56fe\u4e2d\u4f5c\u76f4\u7ebf$AA_1$\u548c$BD$\u7684\u516c\u5782\u7ebf.\n2) \u5982\u679c\u6b63\u65b9\u4f53\u7684\u68f1\u957f\u4e3a$a$\uff0c\u6c42\u8fd9\u4e24\u6761\u76f4\u7ebf\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "327",
      "text": "327.\n1) \u5df2\u77e5\u6b63\u65b9\u4f53$ABCDA_1B_1C_1D_1$\uff0c\u6c42\u4f5c\u76f4\u7ebf$A_1D$\u4e0e$BC_1$\u7684\u516c\u5782\u7ebf.\n2\u00b0) \u5982\u679c\u6b63\u65b9\u4f53\u7684\u4e00\u4e2a\u9762\u7684\u9762\u79ef\u7b49\u4e8e$2\\mathrm{cm}^2$\uff0c\u6c42\u8fd9\u4e24\u6761\u76f4\u7ebf\u95f4\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "328",
      "text": "328. \u56db\u9762\u4f53\u7684\u6bcf\u4e00\u6761\u68f1\u957f\u90fd\u7b49\u4e8e$a$. \u6c42$(AB)$\u4e0e$(CD)$\u95f4\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "329",
      "text": "329. \u901a\u8fc7\u4e24\u6761\u5f02\u9762\u76f4\u7ebf\u7684\u516c\u5782\u7ebf$[MN]$\u7684\u4e2d\u70b9\u4f5c\u5e73\u9762$\\gamma$\u5782\u76f4\u4e8e$(MN)$. \u8bc1\u660e\uff1a$\\gamma$\u5e73\u5206\u7aef\u70b9\u5206\u522b\u5c5e\u4e8e\u4e24\u6761\u5f02\u9762\u76f4\u7ebf\u7684\u7ebf\u6bb5.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 5,
      "text": "\u7aef\u70b9\u5728\u4e24\u6761\u5f02\u9762\u76f4\u7ebf\u4e0a\u5e76\u4e14\u5782\u76f4\u4e8e\u5b83\u4eec\u7684\u7ebf\u6bb5\uff0c\u53eb\u505a**\u5f02\u9762\u76f4\u7ebf\u7684\u516c\u5782\u7ebf**. \u6211\u4eec\u6765\u8bc1\u660e\u5f02\u9762\u76f4\u7ebf$a$\u548c$b$\u7684\u516c\u5782\u7ebf\u7684\u957f\u5ea6$|MN|$(\u56fe128)\u662f\u8fd9\u4e24\u6761\u76f4\u7ebf\u95f4\u7684\u8ddd\u79bb. \u53ea\u8981\u8bc1\u660e$|MN|<|CD|$\uff0c\u5176\u4e2d$[CD]$\u662f\u7aef\u70b9\u5206\u522b\u5728\u4e24\u6761\u5df2\u77e5\u76f4\u7ebf\u4e0a\u7684\u5176\u5b83\u7684\u7ebf\u6bb5."
    }
