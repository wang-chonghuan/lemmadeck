  "exercises": [
    {
      "number": "252",
      "text": "\u4e60\u3000\u9898\n252. \u8bc1\u660e\uff1a\u4e24\u4e2a\u7403\u4f53\u7684\u4f53\u79ef\u4e4b\u6bd4\uff0c\u7b49\u4e8e\u5b83\u4eec\u7684\u534a\u5f84\uff08\u6216\u76f4\u5f84\uff09\u7684\u7acb\u65b9\u6bd4\u3002",
      "figure_ids": []
    },
    {
      "number": "253",
      "text": "\u4e60\u3000\u9898\n253.\n1) \u5730\u7403\u7684\u4f53\u79ef\u662f\u6708\u7403\u4f53\u79ef\u7684\u591a\u5c11\u500d\uff1f\u5730\u7403\u7684\u76f4\u5f84\u901a\u5e38\u53d61\u4e073\u5343\u516c\u91cc\uff0c\u6708\u7403\u7684\u76f4\u5f84\u53d63.5\u5343\u516c\u91cc\u3002\n2) \u4e3a\u4e86\u4f7f\u7403\u7684\u4f53\u79ef\u589e\u5927\u4e24\u500d\uff0c\u7403\u9762\u7684\u76f4\u5f84\u5fc5\u987b\u589e\u5927\u591a\u5c11\u500d\uff1f",
      "figure_ids": []
    },
    {
      "number": "254",
      "text": "\u4e60\u3000\u9898\n254. \u7528\u8fd1\u4f3c\u516c\u5f0f $V=\\frac{1}{2}d^3$ \u8ba1\u7b97\u7403\u4f53\u7684\u4f53\u79ef\u3002\n\u8ba1\u7b97\u7ed3\u679c\u6bd4\u5b9e\u9645\u4f53\u79ef\u5c0f\uff0c\u8fd8\u662f\u6bd4\u5b9e\u9645\u4f53\u79ef\u5927\uff1f\u6c42\u7528\u8fd9\u4e2a\u516c\u5f0f\u8ba1\u7b97\u65f6\u7684\u76f8\u5bf9\u8bef\u5dee\u3002",
      "figure_ids": []
    },
    {
      "number": "255",
      "text": "\u4e60\u3000\u9898\n255. \u4e00\u4e2a\u94c1\u7403\u7684\u8d28\u91cf\u4e3a400kg\u3002\n\u6c42\u5b83\u7684\u76f4\u5f84\u3002",
      "figure_ids": []
    },
    {
      "number": "256",
      "text": "\u4e60\u3000\u9898\n256. \u4e00\u4e2a\u8f6f\u6728\u7403\u7684\u76f4\u5f84\u4e3a2m\uff0c\u6c42\u5b83\u7684\u8d28\u91cf\u3002\n\u8f6f\u6728\u7684\u5bc6\u5ea6\u4e3a$0.25\\mathrm{g}/\\mathrm{cm}^3$\u3002",
      "figure_ids": []
    },
    {
      "number": "257",
      "text": "\u4e60\u3000\u9898\n257. \u5728\u7a7a\u95f4\u5750\u6807\u7cfb\u4e2d\uff0c\u4e00\u4e2a\u56fe\u5f62\u7531\u4e0d\u7b49\u5f0f $x^2+y^2+z^2\\leqslant R^2$ \u7ed9\u51fa\u3002\n\u6c42\u8fd9\u4e2a\u56fe\u5f62\u7684\u4f53\u79ef\u3002",
      "figure_ids": []
    },
    {
      "number": "258",
      "text": "\u4e60\u3000\u9898\n258. \u7403\u9762 $x^2+y^2+z^2=R^2$ \u56f4\u6210\u4e00\u4e2a\u7403\u3002\n\u4ee5\u70b9$O$\u4e3a\u4f4d\u4f3c\u4e2d\u5fc3\u3001\u4ee5 $k$ \u4e3a\u4f4d\u4f3c\u6bd4\u8fdb\u884c\u4f4d\u4f3c\u53d8\u6362\uff0c\u6240\u5f97\u7684\u50cf\u4e5f\u662f\u4e00\u4e2a\u7403\u3002\n\u6c42\u8fd9\u4e2a\u50cf\u7684\u4f53\u79ef\u3002",
      "figure_ids": []
    },
    {
      "number": "259",
      "text": "\u4e60\u3000\u9898\n259. \u4e00\u4e2a\u6b63\u65b9\u4f53\u7684\u6240\u6709\u9876\u70b9\u90fd\u5728\u540c\u4e00\u4e2a\u7403\u9762\u4e0a\uff0c\u68f1\u957f\u4e3a $a$\u3002\n\u6c42\u8fd9\u4e2a\u7403\u9762\u56f4\u6210\u7684\u7403\u4f53\u7684\u4f53\u79ef\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5b9a\u7406 40\u3002\n\u534a\u5f84\u4e3a$R$\u7684\u7403\u4f53\uff0c\u5176\u4f53\u79ef\u4e3a\uff1a\n$V=\\frac{4}{3}\\pi R^3$\u3002"
