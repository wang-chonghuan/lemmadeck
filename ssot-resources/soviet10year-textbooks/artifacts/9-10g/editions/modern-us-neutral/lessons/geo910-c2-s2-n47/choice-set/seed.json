  "exercises": [
    {
      "number": "49",
      "text": "\u4e60\u9898\n49\u00b0. \u8bf4\u51fa\u9762\u6570\u6700\u5c11\u7684\u591a\u9762\u4f53\u7684\u540d\u79f0\u3002\n\u5b83\u6709\u591a\u5c11\u68f1\u3001\u9876\u70b9\u548c\u5bf9\u89d2\u7ebf\uff1f",
      "figure_ids": []
    },
    {
      "number": "50",
      "text": "\u4e60\u9898\n50. \u4e94\u9762\u4f53\u7684\u9762\u80fd\u5426\u662f\uff1a\n1) \u56db\u8fb9\u5f62\uff1b\n2) \u4e94\u8fb9\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "51",
      "text": "\u4e60\u9898\n51. \u591a\u9762\u4f53\u7684\u4e00\u4e2a\u9762\u662f\u516d\u8fb9\u5f62\u3002\n\u8fd9\u4e2a\u591a\u9762\u4f53\u6700\u5c11\u6709\u51e0\u6761\u68f1\uff1f",
      "figure_ids": []
    },
    {
      "number": "52",
      "text": "\u4e60\u9898\n52. \u4f5c\u4e00\u4e2a\u591a\u9762\u4f53\uff0c\u4f7f\u5b83\u6709\uff1a\n1) 8\u6761\u68f1\uff1b\n2) 9\u6761\u68f1\u3002",
      "figure_ids": []
    },
    {
      "number": "53",
      "text": "\u4e60\u9898\n53. \u5224\u65ad\u4e0b\u9762\u7684\u547d\u9898\u662f\u5426\u6b63\u786e\uff1a\n1) \u5982\u679c\u4e24\u4e2a\u51f8\u591a\u9762\u4f53\u7684\u4ea4\u96c6\u662f\u591a\u9762\u4f53\uff0c\u90a3\u4e48\u8fd9\u4e2a\u591a\u9762\u4f53\u662f\u51f8\u7684\uff1b\n2) \u5982\u679c\u4e24\u4e2a\u51f8\u591a\u9762\u4f53\u7684\u5e76\u96c6\u662f\u591a\u9762\u4f53\uff0c\u90a3\u4e48\u5b83\u662f\u51f8\u7684\u3002",
      "figure_ids": []
    },
    {
      "number": "54",
      "text": "\u4e60\u9898\n54. \u591a\u9762\u4f53$ABCDFE$\uff08\u56fe22\uff09\u7684\u9762$ABCD$\u662f\u8fb9\u957f\u4e3a$a$\u7684\u6b63\u65b9\u5f62\uff1b\u9762$ABEF$\u662f\u68af\u5f62\uff0c$|BE|=|EF|=|FA|=\\frac{a}{2}$\uff1b$(ABE)$ $\\perp(ABC)$\u3002\u6c42\uff1a\n1) \u68f1$AF$\u5bf9\u5e73\u9762$ABC$\u7684\u503e\u659c\u89d2\uff1b\n2) \u5e73\u9762$ABC$\u548c$CDF$\u6240\u6210\u7684\u89d2\uff1b\n3) \u5c55\u5f00\u56fe\u7684\u9762\u79ef\u3002",
      "figure_ids": [
        "fig-g10-22"
      ]
    }
  ],
  "concepts": [
    {
      "block": 5,
      "text": "\u6ee1\u8db3\u4e0b\u5217\u6761\u4ef6\u7684\u6709\u9650\u4e2a\u591a\u8fb9\u5f62\u7ec4\u6210\u7684\u56fe\u5f62\uff0c\u53eb\u505a\u7b80\u5355\u591a\u9762\u5f62\uff1a"
    },
    {
      "block": 6,
      "text": "1) \u5bf9\u4e8e\u8fd9\u4e9b\u591a\u8fb9\u5f62\u4e0a\u7684\u4efb\u610f\u4e24\u4e2a\u9876\u70b9\uff0c\u5b58\u5728\u4ee5\u8fd9\u4e24\u4e2a\u9876\u70b9\u4e3a\u7aef\u70b9\uff0c\u7531\u591a\u8fb9\u5f62\u7684\u8fb9\u6240\u6784\u6210\u7684\u4e00\u6761\u6298\u7ebf\uff1b"
    },
    {
      "block": 7,
      "text": "2) \u8fd9\u4e9b\u591a\u8fb9\u5f62\u4e0a\u7684\u4efb\u610f\u4e00\u70b9\uff0c\u6216\u8005\u4ec5\u5c5e\u4e8e\u67d0\u4e2a\u591a\u8fb9\u5f62\uff0c\u6216\u8005\u5c5e\u4e8e\u4e24\u4e2a\u591a\u8fb9\u5f62\u7684\u516c\u5171\u8fb9\uff0c\u6216\u8005\u662f\u7531\u51e0\u4e2a\u591a\u8fb9\u5f62\u7684\u5185\u89d2\u7ec4\u6210\u7684\u591a\u9762\u89d2\u7684\u9876\u70b9\u3002"
    },
    {
      "block": 11,
      "text": "\u4eca\u540e\uff0c\u5728\u8bb2\u5230\u7b80\u5355\u591a\u9762\u5f62\u65f6\uff0c\u4e3a\u4e86\u7b80\u4fbf\u8d77\u89c1\uff0c\u6211\u4eec\u5e38\u5e38\u7701\u53bb\u201c\u7b80\u5355\u201d\u4e00\u8bcd\u3002"
    },
    {
      "block": 12,
      "text": "\u6784\u6210\u591a\u9762\u5f62\u7684\u5404\u4e2a\u591a\u8fb9\u5f62\u53eb\u505a\u591a\u9762\u5f62\u7684\u9762\uff1b\n\u591a\u8fb9\u5f62\u7684\u8fb9\u53eb\u505a\u591a\u9762\u5f62\u7684\u68f1\uff0c\u591a\u8fb9\u5f62\u7684\u9876\u70b9\u53eb\u505a\u591a\u9762\u5f62\u7684\u9876\u70b9\u3002"
    },
    {
      "block": 13,
      "text": "\u5982\u679c\u591a\u9762\u5f62\u7684\u6bcf\u4e00\u6761\u68f1\u5206\u5c5e\u4e8e\u591a\u9762\u5f62\u7684\u4e24\u4e2a\u9762\uff0c\u90a3\u4e48\u8fd9\u4e2a\u591a\u9762\u5f62\u53eb\u505a\u5c01\u95ed\u7684\u3002\n\u68f1\u9525\u7684\u8868\u9762\uff08\u56fe17\uff09\u5c31\u662f\u5c01\u95ed\u7684\u591a\u9762\u5f62\u7684\u4f8b\u5b50\u3002\n\u68f1\u67f1\u7684\u4fa7\u9762\uff08\u56fe16\uff09\u662f\u975e\u5c01\u95ed\u591a\u9762\u5f62\u7684\u4f8b\u5b50\u3002"
    },
    {
      "block": 14,
      "text": "\u5c01\u95ed\u7684\u591a\u9762\u5f62\u628a\u7a7a\u95f4\u4e0d\u5c5e\u4e8e\u5b83\u7684\u6240\u6709\u70b9\u7684\u96c6\u5408\u5206\u6210\u4e24\u4e2a\u5b50\u96c6\u3002\n\u5728\u5176\u4e2d\u4e00\u4e2a\u5b50\u96c6\u91cc\uff0c\u5b58\u5728\u5305\u542b\u5728\u8fd9\u4e2a\u5b50\u96c6\u91cc\u7684\u76f4\u7ebf\uff1b\n\u800c\u5728\u53e6\u4e00\u4e2a\u5b50\u96c6\u91cc\uff0c\u5219\u4e0d\u5b58\u5728\u8fd9\u6837\u7684\u76f4\u7ebf\u3002\n\n\u524d\u4e00\u4e2a\u5b50\u96c6\u53eb\u505a\u5c01\u95ed\u591a\u9762\u5f62\u7684\u5916\u90e8\uff0c\u800c\u540e\u4e00\u4e2a\u5b50\u96c6\u53eb\u505a\u5b83\u7684\u5185\u90e8\u3002"
    },
    {
      "block": 15,
      "text": "**\u5b9a\u4e49. \u5c01\u95ed\u7684\u591a\u9762\u5f62\u4ee5\u53ca\u5b83\u7684\u5185\u90e8\u7684\u5e76\u96c6\u53eb\u505a\u591a\u9762\u4f53.**"
    },
    {
      "block": 16,
      "text": "\u8fd9\u65f6\uff0c\u591a\u9762\u5f62\u548c\u5b83\u7684\u5185\u90e8\u5206\u522b\u53eb\u505a\u591a\u9762\u4f53\u7684\u8868\u9762\u548c\u5b83\u7684\u5185\u90e8\u3002\n\u591a\u9762\u5f62\u8868\u9762\u7684\u5404\u4e2a\u9762\u3001\u68f1\u548c\u9876\u70b9\u5206\u522b\u53eb\u505a\u591a\u9762\u4f53\u7684\u9762\u3001\u68f1\u548c\u9876\u70b9\u3002"
    },
    {
      "block": 17,
      "text": "\u8fde\u7ed3\u591a\u9762\u4f53\u4e0d\u5728\u540c\u4e00\u4e2a\u9762\u4e0a\u7684\u4e24\u4e2a\u9876\u70b9\u7684\u7ebf\u6bb5\uff0c\u53eb\u505a\u591a\u9762\u4f53\u7684\u5bf9\u89d2\u7ebf\u3002\n\u56fe19\u8868\u793a\u7684\u662f\u516d\u9762\u4f53$ABCDEF$\u548c\u5b83\u7684\u5bf9\u89d2\u7ebf$BF$\u3002"
    },
    {
      "block": 18,
      "text": "\u540c\u591a\u8fb9\u5f62\u4e00\u6837\uff0c\u591a\u9762\u4f53\u53ef\u4ee5\u5206\u4e3a\u51f8\u591a\u9762\u4f53\uff08\u56fe19\uff09\u548c\u975e\u51f8\u591a\u9762\u4f53\uff08\u56fe20\uff09\u3002\n\u4ee5\u540e\u6211\u4eec\u53ea\u7814\u7a76\u51f8\u591a\u9762\u4f53\u3002"
    },
    {
      "block": 23,
      "text": "\u5982\u679c\u591a\u9762\u4f53\u7684\u8868\u9762\u662f\u7528\u67d4\u8f6f\u4f46\u65e0\u5f39\u6027\u7684\u6750\u6599\uff08\u7eb8\u3001\u8584\u7684\u786c\u7eb8\u677f\u7b49\u7b49\uff09\u5236\u9020\u7684\uff0c\u90a3\u4e48\u8fd9\u4e2a\u6a21\u578b\u53ef\u4ee5\u6cbf\u7740\u51e0\u6761\u68f1\u526a\u5f00\uff0c\u5e76\u5c55\u5f00\u6210\u4e3a\u67d0\u4e2a\u591a\u8fb9\u5f62\u3002\n\u8fd9\u4e2a\u591a\u8fb9\u5f62\u53eb\u505a\u591a\u9762\u4f53\u8868\u9762\u7684\u5c55\u5f00\u56fe\u3002"
    }
  ],
