      "sha256": "8b1e49d641ff926c1a19d259d4294e44aca181fc9e7772ffa0533c08cacd1fa0"
    },
    "authoritativeText": [
      {"lesson": "geo910-c2-s1-n43", "text": "问题2。求两个非零向量 $\\vec a=(x_1,y_1,z_1)$ 和 $\\vec b=(x_2,y_2,z_2)$ 的夹角 $\\varphi$（图4）。"},
      {"lesson": "geo910-c2-s1-n43", "text": "解。从两个向量的数性积的定义得到，\n$\\cos\\varphi=\\frac{\\vec a\\cdot\\vec b}{|\\vec a|\\cdot|\\vec b|}$。"},
      {"lesson": "geo910-c2-s1-n43", "text": "但是 $\\vec a\\cdot\\vec b=x_1x_2+y_1y_2+z_1z_2$（§42）；\n$|\\vec a|=\\sqrt{x_1^2+y_1^2+z_1^2}$，\n$|\\vec b|=\\sqrt{x_2^2+y_2^2+z_2^2}$（问题1）。于是"},
      {"lesson": "geo910-c2-s1-n43", "text": "$\\cos\\varphi=\\frac{x_1x_2+y_1y_2+z_1z_2}{\\sqrt{x_1^2+y_1^2+z_1^2}\\cdot\\sqrt{x_2^2+y_2^2+z_2^2}}$。"}
    ],
    "inventory": [
      {
        "id": "s04-shared-frame",
        "description": "SOURCE: One unmarked common tail; solid outward i,j,k,a,b arrows and overhead-vector labels. i is down-left, j right, k up, a steep upper-right, b shallow upper-right. MODERN: Hidden labelled tip anchors; screen displacements are layout facts only, not three-dimensional metrics.",
        "objects": ["i-tip", "j-tip", "k-tip", "a-tip", "b-tip", "i-vector", "j-vector", "k-vector", "a-vector", "b-vector"],
        "assertions": ["connect-i", "connect-j", "connect-k", "connect-a", "connect-b", "projection-i-j", "projection-j-k", "projection-k-a", "projection-a-b", "five-vectors"],
        "requires": ["pointRelationships"]
      },
      {
        "id": "s04-phi",
        "description": "SOURCE: One thin solid unarrowed angle trace between a and b, labelled varphi. MODERN: Native circular schematic glyph separated from text; endpoints remain on b and a rays. It does not claim a numerical or measurable spatial angle.",
        "objects": ["a-tip", "b-tip", "phi-arc", "phi-label"],
        "assertions": ["projection-a-b", "phi-start-ray", "phi-end-ray", "one-angle-arc"],
        "requires": ["pointRelationships"]
      }
    ]
  },
