        "p0021#4"
      ]
    },
    {
      "kind": "fig",
      "text": "",
      "id": "fig-13",
      "label": "图 13",
      "printed_page": 14,
      "source_refs": [
        "p0021#5"
      ]
    },
    {
      "kind": "cap",
      "text": "图 12",
      "id": null,
      "label": "图 12",
      "printed_page": 14,
      "source_refs": [
        "p0021#6"
      ]
    },
    {
      "kind": "cap",
      "text": "图 13",
      "id": null,
      "label": "图 13",
      "printed_page": 14,
