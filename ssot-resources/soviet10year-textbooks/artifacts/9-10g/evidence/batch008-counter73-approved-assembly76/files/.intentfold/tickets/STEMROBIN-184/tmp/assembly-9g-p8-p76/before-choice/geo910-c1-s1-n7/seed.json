  "exercises": [
    {
      "number": "44",
      "text": "$44^{\\circ}$. \u5b9a\u74062\u7ed9\u51fa\u7684\u76f4\u7ebf\u4e0e\u5e73\u9762\u5e73\u884c\u7684\u6761\u4ef6\uff0c\u53ea\u662f\u5145\u5206\u6761\u4ef6\uff0c\u8fd8\u662f\u540c\u65f6\u4e5f\u662f\u5fc5\u8981\u6761\u4ef6\uff1f",
      "figure_ids": []
    },
    {
      "number": "45",
      "text": "$45^{\\circ}$. \u76f4\u7ebf\u4e0e\u5e73\u9762 $\\alpha$ \u548c $\\beta$ \u7684\u4ea4\u7ebf\u5e73\u884c\u3002\n$a$ \u4e0e $\\alpha$\u3001$a$ \u4e0e $\\beta$ \u5206\u522b\u53ef\u80fd\u6709\u54ea\u4e9b\u4f4d\u7f6e\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "46",
      "text": "$46^{\\circ}$. \u4e09\u89d2\u5f62 $ABC$ \u7684\u8fb9 $AB$ \u5728\u5e73\u9762 $\\alpha$ \u5185\u3002\n\u7ecf\u8fc7\u8fb9 $AC$ \u4e0e $BC$ \u7684\u4e2d\u70b9\u7684\u76f4\u7ebf $MN$\uff0c\u4e0e\u8fd9\u4e2a\u5e73\u9762\u53ef\u80fd\u6709\u54ea\u4e9b\u4f4d\u7f6e\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "47",
      "text": "$47^{\\circ}$. \u7ecf\u8fc7\u6b63\u516d\u8fb9\u5f62 $ABCDEF$ \u7684\u8fb9 $AB$ \u4f5c\u5e73\u9762 $\\alpha$\u3002\u4e0b\u5217\u5404\u6761\u76f4\u7ebf\u4e0e\u8fd9\u4e2a\u5e73\u9762\u53ef\u80fd\u6709\u54ea\u4e9b\u4f4d\u7f6e\u5173\u7cfb\uff1f\n1) $CF$\uff1b\n2) $CD$\uff1b\n3) $DF$\uff1b\n4) $DE$\u3002",
      "figure_ids": []
    },
    {
      "number": "48",
      "text": "$48^{\\circ}$. \u5df2\u77e5\u4e00\u6761\u76f4\u7ebf\u5e73\u884c\u4e8e\u4e00\u4e2a\u5e73\u9762\u3002\n1) \u5b83\u5e73\u884c\u4e8e\u5e73\u9762\u5185\u4efb\u610f\u4e00\u6761\u76f4\u7ebf\u5417\uff1f\n2) \u5b83\u53ef\u80fd\u4e0e\u8fd9\u4e9b\u76f4\u7ebf\u4e2d\u7684\u4e00\u6761\u76f8\u4ea4\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "49",
      "text": "49.\n1) \u7ecf\u8fc7\u4e00\u4e2a\u5df2\u77e5\u70b9\uff0c\u4f5c\u4e0e\u5df2\u77e5\u76f4\u7ebf\u5e73\u884c\u7684\u5e73\u9762\uff1b\n2) \u7ecf\u8fc7\u5df2\u77e5\u70b9\uff0c\u4f5c\u4e0e\u5df2\u77e5\u5e73\u9762\u5e73\u884c\u7684\u76f4\u7ebf\u3002",
      "figure_ids": []
    },
    {
      "number": "50",
      "text": "50. \u76f4\u7ebf $a$ \u4e0e $b$ \u5e73\u884c\u3002\n\u7ecf\u8fc7\u76f4\u7ebf $a$\uff0c\u4f5c\u4e0e\u76f4\u7ebf $b$ \u5e73\u884c\u7684\u5e73\u9762\u3002",
      "figure_ids": []
    },
    {
      "number": "51",
      "text": "51. \u70b9 $A$ \u548c $B$ \u5206\u522b\u5c5e\u4e8e\u76f8\u4ea4\u7684\u5e73\u9762 $\\alpha$ \u548c $\\beta$\uff0c\u4f46\u90fd\u4e0d\u5c5e\u4e8e\u5b83\u4eec\u7684\u4ea4\u7ebf $C$\u3002\n\u7ecf\u8fc7 $A$ \u548c $B$\uff0c\u4f5c\u4e0e $C$ \u5e73\u884c\u7684\u5e73\u9762\u3002",
      "figure_ids": []
    },
    {
      "number": "52",
      "text": "$52^{\\circ}$. \u5df2\u77e5 $a\\cap\\alpha=M$\uff0c$b\\mathbin{//}\\alpha$\u3002\n\u76f4\u7ebf $a$ \u4e0e $b$ \u53ef\u80fd\u6709\u54ea\u4e9b\u4f4d\u7f6e\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "54",
      "text": "54.\n1) \u4f5c\u51fa\u56db\u9762\u4f53 $ABCD$ \u7684\u622a\u9762\uff0c\u4f7f\u622a\u5e73\u9762\u5305\u542b\u9762 $ABC$ \u7684\u4e2d\u7ebf $CM$\uff0c\u4e14\u5e73\u884c\u4e8e\u76f4\u7ebf $AD$\uff1b\n2) \u5982\u679c\u56db\u9762\u4f53\u7684\u6bcf\u6761\u68f1\u7684\u957f\u5ea6\u90fd\u7b49\u4e8e $a$\uff0c\u6c42\u622a\u9762\u7684\u9762\u79ef\u3002",
      "figure_ids": []
    },
    {
      "number": "55",
      "text": "55. \u5df2\u77e5\u56db\u9762\u4f53 $ABCD$\u3002\n\u4f5c\u51fa\u5e73\u9762 $ABC$ \u4e0e\u7ecf\u8fc7 $(AD)$ \u4e14\u5e73\u884c\u4e8e $(BC)$ \u7684\u5e73\u9762\u7684\u4ea4\u7ebf\u3002",
      "figure_ids": []
    },
    {
      "number": "56",
      "text": "56. \u4f5c\u51fa\u56db\u9762\u4f53\u7684\u622a\u9762\uff0c\u4f7f\u622a\u5e73\u9762\u7ecf\u8fc7\u68f1 $AD$ \u548c $CD$ \u7684\u4e2d\u70b9\uff0c\u4ee5\u53ca\u68f1 $BC$ \u7684\u5185\u70b9 $P$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5df2\u7ecf\u77e5\u9053\u76f4\u7ebf\u4e0e\u5e73\u9762\u7684\u4f4d\u7f6e\u5173\u7cfb\u6709\u4ee5\u4e0b\u4e24\u79cd\u60c5\u51b5\uff1a\n1) \u5982\u679c\u76f4\u7ebf\u4e0a\u7684\u4e24\u4e2a\u4e0d\u540c\u70b9\u5728\u5e73\u9762\u5185\uff0c\u90a3\u4e48\u8fd9\u6761\u76f4\u7ebf\u5c31\u5728\u5e73\u9762\u5185\uff08\u00a7 2\uff0c\u516c\u74063\uff09\uff1b\n2) \u5982\u679c\u76f4\u7ebf\u4e0e\u5e73\u9762\u6709\u552f\u4e00\u7684\u516c\u5171\u70b9\uff0c\u90a3\u4e48\u5b83\u4eec\u76f8\u4ea4\uff08\u00a7 2\uff09\u3002"
    },
    {
      "block": 9,
      "text": "\u56e0\u6b64\uff0c\u53ea\u6709\u4ee5\u4e0b\u4e09\u79cd\u53ef\u80fd\u7684\u60c5\u5f62\uff1a\n1) $a\\subset\\alpha$\uff1b\n2) $a\\cap\\alpha=A$\uff1b\n\n3) $a\\cap\\alpha=\\varnothing$\u3002\n\u4e0e\u7814\u7a76\u4e24\u6761\u76f4\u7ebf\u7684\u4f4d\u7f6e\u5173\u7cfb\u65f6\u4e00\u6837\uff0c\u628a\u7b2c\u4e00\u79cd\u548c\u7b2c\u4e09\u79cd\u60c5\u5f62\u5408\u5e76\u4e3a\u4e00\u79cd\u60c5\u5f62\u3002"
    },
    {
      "block": 10,
      "text": "\u5b9a\u4e49\uff1a\u5982\u679c\u76f4\u7ebf\u4e0e\u5e73\u9762\u6ca1\u6709\u516c\u5171\u70b9\uff0c\u6216\u8005\u76f4\u7ebf\u5728\u5e73\u9762\u5185\uff0c\u5c31\u79f0\u8fd9\u6761\u76f4\u7ebf\u4e0e\u8be5\u5e73\u9762\u5e73\u884c\u3002"
    },
    {
      "block": 11,
      "text": "\u76f4\u7ebf\u4e0e\u5e73\u9762\u5e73\u884c\uff0c\u8bb0\u4f5c\uff1a\n$a\\mathbin{//}\\alpha$ \u6216 $\\alpha\\mathbin{//}a$\u3002"
    },
    {
      "block": 13,
      "text": "\u5b9a\u74062\uff1a\u5982\u679c\u4e00\u6761\u76f4\u7ebf\u5e73\u884c\u4e8e\u5e73\u9762\u5185\u4efb\u610f\u4e00\u6761\u76f4\u7ebf\uff0c\u90a3\u4e48\u8fd9\u6761\u5df2\u77e5\u76f4\u7ebf\u4e0e\u8be5\u5e73\u9762\u5e73\u884c\u3002"
    },
    {
      "block": 17,
      "text": "\u5b9a\u74063\uff08\u9006\u5b9a\u7406\uff09\uff1a\u5982\u679c\u4e00\u4e2a\u5e73\u9762\u7ecf\u8fc7\u4e00\u6761\u4e0e\u53e6\u4e00\u4e2a\u5e73\u9762\u5e73\u884c\u7684\u76f4\u7ebf\uff0c\u5e76\u4e14\u4e0e\u8fd9\u4e2a\u5e73\u9762\u76f8\u4ea4\uff0c\u90a3\u4e48\u4e24\u4e2a\u5e73\u9762\u7684\u4ea4\u7ebf\u548c\u5df2\u77e5\u76f4\u7ebf\u5e73\u884c\u3002"
    }
  ],
