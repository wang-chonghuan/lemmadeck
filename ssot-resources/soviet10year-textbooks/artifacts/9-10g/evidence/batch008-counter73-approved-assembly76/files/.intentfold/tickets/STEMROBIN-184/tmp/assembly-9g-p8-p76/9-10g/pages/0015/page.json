      "cont": false,
      "open": false,
      "samerow": false,
      "lines": [
        "14．已知：$\\alpha\\cap\\beta=m$，$a\\subset\\alpha$，$b\\subset\\beta$，$a\\cap b=A$．证明：",
        "$A\\in m$．"
      ]
    },
