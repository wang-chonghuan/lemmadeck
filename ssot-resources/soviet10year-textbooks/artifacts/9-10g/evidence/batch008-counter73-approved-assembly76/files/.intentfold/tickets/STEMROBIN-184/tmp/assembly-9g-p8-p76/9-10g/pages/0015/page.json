      "samerow": false,
      "lines": [
        "13$^{*}$．已知：$a\\cap b=C$，$b\\cap c=A$，$c\\cap a=B$，$A\\ne B$，$A_1\\in a$，",
        "$B_1\\in b$，$C_1\\in(A_1B_1)$．证明：$C_1\\in(ABC)$．"
      ]
    },
