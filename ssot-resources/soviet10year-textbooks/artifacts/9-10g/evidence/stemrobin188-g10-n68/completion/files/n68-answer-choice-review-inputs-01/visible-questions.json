    {
      "id": "q-homothety-volume",
      "source_numbers": [
        "258"
      ],
      "view": {
        "mode": "single",
        "stem": "球面 $x^2+y^2+z^2=R^2$ 围成一个球，其中 $R>0$。以任意给定点 $O$ 为位似中心、以非零实数 $k$ 为位似比进行位似变换，$k$ 可以为负。以下哪一项对所有这样的 $k$ 都给出了像球的正确半径 $r$ 和体积 $V$？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$r=|k|R$，$V=\\dfrac43\\pi k^3R^3$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$r=|k|R$，$V=\\dfrac43\\pi k^2R^3$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$r=|k|R$，$V=\\dfrac43\\pi|k|^3R^3$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$r=|k|^3R$，$V=\\dfrac43\\pi|k|^9R^3$。",
            "figure_ids": []
          }
        ]
      }
    },
