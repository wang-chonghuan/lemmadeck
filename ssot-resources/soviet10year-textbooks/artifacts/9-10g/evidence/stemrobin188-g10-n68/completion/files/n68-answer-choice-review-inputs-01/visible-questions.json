  "questions": [
    {
      "id": "q-volume-ratio",
      "source_numbers": [
        "252"
      ],
      "view": {
        "mode": "single",
        "stem": "两个球体的半径分别为 $R_1,R_2>0$，直径分别为 $d_1,d_2$，体积分别为 $V_1,V_2$。以下哪一个关系对任意这样的两个球体都成立？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$\\dfrac{V_1}{V_2}=\\dfrac{R_1}{R_2}=\\dfrac{d_1}{d_2}$",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$\\dfrac{V_1}{V_2}=\\left(\\dfrac{R_1}{R_2}\\right)^2=\\left(\\dfrac{d_1}{d_2}\\right)^2$",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$\\dfrac{V_1}{V_2}=\\left(\\dfrac{R_1}{R_2}\\right)^3=\\left(\\dfrac{d_1}{d_2}\\right)^3$",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$\\dfrac{V_1}{V_2}=\\left(\\dfrac{R_1}{R_2}\\right)^3=\\left(\\dfrac{d_2}{d_1}\\right)^3$",
            "figure_ids": []
          }
        ]
      }
    },
