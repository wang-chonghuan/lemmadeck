  "exercises": [
    {
      "number": "1",
      "text": "$1^{\\circ}$*. \u8bf4\u51fa\u5e73\u9762\u51e0\u4f55\u8bfe\u7a0b\u7684\u57fa\u672c\u6982\u5ff5.",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "$2^{\\circ}$. \u6307\u51fa\u4e0b\u5217\u6570\u5b66\u547d\u9898\u5728\u5e73\u9762\u51e0\u4f55\u8bfe\u7a0b\u4e2d\u5c5e\u4e8e\u516c\u7406\u3001\u5b9a\u7406\u8fd8\u662f\u5b9a\u4e49\uff1a\n1) \u8fc7\u5df2\u77e5\u70b9\u5411\u5df2\u77e5\u76f4\u7ebf\u53ef\u4ee5\u4e14\u53ea\u53ef\u4ee5\u4f5c\u4e00\u6761\u5782\u7ebf.\n2) \u4ece $A$ \u5230 $B$ \u7684\u8ddd\u79bb\u7b49\u4e8e\u4ece $B$ \u5230 $A$ \u7684\u8ddd\u79bb.\n3) \u6298\u7ebf\u7684\u957f\u5ea6\u5927\u4e8e\u5b83\u7684\u7aef\u70b9\u4e4b\u95f4\u7684\u8ddd\u79bb.\n4) \u4e24\u4e2a\u56fe\u5f62\u7684\u4ea4\u96c6\u662f\u7531\u540c\u65f6\u5c5e\u4e8e\u8fd9\u4e24\u4e2a\u56fe\u5f62\u7684\u6240\u6709\u70b9\u6784\u6210\u7684\u56fe\u5f62.\n5) \u4f4d\u79fb\u662f\u5e73\u9762\u5230\u5b83\u81ea\u8eab\u7684\u4fdd\u8ddd\u6620\u5c04.\n6) \u8fc7\u4efb\u610f\u4e00\u70b9\uff0c\u53ef\u4ee5\u4f5c\u4e00\u6761\u4e0e\u5df2\u77e5\u76f4\u7ebf\u5e73\u884c\u7684\u76f4\u7ebf.\n7) \u5e73\u79fb\u662f\u4f4d\u79fb.\n8) \u901a\u8fc7\u4e0d\u5728\u540c\u4e00\u76f4\u7ebf\u4e0a\u7684\u4e09\u4e2a\u70b9\uff0c\u53ef\u4ee5\u4f5c\u4e00\u4e2a\u4e14\u53ea\u80fd\u4f5c\u4e00\u4e2a\u5706\u5468.\n9) \u5168\u7b49\u7684\u591a\u8fb9\u5f62\u9762\u79ef\u76f8\u7b49.\n10) \u4ee5 $O$ \u4e3a\u4e2d\u5fc3\u65cb\u8f6c $180^{\\circ}$ \u7684\u53d8\u6362\uff0c\u662f\u4ee5 $O$ \u4e3a\u4e2d\u5fc3\u7684\u4e2d\u5fc3\u5bf9\u79f0.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 4,
      "text": "1. \u5217\u51fa\u4e0d\u52a0\u5b9a\u4e49\u7684\u57fa\u672c\u6982\u5ff5.\n2. \u5efa\u7acb\u53cd\u6620\u8fd9\u4e9b\u57fa\u672c\u6982\u5ff5\u6027\u8d28\u7684\u516c\u7406.\n\n3. \u7528\u57fa\u672c\u6982\u5ff5\u7ed9\u51fa\u5176\u4ed6\u51e0\u4f55\u6982\u5ff5\u7684\u5b9a\u4e49.\n4. \u6839\u636e\u5b9a\u4e49\u548c\u516c\u7406\u8bc1\u660e\u5b9a\u7406."
    },
    {
      "block": 6,
      "text": "\u7acb\u4f53\u51e0\u4f55\u6709\u56db\u4e2a\u57fa\u672c\u6982\u5ff5\uff1a\u70b9\u3001\u76f4\u7ebf\u3001\u5e73\u9762\u548c\u8ddd\u79bb.\n\u4e0d\u4ec5\u5728\u51e0\u4f55\u4e2d\uff0c\u800c\u4e14\u5728\u5176\u4ed6\u6240\u6709\u6570\u5b66\u5206\u652f\u4e2d\uff0c\u201c\u96c6\u5408\u201d\u4e5f\u88ab\u4f5c\u4e3a\u4e0d\u52a0\u5b9a\u4e49\u7684\u57fa\u672c\u6982\u5ff5.\n\n\u5728\u51e0\u4f55\u4e2d\uff0c\u4efb\u4f55\u70b9\u7684\u96c6\u5408\u90fd\u79f0\u4e3a\u56fe\u5f62.\n\u76f4\u7ebf\u548c\u5e73\u9762\u90fd\u662f\u56fe\u5f62\u7684\u4f8b\u5b50."
    }
  ],
