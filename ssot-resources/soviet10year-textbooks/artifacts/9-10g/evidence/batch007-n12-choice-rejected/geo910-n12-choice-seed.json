  "exercises": [
    {
      "number": "97",
      "text": "97. \u5df2\u77e5\u4e09\u4e2a\u4e0d\u540c\u7684\u70b9\uff0c\u5c06\u5b83\u4eec\u6295\u5f71\u5230\u5e73\u9762\u4e0a\uff0c\u53ef\u80fd\u5f97\u5230\u591a\u5c11\u4e2a\u70b9\uff1f",
      "figure_ids": []
    },
    {
      "number": "98",
      "text": "$98^{\\bullet}$. \u6295\u5c04\u76f4\u7ebf\u7684\u5c04\u5f71\u662f\u4ec0\u4e48\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "99",
      "text": "$99^{\\bullet}$.\n1) \u5e73\u9762\uff1b\n2) \u534a\u5e73\u9762\uff1b\n3) \u4e0d\u7b49\u4e8e\u5e73\u89d2\u7684\u89d2\u7684\u5c04\u5f71\u53ef\u80fd\u662f\u4ec0\u4e48\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "100",
      "text": "$100^{\\circ}$. \u5728\u4ec0\u4e48\u60c5\u51b5\u4e0b\uff1a\n1) \u70b9\u7684\u5c04\u5f71\u4e0e\u8fd9\u4e2a\u70b9\u91cd\u5408\uff1b\n2) \u76f4\u7ebf\u7684\u5c04\u5f71\u4e0e\u8fd9\u6761\u76f4\u7ebf\u91cd\u5408\uff1f",
      "figure_ids": []
    },
    {
      "number": "101",
      "text": "$101^{\\circ}$. \u5728\u600e\u6837\u7684\u60c5\u51b5\u4e0b\uff0c\u201c\u5e73\u884c\u76f4\u7ebf\u7684\u5c04\u5f71\u5e73\u884c\u201d\u8fd9\u4e2a\u7ed3\u8bba\u4e0d\u6b63\u786e\uff1f",
      "figure_ids": []
    },
    {
      "number": "102",
      "text": "102. \u5df2\u77e5\u4e00\u6761\u7ebf\u6bb5\u4e0e\u5b83\u7684\u5c04\u5f71\u957f\u5ea6\u76f8\u7b49\u3002\u8fd9\u6761\u7ebf\u6bb5\u4e0e\u6295\u5f71\u5e73\u9762\u53ef\u80fd\u6709\u600e\u6837\u7684\u4f4d\u7f6e\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "103",
      "text": "103.\n1) \u5c06\u4e24\u6761\u76f8\u4ea4\u76f4\u7ebf\u7684\u5e76\u96c6\u6295\u5f71\u5230\u5e73\u9762\u4e0a\uff0c\u53ef\u80fd\u5f97\u5230\u600e\u6837\u7684\u56fe\u5f62\uff1f\n2) \u5c06\u4e24\u6761\u5f02\u9762\u76f4\u7ebf\u7684\u5e76\u96c6\u6295\u5f71\u5230\u5e73\u9762\u4e0a\uff0c\u53ef\u80fd\u5f97\u5230\u600e\u6837\u7684\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "104",
      "text": "104.\n$1^{\\circ}$) \u5982\u679c\u4e24\u6761\u76f4\u7ebf\u7684\u5c04\u5f71\u5e73\u884c\uff0c\u90a3\u4e48\u88ab\u6295\u5f71\u7684\u76f4\u7ebf\u5e73\u884c\u3002\u8fd9\u4e2a\u8bba\u65ad\u6b63\u786e\u5417\uff1f\n2) \u5df2\u77e5\u5f02\u9762\u76f4\u7ebf $a$\u3001$b$ \u548c\u6295\u5f71\u5e73\u9762 $\\alpha$\u3002\u4f5c\u76f4\u7ebf $l$\uff0c\u4f7f\u5f97\u5e73\u884c\u4e8e $l$ \u6295\u5f71\u65f6\uff0c\u76f4\u7ebf $a$ \u548c $b$ \u7684\u5c04\u5f71\u5e73\u884c\u3002",
      "figure_ids": []
    },
    {
      "number": "105",
      "text": "105. \u4ece\u4e00\u4e2a\u70b9\u5f15\u51fa\u4e09\u6761\u4e0d\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u4e0a\u7684\u5c04\u7ebf\u3002\u8fd9\u4e9b\u5c04\u7ebf\u7684\u5e76\u96c6\u548c\u5c04\u5f71\u53ef\u80fd\u662f\u600e\u6837\u7684\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "106",
      "text": "106. \u7ebf\u6bb5 $AB$ \u4e0e\u6295\u5f71\u5e73\u9762\u4ea4\u4e8e\u70b9 $M$\uff0c\u5b83\u7684\u5c04\u5f71\u662f\u7ebf\u6bb5 $A_1B_1$\u3002\n\u5df2\u77e5\uff1a$|AB|=m$\uff0c$|A_1M|:|MB_1|=p:q$\u3002\n\u6c42 $|AM|$ \u548c $|MB|$\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u5df2\u77e5\u5e73\u9762 $\\alpha$ \u548c\u4e0e $\\alpha$ \u76f8\u4ea4\u7684\u76f4\u7ebf $l$\uff08\u56fe 39\uff09\u3002\n\u4efb\u53d6\u4e00\u70b9 $A_1$\uff0c\u8fc7\u5b83\u4f5c\u76f4\u7ebf $l_1$ \u4e0e\u76f4\u7ebf $l$ \u5e73\u884c\u3002\n\u76f4\u7ebf $l_1$ \u4e0e $\\alpha$ \u4ea4\u4e8e\u70b9 $A$\uff08\u56fe 39\uff09\u3002\n\n\u8fd9\u6837\u5f97\u5230\u7684\u70b9 $A$\uff0c\u53eb\u4f5c\u5e73\u884c\u4e8e\u76f4\u7ebf $l$ \u6295\u5f71\u65f6\uff0c\u70b9 $A_1$ \u5728\u5e73\u9762 $\\alpha$ \u4e0a\u7684\u5c04\u5f71\uff0c\u7b80\u5355\u5730\u8bf4\uff0c\u70b9 $A$ \u662f\u70b9 $A_1$ \u7684\u5e73\u884c\u5c04\u5f71\u3002\n\u5df2\u77e5\u56fe\u5f62 $\\phi_1$ \u7684\u6240\u6709\u70b9\u7684\u5e73\u884c\u6295\u5f71\u7ec4\u6210\u7684\u96c6\u5408 $\\phi$\uff0c\u53eb\u4f5c\u56fe\u5f62 $\\phi_1$ \u7684\u5e73\u884c\u5c04\u5f71\u3002"
    },
    {
      "block": 9,
      "text": "\u6b63\u516d\u8fb9\u5f62 $A_1B_1C_1D_1E_1F_1$ \u7684\u6a21\u578b\u6295\u5728\u5899\u4e0a\uff0c\u5f62\u6210\u591a\u8fb9\u5f62 $ABCDEF$ \u7684\u5f71\u5b50\uff08\u56fe 41\uff09\u3002\n\u6539\u53d8\u516d\u8fb9\u5f62\u6240\u5728\u5e73\u9762\u76f8\u5bf9\u4e8e\u5899\u9762\u7684\u4f4d\u7f6e\uff0c\u89c2\u5bdf\u5f71\u5b50\u7684\u53d8\u5316\uff0c\u53ef\u4ee5\u731c\u60f3\u5e73\u884c\u6295\u5f71\u7684\u51e0\u4e2a\u6027\u8d28\u3002\n\u53d9\u8ff0\u4ee5\u4e0b\u6027\u8d28\u65f6\uff0c\u5047\u8bbe\u6cbf\u5e73\u884c\u4e8e\u76f4\u7ebf $l$ \u7684\u65b9\u5411\u8fdb\u884c\u6295\u5f71\uff0c\u800c\u4e14\u76f4\u7ebf $l$ \u4e0e\u88ab\u6295\u5f71\u7684\u76f4\u7ebf\u6216\u7ebf\u6bb5\u4e0d\u5e73\u884c\u3002"
    },
    {
      "block": 10,
      "text": "\u6027\u8d281. \u76f4\u7ebf\u7684\u5c04\u5f71\u662f\u76f4\u7ebf\u3002"
    },
    {
      "block": 11,
      "text": "\u6027\u8d282. \u5e73\u884c\u76f4\u7ebf\u7684\u5c04\u5f71\u662f\u5e73\u884c\u7684\u3002"
    },
    {
      "block": 12,
      "text": "\u6027\u8d283. \u4e24\u6761\u5e73\u884c\u7ebf\u6bb5\u7684\u5c04\u5f71\u7684\u957f\u5ea6\u6bd4\uff0c\u7b49\u4e8e\u8fd9\u4e24\u6761\u88ab\u6295\u5f71\u7ebf\u6bb5\u7684\u957f\u5ea6\u6bd4\u3002"
    }
  ],
