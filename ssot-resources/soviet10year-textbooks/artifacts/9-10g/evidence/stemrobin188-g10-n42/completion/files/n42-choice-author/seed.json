  "exercises": [
    {
      "number": "1",
      "text": "\u4e60 \u9898\n1. \u8bf4\u51fa\u4e0b\u5217\u5411\u91cf\u7684\u5750\u6807\uff1a\n1\uff09$\\vec{i}+2\\vec{j}-3\\vec{k}$\uff1b\n2\uff09$8\\vec{i}+\\vec{k}$\uff1b\n3\uff09$0.5\\vec{j}-\\sqrt{2}\\vec{k}$\uff1b\n4\uff09$7\\vec{j}$\uff1b\n5\uff09$\\vec{i}$\uff1b\n6\uff09$\\vec{0}$\uff1b\n7\uff09$8\\vec{k}+\\vec{i}$.",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u4e60 \u9898\n2. \u6839\u636e\u5411\u91cf $\\vec{a}=(-2,3,0)$\uff0c$\\vec{b}=(1,-1,5)$\uff0c$\\vec{c}$ $=(7,0,4)$ \u7684\u5750\u6807\u6c42\u4e0b\u5217\u5411\u91cf\u7684\u5750\u6807\uff1a\n1\uff09$\\vec{a}+\\vec{b}$\uff1b\n2\uff09$\\vec{a}-\\vec{c}$\uff1b\n3\uff09$\\vec{a}-\\vec{b}+\\vec{c}$.",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u4e60 \u9898\n3. \u5df2\u77e5\u5411\u91cf\uff1a$\\vec{a}=(-3,-1,2)$\uff0c$\\vec{b}=(4,0,6)$\uff0c$\\vec{c}=$ $(5,-2,7)$. \u6c42\u4e0b\u5217\u5411\u91cf\u7684\u5750\u6807\uff1a\n1\uff09$2\\vec{a}$\uff1b\n2\uff09$-\\frac{7}{6}\\vec{b}$\uff1b\n3\uff09$-\\vec{a}+3\\vec{c}$.",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\u4e60 \u9898\n4. \u5229\u7528\u4e24\u4e2a\u5411\u91cf\u5171\u7ebf\u7684\u6761\u4ef6\uff08\u00a720\uff09\uff0c\u8bf4\u660e\u4e0b\u5217\u5411\u91cf\u662f\u5426\u5171\u7ebf\uff1a\n1\uff09$\\vec{a}=\\left(\\frac{3}{7},\\frac{1}{2},-\\frac{3}{4}\\right)$ \u548c $\\vec{b}=\\left(\\frac{2}{7},\\frac{1}{3},-\\frac{1}{2}\\right)$\uff1b\n2\uff09$\\vec{c}=$ $\\left(-\\frac{3}{2},6,\\frac{4}{3}\\right)$ \u548c $\\vec{d}=\\left(\\frac{9}{8},-\\frac{9}{2},-1\\right)$.",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "\u4e60 \u9898\n5. \u5f53 $x$ \u548c $y$ \u662f\u4ec0\u4e48\u503c\u65f6\uff0c\u5411\u91cf $\\vec{a}=(x,-2,5)$ \u548c $\\vec{b}=$ $(1,y,-3)$ \u5171\u7ebf\uff1f",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "\u4e60 \u9898\n6. \u6c42\u5411\u91cf\u7684\u6570\u6027\u79ef\uff1a\n1\uff09$\\vec{a}=(-2,3,1)$ \u548c $\\vec{b}=(5,7,-4)$\uff1b\n2) $\\vec c=\\left(\\frac{1}{2},\\frac{3}{5},-\\frac{5}{6}\\right)$ \u548c $\\vec d=\\left(-\\frac{2}{3},\\frac{5}{6},-\\frac{1}{5}\\right)$.",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "\u4e60 \u9898\n7. \u4e0b\u5217\u5411\u91cf\u5782\u76f4\u5417\uff1f\n1) $\\vec a=(-2,1,3)$ \u548c $\\vec b=(6,-5,7)$\uff1b\n2) $\\vec c=(6,0,12)$ \u548c $\\vec d=(-8,13,4)$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "1. \u8bbe\u5df2\u77e5\u4e09\u4e2a\u4e24\u4e24\u5782\u76f4\u7684\u5355\u4f4d\u5411\u91cf\u7ec4 $(\\vec{i},\\vec{j},\\vec{k})$\uff08\u56fe 1\uff09\u3002\n\u8fd9\u6837\u7684\u5411\u91cf\u7ec4\u53eb\u505a\u76f4\u89d2\u57fa\u5e95\u3002\n\u6211\u4eec\u77e5\u9053\uff0c\u7a7a\u95f4\u7684\u6bcf\u4e00\u4e2a\u5411\u91cf\u53ef\u4ee5\u6309\u5411\u91cf $\\vec{i},\\vec{j},\\vec{k}$ \u5206\u89e3\uff08\u00a723\uff09\u3002\n\n\u8fd9\u5c31\u662f\u8bf4\uff0c\u5bf9\u4e8e\u4efb\u610f\u7684\u4e00\u4e2a\u5411\u91cf $\\vec{a}$\uff0c\u5b58\u5728\u552f\u4e00\u7684\u6570\u7ec4 $(x,y,z)$\uff0c\u4f7f\u5f97\n$\\vec{a}=x\\vec{i}+y\\vec{j}+z\\vec{k}.$\n\uff081\uff09"
    },
    {
      "block": 5,
      "text": "\u9006\u547d\u9898\u4e5f\u6210\u7acb\uff1a\u5728\u5df2\u77e5\u7684\u76f4\u89d2\u57fa\u5e95 $(\\vec{i},\\vec{j},\\vec{k})$ \u4e2d\uff0c\u6bcf\u4e00\u4e2a\u6570\u7ec4 $(x,y,z)$ \u786e\u5b9a\u552f\u4e00\u7684\u5411\u91cf\u3002\n\u6570 $x,y,z$ \u53eb\u505a\u5728\u57fa\u5e95 $(\\vec{i},\\vec{j},\\vec{k})$ \u4e2d\u5411\u91cf $\\vec{a}$ \u7684\u5750\u6807\u3002"
    },
    {
      "block": 7,
      "text": "\u5728\u53d9\u8ff0\u8fd9\u4e00\u7ae0\u7684\u5185\u5bb9\u65f6\uff0c\u7b49\u5f0f\uff081\uff09\u5c06\u4ec5\u7528\u5411\u91cf\u7684\u5750\u6807\u8868\u793a\uff1a\n$\\vec{a}=(x,y,z).$"
    },
    {
      "block": 9,
      "text": "1. \u4e24\u4e2a\uff08\u6216\u66f4\u591a\uff09\u5411\u91cf\u7684\u548c\u7684\u5750\u6807\u7b49\u4e8e\u88ab\u52a0\u5411\u91cf\u5bf9\u5e94\u5750\u6807\u7684\u548c\uff1a\n$\\vec{a}+\\vec{b}=(x_1+x_2,\\ y_1+y_2,\\ z_1+z_2).$"
    },
    {
      "block": 10,
      "text": "2. \u4e24\u4e2a\u5411\u91cf\u7684\u5dee\u7684\u5750\u6807\u7b49\u4e8e\u8fd9\u4e24\u4e2a\u5411\u91cf\u5bf9\u5e94\u5750\u6807\u7684\u5dee\uff1a\n$\\vec{a}-\\vec{b}=(x_1-x_2,\\ y_1-y_2,\\ z_1-z_2).$"
    },
    {
      "block": 11,
      "text": "3. \u5411\u91cf\u4e0e\u6570\u7684\u4e58\u79ef\u7684\u5750\u6807\u7b49\u4e8e\u5df2\u77e5\u5411\u91cf\u7684\u5750\u6807\u4e58\u8fd9\u4e2a\u6570\u7684\u79ef\uff1a\n$P\\vec{a}=(Px_1,Py_1,Pz_1).$"
    },
    {
      "block": 12,
      "text": "4. \u4e24\u4e2a\u5411\u91cf\u7684\u6570\u6027\u79ef\u7b49\u4e8e\u8fd9\u4e24\u4e2a\u5411\u91cf\u7684\u5bf9\u5e94\u5750\u6807\u7684\u4e58\u79ef\u7684\u548c\uff1a\n$\\vec{a}\\cdot\\vec{b}=x_1x_2+y_1y_2+z_1z_2.$"
    }
  ],
