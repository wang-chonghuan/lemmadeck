  "exercises": [
    {
      "number": "391",
      "text": "\u4e60\u9898\n391\uff0e\u5229\u7528\u4ee5\u4e0b\u7684\u9762\u89d2\u80fd\u5236\u6210\u4e09\u9762\u89d2\u7684\u6a21\u578b\u5417\uff1f\n1) $100^\\circ$\u3001$120^\\circ$\u3001$10^\\circ$\uff1b\n2) $80^\\circ$\u3001$50^\\circ$\u3001$30^\\circ$\uff1b\n3) $125^\\circ$\u3001$120^\\circ$\u3001$115^\\circ$\u3002",
      "figure_ids": []
    },
    {
      "number": "392",
      "text": "\u4e60\u9898\n392\uff0e\n1) \u4e09\u9762\u89d2\u7684\u4e24\u4e2a\u9762\u89d2\u7b49\u4e8e $70^\\circ$ \u548c $80^\\circ$\u3002\u6c42\u7b2c\u4e09\u4e2a\u9762\u89d2\u5728\u600e\u6837\u7684\u8303\u56f4\u5185\uff1f\n2) \u5bf9\u4e8e $100^\\circ$ \u548c $120^\\circ$ \u89e3\u7b54\u540c\u6837\u7684\u95ee\u9898\u3002",
      "figure_ids": []
    },
    {
      "number": "393",
      "text": "\u4e60\u9898\n393\uff0e\u4e09\u9762\u89d2\u6240\u6709\u7684\u9762\u90fd\u662f\u76f4\u89d2\u3002\u6c42\u8fd9\u4e2a\u4e09\u9762\u89d2\u7684\u4e8c\u9762\u89d2\u7684\u5ea6\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "394",
      "text": "\u4e60\u9898\n394\uff0e\u8bc1\u660e\uff1a\u5982\u679c\u4e09\u9762\u89d2\u7684\u9762\u89d2\u7684\u5ea6\u6570\u7684\u548c\u7b49\u4e8e $180^\\circ$\uff0c\u90a3\u4e48\u5b83\u4eec\u90fd\u662f\u9510\u89d2\u3002",
      "figure_ids": []
    },
    {
      "number": "395",
      "text": "\u4e60\u9898\n395*\uff0e\u4e09\u89d2\u5f62 $ABC$ \u548c $ABD$ \u4e0d\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u5185\u3002\u8bc1\u660e\uff1a$\\widehat{ACB}+\\widehat{CBD}+\\widehat{BDA}+\\widehat{DAC}<360^\\circ$\u3002",
      "figure_ids": []
    },
    {
      "number": "396",
      "text": "\u4e60\u9898\n396\uff0e\u4e00\u4e2a\u4e09\u9762\u89d2\u7684\u4e24\u4e2a\u9762\u89d2\u90fd\u7b49\u4e8e $45^\\circ$\uff1b\u5b83\u4eec\u4e4b\u95f4\u7684\u4e8c\u9762\u89d2\u662f\u76f4\u89d2\u3002\u6c42\u7b2c\u4e09\u4e2a\u9762\u89d2\u3002",
      "figure_ids": []
    },
    {
      "number": "397",
      "text": "\u4e60\u9898\n397\uff0e\u4e09\u9762\u89d2\u7684\u6240\u6709\u7684\u9762\u89d2\u90fd\u7b49\u4e8e $60^\\circ$\u3002\u5728\u4e00\u6761\u68f1\u4e0a\u53d6\u4e00\u70b9\uff0c\u5b83\u540c\u89d2\u7684\u9876\u70b9\u7684\u8ddd\u79bb\u4e3a $a$\u3002\u6c42\u8fd9\u4e2a\u70b9\u5230\u76f8\u5bf9\u7684\u9762\u6240\u5728\u7684\u5e73\u9762\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "398",
      "text": "\u4e60\u9898\n398. \u5728\u4e09\u9762\u89d2\u4e2d\u4e24\u4e2a\u9762\u89d2\u7b49\u4e8e $60^\\circ$\uff0c\u53e6\u4e00\u4e2a\u7b49\u4e8e $90^\\circ$. \u6c42\u76f8\u5bf9\u4e8e\u76f4\u89d2\u7684\u9762\u89d2\u7684\u68f1\u5bf9\u4e8e\u8fd9\u4e2a\u89d2\u6240\u5728\u7684\u5e73\u9762\u7684\u503e\u659c\u89d2.",
      "figure_ids": []
    },
    {
      "number": "399",
      "text": "\u4e60\u9898\n$399^{*}$. \u6c42\u4e0e\u4e09\u9762\u89d2\u6240\u6709\u7684\u68f1\u7684\u8ddd\u79bb\u76f8\u7b49\u7684\u5168\u90e8\u70b9\u7684\u96c6\u5408.",
      "figure_ids": []
    },
    {
      "number": "400",
      "text": "\u4e60\u9898\n$400^{*}$. \u8bbe\u4efb\u4e00\u4e09\u9762\u89d2\u7684\u9762\u89d2\u4e3a $\\alpha$\u3001$\\beta$\u3001$\\gamma$\uff0c\u8bc1\u660e\u4e0b\u5217\u4e0d\u7b49\u5f0f\u6210\u7acb\uff1a$\\cos\\alpha+\\cos\\beta+\\cos\\gamma>-\\frac{3}{2}$.",
      "figure_ids": []
    },
    {
      "number": "401",
      "text": "\u4e60\u9898\n$401^{*}$. \u8bc1\u660e\uff1a\u4e09\u9762\u89d2\u4e24\u4e2a\u9762\u89d2\u7684\u5e73\u5206\u7ebf\u548c\u7b2c\u4e09\u4e2a\u9762\u89d2\u7684\u90bb\u8865\u89d2\u7684\u5e73\u5206\u7ebf\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u5185.",
      "figure_ids": []
    },
    {
      "number": "402",
      "text": "\u4e60\u9898\n402. \u591a\u9762\u89d2\u7684\u9762\u89d2\u80fd\u53d6\u4e0b\u5217\u6570\u636e\u5417\uff1f\n1) $80^\\circ$\u3001$130^\\circ$\u3001$70^\\circ$\u3001$100^\\circ$\uff1b\n2) $10^\\circ$\u3001$20^\\circ$\u3001$40^\\circ$\u3001$80^\\circ$\u3001$160^\\circ$.",
      "figure_ids": []
    },
    {
      "number": "403",
      "text": "\u4e60\u9898\n403. \u5728\u56db\u9762\u89d2 $SABCD$ \u4e2d\uff0c\u6240\u6709\u7684\u9762\u89d2\u53ca\u89d2 $ASC$ \u90fd\u7b49\u4e8e $60^\\circ$. \u6c42\u5b83\u7684\u4e8c\u9762\u89d2\u7684\u5ea6\u6570.",
      "figure_ids": []
    },
    {
      "number": "404",
      "text": "\u4e60\u9898\n404. \u8bc1\u660e\uff1a\u5bf9\u4e8e\u4efb\u610f\u7684\u51f8\u56db\u9762\u89d2\u90fd\u53ef\u4ee5\u4f5c\u4f7f\u622a\u9762\u662f\u5e73\u884c\u56db\u8fb9\u5f62\u7684\u622a\u5e73\u9762.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "**\u5b9a\u740624. \u4e09\u9762\u89d2\u7684\u6bcf\u4e00\u4e2a\u9762\u89d2\u7684\u5ea6\u6570\u5c0f\u4e8e\u5176\u5b83\u4e24\u4e2a\u9762\u89d2\u5ea6\u6570\u7684\u548c.**"
    },
    {
      "block": 8,
      "text": "\u63a8\u8bba\uff0e\n\u4e09\u9762\u89d2\u7684\u6bcf\u4e00\u4e2a\u9762\u89d2\u7684\u5ea6\u6570\u5927\u4e8e\u5176\u5b83\u4e24\u4e2a\u9762\u89d2\u7684\u5ea6\u6570\u7684\u5dee\u3002"
    },
    {
      "block": 10,
      "text": "\u5b9a\u7406 25\uff0e\n\u5728\u4e09\u9762\u89d2\u4e2d\uff0c\u5b83\u7684\u6240\u6709\u9762\u89d2\u7684\u5ea6\u6570\u7684\u548c\u5c0f\u4e8e$360^\\circ$\u3002"
    },
    {
      "block": 12,
      "text": "\u4e0d\u7b49\u5f0f $|\\beta-\\gamma|<\\alpha<\\beta+\\gamma$ \u548c $\\alpha+\\beta+\\gamma<360^\\circ$ \u4e2d\u7684\u6bcf\u4e00\u4e2a\u90fd\u8868\u793a\u9762\u89d2\u4e3a $\\alpha$\u3001$\\beta$\u3001$\\gamma$ \u7684\u4e09\u9762\u89d2\u5b58\u5728\u7684\u5fc5\u8981\u6761\u4ef6\uff1a\u53ef\u4ee5\u770b\u51fa\uff0c\u5173\u4e8e\u8fd9\u4e24\u4e2a\u4e0d\u7b49\u5f0f\u6210\u7acb\u4e5f\u662f\u8fd9\u6837\u7684\u4e09\u9762\u89d2\u5b58\u5728\u7684\u5145\u5206\u6761\u4ef6\u3002\n\uff08\u53c2\u770b\u300a\u9644\u5f55\u300b\u7b2c 301\u2014302 \u9875\u3002\uff09"
    },
    {
      "block": 13,
      "text": "\u51f8\u7684\u591a\u9762\u89d2\u7684\u9762\u89d2\u7684\u6027\u8d28\u7c7b\u4f3c\u4e8e\u4e09\u9762\u89d2\u7684\u6027\u8d28\uff1a"
    },
    {
      "block": 14,
      "text": "1\uff0e\n\u591a\u9762\u89d2\u7684\u6bcf\u4e00\u4e2a\u9762\u89d2\u7684\u5ea6\u6570\u5c0f\u4e8e\u5176\u5b83\u7684\u9762\u89d2\u7684\u5ea6\u6570\u7684\u548c\u3002"
    },
    {
      "block": 15,
      "text": "2\uff0e\n\u5728\u51f8\u591a\u9762\u89d2\u4e2d\uff0c\u5404\u9762\u89d2\u7684\u5ea6\u6570\u7684\u548c\u5c0f\u4e8e $360^\\circ$\u3002"
    }
  ],
