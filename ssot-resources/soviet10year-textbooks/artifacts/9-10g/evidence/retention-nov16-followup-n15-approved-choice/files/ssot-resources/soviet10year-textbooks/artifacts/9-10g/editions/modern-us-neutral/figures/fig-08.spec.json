    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/9-10g/figures/fig-08.png",
      "sha256": "af5d4d076448046993f46b942cdcd2d6ae97cb606cb811e7e9de2eb0df91be6e"
