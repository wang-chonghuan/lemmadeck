        "objects": ["S", "A", "C", "B", "SC", "SA", "SB", "beta-arc", "right-sector-arc", "alpha-arc-outer", "alpha-arc-inner", "beta-label", "right-sector-label", "alpha-label"],
        "assertions": ["SC-connects", "SA-connects", "SB-connects", "beta-start-on-SC", "beta-end-on-SA", "gamma-start-on-SA", "gamma-end-on-SB", "alpha-inner-start-on-SC", "alpha-inner-end-on-SB", "alpha-outer-start-on-SC", "alpha-outer-end-on-SB"],
        "requires": ["pointRelationships"]
      }
    ]
