    {
      "id": "n61-q209-oblique",
      "source_numbers": [
        "209"
      ],
      "view": {
        "mode": "multiple",
        "stem": "直圆锥的底半径为 $R>0$，母线与底面的夹角为 $\\alpha$，$0<\\alpha<90^\\circ$。一个过顶点的平面与底面的夹角为 $\\varphi$，$0<\\varphi\\le90^\\circ$。令 $A$ 表示它与圆锥相交部分的面积。下列关于截面与面积的说法，哪些正确？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "截面是非退化三角形，当且仅当 $\\alpha<\\varphi\\le90^\\circ$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "在所有非退化情况下，$A=R^2\\tan\\alpha\\sqrt{1-\\tan^2\\alpha\\cot^2\\varphi}$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "在所有非退化情况下，$A=\\dfrac{R^2\\tan\\alpha}{\\sin\\varphi}\\sqrt{1-\\tan^2\\alpha\\cot^2\\varphi}$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "当 $\\varphi=90^\\circ$ 时，$A=R^2\\tan\\alpha$。",
            "figure_ids": []
          },
          {
            "id": "E",
            "text": "当 $\\varphi=\\alpha$ 时，截面是面积为 $R^2/\\cos\\alpha$ 的三角形。",
            "figure_ids": []
          }
        ]
      }
    },
