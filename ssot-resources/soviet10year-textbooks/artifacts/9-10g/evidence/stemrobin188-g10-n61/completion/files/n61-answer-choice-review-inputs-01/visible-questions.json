    {
      "id": "n61-q206-sections",
      "source_numbers": [
        "206"
      ],
      "view": {
        "mode": "multiple",
        "stem": "一个直圆锥的底半径和高都大于零。这里的截面是平面与整个圆锥的交集。关于截面的下列说法，哪些正确？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "轴截面是等腰三角形。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "只要平面经过顶点，截面就一定是三角形。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "平行底面且位于顶点与底面之间的截面是圆盘。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "经过顶点、不经过轴而且截得非零底面弦的截面是不等边三角形。",
            "figure_ids": []
          },
          {
            "id": "E",
            "text": "经过顶点且截得非零底面弦的截面是等腰三角形，即使截平面不经过轴。",
            "figure_ids": []
          }
        ]
      }
    },
