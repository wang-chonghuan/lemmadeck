  "exercises": [
    {
      "number": "34",
      "text": "\u4e60 \u9898\n34.\n1\uff09\u5728\u5e73\u79fb $\\vec{p}=(-1,\\ 5,\\ 3)$ \u4e0b\uff1b\n2\uff09\u5728\u4f4d\u4f3c $H_0^{-\\frac{3}{2}}$ \u4e0b\uff0c\u6c42\u51fa\u5e73\u9762 $3x-y+8z-17=0$ \u7684\u8c61\u7684\u65b9\u7a0b\u3002",
      "figure_ids": []
    },
    {
      "number": "35",
      "text": "\u4e60 \u9898\n35. \u6c42\u5750\u6807\u516c\u5f0f\uff1a\n1\uff09\u4ee5 $O(0,\\ 0,\\ 0)$ \u4e3a\u4e2d\u5fc3\u7684\u4e2d\u5fc3\u5bf9\u79f0\uff1b\n2\uff09\u5173\u4e8e\u5e73\u9762 $z=0$ \u7684\u5bf9\u79f0\uff1b\n3\uff09\u5173\u4e8e $z$ \u5750\u6807\u8f74\u5bf9\u79f0\u3002",
      "figure_ids": []
    },
    {
      "number": "36",
      "text": "\u4e60 \u9898\n36*. \u5229\u7528\u4e0a\u9898\u7684\u7ed3\u679c\uff0c\u6c42\u5e73\u9762 $7x-2y-5z-1=0$ \u7684\u8c61\u7684\u65b9\u7a0b\uff1a\n1\uff09\u5728\u5bf9\u79f0 $z_0$ \u4e0b\uff1b\n2\uff09\u5728\u5173\u4e8e\u5e73\u9762 $z=0$ \u5bf9\u79f0\u4e0b\uff1b\n3\uff09\u5728\u5173\u4e8e $z$ \u5750\u6807\u8f74\u5bf9\u79f0\u4e0b\u3002",
      "figure_ids": []
    },
    {
      "number": "37",
      "text": "\u4e60 \u9898\n37.\n1\uff09\u5728\u4f4d\u4f3c\u53d8\u6362\u4e0b\uff0c\u54ea\u4e9b\u70b9\u3001\u76f4\u7ebf\u548c\u5e73\u9762\u6620\u5c04\u4e3a\u5b83\u672c\u8eab\uff1f\n2\uff09\u600e\u6837\u7684\u4f4d\u4f3c\u53d8\u6362\u662f\u4f4d\u79fb\uff1f",
      "figure_ids": []
    },
    {
      "number": "38",
      "text": "\u4e60 \u9898\n38. \u5df2\u77e5\u4e00\u56db\u9762\u4f53\u7684\u56fe\u548c\u4e00\u70b9 $O$\uff0c\u5982\u679c\n1\uff09$k=-2$\uff1b\n2\uff09$k=0.5$\uff0c\u6c42\u4f5c\u8fd9\u4e2a\u56db\u9762\u4f53\u5728\u4f4d\u4f3c\u53d8\u6362 $H_0^k$ \u4e0b\u7684\u8c61\u3002\n\u5728\u4e24\u79cd\u60c5\u51b5\u4e0b\uff0c\u6c42\u5df2\u77e5\u7684\u56db\u9762\u4f53\u548c\u6240\u4f5c\u7684\u56db\u9762\u4f53\u7684\u8868\u9762\u79ef\u7684\u6bd4\u3002",
      "figure_ids": []
    },
    {
      "number": "39",
      "text": "\u4e60 \u9898\n39.\n1\uff09\u4ee5\u5e73\u884c\u516d\u9762\u4f53\u7684\u4e00\u4e2a\u9876\u70b9\u4e3a\u4f4d\u4f3c\u4e2d\u5fc3\uff0c\u6c42\u4f5c\u5f53 $k$ $=\\frac{1}{3}$ \u65f6\uff0c\u8be5\u5e73\u884c\u516d\u9762\u4f53\u7684\u8c61\u3002\n2\uff09\u6c42\u5e73\u884c\u516d\u9762\u4f53\u548c\u5b83\u7684\u8c61\u7684\u8868\u9762\u79ef\u7684\u6bd4\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "1. \u5047\u8bbe\u7ed9\u5b9a\u4e86\u76f4\u89d2\u5750\u6807\u7cfb\u548c\u7a7a\u95f4\u7684\u53d8\u6362 $f$\u3002\n\u53ef\u4ee5\u63d0\u51fa\u95ee\u9898\uff1a\u63a8\u51fa\u6839\u636e\u4efb\u610f\u70b9 $M$ \u7684\u5750\u6807\u8ba1\u7b97\u5b83\u7684\u8c61 $f(M)$ \u7684\u5750\u6807\u516c\u5f0f\u3002\n\u8fd9\u6837\u7684\u516c\u5f0f\u53eb\u505a\u53d8\u6362\u7684\u5750\u6807\u516c\u5f0f\u3002"
    },
    {
      "block": 4,
      "text": "\u5b9a\u4e49. \u5982\u679c\u5728\u7a7a\u95f4\u7684\u53d8\u6362\u4e0b\uff0c\u4efb\u610f\u7684\u4e00\u70b9 $M$ \u7684\u8c61\u662f\u70b9 $M_1$\uff0c\u800c\u4e14 $\\overrightarrow{OM_1}=k\\overrightarrow{OM}$\uff08$k\\ne0$\uff09\uff0c\u8fd9\u6837\u7684\u7a7a\u95f4\u53d8\u6362\u53eb\u505a\u4ee5 $O$ \u4e3a\u4e2d\u5fc3\u3001\u7cfb\u6570\u4e3a $k$ \u7684\u4f4d\u4f3c\u3002"
    },
    {
      "block": 12,
      "text": "\u5b9a\u7406 27. \u5728\u4f4d\u4f3c\u53d8\u6362\u4e0b\uff0c\u5e73\u9762\u6620\u5c04\u6210\u548c\u5b83\u5e73\u884c\u7684\u5e73\u9762\u3002"
    }
