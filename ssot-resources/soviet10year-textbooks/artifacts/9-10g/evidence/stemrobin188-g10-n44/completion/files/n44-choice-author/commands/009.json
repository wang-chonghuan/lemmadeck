  "stdout": "{\n  \"exercises\": [\n    {\n      \"number\": \"16\",\n      \"text\": \"\\u4e60\\u9898\\n16. \\u6309\\u4e0b\\u5217\\u5750\\u6807\\u4f5c\\u70b9\\uff1a\\n1) $A(2,3,1)$\\uff1b\\n2) $B(1,-1,2)$\\uff1b\\n3) $D\\\\left(-3,\\\\frac12,-1\\\\right)$\\uff1b\\n4) $E(0,2,-3)$\\uff1b\\n5) $G\\\\left(0,0,-\\\\frac32\\\\right)$.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"17\",\n      \"text\": \"\\u4e60\\u9898\\n17. \\u6839\\u636e\\u70b9 $P$ \\u548c $Q$ \\u7684\\u5750\\u6807\\u6c42\\u5411\\u91cf $\\\\overrightarrow{PQ}$ \\u7684\\u5750\\u6807\\uff1a\\n1) $P(2,-3,0)$\\uff0c$Q(-1,2,-3)$\\uff1b\\n2) $P\\\\left(\\\\frac12,-\\\\frac43,\\\\frac56\\\\right)$\\uff0c$Q\\\\left(-\\\\frac35,0,\\\\frac23\\\\right)$.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"18\",\n      \"text\": \"\\u4e60\\u9898\\n18. \\u70b9 $B$ \\u662f\\u70b9 $A(2,-3,1)$ \\u5728\\u5750\\u6807\\u5e73\\u9762 $Oyz$ \\u7684\\u6b63\\u6295\\u5f71. \\u8ba1\\u7b97 $|\\\\overrightarrow{OB}|$.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"19\",\n      \"text\": \"\\u4e60\\u9898\\n19. \\u8ba1\\u7b97\\u5728\\u5750\\u6807\\u8f74 $Oy$ \\u4e0a\\u4e0e\\u70b9 $A(2,-1,1)$ \\u548c $B(0,1,3)$\\u7b49\\u8fdc\\u7684\\u70b9\\u7684\\u5750\\u6807.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"20\",\n      \"text\": \"\\u4e60\\u9898\\n20. \\u7ed9\\u5b9a\\u4e09\\u89d2\\u5f62\\u7684\\u9876\\u70b9\\u7684\\u5750\\u6807\\u4e3a $A(3,-2,1)$\\u3001$B(3,1,5)$\\u3001$C(4,0,3)$. \\u8ba1\\u7b97\\uff1a\\n1)\\u4e2d\\u7ebf $AA_1$ \\u548c $BB_1$ \\u7684\\u957f\\uff1b\\n2)\\u4ece\\u5750\\u6807\\u539f\\u70b9\\u5230\\u4e09\\u89d2\\u5f62 $ABC$ \\u4e2d\\u7ebf\\u4ea4\\u70b9\\u7684\\u8ddd\\u79bb\\uff1b\\n3) \\u8fd9\\u4e2a\\u4e09\\u89d2\\u5f62\\u5185\\u89d2\\u7684\\u5927\\u5c0f.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"21\",\n      \"text\": \"\\u4e60\\u9898\\n21. \\u5df2\\u77e5\\u5e73\\u884c\\u56db\\u8fb9\\u5f62\\u4e09\\u4e2a\\u9876\\u70b9\\u7684\\u5750\\u6807\\uff1a$A(1,-3,0)$\\u3001$B(-2,4,1)$\\u3001$C(-3,1,1)$\\uff0c\\u8ba1\\u7b97\\u8fd9\\u4e2a\\u5e73\\u884c\\u56db\\u8fb9\\u5f62\\u5bf9\\u89d2\\u7ebf\\u7684\\u957f\\u5ea6.\",\n      \"figure_ids\": []\n    },\n    {\n      \"number\": \"22\",\n      \"text\": \"\\u4e60\\u9898\\n22. *\\u8bc1\\u660e\\uff1a\\u70b9 $A(2,4,-4)$\\u3001$B(1,1,-3)$\\u3001$C(-2,0,5)$\\uff0c$D(-1,3,4)$ \\u662f\\u5e73\\u884c\\u56db\\u8fb9\\u5f62\\u7684\\u9876\\u70b9. \\u5e76\\u8ba1\\u7b97\\u5b83\\u7684\\u4e24\\u6761\\u5bf9\\u89d2\\u7ebf\\u7684\\u5939\\u89d2\\u7684\\u5927\\u5c0f.\",\n      \"figure_ids\": []\n    }\n  ],\n  \"concept_candidates\": [\n    {\n      \"block\": 0,\n      \"text\": \"\\u8bbe\\u5728\\u7a7a\\u95f4\\u4e2d\\u5df2\\u77e5\\u4e00\\u70b9 $O$.\\n\\u7a7a\\u95f4\\u7684\\u6bcf\\u4e00\\u4e2a\\u70b9 $M$ \\u5bf9\\u5e94\\u4e8e\\u4e00\\u4e2a\\u5411\\u91cf $\\\\overrightarrow{OM}$.\\n\\u5728\\u8fd9\\u65f6\\uff0c\\u4e0d\\u540c\\u7684\\u70b9\\u5bf9\\u5e94\\u4e8e\\u4e0d\\u540c\\u7684\\u5411\\u91cf.\\n\\n\\u9664\\u70b9 $O$ \\u4e4b\\u5916\\uff0c\\u8fd8\\u7ed9\\u51fa\\u76f4\\u89d2\\u57fa\\u5e95 $(\\\\vec i,\\\\vec j,\\\\vec k)$\\uff08\\u56fe6\\uff09.\\n\\u6bcf\\u4e00\\u4e2a\\u5411\\u91cf\\u5728\\u8fd9\\u4e2a\\u57fa\\u5e95\\u4e2d\\u7684\\u5750\\u6807\\u662f\\uff1a\\n$\\\\overrightarrow{OM}=(x,y,z)$.\"\n    },\n    {\n      \"block\": 1,\n      \"text\": \"\\u5982\\u679c\\u7ed9\\u5b9a\\u4e86\\u76f4\\u89d2\\u57fa\\u5e95 $(\\\\vec i,\\\\vec j,\\\\vec k)$ \\u548c\\u70b9 $O$\\uff0c\\u90a3\\u4e48\\u5c31\\u8bf4\\uff0c\\u5efa\\u7acb\\u4e86\\u7a7a\\u95f4\\u7684\\u76f4\\u89d2\\u5750\\u6807\\u7cfb.\\n\\u70b9 $O$ \\u53eb\\u505a\\u5750\\u6807\\u539f\\u70b9\\uff0c\\u800c\\u5411\\u91cf $\\\\vec i,\\\\vec j,\\\\vec k$ \\u53eb\\u505a\\u5750\\u6807\\u5411\\u91cf.\\n\\n\\u5411\\u91cf $\\\\overrightarrow{OM}$ \\u5728\\u76f4\\u89d2\\u57fa\\u5e95 $(\\\\vec i,\\\\vec j,\\\\vec k)$ \\u4e2d\\u7684\\u5750\\u6807\\uff0c\\u79f0\\u4e3a\\u5728\\u76f4\\u89d2\\u5750\\u6807\\u7cfb\\u4e2d\\u70b9 $M$ \\u7684\\u5750\\u6807.\"\n    },\n    {\n      \"block\": 2,\n      \"text\": \"\\u5982\\u679c $\\\\overrightarrow{OM}=(x,y,z)$\\uff0c\\u90a3\\u4e48\\u70b9 $M$ \\u7684\\u5750\\u6807\\u5199\\u6210 $M(x,y,z)$.\\n\\u6570 $x$ \\u53eb\\u505a\\u70b9 $M$ \\u7684\\u6a2a\\u5750\\u6807\\uff0c$y$ \\u53eb\\u505a\\u70b9 $M$ \\u7684\\u7eb5\\u5750\\u6807\\uff0c$z$ \\u53eb\\u505a\\u70b9 $M$ \\u7684\\u7ad6\\u5750\\u6807.\"\n    },\n    {\n      \"block\": 7,\n      \"text\": \"\\u6211\\u4eec\\u518d\\u5f15\\u5165\\u51e0\\u4e2a\\u5e38\\u7528\\u7684\\u672f\\u8bed.\\n\\u5411\\u91cf $\\\\overrightarrow{OA}=\\\\vec i$\\u3001$\\\\overrightarrow{OB}=\\\\vec j$\\u3001$\\\\overrightarrow{OC}=\\\\vec k$ \\u6240\\u786e\\u5b9a\\u7684\\u8f74\\u53eb\\u505a\\u5750\\u6807\\u8f74\\uff08\\u56fe7\\uff09\\uff1b\\n\\u901a\\u8fc7\\u6bcf\\u4e24\\u4e2a\\u5750\\u6807\\u8f74\\u7684\\u5e73\\u9762\\u53eb\\u505a\\u5750\\u6807\\u5e73\\u9762\\uff1b\\n\\n\\u7ed9\\u51fa\\u4e86\\u5750\\u6807\\u7cfb\\u7684\\u7a7a\\u95f4\\u53eb\\u505a\\u5750\\u6807\\u7a7a\\u95f4.\"\n    },\n    {\n      \"block\": 8,\n      \"text\": \"\\u95ee\\u98981. \\u5df2\\u77e5\\u76f4\\u89d2\\u5750\\u6807\\u7cfb\\uff08\\u56fe8\\uff09. \\u4f5c\\u51fa\\u5750\\u6807\\u4e3a $(x,y,z)$ \\u7684\\u70b9 $M$.\"\n    },\n    {\n      \"block\": 9,\n      \"text\": \"\\u89e3. \\u6839\\u636e\\u70b9\\u7684\\u5750\\u6807\\u7684\\u5b9a\\u4e49\\uff0c\\u672c\\u9898\\u5f52\\u7ed3\\u4e3a\\u4f5c\\u8868\\u793a\\u5411\\u91cf $\\\\overrightarrow{OM}=x\\\\vec i+y\\\\vec j+z\\\\vec k$ \\u7684\\u6709\\u5411\\u7ebf\\u6bb5 $OM$\\uff08\\u56fe8\\uff09.\\n\\n\\u4f9d\\u6b21\\u4f5c\\u5411\\u91cf $\\\\overrightarrow{OA}=x\\\\vec i$\\u3001$\\\\overrightarrow{AB}=y\\\\vec j$ \\u548c $\\\\overrightarrow{BM}=z\\\\vec k$\\uff0c\\u70b9 $M$ \\u5373\\u4e3a\\u6240\\u6c42\\u7684\\u70b9.\\n\\u5b9e\\u9645\\u4e0a\\u6839\\u636e\\u591a\\u8fb9\\u5f62\\u6cd5\\u5219\\uff1a\\n$\\\\overrightarrow{OM}=\\\\overrightarrow{OA}+\\\\overrightarrow{AB}+\\\\overrightarrow{BM}=x\\\\vec i+y\\\\vec j+z\\\\vec k$.\"\n    },\n    {\n      \"block\": 14,\n      \"text\": \"\\u95ee\\u98982. \\u6839\\u636e\\u70b9 $A(x_1,y_1,z_1)$ \\u548c $B(x_2,y_2,z_2)$ \\u7684\\u5750\\u6807\\u6c42\\u5411\\u91cf $\\\\overrightarrow{AB}$ \\u7684\\u5750\\u6807.\"\n    },\n    {\n      \"block\": 15,\n      \"text\": \"\\u89e3. \\u6309\\u5411\\u91cf\\u7684\\u8ba1\\u7b97\\u516c\\u5f0f\\uff08\\u00a719\\uff09\\uff0c$\\\\overrightarrow{AB}=\\\\overrightarrow{OB}-\\\\overrightarrow{OA}$\\uff08\\u56fe9\\uff09.\\n\\u6839\\u636e\\u70b9\\u7684\\u5750\\u6807\\u7684\\u5b9a\\u4e49\\uff0c$\\\\overrightarrow{OB}=(x_2,y_2,z_2)$\\uff0c$\\\\overrightarrow{OA}=(x_1,y_1,z_1)$.\\n\\n\\u5e94\\u7528\\u7528\\u5750\\u6807\\u7ed9\\u51fa\\u7684\\u5411\\u91cf\\u51cf\\u6cd5\\u6cd5\\u5219\\uff08\\u00a742\\uff09\\uff0c\\u5f97\\u5230\\uff1a\\n$\\\\overrightarrow{AB}=(x_2-x_1,\\\\ y_2-y_1,\\\\ z_2-z_1)$. (1)\"\n    },\n    {\n      \"block\": 16,\n      \"text\": \"\\u95ee\\u98983. \\u6c42\\u70b9 $A(x_1,y_1,z_1)$ \\u548c $B(x_2,y_2,z_2)$ \\u4e4b\\u95f4\\u7684\\u8ddd\\u79bb.\"\n    },\n    {\n      \"block\": 17,\n      \"text\": \"\\u89e3. \\u53ea\\u9700\\u6c42\\u5411\\u91cf $\\\\overrightarrow{AB}$ \\u7684\\u957f\\uff08\\u56fe9\\uff09.\\n\\u6839\\u636e\\u516c\\u5f0f(1)\\u8ba1\\u7b97\\u5b83\\u7684\\u5750\\u6807.\\n\\u5e94\\u7528\\u5411\\u91cf\\u957f\\u5ea6\\u7684\\u516c\\u5f0f\\uff08\\u00a743\\uff0c\\u4e60\\u98981\\uff09\\u5f97\\u5230\\uff1a\\n$|AB|=\\\\sqrt{(x_2-x_1)^2+(y_2-y_1)^2+(z_2-z_1)^2}$.\"\n    }\n  ],\n  \"figures\": [\n    {\n      \"id\": \"fig-g10-06\",\n      \"label\": \"\\u56fe 6\"\n    },\n    {\n      \"id\": \"fig-g10-07\",\n      \"label\": \"\\u56fe 7\"\n    },\n    {\n      \"id\": \"fig-g10-08\",\n      \"label\": \"\\u56fe 8\"\n    },\n    {\n      \"id\": \"fig-g10-09\",\n      \"label\": \"\\u56fe 9\"\n    }\n  ]\n}\n",
