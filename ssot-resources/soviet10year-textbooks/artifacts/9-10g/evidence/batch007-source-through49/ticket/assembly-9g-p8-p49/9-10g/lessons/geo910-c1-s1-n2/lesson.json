  "chapter": "九年级",
  "section": "第一章　立体几何的基本概念．空间平行关系",
  "number": "2",
  "title": "立体几何的公理",
  "printed_title": "§2．立体几何的公理",
  "start_page": 10,
  "start_printed": 3,
  "figures": [
