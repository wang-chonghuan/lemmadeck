  "exercises": [
    {
      "number": "16",
      "text": "16$^{\\circ}$. \u5728\u4e0b\u5217\u6bcf\u79cd\u60c5\u5f62\u4e2d\uff0c\u7ecf\u8fc7\u6240\u7ed9\u7684\u70b9\u53ef\u4ee5\u6709\u591a\u5c11\u4e2a\u4e0d\u540c\u7684\u5e73\u9762\uff1f\n1) \u4e00\u4e2a\u70b9\uff1b\n2) \u4e24\u4e2a\u4e0d\u540c\u7684\u70b9\uff1b\n3) \u4e09\u4e2a\u4e0d\u540c\u7684\u70b9\uff1b\n4) \u56db\u4e2a\u70b9\uff0c\u5176\u4e2d\u4efb\u610f\u4e09\u4e2a\u4e0d\u5728\u540c\u4e00\u6761\u76f4\u7ebf\u4e0a\u3002",
      "figure_ids": []
    },
    {
      "number": "17",
      "text": "17. \u5df2\u77e5 $a\\cap b=A$\uff0c$a\\subset\\alpha$\u3002\u5224\u65ad\u4e0b\u5217\u7ed3\u8bba\u662f\u5426\u6b63\u786e\uff1a\n1) $A\\in\\alpha$\uff1b\n2) $b\\subset\\alpha$\u3002",
      "figure_ids": []
    },
    {
      "number": "18",
      "text": "18$^{\\circ}$.\n1) \u5df2\u77e5\u56db\u4e2a\u70b9\u4e0d\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u5185\u3002\u8bc1\u660e\uff1a\u5176\u4e2d\u4efb\u610f\u4e09\u4e2a\u70b9\u90fd\u4e0d\u5728\u540c\u4e00\u6761\u76f4\u7ebf\u4e0a\u3002\n2) \u9006\u547d\u9898\u662f\u5426\u6b63\u786e\uff1f",
      "figure_ids": []
    },
    {
      "number": "19",
      "text": "19$^{\\circ}$. \u56db\u4e2a\u70b9\u4e2d\u7684\u4efb\u610f\u4e09\u4e2a\u90fd\u4e0d\u5728\u540c\u4e00\u4e2a\u5706\u5468\u4e0a\u3002\u8fd9\u56db\u4e2a\u70b9\u662f\u5426\u5168\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u5185\uff1f",
      "figure_ids": []
    },
    {
      "number": "20",
      "text": "20. \u5df2\u77e5\u4e24\u6761\u4e0d\u91cd\u5408\u7684\u5e73\u884c\u76f4\u7ebf\u3002\u8bc1\u660e\uff1a\u6240\u6709\u4e0e\u8fd9\u4e24\u6761\u5df2\u77e5\u76f4\u7ebf\u90fd\u76f8\u4ea4\u7684\u76f4\u7ebf\uff0c\u5168\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u5185\u3002",
      "figure_ids": []
    },
    {
      "number": "21",
      "text": "21$^{\\circ}$. \u5df2\u77e5\u4e24\u6761\u76f8\u4ea4\u76f4\u7ebf\u3002\u6240\u6709\u4e0e\u8fd9\u4e24\u6761\u5df2\u77e5\u76f4\u7ebf\u90fd\u76f8\u4ea4\u7684\u76f4\u7ebf\uff0c\u5168\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u5185\u3002\u8fd9\u4e2a\u8bba\u65ad\u662f\u5426\u6b63\u786e\uff1f",
      "figure_ids": []
    },
    {
      "number": "22",
      "text": "22$^{\\circ}$. \u89d2\u7684\u4e24\u8fb9\u53ef\u80fd\u4e0e\u4e00\u4e2a\u5e73\u9762\u76f8\u4ea4\u4e8e\u4e00\u4e2a\u70b9\u3001\u4e24\u4e2a\u4e0d\u540c\u7684\u70b9\u3001\u4e09\u4e2a\u4e0d\u540c\u7684\u70b9\u5417\uff1f",
      "figure_ids": []
    },
    {
      "number": "23",
      "text": "23. \u5df2\u77e5\u4e00\u7ec4\u6709\u516c\u5171\u59cb\u70b9\u7684\u5c04\u7ebf\uff0c\u5176\u4e2d\u4efb\u610f\u4e09\u6761\u4e0d\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u5185\u3002\u7ecf\u8fc7\u6bcf\u4e24\u6761\u5df2\u77e5\u5c04\u7ebf\u4f5c\u4e00\u4e2a\u5e73\u9762\u3002\u5728\u4e0b\u5217\u6bcf\u79cd\u5c04\u7ebf\u603b\u6570\u7684\u60c5\u5f62\u4e2d\uff0c\u4e00\u5171\u53ef\u4ee5\u4f5c\u51fa\u591a\u5c11\u4e2a\u8fd9\u6837\u7684\u5e73\u9762\uff1f\n1) \u4e09\u6761\uff1b\n2) \u56db\u6761\uff1b\n3) $n$ \u6761\u3002",
      "figure_ids": []
    },
    {
      "number": "24",
      "text": "24. \u4e09\u4e2a\u4e0d\u540c\u7684\u5e73\u9762\u6709\u4e00\u4e2a\u516c\u5171\u70b9\u3002\u8bf4\u8fd9\u4e9b\u5e73\u9762\u6709\u516c\u5171\u76f4\u7ebf\uff0c\u662f\u5426\u6b63\u786e\uff1f\u5f53\u8fd9\u4e9b\u5e73\u9762\u4e24\u4e24\u76f8\u4ea4\u65f6\uff0c\u53ef\u4ee5\u5f97\u5230\u591a\u5c11\u6761\u4e0d\u540c\u7684\u76f4\u7ebf\uff1f",
      "figure_ids": []
    },
    {
      "number": "25",
      "text": "25.\n1) \u5df2\u77e5\u7ebf\u6bb5 $AB$\u3001$BC$\u3001$CD$\u3001$DA$\uff0c\u5e76\u4e14 $(AC)\\cap(BD)$ $=M$\u3002\u8bc1\u660e\uff1a\u8fd9\u4e9b\u7ebf\u6bb5\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u5185\u3002\n2) $^{\\circ}$ \u6728\u5de5\u7528\u4e24\u6761\u7ebf\u68c0\u67e5\u56db\u817f\u684c\u653e\u5728\u5730\u9762\u4e0a\u662f\u5426\u7a33\u5b9a\uff0c\u5e94\u8be5\u600e\u6837\u62c9\u7ebf\uff1f",
      "figure_ids": []
    },
    {
      "number": "26",
      "text": "26$^{\\circ}$.\n1) $P_1$ \u548c $P_2$ \u662f\u5177\u6709\u516c\u5171\u8fb9\u754c $\\alpha$ \u7684\u4e0d\u540c\u534a\u7a7a\u95f4\u3002\u6c42\uff1a\na) $P_1\\cap P_2$\uff1b\nb) $P_1\\cup P_2$\u3002\n2) \u5206\u522b\u8003\u8651\u4e0b\u5217\u6761\u4ef6\uff1a\na) $P\\cap Q=\\alpha$\uff1b\nb) $P\\cup Q=P\\cap Q$\u3002\n\n\u8bf4\u660e\u534a\u7a7a\u95f4 $P$ \u548c $Q$ \u53ca\u5b83\u4eec\u7684\u8fb9\u754c $\\alpha$ \u548c $\\beta$ \u7684\u76f8\u4e92\u4f4d\u7f6e\u5173\u7cfb\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "1.\n\u63a8\u8bba1\uff1a\u7ecf\u8fc7\u4e00\u6761\u76f4\u7ebf\u548c\u4e0d\u5728\u8fd9\u6761\u76f4\u7ebf\u4e0a\u7684\u4e00\u70b9\uff0c\u6709\u4e14\u4ec5\u6709\u4e00\u4e2a\u5e73\u9762\u3002"
    },
    {
      "block": 2,
      "text": "\u5982\u679c\u4e24\u6761\u76f4\u7ebf\u6709\u552f\u4e00\u7684\u516c\u5171\u70b9\uff08$a\\cap b=O$\uff1b\u56fe8\uff0cb\uff09\uff0c\u5c31\u79f0\u8fd9\u4e24\u6761\u76f4\u7ebf\u76f8\u4ea4\u3002"
    },
    {
      "block": 5,
      "text": "\u63a8\u8bba2\uff1a\u7ecf\u8fc7\u4e24\u6761\u76f8\u4ea4\u76f4\u7ebf\uff0c\u6709\u4e14\u4ec5\u6709\u4e00\u4e2a\u5e73\u9762\uff08\u81ea\u884c\u8bc1\u660e\uff09\u3002"
    },
    {
      "block": 6,
      "text": "\u5728\u7acb\u4f53\u51e0\u4f55\u4e2d\uff0c\u4ecd\u6cbf\u7528\u5e73\u9762\u51e0\u4f55\u4e2d\u5e73\u884c\u76f4\u7ebf\u7684\u5b9a\u4e49\uff1a\u5982\u679c\u4e24\u6761\u76f4\u7ebf\u5728\u540c\u4e00\u4e2a\u5e73\u9762\u5185\uff0c\u5e76\u4e14\u6ca1\u6709\u516c\u5171\u70b9\u6216\u8005\u91cd\u5408\uff0c\u5c31\u79f0\u8fd9\u4e24\u6761\u76f4\u7ebf\u5e73\u884c\uff08\u56fe9\uff0ca\u548cb\uff09\u3002"
    },
    {
      "block": 9,
      "text": "\u63a8\u8bba3\uff1a\u7ecf\u8fc7\u4e24\u6761\u4e0d\u540c\u7684\u5e73\u884c\u76f4\u7ebf\uff0c\u53ea\u80fd\u4f5c\u51fa\u4e00\u4e2a\u5e73\u9762\u3002"
    },
    {
      "block": 12,
      "text": "2.\n\u5df2\u77e5\u5e73\u9762 $\\alpha$\u3002\n\u8003\u8651\u7a7a\u95f4\u4e2d\u6240\u6709\u4e0d\u5c5e\u4e8e $\\alpha$ \u7684\u70b9\u7ec4\u6210\u7684\u96c6\u5408\u3002\n\n\u5e73\u9762 $\\alpha$ \u5c06\u8fd9\u4e2a\u70b9\u96c6\u5206\u6210\u4e24\u4e2a\u975e\u7a7a\u7684\u5b50\u96c6\uff0c\u5b83\u4eec\u79f0\u4e3a\u4ee5 $\\alpha$ \u4e3a\u8fb9\u754c\u7684\u534a\u5f00\u7a7a\u95f4\u3002\n\u4e0b\u9762\u5217\u51fa\u534a\u5f00\u7a7a\u95f4\u7684\u6027\u8d28\uff0c\u4e0d\u52a0\u8bc1\u660e\u5730\u627f\u8ba4\u5b83\u4eec\u6210\u7acb\uff08\u56fe10\uff0ca\u3001b\uff09\uff1a"
    },
    {
      "block": 13,
      "text": "1. \u8fde\u63a5\u540c\u4e00\u4e2a\u534a\u5f00\u7a7a\u95f4\u4e2d\u4efb\u610f\u4e24\u70b9\u7684\u7ebf\u6bb5\uff0c\u4e0e\u5b83\u7684\u8fb9\u754c\u4e0d\u76f8\u4ea4\u3002"
    },
    {
      "block": 14,
      "text": "2. \u8fde\u63a5\u5206\u522b\u5c5e\u4e8e\u6709\u5171\u540c\u8fb9\u754c\u7684\u4e24\u4e2a\u534a\u5f00\u7a7a\u95f4\u7684\u4efb\u610f\u4e24\u70b9\u7684\u7ebf\u6bb5\uff0c\u4e0e\u8fd9\u4e2a\u8fb9\u754c\u76f8\u4ea4\u3002"
    },
    {
      "block": 15,
      "text": "\u5982\u679c\u70b9 $A$ \u548c $B$ \u5c5e\u4e8e\u4ee5 $\\alpha$ \u4e3a\u8fb9\u754c\u7684\u540c\u4e00\u4e2a\u534a\u5f00\u7a7a\u95f4\uff0c\u5c31\u8bf4 $A$ \u548c $B$ \u4f4d\u4e8e\u5e73\u9762 $\\alpha$ \u7684\u540c\u4e00\u4fa7\uff08\u56fe10\uff0ca\uff09\u3002\n\u5982\u679c $A$ \u548c $B$ \u5c5e\u4e8e\u6709\u516c\u5171\u8fb9\u754c $\\alpha$ \u7684\u4e0d\u540c\u534a\u5f00\u7a7a\u95f4\uff0c\u5c31\u8bf4 $A$ \u548c $B$ \u4f4d\u4e8e\u5e73\u9762 $\\alpha$ \u7684\u5f02\u4fa7\uff08\u56fe10\uff0cb\uff09\u3002"
    },
    {
      "block": 18,
      "text": "\u534a\u5f00\u7a7a\u95f4\u4e0e\u5b83\u7684\u8fb9\u754c\u7684\u5e76\u96c6\uff0c\u79f0\u4e3a\u534a\u95ed\u7a7a\u95f4\uff08\u6216\u7b80\u79f0\u534a\u7a7a\u95f4\uff09\u3002"
    },
    {
      "block": 19,
      "text": "\u534a\u7a7a\u95f4\u662f\u51f8\u56fe\u5f62$^{*}$\u3002"
    },
    {
      "block": 20,
      "text": "* \u51f8\u56fe\u5f62\u7684\u5b9a\u4e49\uff0c\u662f\u5e73\u9762\u51e0\u4f55\u4e2d\u76f8\u5e94\u5b9a\u4e49\u5728\u7a7a\u95f4\u56fe\u5f62\u4e2d\u7684\u63a8\u5e7f\uff1a\u5982\u679c\u4e00\u4e2a\u56fe\u5f62\u5305\u542b\u8fde\u63a5\u5176\u4e2d\u4efb\u610f\u4e24\u70b9\u7684\u6574\u6761\u7ebf\u6bb5\uff0c\u5c31\u79f0\u8fd9\u4e2a\u56fe\u5f62\u4e3a\u51f8\u56fe\u5f62\u3002"
    }
  ],
