763-def figure_crop_exclusion(
764-    ink: np.ndarray, owned: np.ndarray, box: list[int]
765-) -> np.ndarray | None:
766-    """Remove foreign component edges captured by a snapped figure envelope."""
767-    x, y, w, h = box
768-    foreign = ink & ~owned
769-    if not foreign[max(0, y):y + h, max(0, x):x + w].any():
770-        return None
771-    return ndimage.binary_dilation(foreign, iterations=2) & ~owned
