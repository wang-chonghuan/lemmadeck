757:def figure_ink(ink: np.ndarray, box: list[int]) -> np.ndarray:
758-    """Use the same component ownership as snapping, not the rectangular envelope."""
759-    labels, selected, _ = _figure_components(ink, box)
760-    return np.isin(labels, selected)
