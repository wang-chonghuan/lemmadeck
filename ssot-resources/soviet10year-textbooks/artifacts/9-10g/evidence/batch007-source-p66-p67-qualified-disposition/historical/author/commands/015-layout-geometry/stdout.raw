463-        ):
464-            raw.append((rows.start, rows.stop - 1))
465-    raw.sort()
466-    merged = []
467-    merge_gap = max(2.0, GLYPH_GAP_FACTOR * min(line_h, glyph_h))
468-    for a, b in _merge_close(raw, 0):
469-        if merged:
470-            prev_a, prev_b = merged[-1]
471-            if _decorated_folio(ink, a, b, glyph_h):
472-                # A sparse digit neck can split one folio's row projection.
