449-    if not raw:
450-        return []
451-    line_h = int(np.median([b - a + 1 for a, b in raw]))
452-    # Projection thresholds can miss a narrow standalone quotient such as 1 or 7.
453-    for component_id, bounds in enumerate(ndimage.find_objects(components), 1):
454-        if bounds is None:
455-            continue
456-        rows, columns = bounds
457-        height, width = rows.stop - rows.start, columns.stop - columns.start
458-        if (
