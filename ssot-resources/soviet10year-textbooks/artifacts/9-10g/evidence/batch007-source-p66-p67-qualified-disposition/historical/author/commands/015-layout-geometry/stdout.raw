792:def crop(png: Path, box: list[int], out: Path, pad: int = 12,
793-         exclude: np.ndarray | None = None) -> None:
794-    with Image.open(png) as source:
795-        img = source.copy()
796-    if exclude is not None:
797-        if exclude.shape != (img.height, img.width) or exclude.dtype != bool:
798-            raise ValueError("crop exclusion must be a page-sized boolean mask")
799-        img = img.copy()
800-        white = 255 if img.mode == "L" else tuple(255 for _ in img.getbands())
801-        img.paste(white, mask=Image.fromarray(exclude.astype(np.uint8) * 255))
802-    x, y, w, h = box
803-    out.parent.mkdir(parents=True, exist_ok=True)
804-    left, top = max(0, x - pad), max(0, y - pad)
805-    right, bottom = min(img.width, x + w + pad), min(img.height, y + h + pad)
806-    white = 255 if img.mode == "L" else tuple(255 for _ in img.getbands())
807-    padded = Image.new(img.mode, (right - left, bottom - top), white)
808-    padded.paste(img.crop((x, y, x + w, y + h)), (x - left, y - top))
809-    padded.save(out)
