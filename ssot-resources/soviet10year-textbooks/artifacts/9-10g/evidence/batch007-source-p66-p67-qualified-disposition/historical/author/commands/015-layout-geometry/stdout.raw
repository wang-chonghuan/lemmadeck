812-def ink_coverage(ink: np.ndarray, boxes: list[list[int]]) -> dict:
813-    """墨迹里有多少落在给定框之外。用于「文字行数」以外的第二重体检。"""
814-    H, W = ink.shape
815-    cov = np.zeros_like(ink)
816-    for x, y, w, h in boxes:
817-        cov[max(0, y):min(H, y + h), max(0, x):min(W, x + w)] = True
818-    resid = ink & ~cov
819-    total = int(ink.sum())
820-    return {"ink_px": total, "outside_px": int(resid.sum()),
821-            "outside_ratio": round(int(resid.sum()) / max(total, 1), 5)}
