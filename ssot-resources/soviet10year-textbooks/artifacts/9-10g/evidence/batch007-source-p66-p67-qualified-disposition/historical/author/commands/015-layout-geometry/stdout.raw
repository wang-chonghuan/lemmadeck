390:def line_bands(ink: np.ndarray, content_w: int) -> list[tuple[int, int]]:
391-    """Count printed rows after masking model-identified figures."""
392-    # Work on a counting-only copy; extraction pixels are never changed.
393-    ink = ink.copy()
394-    edge = max(1, int(ink.shape[1] * 0.01))
395-    ink[:, :edge] = False
396-    ink[:, -edge:] = False
397-    raw = _row_fragments(ink, content_w)
398-    if not raw:
399-        return []
400-    line_h = int(np.median([b - a + 1 for a, b in raw]))
401-    components, _ = ndimage.label(ink)
402-    bounds_list = ndimage.find_objects(components)
403-    glyph_heights = [
404-        rows.stop - rows.start
405-        for bounds in bounds_list if bounds is not None
406-        for rows, columns in [bounds]
407-        if 0.25 * line_h <= rows.stop - rows.start <= 1.3 * line_h
408-        and 0.2 * line_h <= columns.stop - columns.start <= 1.3 * line_h
409-    ]
410-    glyph_h = (
411-        float(np.percentile(glyph_heights, 75)) if len(glyph_heights) >= 3 else line_h
412-    )
413-    # Dense, joined shallow blemishes are not glyphs or thin fraction rules.
414-    # Remove them only when they occupy an otherwise isolated projection row.
415-    for component_id, bounds in enumerate(bounds_list, 1):
416-        if bounds is None:
417-            continue
418-        rows, columns = bounds
419-        height, width = rows.stop - rows.start, columns.stop - columns.start
420-        area = np.count_nonzero(components[bounds] == component_id)
421-        if (
422-            0.35 * glyph_h <= height <= 0.65 * glyph_h
423-            and width >= 1.5 * glyph_h
424-            and area >= 0.35 * width * height
425-            and any(
426-                a - 0.15 * glyph_h <= rows.start
427-                and rows.stop - 1 <= b + 0.15 * glyph_h
428-                and b - a + 1 <= 0.65 * glyph_h
429-                and np.count_nonzero(ink[a:b + 1]) <= area * 1.1
430-                for a, b in raw
431-            )
432-        ):
433-            region = ink[bounds]
434-            region[components[bounds] == component_id] = False
435-    for component_id, bounds in enumerate(ndimage.find_objects(components), 1):
436-        if bounds is None:
437-            continue
438-        rows, columns = bounds
439-        height, width = rows.stop - rows.start, columns.stop - columns.start
440-        if height > 1.8 * line_h and width < 0.5 * line_h and width < 0.2 * height:
441-            stroke = components[bounds] == component_id
442-            row_widths = stroke.sum(axis=1)
443-            # Delimiter ends/hooks widen across the stem; a plain streak does not.
444-            if row_widths.max() > 2 * np.median(row_widths):
