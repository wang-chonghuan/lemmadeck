774:def snap(ink: np.ndarray, box: list[int]) -> tuple[list[int], dict]:
775-    """把粗框吸附到它覆盖的连通域上，按落在框内的比例认领墨迹。"""
776-    x, y, w, h = box
777-    H, W = ink.shape
778-    x0, y0 = max(0, x), max(0, y)
779-    x1, y1 = min(W - 1, x + w - 1), min(H - 1, y + h - 1)
780-    _, selected, boxes = _figure_components(ink, box)
781-    nx0, ny0, nx1, ny1 = x1, y1, x0, y0
782-    for lab in selected:
783-        sy, sx = boxes[lab - 1]
784-        nx0, ny0 = min(nx0, sx.start), min(ny0, sy.start)
785-        nx1, ny1 = max(nx1, sx.stop - 1), max(ny1, sy.stop - 1)
786-    if not selected:
787-        return [x0, y0, x1 - x0 + 1, y1 - y0 + 1], {"components": 0}
788-    return [int(nx0), int(ny0), int(nx1 - nx0 + 1), int(ny1 - ny0 + 1)],  {
789-        "components": len(selected), "from": box}
