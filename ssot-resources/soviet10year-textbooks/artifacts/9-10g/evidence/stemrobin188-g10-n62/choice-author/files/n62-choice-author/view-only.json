      "id": "n62-center-invariant",
      "source_numbers": ["216"],
      "view": {
        "mode": "single",
        "stem": "球体的球心为 $S$，半径为 $R>0$。对球体中的任意一点 $M$，记中心对称变换后的点为 $M'=2S-M$。下列哪项关系可以作为这个变换把整个球体映回自身的决定性论据？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$|SM'|=2|SM|$，且对 $M'$ 再作同一变换得到 $M$。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$|SM'|=|SM|$，且对 $M'$ 再作同一变换得到 $M$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$|SM'|=R-|SM|$，且对 $M'$ 再作同一变换得到 $M$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$|SM'|=R$，且对 $M'$ 再作同一变换得到 $M$。",
            "figure_ids": []
          }
        ]
      }
    },
