  "prose": [
    {
      "kind": "p",
      "text": "加法的交换律和结合律对于任何数都成立. 在分数的加法和减法中应用这些定律.",
      "id": null,
      "label": null,
      "printed_page": 225,
      "source_refs": [
        "p0234#7"
      ]
    },
    {
      "kind": "p",
      "text": "例1. 求$5-\\frac{4}{9}$的值：$5-\\frac{4}{9}=4+1-\\frac{4}{9}=4+\\frac{5}{9}=4\\frac{5}{9}$.",
      "id": null,
      "label": null,
      "printed_page": 225,
      "source_refs": [
        "p0234#8"
      ]
    },
    {
      "kind": "p",
      "text": "例2. 求$3-1\\frac{3}{7}$的值：$3-1\\frac{3}{7}=3-1-\\frac{3}{7}=2-\\frac{3}{7}=1\\frac{4}{7}$.",
      "id": null,
      "label": null,
      "printed_page": 225,
      "source_refs": [
        "p0234#9",
        "p0235#1"
      ]
    },
    {
      "kind": "p",
      "text": "例3. 求$2\\frac{3}{5}+1\\frac{1}{4}$的值：$2\\frac{3}{5}+1\\frac{1}{4}=2+\\frac{3}{5}+1+\\frac{1}{4}=3+\\frac{3}{5}+\\frac{1}{4}=3+\\frac{17}{20}=3\\frac{17}{20}$.",
      "id": null,
      "label": null,
      "printed_page": 226,
      "source_refs": [
        "p0235#2"
      ]
    },
    {
      "kind": "p",
      "text": "例4. 求$4\\frac{1}{6}-1\\frac{3}{4}$的值：$4\\frac{1}{6}-1\\frac{3}{4}=3+\\frac{1}{6}-\\frac{3}{4}=3+\\frac{4-18}{6\\cdot4}=3+\\frac{-14}{6\\cdot4}=3-\\frac{7}{12}=2\\frac{5}{12}$.",
      "id": null,
      "label": null,
      "printed_page": 226,
      "source_refs": [
        "p0235#3"
      ]
    },
    {
      "kind": "p",
      "text": "例5. 求$-2\\frac{3}{10}+1\\frac{2}{15}$的值：$-2\\frac{3}{10}+1\\frac{2}{15}=-2-\\frac{3}{10}+1+\\frac{2}{15}=-1+\\frac{-3}{10}+\\frac{2}{5}=-1+\\frac{-25}{10\\cdot15}=-1-\\frac{1}{6}=-1\\frac{1}{6}$.",
      "id": null,
      "label": null,
      "printed_page": 226,
      "source_refs": [
        "p0235#4"
      ]
    }
  ]
}
