  "chapter": "第一章　正数和负数",
  "section": "§ 3. 加法和减法",
  "number": "21",
  "title": "加法的性质",
  "printed_title": "21. 加法的性质",
  "start_page": 85,
  "start_printed": 76,
  "figures": [
    {
      "id": "tbl-p0085-01",
      "label": "竖式",
