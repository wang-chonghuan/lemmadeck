  "section": "§8. 圆周长和圆的面积",
  "number": "58",
  "title": "无限小数",
  "printed_title": "58. 无限小数",
  "start_page": 257,
  "start_printed": 248,
  "figures": [
    {
      "id": "tbl-p0257-01",
      "label": "竖式",
      "page": 257
    },
    {
      "id": "tbl-p0258-01",
      "label": "竖式",
