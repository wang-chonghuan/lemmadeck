      "open": false,
      "samerow": false,
      "lines": [
        "求两点$A(a)$和$B(b)$间的距离，设：",
        "1) $a=2,b=8$；　　3) $a=-1,b=6$；",
        "2) $a=-3,b=-5$；4) $a=5,b=-4$."
      ]
