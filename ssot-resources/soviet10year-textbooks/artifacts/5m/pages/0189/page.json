      "cont": false,
      "open": false,
      "samerow": false,
      "lines": [
        "796. 求点$M(x,y)$在坐标平面上的位置，当",
        "1) $2\\leqslant x\\leqslant6$；　　　2) $3\\leqslant y\\leqslant5$时."
      ]
    },
