      "owner_exercise": null,
      "cont": false,
      "open": false,
      "samerow": false,
      "lines": [
        "794. 证明不等式：",
        "1) $\\frac{200}{4201}<\\frac{1}{20}$；　　　2) $\\frac{125}{361}>\\frac{1}{3}$."
      ]
    },
    {
      "kind": "ex",
