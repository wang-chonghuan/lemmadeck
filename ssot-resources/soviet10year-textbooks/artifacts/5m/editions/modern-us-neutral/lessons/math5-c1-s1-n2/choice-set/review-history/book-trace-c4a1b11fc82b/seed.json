  },
  "exercises": [
    {
      "number": "20",
      "text": "\u7167\u56fe 6.2 \u5199\u51fa\u96c6\u5408 $M$ \u548c\u96c6\u5408 $N$ \u4ee5\u53ca\u5b83\u4eec\u7684\u4ea4\u96c6.",
      "figure_ids": [
        "fig-06-1",
        "fig-06-2"
      ]
    },
    {
      "number": "21",
      "text": "\u5199\u51fa 12 \u7684\u7ea6\u6570\u7684\u96c6\u5408\u548c 18 \u7684\u7ea6\u6570\u7684\u96c6\u5408. \u627e\u51fa\u8fd9\u4e24\u4e2a\u96c6\u5408\u7684\u4ea4\u96c6. 12 \u548c 18 \u7684\u6700\u5927\u516c\u7ea6\u6570\u662f\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "22",
      "text": "\u96c6\u5408 $A$ \u7531\u524d 10 \u4e2a 4 \u7684\u500d\u6570\u7684\u81ea\u7136\u6570\u7ec4\u6210\uff0c\u800c\u96c6\u5408 $B$ \u5219\u7531\u524d 10 \u4e2a 6 \u7684\u500d\u6570\u7684\u81ea\u7136\u6570\u7ec4\u6210. \u627e\u51fa $A$ \u548c $B$ \u7684\u4ea4\u96c6. 4\u4e0e 6 \u7684\u6700\u5c0f\u516c\u500d\u6570\u662f\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "23",
      "text": "\u5728\u5c04\u7ebf\u4e0a\u6807\u51fa 3, 8, 5, 10 \u7684\u5bf9\u5e94\u70b9 $A, B, C, D$. \u54ea\u4e2a\u7ebf\u6bb5\u662f $AB$ \u548c $CD$ \u4e8c\u7ebf\u6bb5\u7684\u4ea4\u96c6\uff1f \u5199\u51fa\u7b54\u6848.",
      "figure_ids": []
    },
    {
      "number": "24",
      "text": "\u627e\u51fa\u7ec4\u6210 \u201cmathematics\u201d \u4e00\u8bcd\u7684\u4e0d\u540c\u5b57\u6bcd\u7684\u96c6\u5408\u548c\u7ec4\u6210\u201cgrammar\u201d\u4e00\u8bcd\u7684\u4e0d\u540c\u5b57\u6bcd\u7684\u96c6\u5408\u7684\u4ea4\u96c6.",
      "figure_ids": []
    },
    {
      "number": "25",
      "text": "\u627e\u51fa\u5076\u6570\u96c6\u5408 $A$ \u548c\u5947\u6570\u96c6\u5408 $B$ \u7684\u4ea4\u96c6.",
      "figure_ids": []
    },
    {
      "number": "26",
      "text": "\u7528 $X$ \u8868\u793a\u4e0d\u7b49\u5f0f $5<x<9$ \u7684\u81ea\u7136\u6570\u89e3\u7684\u96c6\u5408\uff0c\u7528 $Y$ \u8868\u793a\u4e0d\u7b49\u5f0f $2<y<7$ \u7684\u81ea\u7136\u6570\u89e3\u7684\u96c6\u5408. \u5728\u5927\u62ec\u53f7\u5185\u5199\u51fa $X$\u548c $Y$ \u7684\u4ea4\u96c6.",
      "figure_ids": []
    },
    {
      "number": "27",
      "text": "\u201c\u5728\u957f\u6ee1\u9752\u82d4\u7684\u6cbc\u6cfd\u5730\u91cc\uff0c\u9c9c\u7ea2\u7684\u8513\u8d8a\u6854\u7684\u679c\u5b9e\u6210\u4e32\u5730\u6563\u843d\u5728\u571f\u58a9\u4e0a\u201d\uff0c\u4ece\u8fd9\u4e2a\u53e5\u5b50\u7684\u5355\u8bcd\u7684\u96c6\u5408\u4e2d\u9009\u51fa\u5b50\u96c6\uff1a\n1\uff09\u540d\u8bcd\uff1b\n2\uff09\u52a8\u8bcd\uff1b\n3\uff09\u5f62\u5bb9\u8bcd\uff1b\n4\uff09\u6570\u8bcd.",
      "figure_ids": []
    },
    {
      "number": "28",
      "text": "\u5199\u51fa\u96c6\u5408 $\\{1, 2, 3\\}$ \u7684\u5168\u90e8\u5b50\u96c6.",
      "figure_ids": []
    },
    {
      "number": "29",
      "text": "\u56fe 7 \u4e2d $AOB$ \u89d2\u7684\u70b9\u7684\u96c6\u5408\u6d82\u6709\u9634\u5f71. \u8fd9\u4e2a\u70b9\u7684\u96c6\u5408\u662f\u4e24\u4e2a\u5e73\u89d2\u7684\u70b9\u7684\u96c6\u5408\u7684\u5b50\u96c6. \u6307\u51fa\u8fd9\u4e24\u4e2a\u5e73\u89d2\u5e76\u8bf4\u51fa\u540d\u79f0.",
      "figure_ids": [
        "fig-07"
      ]
    },
    {
      "number": "30",
      "text": "\u67d0\u6280\u672f\u5458\u4e03\u6708\u4efd\u6536\u5165 140 \u7f8e\u5143. \u516b\u6708\u4efd\u4ed6\u6539\u8fdb\u4e86\u5de5\u4f5c\u65b9\u6cd5\uff0c\u63d0\u9ad8\u4e86\u6548\u7387\uff0c\u6536\u5165\u589e\u52a0\u4e86 17%. \u8fd9\u4e2a\u6280\u672f\u5458\u5728\u516b\u6708\u4efd\u6536\u5165\u591a\u5c11\u7f8e\u5143\uff1f",
      "figure_ids": []
    },
    {
      "number": "31",
      "text": "\u51b3\u5b9a\u70d8\u5e72 150 \u516c\u65a4\u6a31\u6843. \u70d8\u5e72\u65f6\uff0c\u6a31\u6843\u7684\u91cd\u91cf\u51cf\u8f7b 80%. \u70d8\u5e72\u540e\u5f97\u6a31\u6843\u591a\u5c11\u516c\u65a4\uff1f",
      "figure_ids": []
    },
    {
      "number": "32",
      "text": "\u8ba1\u7b97\uff1a\n1\uff09$4.76 + 3.24 : 0.8 + (0.623 + 1.12 \\cdot 3.8) : 4.1$\uff1b\n2\uff09$3.92 + 4.41 : 0.7 + (1.59 + 1.21 \\cdot 2.6) : 3.2$.",
      "figure_ids": []
    },
    {
      "number": "33",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1\uff09$3.7 \\cdot (x - 2.5) = 186.85$\uff1b\n2\uff09$(y + 3.8) \\cdot 2.9 = 60.61$.",
      "figure_ids": []
    },
    {
      "number": "34",
      "text": "\u5047\u8bbe\uff1a\n1\uff09$A$={5, 10, 15, 20, 25}\uff0c $B$={15, 20, 25, 30, 35}\uff1b\n2\uff09$A$={a, b, c, d, e, f}\uff0c $B$={a, c, d, f}\uff0c\u5728\u5927\u62ec\u53f7\u5185\u5199\u51fa $A$ \u548c $B$ \u7684\u4ea4\u96c6.",
      "figure_ids": []
    },
    {
      "number": "35",
      "text": "\u56fe 8 \u4e2d\u7528\u5706\u5f27\u6807\u51fa\u5e73\u89d2 $AOB$\u548c $COD$. \u5199\u51fa\u8fd9\u4e24\u4e2a\u89d2\u7684\u4ea4\u96c6\u662f\u54ea\u4e2a\u89d2.",
      "figure_ids": [
        "fig-08"
      ]
    },
    {
      "number": "36",
      "text": "\u8bbe\uff1a\n1\uff09$X=20$\uff0c $Y=30$\uff1b\n2\uff09$X=36$\uff0c $Y=24$\uff0c\u5199\u51fa\u6570 $X$ \u7684\u7ea6\u6570\u7684\u96c6\u5408\u548c\u6570 $Y$ \u7684\u7ea6\u6570\u7684\u96c6\u5408. \u627e\u51fa\u8fd9\u4e24\u4e2a\u96c6\u5408\u7684\u4ea4\u96c6.",
      "figure_ids": []
    },
    {
      "number": "37",
      "text": "\u96c6\u5408 $M$ \u7531\u524d 10 \u4e2a 3 \u7684\u500d\u6570\u7684\u81ea\u7136\u6570\u7ec4\u6210\uff0c\u96c6\u5408 $K$ \u7531\u524d 10\u4e2a 5 \u7684\u500d\u6570\u7684\u81ea\u7136\u6570\u7ec4\u6210. \u627e\u51fa $M$ \u548c $K$ \u7684\u4ea4\u96c6.",
      "figure_ids": []
    },
    {
      "number": "38",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1\uff09$18.305 : 0.7 - 0.0368 : 0.4 + 0.492 : 1.2$\uff1b\n2\uff09$(21.62 \\cdot 3.5 - 52.08 : 8.4) \\cdot 0.5$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 4,
      "text": "**\u7531\u4e24\u4e2a\u96c6\u5408\u7684\u516c\u5171\u5143\u7d20\u7ec4\u6210\u7684\u96c6\u5408\u53eb\u4f5c\u8fd9\u4e24\u4e2a\u96c6\u5408\u7684\u4ea4\u96c6.**"
