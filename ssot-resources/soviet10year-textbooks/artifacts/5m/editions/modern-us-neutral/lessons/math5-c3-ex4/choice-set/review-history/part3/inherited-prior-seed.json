    {
      "number": "1277",
      "text": "1277. Jamie\u4e70\u4e86\u4e09\u5305\u82b1\u751f\u7c73\uff0cAlex\u4e70\u4e86\u4e24\u5305\u82b1\u751f\u7c73\uff0c\u51c6\u5907\u548cCasey\u4e09\u4eba\u5e73\u5206. \u8ba1\u7b97\u7ed3\u679c\uff0cCasey\u5e94\u7ed9\u4ed6\u4eec\u4fe925\u7f8e\u5206. \u5176\u4e2dJamie\u548cAlex\u5404\u5e94\u5f97\u591a\u5c11\u7f8e\u5206\uff1f\u4e00\u5305\u82b1\u751f\u7c73\u591a\u5c11\u94b1\uff1f",
