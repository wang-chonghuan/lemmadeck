    {
      "number": "1275",
      "text": "1275. \u628a\u4e00\u4e2a\u91cd600\u514b\u7684\u5927\u86cb\u7cd5\u5207\u6210\u591a\u5c11\u5757\u624d\u80fd\u5e73\u5747\u5206\u7ed9\u4e09\u4e2a\u4eba\uff0c\u4e5f\u80fd\u5e73\u5747\u5206\u7ed9\u56db\u4e2a\u4eba\uff0c\u8bd5\u8bd5\u770b\uff0c\u600e\u6837\u5206\u6cd5\u624d\u80fd\u4f7f\u5207\u7684\u5757\u6570\u6700\u5c11\uff1f",
