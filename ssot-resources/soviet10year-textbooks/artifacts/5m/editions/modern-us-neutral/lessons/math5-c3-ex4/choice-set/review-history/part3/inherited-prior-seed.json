    {
      "number": "1260",
      "text": "1260. \u4e00\u4e2a\u7bb1\u5b50\u4e2d\u670910\u53cc\u5496\u5561\u8272\u889c\u5b50\uff0c10\u53cc\u9ed1\u8272\u889c\u5b50\uff0c\u53e6\u4e00\u7bb1\u4e2d\u670910\u526f\u5496\u5561\u8272\u624b\u5957\u548c10\u526f\u9ed1\u8272\u624b\u5957. \u95ed\u7740\u773c\u775b\u4ece\u8fd9\u4e24\u4e2a\u7bb1\u5b50\u53d6\u51fa\u51e0\u53ea\u889c\u5b50\u548c\u51e0\u53ea\u624b\u5957. \u82e5\u60f3\u4ece\u53d6\u51fa\u7684\u889c\u5b50\u548c\u624b\u5957\u4e2d\uff0c\u914d\u6210\u4e00\u53cc\u76f8\u540c\u989c\u8272\u7684\u889c\u5b50\u548c\u4e00\u526f\u76f8\u540c\u989c\u8272\u7684\u624b\u5957(\u5168\u90e8\u889c\u5b50\u548c\u5168\u90e8\u624b\u5957\u7684\u5c3a\u7801\u90fd\u76f8\u540c)\uff0c\u6700\u5c11\u5f97\u4ece\u7bb1\u5b50\u91cc\u53d6\u51fa\u51e0\u53ea\u889c\u5b50\u548c\u51e0\u53ea\u624b\u5957\uff1f",
      "figure_ids": []
    },
    {
      "number": "1261",
      "text": "1261. \u67d0\u4eba\u4ee510\u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u9a91\u81ea\u884c\u8f66\u4ece\u4e00\u4e2a\u57ce\u5e02\u5230\u53e6\u5916\u4e00\u4e2a\u57ce\u5e02. \u5047\u5982\u4ed6\u9a91\u8f66\u7684\u901f\u5ea6\u662f12\u516c\u91cc/\u5c0f\u65f6\uff0c\u90a3\u4e48\u4ed6\u5c31\u80fd\u63d0\u524d4\u5c0f\u65f6\u5230\u8fbe\u8981\u53bb\u7684\u57ce\u5e02. \u4e24\u4e2a\u57ce\u5e02\u4e4b\u95f4\u7684\u8ddd\u79bb\u662f\u591a\u5c11\u516c\u91cc\uff1f",
      "figure_ids": []
    },
    {
      "number": "1262",
      "text": "1262. \u7532\u3001\u4e59\u4e24\u4e2a\u65c5\u6e38\u7ad9\u76f8\u8ddd46\u516c\u91cc. \u4e00\u6279\u65c5\u884c\u5bb6\u4ece\u7532\u7ad9\u51fa\u53d1\u5230\u4e59\u7ad9\u53bb\uff0c\u884c\u901f\u4e3a5\u516c\u91cc/\u5c0f\u65f6. \u4e24\u5c0f\u65f6\u4ee5\u540e\u53e6\u4e00\u6279\u65c5\u884c\u5bb6\u4ece\u4e59\u7ad9\u51fa\u53d1\u4ee54\u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u548c\u7b2c\u4e00\u6279\u65c5\u884c\u5bb6\u76f8\u5411\u800c\u884c. \u7b2c\u4e8c\u6279\u51fa\u53d1\u540e\u51e0\u5c0f\u65f6\u624d\u80fd\u548c\u7b2c\u4e00\u6279\u76f8\u9047\uff1f",
      "figure_ids": []
    },
    {
      "number": "1263",
      "text": "1263. \u6709\u8f68\u7535\u8f66\u4e0a\u7684\u4e00\u4e2a\u4e58\u5ba2\u53d1\u73b0\u4e00\u4e2a\u719f\u4eba\u6cbf\u7740\u7535\u8f66\u7ebf\u8def\u5f80\u76f8\u53cd\u7684\u65b9\u5411\u8d70\u53bb. 10\u79d2\u949f\u540e\uff0c\u8fd9\u4e2a\u4e58\u5ba2\u4e0b\u8f66\u8ffd\u8d76\u719f\u4eba.\u5982\u679c\u4ed6\u884c\u8d70\u7684\u901f\u5ea6\u662f\u4ed6\u7684\u719f\u4eba\u884c\u8d70\u901f\u5ea6\u76842\u500d\uff0c\u7535\u8f66\u901f\u5ea6\u662f\u4ed6\u884c\u8d70\u901f\u5ea6\u76845\u500d\uff0c\u51e0\u79d2\u949f\u540e\uff0c\u4ed6\u624d\u80fd\u8ffd\u4e0a\u719f\u4eba.",
      "figure_ids": []
    },
    {
      "number": "1264",
      "text": "1264. \u4e00\u4eba\u4e58\u6469\u6258\u8f66\u4ece\u7532\u5e02\u5230\u4e59\u5e02\u53bb. \u5047\u5982\u4ed6\u4e58\u6469\u6258\u8f66\u7684\u901f\u5ea6\u662f35\u516c\u91cc/\u5c0f\u65f6\uff0c\u4ed6\u5c06\u665a\u52302\u5c0f\u65f6\uff0c\u5047\u5982\u901f\u5ea6\u662f50\u516c\u91cc/\u5c0f\u65f6\uff0c\u4ed6\u5c06\u63d0\u524d1\u5c0f\u65f6\u5230\u8fbe\uff0c\u6c42\u51fa\u7532\u4e59\u4e24\u5e02\u4e4b\u95f4\u7684\u8ddd\u79bb\u548c\u4ed6\u51c6\u65f6\u5230\u8fbe\u6240\u9700\u7684\u65f6\u95f4.",
      "figure_ids": []
    },
    {
      "number": "1265",
      "text": "1265. \u706b\u8f66\u752845\u79d2\u949f\u901a\u8fc7\u4e00\u5ea7\u957f450\u7c73\u7684\u6865\u6881\uff0c\u901a\u8fc7\u6273\u9053\u623f\u970015\u79d2\u949f. \u8ba1\u7b97\u5217\u8f66\u7684\u957f\u5ea6\u548c\u884c\u901f.",
      "figure_ids": []
    },
    {
      "number": "1266",
      "text": "1266. \u706b\u8f66\u4ece\u7532\u7ad9\u5230\u4e59\u7ad9\u9700\u898110\u5c0f\u65f6. \u5047\u5982\u706b\u8f66\u7684\u884c\u901f\u5feb10\u516c\u91cc/\u5c0f\u65f6\uff0c\u90a3\u4e48\u5c31\u53ef\u4ee5\u57288\u5c0f\u65f6\u5185\u8d70\u5b8c\u8fd9\u6bb5\u8def\u7a0b.\u6c42\u706b\u8f66\u7684\u884c\u901f\u548c\u7532\u3001\u4e59\u4e24\u7ad9\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "1267",
      "text": "1267. \u6ed1\u96ea\u8fd0\u52a8\u5458\u8ba1\u7b97\uff0c\u5047\u5982\u4ed6\u6ed1\u96ea\u7684\u901f\u5ea6\u662f\u6bcf\u5c0f\u65f610\u516c\u91cc\uff0c\u90a3\u4e48\u4ed6\u5c06\u5728\u4e0b\u5348\u4e00\u65f6\u5230\u8fbe\u6307\u5b9a\u5730\u70b9\uff0c\u5047\u5982\u6ed1\u96ea\u901f\u5ea6\u4e3a\u6bcf\u5c0f\u65f615\u516c\u91cc\u65f6\uff0c\u5c31\u80fd\u5728\u5348\u524d11\u65f6\u5230\u8fbe. \u6ed1\u96ea\u8fd0\u52a8\u5458\u5e94\u4ee5\u591a\u5927\u901f\u5ea6\u6ed1\u96ea\u624d\u80fd\u5728\u6b63\u5348\u5230\u8fbe\u6307\u5b9a\u5730\u70b9\uff1f\u6ed1\u96ea\u7684\u8ddd\u79bb\u591a\u8fdc\uff1f",
      "figure_ids": []
    },
    {
      "number": "1268",
      "text": "1268. \u7ed9Alex\u548cLena\u5404\u4e70\u4e86\u5927\u8863\u3001\u76ae\u978b\u3001\u5e3d\u5b50\uff0c\u5171\u4ed8\u4e8675\u7f8e\u5143. \u7ed9Alex\u4e70\u7684\u6bcf\u6837\u4e1c\u897f\u7684\u4ef7\u94b1\u90fd\u662f\u7ed9Lena\u4e70\u7684\u4e1c\u897f\u76841.5\u500d. Alex\u7684\u5927\u8863\u7684\u4ef7\u94b1\u662f\u4ed6\u7684\u5e3d\u5b50\u7684\u4ef7\u94b1\u768410\u500d\uff0c\u662fLena\u7684\u76ae\u978b\u548c\u5e3d\u5b50\u7684\u4ef7\u94b1\u76843\u500d. \u6240\u4e70\u7684\u6bcf\u6837\u4e1c\u897f\u5404\u662f\u591a\u5c11\u94b1\uff1f",
      "figure_ids": []
    },
    {
      "number": "1269",
      "text": "1269. \u5272\u8349\u961f\u7b2c\u4e00\u5929\u5272\u5b8c\u4e86\u534a\u5757\u8349\u5730\u96f62\u516c\u9877\uff0c\u7b2c\u4e8c\u5929\u5272\u5b8c\u5269\u4f59\u90e8\u5206\u768425%\u548c\u6700\u540e\u76846\u516c\u9877. \u6c42\u8349\u5730\u7684\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "1270",
      "text": "1270. \u91c7\u96c6\u4e86100\u516c\u65a4\u8611\u83c7. \u8611\u83c7\u7684\u542b\u6c34\u91cf\u4e3a99%\uff0c\u7a0d\u667e\u6652\u540e\u6c34\u5206\u964d\u4f4e\u523098%. \u8611\u83c7\u667e\u6652\u540e\u7684\u91cd\u91cf\u662f\u591a\u5c11\u516c\u65a4\uff1f",
      "figure_ids": []
    },
    {
      "number": "1271",
      "text": "1271. \u67d0\u65c5\u884c\u5bb6\u5728\u516c\u5171\u6c7d\u8f66\u4e0a\u770b\u5230\u91cc\u7a0b\u6807\u4e0a\u5199\u7740\u4e00\u4e2a\u4e24\u4f4d\u6570. \u540e\u6765\u4ed6\u7761\u7740\u4e86\uff0c\u4e00\u5c0f\u65f6\u540e\u4ed6\u9192\u6765\u770b\u89c1\u91cc\u7a0b\u6807\u4e0a\u5199\u7740\u4e00\u4e2a\u4e09\u4f4d\u6570. \u5b83\u7684\u7b2c\u4e00\u4e2a\u6570\u5b57\u548c\u4e00\u5c0f\u65f6\u4ee5\u524d\u7684\u7b2c\u4e8c\u4f4d\u6570\u4e00\u6837\uff0c\u7b2c\u4e8c\u4f4d\u6570\u662f\u96f6\uff0c\u7b2c\u4e09\u4f4d\u6570\u548c\u4e00\u5c0f\u65f6\u4ee5\u524d\u7684\u7b2c\u4e00\u4f4d\u6570\u76f8\u540c. \u7ecf\u8fc7\u4e24\u5c0f\u65f6\u4ee5\u540e\uff0c\u4ed6\u4ece\u516c\u5171\u6c7d\u8f66\u7684\u7a97\u5b50\u770b\u5230\u91cc\u7a0b\u6807\u4e0a\u5199\u7684\u6570\u4e0e\u4e24\u5c0f\u65f6\u4ee5\u524d\u7684\u6570\u76f8\u6bd4\uff0c\u53ea\u4e0d\u8fc7\u662f\u96f6\u6362\u6210\u53e6\u5916\u4e00\u4e2a\u6570\u5b57. \u6c42\u6c7d\u8f66\u7684\u901f\u5ea6.",
      "figure_ids": []
    },
    {
      "number": "1272",
      "text": "1272. \u67d0\u65c5\u884c\u5bb6\u8981\u901a\u8fc7\u6c99\u6f20\uff0c\u5168\u7a0b80\u516c\u91cc. \u4ed6\u4e00\u5929\u8d7020\u516c\u91cc\uff0c\u6700\u591a\u80fd\u643a\u5e26\u4e09\u5929\u7528\u7684\u98df\u7269\u548c\u6c34. \u6240\u4ee5\u4ed6\u4e00\u5b9a\u8981\u5728\u9014\u4e2d\u8bbe\u4e00\u4e2a\u7ad9\u5b58\u653e\u98df\u7269\u548c\u6c34. \u4ed6\u51e0\u5929\u80fd\u901a\u8fc7\u6c99\u6f20\uff1f",
      "figure_ids": []
    },
    {
      "number": "1273",
      "text": "1273. \u67d0\u5e02\u7684\u90e8\u5206\u5c45\u6c11\u53ea\u4f1a\u8bb2\u82f1\u8bed\uff0c\u90e8\u5206\u5c45\u6c11\u53ea\u4f1a\u8bb2\u897f\u73ed\u7259\u8bed\uff0c\u8fd8\u6709\u90e8\u5206\u5c45\u6c11\u8fd9\u4e24\u79cd\u8bed\u8a00\u90fd\u80fd\u8bb2. \u8bb2\u897f\u73ed\u7259\u8bed\u7684\u5c45\u6c11\u536085%\uff0c\u8bb2\u82f1\u8bed\u7684\u536075%. \u80fd\u8bb2\u4e24\u79cd\u8bed\u8a00\u7684\u5c45\u6c11\u5360\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "1274",
      "text": "1274. \u628a\u4e03\u4e2a\u82f9\u679c\u5e73\u5747\u5206\u7ed912\u4e2a\u4eba\uff0c\u6bcf\u4e2a\u82f9\u679c\u90fd\u4e0d\u5f97\u5207\u6210\u4e94\u74e3\u4ee5\u4e0a. \u5982\u4f55\u5206\u6cd5\uff1f",
