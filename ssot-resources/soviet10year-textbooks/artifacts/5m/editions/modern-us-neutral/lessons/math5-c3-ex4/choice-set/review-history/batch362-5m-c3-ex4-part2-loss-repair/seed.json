      ]
    },
    {
      "number": "1247",
      "text": "1247. \u628a10\u4e2a\u70b9\u6392\u5217\u57285\u6761\u7ebf\u6bb5\u4e0a\uff0c\u4f7f\u6bcf\u6761\u7ebf\u6bb5\u4e0a\u5404\u67094\u4e2a\u70b9.",
      "figure_ids": []
    },
    {
      "number": "1248",
      "text": "1248. \u628a6\u4e2a\u70b9\u6392\u5217\u57284\u6761\u7ebf\u6bb5\u4e0a\uff0c\u4f7f\u6bcf\u6761\u7ebf\u6bb5\u4e0a\u5404\u67093\u4e2a\u70b9.",
      "figure_ids": []
    },
    {
      "number": "1249",
      "text": "1249. 10\u5377\u513f\u7ae5\u767e\u79d1\u5168\u4e66\u7684\u6392\u5217\u6b21\u5e8f\u662f\uff1a1, 2, 6, 10, 3, 8, 4,7, 9, 5. \u5982\u679c\u6bcf\u6b21\u53ea\u8bb8\u53d6\u51fa\u76f8\u90bb\u7684\u4e24\u5377\uff0c\u4e0d\u6539\u53d8\u5b83\u4eec\u7684\u6b21\u5e8f\u800c\u76f8\u90bb\u5730\u653e\u5230\u65b0\u7684\u4f4d\u7f6e\u4e0a(\u9996\u3001\u5c3e\u6216\u4e24\u5377\u4e4b\u95f4)\uff0c\u600e\u6837\u624d\u80fd\u628a\u5b83\u4eec\u6309\u987a\u5e8f\u6392\u5217\u8d77\u6765\uff1f",
      "figure_ids": []
    },
    {
      "number": "1250",
      "text": "1250. \u6c42\u8bc1\uff1a\u53ea\u5728\u4e00\u4e2a\u5929\u5e73\u6258\u76d8\u4e0a\u653e1, 2, 4, 8, 16\u514b\u7684\u51e0\u4e2a\u5c0f\u781d\u7801\uff0c\u5c31\u53ef\u4ee5\u79f0\u91cf1\uff5e31\u514b\u91cd\u7684\u4efb\u4f55\u7269\u54c1.",
      "figure_ids": []
    },
    {
      "number": "1251",
      "text": "1251. 1964\u5e74\u6211\u7684\u5e74\u9f84\u521a\u597d\u662f\u6211\u51fa\u751f\u5e74\u4efd\u7684\u56db\u4e2a\u6570\u5b57\u7684\u548c.\u6211\u662f\u54ea\u5e74\u51fa\u751f\u7684\uff0c\u51e0\u5c81\uff1f",
      "figure_ids": []
    },
    {
      "number": "1252",
      "text": "1252. \u80fd\u4e0d\u80fd\u628a\u53bb\u6389\u4e86\u5bf9\u89d2\u4e0a\u683c\u5b50\u7684\u68cb\u76d8(\u56fe200)\u952f\u6210\u4e24\u4e2a\u683c\u8fde\u5728\u4e00\u8d77\u7684\u4e00\u4e9b\u5c0f\u957f\u65b9\u5f62\uff1f",
      "figure_ids": [
        "fig-200"
      ]
    },
    {
      "number": "1253",
      "text": "1253. \u5bb9\u79ef\u4e3a10\u5347\u7684\u725b\u5976\u6876\u76db\u6ee1\u4e86\u725b\u5976. \u8981\u7528\u4e00\u4e2a3\u5347\u7684\u7a7a\u6876\u4ece\u8fd9\u4e2a10\u5347\u7684\u6876\u4e2d\u5f807\u5347\u7684\u7a7a\u6876\u50125\u5347\u725b\u5976\uff0c\u600e\u4e48\u5012\u6cd5\uff1f",
      "figure_ids": []
    },
    {
      "number": "1254",
      "text": "1254. \u5546\u5e97\u91cc\u6709\u516d\u4e2a\u5bb9\u79ef\u4e0d\u540c\u7684\u8d27\u7bb1\uff0c\u5206\u522b\u88c5\u8d27\u726915, 16,18, 19, 20, 31\u516c\u65a4. \u4e24\u4e2a\u987e\u5ba2\u4e70\u8d70\u4e86\u4e94\u7bb1\u8d27\u7269. \u5176\u4e2d\u4e00\u4e2a\u987e\u5ba2\u4e70\u7684\u8d27\u7269\u8d28\u91cf\u662f\u53e6\u4e00\u4e2a\u987e\u5ba2\u76842\u500d. \u5546\u5e97\u91cc\u5269\u4e0b\u4e86\u591a\u5c11\u516c\u65a4\u7684\u8d27\u7bb1\uff1f",
      "figure_ids": []
    },
    {
      "number": "1255",
      "text": "1255. \u8336\u676f\u7684\u4ef7\u683c\u5206\u522b\u4e3a75, 70, 60, 50, 40\u7f8e\u5206\uff0c\u8336\u76d8\u5206\u522b\u4e3a58, 42, 32\u7f8e\u5206. \u7528\u4e00\u4e2a\u8336\u676f\u548c\u4e00\u4e2a\u8336\u76d8\u80fd\u7ec4\u6210\u51e0\u5957\u4e0d\u540c\u4ef7\u683c\u7684\u8336\u5177\uff1f\u54ea\u5957\u6700\u4fbf\u5b9c\uff0c\u54ea\u5957\u6700\u8d35\uff1f\u4f1a\u4e0d\u4f1a\u6709\u4e24\u5957\u8336\u5177\u540c\u6837\u4ef7\u683c\uff1f",
      "figure_ids": []
    },
    {
      "number": "1256",
      "text": "1256. 17\u4e2a\u961f\u53c2\u52a0\u8db3\u7403\u51a0\u519b\u51b3\u8d5b. \u6bcf\u4e2a\u961f\u90fd\u548c\u5176\u4f59\u7684\u961f\u5404\u8d5b\u4e24\u573a\uff0c\u4e00\u573a\u662f\u5728\u672c\u961f\u573a\u5730\uff0c\u4e00\u573a\u662f\u5728\u5bf9\u65b9\u573a\u5730. \u5faa\u73af\u8d5b\u5171\u6709\u591a\u5c11\u573a\u6bd4\u8d5b\uff1f",
      "figure_ids": []
    },
    {
      "number": "1257",
      "text": "1257. \u672c\u9898\u65e5\u671f\u7684\u8bb0\u6cd5\u662f\uff1a\u65e5\uff0c\u6708\uff0c\u5e74\u4efd\u7684\u6700\u540e\u4e24\u4e2a\u6570\u5b57(\u4f8b\u5982\uff0c9, 5, 45\uff0c\u5c31\u662f1945\u5e745\u67089\u65e5). \u5728\u4e8c\u5341\u4e16\u7eaa\u5185\uff0c\u53ea\u7528\u540c\u4e00\u4e2a\u6570\u5b57\u5199\u5e74\u6708\u65e5\uff0c\u80fd\u5199\u591a\u5c11\u6b21(\u4f8b\u5982\uff0c5. 5. 55\u2014\u20141955\u5e745\u67085\u65e5)\uff1f",
      "figure_ids": []
    },
    {
      "number": "1258",
      "text": "1258. \u90ca\u533a\u94c1\u8def\u5206\u621012\u4e2a\u533a\u6bb5(\u6309\u7968\u4ef7). \u8fd9\u6761\u94c1\u8def\u5e94\u8be5\u51c6\u5907\u51e0\u79cd\u8f66\u7968(\u4e0d\u540c\u7968\u4ef7\u7684)\uff1f",
      "figure_ids": []
    },
    {
      "number": "1259",
      "text": "1259. \u628a28\u4e2a\u9aa8\u724c\u6309\u89c4\u5219\u6446\u6210\u4e00\u4e32\uff0c\u4e00\u7aef\u662f\u4e94\u70b9\uff0c\u53e6\u4e00\u7aef\u662f\u51e0\u70b9\uff1f",
