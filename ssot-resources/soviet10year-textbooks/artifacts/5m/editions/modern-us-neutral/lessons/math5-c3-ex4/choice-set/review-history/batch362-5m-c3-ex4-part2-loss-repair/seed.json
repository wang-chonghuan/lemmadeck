      "figure_ids": []
    },
    {
      "number": "1244",
      "text": "1244. \u6c42\u5076\u6570\u96c6\u5408\u548c\u8d28\u6570\u96c6\u5408\u7684\u4ea4\u96c6.",
      "figure_ids": []
