  "exercises": [
    {
      "number": "646",
      "text": "\u56fe127\u4e2d\u753b\u6709Ben\u7684\u4f53\u91cd\u53d8\u5316\u56fe\u8c61.Ben\u5728\u516d\u5c81\u3001\u516b\u5c81\u534a\u3001\u5341\u5c81\u65f6\u7684\u4f53\u91cd\u5206\u522b\u662f\u591a\u5c11\uff1f",
      "figure_ids": [
        "fig-127"
      ]
    },
    {
      "number": "647",
      "text": "\u4e00\u4e2a\u6e14\u592b\u8bb2\uff0c\u4ed6\u4ece\u5bb6\u51fa\u6765\u6cbf\u6cb3\u5cb8\u8d70\u4e86\u4e24\u5c0f\u65f6\uff0c\u8d70\u5230\u6cb3\u6d41\u7684\u6c47\u5408\u5904.\u4ed6\u5728\u90a3\u91cc\u6355\u9c7c1.5\u5c0f\u65f6\uff0c\u7136\u540e\u7ee7\u7eed\u5f80\u524d\u8d70.\u4e00\u5c0f\u65f6\u4e4b\u540e\uff0c\u4ed6\u9009\u4e86\u4e00\u4e2a\u65b0\u7684\u5730\u65b9.\u4ed6\u5728\u90a3\u91cc\u6355\u9c7c\u3001\u71ac\u9c7c\u6c64\u3001\u5403\u5348\u996d\u7528\u4e24\u5c0f\u65f6.\u5348\u996d\u540e\u4ed6\u56de\u5bb6.\u8fd9\u5168\u90e8\u8fc7\u7a0b\u4ed6\u5171\u7528\u4e869\u5c0f\u65f6.\u8fd9\u4e2a\u6e14\u592b\u7684\u6d3b\u52a8\u7684\u56fe\u8c61\u753b\u5728\u56fe128\u4e2d.\u56de\u7b54\u4e0b\u5217\u95ee\u9898\uff1a\n1) \u6e14\u592b\u4ece\u5bb6\u51fa\u6765\u540e30\u5206\u30014\u5c0f\u65f640\u5206\u30015.5\u5c0f\u65f6\u5206\u522b\u79bb\u5bb6\u591a\u8fdc\uff1f\n2) \u6e14\u592b\u4ece\u5bb6\u8d70\u51fa\u591a\u5c11\u65f6\u95f4\uff0c\u5230\u8fbe\u79bb\u5bb68\u516c\u91cc\u7684\u5730\u65b9\uff1f\n3) \u79bb\u5bb6\u7684\u8ddd\u79bb\u4ec0\u4e48\u65f6\u5019\u589e\u52a0\u3001\u4ec0\u4e48\u65f6\u5019\u51cf\u5c11\u3001\u4ec0\u4e48\u65f6\u5019\u4e0d\u53d8\uff1f\n4) \u6e14\u592b\u6700\u540e3\u5c0f\u65f6\u8d70\u4e86\u591a\u5c11\u516c\u91cc\uff1f\n5) \u6e14\u592b\u5728\u5168\u7a0b\u7684\u7b2c\u4e00\u4e2a\u5c0f\u65f6\u548c\u6700\u540e\u4e00\u4e2a\u5c0f\u65f6\u7684\u6b65\u884c\u901f\u5ea6\u5404\u662f\u591a\u5c11\u516c\u91cc/\u5c0f\u65f6\uff1f\u6e14\u592b\u79bb\u5bb65\u20146\u5c0f\u65f6\u4e4b\u95f4\u7684\u6b65\u884c\u901f\u5ea6\u662f\u591a\u5c11\u516c\u91cc/\u5c0f\u65f6\uff1f",
      "figure_ids": [
        "fig-128"
      ]
    },
    {
      "number": "648",
      "text": "\u4f5c\u4e00\u6761\u957f3.7\u5398\u7c73\u7684\u7ebf\u6bb5$AB$.\u5206\u522b\u8fc7\u7ebf\u6bb5\u7684\u4e24\u4e2a\u7aef\u70b9\u4f5c\u8fd9\u4e2a\u7ebf\u6bb5\u7684\u5782\u7ebf.",
      "figure_ids": []
    },
    {
      "number": "649",
      "text": "\u82f9\u679c\u7684\u4ef7\u683c\u548c\u68a8\u76f8\u540c\uff0c\u7ecf\u8fc7\u82e5\u5e72\u65f6\u95f4\u4e4b\u540e\uff0c\u82f9\u679c\u964d\u4ef720\u7f8e\u5206\uff0c\u68a8\u964d\u4ef710\u7f8e\u5206.\u8fd9\u65f6\uff0c6\u516c\u65a4\u82f9\u679c\u548c5\u516c\u65a4\u68a8\u7684\u4ef7\u683c\u76f8\u7b49.\u82f9\u679c\u7684\u4ef7\u683c\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "650",
      "text": "\u5728\u6bcf\u4e2a\u7bee\u5b50\u548c\u6bcf\u4e2a\u7bb1\u5b50\u91cc\uff0c\u5f00\u59cb\u90fd\u88c5\u6709\u540c\u6837\u591a\u7684\u9e21\u86cb.\u7136\u540e\u4ece\u6bcf\u4e2a\u7bee\u5b50\u91cc\u5404\u53d6\u51fa10\u4e2a\u9e21\u86cb\uff0c\u5728\u6bcf\u4e2a\u7bb1\u5b50\u91cc\u518d\u591a\u52a020\u4e2a\u9e21\u86cb.\u8fd9\u65f614\u4e2a\u7bee\u5b50\u91cc\u88c5\u7684\u9e21\u86cb\u548c10\u4e2a\u7bb1\u5b50\u91cc\u88c5\u7684\u9e21\u86cb\u6570\u76f8\u7b49.\u5f00\u59cb\u6bcf\u7bb1\u5404\u88c5\u4e86\u591a\u5c11\u4e2a\u9e21\u86cb\uff1f",
      "figure_ids": []
    },
    {
      "number": "651",
      "text": "\u6709\u4e24\u5757\u4e1d\u7ef8\u4e00\u6837\u957f.\u5982\u679c\u4ece\u7b2c\u4e00\u5757\u4e1d\u7ef8\u526a\u4e0b10\u7c73\uff0c\u4ece\u7b2c\u4e8c\u5757\u4e1d\u7ef8\u526a\u4e0b40\u7c73\uff0c\u5219\u7b2c\u4e00\u5757\u4e1d\u7ef8\u7684\u957f\u5ea6\u662f\u7b2c\u4e8c\u5757\u76842\u500d\uff0c\u6bcf\u5757\u4e1d\u7ef8\u662f\u591a\u5c11\u7c73\uff1f",
      "figure_ids": []
    },
    {
      "number": "652",
      "text": "129\u56fe\u4e2d\u8868\u793a\u7684\u662f\u7535\u70ed\u6c34\u58f6\u4e2d\u6c34\u7684\u6e29\u5ea6\u66f2\u7ebf.\u5728$Ox$\u8f74\u4e0a\u8868\u793a\u65f6\u95f4(\u4ee5\u5206\u8ba1)\uff0c\u5728$Oy$\u8f74\u4e0a\u5219\u8868\u793a\u6c34\u6e29(\u4ee5\u5ea6\u8ba1)\uff0c\u6309\u56fe\u8c61\u786e\u5b9a\uff1a\n1) \u7535\u70ed\u6c34\u58f6\u63a5\u901a\u7535\u6d41\u540e20\u5206\u949f\u7684\u6c34\u6e29\uff1b\n2) \u7535\u70ed\u6c34\u58f6\u4e2d\u6c34\u5f00\u59cb\u6cb8\u817e\u7684\u65f6\u95f4\uff1b\n3) \u7535\u70ed\u6c34\u58f6\u4e2d\u7684\u6c34\u6cb8\u817e\u51e0\u5206\u949f\uff1b\n4) \u4ec0\u4e48\u65f6\u95f4\u7535\u70ed\u6c34\u58f6\u4e2d\u7684\u6c34\u6e29\u662f$90^\\circ\\mathrm{C}$\uff1f",
      "figure_ids": [
        "fig-129"
      ]
    },
    {
      "number": "653",
      "text": "130\u56fe\u4e2d\u753b\u51fa\u706b\u8f66\u8fd0\u884c\u56fe\u8c61.\u6309\u56fe\u8c61\u786e\u5b9a\uff1a\n1) \u524d\u4e24\u5c0f\u65f6\u706b\u8f66\u8fd0\u884c\u7684\u8ddd\u79bb\u662f\u591a\u5c11\uff1b\n2) \u706b\u8f66\u5728\u6bcf\u4e00\u7ad9\u505c\u8f66\u51e0\u5206\u949f\uff1b\n3) \u706b\u8f66\u5404\u7ad9\u95f4\u7684\u8ddd\u79bb\uff1b\n4) 3\u5c0f\u65f6\u5185\u7684\u5e73\u5747\u8fd0\u884c\u901f\u5ea6.",
      "figure_ids": [
        "fig-130"
      ]
    },
    {
      "number": "654",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $-3.2k-4.8=-2\\cdot(1.2k+2.4)$\uff1b\n2) $-5\\cdot(0.8y-1.2)=-y+7.2$.",
      "figure_ids": []
    },
    {
      "number": "655",
      "text": "\u7b2c\u4e00\u4e2a\u4e66\u67b6\u4e0a\u7684\u4e66\u662f\u7b2c\u4e8c\u4e2a\u4e66\u67b6\u4e0a\u76843\u500d.\u5f53\u4ece\u7b2c\u4e00\u4e2a\u4e66\u67b6\u4e0a\u53d6\u4e0b8\u672c\u4e66\uff0c\u800c\u5728\u7b2c\u4e8c\u4e2a\u4e66\u67b6\u4e0a\u653e\u4e0a5\u672c\u65f6\uff0c\u5219\u7b2c\u4e8c\u4e2a\u4e66\u67b6\u4e0a\u7684\u4e66\u6bd4\u7b2c\u4e00\u4e2a\u4e66\u67b6\u5c1117\u672c.\u6bcf\u4e2a\u4e66\u67b6\u4e0a\u5404\u6709\u591a\u5c11\u672c\u4e66\uff1f",
      "figure_ids": []
    },
    {
      "number": "656",
      "text": "\u67d0\u865a\u6784\u57ce\u5e02\u5360\u5730\u9762\u79ef\u4e3a87500\u516c\u9877.\u516c\u56ed\u3001\u8857\u5fc3\u82b1\u56ed\u548c\u5c0f\u516c\u56ed\u5360\u4e09\u5206\u4e4b\u4e00.\u5982\u679c\u8be5\u5e02\u4ee5700\u4e07\u5c45\u6c11\u8ba1\u7b97\uff0c\u6bcf\u4e2a\u4eba\u7684\u7eff\u5316\u9762\u79ef\u662f\u591a\u5c11\u5e73\u65b9\u7c73\uff1f",
      "figure_ids": []
    }
  ],
