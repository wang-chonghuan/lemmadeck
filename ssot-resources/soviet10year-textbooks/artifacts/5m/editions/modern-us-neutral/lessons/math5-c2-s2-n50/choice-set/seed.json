  "concepts": [
    {
      "block": 3,
      "text": "$10^3$\u8fd9\u79cd\u5199\u6cd5\u8bfb\u6210\u201c10\u7684\u4e09\u6b21\u5e42\u201d. \u5f0f\u5b50$10^3$\u53eb\u505a\u5e42\uff0c3\u662f\u5e42\u6307\u6570\uff0c\u800c10\u662f\u5e42\u5e95\u6570."
    },
    {
      "block": 6,
      "text": "\u8fb9\u957f\u4e3a$a$\u7684\u6b63\u65b9\u5f62\u7684\u9762\u79ef\u7b49\u4e8e$a\\cdot a$\uff0c\u4e5f\u5c31\u662f$a^2$. \u56e0\u6b64\uff0c\u6307\u6570\u4e3a2\u7684\u5e42\u53eb\u505a\u5e95\u6570\u7684\u5e73\u65b9. \u4f8b\u5982\uff0c$4^2$\u8bfb\u4f5c\uff1a\u201c4\u7684\u5e73\u65b9\u201d."
    },
    {
      "block": 7,
      "text": "\u8fb9\u957f\u4e3a$a$\u7684\u7acb\u65b9\u4f53\u7684\u4f53\u79ef\u7b49\u4e8e$a\\cdot a\\cdot a$\uff0c\u4e5f\u5c31\u662f$a^3$. \u56e0\u6b64\uff0c\u6307\u6570\u4e3a3\u7684\u5e42\u53eb\u505a\u5e95\u6570\u7684\u7acb\u65b9. \u5982\uff0c$5^3$\u8bfb\u4f5c\uff1a\u201c5\u7684\u7acb\u65b9\u201d."
    },
    {
      "block": 8,
      "text": "\u6c42\u542b\u5e42\u7684\u5f0f\u5b50\u7684\u503c\uff0c\u8981\u628a\u5f0f\u5b50\u5206\u6210\u51e0\u90e8\u5206. \u7136\u540e\u6c42\u51fa\u6bcf\u90e8\u5206\u7684\u503c\uff0c\u7528\u6c42\u51fa\u7684\u503c\u4ee3\u66ff\u5404\u90e8\u5206\u518d\u8fdb\u884c\u5176\u4f59\u7684\u8ba1\u7b97. \u5982\u679c\u6ca1\u6709\u62ec\u53f7\uff0c\u5c31\u8981\u9996\u5148\u8ba1\u7b97\u51fa\u5e42\u7684\u503c."
    }
  ],
