    {
      "number": "562",
      "text": "\u67d0\u9879\u865a\u6784\u7684\u5de5\u5382\u7edf\u8ba1\u4e2d\uff0c\u5de5\u5382\u539f\u8ba1\u52121974\u5e74\u7684\u52b3\u52a8\u751f\u4ea7\u7387\u6bd41970\u5e74\u63d0\u9ad825%\uff0c\u5b9e\u9645\u63d0\u9ad8\u4e8639%.1974\u5e74\u7684\u52b3\u52a8\u751f\u4ea7\u7387\u6bd4\u539f\u8ba1\u5212\u63d0\u9ad8\u767e\u5206\u4e4b\u51e0\uff1f\u52b3\u52a8\u751f\u4ea7\u7387\u591a\u63d0\u9ad8\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "563",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e8c\u4eba\u4e58\u6469\u6258\u8f66\u4ece\u76f8\u8ddd250\u516c\u91cc\u7684\u7532\u3001\u4e59\u4e24\u5e02\u540c\u65f6\u51fa\u53d1\uff0c\u76f8\u5411\u800c\u884c.\u4e24\u5c0f\u65f6\u540e\u8fd8\u8981\u884c\u9a7630\u516c\u91cc\u624d\u80fd\u76f8\u9047.\u7b2c\u4e00\u4eba\u4e58\u6469\u6258\u8f66\u7684\u901f\u5ea6\u6bd4\u7b2c\u4e8c\u4eba\u5feb10\u516c\u91cc/\u5c0f\u65f6.\u5206\u522b\u6c42\u51fa\u4e8c\u4eba\u4e58\u6469\u6258\u8f66\u7684\u901f\u5ea6.\n2) \u5185\u71c3\u673a\u8f66\u4ece\u7532\u7ad9\u53d1\u51fa2\u5c0f\u65f6\u540e\uff0c\u628a\u884c\u901f\u52a0\u5feb12\u516c\u91cc/\u5c0f\u65f6\uff0c\u4e8e\u53d1\u8f66\u540e5\u5c0f\u65f6\u5230\u8fbe\u7ec8\u70b9\u4e59\u7ad9.\u5982\u679c\u4ece\u7532\u7ad9\u5230\u4e59\u7ad9\u7684\u8ddd\u79bb\u4e3a261\u516c\u91cc\uff0c\u90a3\u4e48\u5185\u71c3\u673a\u8f66\u5f00\u59cb\u7684\u884c\u901f\u4e3a\u591a\u5c11\u516c\u91cc/\u5c0f\u65f6\uff1f",
      "figure_ids": []
    },
    {
      "number": "564",
      "text": "\u5316\u7b80\uff1a\n1) $-a\\cdot(-7)$\uff1b\n2) $b\\cdot(-4m)$\uff1b\n3) $-3\\cdot(-ab)$\uff1b\n4) $-mn\\cdot(-5)$\uff1b\n5) $2a\\cdot(-3b)$\uff1b\n6) $-7b\\cdot(-7a)$.",
