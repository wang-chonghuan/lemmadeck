    {
      "number": "558",
      "text": "\u53bb\u6389\u4e0b\u5217\u5404\u5f0f\u4e2d\u7684\u62ec\u53f7\uff1a\n1) $-5a\\cdot(-a)-4m$\uff1b\n2) $-6a+7\\cdot(-b)$\uff1b\n3) $-11\\cdot(-x)-5.3\\cdot(-k)$\uff1b\n4) $a\\cdot(-2.6)+10\\cdot(-b)$.",
      "figure_ids": []
    },
    {
      "number": "559",
      "text": "\u628a\u4e0b\u5217\u548c\u6539\u6210\u79ef\u7684\u5f62\u5f0f\uff1a\n1) $m+m+m+m$\uff1b\n2) $-a-a-a-a-a-a$\uff1b\n3) $-3x-3x-3x-3x-3x$\uff1b\n4) $-xy-xy-xy-xy-xy$.",
      "figure_ids": []
    },
    {
      "number": "560",
      "text": "\u6c42\u4e0b\u5217\u5404\u9898\u6240\u6709\u6574\u6570\u7684\u79ef\uff1a\n1) \u4ece1\u52305\uff1b\n2) \u4ece$-5$\u5230$-1$\uff1b\n3) \u4ece$-5$\u52305\uff1b\n4) \u4ece$-45$\u523050.",
      "figure_ids": []
    },
    {
      "number": "561",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1) $(10.8-12)\\cdot(6.7-9)$\uff1b\n2) $(11.3-13)\\cdot(5.8-8)$\uff1b\n3) $(16.7-12):(21.5-24)$\uff1b\n4) $(18.6-14):(31.5-34)$\uff1b\n5) $-2.79:3.1+24.24:2.4$\uff1b\n6) $2.07:(-2.3)+13.13:1.3$\uff1b\n7) $(1-1.5\\cdot1.4)\\cdot(-2.8)$\uff1b\n8) $(1-1.3\\cdot1.6)\\cdot(-3.2)$.",
      "figure_ids": []
