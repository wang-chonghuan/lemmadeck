    {
      "number": "196",
      "text": "\u4e24\u5217\u706b\u8f66\u540c\u901f\u884c\u9a76. \u4e00\u5217\u5df2\u7ecf\u884c\u9a76\u4e86 9 \u5c0f\u65f6\uff0c\u53e6\u4e00\u5217 5\u5c0f\u65f6. \u5047\u5982\u7b2c\u4e8c\u5217\u706b\u8f66\u6bd4\u7b2c\u4e00\u5217\u5c11\u8d70\u4e86 290 \u516c\u91cc\uff0c\u90a3\u4e48\u706b\u8f66\u7684\u884c\u9a76\u901f\u5ea6\u662f\u591a\u5c11\uff1f",
