    },
    {
      "number": "194",
      "text": "\u54ea\u4e9b\u6570\u662f 124\uff0c$-124$\uff0c37\uff0c$-38$\uff0c3\uff0c$-4$\uff0c0 \u7b49\u6570\u7684\u76f8\u53cd\u6570\uff1f",
