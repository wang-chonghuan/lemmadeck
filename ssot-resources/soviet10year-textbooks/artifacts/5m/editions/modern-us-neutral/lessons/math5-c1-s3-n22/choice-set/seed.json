  "exercises": [
    {
      "number": "371",
      "text": "\u5728\u4e00\u5f20\u7eb8\u4e0a\u4f5c\u76f4\u7ebf $AB$ \u548c\u67d0\u56fe\u5f62 $P$. \u628a\u8fd9\u5f20\u7eb8\u6cbf\u76f4\u7ebf$AB$ \u5bf9\u6298. \u7528\u5706\u89c4\u7684\u5c16\u7aef\u5728\u56fe\u5f62 $P$ \u7684\u51e0\u4e2a\u70b9\u4e0a\u5f80\u7eb8\u4e0a\u624e\u773c. \u7136\u540e\u628a\u7eb8\u6253\u5f00\uff0c\u627e\u51fa\u51e0\u5bf9\u5bf9\u79f0\u70b9\uff0c\u7528\u7b26\u53f7\u6807\u51fa\u8fd9\u4e9b\u70b9.",
      "figure_ids": []
    },
    {
      "number": "372",
      "text": "\u5982\u56fe $91.1,91.2$ \u6240\u793a\uff0c\u4f5c\u76f4\u7ebf $m$ \u548c\u7ebf\u6bb5 $AB$ \u4e0e $CD$. \u4f5c\u7ebf\u6bb5 $AB,CD$ \u7684\u5173\u4e8e\u76f4\u7ebf $m$ \u7684\u4e24\u6761\u5bf9\u79f0\u7ebf\u6bb5.",
      "figure_ids": [
        "fig-91"
      ]
    },
    {
      "number": "373",
      "text": "\u4f5c\u6298\u7ebf $ABC$ \u548c\u76f4\u7ebf $n$\uff0c\u4f7f\u76f4\u7ebf $n$ \u548c $BC$ \u76f8\u4ea4. \u4f5c\u6298\u7ebf$ABC$ \u7684\u5173\u4e8e\u76f4\u7ebf $n$ \u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": []
    },
    {
      "number": "374",
      "text": "\u628a\u56fe 92 \u63cf\u4e0b\u6765. \u4f5c\u56db\u8fb9\u5f62 $ABCD$ \u7684\u5173\u4e8e\u76f4\u7ebf $m$ \u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": [
        "fig-92"
      ]
    },
    {
      "number": "375",
      "text": "\u4f5c\u957f\u65b9\u5f62 $ABCD$\uff0c\u4f7f $|AB|=5$ \u5398\u7c73\uff0c$|BC|=3$ \u5398\u7c73. \u4f5c\u957f\u65b9\u5f62 $ABCD$ \u7684\u5173\u4e8e\u76f4\u7ebf $AC$ \u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": []
    },
    {
      "number": "376",
      "text": "\u56fe 93 \u4e2d\u54ea\u4e9b\u56fe\u5f62\u662f\u5173\u4e8e\u5df2\u77e5\u8f74\u7684\u5bf9\u79f0\u56fe\u5f62\uff1f",
      "figure_ids": [
        "fig-93"
      ]
    },
    {
      "number": "377",
      "text": "\u4f5c\u52a0\u6cd5\uff1a\n1) $3.75+(-2.11)+(-4.9)+2.8+(-5.73)$\uff1b\n2) $-4.05+(-7.01)+4.65+(-8.63)+5.28$\uff1b\n3) $-7.612+5.765+(-0.765)+4.313+5.58$\uff1b\n4) $9.113+(-6.444)+(-3.363)+0.363+4.28$.",
      "figure_ids": []
    },
    {
      "number": "378",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1) $|1.34+(-4.71)|$\uff1b\n2) $|-5.62|+|8.05|$\uff1b\n3) $|-2.73+0.29|$\uff1b\n4) $|6.35|+|1-4.96|$.",
      "figure_ids": []
    },
    {
      "number": "379",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $-x=-7.2+9$\uff1b\n2) $-k=11+(-12.3)$\uff1b\n3) $-y=-6.5+8$\uff1b\n4) $-p=12+(-13.7)$.",
      "figure_ids": []
    },
    {
      "number": "380",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e3a\u67d0\u5382\u804c\u5de5\u4fee\u5efa\u4e86\u4e00\u5e62240\u6237\u7684\u4f4f\u5b85\u697c.\u5176\u4e2d\u4e09\u5ba4\u6237\u5360\u5168\u90e8\u6237\u6570\u768415%.\u540c\u65f6\uff0c\u4e09\u5ba4\u6237\u53c8\u5360\u4e00\u5ba4\u6237\u603b\u6570\u7684$2/3$.\u5176\u4f59\u4e3a\u4e8c\u5ba4\u6237.\u8fd9\u5e62\u4f4f\u5b85\u697c\u4e2d\u6709\u591a\u5c11\u4e8c\u5ba4\u6237\uff1f\n2) \u5728\u79df\u8239\u7ad9\u6709150\u53ea\u8239.\u4e09\u4e2a\u5750\u4f4d\u7684\u8239\u5360\u5168\u90e8\u8239\u7684$14\\%$.\u4e09\u4e2a\u5750\u4f4d\u7684\u8239\u6570\u662f\u4e94\u4e2a\u5750\u4f4d\u7684\u8239\u6570\u7684$7/8$.\u5176\u4f59\u662f\u56db\u4e2a\u5750\u4f4d\u7684\u8239.\u79df\u8239\u7ad9\u6709\u591a\u5c11\u53ea\u56db\u4e2a\u5750\u4f4d\u7684\u8239\uff1f\n3) \u5de5\u5382\u59d4\u5458\u4f1a\u5728\u4e00\u5e74\u5185\u5171\u53d1\u51fa350\u5f20\u8bc1\u4ef6.\u5176\u4e2d\u4f11\u517b\u8bc1\u5360\u5168\u90e8\u8bc1\u4ef6\u7684$2/5$\uff0c\u5b83\u5360\u65c5\u6e38\u8bc1\u768470%\uff0c\u5176\u4f59\u662f\u7597\u517b\u8bc1.\u53d1\u51fa\u4e86\u591a\u5c11\u5f20\u7597\u517b\u8bc1\uff1f\n4) \u5b66\u6821\u5b9e\u9a8c\u56ed\u5730\u5171\u6709450\u68f5\u6811.\u6934\u6811\u5360\u603b\u68f5\u6570\u7684$2/5$\uff0c\u6934\u6811\u7684\u68f5\u6570\u662f\u677e\u6811\u768490%\uff0c\u5176\u4f59\u662f\u6866\u6811.\u5b66\u6821\u5b9e\u9a8c\u56ed\u5730\u6709\u591a\u5c11\u68f5\u6866\u6811\uff1f",
      "figure_ids": []
    },
    {
      "number": "381",
      "text": "\u7528\u7cca\u5899\u7eb8\u7cca\u5899\uff0c\u6bcf1\u5e73\u65b9\u7c73\u5899\u9700\u7528\uff1a\u7cca\u5899\u7eb80.25\u5f20\uff0c\u6dc0\u7c890.09\u516c\u65a4\uff0c\u80f60.01\u516c\u65a4\uff0c\u62a5\u7eb80.07\u5f20.\u5047\u5982\u4e00\u4e2a\u623f\u95f4\u7684\u56db\u9762\u5899\u603b\u9762\u79ef\u4e3a35.3\u5e73\u65b9\u7c73\uff0c\u95e8\u3001\u7a97\u9762\u79ef\u4e3a10.2\u5e73\u65b9\u7c73\uff0c\u7cca\u8fd9\u4e2a\u623f\u95f4\u7684\u5899\u9700\u8981\u591a\u5c11\u6750\u6599\uff1f\u7b54\u6570\u53d6\u6574\u6570.",
      "figure_ids": []
    },
    {
      "number": "382",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $165.64-(a-12.5)=160.54$\uff1b\n2) $278.74-(6.5-b)=276.84$.",
      "figure_ids": []
    },
    {
      "number": "383",
      "text": "\u628a94\u56fe\u63cf\u5728\u7ec3\u4e60\u672c\u4e0a\uff0c\u4f5c\u7ebf\u6bb5$MK$\u548c$CE$\u7684\u5173\u4e8e\u76f4\u7ebf$P$\u7684\u5bf9\u79f0\u7ebf\u6bb5.",
      "figure_ids": [
        "fig-94"
      ]
    },
    {
      "number": "384",
      "text": "\u6309\u56fe95\u6240\u793a\uff0c\u4f5c\u4e09\u89d2\u5f62$ABC$\u548c\u76f4\u7ebf$n$.\u4f5c\u4e09\u89d2\u5f62$ABC$\u7684\u5173\u4e8e\u76f4\u7ebf$n$\u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": [
        "fig-95"
      ]
    },
    {
      "number": "385",
      "text": "\u4ee52.7\u5398\u7c73\u4e3a\u534a\u5f84\u4f5c\u5706\u5468$P$.\u4f5c\u4e00\u76f4\u7ebf$x$\u4ea4\u5706\u5468\u4e8e$A$\u3001$B$\u4e24\u70b9.\u4f5c\u5706\u5468$P$\u7684\u5173\u4e8e\u76f4\u7ebf$AB$\u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": []
    },
    {
      "number": "386",
      "text": "\u628a\u56fe96\u753b\u5230\u7ec3\u4e60\u672c\u4e0a\uff0c\u4f5c\u5e26\u9634\u5f71\u7684\u56fe\u5f62\u7684\u5173\u4e8e$m$\u8f74\u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": [
        "fig-96"
      ]
    },
    {
      "number": "387",
      "text": "\u628a\u4e00\u5f20\u7eb8\u5bf9\u6298\uff0c\u7136\u540e\u7528\u526a\u5200\u526a\u4e00\u4e2a\u4efb\u610f\u56fe\u5f62.\u628a\u7eb8\u5c55\u5f00\uff0c\u8ba9\u5927\u5bb6\u770b\u770b\u5173\u4e8e\u6298\u75d5\u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": []
    },
    {
      "number": "388",
      "text": "\u4e00\u4eba\u9a91\u81ea\u884c\u8f66\u4ece\u6751\u5e84\u51fa\u53d1\u8ffd\u8d76\u8d70\u5728\u6865\u4e0a\u7684\u884c\u4eba\uff0c\u4ed6\u572812\u5206\u949f\u540e\u8d76\u4e0a\u8fd9\u4e2a\u884c\u4eba.\u5982\u679c\u9a91\u81ea\u884c\u8f66\u7684\u901f\u5ea6\u662f15\u516c\u91cc/\u5c0f\u65f6\uff0c\u4ece\u6751\u5e84\u5230\u6865\u7684\u8ddd\u79bb\u4e3a1\u516c\u91cc800\u7c73\uff0c\u884c\u4eba\u7684\u6b65\u884c\u901f\u5ea6\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "389",
      "text": "\u8ba1\u7b97\uff1a\n1) $(203-20.809-150+83.079):(1.3472+1.1528)$\uff1b\n2) $(5.78+1.72)\\cdot[8.23+1.17+171.1:(4.418+1.382)]$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 3,
      "text": "\u5047\u5982 $P$ \u4e0e $T$ \u4e24\u56fe\u5f62\u4e2d\uff0c\u7ec4\u6210\u6bcf\u4e2a\u56fe\u5f62\u7684\u70b9\u90fd\u548c\u53e6\u4e00\u4e2a\u56fe\u5f62\u7684\u70b9\u5bf9\u79f0\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u56fe\u5f62\u5c31\u662f**\u5173\u4e8e\u76f4\u7ebf $l$ \u5bf9\u79f0**\uff08\u56fe 87\uff09.\u76f4\u7ebf $l$ \u53eb\u505a $P$ \u548c $T$ \u56fe\u5f62\u7684\u5bf9\u79f0\u8f74. \u56e0\u4e3a\u5728\u6298\u53e0\u65f6\uff0c\u5bf9\u79f0\u56fe\u5f62\u4e92\u76f8\u91cd\u5408\uff0c\u6240\u4ee5\u5b83\u4eec\u662f\u5408\u540c\u7684."
    }
