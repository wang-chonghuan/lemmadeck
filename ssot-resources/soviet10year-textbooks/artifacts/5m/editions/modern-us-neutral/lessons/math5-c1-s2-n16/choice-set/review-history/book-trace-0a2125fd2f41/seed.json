  "exercises": [
    {
      "number": "262",
      "text": "\u6309\u56fe 67 \u786e\u5b9a\u4ece\u70b9 $O$ \u5230\u70b9 $M,K,P$ \u548c $N$ \u8981\u4ece\u5de6\u5411\u53f3\u8d70\u51e0\u683c\uff0c\u4ece\u4e0b\u5411\u4e0a\u8d70\u51e0\u683c\uff1f",
      "figure_ids": [
        "fig-67"
      ]
    },
    {
      "number": "263",
      "text": "\u590f\u4ee4\u8425\u4e3e\u884c\u201c\u5750\u6807\u5bfb\u5b9d\u201d\u6d3b\u52a8. \u5f00\u59cb\u65f6\uff0c\u5c0f\u961f\u4f4d\u4e8e\u70b9 $O$\uff08\u56fe68\uff09. \u6307\u5bfc\u5458\u5ba3\u8bfb\u8def\u7ebf\uff1a\u201c\u5411\u4e1c\u8d70 5 \u516c\u91cc\uff0c\u7136\u540e\u518d\u5411\u5317\u8d70 4 \u516c\u91cc\u201d. \u8bf4\u51fa\u5c0f\u961f\u5e94\u5230\u7684\u70b9 $B$ \u7684\u5750\u6807. \u4e3a\u5176\u5b83\u5c0f\u961f\u5199\u51fa\u5206\u522b\u5230 $C,D,E$ \u5404\u70b9\u7684\u8def\u7ebf\uff0c\u5e76\u8bf4\u51fa\u8fd9\u4e09\u4e2a\u70b9\u7684\u5750\u6807.",
      "figure_ids": [
        "fig-68"
      ]
    },
    {
      "number": "264",
      "text": "\u4f5c\u5750\u6807\u8f74 $Ox,Oy$ \u5e76\u4e14\u6807\u51fa\u4e0b\u5217\u5404\u70b9\uff1a$A(2,8)$\uff0c$B(3,-4),C(-4,5)$\uff0c$D(-3,-7),E(0,5)$\uff0c$M(0,-4),K(6,0)$\uff0c$P(-7,0)$.",
      "figure_ids": []
    },
    {
      "number": "265",
      "text": "\u6c42\u51fa $A,B,C,D$ \u5404\u70b9\u7684\u5750\u6807\uff08\u56fe 69\uff09.",
      "figure_ids": [
        "fig-69"
      ]
    },
    {
      "number": "266",
      "text": "\u8bf4\u51fa\u5750\u6807\u4e3a $0,0$ \u7684\u70b9\uff08\u53c2\u770b\u56fe 69\uff09.",
      "figure_ids": [
        "fig-69"
      ]
    },
    {
      "number": "267",
      "text": "\u4f5c\u76f4\u89d2\u5750\u6807\u7cfb\u5e76\u4e14\u6309\u4e0b\u5217\u5df2\u77e5\u9876\u70b9\u5750\u6807\u4f5c\u56db\u8fb9\u5f62$ABCD$\uff1a$A(-10,2),B(-2,-2),C(-2,-6),D(-10,-6)$.",
      "figure_ids": []
    },
    {
      "number": "268",
      "text": "\u8bf4\u51fa\u516d\u8fb9\u5f62\u9876\u70b9\u7684\u5750\u6807\uff08\u56fe 70\uff09.",
      "figure_ids": [
        "fig-70"
      ]
    },
    {
      "number": "269",
      "text": "\u5728\u5750\u6807\u7eb8\u4e0a\uff08\u56fe 71\uff09\u6807\u51fa $A,B,C,D,E,F,K,M$ \u5404\u70b9. \u627e\u51fa\u5404\u70b9\u7684\u5750\u6807.",
      "figure_ids": [
        "fig-71"
      ]
    },
    {
      "number": "270",
      "text": "\u5728\u5750\u6807\u5e73\u9762\u4e0a\u4f5c\u4e00\u6761\u7ebf\uff08\u56fe 72\uff09\uff0c\u627e\u51fa\u8fd9\u6761\u7ebf\u4e0a\u7684\u4ee5\u4e0b\u5404\u70b9\uff1a\n1) \u6a2a\u5750\u6807\u4e3a $2,1.7,-1.8$\uff1b\n2) \u7eb5\u5750\u6807\u4e3a $1.8,2.1,-1.3,-3.1,-2.5$.",
      "figure_ids": [
        "fig-72"
      ]
    },
    {
      "number": "271",
      "text": "\u5df2\u77e5\u70b9\u7684\u96c6\u5408 $\\{A,B,C,D,E\\}$\uff0c\u5176\u4e2d $A(1,3),B(-1,4)$\uff0c$C(7,-5),D(0,6),E(-4,0)$. \u5728\u5927\u62ec\u53f7\u5185\u5199\u51fa\u7531\u4e0b\u5217\u5404\u70b9\u7ec4\u6210\u7684\u5b50\u96c6\uff1a\n1) \u4f4d\u4e8e $Ox$ \u8f74\u4ee5\u4e0a\uff0c\n2) \u5728 $Oy$ \u8f74\u7684\u5de6\u8fb9.",
      "figure_ids": []
    },
    {
      "number": "272",
      "text": "\u6807\u51fa\u5750\u6807\u4e3a $A(6,-2),B(-2,6),E(5,5)$ \u7684\u5404\u70b9. \u627e\u51fa\u76f4\u7ebf $OE$ \u548c\u7ebf\u6bb5 $AB$ \u7684\u4ea4\u70b9\u7684\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "273",
      "text": "\u4f5c\u4e00\u4e2a\u8fb9\u957f\u4e3a 3 \u5398\u7c73\u548c 5 \u5398\u7c73\u7684\u957f\u65b9\u5f62 $ABCD$. \u628a\u5b83\u5e73\u79fb\uff0c\u4f7f\u9876\u70b9 $A$ \u79fb\u5230\u9876\u70b9 $C$.",
      "figure_ids": []
    },
    {
      "number": "274",
      "text": "\u6c7d\u8f66\u5934 4 \u5c0f\u65f6\u7684\u884c\u901f\u662f 62.5 \u516c\u91cc/\u5c0f\u65f6\uff0c\u4ee5\u540e 2.5 \u5c0f\u65f6\u7684\u884c\u901f\u662f 53.4 \u516c\u91cc/\u5c0f\u65f6\uff0c\u6700\u540e 1.5 \u5c0f\u65f6\u7684\u901f\u5ea6\u662f82.2 \u516c\u91cc/\u5c0f\u65f6. \u6c42\u6c7d\u8f66\u5728\u5168\u90e8\u884c\u9a76\u65f6\u95f4\u5185\u7684\u5e73\u5747\u901f\u5ea6.",
      "figure_ids": []
    },
    {
      "number": "275",
      "text": "\u628a\u4e09\u79cd\u8c37\u7269\u6df7\u5408\u5728\u4e00\u8d77\uff1a\u6bcf 100 \u514b\u552e\u4ef7 96 \u7f8e\u5206\u7684\u71d5\u9ea6\u6df7\u5408\u7269 300 \u514b\uff0c\u6bcf 100 \u514b\u552e\u4ef7 1 \u7f8e\u5143 4 \u7f8e\u5206\u7684\u575a\u679c\u6df7\u5408\u7269 450 \u514b\uff0c\u8fd8\u6709\u6bcf 100 \u514b\u552e\u4ef7 76 \u7f8e\u5206\u7684\u6c34\u679c\u6df7\u5408\u7269 250 \u514b. \u6c42\u6df7\u5408\u540e\u6bcf 100 \u514b\u98df\u54c1\u7684\u4ef7\u683c. \u7b54\u6570\u4e0d\u6ee1 1 \u7f8e\u5206\u7684\u5c0f\u6570\u56db\u820d\u4e94\u5165.",
      "figure_ids": []
    },
    {
      "number": "276",
      "text": "\u5217\u51fa\u65b9\u7a0b\u89e3\u5e94\u7528\u9898\uff1a\n1) \u6cb9\u7f50\u4e2d\u6709\u7164\u6cb9 38 \u5428. \u7b2c\u4e00\u5929\u7528\u6389\u6cb9\u7f50\u4e2d\u7684\u7164\u6cb9\u662f \u7b2c\u4e8c\u5929\u7684 2.4 \u500d\uff0c\u6cb9\u7f50\u4e2d\u8fd8\u5269\u7164\u6cb9 9.1 \u5428. \u7b2c\u4e00\u5929\u7528 \u6389\u591a\u5c11\u5428\u7164\u6cb9\uff1f\n2) \u65e9\u6668\u4ed3\u5e93\u91cc\u6709\u9762\u7c89 4.64 \u5428. \u5348\u996d\u524d\u8fd0\u51fa\u7684\u9762\u7c89\u662f \u5348\u996d\u540e\u7684 2 \u500d. \u508d\u665a\u524d\uff0c\u4ed3\u5e93\u91cc\u8fd8\u5269\u9762\u7c89 0.64 \u5428. \u5348 \u996d\u524d\u4ece\u4ed3\u5e93\u8fd0\u51fa\u591a\u5c11\u5428\u9762\u7c89\uff1f",
      "figure_ids": []
    },
    {
      "number": "277",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e94\u5e74\u7ea7\u6709 40 \u540d\u5b66\u751f. \u8003\u8bd5\u65f6\uff0c6 \u4e2a\u5b66\u751f\u5f97\u201c5\u201d\u5206. \u5f97\u201c5\u201d\u5206\u7684\u5b66\u751f\u5360\u5168\u4f53\u5b66\u751f\u7684\u767e\u5206\u4e4b\u51e0\uff1f\n2) \u793e\u533a\u9752\u5c11\u5e74\u5c0f\u7ec4\u5728\u661f\u671f\u516d\u7eff\u5316\u6d3b\u52a8\u4e2d\u690d\u6811 60 \u68f5. \u51ac\u5929\u6b7b\u6389 3 \u68f5. \u6210\u6d3b\u7387\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "278",
      "text": "\u628a\u4e0b\u5217\u5404\u6570\u5316\u6210\u5c0f\u6570\u540e\uff0c\u6c42\u5404\u5f0f\u7684\u503c\uff1a\n1) $12\\frac{3}{4}-2\\frac{7}{8}\\cdot1\\frac{1}{2}$\uff1b\n2) $\\left(17\\frac{19}{20}-8\\frac{47}{50}\\right):\\frac{1}{4}$\uff1b\n3) $25\\frac{5}{8}-3\\frac{1}{4}\\cdot2\\frac{2}{5}$\uff1b\n4) $\\left(2\\frac{23}{40}+6\\frac{13}{20}\\right):2\\frac{1}{2}$.",
      "figure_ids": []
    },
    {
      "number": "279",
      "text": "\u8ba1\u7b97\uff1a\n1) $(28.376+35.99:5.9-3.45\\cdot2.8):3.52$\uff1b\n2) $(6.4\\cdot8.25-32.396+35.51:5.3):4.48$.",
      "figure_ids": []
    },
    {
      "number": "280",
      "text": "\u590f\u4ee4\u8425\u8fdb\u884c\u201c\u5750\u6807\u5bfb\u5b9d\u201d\u6d3b\u52a8. \u5f00\u59cb\u65f6\u5168\u961f\u4f4d\u4e8e $O$ \u70b9\uff08\u53c2\u770b\u56fe 68\uff09. \u7136\u540e\u7b2c\u4e00\u5c0f\u961f\u5230\u5750\u6807\u4e3a 5 \u548c 1 \u7684\u70b9\u53bb\uff0c\u7b2c\u4e8c\u5c0f\u961f\u5230\u70b9 $(-2,4)$ \u53bb\uff0c\u7b2c\u4e09\u5c0f\u961f\u53bb\u70b9 $(1,-3)$. \u5404\u5c0f\u961f\u5728\u8fd9\u4e9b\u70b9\u7559\u4e0b\u6807\u5fd7\u65d7. \u627e\u51fa\u7559\u4e0b\u6807\u5fd7\u65d7\u7684\u5404\u70b9.",
      "figure_ids": [
        "fig-68"
      ]
    },
    {
      "number": "281",
      "text": "\u4f5c\u6298\u7ebf $ABCDE$ \u548c $MNK$\uff0c\u5176\u9876\u70b9\u5750\u6807\u4e3a\uff1a$A(-6,2),B(-4,6),C(1,1),D(2,-5)$\uff0c$E(8,-1)$ \u548c $M(-5,-5),N(-1,7),K(8,4)$.\u6c42\u51fa\u6298\u7ebf $ABCDE$ \u548c $MNK$ \u7684\u4ea4\u70b9\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "282",
      "text": "\u4f5c\u9876\u70b9\u5750\u6807\u4e3a\uff1a$A(-8,6),B(6,5),C(1,-3),D(-7,1)$\u7684\u56db\u8fb9\u5f62 $ABCD$. \u6c42\u51fa\u7ebf\u6bb5 $AC$ \u548c $BD$ \u7684\u4ea4\u70b9\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "283",
      "text": "\u4e70 4 \u516c\u65a4\u7cd6\u679c\u548c 3 \u516c\u65a4\u997c\u5e72\u5171\u4ed8 12 \u7f8e\u5143 20 \u7f8e\u5206. \u4e702\u516c\u65a4\u540c\u6837\u7cd6\u679c\u548c 3 \u516c\u65a4\u540c\u6837\u997c\u5e72\u4ed8 8 \u7f8e\u5143 20 \u7f8e\u5206. 1\u516c\u65a4\u997c\u5e72\u8981\u591a\u5c11\u94b1\uff1f",
      "figure_ids": []
    },
    {
      "number": "284",
      "text": "\u4e00\u957f\u65b9\u5f62\u5468\u957f 84 \u5206\u7c73. \u5b83\u7684\u5bbd\u6bd4\u957f\u77ed 6 \u5206\u7c73. \u6c42\u8fd9\u4e2a\u957f\u65b9\u5f62\u7684\u8fb9\u957f\u548c\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "285",
      "text": "\u8ba1\u7b97\uff1a\n1) $27\\,784:46\\cdot208-41\\,419-(5078+3065)$\uff1b\n2) $185\\cdot216:37+58\\,602-(31\\,600-29\\,097)$.",
