    },
    {
      "number": "422",
      "text": "计算：\n1) $26-(-5)$；\n2) $-4+(-18)$；\n3) $14-(-18)$；\n4) $10-7$；\n5) $4.7-8.1$；\n6) $-3.3-9.6$；\n7) $7-(-4.9)$；\n8) $-5-(-2.9)$；\n9) $-8.6-(-8.6)$.",
