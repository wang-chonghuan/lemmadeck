  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5728\u8fd9\u4ee5\u524d\uff0c\u6211\u4eec\u89e3\u65b9\u7a0b\u65f6\u7528\u4e86\u4e0d\u540c\u7684\u6cd5\u5219.\u6709\u65f6\u8fd0\u7528\u6c42\u672a\u77e5\u52a0\u6570\u7684\u6cd5\u5219\uff0c\u6709\u65f6\u5e94\u7528\u6c42\u672a\u77e5\u88ab\u51cf\u6570\u7684\u6cd5\u5219\uff0c\u8fd8\u6709\u65f6\u5e94\u7528\u6c42\u672a\u77e5\u51cf\u6570\u7684\u6cd5\u5219.\u73b0\u5728\uff0c\u5df2\u7ecf\u5b66\u4e60\u4e86\u6b63\u8d1f\u6570\u7684\u52a0\u6cd5\u548c\u51cf\u6cd5\uff0c\u6211\u4eec\u5c31\u53ef\u4ee5\u7528\u628a\u65b9\u7a0b\u7684\u4e24\u8fb9\u52a0\u4e0a\u540c\u4e00\u4e2a\u6570\u7684\u65b9\u6cd5\u89e3\u6240\u6709\u8fd9\u4e9b\u65b9\u7a0b."
