  "exercises": [
    {
      "number": "160",
      "text": "\u4f5c\u7ebf\u6bb5 $MP$ \u5e76\u53d6\u8fd9\u4e2a\u7ebf\u6bb5\u5916\u4e00\u70b9 $O$. \u4f5c $MP$ \u7684\u5173\u4e8e\u70b9$O$ \u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": []
    },
    {
      "number": "161",
      "text": "\u753b\u4e00\u6b63\u65b9\u5f62 $ABCD$\uff0c\u4f5c\u8fd9\u4e2a\u6b63\u65b9\u5f62\u7684\u5173\u4e8e\u9876\u70b9 $B$ \u7684\u5bf9\u79f0\u56fe\u5f62. \u8bf4\u51fa\u6b63\u65b9\u5f62\u53d8\u6210\u4e86\u4ec0\u4e48\u56fe\u5f62.",
      "figure_ids": []
    },
    {
      "number": "162",
      "text": "\u753b\u4e00\u5706\u5468\uff0c\u5e76\u5728\u5706\u5468\u4e0a\u53d6\u4e00\u70b9 $P$\uff0c\u4f5c\u8fd9\u4e2a\u5706\u5468\u7684\u5173\u4e8e $P$\u70b9\u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": []
    },
    {
      "number": "163",
      "text": "\u627e\u51fa\u56fe 49 \u4e2d\u7684\u4e00\u5bf9\u4e2d\u5fc3\u5bf9\u79f0\u56fe\u5f62. \u6307\u51fa\u5b83\u4eec\u7684\u5bf9\u79f0\u4e2d\u5fc3.",
      "figure_ids": [
        "fig-49"
      ]
    },
    {
      "number": "164",
      "text": "\u56fe 50 \u4e2d\u54ea\u4e2a\u56fe\u5f62\u6709\u5bf9\u79f0\u4e2d\u5fc3\uff1f",
      "figure_ids": [
        "fig-50"
      ]
    },
    {
      "number": "165",
      "text": "\u4f5c\u8fb9\u957f\u4e3a 4 \u5398\u7c73\u7684\u7b49\u8fb9\u4e09\u89d2\u5f62. \u4f5c\u8fd9\u4e2a\u4e09\u89d2\u5f62\u7684\u5173\u4e8e\u4e00\u8fb9\u4e2d\u70b9\u7684\u5bf9\u79f0\u4e09\u89d2\u5f62. \u8fd9\u4e24\u4e2a\u4e09\u89d2\u5f62\u7684\u5e76\u96c6\u662f\u4ec0\u4e48\u56fe\u5f62\uff1f\u5b83\u6709\u6ca1\u6709\u5bf9\u79f0\u4e2d\u5fc3\uff1f",
      "figure_ids": []
    },
    {
      "number": "166",
      "text": "\u4f5c $\\angle MOP=135^\\circ$. \u4f5c\u89d2 $MOP$ \u7684\u5bf9\u9876\u89d2. \u8fd9\u4e2a\u89d2\u662f\u591a\u5c11\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "167",
      "text": "\u753b\u76f8\u4ea4\u7684\u4e8c\u76f4\u7ebf. \u8fd9\u4e24\u6761\u76f4\u7ebf\u5f62\u6210\u51e0\u5bf9\u5bf9\u9876\u89d2\uff1f",
      "figure_ids": []
    },
    {
      "number": "168",
      "text": "\u4e8c\u76f4\u7ebf\u76f8\u4ea4\u65f6\u6240\u5f62\u6210\u7684\u89d2\u4e2d\u6709\u4e00\u4e2a\u662f $72^\\circ$. \u4f5c\u56fe\u5e76\u6c42\u51fa\u5176\u5b83\u5404\u89d2\u7684\u5ea6\u6570.",
      "figure_ids": []
    },
    {
      "number": "169",
      "text": "$X$ \u70b9\u7684\u5750\u6807\u4e3a $-3$. \u5b83\u5411\u53f3\u79fb\u52a8 5 \u4e2a\u5355\u4f4d\uff0c\u53d8\u6210 $B$ \u70b9\uff0c\u800c\u5411\u5de6\u79fb\u52a8 4 \u4e2a\u5355\u4f4d\uff0c\u53d8\u4e3a $C$ \u70b9. \u6c42 $B$\u3001$C$ \u4e24\u70b9\u7684\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "170",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u9972\u517b\u573a\u7684 250 \u5339\u9a6c\u4e2d\uff0c\u6709 30 \u5339\u662f\u4e4c\u9ed1\u8272\u7684\uff0c\u5728\u5176\u4f59\u7684\u9a6c\u4e2d\uff0c\u7070\u8272\u7684\u5360 0.7\uff0c\u9664\u4e4c\u9ed1\u8272\u7684\u548c\u7070\u8272\u7684\u4ee5\u5916\uff0c\u90fd\u662f\u67a3\u7ea2\u8272\u7684. \u6709\u591a\u5c11\u5339\u67a3\u7ea2\u8272\u7684\u9a6c\uff1f\n2) \u8d2d\u4e70\u4e86 120 \u7b52\u80f6\uff0c\u5176\u4e2d\u6709 30 \u7b52\u662f\u6a61\u80f6\uff0c\u5728\u5176\u4f59\u5404\u7b52\u4e2d\u916a\u7d20\u80f6\u5360 0.4\uff0c\u9664\u6a61\u80f6\u548c\u916a\u7d20\u80f6\u4ee5\u5916\uff0c\u8fd8\u4e70\u4e86\u7845\u9178\u76d0\u80f6. \u4e70\u4e86\u591a\u5c11\u7b52\u7845\u9178\u76d0\u80f6\uff1f",
      "figure_ids": []
    },
    {
      "number": "171",
      "text": "\u8ba1\u7b97\uff1a\n1) $51-(3.75:3+86.45:24.7)\\cdot2.4$\uff1b\n2) $11.1+(56.28:6-108.9:19.8)\\cdot2.5$.",
      "figure_ids": []
    },
    {
      "number": "172",
      "text": "\u4f5c\u76f4\u89d2\u4e09\u89d2\u5f62 $ABC$\uff0c\u5b83\u7684\u76f4\u89d2\u8fb9 $AB$ \u548c $BC$ \u7684\u957f\u5206\u522b\u4e3a3.2 \u5398\u7c73\u548c 4.1 \u5398\u7c73. \u4f5c\u4e09\u89d2\u5f62 $ABC$ \u7684\u5173\u4e8e\u9876\u70b9 $A$ \u7684\u5bf9\u79f0\u4e09\u89d2\u5f62.",
      "figure_ids": []
    },
    {
      "number": "173",
      "text": "\u4ee5 $A$ \u4e3a\u5706\u5fc3\u4f5c\u534a\u5f84\u957f\u4e3a 4 \u5398\u7c73\u7684\u5706\u5468. \u4f5c\u534a\u5f84 $AB$\uff0c\u53d6\u5b83\u7684\u4e2d\u70b9 $K$. \u4f5c\u8fd9\u4e2a\u5706\u5468\u7684\u5173\u4e8e\u70b9 $K$ \u7684\u5bf9\u79f0\u56fe\u5f62.",
      "figure_ids": []
    },
    {
      "number": "174",
      "text": "\u7528\u6298\u7eb8\u7684\u65b9\u6cd5\u4f5c\u56fe\uff1a\n1) \u4efb\u610f\u5bf9\u9876\u89d2\uff1b\n2) \u76f4\u89d2\u5bf9\u9876\u89d2.",
      "figure_ids": []
    },
    {
      "number": "175",
      "text": "\u4f5c\u4e8c\u90bb\u8865\u89d2\uff0c\u5176\u4e2d\u7684\u4e00\u4e2a\u89d2\u662f $36^\\circ$. \u4f5c\u8fd9\u4e2a\u89d2\u7684\u5bf9\u9876\u89d2.\u53e6\u4e00\u4e2a\u90bb\u89d2\u7684\u5bf9\u9876\u89d2\u662f\u591a\u5c11\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "176",
      "text": "\u4e00\u751f\u4ea7\u961f\u5728\u5934\u4e09\u5929\u6536\u5272\u4e86 500 \u516c\u9877\u571f\u5730\u4e2d\u7684 225 \u516c\u9877.\u751f\u4ea7\u961f\u8fd8\u8981\u6536\u5272\u5168\u90e8\u9762\u79ef\u7684\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "177",
      "text": "\u53c2\u52a0\u793e\u533a\u751f\u4ea7\u6539\u8fdb\u9879\u76ee\u7684\u5de5\u4f5c\u961f\u51b3\u5b9a\u6bcf\u4e2a\u5de5\u4eba\u7684\u4ea7\u91cf\u7531\u539f\u8ba1\u5212\u7684 20 \u53f0\u4eea\u5668\u589e\u52a0\u5230 25 \u53f0\u4eea\u5668\uff0c\u6bcf\u4e2a\u5de5\u4eba\u5c06\u8d85\u989d\u5b8c\u6210\u539f\u8ba1\u5212\u7684\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "178",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $2.45\\cdot(m-8.8)=4.41$\uff1b\n2) $7.54-3.6k=5.92$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5047\u5982\u70b9 $O$ \u662f\u7ebf\u6bb5 $AB$ \u7684\u4e2d\u70b9\uff0c\u90a3\u4e48 $A$\u3001$B$ \u4e24\u70b9\u53eb\u505a\u5173\u4e8e\u70b9$O$ \u7684\u5bf9\u79f0\u70b9\uff08\u56fe 42\uff09. \u4e3a\u4e86\u4f5c\u70b9 $A$ \u5173\u4e8e\u70b9 $O$ \u7684\u5bf9\u79f0\u70b9 $B$\uff0c\u5fc5\u987b\u5f15\u76f4\u7ebf $AO$\uff0c\u5e76\u5728\u76f4\u7ebf $AO$ \u4e0a\uff0c\u5728\u70b9 $O$ \u7684\u53e6\u4e00\u4fa7\u4f5c\u957f\u5ea6\u548c $AO$ \u76f8\u7b49\u7684\u7ebf\u6bb5 $OB$\uff08\u56fe 43\uff09."
    },
    {
      "block": 7,
      "text": "\u4f5c\u56fe\u5f62 $F$ \u548c\u70b9 $O$\uff0c\u7136\u540e\u53d6\u8fd9\u4e2a\u56fe\u5f62\u6bcf\u4e2a\u70b9\u5173\u4e8e\u70b9 $O$ \u7684\u5bf9\u79f0\u70b9. \u7ed3\u679c\u5f97\u51fa\u4e00\u4e2a\u65b0\u56fe\u5f62 $F_1$\uff0c\u5b83\u548c\u56fe\u5f62 $F$ \u5173\u4e8e\u70b9 $O$ \u5bf9\u79f0\uff08\u56fe 44\uff09. \u70b9 $O$ \u53eb\u505a\u5bf9\u79f0\u4e2d\u5fc3. \u4efb\u4f55\u4e24\u4e2a\u6210\u4e2d\u5fc3\u5bf9\u79f0\u7684\u56fe\u5f62\u90fd\u662f\u5408\u540c\u7684."
    },
    {
      "block": 15,
      "text": "\u56fe 48 \u4e2d\uff0c\u89d2 $AOB$ \u548c\u89d2 $COD$ \u5173\u4e8e\u516c\u5171\u9876\u70b9 $O$ \u5bf9\u79f0. \u8fd9\u6837\u7684\u89d2\u53eb\u505a\u5bf9\u9876\u89d2. \u540c\u4efb\u4f55\u5173\u4e8e\u67d0\u70b9\u5bf9\u79f0\u7684\u4e24\u4e2a\u56fe\u5f62\u4e00\u6837\uff0c\u5bf9\u9876\u89d2\u4e5f\u5408\u540c. \u6240\u4ee5\u8fd9\u4e24\u4e2a\u89d2\u76f8\u7b49\uff0c\u4e5f\u5c31\u662f $\\angle AOB=\\angle COD$. \u5bf9\u9876\u89d2\u4e2d\u7684\u4e00\u4e2a\u89d2\u7684\u4e24\u4e2a\u8fb9\u662f\u53e6\u4e00\u4e2a\u89d2\u7684\u4e24\u4e2a\u8fb9\u7684\u53cd\u5411\u5c04\u7ebf. \u56fe 48\u4e2d\uff0c\u5c04\u7ebf $OC$ \u548c\u5c04\u7ebf $OB$ \u53cd\u5411\uff0c\u800c\u5c04\u7ebf $OD$ \u548c\u5c04\u7ebf $OA$ \u53cd\u5411."
    }
  ],
