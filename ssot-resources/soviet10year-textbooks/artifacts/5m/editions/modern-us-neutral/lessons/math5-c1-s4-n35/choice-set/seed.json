  "exercises": [
    {
      "number": "638",
      "text": "\u753b\u4e24\u6761\u76f8\u4ea4\u7684\u76f4\u7ebf\u548c\u7ebf\u5916\u7684\u4e00\u70b9$P$.\u8fc7\u70b9$P$\u5206\u522b\u5411\u4e24\u6761\u76f4\u7ebf\u4f5c\u5782\u7ebf.",
      "figure_ids": []
    },
    {
      "number": "639",
      "text": "\u753b\u4e00\u4e2a\u5706\u548c\u5b83\u7684\u76f4\u5f84$AB$.\u4f5c\u8fd9\u4e2a\u5706\u7684\u76f4\u5f84$CD$\uff0c\u4f7f\u5b83\u5782\u76f4\u4e8e\u76f4\u5f84$AB$.",
      "figure_ids": []
    },
    {
      "number": "640",
      "text": "\u753b\u4e00\u4e2a\u6b63\u65b9\u5f62$ABCD$\u548c\u5b83\u7684\u5bf9\u89d2\u7ebf$AC$.\u8fc7\u7ebf\u6bb5$AC$\u7684\u4e2d\u70b9\u4f5c$AC$\u7684\u5782\u7ebf.",
      "figure_ids": []
    },
    {
      "number": "641",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $-3\\cdot(2x+1)=-33-3x$\uff1b\n2) $0.4\\cdot(7-5m)=-4+0.4m$\uff1b\n3) $6-x=3\\cdot(-8+3x)$\uff1b\n4) $-1.6\\cdot(x-6)=-1.2\\cdot(x-8)$.",
      "figure_ids": []
    },
    {
      "number": "642",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u67d0\u5de5\u4eba\u6309\u5b9a\u989d\u5e94\u8be5\u5236\u902072\u4e2a\u96f6\u4ef6\uff0c\u800c\u4ed6\u5236\u9020\u4e8690\u4e2a\u96f6\u4ef6.\u8fd9\u4e2a\u5de5\u4eba\u5b8c\u6210\u4e86\u5b9a\u989d\u7684\u767e\u5206\u4e4b\u591a\u5c11\uff1f\u8d85\u989d\u5b8c\u6210\u767e\u5206\u4e4b\u51e0\uff1f\n2) \u519c\u4e1a\u5408\u4f5c\u793e\u6210\u5458\u6309\u5b9a\u989d\u5e94\u8fd0\u8f9364\u5428\u5e72\u8349\uff0c\u4ed6\u8fd0\u8f93\u4e8672\u5428.\u4ed6\u5b8c\u6210\u4e86\u5b9a\u989d\u7684\u767e\u5206\u4e4b\u51e0\uff1f\u8d85\u989d\u5b8c\u6210\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "643",
      "text": "\u753b\u76f4\u7ebf$HK$\uff0c\u53d6\u8fd9\u6761\u76f4\u7ebf\u4e0a\u7684\u4e00\u70b9$A$\u548c\u7ebf\u5916\u7684\u4e00\u70b9$B$.\u5206\u522b\u8fc7\u70b9$A$\u548c\u70b9$B$\u4f5c\u76f4\u7ebf$HK$\u7684\u5782\u7ebf.",
      "figure_ids": []
    },
    {
      "number": "644",
      "text": "\u5927\u5757\u9ebb\u5e03\u662f\u5c0f\u5757\u9ebb\u5e03\u76842\u500d.\u4ece\u5c0f\u5757\u9ebb\u5e03\u526a\u4e0b15\u7c73\uff0c\u4ece\u5927\u5757\u9ebb\u5e03\u526a\u4e0b45\u7c73\u540e\uff0c\u4e24\u5757\u9ebb\u5e03\u957f\u76f8\u7b49.\u5927\u3001\u5c0f\u4e24\u5757\u9ebb\u5e03\u5404\u957f\u591a\u5c11\u7c73\uff1f",
      "figure_ids": []
    },
    {
      "number": "645",
      "text": "\u6309\u56fe122\u5217\u51fa\u65b9\u7a0b\u5e76\u6c42\u89e3.",
      "figure_ids": [
        "fig-122"
      ]
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u4f5c\u76f4\u7ebf\u7684\u5782\u7ebf\u53ef\u4ee5\u7528\u4e09\u89d2\u677f\uff0c\u4e5f\u53ef\u4ee5\u7528\u5706\u89c4\u548c\u76f4\u5c3a. \u5047\u5b9a\u5728\u5e73\u9762\u4e0a\u6709\u4e00\u70b9$K$\u548c\u4e00\u76f4\u7ebf$l$. \u8981\u8fc7\u70b9$K$\u5411\u76f4\u7ebf$l$\u4f5c\u5782\u7ebf\uff0c\u5148\u5728\u76f4\u7ebf$l$\u4e0a\u53d6\u548c\u70b9$K$\u7b49\u8ddd\u7684\u4e24\u70b9$B$\u548c$A$\uff0c\u7136\u540e\u4f5c\u8fd9\u4e24\u70b9\u7684\u5bf9\u79f0\u8f74\uff08\u56fe121\uff09. \u8fd9\u4e2a\u5bf9\u79f0\u8f74\u8fc7\u70b9$K$\u5e76\u4e14\u5782\u76f4\u4e8e\u76f4\u7ebf$l$."
    }
  ],
