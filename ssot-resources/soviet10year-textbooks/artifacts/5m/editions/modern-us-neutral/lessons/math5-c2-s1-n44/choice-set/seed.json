  "exercises": [
    {
      "number": "788",
      "text": "788. \u56fe143\u4e2d\u6709\u51e0\u4e2a\u56fe\u5f62. \u54ea\u4e9b\u56fe\u5f62\u6709\u4e00\u4e2a\u5bf9\u79f0\u8f74\uff0c\u54ea\u4e9b\u6709\u4e24\u4e2a\uff0c\u54ea\u4e9b\u6709\u591a\u4e8e\u4e24\u4e2a\u7684\u5bf9\u79f0\u8f74\uff1f",
      "figure_ids": [
        "fig-143"
      ]
    },
    {
      "number": "789",
      "text": "789. \u7ebf\u6bb5\u548c\u76f4\u7ebf\u5404\u6709\u51e0\u4e2a\u5bf9\u79f0\u8f74\uff1f",
      "figure_ids": []
    },
    {
      "number": "790",
      "text": "790. \u4e00\u4e2a\u5706\u5468\u548c\u5b83\u7684\u4e00\u4e2a\u76f4\u5f84\u7684\u5e76\u96c6\u6709\u51e0\u4e2a\u5bf9\u79f0\u8f74\uff1f",
      "figure_ids": []
    },
    {
      "number": "791",
      "text": "791. \u8bc1\u660e\uff0c\u8fc7\u4e24\u4e2a\u76f8\u4ea4\u5706\u5706\u5fc3\u7684\u76f4\u7ebf\u662f\u8fd9\u4e24\u4e2a\u5706\u7684\u5e76\u96c6\u7684\u5bf9\u79f0\u8f74(\u56fe144).",
      "figure_ids": [
        "fig-144"
      ]
    },
    {
      "number": "792",
      "text": "792. \u76f4\u7ebf$BD$\u8fc7\u7b49\u8170\u4e09\u89d2\u5f62$ABC$\u7684\u9876\u70b9$B$\u548c\u5e95\u8fb9$AC$\u7684\u4e2d\u70b9$D$(\u56fe145).\u8bc1\u660e\uff0c\u76f4\u7ebf$BD$\u662f\u4e09\u89d2\u5f62$ABC$\u7684\u5bf9\u79f0\u8f74.",
      "figure_ids": [
        "fig-145"
      ]
    },
    {
      "number": "793",
      "text": "793. \u6bd4\u8f83\u4e0b\u5217\u5404\u5206\u6570\u7684\u5927\u5c0f\uff1a\n1) $\\frac{5}{7}$\u548c$\\frac{7}{10}$\uff1b\n2) $\\frac{11}{8}$\u548c$\\frac{13}{11}$\uff1b\n3) $\\frac{4}{7}$\u548c$\\frac{7}{10}$\uff1b\n4) $\\frac{12}{11}$\u548c$\\frac{11}{10}$.",
      "figure_ids": []
    },
    {
      "number": "794",
      "text": "794. \u8bc1\u660e\u4e0d\u7b49\u5f0f\uff1a\n1) $\\frac{200}{4201}<\\frac{1}{20}$\uff1b\n2) $\\frac{125}{361}>\\frac{1}{3}$.",
      "figure_ids": []
    },
    {
      "number": "795",
      "text": "795. \u628a\u4e0b\u5217\u5404\u6570\u5206\u89e3\u8d28\u56e0\u6570\uff1a\n1) 720\uff0c1890\uff1b\n2) 840\uff0c1440.",
      "figure_ids": []
    },
    {
      "number": "796",
      "text": "796. \u6c42\u70b9$M(x,y)$\u5728\u5750\u6807\u5e73\u9762\u4e0a\u7684\u4f4d\u7f6e\uff0c\u5f53\n1) $2\\leqslant x\\leqslant6$\uff1b\n2) $3\\leqslant y\\leqslant5$\u65f6.",
      "figure_ids": []
    },
    {
      "number": "797",
      "text": "797. \u89e3\u5e94\u7528\u9898\uff1a\n1) Alex\u6355\u5230\u51e0\u6761\u9c88\u9c7c\uff0c\u91cf\u4e86\u9c7c\u7684\u957f\u5ea6\uff1a\u5176\u4e2d2\u6761\u9c7c\u5404\u957f20\u5398\u7c73\uff0c5\u6761\u9c7c\u5404\u957f16\u5398\u7c73\uff0c1\u6761\u9c7c\u957f12\u5398\u7c73. \u6c42\u8fd9\u51e0\u6761\u9c7c\u7684\u5e73\u5747\u957f\u5ea6.\n2) Sam\u6355\u5230\u51e0\u6761\u68ad\u9c7c\uff0c\u91cf\u4e86\u5b83\u4eec\u7684\u957f\u5ea6\uff1a\u5176\u4e2d\u4e00\u6761\u957f52\u5398\u7c73\uff0c5\u6761\u5404\u957f48\u5398\u7c73\uff0c2\u6761\u5404\u957f34\u5398\u7c73.\u6c42\u8fd9\u51e0\u6761\u68ad\u9c7c\u7684\u5e73\u5747\u957f\u5ea6.",
      "figure_ids": []
    },
    {
      "number": "798",
      "text": "798. \u5728\u56fe146\u4e0a\u753b\u6709\u516b\u8fb9\u5f62\u548c\u6b63\u65b9\u5f62. \u516b\u8fb9\u5f62\u7684\u5404\u89d2\u90fd\u662f\u5408\u540c\u7684. \u8fd9\u4e9b\u516b\u8fb9\u5f62\u7684\u6bcf\u4e2a\u89d2\u662f\u591a\u5c11\u5ea6\uff1f",
      "figure_ids": [
        "fig-146"
      ]
    },
    {
      "number": "799",
      "text": "799. \u8ba1\u7b97\uff1a\n1) $[(169.68:5.6-22.8)\\cdot9.4+9.7]\\cdot22.5$\uff1b\n2) $[(253.26:6.3-31.7)\\cdot8.6+7.4]\\cdot32.6$.",
      "figure_ids": []
    },
    {
      "number": "800",
      "text": "800. \u5728\u56fe147\u6240\u753b\u5b57\u5f62\u7684\u82f1\u6587\u5927\u5199\u5b57\u6bcd\u4e2d\u54ea\u4e9b\u6709\u94c5\u5782\u5bf9\u79f0\u8f74\uff0c\u54ea\u4e9b\u6709\u6c34\u5e73\u5bf9\u79f0\u8f74\uff0c\u54ea\u4e9b\u517c\u6709\u94c5\u5782\u5bf9\u79f0\u8f74\u548c\u6c34\u5e73\u5bf9\u79f0\u8f74\uff1f\u54ea\u4e9b\u5b57\u6bcd\u6ca1\u6709\u5bf9\u79f0\u8f74\uff1f",
      "figure_ids": [
        "fig-147"
      ]
    },
    {
      "number": "801",
      "text": "801. \u753b\u4e09\u89d2\u5f62$ABC$. \u4f5c\u4e09\u89d2\u5f62$ABC$\u7684\u5173\u4e8e$AB$\u8fb9\u7684\u8f74\u5bf9\u79f0\u56fe\u5f62. \u8bc1\u660e\uff0c\u8fd9\u4e24\u4e2a\u4e09\u89d2\u5f62\u7684\u5e76\u96c6\u6709\u5bf9\u79f0\u8f74.",
      "figure_ids": []
    },
    {
      "number": "802",
      "text": "802. \u67d0\u50a8\u6237\u5728\u50a8\u84c4\u6240\u5b58\u5b9a\u671f\u5b58\u6b3e\uff0c\u5e74\u52293%. \u4e00\u5e74\u540e\u5b58\u6b3e\u53d8\u6210412\u7f8e\u5143. \u8fd9\u4f4d\u50a8\u6237\u5728\u50a8\u84c4\u6240\u5b58\u4e86\u591a\u5c11\u7f8e\u5143\uff1f",
      "figure_ids": []
    },
    {
      "number": "803",
      "text": "803. \u8ba1\u7b97\uff1a\n1) $40.4\\cdot[26.3-(37.76:5.9+41.39):8.1]$\uff1b\n2) $30.3\\cdot[124.9-(48.96:6.8+36.04):9.2]$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u56fe139\u753b\u7684\u662f\u4e00\u5ea7\u82b1\u56ed\u7684\u5927\u95e8. \u4e24\u6247\u5927\u95e8\u5173\u4e8e\u76f4\u7ebf$l$\u5bf9\u79f0. \u5982\u679c\u4f5c\u5173\u4e8e\u8fd9\u6761\u76f4\u7ebf\u7684\u5bf9\u79f0\u56fe\u5f62\uff0c\u5c31\u53ef\u4ee5\u5f97\u5230\u76f8\u540c\u7684\u56fe\u5f62. \u5982\u679c\u4e00\u4e2a\u56fe\u5f62\u7ecf\u8fc7\u5bf9\u79f0\u79fb\u52a8\u53d8\u6210\u5b83\u81ea\u5df1\uff0c\u5c31\u8bf4\uff0c**\u8fd9\u4e2a\u56fe\u5f62\u5173\u4e8e\u76f4\u7ebf$l$\u5bf9\u79f0.** \u8fd9\u65f6\u76f4\u7ebf$l$\u53eb\u505a**\u56fe\u5f62\u7684\u5bf9\u79f0\u8f74.** \u5bf9\u79f0\u8f74\u628a\u56fe\u5f62\u5206\u6210\u76f8\u4e92\u5bf9\u79f0\u7684\u4e24\u90e8\u5206."
    }
  ],
