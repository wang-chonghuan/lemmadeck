          },
          {
            "id": "B",
            "text": "$\\frac15=\\frac55,\\quad\\frac37=\\frac{15}{7},\\quad\\frac{25}{8}=\\frac{125}{8},\\quad\\frac{39}{40}=\\frac{195}{40}$。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$\\frac15=\\frac1{25},\\quad\\frac37=\\frac3{35},\\quad\\frac{25}{8}=\\frac{25}{40},\\quad\\frac{39}{40}=\\frac{39}{200}$。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$\\frac15=\\frac6{10},\\quad\\frac37=\\frac8{12},\\quad\\frac{25}{8}=\\frac{30}{13},\\quad\\frac{39}{40}=\\frac{44}{45}$。",
            "figure_ids": []
