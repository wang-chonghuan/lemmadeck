  "chapter": "第二章　有理数",
  "section": "§6. 乘法和除法",
  "number": "49",
  "title": "比例",
  "printed_title": "49. 比例",
  "start_page": 213,
  "start_printed": 204,
  "figures": [
    {
      "id": "fig-154",
