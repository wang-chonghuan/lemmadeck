  "exercises": [
    {
      "number": "244",
      "text": "\u4f5c\u957f 4 \u5398\u7c73\u7684\u7ebf\u6bb5 $AB$\uff0c\u5728\u7ebf\u6bb5\u5916\u53d6\u70b9 $C_1$. \u5e73\u79fb\u7ebf\u6bb5$AB$\uff0c\u4f7f\u5176\u4e2d\u70b9 $C$ \u79fb\u5230\u70b9 $C_1$.",
      "figure_ids": []
    },
    {
      "number": "245",
      "text": "\u4f5c\u8fb9\u957f 4 \u5398\u7c73\u7684\u6b63\u65b9\u5f62 $ABCD$\uff0c\u5e76\u4e14\u5728\u8fd9\u4e2a\u6b63\u65b9\u5f62\u5916\u53d6\u70b9 $A_1$. \u5e73\u79fb\u6b63\u65b9\u5f62\uff0c\u4f7f\u70b9 $A$ \u79fb\u5230\u70b9 $A_1$.",
      "figure_ids": []
    },
    {
      "number": "246",
      "text": "\u56fe 62 \u4e2d\u753b\u6709\u957f\u65b9\u5f62 $ABCD$ \u548c\u70b9 $K$. \u5e73\u79fb\u8fd9\u4e2a\u957f\u65b9\u5f62\uff0c\u4f7f\u70b9 $A$ \u4e0e\u70b9 $K$ \u91cd\u5408. \u5e73\u79fb\u540c\u4e00\u957f\u65b9\u5f62\uff0c\u4f7f\u70b9 $C$ \u4e0e\u70b9 $K$\u91cd\u5408.",
      "figure_ids": [
        "fig-62"
      ]
    },
    {
      "number": "247",
      "text": "\u56fe 63 \u4e2d\u54ea\u4e9b\u56fe\u5f62\u662f\u7531\u53e6\u4e00\u4e2a\u56fe\u5f62\u5e73\u79fb\u5f97\u6765\u7684\uff1f",
      "figure_ids": [
        "fig-63"
      ]
    },
    {
      "number": "248",
      "text": "\u56fe 64 \u4e2d\u753b\u6709\u4e09\u89d2\u5f62 $ABC$. \u5728\u81ea\u5df1\u7684\u7ec3\u4e60\u672c\u4e0a\u4f5c\u540c\u6837\u7684\u4e09\u89d2\u5f62\u5e76\u4e14\u4f7f\u5b83\u5411\u4e0b\u5e73\u79fb\u4e03\u4e2a\u683c. \u518d\u628a\u6240\u5f97\u7684\u4e09\u89d2\u5f62\u5411\u53f3\u79fb 4 \u4e2a\u683c.",
      "figure_ids": [
        "fig-64"
      ]
    },
    {
      "number": "249",
      "text": "\u5047\u8bbe\u677e\u9f20\u5728\u6811\u4e0a\u505c\u7559\u70b9\u7684\u5750\u6807\u4e3a $x$\uff0c\u800c\u5544\u6728\u9e1f\u843d\u7684\u70b9\u7684\u5750\u6807\u4e3a $y$. \u5982\u679c\uff1a\n1) $x=2.4,\\ y=6.1$\uff1b\n2) $x=3,\\ y=-4$\uff1b\n3) $x=-3,\\ y=4$\uff1b\n4) $x=-3,\\ y=-6$\uff0c\u54ea\u4e00\u4e2a\u505c\u7559\u7684\u4f4d\u7f6e\u66f4\u9ad8\u4e9b\uff1f",
      "figure_ids": []
    },
    {
      "number": "250",
      "text": "\u6bd4\u8f83\u4e0b\u5217\u5404\u6570\u7684\u5927\u5c0f\uff1a\n1) $0$ \u548c $-800$\uff1b\n2) $-68$ \u548c $0$\uff1b\n3) $-39$ \u548c $201$\uff1b\n4) $59$ \u548c $-80$\uff1b\n5) $-45$ \u548c $-20$\uff1b\n6) $-2$ \u548c $-30$.",
      "figure_ids": []
    },
    {
      "number": "251",
      "text": "\u4e0b\u5217\u6bcf\u4e24\u4e2a\u6570\u4e4b\u95f4\u5305\u62ec\u54ea\u4e9b\u6574\u6570\uff1a\n1) $-8.8$ \u548c $3.85$\uff1b\n2) $-3.11$ \u548c $3.11$\uff1b\n3) $-9.2$ \u548c $4.73$\uff1b\n4) $-3.22$ \u548c $3.22$.",
      "figure_ids": []
    },
    {
      "number": "252",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u4e0b\u5217\u4e0d\u7b49\u5f0f\u89e3\u7684\u96c6\u5408\uff1a\n1) $-3.2\\leqslant y\\leqslant5.5$\uff1b\n2) $-9.8\\leqslant y\\leqslant-4.8$\uff1b\n3) $x\\geqslant-3$\uff1b\n4) $x\\leqslant5$.",
      "figure_ids": []
    },
    {
      "number": "253",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e00\u65c5\u884c\u8005\u4e58\u6c7d\u8247\u9006\u6d41\u822a\u884c 3 \u5c0f\u65f6\uff0c\u8fd4\u56de\u65f6\u4e58\u6728\u7b4f. \u5982 \u679c\u6c7d\u8247\u7684\u901f\u5ea6\u662f 24 \u516c\u91cc/\u5c0f\u65f6\uff0c\u6cb3\u6c34\u6d41\u901f\u4e3a 3 \u516c\u91cc /\u5c0f\u65f6\uff0c\u90a3\u4e48\u65c5\u884c\u8005\u8fd4\u56de\u9014\u4e2d\u7528\u4e86\u591a\u5c11\u65f6\u95f4\uff1f\n2) \u65c5\u884c\u8005\u4e58\u6728\u7b4f\u5728 25 \u5c0f\u65f6\u5185\u987a\u6d41\u822a\u884c 75 \u516c\u91cc. \u8fd4\u56de \u65f6\u4e58\u6c7d\u8247\uff0c\u6c7d\u8247\u7684\u901f\u5ea6\u4e3a 28 \u516c\u91cc/\u5c0f\u65f6. \u65c5\u884c\u8005\u5728 \u8fd4\u56de\u9014\u4e2d\u7528\u4e86\u591a\u5c11\u65f6\u95f4\uff1f",
      "figure_ids": []
    },
    {
      "number": "254",
      "text": "2024 \u5e74\u67d0\u5730\u533a\u751f\u4ea7\u4e86 98 \u4ebf 2500 \u4e07\u5e73\u65b9\u7c73\u5404\u79cd\u7ec7\u7269. \u8be5\u5730\u533a\u6bcf\u4eba\u5e73\u5747\u6709\u51e0\u5e73\u65b9\u7c73\u7ec7\u7269\uff08\u4eba\u53e3\u6309 2 \u4ebf 5 \u5343\u4e07\u8ba1\uff09\uff1f",
      "figure_ids": []
    },
    {
      "number": "255",
      "text": "\u793e\u533a\u519c\u573a\u4e3a\u704c\u6e89\u9762\u79ef\u4e3a 2.7 \u516c\u9877\u7684\u83dc\u56ed\uff0c\u5b89\u88c5\u4e86\u55b7\u704c\u88c5\u7f6e. \u4e3a\u4e86\u4ee3\u66ff 5 \u6beb\u7c73\u7684\u964d\u6c34\uff0c\u55b7\u704c\u88c5\u7f6e\u5e94\u7ed9\u6c34\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "256",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $97.5\\cdot(a-45.9)=126.75$\uff1b\n2) $(309.01-b):6.05=0.6$.",
      "figure_ids": []
    },
    {
      "number": "257",
      "text": "\u8bbe $|AB|=|BC|=5$ \u5398\u7c73\uff0c$|AC|=3$ \u5398\u7c73\uff0c\u4f5c\u4e09\u89d2\u5f62$ABC$. \u5e73\u79fb\u4e09\u89d2\u5f62\uff0c\u4f7f\u9876\u70b9 $B$ \u79fb\u5230\u9876\u70b9 $C$.",
      "figure_ids": []
    },
    {
      "number": "258",
      "text": "\u4f5c\u6b63\u65b9\u5f62 $ABCD$ \u548c\u5b83\u7684\u4e24\u6761\u5bf9\u89d2\u7ebf. \u5728\u6b63\u65b9\u5f62\u5916\u53d6\u70b9$M$. \u5e73\u79fb\u8fd9\u4e2a\u6b63\u65b9\u5f62\uff0c\u4f7f\u5bf9\u89d2\u7ebf\u4ea4\u70b9 $O$ \u79fb\u5230\u70b9 $M$.",
      "figure_ids": []
    },
    {
      "number": "259",
      "text": "\u4f9b\u5e94\u7ad9\u6709\u897f\u74dc 16 \u5428. \u65e9\u6668\u4ece\u4f9b\u5e94\u7ad9\u8fd0\u51fa 6 \u5428\u897f\u74dc\uff0c\u4ee5\u540e\u53c8\u8fd0\u51fa 4 \u5428\uff0c\u665a\u4e0a\u4f9b\u5e94\u7ad9\u53c8\u8fd0\u8fdb 12 \u5428\u897f\u74dc. \u5728\u6570\u8f74\u4e0a\u8868\u793a\u51fa\u8fd9\u4e9b\u53d8\u5316.",
      "figure_ids": []
    },
    {
      "number": "260",
      "text": "\u67d0\u57fa\u91d1\u7b2c\u4e09\u9636\u6bb5\u7684\u6536\u5165\u662f 11 780 \u4ebf\u7f8e\u5143. \u8fd9\u662f\u7b2c\u4e8c\u9636\u6bb5\u6536\u5165\u7684 142%\uff0c\u662f\u7b2c\u4e00\u9636\u6bb5\u7684 213%. \u6c42\u7b2c\u4e00\u9636\u6bb5\u548c\u7b2c\u4e8c\u9636\u6bb5\u7684\u6536\u5165\uff08\u7ed3\u679c\u4fdd\u7559\u5230\u5341\u4ebf\uff09.",
      "figure_ids": []
    },
    {
      "number": "261",
      "text": "\u8ba1\u7b97\uff1a\n1) $87\\cdot(5769-5632)+16\\,317:(4401-4068)$\uff1b\n2) $26\\,752:(2724-2306)+62\\cdot(7762-7345)$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u4e3a\u4e86\u7ed9\u5b9a\u56fe\u5f62\u7684\u5e73\u79fb\uff0c\u53ea\u8981\u77e5\u9053\u8fd9\u4e2a\u56fe\u5f62\u7684\u4e00\u4e2a\u70b9\u79fb\u52a8\u5230\u54ea\u91cc\u5c31\u8db3\u591f\u4e86. \u5047\u5982\u5728\u5e73\u79fb\u65f6\uff0c\u70b9 $A$ \u79fb\u5230\u70b9 $A_1$\uff08\u56fe 58\uff09. \u8981\u60f3\u77e5\u9053\u8fd9\u4e2a\u56fe\u5f62\u7684 $B$ \u70b9\u79fb\u5230\u54ea\u91cc\uff0c\u4f5c\u6cd5\u5982\u4e0b\uff1a\u8054\u7ed3\u70b9 $A$ \u548c\u70b9 $A_1$\uff0c\u5e76\u4e14\u4ece $B$ \u70b9\u4f5c\u548c $AA_1$ \u7ebf\u6bb5\u5e73\u884c\u7684\u7ebf\u6bb5 $BB_1$\uff0c\u4f7f\u5b83\u4e0e $AA_1$ \u957f\u5ea6\u76f8\u7b49\u3001\u65b9\u5411\u76f8\u540c\uff0c\u4e8e\u662f\u70b9 $B$ \u79fb\u5230\u70b9 $B_1$."
    }
