  "exercises": [
    {
      "number": "39",
      "text": "\u6309\u56fe 5 \u5199\u51fa $X$ \u548c $Y$ \u7684\u5e76\u96c6.",
      "figure_ids": [
        "fig-05"
      ]
    },
    {
      "number": "40",
      "text": "\u5df2\u77e5\u4e09\u4e2a\u96c6\u5408\uff1a $A$={b, c, d, e, f}; $B$={b, d, f, i, l};$C$={c, e, g}. \u7528\u5927\u62ec\u53f7\u6216\u7b26\u53f7 $\\phi$ \u5199\u51fa\u4e0b\u5217\u96c6\u5408\uff1a $A \\cup B$,$A \\cap B, B \\cap A, B \\cup A, A \\cap C, A \\cup C, B \\cap C, B \\cup C$.",
      "figure_ids": []
    },
    {
      "number": "41",
      "text": "\u5728\u5c04\u7ebf\u4e0a\u6807\u51fa 3, 6, 10 \u7684\u5bf9\u5e94\u70b9 $A, B, C$. \u6c42\u4e0b\u5217\u96c6\u5408\u7684\u5e76\u96c6\uff1a\n1\uff09$[AB]$ \u548c $[BC]$\uff1b\n2\uff09$[AC]$ \u548c $[BC]$.",
      "figure_ids": []
    },
    {
      "number": "42",
      "text": "\u7528 $A$ \u8868\u793a\u6211\u4eec\u73ed\u4e0a 11 \u5c81\u4ee5\u4e0a\u7684\u5b66\u751f\u7684\u96c6\u5408\uff0c\u7528 $B$ \u8868\u793a\u6211\u4eec\u73ed 12 \u5c81\u4ee5\u4e0b\u7684\u5b66\u751f\u7684\u96c6\u5408. \u6c42\u8fd9\u4e24\u4e2a\u96c6\u5408\u7684\u5e76\u96c6.",
      "figure_ids": []
    },
    {
      "number": "43",
      "text": "\u4ece\u96c6\u5408 $X$={67, 48, 90, 45, 76, 25}\u4e2d\u6311\u51fa\u7531 5 \u7684\u500d\u6570\u7ec4\u6210\u7684\u5b50\u96c6 $A$ \u548c\u7531 3 \u7684\u500d\u6570\u7ec4\u6210\u7684\u5b50\u96c6 $B$. \u6c42\u51fa\u8fd9\u4e24\u4e2a\u5b50\u96c6\u7684\u4ea4\u96c6.",
      "figure_ids": []
    },
    {
      "number": "44",
      "text": "$M$ \u662f\u6211\u4eec\u73ed\u53c2\u52a0\u79d1\u5b66\u793e\u56e2\u7684\u5b66\u751f\u96c6\u5408\uff0c $N$ \u662f\u590f\u4ee4\u8425\u5f92\u6b65\u6d3b\u52a8\u53c2\u52a0\u8005\u7684\u96c6\u5408. $M \\cap N$ \u8868\u793a\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "45",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1\uff091965 \u5e74\u67d0\u6559\u80b2\u57fa\u91d1\u53d1\u653e\u5927\u5b66\u751f\u5956\u5b66\u91d1 9 \u4ebf\u7f8e\u5143\uff0c1972 \u5e74\u53d1\u653e 15 \u4ebf\u7f8e\u5143. \u4ece 1965 \u5e74\u5230 1972 \u5e74\uff0c\u5956\u5b66\u91d1\u589e\u52a0\u4e86\u767e\u5206\u4e4b\u51e0\uff1f\n2\uff091972 \u5e74\uff0c\u7532\u5730\u533a\u6bcf 10 000 \u4eba\u4e2d\u6709 30 \u540d\u533b\u751f\uff0c\u4e59\u5730\u533a\u6bcf10 000 \u4eba\u4e2d\u6709 20 \u540d\u533b\u751f. \u4e59\u5730\u533a\u7684\u533b\u751f\u6bd4\u7532\u5730\u533a\u5c11\u767e\u5206\u4e4b\u51e0(\u6309 10 000 \u4eba\u8ba1).",
      "figure_ids": []
    },
    {
      "number": "46",
      "text": "$K$ \u662f 15 \u7684\u7ea6\u6570\u7684\u96c6\u5408\uff0c $M$ \u662f 18 \u7684\u7ea6\u6570\u7684\u96c6\u5408\uff0c $P$ \u662f 9 \u7684\u7ea6\u6570\u7684\u96c6\u5408. \u5728\u5927\u62ec\u53f7\u5185\u5199\u51fa\u4e0b\u5217\u5404\u96c6\u5408\uff1a\n1\uff09$K \\cup M$\uff1b\n2\uff09$K \\cap M$\uff1b\n3\uff09$M \\cup P$\uff1b\n4\uff09$M \\cap P$.",
      "figure_ids": []
    },
    {
      "number": "47",
      "text": "$A$={7, 8, 9, 10}\uff0c $C$={9, 10, 11, 12, 13}. \u5728\u5927\u62ec\u53f7\u5185\u5199\u51fa\u4e0b\u5217\u96c6\u5408\uff1a\n1\uff09$A \\cap C$\uff1b\n2\uff09$A \\cup C$.",
      "figure_ids": []
    },
    {
      "number": "48",
      "text": "\u6309\u56fe 10 \u56de\u7b54\uff1a\n1\uff09\u54ea\u6761\u76f4\u7ebf\u5e73\u884c\u4e8e\u76f4\u7ebf$m$\uff1f\n2\uff09\u54ea\u6761\u76f4\u7ebf\u4e0e\u76f4\u7ebf $m$ \u76f8\u4ea4\uff1f",
      "figure_ids": [
        "fig-10"
      ]
    }
  ],
