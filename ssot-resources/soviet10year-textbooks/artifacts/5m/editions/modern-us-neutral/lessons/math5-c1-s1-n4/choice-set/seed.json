      "number": "49",
      "text": "求证长方形的对边平行.",
      "figure_ids": []
    },
    {
      "number": "50",
      "text": "作 5 条互相平行的直线.",
      "figure_ids": []
    },
    {
      "number": "51",
      "text": "作直线 $l$ 并取线外两点 $M$ 和 $K$，过点 $M$ 和 $K$ 作平行于 $l$的两条直线.",
      "figure_ids": []
    },
