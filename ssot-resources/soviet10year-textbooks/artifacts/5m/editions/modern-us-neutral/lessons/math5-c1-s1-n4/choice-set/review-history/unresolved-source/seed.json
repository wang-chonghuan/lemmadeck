  "exercises": [
    {
      "number": "49",
      "text": "\u6c42\u8bc1\u957f\u65b9\u5f62\u7684\u5bf9\u8fb9\u5e73\u884c.",
      "figure_ids": []
    },
    {
      "number": "50",
      "text": "\u4f5c 5 \u6761\u4e92\u76f8\u5e73\u884c\u7684\u76f4\u7ebf.",
      "figure_ids": []
    },
    {
      "number": "51",
      "text": "\u4f5c\u76f4\u7ebf $l$ \u5e76\u53d6\u7ebf\u5916\u4e24\u70b9 $M$ \u548c $K$\uff0c\u8fc7\u70b9 $M$ \u548c $K$ \u4f5c\u5e73\u884c\u4e8e $l$\u7684\u4e24\u6761\u76f4\u7ebf.",
      "figure_ids": []
    },
    {
      "number": "52",
      "text": "\u4f5c\u4e09\u89d2\u5f62\u5e76\u8fc7\u6bcf\u4e00\u9876\u70b9\u4f5c\u4e00\u6761\u5e73\u884c\u4e8e\u5bf9\u8fb9\u7684\u76f4\u7ebf.",
      "figure_ids": []
    },
    {
      "number": "53",
      "text": "\u5229\u7528\u76f4\u5c3a\u548c\u4e09\u89d2\u677f\u627e\u51fa\u56fe 13 \u4e2d\u7684\u6bcf\u5bf9\u5e73\u884c\u7ebf.",
      "figure_ids": [
        "fig-13"
      ]
    },
    {
      "number": "54",
      "text": "\u96c6\u5408 $A$ \u7531\u524d\u56db\u4e2a 3 \u7684\u500d\u6570\u7684\u81ea\u7136\u6570\u7ec4\u6210\uff0c\u96c6\u5408 $B$ \u7531\u524d\u4e09\u4e2a 6 \u7684\u500d\u6570\u7684\u81ea\u7136\u6570\u7ec4\u6210. \u5728\u5927\u62ec\u53f7\u5185\u5199\u51fa $A$\u3001$B$ \u7684\u4ea4\u96c6\u548c\u5e76\u96c6.",
      "figure_ids": []
    },
    {
      "number": "55",
      "text": "$X$ \u662f\u4e0d\u7b49\u5f0f $7 \\leqslant X \\leqslant 12$ \u7684\u81ea\u7136\u6570\u89e3\u7684\u96c6\u5408\uff1b $Y$ \u662f\u4e0d\u7b49\u5f0f$5 \\leqslant Y \\leqslant 8$ \u7684\u81ea\u7136\u6570\u89e3\u7684\u96c6\u5408. \u6c42\uff1a\n1) $X \\cap Y$\uff1b\n2) $X \\cup Y$.",
      "figure_ids": []
    },
    {
      "number": "56",
      "text": "\u5199\u51fa 60 \u548c 24 \u7684\u7ea6\u6570\u7684\u96c6\u5408\u5e76\u6c42\u51fa\u8fd9\u4e24\u4e2a\u96c6\u5408\u7684\u4ea4\u96c6. \u6c42\u51fa 60 \u548c 24 \u7684\u6700\u5927\u516c\u7ea6\u6570.",
      "figure_ids": []
    },
    {
      "number": "57",
      "text": "\u4f5c\u4e24\u4e2a\u4e09\u89d2\u5f62\uff0c\u4f7f\uff1a\n1) \u4ea4\u96c6\u662f\u4e00\u4e2a\u7ebf\u6bb5\uff0c\u800c\u5e76\u96c6\u4e3a\u56db\u8fb9\u5f62\uff1b\n2) \u4ea4\u96c6\u4e3a\u4e00\u7ebf\u6bb5\uff0c\u800c\u5e76\u96c6\u4e3a\u4e09\u89d2\u5f62.",
      "figure_ids": []
    },
    {
      "number": "58",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u76f8\u5411\u800c\u884c\u7684\u4e24\u5217\u706b\u8f66\u76f8\u8ddd 900 \u516c\u91cc\uff0c\u4e24\u8f66\u884c\u901f\u5206\u522b\u4e3a65 \u516c\u91cc/\u5c0f\u65f6\u548c 85 \u516c\u91cc/\u5c0f\u65f6. \u7ecf\u8fc7\u51e0\u5c0f\u65f6\u540e\uff0c\u8fd9\u4e24\u5217\u706b\u8f66\u76f8\u9047\uff1f\n2) \u76f8\u5411\u822a\u884c\u7684\u4e24\u8258\u8f6e\u8239\u76f8\u8ddd 236 \u516c\u91cc. \u4e24\u8239\u7684\u822a\u901f\u5206\u522b\u4e3a 32 \u516c\u91cc/\u5c0f\u65f6\u548c 27 \u516c\u91cc/\u5c0f\u65f6. \u51e0\u5c0f\u65f6\u540e\u4e24\u8239\u76f8\u9047\uff1f",
      "figure_ids": []
    },
    {
      "number": "59",
      "text": "\u5217\u51fa\u65b9\u7a0b\u89e3\u5e94\u7528\u9898\uff1a\n1) \u67d0\u5e02\u5404\u5de5\u5382\u5728\u4e09\u5e74\u5185\u6709 171 \u79cd\u4ea7\u54c1\u83b7\u5f97\u521b\u65b0\u5956. \u7b2c\u4e00\u5e74\u83b7\u5956\u7684\u4ea7\u54c1\u6bd4\u7b2c\u4e09\u5e74\u5c11\u4e00\u534a\uff0c\u7b2c\u4e8c\u5e74\u6bd4\u7b2c\u4e00\u5e74\u591a 23 \u79cd\u4ea7\u54c1. \u7b2c\u4e00\u5e74\u83b7\u5956\u7684\u4ea7\u54c1\u6709\u591a\u5c11\u79cd\uff1f\n2) \u67d0\u5382\u4e09\u4e2a\u8f66\u95f4\u5171\u6709 91 \u540d\u4f18\u79c0\u6280\u672f\u5458. \u7b2c\u4e00\u8f66\u95f4\u7684\u4f18\u79c0\u6280\u672f\u5458\u4eba\u6570\u662f\u7b2c\u4e8c\u8f66\u95f4\u7684 2 \u500d\uff0c\u7b2c\u4e09\u8f66\u95f4\u6bd4\u7b2c\u4e8c\u8f66\u95f4\u591a 7 \u4eba. \u7b2c\u4e00\u8f66\u95f4\u6709\u591a\u5c11\u540d\u4f18\u79c0\u6280\u672f\u5458\uff1f",
      "figure_ids": []
    },
    {
      "number": "60",
      "text": "\u628a\u4e0b\u5217\u5404\u6570\u5316\u6210\u5c0f\u6570\uff1a $\\frac{1}{2}$\uff0c $\\frac{1}{4}$\uff0c $\\frac{3}{4}$\uff0c $\\frac{1}{5}$\uff0c $\\frac{4}{5}$\uff0c $\\frac{1}{10}$\uff0c $\\frac{7}{10}$\uff0c $\\frac{3}{20}$\uff0c $2\\frac{1}{2}$\uff0c $3\\frac{3}{4}$\uff0c $5\\frac{7}{20}$.",
      "figure_ids": []
    },
    {
      "number": "61",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $14n-8n-2n=511$\uff1b\n2) $25a-7a-16a=33$\uff1b\n3) $4x+6x-x=21.6$\uff1b\n4) $5y-y+5y=61.2$.",
      "figure_ids": []
    },
    {
      "number": "62",
      "text": "\u628a\u56fe 14 \u753b\u5728\u7ec3\u4e60\u672c\u4e0a. \u8fc7 $K$ \u70b9\u5f15\u4e00\u76f4\u7ebf\u5e73\u884c\u4e8e\u76f4\u7ebf $a$.",
      "figure_ids": [
        "fig-14"
      ]
    },
    {
      "number": "63",
      "text": "\u628a\u56fe 15 \u753b\u5728\u7ec3\u4e60\u672c\u4e0a. \u8fc7 $M$ \u548c $P$ \u4e24\u70b9\u5411\u76f4\u7ebf $l$ \u4f5c\u4e24\u6761\u5782\u7ebf.",
      "figure_ids": [
        "fig-15"
      ]
    },
    {
      "number": "64",
      "text": "\u6709\u4e24\u4e2a\u884c\u4eba\u4ece\u4e24\u4e2a\u6751\u5e84\u540c\u65f6\u51fa\u53d1\u76f8\u5411\u800c\u884c\uff0c\u4e8e 4 \u5c0f\u65f6\u540e\u76f8\u9047. \u4e24\u6751\u76f8\u8ddd 36 \u516c\u91cc. \u4e00\u4e2a\u884c\u4eba\u7684\u901f\u5ea6\u4e3a 4 \u516c\u91cc/\u5c0f\u65f6. \u6c42\u53e6\u4e00\u4e2a\u884c\u4eba\u7684\u901f\u5ea6.",
      "figure_ids": []
    },
    {
      "number": "65",
      "text": "\u5728\u4e09\u4e2a\u7bb1\u5b50\u4e2d\u5171\u88c5\u6a31\u6843 76 \u516c\u65a4. \u7b2c\u4e8c\u7bb1\u88c5\u7684\u6a31\u6843\u662f\u7b2c\u4e00\u7bb1\u7684 2 \u500d\uff0c\u7b2c\u4e09\u7bb1\u6bd4\u7b2c\u4e00\u7bb1\u591a 8 \u516c\u65a4. \u6bcf\u7bb1\u5404\u88c5\u6a31\u6843\u591a\u5c11\u516c\u65a4\uff1f",
      "figure_ids": []
    },
    {
      "number": "66",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $13200:x-2180=20$\uff1b\n2) $y:320-31=79$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u56fe 11 \u4e2d\u7684\u76f4\u7ebf $m$ \u4e0e $n$ \u5782\u76f4\u4e8e\u76f4\u7ebf $l$. $m$ \u548c $n$ \u4e24\u6761\u76f4\u7ebf\u4e0d\u76f8\u4ea4\uff0c\u800c\u662f\u4e92\u76f8\u5e73\u884c. \u4e3a\u4e86\u4f5c\u5e73\u884c\u4e8e\u76f4\u7ebf $m$ \u7684\u76f4\u7ebf\uff0c\u5982\u56fe 12\u6240\u793a\uff0c\u5148\u9760\u7d27\u76f4\u7ebf $m$ \u653e\u4e00\u4e09\u89d2\u677f\uff0c\u518d\u9760\u7d27\u4e09\u89d2\u677f\u7684\u53e6\u4e00\u8fb9\u653e\u4e00\u76f4\u5c3a. \u7136\u540e\u6cbf\u76f4\u5c3a\u79fb\u52a8\u4e09\u89d2\u677f\u5e76\u4f5c\u5e73\u884c\u4e8e\u76f4\u7ebf $m$ \u7684\u76f4\u7ebf $n$. \u8fd9\u6837\u5c31\u53ef\u4ee5\u8fc7\u5e73\u9762\u4e0a\u7684\u4efb\u4e00\u70b9\u4f5c\u76f4\u7ebf $m$ \u7684\u5e73\u884c\u7ebf."
    }
  ],
