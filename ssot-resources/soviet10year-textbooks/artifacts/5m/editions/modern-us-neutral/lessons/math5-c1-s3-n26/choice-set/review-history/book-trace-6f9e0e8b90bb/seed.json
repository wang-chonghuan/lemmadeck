  "exercises": [
    {
      "number": "480",
      "text": "\u4f5c\u4e00\u76f4\u7ebf\uff0c\u628a\u5b83\u4f5c\u4e3a\u5bf9\u79f0\u8f74\uff0c\u4f5c\u5173\u4e8e\u8fd9\u4e2a\u8f74\u5bf9\u79f0\u7684\u4e24\u70b9$M$\u548c$H$.\u5728\u5bf9\u79f0\u8f74\u5916\u53d6\u4e00\u70b9$P$.\u6bd4\u8f83\u4ece\u70b9$P$\u5230\u70b9$M$\u548c\u70b9$H$\u7684\u8ddd\u79bb.\u4f5c\u548c$M,H$\u4e24\u70b9\u7b49\u8ddd\u7684\u70b9$O$.\u8bf4\u660e\u70b9$O$\u7684\u4f4d\u7f6e.",
      "figure_ids": []
    },
    {
      "number": "481",
      "text": "\u5728\u56fe105\u4e2d\uff0c\u76f4\u7ebf$l$\u662f$A,B$\u4e24\u70b9\u7684\u5bf9\u79f0\u8f74.\u8bf4\u51fa\u56fe\u4e2d\u6807\u51fa\u7684\u4e0b\u5217\u5404\u70b9\u7684\u96c6\u5408\uff1a\n1) \u548c$A,B$\u4e8c\u70b9\u7b49\u8ddd\u79bb\uff1b\n2) \u4f4d\u4e8e\u5bf9\u79f0\u8f74\u4e0a\uff1b\n3) \u548c$A,B$\u4e8c\u70b9\u7684\u8ddd\u79bb\u4e0d\u7b49\uff1b\n4) \u4e0d\u5728\u5bf9\u79f0\u8f74\u4e0a.",
      "figure_ids": [
        "fig-105"
      ]
    },
    {
      "number": "482",
      "text": "\u53d6\u70b9$P$\u548c\u70b9$N$\uff0c\u7528\u5706\u89c4\u548c\u76f4\u5c3a\u4f5c\u8fd9\u4e24\u4e2a\u70b9\u7684\u5bf9\u79f0\u8f74.",
      "figure_ids": []
    },
    {
      "number": "483",
      "text": "\u4f5c\u4e0b\u5217\u6bcf\u5bf9\u70b9\u7684\u5bf9\u79f0\u8f74\uff1a\n1) $A(1,3)$\u548c$B(-1,-3)$\uff1b\n2) $C(-2,-4)$\u548c$D$ $(-4,-2)$.",
      "figure_ids": []
    },
    {
      "number": "484",
      "text": "\u56fe106\u4e2d\u7ed9\u5b9a\u4e86\u76f4\u7ebf$AB$\u548c$M,N$\u4e24\u70b9.\u628a\u8fd9\u4e2a\u56fe\u753b\u5728\u7ec3\u4e60\u672c\u4e0a\uff0c\u5e76\u5728\u76f4\u7ebf$AB$\u4e0a\u627e\u51fa\u548c$M,N$\u4e24\u70b9\u7b49\u8ddd\u7684\u70b9$K$.",
      "figure_ids": [
        "fig-106"
      ]
    },
    {
      "number": "485",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $-44-(a+8)=-4+11$\uff1b\n2) $65+(-29-x)=1.7-5.2$\uff1b\n3) $30-(-y+4.5)=-1.5-1$\uff1b\n4) $52+(-82+a)=-370+70$.",
      "figure_ids": []
    },
    {
      "number": "486",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e00\u4e2a\u8001\u5976\u5976\u4e70\u4e866\u4e2a\u9762\u5305\u5708\uff0c\u53c8\u4e70\u4e864\u4e2a\u5355\u4ef7\u548c\u9762\u5305\u5708\u4e00\u6837\u7684\u5c0f\u9762\u5305\uff0c\u8fd8\u4e70\u4e86\u4e00\u4e2a13\u7f8e\u5206\u7684\u957f\u9762\u5305.\u5979\u5171\u4ed8\u4e8673\u7f8e\u5206.\u4e00\u4e2a\u9762\u5305\u5708\u6216\u4e00\u4e2a\u5c0f\u9762\u5305\u662f\u591a\u5c11\u94b1\uff1f\n2) \u4e00\u4e2a\u8001\u5927\u7237\u4e70\u4e867\u672c\u65b9\u683c\u672c\uff0c\u53c8\u4e70\u4e866\u672c\u5355\u4ef7\u4e00\u6837\u7684\u6a2a\u683c\u672c\uff0c\u8fd8\u752835\u4e2a\u7f8e\u5206\u4e70\u4e86\u4e00\u652f\u94a2\u7b14.\u4ed6\u4e00\u5171\u4ed8\u4e8661\u7f8e\u5206.\u65b9\u683c\u672c\u6216\u6a2a\u683c\u672c\u6bcf\u672c\u662f\u591a\u5c11\u94b1\uff1f\n3) \u6211\u60f3\u4e00\u4e2a\u6570\uff0c\u52a0\u4e0a5\uff0c\u6240\u5f97\u7684\u548c\u4e58\u4ee59\uff0c\u518d\u52a0\u4e0a\u6211\u60f3\u7684\u6570\uff0c\u51cf\u53bb25\uff0c\u7ed3\u679c\u5f97200\uff0c\u6211\u60f3\u7684\u662f\u4ec0\u4e48\u6570\uff1f\n4) \u6211\u60f3\u4e00\u4e2a\u6570\uff0c\u51cf\u53bb3\uff0c\u6240\u5f97\u7684\u5dee\u4e58\u4ee56\uff0c\u518d\u4ece\u79ef\u4e2d\u51cf\u53bb\u6211\u60f3\u7684\u6570\uff0c\u7136\u540e\u52a048\uff0c\u7ed3\u679c\u5f9790\uff0c\u6211\u60f3\u7684\u662f\u4ec0\u4e48\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "487",
      "text": "\u4ece\u6b63\u65b9\u5f62\u4e0a\u5272\u53bb\u56db\u4e2a\u5408\u540c\u4e09\u89d2\u5f62\uff08\u56fe107\uff09.\u6c42\u8bc1\uff1a\u56db\u8fb9\u5f62$ABCD$\u662f\u6b63\u65b9\u5f62.",
      "figure_ids": [
        "fig-107"
      ]
    },
    {
      "number": "488",
      "text": "\u753b\u7ebf\u6bb5$MK$\uff0c\u4f5c$M,K$\u4e24\u70b9\u7684\u5bf9\u79f0\u8f74.",
      "figure_ids": []
    },
    {
      "number": "489",
      "text": "\u4f5c\u70b9$A(-2,-3)$\u548c\u70b9$B(4,3)$\u7684\u5bf9\u79f0\u8f74.\u6c42\u51fa\u5bf9\u79f0\u8f74\u548c\u5750\u6807\u8f74\u7684\u4ea4\u70b9\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "490",
      "text": "\u572840\u540d\u5b66\u751f\u4e2d\uff0c\u67093\u540d\u56e0\u75c5\u7f3a\u5e2d.\u51fa\u5e2d\u7684\u5b66\u751f\u5360\u5168\u73ed\u5b66\u751f\u7684\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "491",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $12.3-(x+8.7)=6.9$\uff1b\n2) $124.8-(38.6-x)=121.2$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5047\u5b9a\u70b9$A$\u548c\u70b9$B$\u5173\u4e8e\u76f4\u7ebf$l$\u5bf9\u79f0\uff08\u56fe103\uff09.\u5728\u8fd9\u6761\u76f4\u7ebf\u4e0a\u53d6\u4efb\u610f\u70b9$C$.\u7ebf\u6bb5$AC$\u548c$CB$\u76f8\u4e92\u5bf9\u79f0.\u8fd9\u5c31\u662f\u8bf4\uff0c\u8fd9\u4e24\u6761\u7ebf\u6bb5\u5408\u540c\uff0c\u957f\u5ea6\u4e5f\u76f8\u7b49.\u5bf9\u79f0\u8f74\u4e0a\u6bcf\u4e2a\u70b9\u5230\u5173\u4e8e\u8fd9\u4e2a\u8f74\u5bf9\u79f0\u7684\u4e24\u70b9$A$\u4e0e$B$\u7684\u8ddd\u79bb\u76f8\u7b49."
    },
    {
      "block": 3,
      "text": "\u53ea\u6709\u5bf9\u79f0\u8f74\u4e0a\u7684\u70b9\u624d\u5177\u6709\u8fd9\u79cd\u6027\u8d28\uff0c\u8fd9\u5c31\u662f\u548c\u4e24\u70b9$A,B$\u7b49\u8ddd\u79bb\u7684\u6240\u6709\u70b9\u90fd\u5728\u8fd9\u4e24\u70b9\u7684\u5bf9\u79f0\u8f74\u4e0a."
    }
  ],
