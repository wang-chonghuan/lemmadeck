  "exercises": [
    {
      "number": "126",
      "text": "\u70b9 $O$ \u4e3a\u539f\u70b9. \u5199\u51fa\u70b9 $O$\u3001$A$\u3001$B$\u3001$C$\u3001$D$\u3001$P$\u3001$K$\u3001$M$\u3001$E$ \u7b49\u7684\u5750\u6807\uff08\u56fe 36\uff09.",
      "figure_ids": [
        "fig-36"
      ]
    },
    {
      "number": "127",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u4e0b\u5217\u5404\u70b9\uff1a$A(1)$\uff0c$B(8.3)$\uff0c$C(-6)$\uff0c$D(6)$\uff0c$M(-2.4)$\uff0c$K(2.4)$.",
      "figure_ids": []
    },
    {
      "number": "128",
      "text": "\u4e09\u89d2\u5f62\u5c0f\u65d7\u4f4d\u4e8e\u5750\u6807\u4e3a $-2$ \u7684\u70b9\u4e0a\uff0c\u957f\u65b9\u5f62\u7684\u5c0f\u65d7\u5728\u5750\u6807\u4e3a $2$ \u7684\u70b9\u4e0a\uff08\u56fe 37\uff09. \u6807\u51fa\u539f\u70b9\u548c\u5355\u4f4d\u7ebf\u6bb5. \u5199\u51fa\u70b9$B$\u3001$C$\u3001$D$ \u7684\u5750\u6807.",
      "figure_ids": [
        "fig-37"
      ]
    },
    {
      "number": "129",
      "text": "\u8bbe\uff1a$x=-7,3.3,-5.2,-1,2,-1.8,\\frac{5}{3},-\\frac{7}{2}$ \u65f6\uff0c\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u5750\u6807\u4e3a $x$ \u7684\u70b9.",
      "figure_ids": []
    },
    {
      "number": "130",
      "text": "\u8bbe\uff1a\n1) $a=-6,3,-5,-8,10,-11,9,7,-7$\uff1b\n2) $a=2,-1,-3,-5,4,\\frac{7}{8},\\frac{5}{6}$\uff0c\u7528\u6570\u8f74\u4e0a\u7684\u70b9\u8868\u793a\u6570 $a$.",
      "figure_ids": []
    },
    {
      "number": "131",
      "text": "\u6309\u523b\u5ea6\uff08\u89c1\u56fe 38\uff09\u6c42\u51fa\u5c71\u7684\u9ad8\u5ea6\u548c\u6d77\u6d0b\u7684\u6df1\u5ea6.",
      "figure_ids": [
        "fig-38"
      ]
    },
    {
      "number": "132",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u70b9 $A(-2)$ \u548c\u70b9 $B(7)$. \u6c42\u51fa $A$\u3001$B$ \u4e24\u70b9\u95f4\u7684\u8ddd\u79bb\uff08\u4ee5\u5355\u4f4d\u7ebf\u6bb5\u8ba1\uff09.",
      "figure_ids": []
    },
    {
      "number": "133",
      "text": "\u8bf4\u51fa\u6570\u8f74\u4e0a\u5408\u4e8e\u4ee5\u4e0b\u6761\u4ef6\u7684\u4efb\u610f\u4e09\u4e2a\u6570\uff1a\n1) \u5728 11 \u7684\u53f3\u8fb9\uff1b\n2) \u5728 $-8$ \u7684\u5de6\u8fb9\uff1b\n3) \u5728 $-820$ \u7684\u5de6\u8fb9\uff1b\n4) \u5728 $-72$ \u7684\u53f3\u8fb9.",
      "figure_ids": []
    },
    {
      "number": "134",
      "text": "\u8c03\u8282\u6f14\u793a\u6e29\u5ea6\u8ba1\u7684\u6c34\u94f6\u67f1\uff0c\u4f7f\u5b83\u8868\u793a\u51fa\u4e0b\u5217\u6e29\u5ea6\uff1a\n1) $-12^\\circ\\mathrm{C}$\uff1b\n2) $-11^\\circ\\mathrm{C}$\uff1b\n3) $-7^\\circ\\mathrm{C}$\uff1b\n4) $3^\\circ\\mathrm{C}$\uff1b\n5) $-8.5^\\circ\\mathrm{C}$\uff1b\n6) $7.3^\\circ\\mathrm{C}$.",
      "figure_ids": []
    },
    {
      "number": "135",
      "text": "\u5728\u793e\u533a\u79d1\u5b66\u4e2d\u5fc3\u7684\u5efa\u7b51\u7269\u4e0a\u5b89\u88c5\u6709\u4e00\u4e2a\u5e26\u6307\u9488\u7684\u6e29\u5ea6\u8ba1. \u8fd9\u4e2a\u6e29\u5ea6\u8ba1\u6307\u793a\u7684\u6e29\u5ea6\u662f\u591a\u5c11\u5ea6\uff08\u56fe39\uff09\uff1f",
      "figure_ids": [
        "fig-39"
      ]
    },
    {
      "number": "136",
      "text": "\u4ece\u96c6\u5408 $\\{-1.2,\\frac{3}{5},-\\frac{12}{4},0,6,-3\\frac{7}{8},7.2,-10,8\\}$ \u4e2d\u9009\u51fa\u4ee5\u4e0b\u5b50\u96c6\uff1a\n1) \u8d1f\u6570\uff1b\n2) \u6b63\u6570\uff1b\n3) \u81ea\u7136\u6570.",
      "figure_ids": []
    },
    {
      "number": "137",
      "text": "\u8bf4\u51fa\u7b49\u8fb9\u4e09\u89d2\u5f62\u96c6\u5408\u548c\u7b49\u8170\u4e09\u89d2\u5f62\u96c6\u5408\u7684\u5e76\u96c6.",
      "figure_ids": []
    },
    {
      "number": "138",
      "text": "\u4f5c\u7528\u5728\u6bcf\u5e73\u65b9\u5398\u7c73\u5730\u7403\u8868\u9762\u7684\u7a7a\u6c14\u67f1\u7684\u8d28\u91cf\u4e3a 1.033 \u516c\u65a4. \u4f5c\u7528\u4e8e\u6bcf\u5e73\u65b9\u516c\u91cc\u4e0a\u7684\u7a7a\u6c14\u67f1\u7684\u8d28\u91cf\u662f\u591a\u5c11\uff1f\u8ba1\u7b97\u4e00\u7247\u6d77\u57df\u4e0a\u7684\u7a7a\u6c14\u67f1\u7684\u8d28\u91cf\uff0c\u8be5\u6d77\u7684\u9762\u79ef\u4e3a 38 000 \u5e73\u65b9\u516c\u91cc.",
      "figure_ids": []
    },
    {
      "number": "139",
      "text": "\u5728 $37*5$ \u7684\u5199\u6cd5\u4e2d\uff0c\u7528\u4ec0\u4e48\u6570\u5b57\u4ee3\u66ff $*$ \u53f7\u624d\u80fd\u4f7f\u6240\u5f97\u7684\u6570\n1) \u88ab 3 \u6574\u9664\uff1f\u548c\n2) \u88ab 5 \u6574\u9664\uff1f",
      "figure_ids": []
    },
    {
      "number": "140",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e92\u76f8\u7ade\u8d5b\u7684\u4e24\u4e2a\u690d\u68c9\u7a81\u51fb\u961f\u4e00\u5929\u5171\u6536\u83b7\u68c9\u82b1 10.2 \u516c\u62c5. \u7b2c\u4e00\u961f\u6bd4\u7b2c\u4e8c\u961f\u591a\u6536\u83b7 0.76 \u516c\u62c5. \u6bcf\u961f\u5404\u6536\u83b7\u591a\u5c11\u516c\u62c5\uff1f\n2) \u4e92\u76f8\u7ade\u8d5b\u7684\u4e24\u4e2a\u8054\u5408\u6536\u5272\u673a\u624b\u4e00\u5929\u5171\u6536\u5272\u4e86 64.2 \u516c\u9877. \u5982\u679c\u4e00\u4e2a\u6536\u5272\u673a\u624b\u6bd4\u53e6\u4e00\u4e2a\u5c11\u6536\u5272 2.8 \u516c\u9877\uff0c\u90a3\u4e48\u8fd9\u4e24\u4e2a\u6536\u5272\u673a\u624b\u5404\u6536\u5272\u591a\u5c11\u516c\u9877\uff1f",
      "figure_ids": []
    },
    {
      "number": "141",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a1) \u4e24\u4e2a\u90bb\u8865\u89d2\u4e2d\uff0c\u4e00\u89d2\u662f\u53e6\u4e00\u89d2\u7684\u4e09\u500d\uff0c\u4e24\u4e2a\u89d2\u5404\u591a\u5c11\u5ea6\uff1f\u4f5c\u51fa\u8fd9\u4e24\u4e2a\u90bb\u8865\u89d2.2) \u4e8c\u90bb\u8865\u89d2\u4e2d\uff0c\u4e00\u89d2\u662f\u53e6\u4e00\u89d2\u7684\u56db\u500d\uff0c\u6c42\u51fa\u6bcf\u4e2a\u89d2\u7684\u5927\u5c0f. \u4f5c\u51fa\u8fd9\u4e24\u4e2a\u90bb\u8865\u89d2.",
      "figure_ids": []
    },
    {
      "number": "142",
      "text": "\u8ba1\u7b97\uff1a\n1) $0.5632:5.12+42.56:3.8-(11-3.9:1.5)$\uff1b\n2) $(5.98+5.36):2.8:(5\\cdot0.003+15\\cdot0.029)$.",
      "figure_ids": []
    },
    {
      "number": "143",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u4ee5\u4e0b\u5404\u70b9\uff1a$M(-3)$\uff0c$N(4)$\uff0c$P(-8.1)$\uff0c$K(3.3)$\uff0c$T(-7)$\uff0c$C(7)$.",
      "figure_ids": []
    },
    {
      "number": "144",
      "text": "\u5212\u51fa\u4ece $-60^\\circ\\mathrm{C}$ \u5230 $60^\\circ\\mathrm{C}$ \u7684\u6e29\u5ea6\u523b\u5ea6\uff0c\u53d6\u6bcf\u4e2a\u523b\u5ea6\u4e3a $5^\\circ\\mathrm{C}$\uff0c\u5728\u523b\u5ea6\u4e0a\u6807\u51fa\u6c34\u94f6\u7684\u51b0\u70b9\uff08$-39^\\circ\\mathrm{C}$\uff09\uff0c\u4eba\u4f53\u7684\u6b63\u5e38\u6e29\u5ea6\uff08$36.6^\\circ\\mathrm{C}$\uff09\uff0c\u6c7d\u6cb9\u7684\u51b0\u70b9\uff08$-60^\\circ\\mathrm{C}$\uff09.",
      "figure_ids": []
    },
    {
      "number": "145",
      "text": "\u4e92\u76f8\u7ade\u8d5b\u7684\u4e24\u4e2a\u62d6\u62c9\u673a\u624b\u5171\u7ffb\u8015\u4e86 12.32 \u516c\u9877\u571f\u5730\uff0c\u5176\u4e2d\u4e00\u4e2a\u62d6\u62c9\u673a\u624b\u7ffb\u8015\u7684\u571f\u5730\u662f\u53e6\u4e00\u4e2a\u7ffb\u8015\u7684 1.2 \u500d. \u6bcf\u4e2a\u62d6\u62c9\u673a\u624b\u7ffb\u8015\u4e86\u591a\u5c11\u516c\u9877\u571f\u5730\uff1f",
      "figure_ids": []
    },
    {
      "number": "146",
      "text": "\u67d0\u5148\u8fdb\u6324\u5976\u5458\u4e00\u5e74\u4ece\u4e00\u5934\u5976\u725b\u6324\u5976 6500 \u516c\u65a4. \u5982\u679c\u725b\u5976\u7684\u542b\u8102\u91cf\u4e3a $3.9\\%$\uff0c\u4ece\u8fd9\u4e9b\u725b\u5976\u4e2d\u80fd\u5236\u53d6\u591a\u5c11\u5976\u6cb9\uff1f",
      "figure_ids": []
    },
    {
      "number": "147",
      "text": "\u5f53 $k=3.06,30.6$ \u65f6\uff0c\u8ba1\u7b97 $4.7k+3.6k-0.83$ \u7684\u503c.",
      "figure_ids": []
    },
    {
      "number": "148",
      "text": "\u8ba1\u7b97\uff1a\n1) $907+613\\cdot(80\\cdot11-42\\,558:519)$\uff1b\n2) $120\\,000-119\\,340:(684\\cdot245-675\\cdot246)$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u8981\u786e\u5b9a\u4e00\u70b9\u5728\u76f4\u7ebf\u4e0a\u5173\u4e8e $O$ \u70b9\u7684\u4f4d\u7f6e\uff0c\u5355\u662f\u6307\u51fa\u5b83\u4e0e $O$\u70b9\u7684\u8ddd\u79bb\u662f\u4e0d\u591f\u7684\uff0c\u8fd8\u5fc5\u987b\u8bf4\u660e\u5b83\u5728 $O$ \u70b9\u7684\u54ea\u4e00\u8fb9. \u901a\u5e38\u628a\u8fd9\u6761\u76f4\u7ebf\u753b\u6210\u6c34\u5e73\u7ebf. \u5982\u56fe 34.1 \u6807\u6709\u523b\u5ea6. \u4e00\u822c\u4e0d\u7528\u201c\u5de6\u201d\u3001\u201c\u53f3\u201d\uff0c\u800c\u662f\u5728\u70b9 $O$ \u7684\u4e00\u8fb9\u5199 $1,2,3\\cdots\\cdots$\uff0c\u800c\u5728\u53e6\u4e00\u8fb9\u5199\u5e26\u8d1f\u53f7\u7684\u6570\uff1a\n$-1,-2,-3\\cdots\\cdots$\uff08\u56fe 34.2\uff09\uff0c\u8bfb\u4f5c\u201c\u8d1f 1\u201d\u3001\u201c\u8d1f 2\u201d\u3001\u201c\u8d1f 3\u201d\u7b49\u7b49. \u7531\u70b9 $O$ \u5411\u53f3\u7684\u65b9\u5411\u4e3a\u6b63\uff0c\u800c\u5411\u5de6\u5219\u4e3a\u8d1f. \u7528\u7bad\u5934\u6307\u51fa\u76f4\u7ebf\u4e0a\u7684\u6b63\u65b9\u5411. $1$\u3001$\\frac{2}{3}$\u3001$2.6$ \u4e00\u7c7b\u7684\u6570\u53eb\u505a\u6b63\u6570\uff0c\u800c $-1$\u3001$-\\frac{2}{3}$\u3001$-2.6$ \u5219\u53eb\u505a\u8d1f\u6570. \u5728\u76f4\u7ebf\u4e0a\uff0c$O$ \u628a\u6b63\u6570\u548c\u8d1f\u6570\u5206\u5f00. \u539f\u70b9 $O$ \u8868\u793a\u7684\u96f6\u65e2\u4e0d\u662f\u6b63\u6570\uff0c\u4e5f\u4e0d\u662f\u8d1f\u6570."
    },
    {
      "block": 6,
      "text": "\u89c4\u5b9a\u6709\u539f\u70b9\u3001\u5355\u4f4d\u7ebf\u6bb5\u548c\u65b9\u5411\u7684\u76f4\u7ebf\u53eb\u505a\u6570\u8f74. \u5728\u5386\u53f2\u8bfe\u4e2d\u6211\u4eec\u9047\u5230\u8fc7\u6570\u8f74. \u4e0d\u8fc7\u5728\u90a3\u91cc\u53eb\u505a\u201c\u5e74\u4ee3\u8868\u201d."
    }
  ],
