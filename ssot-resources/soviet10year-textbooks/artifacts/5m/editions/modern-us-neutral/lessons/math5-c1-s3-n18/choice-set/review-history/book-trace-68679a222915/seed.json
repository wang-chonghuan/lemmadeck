  "exercises": [
    {
      "number": "299",
      "text": "\u7528\u6570\u8f74\u6c42\u4e0b\u5217\u6bcf\u4e24\u4e2a\u6570\u7684\u548c\uff1a\n1) $-1$ \u4e0e 2\uff1b\n2) 3 \u4e0e 4\uff1b\n3) $-3$ \u4e0e 6\uff1b\n4) 1 \u4e0e $-5$\uff1b\n5) $-5$ \u4e0e 6\uff1b\n6) $-3$ \u4e0e $-2$.",
      "figure_ids": []
    },
    {
      "number": "300",
      "text": "\u5728\u6570\u8f74\u4e0a\u8fdb\u884c\u4e0b\u5217\u5404\u6570\u7684\u52a0\u6cd5\u8ba1\u7b97\uff1a4 \u4e0e 0\uff0c0 \u4e0e $-3$\uff0c$-5$ \u4e0e 0. \u4f5c\u51fa\u7ed3\u8bba\uff0c\u628a\u7ed3\u8bba\u5199\u6210\u542b\u6709\u53d8\u91cf\u7684\u7b49\u5f0f\u5f62\u5f0f.",
      "figure_ids": []
    },
    {
      "number": "301",
      "text": "\u60f3\u4e24\u4e2a\u76f8\u53cd\u6570\uff0c\u628a\u4e24\u6570\u76f8\u52a0. \u518d\u7528\u4e24\u5bf9\u76f8\u53cd\u6570\u68c0\u9a8c\u6240\u5f97\u7ed3\u679c. \u4f5c\u51fa\u7ed3\u8bba\uff0c\u628a\u5b83\u5199\u6210\u542b\u6709\u53d8\u91cf\u7684\u7b49\u5f0f\u5f62\u5f0f.",
      "figure_ids": []
    },
    {
      "number": "302",
      "text": "\u6c42\u4e0b\u5f0f\u7684\u503c\uff1a\n1) $[(-3.9)+3.9]+(-9.1)$\uff1b\n2) $(0-4.8)+(-4.8)$.",
      "figure_ids": []
    },
    {
      "number": "303",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u6570 $a$\uff08\u56fe 79\uff09. \u5982\u4f55\u5728\u8fd9\u4e2a\u6570\u8f74\u4e0a\u627e\u51fa$a+2$\uff0c$a+(-3)$\uff0c$a+(-4.5)$ \u5404\u6570\uff1f",
      "figure_ids": [
        "fig-79"
      ]
    },
    {
      "number": "304",
      "text": "\u5728\u6570\u8f74\u4e0a\uff0c\u6570 $a+4$ \u5bf9\u5e94\u4e8e\u70b9 $A$\uff0c$a+(-4)$ \u5bf9\u5e94\u4e8e\u70b9 $B$\uff0c\u4ec0\u4e48\u6570\u5bf9\u5e94\u4e8e $AB$ \u7ebf\u6bb5\u7684\u4e2d\u70b9\uff1f",
      "figure_ids": []
    },
    {
      "number": "305",
      "text": "\u6c14\u6e29\u4e3a $-2^\\circ\\mathrm{C}$. \u5f53\u6c14\u6e29\u53d8\u5316 $3^\\circ\\mathrm{C}$\uff0c$1^\\circ\\mathrm{C}$\uff0c$2^\\circ\\mathrm{C}$\uff0c$-3^\\circ\\mathrm{C}$\uff0c$5^\\circ\\mathrm{C}$\uff0c$-4^\\circ\\mathrm{C}$ \u540e\uff0c\u5206\u522b\u5e94\u4e3a\u591a\u5c11\u5ea6\uff1f\u7528\u6570\u8f74\u505a\u5404\u6570\u7684\u52a0\u6cd5.",
      "figure_ids": []
    },
    {
      "number": "306",
      "text": "\u4e0b\u8868\u5217\u6709\u4e0a\u5348\u548c\u4e0b\u5348\u6c14\u6e29\u7684\u53d8\u5316\u91cf. \u7528\u6570\u8f74\u7b97\u51fa\u5168\u5929\u6e29\u5ea6\u7684\u53d8\u5316\u91cf.",
      "figure_ids": [
        "tbl-p0075-02"
      ]
    },
    {
      "number": "307",
      "text": "\u5728\u6625\u6c5b\u65f6\uff0c\u67d0\u57ce\u5e02\u6709\u6df9\u6ca1\u7684\u5371\u9669. \u6551\u63f4\u961f\u8d76\u6765\u62a2\u9669\uff0c\u4ed6\u4eec\u758f\u901a\u4e86\u58c5\u585e\u7684\u6d41\u6c34. \u6b64\u540e\u7b2c\u4e00\u5929\uff0c\u6c34\u4f4d\u53d8\u5316\u4e86 $-1.2$ \u7c73\uff0c\u7b2c\u4e8c\u5929\u53d8\u5316\u4e86 $-0.7$ \u7c73. \u6cb3\u6d41\u6c34\u4f4d\u5728\u8fd9\u4e24\u5929\u5185\u662f\u600e\u6837\u53d8\u5316\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "308",
      "text": "\u4f5c\u4ee5\u70b9 $M(-3,-3)$ \u4e3a\u5706\u5fc3\u3001\u4ee5 4 \u4e2a\u5355\u4f4d\u4e3a\u534a\u5f84\u7684\u5706\u5468. \u628a\u8fd9\u4e2a\u5706\u5468\u5148\u5411\u4e0a\u5e73\u79fb 5 \u4e2a\u5355\u4f4d\uff0c\u4ee5\u540e\u518d\u5411\u53f3\u5e73\u79fb3 \u4e2a\u5355\u4f4d.",
      "figure_ids": []
    },
    {
      "number": "309",
      "text": "\u6309\u9012\u589e\u987a\u5e8f\u6392\u5217\u4e0b\u5217\u5404\u6570\uff1a9\uff0c$-40$\uff0c$-15$\uff0c0\uff0c1\uff0c$-7$\uff0c7\uff0c$-9$.",
      "figure_ids": []
    },
    {
      "number": "310",
      "text": "\u6309\u9012\u51cf\u987a\u5e8f\u6392\u5217\u4ee5\u4e0b\u5404\u6570\uff1a$-25$\uff0c$-30$\uff0c29\uff0c$-5$\uff0c4\uff0c$-2$\uff0c1\uff0c0.",
      "figure_ids": []
    },
    {
      "number": "311",
      "text": "\u5df2\u77e5 $x$ \u4e0e $y$ \u4e3a\u6b63\u6570\uff0c\u800c\u4e14 $x\\ne y$. \u7528 $<$\uff0c$>$ \u6216 $=$ \u53f7\u4ee3\u66ff\u661f\u53f7\uff0c\u4f7f\u6210\u4e3a\u771f\u7b49\u5f0f\u6216\u771f\u4e0d\u7b49\u5f0f\uff1a\n1) $0*x$\uff1b\n2) $-y*0$\uff1b\n3) $-x*y$\uff1b\n4) $y*-x$\uff1b\n5) $|x|*-x$\uff1b\n6) $|y|*y$\uff1b\n7) $-x*|y|$\uff1b\n8) $|-x|*|-y|$.",
      "figure_ids": []
    },
    {
      "number": "312",
      "text": "\u67d0\u9879\u865a\u6784\u7edf\u8ba1\u4e2d\uff0c1950 \u5e74\u7532\u5730\u533a\u6709\u5de5\u7a0b\u5e08 40 \u4e07\u4eba\uff0c\u4e59\u5730\u533a\u6709\u5de5\u7a0b\u5e08 31 \u4e07\u4eba. \u5230 1973 \u5e74\uff0c\u7532\u5730\u533a\u7684\u5de5\u7a0b\u5e08\u4eba\u6570\u589e\u52a0\u5230 $690\\%$\uff0c\u800c\u4e59\u5730\u533a\u589e\u52a0\u5230 $225\\%$. 1973 \u5e74\u7532\u5730\u533a\u7684\u5de5\u7a0b\u5e08\u4eba\u6570\u6bd4\u4e59\u5730\u533a\u591a\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "313",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $235.46-(2.3a+1.2a)=227.06$\uff1b\n2) $171.84-(3.8x-1.3x)=167.34$.",
      "figure_ids": []
    },
    {
      "number": "314",
      "text": "\u7528\u6570\u8f74\u6c42\u4e0b\u5217\u5404\u5bf9\u6570\u7684\u548c\uff1a\n1) $-4$ \u4e0e 5\uff1b\n2) 3 \u4e0e $-2$\uff1b\n3) $-6$ \u4e0e 8\uff1b\n4) $-7$ \u4e0e 0\uff1b\n5) 8 \u4e0e $-8$\uff1b\n6) $-6$ \u4e0e $-5$.",
      "figure_ids": []
    },
    {
      "number": "315",
      "text": "Alex \u4ee5 $3.4$ \u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u6b65\u884c 2 \u5c0f\u65f6\uff0c\u53c8\u4ee5 $9.1$ \u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u9a91\u81ea\u884c\u8f66 1 \u5c0f\u65f6. Alex \u5168\u7a0b\u7684\u5e73\u5747\u901f\u5ea6\u662f\u591a\u5c11\uff1f",
      "figure_ids": []
    },
    {
      "number": "316",
      "text": "\u4e00\u5757\u94dc\u950c\u5408\u91d1\u542b\u94dc $16.4$ \u516c\u65a4\uff0c\u950c $3.6$ \u516c\u65a4. \u8fd9\u79cd\u5408\u91d1\u4e2d\u542b\u6709\u767e\u5206\u4e4b\u51e0\u7684\u94dc\uff1f",
      "figure_ids": []
    },
    {
      "number": "317",
      "text": "\u8bbe\u70b9 $A$ \u5750\u6807\u662f $2,3$\uff0c\u70b9 $B$ \u5750\u6807\u4e3a $-1,-6$\uff0c\u4f5c $AB$ \u7ebf\u6bb5. \u6c42\u7ebf\u6bb5 $AB$ \u548c\u4e24\u8f74 $Ox$ \u548c $Oy$ \u7684\u4ea4\u70b9\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "318",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $(x-4.7)\\cdot7.3=38.69$\uff1b\n2) $(3.6-a)\\cdot5.8=14.5$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "**\u4e00\u822c\u5730\u8bf4\uff0c\u6570 $a$ \u52a0\u4e0a\u6570 $b$\uff0c\u5c31\u662f\u628a\u6570****$a$ \u53d8\u5316 $b$ \u4e2a\u5355\u4f4d.**"
    },
    {
      "block": 4,
      "text": "\u4efb\u4f55\u4e00\u4e2a\u6570\u52a0\u6b63\u6570\u5c31\u589e\u5927\uff0c\u800c\u52a0\u8d1f\u6570\u5219\u51cf\u5c0f."
    },
    {
      "block": 16,
      "text": "**\u4e00\u822c\u5730\u8bf4\uff0c\u6c42\u8fde\u7eed\u4e24\u6b21\u53d8\u5316\u7684\u7ed3\u679c\u7528\u52a0\u6cd5.**"
    }
