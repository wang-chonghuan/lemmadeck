  "exercises": [
    {
      "number": "76",
      "text": "\u56fe 23 \u4e2d\u753b\u6709\u82e5\u5e72\u4e2a\u4e09\u89d2\u5f62. \u6309\u7167\u8fd9\u4e2a\u56fe\u586b\u5199\u4e0b\u8868\uff1a",
      "figure_ids": [
        "fig-23"
      ]
    },
    {
      "number": "77",
      "text": "\u4f5c\u957f\u65b9\u5f62 $ABCD$\uff0c\u5b83\u7684\u957f\u3001\u5bbd\u5206\u522b\u4e3a 5 \u5398\u7c73\u548c 3 \u5398\u7c73. \u5f15\u7ebf\u6bb5 $AC$ \u4e0e $BD$\uff08\u957f\u65b9\u5f62\u7684\u5bf9\u89d2\u7ebf\uff09. \u8fd9\u4e2a\u957f\u65b9\u5f62\u88ab\u5206\u6210\u51e0\u4e2a\u4e09\u89d2\u5f62\uff1f\u5176\u4e2d\u54ea\u4e9b\u662f\u9510\u89d2\u4e09\u89d2\u5f62\uff0c\u54ea\u4e9b\u662f\u949d\u89d2\u4e09\u89d2\u5f62\uff1f\u518d\u628a\u6240\u5f97\u7684\u6bcf\u4e2a\u4e09\u89d2\u5f62\u5206\u6210\u4e8c\u4e2a\u76f4\u89d2\u4e09\u89d2\u5f62.",
      "figure_ids": []
    },
    {
      "number": "78",
      "text": "\u4f5c\u6b63\u65b9\u5f62\u5e76\u628a\u5b83\u5206\u6210\u4e24\u4e2a\u76f4\u89d2\u4e09\u89d2\u5f62.",
      "figure_ids": []
    },
    {
      "number": "79",
      "text": "\u5728\u5706\u5fc3\u4e3a $O$ \u7684\u5706\u4e2d\uff0c\u5f15\u534a\u5f84 $OA$ \u548c $OB$\uff0c\u4f7f\u5b83\u4eec\u7684\u5939\u89d2\u7b49\u4e8e $140^\\circ$. \u5224\u5b9a\u4e09\u89d2\u5f62 $AOB$ \u7684\u7c7b\u578b.",
      "figure_ids": []
    },
    {
      "number": "80",
      "text": "\u4ee5 $K$ \u70b9\u4e3a\u5706\u5fc3\uff0c\u4f5c\u534a\u5f84\u957f 3 \u5398\u7c73\u7684\u5706. \u5728\u5706\u5468\u4e0a\u53d6\u70b9 $M$\u548c $T$\uff0c\u4f7f\u5b83\u4eec\u4e4b\u95f4\u7684\u8ddd\u79bb\u4e3a 3 \u5398\u7c73. \u7528\u7ebf\u6bb5\u8054\u7ed3\u70b9 $K$\u3001$M$\u548c $T$. \u8bc1\u660e\uff0c\u4e09\u89d2\u5f62 $MKT$ \u4e3a\u7b49\u8fb9\u4e09\u89d2\u5f62.",
      "figure_ids": []
    },
    {
      "number": "81",
      "text": "\u628a 13 \u548c 23 \u4e4b\u95f4\u7684\u81ea\u7136\u6570\u7684\u96c6\u5408\u5206\u4e3a\u4e24\u4e2a\u4e0d\u76f8\u4ea4\u7684\u5b50\u96c6\uff0c\u5176\u4e2d\u4e00\u4e2a\u5b50\u96c6\u5305\u62ec 7 \u7684\u500d\u6570\uff0c\u53e6\u4e00\u4e2a\u5b50\u96c6\u5305\u62ec 7 \u7684\u500d\u6570\u4ee5\u5916\u7684\u5404\u6570.",
      "figure_ids": []
    },
    {
      "number": "82",
      "text": "\u4e0b\u5217\u5206\u7c7b\u662f\u4e0d\u662f\u6b63\u786e\uff1f\n1) \u628a\u5168\u90e8\u89d2\u7684\u96c6\u5408\u5206\u6210\u4e09\u4e2a\u5b50\u96c6\uff1a\u76f4\u89d2\u7684\u96c6\u5408\uff0c\u9510\u89d2\u7684\u96c6\u5408\u548c\u949d\u89d2\u7684\u96c6\u5408\uff1b\n2) \u628a\u4e09\u89d2\u5f62\u7684\u96c6\u5408\u5206\u4e3a\u4e09\u4e2a\u5b50\u96c6\uff1a\u4e0d\u7b49\u8fb9\u4e09\u89d2\u5f62\u7684\u96c6\u5408\uff0c\u7b49\u8170\u4e09\u89d2\u5f62\u7684\u96c6\u5408\u4ee5\u53ca\u7b49\u8fb9\u4e09\u89d2\u5f62\u7684\u96c6\u5408\uff1b\n3) \u628a\u9a6c\u817f\u7684\u96c6\u5408\u5206\u6210\u56db\u7c7b\uff1a\u4e24\u6761\u524d\u817f\uff0c\u4e24\u6761\u540e\u817f\uff0c\u4e24\u6761\u5de6\u817f\uff0c\u4e24\u6761\u53f3\u817f.",
      "figure_ids": []
    },
    {
      "number": "83",
      "text": "$M$ \u4e3a\u4e0d\u7b49\u5f0f $124\\leqslant x<130$ \u7684\u81ea\u7136\u6570\u89e3\u7684\u96c6\u5408. $K$ \u4e3a\u4e0d\u7b49\u5f0f $126<x\\leqslant133$ \u7684\u81ea\u7136\u6570\u89e3\u7684\u96c6\u5408. \u6c42 $K$ \u548c $M$ \u7684\u4ea4\u96c6\u548c\u5e76\u96c6.",
      "figure_ids": []
    },
    {
      "number": "84",
      "text": "\u4f5c $\\triangle ABC$\uff0c\u4f7f\uff1a\n1) $|AB|=3.5$ \u5398\u7c73\uff0c $|AC|=5$ \u5398\u7c73\uff0c $\\widehat{BAC}=135^\\circ$\uff1b\n2) $|AB|=4$ \u5398\u7c73\uff0c $\\widehat{CAB}=72^\\circ$\uff0c $\\widehat{CBA}=72^\\circ$.",
      "figure_ids": []
    },
    {
      "number": "85",
      "text": "\u6839\u636e\u4e0b\u5217\u5df2\u77e5\u6761\u4ef6\uff0c\u4f5c $\\angle B$ \u4e3a\u76f4\u89d2\u7684\u76f4\u89d2\u4e09\u89d2\u5f62 $ABC$\uff1a\n1) $|AB|=3$ \u5398\u7c73\uff0c $|CB|=5$ \u5398\u7c73\uff1b\n2) $|AB|=4.5$ \u5398\u7c73\uff0c $\\widehat{BAC}=40^\\circ$.",
      "figure_ids": []
    },
    {
      "number": "86",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e00\u4e2a\u590f\u4ee4\u8425\u5c0f\u7ec4\u8fdb\u884c\u4e86\u4e00\u6b21\u81ea\u884c\u8f66\u8fdc\u8db3. \u5168\u7a0b 140.4 \u516c\u91cc. \u5728\u524d 48.6 \u516c\u91cc\uff0c\u961f\u5458\u9a91\u8f66\u901f\u5ea6\u4e3a 12.15 \u516c\u91cc/\u5c0f\u65f6\uff0c\u4ee5\u540e\u7684\u901f\u5ea6\u4e3a 15.3 \u516c\u91cc/\u5c0f\u65f6. \u5c0f\u7ec4\u5728\u8def\u4e0a\u5171\u7528\u4e86\u591a\u5c11\u65f6\u95f4\uff1f\n2) \u4e00\u4e2a\u5f92\u6b65\u5c0f\u7ec4\u5b8c\u6210\u4e86 32.4 \u516c\u91cc\u7684\u8def\u7ebf. \u524d4.5 \u5c0f\u65f6\u4ed6\u4eec\u5728\u5927\u8def\u4e0a\u884c\u8d70\uff0c\u901f\u5ea6\u4e3a 5.2 \u516c\u91cc/\u5c0f\u65f6\uff0c\u5176\u4f59\u65f6\u95f4\u6cbf\u6e7f\u5730\u6b65\u9053\u524d\u8fdb\uff0c\u901f\u5ea6\u4e3a 2.5 \u516c\u91cc/\u5c0f\u65f6. \u8fd9\u6b21\u5f92\u6b65\u5171\u7528\u4e86\u591a\u5c11\u65f6\u95f4\uff1f",
      "figure_ids": []
    },
    {
      "number": "87",
      "text": "\u628a\u4e0b\u5217\u5404\u6570\u5316\u6210\u5c0f\u6570\u5e76\u8ba1\u7b97\uff1a\n1) $\\frac{1}{4}+\\frac{1}{10}$\uff1b\n2) $\\frac{1}{4}+\\frac{4}{5}$\uff1b\n3) $\\frac{3}{4}-\\frac{3}{8}$\uff1b\n4) $\\frac{3}{20}:\\frac{3}{50}$.",
      "figure_ids": []
    },
    {
      "number": "88",
      "text": "\u4f5c\u4e00\u5706. \u5f15\u76f4\u5f84 $MP$\uff0c\u5728\u5706\u5468\u4e0a\u53d6\u4e00\u70b9 $H$\uff0c\u628a\u70b9 $H$ \u4e0e\u70b9 $M$\u548c $P$ \u8054\u7ed3\u8d77\u6765. \u627e\u51fa\u6240\u5f97\u4e09\u89d2\u5f62\u4e2d\u7684\u76f4\u89d2\uff0c\u91cf\u51fa\u8fd9\u4e2a\u4e09\u89d2\u5f62\u7684\u4e24\u4e2a\u9510\u89d2.",
      "figure_ids": []
    },
    {
      "number": "89",
      "text": "\u4f5c\u4e00\u76f4\u89d2\u8fb9\u957f\u4e3a 2.8 \u5398\u7c73\u7684\u7b49\u8170\u76f4\u89d2\u4e09\u89d2\u5f62\uff0c\u6bd4\u8f83\u8fd9\u4e2a\u4e09\u89d2\u5f62\u7684\u4e24\u4e2a\u9510\u89d2\u7684\u5927\u5c0f.",
      "figure_ids": []
    },
    {
      "number": "90",
      "text": "\u5728\u5706 $O$ \u4e2d\uff0c\u5f15\u76f4\u5f84 $AB$ \u548c\u534a\u5f84 $OD$\uff0c\u4f7f $\\widehat{AOD}=50^\\circ$. \u8054\u7ed3\u70b9$D$ \u548c\u70b9 $A$ \u4e0e $B$. \u5224\u5b9a\u6240\u5f97\u7684\u6bcf\u4e2a\u4e09\u89d2\u5f62\u7684\u7c7b\u578b.",
      "figure_ids": []
    },
    {
      "number": "91",
      "text": "\u4ece\u4e00\u6751\u5e84\u5230\u67d0\u5e02\u7684\u516c\u8def\u7a7f\u8fc7\u4e00\u4e2a\u5de5\u4eba\u6751. \u4e00\u8f86\u5c0f\u6c7d\u8f66\u4ece\u6751\u5e84\u51fa\u53d1\u8fdb\u57ce\uff0c\u884c\u901f\u4e3a\u6bcf\u5206\u949f 1 \u516c\u91cc 500 \u7c73. \u4e0e\u6b64\u540c\u65f6\uff0c\u4e00\u8f86\u8f7d\u91cd\u6c7d\u8f66\u4ece\u5de5\u4eba\u6751\u51fa\u53d1\u8fdb\u57ce\uff0c\u884c\u901f\u4e3a 1 \u516c\u91cc/\u5206. 20\u5206\u949f\u540e\u5c0f\u6c7d\u8f66\u8d76\u4e0a\u4e86\u8f7d\u91cd\u6c7d\u8f66. \u6c42\u6751\u5e84\u4e0e\u5de5\u4eba\u6751\u4e4b\u95f4\u7684\u8ddd\u79bb.",
      "figure_ids": []
    },
    {
      "number": "92",
      "text": "\u54e5\u54e5\u7684\u5e74\u9f84\u662f\u59b9\u59b9\u5e74\u9f84\u7684 4 \u500d\uff0c\u59b9\u59b9\u6bd4\u54e5\u54e5\u5c0f 9 \u5c81. \u59b9\u59b9\u548c\u54e5\u54e5\u5404\u51e0\u5c81\uff1f",
      "figure_ids": []
    },
    {
      "number": "93",
      "text": "\u8ba1\u7b97\uff1a\n1) $2\\frac{1}{7}-(3\\frac{5}{7}-2\\frac{4}{7})$\uff1b\n2) $6\\frac{2}{5}+(4\\frac{4}{5}-\\frac{4}{5})$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u4e09\u89d2\u5f62\u53ef\u6309\u5b83\u7684\u89d2\u7684\u5927\u5c0f\u8fdb\u884c\u5206\u7c7b. \u4e09\u89d2\u5f62\u4e2d\u81f3\u591a\u6709\u4e00\u4e2a\u76f4\u89d2\u6216\u4e00\u4e2a\u949d\u89d2\uff0c\u5426\u5219\uff0c\u4ec5\u8fd9\u4e24\u4e2a\u89d2\u7684\u548c\u5c31\u4e0d\u5c0f\u4e8e $180^\\circ$. \u6240\u4ee5\u5404\u79cd\u4e09\u89d2\u5f62\u7684\u96c6\u5408\u53ef\u4ee5\u6309\u89d2\u7684\u5927\u5c0f\u5206\u6210\u4e09\u7c7b\uff1a1) \u9510\u89d2\u4e09\u89d2\u5f62\uff0c\u4e09\u4e2a\u89d2\u90fd\u662f\u9510\u89d2\uff08\u56fe 19\uff09\uff1b\n2) \u76f4\u89d2\u4e09\u89d2\u5f62\uff0c\u6709\u4e00\u4e2a\u76f4\u89d2\uff08\u56fe 20\uff09\uff1b\n3) \u949d\u89d2\u4e09\u89d2\u5f62\uff0c\u6709\u4e00\u4e2a\u949d\u89d2\uff08\u56fe 21\uff09."
    },
    {
      "block": 9,
      "text": "\u76f4\u89d2\u4e09\u89d2\u5f62\u7684\u4e09\u4e2a\u8fb9\u6709\u4e13\u95e8\u7684\u540d\u79f0\uff0c\u5982\u56fe 20 \u6240\u793a. \u4e09\u89d2\u5f62\u4e5f\u53ef\u4ee5\u6309\u8fb9\u957f\u5206\u7c7b. \u5982\u679c\u4e09\u89d2\u5f62\u4e2d\u6709\u4e24\u8fb9\u76f8\u7b49\uff0c\u5219\u628a\u8fd9\u79cd\u4e09\u89d2\u5f62\u53eb\u505a\u7b49\u8170\u4e09\u89d2\u5f62. \u5176\u4f59\u6240\u6709\u4e09\u89d2\u5f62\uff08\u4e09\u4e2a\u8fb9\u6ca1\u6709\u7b49\u957f\u7684\uff09\u6784\u6210\u7531\u4e0d\u7b49\u8fb9\u4e09\u89d2\u5f62\u7ec4\u6210\u7684\u5b50\u96c6. \u4e09\u89d2\u5f62\u7684\u96c6\u5408\u5206\u4e3a\u4e8c\u7c7b\uff1a\u7b49\u8170\u4e09\u89d2\u5f62\u7684\u96c6\u5408\u548c\u4e0d\u7b49\u8fb9\u4e09\u89d2\u5f62\u7684\u96c6\u5408. \u7b49\u8170\u4e09\u89d2\u5f62\u7684\u4e09\u4e2a\u8fb9\u6709\u4e13\u95e8\u540d\u79f0\uff0c\u5982\u56fe 22 \u6240\u793a. \u4e09\u8fb9\u76f8\u7b49\u7684\u4e09\u89d2\u5f62\u53eb\u505a\u7b49\u8fb9\u4e09\u89d2\u5f62. \u7b49\u8fb9\u4e09\u89d2\u5f62\u7684\u96c6\u5408\u662f\u7b49\u8170\u4e09\u89d2\u5f62\u7684\u96c6\u5408\u7684\u5b50\u96c6."
    }
  ],
