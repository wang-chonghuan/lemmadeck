    },
    {
      "number": "508",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e00\u5bb6\u6709\u4e09\u4e2a\u5b69\u5b50\uff0c\u67d0\u4e2a\u865a\u6784\u7684\u793e\u533a\u9879\u76ee\u6bcf\u5e74\u4e3a\u5176\u4e2d\u7684\u4e00\u4e2a\u5b69\u5b50\u82b1\u7684\u6559\u80b2\u8d39\u662f150\u7f8e\u5143\uff0c\u4e3a\u53e6\u4e00\u4e2a\u5b69\u5b50\u82b1\u7684\u6559\u80b2\u8d39\u662f\u7b2c\u4e00\u4e2a\u76843\u500d\uff0c\u5982\u679c\u8fd9\u4e2a\u793e\u533a\u9879\u76ee\u4e3a\u8fd9\u4e09\u4e2a\u5b69\u5b50\u82b1\u7684\u6559\u80b2\u8d39\u662f\u5e73\u5747\u6bcf\u4eba\u6bcf\u5e74240\u7f8e\u5143\uff0c\u90a3\u4e48\u8fd9\u4e2a\u793e\u533a\u9879\u76ee\u6bcf\u5e74\u4e3a\u7b2c\u4e09\u4e2a\u5b69\u5b50\u82b1\u7684\u6559\u80b2\u8d39\u662f\u591a\u5c11\u7f8e\u5143\uff1f\n2) \u7236\u4eb2\u7684\u5de5\u8d44\u6bcf\u6708\u662f240\u7f8e\u5143.\u7236\u4eb2\u7684\u5de5\u8d44\u662f\u5973\u513f\u5956\u5b66\u91d1\u76846\u500d.\u5982\u679c\u4e00\u5bb6\u56db\u53e3\uff08\u5c0f\u513f\u5b50\u662f\u5c0f\u5b66\u751f\uff09\uff0c\u6bcf\u4eba\u6bcf\u6708\u5e73\u5747115\u7f8e\u5143\uff0c\u6bcd\u4eb2\u7684\u5de5\u8d44\u6bcf\u6708\u662f\u591a\u5c11\u7f8e\u5143\uff1f",
