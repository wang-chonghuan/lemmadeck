    {
      "number": "504",
      "text": "\u628a109\u56fe\u753b\u5728\u7ec3\u4e60\u672c\u4e0a\uff0c\u5728\u5706\u5468\u4e0a\u627e\u51fa\u548c$A,B$\u4e8c\u70b9\u7b49\u8ddd\u79bb\u7684\u5404\u70b9.",
      "figure_ids": []
    },
    {
      "number": "505",
      "text": "\u4f5c\u4e09\u89d2\u5f62$ABC$.\u4f5c\u4e0b\u5217\u6bcf\u5bf9\u70b9\u7684\u5bf9\u79f0\u8f74\uff1a\n1) \u70b9$A$\u548c\u70b9$B$\uff1b\n2) \u70b9$A$\u548c\u70b9$C$\uff1b\n3) \u70b9$B$\u548c\u70b9$C$.\u4f60\u53d1\u73b0\u8fd9\u4e9b\u8f74\u5177\u6709\u4ec0\u4e48\u6027\u8d28\uff1f",
