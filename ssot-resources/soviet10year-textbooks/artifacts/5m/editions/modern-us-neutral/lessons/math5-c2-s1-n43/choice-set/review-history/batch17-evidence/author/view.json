    {
      "id": "both-fraction-inequality-proof-records",
      "source_numbers": [
        "778"
      ],
      "view": {
        "mode": "multiple",
        "stem": "要证明 $123/800>1/8$ 和 $361/6000<1/15$。选择所有等式、计算和论证均正确的完整证明记录。",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$1/8=100/800$，因 $123>100$ 得第一式；$1/15=400/6000$，因 $361<400$ 得第二式。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$1/8=1/800$，因 $123>1$ 得第一式；$1/15=160000/6000$，因 $361<160000$ 得第二式。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$1/8=10/800$，因 $123>10$ 得第一式；$1/15=4000/6000$，因 $361<4000$ 得第二式。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$123/800-1/8=23/800>0$；$361/6000-1/15=-13/2000<0$，故两式成立。",
            "figure_ids": []
          }
        ]
      }
    },
