  "exercises": [
    {
      "number": "286",
      "text": "\u89e3\u91ca\u4e0b\u5217\u5404\u9898\u7684\u542b\u4e49\uff1a1) \u6e29\u5ea6\u53d8\u5316\u4e86 $t^\\circ\\mathrm{C}$\uff0c\u8bbe $t=28$\uff0c$-30$\uff0c$-8$\uff0c$4.5$\uff0c$-20$\uff0c$-1.7$.2) \u5f39\u7c27\u7684\u957f\u5ea6\u53d8\u5316\u4e86 $p$ \u6beb\u7c73\uff0c\u8bbe $p=15$\uff0c$-10$\uff0c$12$\uff0c$-9$\uff0c$-4$.",
      "figure_ids": []
    },
    {
      "number": "287",
      "text": "\u6c14\u6e29\u53d8\u5316\u4e86 $x$ \u5ea6. \u8bbe\u6c14\u6e29\uff1a\n1) \u964d\u4f4e $6^\\circ\\mathrm{C}$\uff1b\n2) \u5347\u9ad8 $3.6^\\circ\\mathrm{C}$\uff1b\n3) \u5347\u9ad8 $60^\\circ\\mathrm{C}$\uff1b\n4) \u964d\u4f4e $35.8^\\circ\\mathrm{C}$\uff0c$x$ \u4e3a\u591a\u5c11\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "288",
      "text": "\u5f39\u7c27\u7684\u957f\u5ea6\u53d8\u5316\u4e86 $n$ \u6beb\u7c73. \u8bbe\u5f39\u7c27\u957f\u5ea6\uff1a\n1) \u5ef6\u957f 6 \u6beb\u7c73\uff1b\n2) \u7f29\u77ed 5 \u6beb\u7c73\uff1b\n3) \u7f29\u77ed 23 \u6beb\u7c73\uff1b\n4) \u5ef6\u957f 18 \u6beb\u7c73\uff0c$n$ \u7b49\u4e8e\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "289",
      "text": "\u4e0a\u5348\u6e29\u5ea6\u53d8\u5316 $6^\\circ\\mathrm{C}$\uff0c\u4e0b\u5348\u53d8\u5316 $-4^\\circ\\mathrm{C}$\uff0c\u8fd9\u4e00\u5929\u5185\u6e29\u5ea6\u662f\u600e\u6837\u53d8\u5316\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "290",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u70b9 $A(7)$. \u5982\u679c\u628a 7 \u79fb\u52a8 2\uff0c\u8fd9\u4e2a\u70b9\u5c06\u79fb\u5230\u54ea\u91cc\uff1f\u5982\u679c 7 \u79fb\u52a8 $-3$ \u65f6\uff0c\u8fd9\u4e2a\u70b9\u53c8\u5c06\u79fb\u5230\u54ea\u91cc\uff1f",
      "figure_ids": []
    },
    {
      "number": "291",
      "text": "\u5f53 $-4$ \u79fb\u52a8 6 \u65f6\uff0c\u70b9 $A(-4)$ \u5c06\u79fb\u5230\u54ea\u91cc\uff1f\u53c8\u5f53 $-4$ \u79fb\u52a8$-7$ \u65f6\uff0c\u8fd9\u70b9\u53c8\u5c06\u79fb\u5230\u54ea\u91cc\uff1f",
      "figure_ids": []
    },
    {
      "number": "292",
      "text": "\u8bf4\u51fa $A(2,7)$\uff0c$B(-3,-6)$\uff0c$C(4,-5)$\uff0c$E(0,6)$ \u5404\u70b9\u5173\u4e8e\u5750\u6807\u539f\u70b9 $O$ \u7684\u5bf9\u79f0\u70b9\u7684\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "293",
      "text": "\u8bbe $A(-6,2)$\uff0c$B(-2,2)$\uff0c$C(-1,5)$\uff0c$D(-4,5)$\uff0c\u4f5c\u56db\u8fb9\u5f62 $ABCD$ \u7684\u5173\u4e8e\u5750\u6807\u539f\u70b9\u7684\u5bf9\u79f0\u56db\u8fb9\u5f62.",
      "figure_ids": []
    },
    {
      "number": "294",
      "text": "\u5728\u4e00\u6761\u94c1\u8def\u5e72\u7ebf\u4e0a\u4fee\u5efa\u4e86\u6570\u6761\u96a7\u9053\uff0c\u5176\u4e2d\u4e00\u6761\u957f 15 \u516c\u91cc\uff0c\u8fd8\u6709\u4e00\u6761\u957f 9 \u516c\u91cc. \u5982\u679c\u5168\u957f 750 \u7c73\u7684\u8d27\u8f66\u7528 21 \u5206\u949f\u901a\u8fc7\u7b2c\u4e00\u6761\u96a7\u9053\uff0c\u90a3\u4e48\u8d27\u8f66\u901a\u8fc7\u7b2c\u4e8c\u6761\u96a7\u9053\u9700\u8981\u591a\u5c11\u65f6\u95f4\uff08\u706b\u8f66\u901a\u8fc7\u65f6\u95f4\u6309\u673a\u8f66\u5f00\u59cb\u8fdb\u5165\u96a7\u9053\u5230\u6700\u540e\u4e00\u8282\u8f66\u7bb1\u5f00\u51fa\u96a7\u9053\u8ba1\u7b97\uff09\uff1f",
      "figure_ids": []
    },
    {
      "number": "295",
      "text": "\u8ba1\u7b97\uff1a\n1) $7225:85+64\\cdot2345-248\\,878:613$\uff1b\n2) $54\\cdot3465-9025:95+360\\,272:712$.",
      "figure_ids": []
    },
    {
      "number": "296",
      "text": "\u5728\u4e00\u6b21\u98de\u884c\u6d4b\u8bd5\u4e2d\uff0c\u6d4b\u8bd5\u98de\u673a\u9996\u5148\u5347\u9ad8 20 \u516c\u91cc\uff0c\u7136\u540e\u4e0b\u964d $5.5$ \u516c\u91cc. \u98de\u673a\u4e0a\u5347\u9ad8\u5ea6\u662f\u600e\u6837\u53d8\u5316\u7684\uff1f",
      "figure_ids": []
    },
    {
      "number": "297",
      "text": "\u4e00\u4e2a\u5de5\u4eba\u5e08\u5085\u4e00\u5c0f\u65f6\u5236\u6210\u7684\u96f6\u4ef6\u6bd4\u4ed6\u5f92\u5f1f\u591a 5 \u4e2a. \u5e08\u5f92\u4e8c\u4eba\u5171\u540c\u5de5\u4f5c 2 \u5c0f\u65f6\uff0c\u505a\u4e86 58 \u4e2a\u96f6\u4ef6. \u5e08\u5085\u548c\u5f92\u5f1f\u4e00\u5c0f\u65f6\u5404\u505a\u591a\u5c11\u4e2a\u96f6\u4ef6\uff1f",
      "figure_ids": []
    },
    {
      "number": "298",
      "text": "\u8ba1\u7b97\uff1a$[44.96+28.84:(13.7-10.9)]:1.8$.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u5f39\u7c27\u7684\u957f\u5ea6\u80fd\u5f80\u4e24\u4e2a\u65b9\u5411\u53d8\u5316\uff1a\u5ef6\u957f\u6216\u7f29\u77ed\uff08\u56fe 73\uff09. \u5ef6\u957f\u7528\u6b63\u6570\u8868\u793a\uff0c\u7f29\u77ed\u7528\u8d1f\u6570\u8868\u793a. \u5047\u5982\u8bf4\u5f39\u7c27\u7684\u957f\u5ea6\u53d8\u5316\u4e86 $-6$ \u6beb\u7c73\uff0c\u8fd9\u5c31\u662f\u8bf4\u5b83\u7f29\u77ed\u4e86 6 \u6beb\u7c73. \u5982\u679c\u8bf4\u5f39\u7c27\u7684\u957f\u5ea6\u53d8\u5316\u4e86 10 \u6beb\u7c73\uff0c\u8fd9\u5c31\u610f\u5473\u7740\u5b83\u5ef6\u957f\u4e86 10\u6beb\u7c73.\u5047\u8bbe\u6570 $a$ \u53d8\u5316\u4e86 6 \u4e2a\u5355\u4f4d\uff0c\u90a3\u4e48\u70b9 $A(a)$ \u5c31\u662f\u5411\u53f3\u79fb\u52a8\u4e86 6 \u4e2a\u5355\u4f4d. \u5982\u679c\u6570 $a$ \u53d8\u5316\u4e86 $-6$\uff0c\u5c31\u662f\u70b9 $A(a)$ \u5411\u5de6\u79fb\u52a8\u4e86 6 \u4e2a\u5355\u4f4d\uff08\u56fe 74\uff09."
    }
