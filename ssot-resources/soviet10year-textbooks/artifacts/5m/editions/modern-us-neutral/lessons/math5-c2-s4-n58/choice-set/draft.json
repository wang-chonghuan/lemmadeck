  "questions": [
    {
      "id": "q1108",
      "source_numbers": ["1108"],
      "view": {
        "mode": "multiple",
        "stem": "下列分数中，哪些能够写成有限小数？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$\\frac{33}{80}$", "figure_ids": []},
          {"id": "b", "text": "$\\frac{7}{75}$", "figure_ids": []},
          {"id": "c", "text": "$\\frac{27}{50}$", "figure_ids": []},
          {"id": "d", "text": "$\\frac{5}{48}$", "figure_ids": []},
          {"id": "e", "text": "$\\frac{27}{28}$", "figure_ids": []},
          {"id": "f", "text": "$\\frac{17}{25}$", "figure_ids": []},
          {"id": "g", "text": "$\\frac{3}{6}$", "figure_ids": []},
          {"id": "h", "text": "$\\frac{15}{12}$", "figure_ids": []},
          {"id": "i", "text": "$\\frac{13}{12}$", "figure_ids": []},
          {"id": "j", "text": "$\\frac{7}{28}$", "figure_ids": []},
          {"id": "k", "text": "$\\frac{8}{28}$", "figure_ids": []},
          {"id": "l", "text": "$\\frac{9}{75}$", "figure_ids": []},
          {"id": "m", "text": "$\\frac{25}{75}$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "对全部十三个分数判断能否表示为有限小数，保留先约分再判断分母质因数的区别。",
        "source_solution": "约分后的分母依次为80,75,50,48,28,25,2,4,12,4,7,25,3。仅含2、5质因数者对应33/80、27/50、17/25、3/6、15/12、7/28、9/75；其余六个不能写成有限小数。",
        "unit_reason": "十三个对象共用同一定义，构成一次完整分类；使用原生多选，不拆成逐分数的是非题或组合代码。",
        "concept_blocks": [8],
        "limitations": ["选择完整分类不能证明独立书写每个分数的约分和质因数分解过程。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["a", "c", "f", "g", "h", "j", "l"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "33与80互质，80=2^4*5，约分后分母无其他质因数。", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "7/75已约分，75=3*5^2，质因数3阻止有限表示。误把分母含有5当作充分条件，会将此项误选。", "misconception": "把75分解为3*5^2后，只检查存在5，不检查残余质因数3；输出能够写成有限小数。"},
          {"option_id": "c", "truth": "correct", "derivation": "27与50互质，50=2*5^2，因此有限。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "5/48已约分，48=2^4*3。仅因48是偶数就判有限会漏掉质因数3。", "misconception": "计算48除以2得24，发现分母为偶数便停止分解，并把所有偶数分母当作2的幂，误选5/48。"},
          {"option_id": "e", "truth": "incorrect", "derivation": "27与28互质，28=4*7。单独把分母除以7会得到错误的27/4并误判有限。", "misconception": "分母28除以7变成4，分子27保持不变；用错误的27/4代替原分数，因4=2^2而误选。"},
          {"option_id": "f", "truth": "correct", "derivation": "17/25已约分，25=5^2，因此有限。", "misconception": null},
          {"option_id": "g", "truth": "correct", "derivation": "3/6=1/2，约分后分母为2，因此有限。", "misconception": null},
          {"option_id": "h", "truth": "correct", "derivation": "15/12=5/4，4=2^2；假分数不妨碍有限小数表示。", "misconception": null},
          {"option_id": "i", "truth": "incorrect", "derivation": "13/12=1+1/12，余数部分的分母12=2^2*3，不能有限。丢弃余数只看整数1会误选。", "misconception": "执行整数除法13除以12得商1、余数1；丢弃余数，以整数1为完整商，因1是有限小数而误选原分数。"},
          {"option_id": "j", "truth": "correct", "derivation": "7/28=1/4，分母只含2，因此有限。", "misconception": null},
          {"option_id": "k", "truth": "incorrect", "derivation": "8/28=2/7，分母含7。长除法六位结果0.285714只是截断，不是精确有限小数。", "misconception": "把8/28约分为2/7，长除法只保留六位得到0.285714；把停止计算误作除法终止，误选原分数。"},
          {"option_id": "l", "truth": "correct", "derivation": "9/75=3/25，约掉3后分母为5^2，因此有限。", "misconception": null},
          {"option_id": "m", "truth": "incorrect", "derivation": "25/75=1/3，约分后仍含质因数3。检查两个数都以5结尾不能决定有限性。", "misconception": "检查25和75的末位均为5，就断言约分后分母只含5；未计算25/75=1/3，误选该项。"}
        ]
      }
    },
    {
      "id": "q1109",
      "source_numbers": ["1109"],
      "view": {
        "mode": "single",
        "stem": "把 $\\frac{5}{16}$、$\\frac{146}{125}$、$45\\frac{73}{80}$、$26\\frac{27}{32}$ 写成小数。按这一顺序，完整结果是哪一组？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$(0.3125,\\ 1.168,\\ 41.0625,\\ 21.9375)$", "figure_ids": []},
          {"id": "b", "text": "$(0.03125,\\ 0.1168,\\ 45.9125,\\ 26.84375)$", "figure_ids": []},
          {"id": "c", "text": "$(0.3125,\\ 1.168,\\ 45.9125,\\ 26.84375)$", "figure_ids": []},
          {"id": "d", "text": "$(0.3125,\\ 1.168,\\ 45.09125,\\ 26.084375)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "完成四个精确小数转换，保留假分数与两个带分数的整数部分及不同小数位数。",
        "source_solution": "5/16=3125/10000=0.3125；146/125=1168/1000=1.168；73/80=0.9125、27/32=0.84375，分别加45、26得到45.9125、26.84375。",
        "unit_reason": "一次完整有序转换记录覆盖四个原数，避免把每个小数位或整数部分做成独立点击。",
        "concept_blocks": [8],
        "limitations": ["识别完整记录不能证明独立完成除法及带分数转换的书写。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["c"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "前两数正确。误将带分数解释为乘积：45*(73/80)=41.0625，26*(27/32)=21.9375，得到此组。", "misconception": "带分数的整数部分与分数部分相乘，而非相加。"},
          {"option_id": "b", "truth": "incorrect", "derivation": "扩分两个简单分数时，分母均多写一个零：5*625=3125，但16*625误写成100000，得到0.03125；146*8=1168，但125*8误写成10000，得到0.1168；两个带分数仍正常转换。", "misconception": "扩分两个简单分数后，分母各多写一个零，使结果的小数点均错移一位。"},
          {"option_id": "c", "truth": "correct", "derivation": "四数依次为3125/10000、1168/1000、45+9125/10000、26+84375/100000，得到所列完整记录。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "先求出0.9125和0.84375；拼接带分数时误在其小数数字前保留一个额外0，得到45.09125、26.084375；前两数不变。", "misconception": "把带分数整数与小数相加当作字符串拼接，并把真分数小数表示中的前导0移入小数点后。"}
        ]
      }
    },
    {
      "id": "q1110",
      "source_numbers": ["1110"],
      "view": {
        "mode": "single",
        "stem": "比较下列四组数中前一个数与后一个数的大小：\n\n1. $7.68954$ 与 $7.68945$\n2. $3.131313\\ldots$ 与 $3.14$\n3. $0.7777\\ldots$ 与 $0.770770\\ldots$\n4. $1.3131\\ldots$ 与 $1.333\\ldots$\n\n比较符号依次是哪一组？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$(=,\\ <,\\ >,\\ <)$", "figure_ids": []},
          {"id": "b", "text": "$(>,\\ <,\\ >,\\ <)$", "figure_ids": []},
          {"id": "c", "text": "$(>,\\ >,\\ >,\\ <)$", "figure_ids": []},
          {"id": "d", "text": "$(<,\\ >,\\ <,\\ >)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "逐位比较四个有序数对，包括有限与无限小数的比较。",
        "source_solution": "首次不同的位置分别是小数第四位5>4、第二位3<4、第三位7>0、第二位1<3；因此关系为>,<,>,<。显示前缀已充分决定各关系，无须补充省略号后的循环约定。",
        "unit_reason": "四个比较共同组成一个完整有序记录，保留所有比较和原顺序，不以一个易比较数对代替全题。",
        "concept_blocks": [],
        "limitations": ["选择符号组不能证明逐对书写比较理由。", "不补定省略号所指的精确循环节；所有结论均由已显示的首次不同数位决定。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["b"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "先把每个数四舍五入到两位：首对变成7.69和7.69，误判相等；其余变成3.13与3.14、0.78与0.77、1.31与1.33，关系仍为<,>,<。", "misconception": "用两位近似数的比较代替原数的精确比较，丢失首对决定大小的数位。"},
          {"option_id": "b", "truth": "correct", "derivation": "从高位起比较，四个首次不同数位分别给出>,<,>,<。", "misconception": null},
          {"option_id": "c", "truth": "incorrect", "derivation": "遇到一边无限、一边有限且整数部分相同时，无条件把无限小数判大，于是第二对误判>；其他三对仍按首次不同数位比较。", "misconception": "把小数展开的长度当作数值大小，只在有限与无限相对时覆盖正常逐位比较。"},
          {"option_id": "d", "truth": "incorrect", "derivation": "找出正确的首次不同数位，却在每对中把较大数位所在的前一个数标成<、较小标成>，四个符号全部反向。", "misconception": "混淆比较符号方向：前数较大时写<，较小时写>。"}
        ]
      }
    },
