    {
      "id": "q1112",
      "source_numbers": ["1112"],
      "view": {
        "mode": "single",
        "stem": "32 克氧中含有 $6.06\\cdot10^{23}$ 个分子。按题给数据计算，1 公斤氧中含有多少个分子？",
        "figure_ids": [],
        "options": [
          {"id": "a", "text": "$1.89375\\cdot10^{25}$ 个分子", "figure_ids": []},
          {"id": "b", "text": "$1.89375\\cdot10^{22}$ 个分子", "figure_ids": []},
          {"id": "c", "text": "$1.9392\\cdot10^{22}$ 个分子", "figure_ids": []},
          {"id": "d", "text": "$1.89375\\cdot10^{23}$ 个分子", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "以相同质量单位计算比例并正确调整十的幂。",
        "source_solution": "1公斤=1000克；比例1000/32=31.25；6.06*31.25=189.375，故分子数189.375*10^23=1.89375*10^25。",
        "unit_reason": "一个带数量单位的总数需要完成质量换算、正比例与科学记数法，三步构成同一实际问题。",
        "concept_blocks": [],
        "limitations": ["选择总数不证明书写单位换算和指数规范化过程。", "原题未要求有效数字或近似精度；保留按所给数进行的算术结果，不声称实际测量具有更多精度。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["a"],
        "rationales": [
          {"option_id": "a", "truth": "correct", "derivation": "6.06*10^23*(1000/32)=189.375*10^23=1.89375*10^25。", "misconception": null},
          {"option_id": "b", "truth": "incorrect", "derivation": "漏掉公斤到克的1000倍，计算6.06*10^23*(1/32)=0.189375*10^23=1.89375*10^22。", "misconception": "把1公斤的数字1直接与以克计的32相除。"},
          {"option_id": "c", "truth": "incorrect", "derivation": "换算为1000克后把比例写反，计算6.06*10^23*(32/1000)=0.19392*10^23=1.9392*10^22。", "misconception": "正比例扩大量时使用原质量除以目标质量，而非目标质量除以原质量。"},
          {"option_id": "d", "truth": "incorrect", "derivation": "先正确得到189.375*10^23，随后把189.375缩小100倍成1.89375却保持指数23，得到所列值。", "misconception": "科学记数法移动小数点两位时未把指数增加2。"}
        ]
      }
    },
    {
