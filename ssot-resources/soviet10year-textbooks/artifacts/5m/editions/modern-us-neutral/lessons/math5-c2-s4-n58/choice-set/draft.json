        "options": [
          {"id": "a", "text": "$(-64,\\ 64,\\ -1)$", "figure_ids": []},
          {"id": "b", "text": "$(-16,\\ -16,\\ -\\frac14)$", "figure_ids": []},
          {"id": "c", "text": "$(-16,\\ 16,\\ -\\frac14)$", "figure_ids": []},
          {"id": "d", "text": "$(-12,\\ 12,\\ -3)$", "figure_ids": []}
        ]
      },
      "intent": {
        "task": "在三种输入下保留负系数、奇次幂符号及分数立方。",
        "source_solution": "x的立方依次为8、-8、1/8；乘以系数-2后为-16、16、-1/4。指数只作用于x，不作用于系数。",
        "unit_reason": "一张完整有序代入记录共同检验同一个表达式，保留负输入与分数输入边界。",
        "concept_blocks": [],
        "limitations": ["不能据选择结果声称已独立书写代入和立方过程。"],
        "figure_observations": []
      },
      "key": {
        "correct": ["c"],
        "rationales": [
          {"option_id": "a", "truth": "incorrect", "derivation": "误计算(-2x)^3；输入2、-2、1/2给底数-4、4、-1，立方为-64、64、-1。", "misconception": "将未加括号的外部系数也纳入立方底数。"},
          {"option_id": "b", "truth": "incorrect", "derivation": "先把x取绝对值再立方，得到8、8、1/8，乘-2得-16、-16、-1/4。", "misconception": "把负数的奇次幂错误处理成正数的幂。"},
          {"option_id": "c", "truth": "correct", "derivation": "-2*2^3=-16；-2*(-2)^3=16；-2*(1/2)^3=-1/4。", "misconception": null},
          {"option_id": "d", "truth": "incorrect", "derivation": "把x^3替换为3x，再乘-2，即计算-6x，得到-12、12、-3。", "misconception": "把指数3解释为乘以3，而非三个相同因子的乘积。"}
        ]
      }
    },
    {
