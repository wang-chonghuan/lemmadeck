  "exercises": [
    {
      "number": "149",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u70b9 $A(2)$. \u5411\u53f3\u79fb\u52a8 6 \u4e2a\u5355\u4f4d\u65f6\uff0c\u8fd9\u4e2a\u70b9\u53d8\u6210\u54ea\u70b9\uff1f\u5411\u5de6\u79fb\u52a8 6 \u4e2a\u5355\u4f4d\u5462\uff1f\u5f53\u79fb\u52a8 7 \u65f6\uff0c$A$ \u70b9\u5c06\u53d8\u5230\u54ea\u70b9\uff1f\u79fb\u52a8 $-7$ \u5462\uff1f",
      "figure_ids": []
    },
    {
      "number": "150",
      "text": "\u70b9 $P(4)$ \u5728\u79fb\u52a8\u4ee5\u540e\u548c\u70b9 $K(-2)$ \u91cd\u5408\uff0c\u70b9 $P$ \u79fb\u52a8\u4e86\u51e0\u4e2a\u5355\u4f4d\uff1f\u5982\u679c\u5b83\u548c\u70b9 $T(6)$ \u76f8\u91cd\u5408\uff0c\u53c8\u662f\u79fb\u52a8\u4e86\u51e0\u4e2a\u5355\u4f4d\uff1f",
      "figure_ids": []
    },
    {
      "number": "151",
      "text": "\u8bfb\u51fa\u56fe 41 \u4e2d\u6e29\u5ea6\u8ba1\u7684\u8bfb\u6570. \u5982\u679c\uff1a\n1) \u5347\u9ad8 $1^\\circ\\mathrm{C}$\uff1b\n2) \u964d\u4f4e $1^\\circ\\mathrm{C}$\uff1b\n3) \u5347\u9ad8 $2^\\circ\\mathrm{C}$\uff1b\n4) \u964d\u4f4e $2^\\circ\\mathrm{C}$\uff0c\u6bcf\u4e2a\u6e29\u5ea6\u8ba1\u8868\u793a\u7684\u6e29\u5ea6\u4e3a\u51e0\u5ea6\uff1f",
      "figure_ids": [
        "fig-41"
      ]
    },
    {
      "number": "152",
      "text": "\u6211\u770b\u5230\u5ba4\u5916\u6e29\u5ea6\u8ba1\u7684\u8bfb\u6570\u662f $5^\\circ\\mathrm{C}$\uff0c\u6211\u8981\u4e0d\u8981\u627e\u540c\u5b66\u53bb\u6e9c\u51b0\u573a\u5462\uff1f\u5982\u679c\u660e\u5929\u6c14\u6e29\u4e0b\u964d $11^\\circ\\mathrm{C}$ \u65f6\uff0c\u6211\u4eec\u80fd\u4e0d\u80fd\u6e9c\u51b0\u5462\uff1f",
      "figure_ids": []
    },
    {
      "number": "153",
      "text": "\u6c42\u5728\u6570\u8f74\u4e0a\u7684\u4ee5\u4e0b\u5404\u6570\uff1a\n1) \u548c $-8$ \u76f8\u8ddd 6 \u4e2a\u5355\u4f4d\uff1b\n2) \u548c 4 \u76f8\u8ddd 10 \u4e2a\u5355\u4f4d\uff1b\n3) \u548c $-4$ \u76f8\u8ddd 10 \u4e2a\u5355\u4f4d\uff1b\n4) \u548c 0 \u76f8\u8ddd 100 \u4e2a\u5355\u4f4d.",
      "figure_ids": []
    },
    {
      "number": "154",
      "text": "\u5199\u51fa\u548c $-11$ \u7b49\u8ddd\u79bb\u7684\u4e24\u4e2a\u6570. \u518d\u5199\u4e09\u5bf9\u8fd9\u6837\u7684\u6570.",
      "figure_ids": []
    },
    {
      "number": "155",
      "text": "\u4e00\u4e2a\u91c7\u7528\u4e86\u5148\u8fdb\u519c\u4e1a\u6280\u672f\u7684\u751f\u4ea7\u961f\u5728\u9762\u79ef\u4e3a 45 \u516c\u9877\u7684\u571f\u5730\u4e0a\u6536\u83b7\u4e86 4275 \u5428\u9a6c\u94c3\u85af\uff0c\u5728 35 \u516c\u9877\u7684\u4e00\u5757\u571f\u5730\u4e0a\u6536\u83b7\u4e86 3290 \u5428. \u8fd9\u4e2a\u751f\u4ea7\u961f\u5e73\u5747\u4ece\u6bcf\u516c\u9877\u571f\u5730\u6536\u83b7\u591a\u5c11\u9a6c\u94c3\u85af\uff1f",
      "figure_ids": []
    },
    {
      "number": "156",
      "text": "1974 \u5e74\u5168\u56fd\u6536\u5f97\u7c7d\u68c9 840 \u4e07\u5428. \u5176\u4e2d 530 \u4e07\u5428\u662f\u5728\u4e3b\u8981\u4ea7\u68c9\u5730\u533a\u6536\u7684. \u5176\u5b83\u4ea7\u68c9\u5730\u533a\u63d0\u4f9b\u7684\u7c7d\u68c9\u5360\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "157",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u70b9 $A(-3)$. \u5f53\u5b83\u5411\u53f3\u79fb\u52a8 5 \u4e2a\u5355\u4f4d\u65f6\uff0c\u5c06\u53d8\u6210\u54ea\u4e2a\u70b9\uff1f\u5f53\u5b83\u5411\u5de6\u79fb\u52a8 2 \u4e2a\u5355\u4f4d\u65f6\uff0c\u53c8\u5c06\u53d8\u4e3a\u54ea\u70b9\u5462\uff1f",
      "figure_ids": []
    },
    {
      "number": "158",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u70b9 $M(-4)$. \u5728\u79fb\u52a8\u4ee5\u540e\uff0c\u8fd9\u4e2a\u70b9\u548c\u70b9$C(3)$ \u91cd\u5408. \u70b9 $M$ \u79fb\u52a8\u4e86\u51e0\u4e2a\u5355\u4f4d\uff1f",
      "figure_ids": []
    },
    {
      "number": "159",
      "text": "\u6839\u636e\u67d0\u5e02\u7684\u53d1\u5c55\u8ba1\u5212\uff0c\u8981\u5efa\u8bbe\u4e00\u5ea7\u65b0\u5de5\u5382. \u8be5\u5382\u9700\u8981 660 \u540d\u5de5\u4eba\u2014\u8f66\u5de5\u3001\u94b3\u5de5\u548c\u94e3\u5de5. \u6240\u9700\u8981\u7684\u8f66\u5de5\u662f\u94e3\u5de5\u7684 3 \u500d\uff0c\u800c\u94b3\u5de5\u662f\u94e3\u5de5\u7684 2 \u500d. \u8be5\u5382\u9700\u8981\u591a\u5c11\u540d\u8f66\u5de5\uff1f",
      "figure_ids": []
    }
  ],
