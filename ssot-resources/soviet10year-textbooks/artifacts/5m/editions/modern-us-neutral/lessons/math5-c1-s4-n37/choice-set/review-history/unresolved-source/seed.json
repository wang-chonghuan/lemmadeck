    {
      "number": "687",
      "text": "\u4e00\u5bb6\u56db\u53e3\u4eba.\u7236\u4eb2\u662f\u516c\u5171\u6c7d\u8f66\u53f8\u673a\uff0c\u6bcf\u6708\u5de5\u8d44248.2\u7f8e\u5143\uff0c\u6bcd\u4eb2\u662f\u65e0\u8f68\u7535\u8f66\u53f8\u673a\uff0c\u6bcf\u6708\u5de5\u8d44174.2\u7f8e\u5143.\u4ed6\u4eec\u4f4f\u4e00\u595740\u5e73\u65b9\u7c73\u7684\u4f4f\u5b85\uff0c\u6bcf\u5e73\u65b9\u7c73\u5c45\u4f4f\u9762\u79ef\u7684\u623f\u8d39\u662f13.2\u7f8e\u5206.\u623f\u8d39\u5360\u8fd9\u5bb6\u5de5\u8d44\u6536\u5165\u7684\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "688",
      "text": "\u4e24\u4e2a\u5de5\u4f5c\u961f\u7684\u4eba\u6570\u76f8\u7b49.\u7b2c\u4e00\u4e2a\u5de5\u4f5c\u961f\u589e\u52a08\u4eba\uff0c\u7b2c\u4e8c\u4e2a\u5de5\u4f5c\u961f\u51cf\u5c112\u4eba\u65f6\uff0c\u7b2c\u4e00\u961f\u7684\u5de5\u4eba\u6570\u4e3a\u7b2c\u4e8c\u961f\u76843\u500d.\u6bcf\u4e2a\u961f\u91cc\u6709\u591a\u5c11\u5de5\u4eba\uff1f",
      "figure_ids": []
    },
    {
      "number": "689",
      "text": "Ben\u7684\u4e00\u6b65\u6bd4Tom\u7684\u4e00\u6b65\u592712\u5398\u7c73\uff0cTom\u76844\u6b65\u6bd4Ben\u76846\u5c0f54\u5398\u7c73\uff0c\u6c42\u6bcf\u4e2a\u5b69\u5b50\u6bcf\u6b65\u7684\u8ddd\u79bb.\n\u5224\u65ad\u8fd9\u4e9b\u6761\u4ef6\u80fd\u5426\u540c\u65f6\u6210\u7acb\uff0c\u5e76\u8bf4\u660e\u7406\u7531\u3002",
      "figure_ids": []
    },
    {
      "number": "690",
      "text": "\u7b2c\u4e00\u8258\u5feb\u8247\u4e2d\u7684\u4eba\u6570\u662f\u7b2c\u4e8c\u8258\u5feb\u8247\u76842\u500d.\u5f53\u5230\u8fbe\u6700\u8fd1\u7684\u7801\u5934\uff0c\u4ece\u7b2c\u4e00\u8258\u5feb\u8247\u4e0b\u676598\u4eba\uff0c\u4ece\u7b2c\u4e8c\u8258\u5feb\u8247\u4e0b\u676516\u4eba\u540e\uff0c\u4e24\u8247\u4e0a\u7684\u4eba\u6570\u76f8\u7b49.\u6bcf\u8258\u5feb\u8247\u539f\u5148\u5404\u6709\u591a\u5c11\u4eba\uff1f",
      "figure_ids": []
    },
    {
      "number": "691",
      "text": "\u4e00\u5ea7\u5927\u578b\u7cae\u4ed3\u4e2d\u7684\u7cae\u98df\u662f\u7b2c\u4e8c\u5ea7\u7cae\u4ed3\u76843\u500d.\u5f53\u4ece\u7b2c\u4e00\u5ea7\u7cae\u4ed3\u4e2d\u8fd0\u51fa960\u5428\u7cae\u98df\uff0c\u5411\u7b2c\u4e8c\u5ea7\u7cae\u4ed3\u4e2d\u8fd0\u8fdb240\u5428\u7cae\u98df\u4e4b\u540e\uff0c\u4e24\u5ea7\u7cae\u4ed3\u4e2d\u7684\u7cae\u98df\u76f8\u7b49.\u6bcf\u5ea7\u7cae\u4ed3\u539f\u5148\u5404\u6709\u591a\u5c11\u5428\u7cae\u98df\uff1f",
      "figure_ids": []
    },
    {
      "number": "692",
      "text": "\u706b\u8f66\u7ad9\u91cc\u505c\u6709\u4e24\u5217\u706b\u8f66.\u7b2c\u4e00\u5217\u706b\u8f66\u7684\u8f66\u7bb1\u6570\u662f\u7b2c\u4e8c\u5217\u76842\u500d.\u5f53\u4ece\u7b2c\u4e00\u5217\u706b\u8f66\u4e0a\u6458\u4e0b14\u8282\u8f66\u7bb1\uff0c\u6302\u5728\u7b2c\u4e8c\u5217\u706b\u8f66\u4e0a\u65f6\uff0c\u4e24\u5217\u706b\u8f66\u7684\u8f66\u7bb1\u8282\u6570\u76f8\u7b49.\u6bcf\u5217\u706b\u8f66\u539f\u5148\u5404\u6709\u591a\u5c11\u8282\u8f66\u7bb1\uff1f",
      "figure_ids": []
    },
    {
      "number": "693",
      "text": "\u8ba1\u7b97\uff1a\n1) $(112:28-36-24):(-1.4)$\uff1b\n2) $4.9-4.8:(3-19)-1.4:(-8)$\uff1b\n3) $-5.7:(-19)-0.8\\cdot(-4)+2.7:0.3$\uff1b\n4) $(-6.4\\cdot0.3+5.4\\cdot0.3):(-0.2)-5.1$.",
      "figure_ids": []
    }
