    {
      "number": "684",
      "text": "\u4fee\u7b51\u67d0\u865a\u6784\u94c1\u8def\uff0c\u9700\u8981\u642c\u8fd02.7\u4ebf\u7acb\u65b9\u7c73\u571f.\u5982\u679c\u6bcf\u7acb\u65b9\u7c73\u571f\u91cd2.5\u5428\uff0c\u752825\u5428\u8f7d\u91cd\u6c7d\u8f66\u9700\u8981\u642c\u8fd0\u591a\u5c11\u6b21\uff1f",
