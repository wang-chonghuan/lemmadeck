      "text": "\u4e00\u4ef6\u5927\u8863\u3001\u4e00\u53cc\u76ae\u978b\u548c\u4e00\u9876\u5e3d\u5b50\u4ef7\u503c43\u7f8e\u5143.\u4e00\u53cc\u76ae\u978b\u7684\u4ef7\u503c\u662f\u4e00\u9876\u5e3d\u5b50\u76843\u500d\uff0c\u800c\u5e3d\u5b50\u6bd4\u5927\u8863\u8d3135\u7f8e\u5143.\u6bcf\u4ef6\u4e1c\u897f\u5404\u503c\u591a\u5c11\u7f8e\u5143\uff1f",
      "figure_ids": []
