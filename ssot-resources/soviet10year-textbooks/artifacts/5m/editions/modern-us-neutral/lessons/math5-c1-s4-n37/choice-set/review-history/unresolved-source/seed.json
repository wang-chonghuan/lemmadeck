    {
      "number": "672",
      "text": "\u65c5\u884c\u7528\u7164\u6c14\u7089\u548c\u4e24\u4e2a\u6c14\u74f6\u5171\u91cd7\u516c\u65a4.\u7164\u6c14\u7089\u7684\u91cd\u91cf\u6bd4\u4e00\u4e2a\u6c14\u74f6\u8f7b2\u516c\u65a4.\u6c42\u4e00\u4e2a\u6c14\u74f6\u7684\u91cd\u91cf.",
      "figure_ids": []
    },
    {
      "number": "673",
      "text": "\u5496\u5561\u58f6\u548c\u4e24\u4e2a\u8336\u676f\u76db740\u514b\u6c34.\u5496\u5561\u58f6\u4e2d\u7684\u6c34\u6bd4\u4e00\u4e2a\u676f\u5b50\u91cc\u7684\u6c34\u591a380\u514b.\u6c42\u5496\u5561\u58f6\u80fd\u76db\u591a\u5c11\u514b\u6c34\uff1f",
      "figure_ids": []
    },
    {
      "number": "674",
      "text": "\u4e09\u5929\u5171\u5356\u51fa830\u516c\u65a4\u6a59\u5b50.\u7b2c\u4e8c\u5929\u5356\u51fa\u7684\u6a59\u5b50\u6bd4\u7b2c\u4e00\u5929\u5c1130\u516c\u65a4\uff0c\u7b2c\u4e09\u5929\u5356\u51fa\u7684\u662f\u7b2c\u4e8c\u5929\u76843\u500d.\u7b2c\u4e00\u5929\u5356\u51fa\u591a\u5c11\u516c\u65a4\u6a59\u5b50\uff1f",
