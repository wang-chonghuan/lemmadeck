    {
      "number": "680",
      "text": "\u5b66\u6821\u4e2d\u6709360\u540d\u5973\u5b66\u751f.\u5982\u679c\u7537\u5b66\u751f\u5360\u5168\u6821\u5b66\u751f\u603b\u6570\u768452%\uff0c\u90a3\u4e48\uff0c\u5b66\u6821\u91cc\u5171\u6709\u591a\u5c11\u5b66\u751f\uff1f",
