    {
      "number": "664",
      "text": "\u4f5c$150^\\circ$\u7684\u89d2.\u4f5c\u8fd9\u4e2a\u89d2\u7684\u5e73\u5206\u7ebf\uff0c\u5e76\u5728\u5e73\u5206\u7ebf\u4e0a\u53d6\u4e00\u70b9$K$.\u8fc7$K$\u70b9\u4f5c\u5e73\u884c\u4e8e\u8fd9\u4e2a\u89d2\u7684\u4e24\u8fb9\u7684\u4e24\u6761\u76f4\u7ebf.\u91cf\u6240\u5f97\u56db\u8fb9\u5f62\u7684\u5404\u89d2.",
      "figure_ids": []
    },
    {
      "number": "665",
      "text": "\u5706\u548c\u4ee5\u5706\u5fc3\u4e3a\u9876\u70b9\u7684\u89d2\u7684\u4ea4\u96c6\u53eb\u505a\u6247\u5f62.\u4ee54.5\u5398\u7c73\u4e3a\u534a\u5f84\uff0c\u4ee5$O$\u4e3a\u5706\u5fc3\u4f5c\u5706.\u4f5c\u89d2$AOB$\u3001$BOC$\u548c$COD$\uff0c\u5206\u522b\u4e3a$40^\\circ$\u3001$60^\\circ$\u548c$30^\\circ$.\u628a\u5f97\u51fa\u7684\u5404\u6247\u5f62\u753b\u4e0a\u4e0d\u540c\u989c\u8272.\u54ea\u4e2a\u56fe\u5f62\u662f\u8fd9\u4e9b\u6247\u5f62\u7684\u5e76\u96c6\uff1f\u89d2$AOB$\u548c\u5706\u5468\u7684\u4ea4\u96c6\u662f\u4ec0\u4e48\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "666",
      "text": "\u5728\u89d2$ABC$\u7684\u4e24\u8fb9\u4e0a\u622a\u4e24\u4e2a\u7b49\u957f\u7684\u7ebf\u6bb5$BK$\u548c$BM$\uff0c\u8054\u7ed3\u5b83\u4eec\u7684\u4e24\u7aef.\u5224\u5b9a\u6240\u5f97\u4e09\u89d2\u5f62\u7684\u7c7b\u578b.",
      "figure_ids": []
    },
    {
      "number": "667",
      "text": "\u67d0\u865a\u6784\u57ce\u5e02\u6bcf\u6708\u964d\u6c34\u91cf(\u4ee5\u5398\u7c73\u8ba1)\u7684\u5206\u5e03\u60c5\u51b5\u662f\uff1a\u6839\u636e\u8fd9\u4e9b\u6570\u636e\u7ed8\u5236\u6bcf\u6708\u964d\u6c34\u91cf\u5206\u5e03\u7684\u6761\u5f62\u56fe.\u54ea\u6708\u4efd\u964d\u6c34\u91cf\u6700\u5927\uff0c\u54ea\u6708\u4efd\u964d\u6c34\u91cf\u6700\u5c0f\uff1f",
      "figure_ids": [
        "tbl-p0162-02"
      ]
    },
    {
      "number": "668",
      "text": "\u5b66\u6821\u79cd\u690d\u5c0f\u7ec4\u4ece9\u516c\u9877\u79cd\u690d\u56ed\u91cc\u6bcf\u516c\u9877\u653635\u5428\u852c\u83dc.\u6bcf\u5428\u852c\u83dc\u7684\u6536\u76ca\u662f115\u7f8e\u5143.\u751f\u4ea7\u961f\u628a\u8fd9\u4e9b\u94b1\u768412%\u6350\u7ed9\u793e\u533a\u57fa\u91d1.\u540c\u5b66\u4eec\u4ea4\u591a\u5c11\u94b1\u7ed9\u793e\u533a\u57fa\u91d1\uff1f",
      "figure_ids": []
    },
    {
      "number": "669",
      "text": "\u6309\u4e09\u89d2\u5f62\u5404\u9876\u70b9\u5750\u6807\uff1a$A(2,6)$\u3001$B(6,4)$\u548c$C(4,-2)$\u4f5c\u4e09\u89d2\u5f62$ABC$.\u5206\u522b\u4f5c\u4e09\u89d2\u5f62$ABC$\u7684\u5173\u4e8e\u539f\u70b9\u548c$Oy$\u8f74\u7684\u5bf9\u79f0\u56fe\u5f62$P$\u548c$M$.\u56fe\u5f62$P$\u548c$M$\u662f\u4e0d\u662f\u5173\u4e8e$Ox$\u8f74\u5bf9\u79f0\uff1f",
      "figure_ids": []
    },
    {
      "number": "670",
      "text": "\u8ba1\u7b97\uff1a\n1) $-0.2\\cdot(-0.4)\\cdot0.3-0.01064:(-0.14)$\uff1b\n2) $0.00936:(-0.18)-0.7\\cdot(-0.3)\\cdot(-0.4)$\uff1b\n3) $-36:25-(-2.4+2.7\\cdot0.3)$\uff1b\n4) $44:(-25)-(4.3\\cdot0.8-3.7)$.",
