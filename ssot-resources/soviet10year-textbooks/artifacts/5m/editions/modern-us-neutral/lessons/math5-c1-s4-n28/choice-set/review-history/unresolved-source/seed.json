  "concepts": [
    {
      "block": 0,
      "text": "\u8d1f\u6570\u7684\u9664\u6cd5\u548c\u6b63\u6570\u9664\u6cd5\u7684\u610f\u4e49\u76f8\u540c\uff1a\u5c31\u662f\u5df2\u77e5\u4e24\u4e2a\u56e0\u6570\u7684\u79ef\u548c\u5176\u4e2d\u7684\u4e00\u4e2a\u56e0\u6570\uff0c\u6c42\u53e6\u4e00\u4e2a\u56e0\u6570."
    },
    {
      "block": 3,
      "text": "\u4e24\u4e2a\u8d1f\u6570\u76f8\u9664\uff0c\u5546\u662f\u6b63\u6570.\u5546\u7684\u7edd\u5bf9\u503c\u7b49\u4e8e\u88ab\u9664\u6570\u7684\u7edd\u5bf9\u503c\u9664\u4ee5\u9664\u6570\u7684\u7edd\u5bf9\u503c."
    },
    {
      "block": 5,
      "text": "\u5f02\u53f7\u4e8c\u6570\u76f8\u9664\uff0c\u5546\u662f\u8d1f\u6570.\u5546\u7684\u7edd\u5bf9\u503c\u7b49\u4e8e\u88ab\u9664\u6570\u7684\u7edd\u5bf9\u503c\u9664\u4ee5\u9664\u6570\u7684\u7edd\u5bf9\u503c."
    },
    {
      "block": 12,
      "text": "\u96f6\u9664\u4ee5\u4efb\u4f55\u4e00\u4e2a\u4e0d\u7b49\u4e8e\u96f6\u7684\u6570\u90fd\u5f97\u96f6."
    },
    {
      "block": 13,
      "text": "\u96f6\u4e0d\u80fd\u4f5c\u9664\u6570\uff08\u56fe112\uff09."
    },
    {
      "block": 16,
      "text": "\u89e3\u65b9\u7a0b\u65f6\uff0c\u65b9\u7a0b\u7684\u4e24\u8fb9\u5f80\u5f80\u9700\u8981\u4e58\u4ee5\u6216\u9664\u4ee5\u540c\u4e00\u4e2a\u6570\uff08\u4e0d\u7b49\u4e8e\u96f6\uff09.\u6240\u5f97\u65b0\u65b9\u7a0b\u7684\u6839\u7684\u96c6\u5408\u548c\u7ed9\u5b9a\u65b9\u7a0b\u7684\u76f8\u540c."
    }
