  "exercises": [
    {
      "number": "517",
      "text": "\u4e0b\u5217\u9664\u6cd5\u505a\u5f97\u5bf9\u4e0d\u5bf9\uff1f\n1) $-36:2=-18$\uff1b\n2) $60:(-1.5)=-4$\uff1b\n3) $2.7:(-1)=2.7$\uff1b\n4) $-7.5:(-5)=1.5$.",
      "figure_ids": []
    },
    {
      "number": "518",
      "text": "\u6c42\u5546\uff1a\n1) $-38:19$\uff1b\n2) $45:(-15)$\uff1b\n3) $-36:(-6)$\uff1b\n4) $270:(-9)$\uff1b\n5) $-5.1:(-17)$\uff1b\n6) $650:(-1.3)$\uff1b\n7) $-4.4:4$\uff1b\n8) $-8.6:(-43)$\uff1b\n9) $48.1:(-48.1)$\uff1b\n10) $-950:9.5$\uff1b\n11) $-5.42:(-27.1)$\uff1b\n12) $10.01:(-1.3)$.",
      "figure_ids": []
    },
    {
      "number": "519",
      "text": "\u8ba1\u7b97\uff1a\n1) $-4\\cdot(-5)-(-30):6$\uff1b\n2) $15:(-15)-(-24):8$\uff1b\n3) $-8\\cdot(-3+12):36+2$\uff1b\n4) $2.3\\cdot(-6-4):5$\uff1b\n5) $(-8+32):(-6)-7$\uff1b\n6) $-21+(-3-4+5):(-2)$\uff1b\n7) $-6\\cdot4-84:(-3.8+1.7)$\uff1b\n8) $(-6+6.4-10):(-8)\\cdot(-3)$.",
      "figure_ids": []
    },
    {
      "number": "520",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1) $(3m+6m):9$\uff0c\u5f53$m=-12,-5.96$\u65f6\uff1b\n2) $(5.2a-5.2b):5.2$\uff0c\u5f53$a=-27,b=-3.64$\u65f6.",
      "figure_ids": []
    },
    {
      "number": "521",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1) $(-23\\cdot5):5$\uff1b\n2) $[32\\cdot(-7)]:32$\uff1b\n3) $(-9\\cdot7.4):(-9)$\uff1b\n4) $[-8\\cdot(-9.1)]:9.1$.",
      "figure_ids": []
    },
    {
      "number": "522",
      "text": "\u6c42\u5546\uff1a\n1) $87x$\u548c87\uff1b\n2) $6.2m$\u548c6.2\uff1b\n3) $-3.7k$\u548c$-3.7$\uff1b\n4) $9m$\u548c$m$\uff1b\n5) $-41k$\u548c$k$\uff1b\n6) $-1.9x$\u548c$x$.",
      "figure_ids": []
    },
    {
      "number": "523",
      "text": "\u6c42\u8bc1\uff1a\u5f53\u53d8\u6570\u4e3a\u4efb\u4f55\u503c\u65f6\uff0c\u4e0b\u5217\u7b49\u5f0f\u90fd\u6210\u7acb\uff1a\n1) $-28k:(-7)=4k$\uff1b\n2) $64x:(-8)=-8x$.",
      "figure_ids": []
    },
    {
      "number": "524",
      "text": "\u89e3\u65b9\u7a0b\u5e76\u68c0\u9a8c\uff1a\n1) $-x\\cdot4=-100$\uff1b\n2) $3\\cdot(-x)=-27$\uff1b\n3) $-0.1y=33$\uff1b\n4) $10\\cdot(x-4)=-80$.",
      "figure_ids": []
    },
    {
      "number": "525",
      "text": "\u6211\u60f3\u4e00\u4e2a\u6570\uff0c\u6269\u59275\u500d\uff0c\u518d\u51cf\u53bb2.7\uff0c\u7ed3\u679c\u5f97$-21.7$\uff0c\u6211\u60f3\u7684\u662f\u4ec0\u4e48\u6570\uff1f",
      "figure_ids": []
    },
    {
      "number": "526",
      "text": "\u6309\u56fe113\u5217\u65b9\u7a0b\u5e76\u6c42\u89e3.",
      "figure_ids": [
        "fig-113"
      ]
    },
    {
      "number": "527",
      "text": "\u4f5c\u9876\u70b9\u5750\u6807\u4e3a$N(-3,0),T(4,0),P(4,5)$\u7684\u4e09\u89d2\u5f62$NTP$.\u518d\u4f5c\u4e09\u89d2\u5f62$NTP$\u7684\u5173\u4e8e$Ox$\u8f74\u7684\u5bf9\u79f0\u4e09\u89d2\u5f62.\u8fd9\u4e24\u4e2a\u5bf9\u79f0\u4e09\u89d2\u5f62\u7684\u5e76\u96c6\u662f\u4ec0\u4e48\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "528",
      "text": "\u628a$-42,16,-2.7,-1,0,64.8$\u5404\u6570\u4e2d\u7684\u6bcf\u4e2a\u6570\u90fd\u5316\u6210\u4e24\u4e2a\u56e0\u6570\u7684\u79ef\uff0c\u5176\u4e2d\u7684\u4e00\u4e2a\u56e0\u6570\u662f$-1$.",
      "figure_ids": []
    },
    {
      "number": "529",
      "text": "\u628a9\uff0c16\uff0c25\u5206\u522b\u5316\u6210\u4e24\u4e2a\u76f8\u7b49\u7684\u56e0\u6570\u7684\u79ef.\u505a\u8fd9\u4e2a\u9898\u53ef\u4ee5\u7528\u51e0\u79cd\u65b9\u6cd5\uff1f",
      "figure_ids": []
    },
    {
      "number": "530",
      "text": "\u67d0\u9879\u865a\u6784\u7edf\u8ba1\u8bb0\u5f55\u4e24\u4e2a\u5730\u533a\u7684\u94a2\u4ea7\u91cf.1950\u5e74\uff0cRiver Region \u751f\u4ea7\u4e863580\u4e07\u5428\u94a2\uff0cLake Region \u751f\u4ea7\u4e864840\u4e07\u5428\u94a2.1973\u5e74\uff0cRiver Region \u7684\u94a2\u4ea7\u91cf\u4e3a17800\u4e07\u5428\uff0cLake Region \u4e3a15000\u4e07\u5428.\u628a\u4e24\u4e2a\u5730\u533a\u57281950\u5e74\u548c1973\u5e74\u7684\u94a2\u4ea7\u91cf\u4f5c\u6210\u6761\u5f62\u56fe.",
      "figure_ids": []
    },
    {
      "number": "531",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e00\u4e2a\u7532\u866b\u4ee56\u5398\u7c73/\u79d2\u7684\u901f\u5ea6\u6cbf\u6811\u5e72\u5411\u4e0a\u722c\uff08\u56fe114\uff09.\u4e00\u6761\u6bdb\u866b\u6cbf\u540c\u4e00\u6811\u5e72\u5411\u4e0b\u722c.\u73b0\u5728\u6bdb\u866b\u6bd4\u7532\u866b\u4f4e60\u5398\u7c73.\u5982\u679c5\u79d2\u949f\u4ee5\u540e\u7532\u866b\u548c\u6bdb\u866b\u7684\u8ddd\u79bb\u662f100\u5398\u7c73\uff0c\u6bdb\u866b\u7684\u722c\u884c\u901f\u5ea6\u662f\u591a\u5c11\u5398\u7c73/\u79d2\uff1f\n2) \u4e8c\u4eba\u4ee5\u76f8\u540c\u901f\u5ea6\u9a91\u81ea\u884c\u8f66\u76f8\u5411\u800c\u884c.\u73b0\u5728\u4ed6\u4eec\u4e4b\u95f4\u7684\u8ddd\u79bb\u662f40\u516c\u91cc\uff0c\u4e09\u5c0f\u65f6\u540e\u5c06\u662f50\u516c\u91cc.\u6c42\u6bcf\u4eba\u9a91\u8f66\u7684\u901f\u5ea6.",
      "figure_ids": [
        "fig-114"
      ]
    },
    {
      "number": "532",
      "text": "\u4ece\u957f\u5bbd\u4e3a$40\\times30$\u5398\u7c73\u7684\u5c0f\u7a97\u8fdb\u5165\u5ba4\u5185\u7684\u7a7a\u6c14\u91cf\u662f\u6bcf\u79d2$0.004\\cdot(T-t)$\u7acb\u65b9\u7c73.\u5f0f\u4e2d$T$\u2014\u2014\u5ba4\u5185\u6c14\u6e29\uff0c$t$\u2014\u2014\u5ba4\u5916\u6c14\u6e29.\u5f53$T=25^\\circ\\mathrm{C},t=-15^\\circ\\mathrm{C}$\u65f6\uff0c15\u5206\u949f\u5185\uff0c\u8fdb\u5165\u5ba4\u5185\u7684\u7a7a\u6c14\u662f\u591a\u5c11\u7acb\u65b9\u7c73\uff1f\u5047\u5982\u623f\u95f4\u7684\u957f\u5ea6\u662f5.4\u7c73\uff0c\u5bbd4.2\u7c73\uff0c\u9ad82.75\u7c73\uff0c\u9700\u8981\u591a\u5c11\u65f6\u95f4\u624d\u80fd\u4f7f\u6574\u4e2a\u623f\u95f4\u6362\u4e0a\u65b0\u9c9c\u7a7a\u6c14\uff1f",
      "figure_ids": []
    },
    {
      "number": "533",
      "text": "\u8ba1\u7b97\uff1a\n1) $25.116:3.12\\cdot(346.7-246.7)\\cdot(1.06+7.98)$\uff1b\n2) $25.047:4.14\\cdot(7.97+1.06)\\cdot(417.6-317.6)$.",
      "figure_ids": []
    },
    {
      "number": "534",
      "text": "\u4f5c\u9664\u6cd5\uff1a\n1) $57:(-19)$\uff1b\n2) $-123:41$\uff1b\n3) $-147:(-7)$\uff1b\n4) $3.8:(-2)$\uff1b\n5) $-6.3:7$\uff1b\n6) $-5.6:(-56)$\uff1b\n7) $14.31:(-2.7)$\uff1b\n8) $-86.2:(-0.1)$\uff1b\n9) $-51.34:(-1.7)$.",
      "figure_ids": []
    },
    {
      "number": "535",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1) $(48-57):0.9$\uff1b\n2) $(-84.2-15.8):(-0.01)$\uff1b\n3) $(-24.6+13.8):2.7$\uff1b\n4) $643.2:(-87.3+85.7)$\uff1b\n5) $3.2:(-0.4\\cdot0.2)$\uff1b\n6) $-4.9:(-0.2\\cdot0.3-0.1)$.",
      "figure_ids": []
    },
    {
      "number": "536",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $-6.32x=60.04$\uff1b\n2) $y:(-3.08)=-4.5$\uff1b\n3) $8.37\\cdot(-y)=20.088$\uff1b\n4) $-10.01k=83.083$\uff1b\n5) $-p:(-3.8)=2.05$\uff1b\n6) $-2.4\\cdot(-m)=-0.24$.",
      "figure_ids": []
    },
    {
      "number": "537",
      "text": "\u6cb3\u4e0a\u67b6\u8bbe\u4e00\u5ea7\u957f234\u7c73\u7684\u4e94\u5b54\u6865\uff0c\u5176\u4e2d4\u5b54\u7684\u957f\u5ea6\u76f8\u7b49\uff0c\u7b2c\u4e94\u5b54\u6bd4\u5176\u4f59\u7684\u6bcf\u5b54\u957f14\u7c73.\u6bcf\u5b54\u7684\u957f\u5ea6\u662f\u591a\u5c11\u7c73\uff1f",
      "figure_ids": []
    },
    {
      "number": "538",
      "text": "\u7528200\u516c\u65a4\u9762\u7c89\u70e4\u9762\u5305\uff0c\u5f97260\u516c\u65a4\u719f\u9762\u5305\uff0c\u6c42\u5403\u6c34\u7387.",
      "figure_ids": []
    },
    {
      "number": "539",
      "text": "\u4f5c\u4e09\u89d2\u5f62$ABC$\uff0c\u4f7f$|AB|=3$\u5398\u7c73\uff0c$|BC|=4$\u5398\u7c73\uff0c$|AC|=6$\u5398\u7c73.\u4f5c\u4e09\u89d2\u5f62$ABC$\u7684\u5173\u4e8e\u76f4\u7ebf$AB$\u7684\u5bf9\u79f0\u4e09\u89d2\u5f62.",
