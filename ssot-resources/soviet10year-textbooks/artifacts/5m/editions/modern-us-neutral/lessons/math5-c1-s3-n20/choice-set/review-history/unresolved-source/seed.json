  "exercises": [
    {
      "number": "335",
      "text": "6 \u53d8\u5316\u4e86 $-10$. \u6240\u5f97\u7684\u6570\u4f4d\u4e8e\u539f\u70b9\u7684\u54ea\u4e00\u8fb9\uff1f\u8fd9\u4e2a\u6570\u548c\u539f\u70b9\u7684\u8ddd\u79bb\u591a\u5927\uff1f$6+(-10)$ \u7684\u548c\u7b49\u4e8e\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "336",
      "text": "10 \u53d8\u5316\u4e86 $-6$. \u6240\u5f97\u7684\u6570\u5728\u539f\u70b9\u7684\u54ea\u4e00\u8fb9\uff1f\u8fd9\u4e2a\u6570\u548c\u539f\u70b9\u7684\u8ddd\u79bb\u591a\u5927\uff1f$10+(-6)$ \u7684\u548c\u7b49\u4e8e\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "337",
      "text": "\u4e0a\u5348\u6c14\u6e29\u53d8\u5316\u4e86 $-4^\\circ\\mathrm{C}$\uff0c\u4e0b\u5348\u53d8\u5316\u4e86 $12^\\circ\\mathrm{C}$. \u5168\u5929\u6c14\u6e29\u53d8\u5316\u4e86\u591a\u5c11\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "338",
      "text": "\u4f5c\u52a0\u6cd5\uff1a\n1) $26+(-6)$\uff1b\n2) $-70+50$\uff1b\n3) $-17+30$\uff1b\n4) $80+(-120)$\uff1b\n5) $-4+(-38)$\uff1b\n6) $-5.3+6.8$\uff1b\n7) $-9+8.5$\uff1b\n8) $1+(-0.39)$\uff1b\n9) $-0.7+(-0.6)$.",
      "figure_ids": []
    },
    {
      "number": "339",
      "text": "1) $-6$ \u4e0e $-12$ \u7684\u548c\u52a0\u4e0a 20\uff1b\n2) $2.6$ \u52a0\u4e0a $-1.8$ \u4e0e $5.2$ \u7684\u548c\uff1b\n3) $-10$ \u4e0e $-1.3$ \u7684\u548c\u52a0\u4e0a 5 \u4e0e $-8.7$ \u7684\u548c\uff1b\n4) 11 \u4e0e $-6.5$ \u7684\u548c\u52a0\u4e0a $-3.2$ \u4e0e $-6.8$ \u7684\u548c.",
      "figure_ids": []
    },
    {
      "number": "340",
      "text": "\u5728 $-8,7.1,-7.1,13,-0.5$ \u5404\u6570\u4e2d\uff0c\u54ea\u4e2a\u6570\u662f\u65b9\u7a0b $-6+$ $x=-13.1$ \u7684\u6839\uff1f",
      "figure_ids": []
    },
    {
      "number": "341",
      "text": "\u5fc3\u7b97\u51fa\u4e0b\u5217\u65b9\u7a0b\u7684\u6839\uff0c\u5e76\u8fdb\u884c\u9a8c\u7b97\uff1a\n1) $x+(-3)=-11$\uff1b\n2) $-5+a=15$\uff1b\n3) $m+(-12)=2$\uff1b\n4) $3+n=-10$.",
      "figure_ids": []
    },
    {
      "number": "342",
      "text": "\u7537\u5b69\u653e\u7684\u98ce\u7b5d\u5347\u9ad8 23 \u7c73\uff08\u56fe 85\uff09. \u8fc7\u4e86\u4e00\u6bb5\u65f6\u95f4\uff0c\u98ce\u7b5d\u7684\u9ad8\u5ea6\u53d8\u5316\u4e86 5 \u7c73\uff0c\u4ee5\u540e\u53c8\u53d8\u5316\u4e86 $-20$ \u7c73.\u5728\u8fd9\u4e24\u6b21\u53d8\u5316\u4e4b\u540e\uff0c\u98ce\u7b5d\u7684\u9ad8\u5ea6\u662f\u591a\u5c11\u7c73\uff1f",
      "figure_ids": [
        "fig-85"
      ]
    },
    {
      "number": "343",
      "text": "\u6628\u665a\u6e29\u5ea6\u8ba1\u4e0a\u7684\u8bfb\u6570\u662f $7^\\circ\\mathrm{C}$\uff0c\u4e00\u591c\u6c14\u6e29\u53d8\u5316\u4e86$p^\\circ\\mathrm{C}$. \u4eca\u5929\u65e9\u6668\u6c14\u6e29\u662f\u591a\u5c11\u5ea6\uff1f\u5217\u51fa\u5f0f\u5b50\u5e76\u4e14\u6c42\u503c\uff0c\u8bbe $p=4,-7,-9,0,-10,1$.",
      "figure_ids": []
    },
    {
      "number": "344",
      "text": "\u8ba1\u7b97\u4e0b\u5f0f\u7684\u503c\uff1a\n1) $-20+[-7+(-5)]$\uff1b\n2) $-1.2+[-1.3+(-1.4)]$.",
      "figure_ids": []
    },
    {
      "number": "345",
      "text": "\u4f5c\u89d2 $BAC$ \u7b49\u4e8e $50^\\circ$. \u5728 $AB$ \u5c04\u7ebf\u4e0a\u8ddd\u9876\u70b9 7 \u5398\u7c73\u5904\u53d6\u70b9 $K$. \u7528\u5706\u89c4\u5728 $AC$ \u5c04\u7ebf\u4e0a\u627e\u51fa\u8ddd $K$ \u70b9 6 \u5398\u7c73\u7684\u70b9.",
      "figure_ids": []
    },
    {
      "number": "346",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) Alex\u3001Ben\u3001Sam\u4e00\u5757\u6293\u4e86 51 \u6761\u9c88\u9c7c. Sam\u6293\u7684\u9c88\u9c7c\u662fAlex\u7684 2 \u500d\uff0cBen\u6bd4Alex\u591a\u6293 3 \u6761. \u6bcf\u4e2a\u5c0f\u5b69\u5404\u6293\u591a\u5c11\u6761\u9c88\u9c7c\uff1f\n2) \u67d0\u5de5\u5382\u4e09\u4e2a\u8f66\u95f4\u5171\u6709 970 \u4eba. \u7b2c\u4e00\u8f66\u95f4\u4eba\u6570\u662f\u7b2c\u4e8c\u8f66\u95f4\u7684\u4eba\u6570\u7684 2 \u500d. \u7b2c\u4e09\u8f66\u95f4\u6bd4\u7b2c\u4e00\u8f66\u95f4\u591a 20 \u4eba.\u8fd9\u4e2a\u5382\u6bcf\u4e2a\u8f66\u95f4\u5404\u6709\u591a\u5c11\u4eba\uff1f",
      "figure_ids": []
    },
    {
      "number": "347",
      "text": "\u957f\u65b9\u4f53\u7684\u5e95\u662f\u8fb9\u957f 11 \u5398\u7c73\u7684\u6b63\u65b9\u5f62. \u5982\u679c\u957f\u65b9\u4f53\u7684\u4f53\u79ef\u4e3a 2420 \u7acb\u65b9\u5398\u7c73\uff0c\u6c42\u5b83\u7684\u9ad8.",
      "figure_ids": []
    },
    {
      "number": "348",
      "text": "\u6cb9\u6f06 1 \u5e73\u65b9\u7c73\u5730\u677f\u548c\u817b\u7f1d\uff0c\u9700\u8981\uff1a\u5e72\u6027\u6cb9 $0.18$ \u516c\u65a4\uff0c\u8d6d\u77f3\u989c\u6599 $0.099$ \u516c\u65a4\uff0c\u817b\u5b50 $0.00225$ \u516c\u65a4. \u6cb9\u6f06\u9762\u79ef\u4e3a$4.4\\times7.5$ \u7c73\u7684\u623f\u95f4\u7684\u5730\u677f\uff0c\u8981\u591a\u5c11\u6d82\u6599\uff1f\u6240\u5f97\u7ed3\u679c\u4e0d\u8db3\u5341\u5206\u4e4b\u4e00\u516c\u65a4\u7684\u56db\u820d\u4e94\u5165.",
      "figure_ids": []
    },
    {
      "number": "349",
      "text": "\u5316\u7b80\u4e0b\u5217\u5404\u5f0f\uff1a\n1) $3.7x+2.5y+1.6x+4.8y+0.6+0.8$\uff1b\n2) $4.5x+1.9x+0.7x+1.6x+5.7x+0.9$.",
      "figure_ids": []
    },
    {
      "number": "350",
      "text": "\u8ba1\u7b97\uff1a\n1) $[125.3-0.88\\cdot(3.52+2.18)\\cdot1.5]:2.72$\uff1b\n2) $6.5\\cdot[30-8.2\\cdot(5.355+1.395):3.75]$.",
      "figure_ids": []
    },
    {
      "number": "351",
      "text": "\u4f5c\u52a0\u6cd5\uff1a\n1) $17+(-5)$\uff1b\n2) $-21+19$\uff1b\n3) $-8+(-43)$\uff1b\n4) $-0.5+6$\uff1b\n5) $-2.4+(-3.2)$\uff1b\n6) $6.1+(-8.3)$\uff1b\n7) $4.2+(-3.8)$\uff1b\n8) $-5.7+2.9$.",
      "figure_ids": []
    },
    {
      "number": "352",
      "text": "\u628a\u4e0b\u5217\u5404\u6570\u5316\u6210\u4e24\u4e2a\u76f8\u7b49\u52a0\u6570\u7684\u548c\uff1a10\uff0c$-8$\uff0c16\uff0c$-6.8$\uff0c$-5.2$.",
      "figure_ids": []
    },
    {
      "number": "353",
      "text": "\u8bbe\uff1a\n1) $a=-1.6,\\ b=3.2$\uff0c\n2) $a=-2.7,\\ b=1.9$\uff0c\u6c42\u548c $a+b$\u7684\u503c.",
      "figure_ids": []
    },
    {
      "number": "354",
      "text": "\u68ee\u6797\u9762\u79ef 480 \u516c\u9877\uff0c\u6cbc\u6cfd\u9762\u79ef\u6bd4\u68ee\u6797\u9762\u79ef\u5c0f 370 \u516c\u9877.\u8349\u5730\u9762\u79ef\u662f\u6cbc\u6cfd\u9762\u79ef\u7684 5 \u500d. \u8349\u5730\u9762\u79ef\u591a\u5927\uff1f",
      "figure_ids": []
    },
    {
      "number": "355",
      "text": "\u7194\u70bc\u4e86\u4e00\u5757\u4f53\u79ef\u4e3a 15 \u7acb\u65b9\u5398\u7c73\u7684\u94dc\u548c\u4e00\u5757\u4f53\u79ef\u4e3a 10\u7acb\u65b9\u5398\u7c73\u7684\u950c. \u5982\u679c\u6bcf\u7acb\u65b9\u5398\u7c73\u94dc\u7684\u8d28\u91cf\u4e3a $8.9$ \u514b\uff0c\u4e00\u7acb\u65b9\u5398\u7c73\u950c\u7684\u8d28\u91cf\u662f $7.1$ \u514b\uff0c\u90a3\u4e48 1 \u7acb\u65b9\u5398\u7c73\u94dc\u950c\u5408\u91d1\u7684\u8d28\u91cf\u662f\u591a\u5c11\u514b\uff1f\u6240\u5f97\u7ed3\u679c\u5728 $1/10$ \u514b\u4ee5\u4e0b\u7684\u56db\u820d\u4e94\u5165.",
      "figure_ids": []
    },
    {
      "number": "356",
      "text": "\u4e09\u4e2a\u4eba\u9020\u5730\u7403\u536b\u661f\u7684\u8d28\u91cf\u5171\u4e3a $1918.9$ \u516c\u65a4. \u5047\u8bbe\u5df2\u77e5\u7b2c\u4e8c\u4e2a\u536b\u661f\u7684\u8d28\u91cf\u6bd4\u7b2c\u4e00\u4e2a\u91cd $424.7$ \u516c\u65a4\uff0c\u7b2c\u4e09\u4e2a\u7684\u8d28\u91cf\u6bd4\u7b2c\u4e8c\u4e2a\u91cd $818.7$ \u516c\u65a4\uff0c\u6c42\u6bcf\u4e2a\u536b\u661f\u7684\u8d28\u91cf.",
      "figure_ids": []
    },
    {
      "number": "357",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $(x+36.1)\\cdot5.1=245.82$\uff1b\n2) $(m-0.67)\\cdot0.02=0.0152$\uff1b\n3) $(x+24.3):18.3=3.1$\uff1b\n4) $(y-15.7):19.2=4.7$.",
      "figure_ids": []
    }
  ],
