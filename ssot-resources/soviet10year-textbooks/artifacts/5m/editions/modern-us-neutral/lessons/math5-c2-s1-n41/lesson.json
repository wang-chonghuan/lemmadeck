    {
      "kind": "p",
      "text": "只有两个约数（1和这个数本身）的数叫做质数.",
      "id": null,
      "label": null,
      "printed_page": 169,
      "source_refs": [
        "p0178#9"
      ],
      "source_text": "只有两个约数（1和这个数本身）的数叫做质数.",
