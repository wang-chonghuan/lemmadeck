  "exercises": [
    {
      "number": "620",
      "text": "620. \u628a\u4e0d\u542b\u6709\u53d8\u91cf\u7684\u9879\u4ece\u65b9\u7a0b\u7684\u5de6\u8fb9\u79fb\u5230\u53f3\u8fb9\uff1a\n1) $8x+5.9=7x+20$\uff1b\n2) $6x-8=-5x-1.6$.",
      "figure_ids": []
    },
    {
      "number": "621",
      "text": "621. \u628a\u542b\u6709\u53d8\u91cf\u7684\u5404\u9879\u96c6\u4e2d\u5728\u65b9\u7a0b\u7684\u5de6\u8fb9\uff0c\u800c\u628a\u4e0d\u542b\u6709\u53d8\u91cf\u7684\u5404\u9879\u96c6\u4e2d\u5728\u65b9\u7a0b\u7684\u53f3\u8fb9\uff1a\n1) $15y-8=-6y+4.6$\uff1b\n2) $-16y+1.7=2y-1$.",
      "figure_ids": []
    },
    {
      "number": "622",
      "text": "622. \u89e3\u65b9\u7a0b\uff1a\n1) $6x-12=5x+4$\uff1b\n2) $-9a+8=-10a-2$\uff1b\n3) $7m+1=8m+9$\uff1b\n4) $-12m-3=11m-3$\uff1b\n5) $4+25y=6+24y$\uff1b\n6) $11-5x=12-6x$\uff1b\n7) $4y+7=-3+5y$\uff1b\n8) $6-2y=8-3y$.",
      "figure_ids": []
    },
    {
      "number": "623",
      "text": "623. \u6c42\u4e0b\u5217\u65b9\u7a0b\u7684\u6839\uff1a\n1) $5x+3=2x$\uff1b\n2) $-0.4a-14=0.3a$\uff1b\n3) $8x-25=3x+30$\uff1b\n4) $6.9-9m=-5m-33.1$\uff1b\n5) $6k-100=9k-1$\uff1b\n6) $4.7-8x=4.9-10x$\uff1b\n7) $7.3a=1.6a$\uff1b\n8) $-19m=11m$.",
      "figure_ids": []
    },
    {
      "number": "624",
      "text": "624. \u89e3\u65b9\u7a0b\u5e76\u68c0\u9a8c\uff1a\n1) $-40\\cdot(-7x+5)=-1600$\uff1b\n2) $2.1\\cdot(4-6a)=-42$\uff1b\n3) $(-20x-50)\\cdot2=100$\uff1b\n4) $-3\\cdot(2-15x)=-6$.",
      "figure_ids": []
    },
    {
      "number": "625",
      "text": "625. \u7b2c\u4e00\u4e2a\u6876\u91cc\u7684\u725b\u5976\u662f\u7b2c\u4e8c\u6876\u76843\u500d. \u5982\u679c\u628a\u7b2c\u4e00\u4e2a\u6876\u91cc\u7684\u725b\u5976\u5012\u5165\u7b2c\u4e8c\u4e2a\u6876\u91cc20\u5347\uff0c\u5219\u4e24\u4e2a\u6876\u91cc\u7684\u725b\u5976\u76f8\u7b49. \u6bcf\u4e2a\u6876\u91cc\u539f\u6709\u591a\u5c11\u5347\u725b\u5976\uff1f",
      "figure_ids": []
    },
    {
      "number": "626",
      "text": "626. \u7ebf\u6bb5$AB$\u6bd4\u7ebf\u6bb5$CD$\u957f2\u5398\u7c73. \u5982\u679c\u628a\u7ebf\u6bb5$AB$\u589e\u52a010\u5398\u7c73\uff0c\u800c\u628a\u7ebf\u6bb5$CD$\u5ef6\u957f\u5230\u539f\u957f\u76843\u500d\uff0c\u5219\u7ed3\u679c\u76f8\u7b49. \u6c42\u7ebf\u6bb5$AB$\u957f.",
      "figure_ids": []
    },
    {
      "number": "627",
      "text": "627. \u6309\u9876\u70b9\u5750\u6807\uff1a$A(0,5),B(7,7)$\u548c$M(3,0)$\u4f5c\u4e09\u89d2\u5f62$ABM$. \u4f5c\u4e09\u89d2\u5f62$ABM$\u7684\u5173\u4e8e$Ox$\u8f74\u7684\u5bf9\u79f0\u56fe\u5f62$P$\u548c\u56fe\u5f62$P$\u7684\u5173\u4e8e$Oy$\u8f74\u7684\u5bf9\u79f0\u56fe\u5f62$K$. \u56fe\u5f62$K$\u662f\u4e0d\u662f$\\triangle ABM$\u7684\u5173\u4e8e\u5750\u6807\u539f\u70b9\u7684\u5bf9\u79f0\u56fe\u5f62\uff1f",
      "figure_ids": []
    },
    {
      "number": "628",
      "text": "628. \u53bb\u62ec\u53f7\u5e76\u5408\u5e76\u540c\u7c7b\u9879\uff1a\n1) $-3.5\\cdot(3k-2)+2\\cdot(1.3k-1)$\uff1b\n2) $5\\cdot(a-1.7)-2\\cdot(2.7-a)$\uff1b\n3) $4\\cdot(x-1.7)-3\\cdot(1.5-x)$\uff1b\n4) $-2.8\\cdot(2y-3)+3\\cdot(2 1y-1)$. \u7b2c4\u5c0f\u95ee\u539f\u5370\u7cfb\u6570\u4e2d\u6709\u65e0\u6cd5\u786e\u8ba4\u7684\u7a7a\u9699\uff1b\u5148\u5b8c\u6210\u524d\u4e09\u95ee\uff0c\u518d\u8bf4\u660e\u7b2c4\u5c0f\u95ee\u4e0d\u80fd\u786e\u5b9a\u552f\u4e00\u5316\u7b80\u7ed3\u679c\u7684\u539f\u56e0\u3002",
      "figure_ids": []
    },
    {
      "number": "629",
      "text": "629. \u628a\u516c\u56e0\u6570\u63d0\u5230\u62ec\u53f7\u5916\u9762\uff1a\n1) $-5m+10n+15$\uff1b\n2) $6a-3b-12c$\uff1b\n3) $4a-8b+12$\uff1b\n4) $-6z+3y-9x$.",
      "figure_ids": []
    },
    {
      "number": "630",
      "text": "630. \u89e3\u5e94\u7528\u9898\uff1a\n1) \u752865\u7f8e\u5206\u4e70\u4e8619\u5f203\u7f8e\u5206\u548c5\u7f8e\u5206\u7684\u90ae\u7968. 3\u7f8e\u5206\u548c5\u7f8e\u5206\u7684\u90ae\u7968\u5404\u4e70\u4e86\u591a\u5c11\u5f20\uff1f\n2) \u519c\u4e1a\u5408\u4f5c\u793e\u6210\u5458\u4eec\u5728\u4e00\u5e74\u5185\u4e70\u4e8636\u8f86\u4e09\u8f6e\u6469\u6258\u8f66\u548c\u4e24\u8f6e\u6469\u6258\u8f66. \u8fd9\u4e9b\u6469\u6258\u8f66\u5171\u670993\u4e2a\u8f66\u8f6e. \u519c\u4e1a\u5408\u4f5c\u793e\u6210\u5458\u4eec\u4e70\u4e86\u51e0\u8f86\u4e09\u8f6e\u6469\u6258\u8f66\uff0c\u51e0\u8f86\u4e24\u8f6e\u6469\u6258\u8f66\uff1f",
      "figure_ids": []
    },
    {
      "number": "631",
      "text": "631. \u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1) $2\\cdot(3x+5)-3\\cdot(4x-1)$\uff0c\u5f53$x=-4.2,\\ 5.3$\u65f6\uff1b\n2) $-3\\cdot(4-5k)+2\\cdot(3-6k)$\uff0c\u5f53$k=0.13,\\ -0.65$\u65f6.",
      "figure_ids": []
    },
    {
      "number": "632",
      "text": "632. \u6c42\u8bc1\uff0c\u5bf9\u4e8e\u53d8\u91cf\u7684\u4efb\u610f\u503c\uff1a\n1) \u5f0f$5\\cdot(7y-2)-7\\cdot(5y+2)$\u7684\u503c\u7b49\u4e8e$-24$\uff1b\n2) \u5f0f$4\\cdot(8a+3)-8\\cdot(4a-3)$\u7684\u503c\u7b49\u4e8e36.",
      "figure_ids": []
    },
    {
      "number": "633",
      "text": "633. \u89e3\u65b9\u7a0b\uff1a\n1) $-27x+220=-5x$\uff1b\n2) $7a=-310-3a$\uff1b\n3) $-2x+16=5x-19$\uff1b\n4) $25-3b=9-5b$\uff1b\n5) $3+11y=203+y$\uff1b\n6) $3\\cdot(4x-8)=3x-6$\uff1b\n7) $-4-(-x+7)=x+17$\uff1b\n8) $a-32=(a+8)\\cdot(-7)$\uff1b\n9) $12-2\\cdot(x+3)=26$\uff1b\n10) $-5\\cdot(3a+1)-11=-16$.",
      "figure_ids": []
    },
    {
      "number": "634",
      "text": "634. \u8bbe\uff1a$a=-24,b=-4$\uff0c\u6c42$(3a-8b)-(4a+11b)+a$\u7684\u503c.",
      "figure_ids": []
    },
    {
      "number": "635",
      "text": "635. \u8ba1\u7b97\uff1a\n1) $(-0.8\\cdot1.2+1.06):(-0.5)$\uff1b\n2) $(-30.15:15+0.91)\\cdot(-2.4)$.",
      "figure_ids": []
    },
    {
      "number": "636",
      "text": "636. \u4e00\u74f6\u9178\u725b\u5976\u7684\u8d28\u91cf\u662f\u7a7a\u74f6\u76842\u500d. \u5982\u679cMia\u559d\u4e86\u534a\u74f6\u9178\u725b\u5976\uff0c\u5979\u559d\u4e86\u591a\u5c11\u514b\u9178\u725b\u5976\uff1f\u53c2\u7167\u56fe120\u89e3\u9898.",
      "figure_ids": [
        "fig-120"
      ]
    },
    {
      "number": "637",
      "text": "637. \u628a\u4e00\u6bb5\u957f68\u7c73\u7684\u7535\u7ebf\u622a\u6210\u56db\u6bb5\uff0c\u524d\u4e24\u6bb5\u4e00\u6837\u957f\uff0c\u7b2c\u4e09\u6bb5\u662f\u7b2c\u4e00\u6bb5\u76842\u500d\uff0c\u7b2c\u56db\u6bb5\u6bd4\u7b2c\u4e09\u6bb5\u957f3\u7c73. \u6bcf\u6bb5\u5404\u957f\u591a\u5c11\u7c73\uff1f",
