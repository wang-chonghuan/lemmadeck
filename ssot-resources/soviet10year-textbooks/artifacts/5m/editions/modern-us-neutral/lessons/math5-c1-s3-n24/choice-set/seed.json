  "exercises": [
    {
      "number": "435",
      "text": "\u53bb\u6389\u4e0b\u5217\u5404\u5f0f\u4e2d\u7684\u62ec\u53f7\n1) $a+(b+c)$\uff1b\n2) $a+(-b+c)$\uff1b\n3) $a+(b-c)$\uff1b\n4) $a+(-b-c)$.\u8bbe$a=15,b=34,c=-20$\uff0c\u68c0\u9a8c\u6240\u5f97\u7b49\u5f0f.",
      "figure_ids": []
    },
    {
      "number": "436",
      "text": "\u53bb\u6389\u4e0b\u5217\u5404\u5f0f\u4e2d\u7684\u62ec\u53f7\uff1a\n1) $a-(b+c)$\uff1b\n2) $a-(-b+c)$\uff1b\n3) $a-(b-c)$\uff1b\n4) $a-(-b-c)$.\u8bbe$a=-2.1,b=6.1,c=-2.6$\uff0c\u68c0\u9a8c\u6240\u5f97\u7b49\u5f0f.",
      "figure_ids": []
    },
    {
      "number": "437",
      "text": "\u5229\u7528\u56fe100\u76841\u548c2\uff0c\u8bc1\u660e\u4e0b\u5217\u5404\u5bf9\u6570\u662f\u76f8\u53cd\u6570\uff1a\n1) $-a-2$\u548c$a+2$\uff1b\n2) $-a+2$\u548c$a-2$.",
      "figure_ids": [
        "fig-100"
      ]
    },
    {
      "number": "438",
      "text": "\u53bb\u62ec\u53f7\uff1a\n1) $64-(90+100)$\uff1b\n2) $9+(81-16)$\uff1b\n3) $8-(3-60)$\uff1b\n4) $48-(-1.4+a)$\uff1b\n5) $-2.16+(x-5.14)$\uff1b\n6) $-m-(18+a)$.",
      "figure_ids": []
    },
    {
      "number": "439",
      "text": "\u4e00\u8f86\u516c\u5171\u6c7d\u8f66\u4e2d\u6709\u4e58\u5ba250\u4eba.\u5728\u67d0\u7ad9\u4e0a\u8f6611\u4eba\uff0c\u5728\u53e6\u4e00\u7ad9\u4e0b\u8f6618\u4eba.\u8f66\u4e2d\u8fd8\u6709\u591a\u5c11\u4e58\u5ba2\uff1f\u7528\u4e24\u79cd\u65b9\u6cd5\u5217\u5f0f\u89e3\u8fd9\u4e2a\u95ee\u9898.",
      "figure_ids": []
    },
    {
      "number": "440",
      "text": "\u5728\u4e00\u6761\u865a\u6784\u7684\u65c5\u884c\u8def\u7ebf\u4e0a\uff0cMaple City \u548c Bay City \u4e4b\u95f4\u6709 Oak City \u548c River City \u4e24\u5ea7\u57ce\u5e02\uff08\u56fe101\uff09.\u4ece Maple City \u5230 Bay City \u662f1100\u516c\u91cc\uff0c\u4ece Oak City \u5230 Bay City \u662f681\u516c\u91cc\uff0c\u4ece River City \u5230 Oak City \u662f331\u516c\u91cc.\u6c42\u4ece Maple City \u5230 River City \u7684\u8ddd\u79bb.\u7528\u4e24\u79cd\u65b9\u6cd5\u5217\u5f0f\u89e3\u9898.",
      "figure_ids": [
        "fig-101"
      ]
    },
    {
      "number": "441",
      "text": "\u5316\u7b80\u4e0b\u5217\u5404\u5f0f\uff1a\n1) $0.4+(m-22)$\uff1b\n2) $(6-x)+48.7$\uff1b\n3) $-0.16-(4.04-m)$\uff1b\n4) $(16-a)-20.7$\uff1b\n5) $p-(1.4+p)$\uff1b\n6) $-a+(a-1.1)$.",
      "figure_ids": []
    },
    {
      "number": "442",
      "text": "\u53bb\u6389\u4e0b\u5217\u5404\u5f0f\u4e2d\u7684\u62ec\u53f7\uff0c\u518d\u6c42\u503c\uff1a\n1) $-10+7+(10-11)$\uff1b\n2) $4-18-(9-18)$\uff1b\n3) $-2.4+6.5-(-6.5+4-8)$\uff1b\n4) $3+0.7+(3.1-10-2.9)$.",
      "figure_ids": []
    },
    {
      "number": "443",
      "text": "\u5316\u7b80\u4e0b\u5217\u5404\u5f0f\uff1a\n1) $m-(n+m)$\uff1b\n2) $(n+x)-x$\uff1b\n3) $a-(a-b)$\uff1b\n4) $7+(n-7)$\uff1b\n5) $-8.3+(-x+8.3)$\uff1b\n6) $P+(-m+k-p)$\uff1b\n7) $-a-(m-a+p)$\uff1b\n8) $n+(k-a-n)$\uff1b\n9) $-(m-a)-(k+a)$\uff1b\n10) $m-(a+m)-(a-m)$.",
      "figure_ids": []
    },
    {
      "number": "444",
      "text": "\u5316\u7b80\u4e0b\u5f0f\u518d\u6c42\u503c\uff1a$-y-k-(-y+b-m-k)$\uff0c\n1) \u5f53$y=-6.6,b=-8.1,m=5,k=3$\u65f6\uff1b\n2) \u5f53$b=-10.7,m=-22.3$\u65f6.",
      "figure_ids": []
    },
    {
      "number": "445",
      "text": "\u5217\u51fa\u4e0b\u5217\u6bcf\u4e8c\u5f0f\u7684\u5dee\u5e76\u5316\u7b80\uff1a\n1) $-6+15$\u548c$4-6$\uff1b\n2) $m-25$\u548c$25+m$\uff1b\n3) $-3+a$\u548c$a+60.1$\uff1b\n4) $32-n$\u548c$-n+40.7$\uff1b\n5) $m+n$\u548c$k+m$\uff1b\n6) $-a+b$\u548c$b-a$\uff1b\n7) $-P-a$\u548c$k-a$\uff1b\n8) $m$\u548c$-a+m-b$.",
      "figure_ids": []
    },
    {
      "number": "446",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $7.2-(6.2-x)=2.2$\uff1b\n2) $-5+(a-25)=-4$\uff1b\n3) $(x+3)-17=-20$\uff1b\n4) $-(10-b)+23.5=-40.5$.",
      "figure_ids": []
    },
    {
      "number": "447",
      "text": "\u5217\u65b9\u7a0b\u89e3\u5e94\u7528\u9898\uff1a\n1) \u5728\u7b2c\u4e00\u4e2a\u4e66\u67b6\u4e0a\u670942\u672c\u4e66\uff0c\u7b2c\u4e8c\u4e2a\u4e66\u67b6\u4e0a\u670934\u672c\u4e66.\u4ece\u7b2c\u4e8c\u4e2a\u4e66\u67b6\u53d6\u4e0b\u4e86\u51e0\u672c\u4e66\uff0c\u800c\u4ece\u7b2c\u4e00\u4e2a\u4e66\u67b6\u53d6\u4e0b\u7684\u4e66\u7684\u518c\u6570\u540c\u7b2c\u4e8c\u4e2a\u4e66\u67b6\u4e2d\u5269\u4e0b\u7684\u4e66\u7684\u518c\u6570\u76f8\u7b49.\u8fd9\u6837\uff0c\u7b2c\u4e00\u4e2a\u4e66\u67b6\u4e0a\u8fd8\u5269\u4e0b12\u672c\u4e66.\u4ece\u7b2c\u4e8c\u4e2a\u4e66\u67b6\u53d6\u4e0b\u7684\u4e66\u662f\u51e0\u672c\uff1f\n2) \u7b2c\u4e00\u73ed\u670942\u4e2a\u5b66\u751f\uff0c\u7b2c\u4e8c\u73ed\u6bd4\u7b2c\u4e09\u73ed\u5c113\u4e2a\u5b66\u751f.\u5982\u679c\u7b2c\u4e00\u73ed\u548c\u7b2c\u4e8c\u73ed\u5171\u670982\u4e2a\u5b66\u751f\uff0c\u90a3\u4e48\u7b2c\u4e09\u73ed\u6709\u591a\u5c11\u4e2a\u5b66\u751f\uff1f",
      "figure_ids": []
    },
    {
      "number": "448",
      "text": "\u6c42\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1) $4.7-(-5.2)-3.8+(-1.6)+10.1$\uff1b\n2) $27.5+(-8.1)-(-2.6)-4.9+0.7$.",
      "figure_ids": []
    },
    {
      "number": "449",
      "text": "\u6bd4\u8f83\u4e0b\u5217\u4e24\u5f0f\u7684\u5927\u5c0f\uff1a\n1) $|-3.5+2.9|$\u548c$|-3.5|+|2.9|$\uff1b\n2) $|-8.1-0.7|$\u548c$|-8.1|+|0.7|$.",
      "figure_ids": []
    },
    {
      "number": "450",
      "text": "\u53d6\u8ddd\u79bb\u4e3a4\u5398\u7c73\u7684$A,B$\u4e24\u70b9.\u7528\u5706\u89c4\u4f5c\u4e0e\u70b9$A$\u548c\u70b9$B$\u76f8\u8ddd\u90fd\u662f5\u5398\u7c73\u7684\u70b9$M$.\u4f5c\u70b9$M$\u5173\u4e8e\u76f4\u7ebf$AB$\u7684\u5bf9\u79f0\u70b9$P$.",
      "figure_ids": []
    },
    {
      "number": "451",
      "text": "\u53d6\u70b9$A(2,4)$\u548c\u70b9$B(-3,1)$.\u4f5c\u7ebf\u6bb5$AB$\u7684\u5bf9\u79f0\u7ebf\u6bb5\uff1a\n1) \u5173\u4e8e$Ox$\u8f74\uff1b\n2) \u5173\u4e8e$Oy$\u8f74.",
      "figure_ids": []
    },
    {
      "number": "452",
      "text": "\u4e0b\u8868\u4e2d\u5217\u6709\u6d77\u62d4\u9ad8\u5ea6\uff08\u4ee5\u7c73\u8ba1\uff09.\u8fd9\u4e2a\u8868\u4e2d\u7684\u8d1f\u503c\u6709\u4ec0\u4e48\u610f\u4e49\uff1f\u6c42\u4ee5\u91cc\u6d77\u6d77\u9762\u4e3a\u6c34\u5e73\u9762\u65f6\uff0c\u8d1d\u52a0\u5c14\u6e56\u7684\u6700\u5927\u6df1\u5ea6\u548c\u5384\u5c14\u5e03\u9c81\u58eb\u7684\u9ad8\u5ea6.",
      "figure_ids": [
        "tbl-p0108-01"
      ]
    },
    {
      "number": "453",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u5c0f\u8239\u7684\u822a\u901f\u67092\u5c0f\u65f6\u662f5.2\u516c\u91cc/\u5c0f\u65f6\uff0c3\u5c0f\u65f6\u662f6.4\u516c\u91cc/\u5c0f\u65f6\uff0c5\u5c0f\u65f6\u662f5.5\u516c\u91cc/\u5c0f\u65f6.\u6c42\u8239\u5728\u5168\u7a0b\u5185\u7684\u5e73\u5747\u822a\u901f.\n2) \u4e00\u4e2a\u65c5\u884c\u5bb6\u4ee56.3\u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u6b65\u884c2\u5c0f\u65f6\uff0c\u4ee512.6\u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u9a91\u81ea\u884c\u8f663\u5c0f\u65f6\uff0c\u53c8\u4ee59.9\u516c\u91cc/\u5c0f\u65f6\u7684\u901f\u5ea6\u4e58\u8239\u822a\u884c4\u5c0f\u65f6.\u6c42\u65c5\u884c\u5bb6\u7684\u5e73\u5747\u901f\u5ea6.",
      "figure_ids": []
    },
    {
      "number": "454",
      "text": "\u5728\u6570\u8f74\u4e0a\u8868\u793a\u51fa\u4e0b\u5217\u4e0d\u7b49\u5f0f\u89e3\u7684\u96c6\u5408\uff1a\n1) $-3\\leqslant x\\leqslant4$\uff1b\n2) $x\\leqslant-2$\uff1b\n3) $-5\\leqslant x\\leqslant1$\uff1b\n4) $x\\geqslant3$.",
      "figure_ids": []
    },
    {
      "number": "455",
      "text": "\u6309\u4e0b\u5217\u7a0b\u5e8f\u8fdb\u884c\u8ba1\u7b97\uff1a\n1) \u6c42$a=-1.5+6.3\\cdot2$\u548c$b=8.4:2.1+(-2.7)$\u7684\u503c\uff1b\n2) \u6c42$x=a\\cdot b+a-b$\u548c$y=2a-3b$\uff1b\n3) \u6c42$x\\cdot y$.",
      "figure_ids": []
    },
    {
      "number": "456",
      "text": "\u5199\u51fa\u8ba1\u7b97\u7a0b\u5e8f\u5e76\u8fdb\u884c\u8ba1\u7b97\uff1a\n1) $352.8:[(55.27-5.62\\cdot8.5)\\cdot(79.356-7.6\\cdot9.81)]$\uff1b\n2) $361.8:[(19.35-4.74\\cdot2.5)\\cdot(63.351-8.7\\cdot6.73)]$.",
      "figure_ids": []
    },
    {
      "number": "457",
      "text": "\u5316\u7b80\u4e0b\u5217\u5404\u5f0f\uff1a\n1) $x+(y-x)-(y-3)$\uff1b\n2) $-(a-b)-b+(-a-7)$\uff1b\n3) $-(m-n)+(m-7)-n$\uff1b\n4) $(13-x)-(13-y)+x$.",
      "figure_ids": []
    },
    {
      "number": "458",
      "text": "\u5199\u51fa\u4e0b\u5217\u6bcf\u4e24\u5f0f\u7684\u5dee\u5e76\u5316\u7b80\uff1a\n1) $m-13$\u548c$17+m$\uff1b\n2) $a+12$\u548c$15-a$\uff1b\n3) $-c+b$\u548c$b-3-c$\uff1b\n4) $a-b+8$\u548c$8+b$.",
      "figure_ids": []
    },
    {
      "number": "459",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $14-(35+x)=12$\uff1b\n2) $3.3-(x-6.7)=100$.",
      "figure_ids": []
    },
    {
      "number": "460",
      "text": "\u7535\u89c6\u673a\u552e\u4ef7240\u7f8e\u5143.\u964d\u4ef7\u540e\u7684\u4ef7\u683c\u662f204\u7f8e\u5143.\u7535\u89c6\u673a\u7684\u4ef7\u683c\u964d\u4f4e\u4e86\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "461",
      "text": "\u5df2\u77e5\u957f\u65b9\u5f62\u7684\u4e09\u4e2a\u9876\u70b9\u5750\u6807\u662f\uff1a$A(-2,-1),B(-2,3)$\uff0c$C(6,3)$\uff0c\u4f5c\u957f\u65b9\u5f62$ABCD$.\u6c42\u9876\u70b9$D$\u548c\u5bf9\u89d2\u7ebf$AC$\u548c$BD$\u7684\u4ea4\u70b9\u5750\u6807.",
      "figure_ids": []
    },
    {
      "number": "462",
      "text": "\u4f5c\u7aef\u70b9\u5750\u6807\u4e3a$N(1,4)$\u548c$T(3,2)$\u7684\u7ebf\u6bb5$NT$.\u4f5c\u7ebf\u6bb5$NT$\u7684\u5173\u4e8e$Ox$\u8f74\u7684\u5bf9\u79f0\u7ebf\u6bb5$CD$\u4ee5\u53ca\u5173\u4e8e$Oy$\u8f74\u7684\u5bf9\u79f0\u7ebf\u6bb5$AB$.",
      "figure_ids": []
    },
    {
      "number": "463",
      "text": "\u5728\u7eb8\u4e0a\u4f5c\u957f\u65b9\u5f62$ABCD$\u548c\u4e0e\u8fd9\u4e2a\u957f\u65b9\u5f62\u4e0d\u76f8\u4ea4\u7684\u76f4\u7ebf$l$.\u628a\u7eb8\u6cbf\u76f4\u7ebf$l$\u6298\u53e0\u8d77\u6765\uff0c\u5728\u957f\u65b9\u5f62\u7684\u9876\u70b9\u624e\u773c.\u7136\u540e\u628a\u7eb8\u5c55\u5f00\uff0c\u6309\u9488\u773c\u4f5c\u957f\u65b9\u5f62$ABCD$\u7684\u5173\u4e8e\u76f4\u7ebf$l$\u7684\u5bf9\u79f0\u957f\u65b9\u5f62.",
      "figure_ids": []
    }
  ],
  "concepts": [
