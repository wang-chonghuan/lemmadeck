  "exercises": [
    {
      "number": "1201",
      "text": "1201. \u5728\u5730\u4e0a\u4f5c\u4e00\u6761\u76f4\u7ebf. \u5728\u76f4\u7ebf\u4e0a\u53d6\u957f20\u7c73\u300136\u7c73\u300142\u7c73\u7684\u7ebf\u6bb5.",
      "figure_ids": []
    },
    {
      "number": "1202",
      "text": "1202. \u6d4b\u91cf\u4e00\u5757\u957f\u65b9\u5f62\u5730\u5757\u7684\u5468\u957f. \u8ba1\u7b97\u8fd9\u5757\u5730\u5757\u7684\u957f\u548c\u5bbd. \u6c42\u5730\u5757\u7684\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "1203",
      "text": "1203. \u6d4b\u91cf\u6559\u5ba4\u7684\u957f\u548c\u5bbd. \u5b83\u7684\u9762\u79ef\u591a\u5927\uff1f\u6d4b\u91cf\u8fd9\u95f4\u6559\u5ba4\u7684\u9ad8\u5ea6. \u5b83\u7684\u4f53\u79ef\u591a\u5927\uff1f",
      "figure_ids": []
    },
    {
      "number": "1204",
      "text": "1204. \u5728\u56fe195\u4e2d\u753b\u6709\u4e00\u5757\u5730\u7684\u5e73\u9762\u56fe. \u5982\u679c\u8fd9\u4e2a\u5e73\u9762\u56fe\u7684\u6bd4\u4f8b\u5c3a\u662f1:1000\uff0c\u90a3\u4e48\u8fd9\u4e00\u5730\u5757\u7684\u9762\u79ef\u662f\u591a\u5c11\u516c\u4ea9\uff1f",
      "figure_ids": [
        "fig-195"
      ]
    },
    {
      "number": "1205",
      "text": "1205. \u5728\u56fe196\u4e2d\u753b\u6709\u83dc\u56ed\u7684\u5e73\u9762\u56fe. \u6309\u7167\u5e73\u9762\u56fe\u8ba1\u7b97\u9a6c\u94c3\u85af\u3001\u9ec4\u74dc\u548c\u767d\u83dc\u5730\u5404\u662f\u591a\u5c11\u516c\u4ea9\uff08\u5e73\u9762\u56fe\u7684\u6bd4\u4f8b\u5c3a\u4e3a1:1000\uff09\uff1f",
      "figure_ids": [
        "fig-196"
      ]
    },
    {
      "number": "1206",
      "text": "1206. \u4f60\u4eec\u6821\u56ed\u7684\u9762\u79ef\u6709\u591a\u5927\uff1f\u4f5c\u5fc5\u8981\u7684\u6d4b\u91cf\u548c\u8ba1\u7b97.",
      "figure_ids": []
    },
    {
      "number": "1207",
      "text": "1207. \u5229\u7528\u6807\u6746\u548c\u76f4\u89d2\u5668\u5728\u5730\u4e0a\u4f5c\u4e00\u957f\u65b9\u5f62\uff0c\u4f7f\u5b83\u7684\u957f\u4e3a20\u7c73\uff0c\u5bbd\u4e3a15\u7c73.",
      "figure_ids": []
    },
    {
      "number": "1208",
      "text": "1208. \u7528\u6807\u6746\u548c\u76f4\u89d2\u5668\u5728\u5730\u9762\u4e0a\u4f5c\u4e00\u4e2a\u957f\u65b9\u5f62. \u6d4b\u91cf\u6240\u4f5c\u7684\u957f\u65b9\u5f62\u7684\u957f\u548c\u5bbd. \u6d4b\u91cf\u7ed3\u679c\u7cbe\u786e\u5230\u5206\u7c73\uff0c\u5e76\u8ba1\u7b97\u5468\u957f\u548c\u9762\u79ef.",
      "figure_ids": []
    },
    {
      "number": "1209",
      "text": "1209. \u6c42\u4f60\u81ea\u5df1\u7684\u6b65\u957f. \u4e3a\u6b64\u9700\u8981\u7528\u5377\u5c3a\u6216\u5176\u5b83\u6d4b\u91cf\u4eea\u5668\u6d4b\u91cf\u51fa\u5730\u9762\u4e0a\u4e00\u4e2a\u7ebf\u6bb5\u7684\u957f\u5ea6\uff0c\u7136\u540e\u770b\u770b\u5728\u8fd9\u4e2a\u7ebf\u6bb5\u4e0a\u4f60\u8981\u8d70\u591a\u5c11\u6b65\uff0c\u518d\u8ba1\u7b97\u4f60\u6bcf\u6b65\u7684\u5e73\u5747\u957f\u5ea6.",
      "figure_ids": []
    },
    {
      "number": "1210",
      "text": "1210. \u6b65\u6d4b\u4ece\u4f60\u5bb6\u5230\u5b66\u6821\u7684\u8ddd\u79bb\uff0c\u5229\u7528\u5df2\u77e5\u7684\u81ea\u5df1\u6bcf\u6b65\u7684\u957f\u5ea6\u6c42\u51fa\u8fd9\u6bb5\u8ddd\u79bb\uff08\u4ee5\u7c73\u8ba1\uff09.",
      "figure_ids": []
    },
    {
      "number": "1211",
      "text": "1211. \u753b\u51fa\u4f60\u5bb6\u7684\u4e00\u4e2a\u623f\u95f4\u7684\u8fd1\u4f3c\u5e73\u9762\u56fe\uff0c\u6bd4\u4f8b\u5c3a\u4e3a1:50\uff0c\u4ee5\u7c73\u4e3a\u5355\u4f4d\u8fdb\u884c\u6d4b\u91cf.",
      "figure_ids": []
    },
    {
      "number": "1212",
      "text": "1212. \u6d4b\u91cf\u4efb\u610f\u5730\u6bb5\u5e76\u753b\u51fa\u5b83\u7684\u5e73\u9762\u56fe\uff0c\u53d61:250\u7684\u6bd4\u4f8b\u5c3a.",
      "figure_ids": []
    },
    {
      "number": "1213",
      "text": "1213. \u5217\u4e00\u4e2a\u8868\uff0c\u628a\u4f60\u7684\u6b65\u8ddd\u6362\u7b97\u6210\u7c73. \u5728\u4e00\u680f\u5185\u5199\u6b65\u6570\uff0c\u53e6\u4e00\u680f\u5185\u5199\u76f8\u5e94\u7684\u7c73\u6570.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5728\u5730\u9762\u4e0a\u7684\u76f4\u7ebf\u7ebf\u6bb5\u7684\u957f\u5ea6\u7528\u5377\u5c3a\uff08\u56fe189\uff09\u3001\u5e26\u5c3a\uff08\u56fe190\uff09\u6216\u8005\u91ce\u5916\u4e24\u811a\u89c4\u6d4b\u91cf\uff08\u56fe191\uff09. \u5730\u9762\u4e0a\u7ebf\u6bb5\u7684\u957f\u5ea6\u6709\u65f6\u7528\u6b65\u6d4b. \u5f53\u7136\uff0c\u8fd9\u9700\u8981\u9884\u5148\u77e5\u9053\u81ea\u5df1\u4e00\u6b65\u7684\u957f\u5ea6."
    },
    {
      "block": 9,
      "text": "\u4e00\u822c\u5728\u5730\u4e0a\u4e0d\u662f\u50cf\u5728\u7eb8\u4e0a\u4e00\u6837\u5730\u753b\u76f4\u7ebf\u7ebf\u6bb5\uff0c\u800c\u662f\u5728\u5730\u4e0a\u7acb\u4e0a\u4e13\u95e8\u7684\u6807\u6746\u6765\u6807\u793a\u8fd9\u4e00\u7ebf\u6bb5\uff08\u56fe192\uff09. \u5c31\u7528\u7acb\u5728\u5730\u4e0a\u7684\u4e00\u6392\u6807\u6746\u6765\u8868\u793a\u5730\u4e0a\u7684\u76f4\u7ebf\u7ebf\u6bb5\uff08\u53c2\u770b\u56fe192\uff09. \u7528\u8fd9\u6837\u7684\u65b9\u6cd5\u5728\u5730\u4e0a\u4f5c\u76f4\u7ebf\u53eb\u505a\u5b9a\u76f4\u7ebf."
    },
    {
      "block": 12,
      "text": "\u5728\u5730\u9762\u4e0a\u4f5c\u76f4\u89d2\uff0c\u7528\u53eb\u505a\u76f4\u89d2\u5668\u8fd9\u6837\u7684\u5de5\u5177\uff08\u56fe193\uff09. \u5728\u5730\u9762\u4e0a\u4f5c\u76f4\u89d2\u7684\u65b9\u6cd5\u5982\u56fe194\u6240\u793a."
    }
  ],
