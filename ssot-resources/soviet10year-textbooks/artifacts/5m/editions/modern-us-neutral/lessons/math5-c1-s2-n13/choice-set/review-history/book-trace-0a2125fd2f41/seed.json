  "exercises": [
    {
      "number": "198",
      "text": "\u6c42\u4e0b\u5217\u5404\u6570\u7684\u7edd\u5bf9\u503c\uff1a81\uff0c1.3\uff0c$-5.2$\uff0c$-1.5$\uff0c52\uff0c0. \u5206\u522b\u5199\u51fa\u76f8\u5e94\u7684\u7b49\u5f0f.",
      "figure_ids": []
    },
    {
      "number": "199",
      "text": "\u5982\u679c $x=-12.3,12.3,-66,83,75$ \u65f6\uff0c\u6c42 $|x|$ \u5f0f\u7684\u503c.",
      "figure_ids": []
    },
    {
      "number": "200",
      "text": "\u6c42\u4ece\u539f\u70b9\u5230\u4e0b\u5217\u5404\u70b9\u7684\u8ddd\u79bb\uff1a$A(3.7)$\uff0c$B(-7.8)$\uff0c$C(-200)$\uff0c$D(315.6)$\uff0c$E(0)$.",
      "figure_ids": []
    },
    {
      "number": "201",
      "text": "\u8ba1\u7b97\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1) $|-8|-|-5|$\uff1b\n2) $|-10|\\cdot|-15|$\uff1b\n3) $|240|:|-80|$\uff1b\n4) $|-710|+|-290|$.",
      "figure_ids": []
    },
    {
      "number": "202",
      "text": "\u70b9 $A$ \u4f4d\u4e8e\u539f\u70b9\u5de6\u4fa7 5.8 \u4e2a\u5355\u4f4d\uff0c\u70b9 $B$ \u4f4d\u4e8e\u53f3\u4fa7 9.8 \u4e2a\u5355\u4f4d. \u5404\u70b9\u7684\u5750\u6807\u7b49\u4e8e\u51e0\uff1f\u6bcf\u4e2a\u5750\u6807\u7684\u7edd\u5bf9\u503c\u7b49\u4e8e\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "203",
      "text": "\u6c42\u51fa\uff1a\n1) \u7edd\u5bf9\u503c\u7b49\u4e8e 25\uff0c4\uff0c7.4 \u7684\u8d1f\u6570\uff1b\n2) \u7edd\u5bf9\u503c\u7b49\u4e8e 27\uff0c4.8\uff0c11.41 \u7684\u6b63\u6570.",
      "figure_ids": []
    },
    {
      "number": "204",
      "text": "\u5199\u51fa\u7edd\u5bf9\u503c\u4e3a 12\uff0c41\uff0c0 \u7684\u4e24\u4e2a\u76f8\u53cd\u6570.",
      "figure_ids": []
    },
    {
      "number": "205",
      "text": "\u5df2\u77e5 $|a|=7$\uff0c$|-a|$ \u7b49\u4e8e\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "206",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $|x|=9$\uff1b\n2) $|y|=20$\uff1b\n3) $|a|=0$\uff1b\n4) $|m|=-3$.",
      "figure_ids": []
    },
    {
      "number": "207",
      "text": "\u5728\u5927\u62ec\u53f7\u5185\u5199\u51fa\u4e0b\u5217\u4e0d\u7b49\u5f0f\u6574\u6570\u89e3\u7684\u96c6\u5408\uff1a\n1) $|x|<3.9$\uff1b\n2) $|y|\\leqslant3.8$.",
      "figure_ids": []
    },
    {
      "number": "208",
      "text": "\u5982\u679c $-k=-3.5,6.8,-\\frac{3}{4},0$ \u65f6\uff0c\u6c42 $k$ \u7684\u503c.",
      "figure_ids": []
    },
    {
      "number": "209",
      "text": "\u89e3\u65b9\u7a0b\uff1a\n1) $-y=-8.75$\uff1b\n2) $-p=5.11$.",
      "figure_ids": []
    },
    {
      "number": "210",
      "text": "\u89e3\u5e94\u7528\u9898\uff1a\n1) \u4e00\u8f86\u5c0f\u6c7d\u8f66\u548c\u4e00\u8f86\u8f7d\u91cd\u6c7d\u8f66\u4ece\u76f8\u8ddd 280 \u516c\u91cc\u7684\u4e24\u4e2a\u57ce\u5e02\u540c\u65f6\u5f00\u51fa\uff0c\u76f8\u5411\u800c\u884c. \u5c0f\u6c7d\u8f66\u7684\u901f\u5ea6\u4e3a 80 \u516c\u91cc/\u5c0f\u65f6\uff0c\u8f7d\u91cd\u6c7d\u8f66\u7684\u901f\u5ea6\u4e3a\u5c0f\u6c7d\u8f66\u901f\u5ea6\u7684 75%. \u51e0\u5c0f\u65f6\u540e\u4e8c\u8f66\u76f8\u9047\uff1f\n2) \u4e24\u4e2a\u4eba\u9a91\u81ea\u884c\u8f66\u4ece\u76f8\u8ddd 70 \u516c\u91cc\u7684\u4e24\u4e2a\u6751\u5e84\u540c\u65f6\u51fa\u53d1\uff0c\u76f8\u5411\u800c\u884c. \u4e00\u4e2a\u4eba\u9a91\u8f66\u7684\u901f\u5ea6\u4e3a 20 \u516c\u91cc/\u5c0f\u65f6\uff0c\u53e6\u4e00\u4e2a\u4eba\u7684\u901f\u5ea6\u4e3a\u7b2c\u4e00\u4e2a\u4eba\u7684 75%. \u51e0\u5c0f\u65f6\u540e\uff0c\u4e24\u4e2a\u9a91\u81ea\u884c\u8f66\u7684\u4eba\u76f8\u9047\uff1f",
      "figure_ids": []
    },
    {
      "number": "211",
      "text": "\u5728 $4.1a-2.2b$ \u5f0f\u4e2d\uff0c\u4ee5\u5f0f $7.82+1.28$ \u4ee3\u66ff\u5b57\u6bcd $a$\uff0c\u4ee5\u5f0f$6.41-2.36$ \u4ee3\u66ff $b$\uff0c\u6c42\u6240\u5f97\u6570\u5f0f\u7684\u503c.",
      "figure_ids": []
    },
    {
      "number": "212",
      "text": "\u6309\u4e0b\u56fe\u8ba1\u7b97\uff08\u56fe 54\uff09.",
      "figure_ids": [
        "fig-54"
      ]
    },
    {
      "number": "213",
      "text": "\u4e0b\u8868\u5217\u6709 2020\u20142024 \u5e74\u95f4\u67d0\u5dde\u7684\u592a\u9633\u80fd\u53d1\u7535\u91cf\uff08\u4ee5\u767e\u4e07\u5146\u74e6\u65f6\u8ba1\uff09\u5e76\u6ce8\u660e\u4e86\u8fd9\u51e0\u5e74\u5185\u5317\u90e8\u5730\u533a\u7684\u592a\u9633\u80fd\u53d1\u7535\u91cf. \u5217\u8868\u8bf4\u660e\u8fd9\u51e0\u5e74\u5185\u5317\u90e8\u5730\u533a\u7684\u592a\u9633\u80fd\u53d1\u7535\u91cf\u5360\u5168\u5dde\u592a\u9633\u80fd\u53d1\u7535\u91cf\u7684\u767e\u5206\u6bd4.",
      "figure_ids": [
        "tbl-p0054-02"
      ]
    },
    {
      "number": "214",
      "text": "\u5728\u6570\u8f74\u4e0a\u6807\u51fa\u7edd\u5bf9\u503c\u4e3a 3\uff0c8\uff0c1\uff0c2 \u7684\u5404\u6570.",
      "figure_ids": []
    },
    {
      "number": "215",
      "text": "\u5199\u51fa\u80fd\u6ee1\u8db3\u4e0b\u5217\u4e0d\u7b49\u5f0f\u7684\u53d8\u91cf $x$ \u7684\u6574\u6570\u503c\u7684\u96c6\u5408\uff1a\n1) $|x|<5$\uff1b\n2) $|x|\\leqslant6.3$.",
      "figure_ids": []
    },
    {
      "number": "216",
      "text": "\u8ba1\u7b97\u4e0b\u5217\u5404\u5f0f\u7684\u503c\uff1a\n1) $|-817|-|399|$\uff1b\n2) $|-6.8|:|-1.7|$\uff1b\n3) $|-564|+|-299|$\uff1b\n4) $|-24|\\cdot|-125|$.",
      "figure_ids": []
    },
    {
      "number": "217",
      "text": "\u505a\u679c\u9171\u65f6\uff0c\u5728\u4e8c\u4efd\u7cd6\u91cc\u52a0\u4e09\u4efd\uff08\u6309\u91cd\u91cf\u8ba1\uff09\u6d46\u679c. \u5982\u679c\u5df2\u77e5\u716e\u6cb8\u540e\uff0c\u679c\u9171\u7684\u91cd\u91cf\u8981\u51cf\u5c11 $1/3$\uff0c\u90a3\u4e48\u5236\u505a 10 \u516c\u65a4\u679c\u9171\uff0c\u9700\u8981\u7528\u591a\u5c11\u7cd6\u548c\u591a\u5c11\u6d46\u679c\uff1f",
      "figure_ids": []
    },
    {
      "number": "218",
      "text": "\u4e00\u8282\u8bfe 45 \u5206\u949f. \u4f5c\u53e3\u5934\u7ec3\u4e60\u7528\u53bb 9 \u5206\u949f\uff0c\u53e3\u5934\u7ec3\u4e60\u5360\u53bb\u4e00\u8282\u8bfe\u7684\u767e\u5206\u4e4b\u51e0\uff1f",
      "figure_ids": []
    },
    {
      "number": "219",
      "text": "\u8ba1\u7b97 $7.35\\cdot(8-2.4)+(9-3.2)\\cdot6.45$ \u7684\u503c.",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 3,
      "text": "**\u6c42\u6570\u7684\u7edd\u5bf9\u503c\uff0c\u5fc5\u987b\u4ee5\u5355\u4f4d\u7ebf\u6bb5\u5ea6\u91cf\u4ece\u539f\u70b9\u5230\u8fd9\u4e2a\u6570\u7684\u5bf9\u5e94\u70b9\u7684\u8ddd\u79bb.**"
    },
    {
      "block": 4,
      "text": "\u4e00\u4e2a\u6570\u7684\u7edd\u5bf9\u503c\u4e0d\u80fd\u662f\u8d1f\u6570. \u6b63\u6570\u548c\u96f6\u7684\u7edd\u5bf9\u503c\u90fd\u662f\u5b83\u672c\u8eab\uff0c\u800c\u8d1f\u6570\u7684\u7edd\u5bf9\u503c\u662f\u5b83\u7684\u76f8\u53cd\u6570."
    },
    {
      "block": 6,
      "text": "\u7528\u53d8\u91cf\u53ef\u4ee5\u628a\u6570\u7684\u7edd\u5bf9\u503c\u7684\u5b9a\u4e49\u5199\u4f5c\uff1a\n$|a|=\\begin{cases}a,&\\text{\u5f53 }a\\text{ \u4e3a\u6b63\u6570\u6216\u7b49\u4e8e }0\\text{ \u65f6\uff1b}\\\\-a,&\\text{\u5f53 }a\\text{ \u4e3a\u8d1f\u6570\u65f6.}\\end{cases}$"
    }
  ],
