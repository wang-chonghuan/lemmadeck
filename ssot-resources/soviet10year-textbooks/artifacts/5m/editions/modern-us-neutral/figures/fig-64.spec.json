  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/5m/figures/fig-64.png",
      "sha256": "e18a096e3c8db9e95aaf4061b5a849961f9649dd4b9477b9a863ee73823eccff"
