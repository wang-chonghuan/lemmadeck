  "description": "A circle overlaps a square to form a combined region.",
  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/5m/figures/fig-09.png",
      "sha256": "613b9d8dea98733d178af15eae61cc1c1f0efd001d2295790b6011ac8dc7d609"
