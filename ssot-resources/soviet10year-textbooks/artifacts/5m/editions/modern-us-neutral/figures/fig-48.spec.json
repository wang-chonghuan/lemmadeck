  "description": "Two intersecting lines form equal opposite angles.",
  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/5m/figures/fig-48.png",
      "sha256": "43294265650883f6ebd6282cf0803848a07c23f6c49cd1334d7129a9a754337a"
