    },
    "authoritativeText": [
      {
        "lesson": "math5-c1-s2-n10",
        "text": "利用正数和负数不仅可以表示点在数轴上的位置，同时还能表示点在数轴上的移动. 例如把点向右移动 3 个单位，就说是移动 3 个单位，向左移动 3 个单位就说是移动 $-3$ 个单位. 点 $A(1)$ 移动 3 个单位，就变成点 $B(4)$，而点 $A$ 移 $-3$个单位，就变成点 $C(-2)$（图 40）."
      }
    ],
    "inventory": [
      {
        "id": "source-points",
        "description": "Original A=1, C=-2, B=4; same origin and unit scale.",
        "objects": [
          "O",
          "A",
          "B",
          "C"
        ],
        "assertions": [
          "O-to-A",
          "O-to-B",
          "O-to-C"
        ],
        "requires": [
          "pointRelationships"
        ]
      },
      {
        "id": "displacements",
        "description": "Original left/right arrows from A by three units, not from O.",
