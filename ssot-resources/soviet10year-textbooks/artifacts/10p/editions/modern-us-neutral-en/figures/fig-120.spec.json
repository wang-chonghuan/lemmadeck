        "objects": ["variable-plate-top-left", "variable-plate-top-right", "variable-plate-bottom-left", "variable-plate-bottom-right", "variable-top-pin", "variable-bottom-pin", "adjustment-start", "adjustment-end", "variable-upper-plate", "variable-lower-plate", "variable-adjustment", "variable-C"],
