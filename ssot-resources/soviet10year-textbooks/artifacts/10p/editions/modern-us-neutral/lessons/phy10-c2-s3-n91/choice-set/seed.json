      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u8bf7\u9610\u8ff0\u60e0\u66f4\u65af-\u83f2\u6d85\u5c14\u539f\u7406\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u6539\u53d8\u884d\u5c04\u5149\u6805\u7684\u72ed\u7f1d\u6570\u65f6\uff0c\u4fdd\u6301\u5149\u6805\u95f4\u8ddd\u3001\u5165\u5c04\u5149\u7684\u6ce2\u957f\u548c\u5165\u5c04\u65b9\u5411\u4e0d\u53d8\uff0c\u4e3b\u6700\u5927\u503c\u7684\u4f4d\u7f6e\u4e0e\u72ed\u7f1d\u6570\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u81ea\u7136\u5149\u4e0e\u504f\u632f\u5149\u6709\u4ec0\u4e48\u533a\u522b\uff1f",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5. \u5728\u4ec0\u4e48\u60c5\u51b5\u4e0b\uff0c\u51e0\u4f55\u5149\u5b66\u7684\u5b9a\u5f8b\u662f\u8fd1\u4f3c\u6b63\u786e\u7684\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 2,
      "text": "\u5148\u628a\u5149\u7684\u4f20\u64ad\u65b9\u5411\u60f3\u6210\u5411\u524d\u7684\u7bad\u5934\uff0c\u518d\u628a\u5b83\u4e0e\u573a\u7684\u632f\u52a8\u65b9\u5411\u5206\u5f00\u3002\n\u7535\u573a\u5f3a\u5ea6\u77e2\u91cf$\\vec{E}$\u548c\u78c1\u611f\u5e94\u5f3a\u5ea6\u77e2\u91cf$\\vec{B}$\u8868\u793a\u5f53\u5730\u7535\u573a\u3001\u78c1\u573a\u7684\u5927\u5c0f\u548c\u65b9\u5411\uff0c\u77e2\u91cf\u53ef\u4ee5\u60f3\u6210\u5e26\u957f\u5ea6\u7684\u7bad\u5934\u3002\n\u5bf9\u4e8e\u5728\u771f\u7a7a\u4e2d\u4f20\u64ad\u7684\u5e73\u9762\u7535\u78c1\u6ce2\uff0c\u8fd9\u4e24\u652f\u573a\u7bad\u5934\u5f7c\u6b64\u5782\u76f4\uff0c\u4e5f\u90fd\u5782\u76f4\u4e8e\u4f20\u64ad\u65b9\u5411\uff1b\n\n\u539f\u4e66\u63d0\u9192\u53ef\u53c2\u89c1\u7b2c\u4e94\u7ae0\u3002\n\u5728\u901a\u5e38\u7684\u81ea\u7136\u5149\u4e2d\uff0c\u7535\u573a\u5f3a\u5ea6$\\vec{E}$\u548c\u78c1\u611f\u5e94\u5f3a\u5ea6$\\vec{B}$\u7684\u632f\u52a8\u6ca1\u6709\u7a33\u5b9a\u4e0d\u53d8\u7684\u5171\u540c\u53d6\u5411\uff0c\u4ec5\u6709\u4e0d\u540c\u7684\u77ac\u65f6\u53d6\u5411\u8fd8\u4e0d\u8db3\u4ee5\u5224\u5b9a\u975e\u504f\u632f\u5149\u3002\n\u5bf9\u4e8e\u81ea\u7136\u5149\uff0c\u7edf\u8ba1\u4e0a\u5404\u6a2a\u5411\u65b9\u5411\u7684\u5e73\u5747\u5f3a\u5ea6\u76f8\u540c\uff0c\u6b63\u4ea4\u7535\u573a\u5206\u91cf\u4e4b\u95f4\u4e5f\u6ca1\u6709\u7a33\u5b9a\u7684\u76f8\u4f4d\u5173\u7cfb\u3002\n\n\u8fd9\u4e9b\u72ec\u7acb\u7684\u5c0f\u6ce2\u5217\u5f7c\u6b64\u4e0d\u76f8\u5173\uff0c\u53e0\u52a0\u540e\u7684\u5149\u6ca1\u6709\u786e\u5b9a\u7684\u504f\u632f\u6001\u3002\n\u4e0d\u80fd\u53ea\u4f9d\u636e\u7535\u573a\u65b9\u5411\u968f\u65f6\u95f4\u8f6c\u52a8\u6765\u5224\u5b9a\u975e\u504f\u632f\u5149\uff1b\n\u5706\u504f\u632f\u5149\u7684\u65b9\u5411\u4e5f\u4f1a\u8f6c\u52a8\uff0c\u4f46\u5b83\u7684\u6b63\u4ea4\u7535\u573a\u5206\u91cf\u4ecd\u6709\u786e\u5b9a\u7684\u76f8\u4f4d\u5173\u7cfb\uff0c\u6240\u4ee5\u5b83\u4ecd\u662f\u504f\u632f\u5149\u3002\n\n\u8fd9\u4e0d\u662f\u6bcf\u4e00\u65f6\u523b\u90fd\u5728\u6240\u6709\u65b9\u5411\u540c\u65f6\u632f\u52a8\uff0c\u4e5f\u4e0d\u662f\u7535\u573a\u548c\u78c1\u573a\u5404\u81ea\u968f\u610f\u9009\u62e9\u65b9\u5411\uff1b\n\u5728\u6bcf\u4e2a\u5c0f\u6ce2\u5217\u4e2d\uff0c\u5b83\u4eec\u4ecd\u4e92\u76f8\u5782\u76f4\u3002\n\u672c\u8bfe\u628a\u539f\u4e66\u6240\u8bf4\u7684\u504f\u632f\u5149\u5177\u4f53\u7406\u89e3\u4e3a\u5e73\u9762\u504f\u632f\u5149\uff0c\u4e5f\u53eb\u7ebf\u504f\u632f\u5149\uff1b\n\n\u504f\u632f\u8fd8\u6709\u5176\u4ed6\u7c7b\u578b\u3002\n\u5728\u5e73\u9762\u504f\u632f\u5149\u4e2d\uff0c$\\vec{E}$\u6cbf\u56fa\u5b9a\u7684\u6a2a\u5411\u76f4\u7ebf\u5f80\u590d\u53d8\u5316\uff0c$\\vec{B}$\u6cbf\u4e0e\u5b83\u5782\u76f4\u7684\u53e6\u4e00\u6761\u56fa\u5b9a\u6a2a\u5411\u76f4\u7ebf\u5f80\u590d\u53d8\u5316\u3002\n\u5404\u81ea\u7684\u632f\u52a8\u76f4\u7ebf\u4e0e\u4f20\u64ad\u65b9\u5411\u6784\u6210\u56fa\u5b9a\u5e73\u9762\uff0c\u8fd9\u4e24\u4e2a\u5e73\u9762\u4e92\u76f8\u5782\u76f4\u3002\n\n\u56fa\u5b9a\u7684\u662f\u632f\u52a8\u7684\u76f4\u7ebf\uff0c\u4e0d\u662f\u7bad\u5934\u6c38\u8fdc\u671d\u5411\u540c\u4e00\u4fa7\uff1b\n\u573a\u7684\u5927\u5c0f\u548c\u65b9\u5411\u4ecd\u4f1a\u53d8\u5316\u3002\n\u539f\u4e66\u4e3e\u4e86\u56fe104\u4e2d\u7684\u504f\u632f\u6ce2\u4f5c\u4f8b\u5b50\uff0c\u8fd9\u4e2a\u56fe\u53f7\u6307\u5411\u539f\u4e66\uff0c\u4e0d\u662f\u672c\u9875\u7684\u65b0\u63d2\u56fe\u3002"
    }
  ],
