  "exercises": [
    {
      "number": "1",
      "text": "1. \u5728\u5c4b\u5185\u6216\u8857\u4e0a\uff0c\u4f60\u89c2\u5bdf\u5230\u8fc7\u53ef\u80fd\u4e0e\u5171\u632f\u6709\u5173\u7684\u73b0\u8c61\u5417\uff1f\n\u4ece\u771f\u5b9e\u89c2\u5bdf\u4e2d\u9009\u53d6\u4f8b\u5b50\uff0c\u8bf4\u660e\u4ec0\u4e48\u7269\u4f53\u5728\u632f\u52a8\u3001\u53ef\u80fd\u7531\u4ec0\u4e48\u5468\u671f\u6027\u4f5c\u7528\u9a71\u52a8\uff0c\u4ee5\u53ca\u662f\u5426\u6709\u8bc1\u636e\u8868\u660e\u6539\u53d8\u9a71\u52a8\u9891\u7387\u4f1a\u4f7f\u54cd\u5e94\u660e\u663e\u589e\u5f3a\u3002\n\u82e5\u4e0d\u80fd\u6838\u5bf9\u9a71\u52a8\u9891\u7387\u4e0e\u7cfb\u7edf\u7684\u56fa\u6709\u6027\u8d28\uff0c\u5e94\u8bf4\u660e\u4e3a\u4ec0\u4e48\u4e0d\u80fd\u4ec5\u51ed\u770b\u5230\u660e\u663e\u632f\u52a8\u5c31\u65ad\u5b9a\u5171\u632f\u3002\n\u6ca1\u6709\u89c2\u5bdf\u5230\u65f6\u53ef\u4ee5\u5982\u5b9e\u56de\u7b54\uff0c\u4e0d\u8981\u628a\u672a\u89c1\u5230\u7684\u60c5\u51b5\u5199\u6210\u4eb2\u8eab\u89c2\u5bdf\uff0c\u4e5f\u4e0d\u9700\u8981\u4eba\u4e3a\u6fc0\u8d77\u5371\u9669\u7684\u5f3a\u70c8\u632f\u52a8\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u5730\u4e0b\u94c1\u8def\u901a\u9053\u6709\u4e00\u6247\u53ef\u5411\u4e24\u4e2a\u65b9\u5411\u6446\u52a8\u3001\u7531\u5f39\u7c27\u590d\u4f4d\u7684\u95e8\u3002\n\u5728\u6240\u6bd4\u8f83\u7684\u5f00\u95e8\u4f4d\u7f6e\uff0c\u5411\u540c\u4e00\u95e8\u628a\u624b\u65bd\u52a0\u7ea6 $50$ \u725b\u987f\u7684\u9759\u529b\uff0c\u624d\u80fd\u4f7f\u95e8\u4fdd\u6301\u5f00\u7740\u3002\n\u82e5\u65bd\u529b\u7684\u5927\u5c0f\u53ef\u8fbe\u5230 $0.005$ \u725b\u987f\uff0c\u662f\u5426\u53ef\u80fd\u628a\u95e8\u9010\u6b65\u6253\u5f00\uff1f\n\u5ffd\u7565\u5408\u9875\u6469\u64e6\uff0c\u5e76\u5728\u672c\u9898\u7684\u7406\u60f3\u6a21\u578b\u4e2d\u5ffd\u7565\u5176\u4ed6\u8017\u6563\uff0c\u628a\u95e8\u5728\u6240\u8ba8\u8bba\u89d2\u5ea6\u8303\u56f4\u5185\u7684\u5f80\u590d\u8fd0\u52a8\u8fd1\u4f3c\u770b\u4f5c\u7ebf\u6027\u632f\u52a8\uff1b\u95e8\u7684\u7ed3\u6784\u548c\u65bd\u529b\u4f4d\u7f6e\u4fdd\u6301\u4e0d\u53d8\u3002\n\u533a\u5206\u6301\u7eed\u65bd\u52a0\u5f88\u5c0f\u7684\u9759\u529b\uff0c\u4e0e\u6309\u95e8\u7684\u56fa\u6709\u8282\u62cd\u53cd\u590d\u65bd\u52a0\u6709\u52a9\u4e8e\u8fd0\u52a8\u7684\u63a8\u529b\uff0c\u5e76\u8bf4\u660e\u540e\u8005\u4e3a\u4ec0\u4e48\u53ef\u80fd\u9010\u6b21\u8f93\u5165\u80fd\u91cf\u3002\n\u7b54\u6848\u5e94\u8bf4\u660e\u65bd\u529b\u65f6\u673a\u3001\u6301\u7eed\u4f5c\u7528\u548c\u6a21\u578b\u6761\u4ef6\uff0c\u4e0d\u80fd\u7531\u4e24\u4e2a\u529b\u503c\u76f4\u63a5\u65ad\u8a00\u95e8\u4f1a\u7acb\u523b\u6253\u5f00\uff0c\u4e5f\u4e0d\u80fd\u8ba4\u4e3a\u5f88\u5c0f\u7684\u6052\u529b\u80fd\u628a\u95e8\u9759\u6001\u4fdd\u6301\u5728\u539f\u6765\u7684\u5f00\u95e8\u4f4d\u7f6e\u3002\n\u4e0d\u8981\u6c42\u8ba1\u7b97\u672a\u7ed9\u51fa\u7684\u5f00\u542f\u65f6\u95f4\u6216\u5b9e\u9645\u632f\u5e45\uff1b\u5b58\u5728\u8017\u6563\u6216\u975e\u7ebf\u6027\u65f6\uff0c\u4e5f\u4e0d\u80fd\u4fdd\u8bc1\u8fd9\u6837\u7684\u5c0f\u529b\u8db3\u4ee5\u6253\u5f00\u4efb\u610f\u95e8\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u5728\u4ec0\u4e48\u6761\u4ef6\u4e0b\uff0c\u632f\u52a8\u7cfb\u7edf\u7684\u5171\u632f\u54cd\u5e94\u6700\u660e\u663e\uff1f\n\u5728\u9a71\u52a8\u5f3a\u5ea6\u548c\u4f5c\u7528\u65b9\u5f0f\u53ef\u6bd4\u8f83\u3001\u54cd\u5e94\u8fd1\u4f3c\u7ebf\u6027\u7684\u6761\u4ef6\u4e0b\uff0c\u8bf4\u660e\u963b\u5c3c\u5927\u5c0f\u3001\u9a71\u52a8\u9891\u7387\u4e0e\u76f8\u5e94\u56fa\u6709\u9891\u7387\u7684\u63a5\u8fd1\u7a0b\u5ea6\uff0c\u4ee5\u53ca\u5916\u529b\u80fd\u5426\u6709\u6548\u6fc0\u8d77\u8be5\u632f\u52a8\u65b9\u5f0f\u600e\u6837\u5f71\u54cd\u54cd\u5e94\u3002\n\u533a\u5206\u7a33\u5b9a\u54cd\u5e94\u4e0e\u53ea\u6301\u7eed\u5f88\u77ed\u65f6\u95f4\u7684\u63a8\u52a8\uff0c\u4e0d\u8981\u628a\u7406\u60f3\u65e0\u963b\u5c3c\u6a21\u578b\u4e2d\u6301\u7eed\u5171\u632f\u6fc0\u52b1\u7684\u7ed3\u679c\u5f53\u4f5c\u6240\u6709\u5b9e\u9645\u7cfb\u7edf\u7684\u89c4\u5f8b\u3002\n\u540c\u65f6\u8bf4\u660e\u201c\u54cd\u5e94\u660e\u663e\u201d\u4e3a\u4ec0\u4e48\u4e0d\u7b49\u4e8e\u201c\u5fc5\u5b9a\u635f\u574f\u201d\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u4e3e\u51fa\u8bfe\u6587\u4e2d\u672a\u63d0\u8fc7\u7684\u81ea\u632f\u7cfb\u7edf\u5b9e\u4f8b\u3002\n\u8bf4\u660e\u8be5\u7cfb\u7edf\u7684\u80fd\u6e90\u6765\u81ea\u54ea\u91cc\uff0c\u54ea\u4e9b\u90e8\u5206\u628a\u632f\u52a8\u72b6\u6001\u53cd\u9988\u7ed9\u8865\u80fd\u8fc7\u7a0b\uff0c\u4ee5\u53ca\u600e\u6837\u5728\u5408\u9002\u7684\u65f6\u673a\u8865\u507f\u8017\u6563\u3002\n\u8fd8\u8981\u8bf4\u660e\u5b83\u4e3a\u4ec0\u4e48\u4e0d\u9700\u8981\u7531\u5916\u754c\u72ec\u7acb\u89c4\u5b9a\u8282\u62cd\u7684\u5468\u671f\u6027\u9a71\u52a8\u529b\u3002\n\u4ec5\u4ec5\u6709\u80fd\u6e90\u6216\u80fd\u53cd\u590d\u8fd0\u52a8\uff0c\u4e0d\u8db3\u4ee5\u628a\u4e00\u4e2a\u88c5\u7f6e\u8ba4\u5b9a\u4e3a\u81ea\u632f\u7cfb\u7edf\u3002",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5. \u81ea\u632f\u3001\u53d7\u8feb\u632f\u52a8\u548c\u81ea\u7531\u632f\u52a8\u6709\u4ec0\u4e48\u533a\u522b\uff1f\n\u4ece\u6709\u6ca1\u6709\u6301\u7eed\u8865\u80fd\u3001\u8282\u62cd\u7531\u8c01\u63a7\u5236\u3001\u9891\u7387\u548c\u632f\u5e45\u600e\u6837\u786e\u5b9a\u7b49\u65b9\u9762\u6bd4\u8f83\uff0c\u5e76\u533a\u5206\u5f00\u59cb\u65f6\u7684\u8fc7\u6e21\u8fc7\u7a0b\u4e0e\u7a33\u5b9a\u5de5\u4f5c\u72b6\u6001\u3002\n\u8bf4\u660e\u81ea\u632f\u4e2d\u53cd\u9988\u8865\u80fd\u4e0e\u5916\u754c\u7ed9\u5b9a\u5468\u671f\u9a71\u52a8\u529b\u7684\u533a\u522b\uff0c\u4ee5\u53ca\u7a33\u5b9a\u81ea\u632f\u632f\u5e45\u4e0e\u521d\u59cb\u63a8\u52a8\u5927\u5c0f\u7684\u5173\u7cfb\u9700\u8981\u54ea\u4e9b\u6761\u4ef6\u3002\n\u6bd4\u8f83\u6709\u963b\u5c3c\u548c\u7406\u60f3\u65e0\u963b\u5c3c\u7684\u81ea\u7531\u632f\u52a8\uff0c\u89e3\u91ca\u4e3a\u4ec0\u4e48\u4e0d\u80fd\u4ec5\u51ed\u632f\u5e45\u662f\u5426\u8870\u51cf\u6765\u533a\u5206\u8fd9\u4e9b\u632f\u52a8\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u6709\u963b\u529b\u7684\u632f\u52a8\u7cfb\u7edf\u5982\u679c\u53ea\u6709\u4e00\u6b21\u521d\u59cb\u63a8\u52a8\uff0c\u901a\u5e38\u4f1a\u56e0\u8017\u6563\u800c\u4f7f\u81ea\u7531\u632f\u52a8\u9010\u6e10\u8870\u51cf\u3002\n\u8981\u7ef4\u6301\u632f\u52a8\uff0c\u5c31\u5fc5\u987b\u4e0d\u65ad\u4ece\u80fd\u6e90\u8865\u5145\u673a\u68b0\u80fd\u3002\n\u53d7\u8feb\u632f\u52a8\u7531\u5916\u754c\u7ed9\u5b9a\u7684\u968f\u65f6\u95f4\u53d8\u5316\u7684\u529b\u9a71\u52a8\uff1b\n\n\u5468\u671f\u6027\u5916\u529b\u53ef\u4ee5\u5728\u6709\u963b\u5c3c\u7684\u7cfb\u7edf\u4e2d\u7ef4\u6301\u7a33\u5b9a\u7684\u53d7\u8feb\u632f\u52a8\uff0c\u5e76\u4e0d\u8981\u6c42\u963b\u529b\u4e3a\u96f6\u3002\n\u53e6\u4e00\u79cd\u7ef4\u6301\u65b9\u5f0f\u662f\u5728\u7cfb\u7edf\u4e2d\u8bbe\u7f6e\u80fd\u6e90\uff0c\u5e76\u7531\u632f\u52a8\u672c\u8eab\u63a7\u5236\u80fd\u91cf\u8865\u7ed9\u7684\u65f6\u673a\uff0c\u4ee5\u8865\u507f\u8017\u6563\uff0c\u8fd9\u6837\u53ef\u4ee5\u5f62\u6210\u81ea\u632f\u3002\n\u8fd9\u91cc\u8bf4\u201c\u4e0d\u9700\u8981\u5468\u671f\u6027\u5916\u529b\u201d\uff0c\u6307\u4e0d\u9700\u8981\u7531\u5916\u754c\u72ec\u7acb\u89c4\u5b9a\u8282\u62cd\u7684\u5468\u671f\u6027\u9a71\u52a8\u529b\uff0c\u5e76\u4e0d\u8868\u793a\u632f\u52a8\u7269\u4f53\u4e0d\u53d7\u529b\u6216\u7cfb\u7edf\u4e0d\u6d88\u8017\u80fd\u6e90\u3002\n\n\u80fd\u6e90\u53ef\u4ee5\u6765\u81ea\u7cfb\u7edf\u5185\u90e8\u7684\u50a8\u5907\uff0c\u4e5f\u53ef\u4ee5\u7531\u5916\u754c\u6301\u7eed\u4f9b\u7ed9\uff1b\n\u53cd\u9988\u88c5\u7f6e\u51b3\u5b9a\u4ec0\u4e48\u65f6\u5019\u628a\u80fd\u91cf\u4f20\u7ed9\u632f\u52a8\u7269\u4f53\u3002"
    },
    {
      "block": 5,
      "text": "\u7531\u6301\u7eed\u6216\u50a8\u5b58\u7684\u80fd\u6e90\u4f9b\u80fd\uff0c\u7531\u7cfb\u7edf\u81ea\u8eab\u7684\u53cd\u9988\u8c03\u8282\u80fd\u91cf\u8865\u7ed9\uff0c\u5728\u9002\u5f53\u6761\u4ef6\u4e0b\u5f62\u6210\u80fd\u591f\u7ef4\u6301\u7684\u632f\u52a8\uff0c\u79f0\u4e3a\u81ea\u632f\u3002\n\u5176\u5173\u952e\u662f\u4e0d\u9700\u8981\u5916\u754c\u72ec\u7acb\u89c4\u5b9a\u8282\u62cd\u7684\u5468\u671f\u6027\u9a71\u52a8\u529b\uff0c\u800c\u4e0d\u662f\u6ca1\u6709\u4efb\u4f55\u5916\u529b\u3002\n\u8fd9\u91cc\u6cbf\u7528\u539f\u4e66\u201c\u975e\u963b\u5c3c\u632f\u52a8\u201d\u7684\u8bf4\u6cd5\uff0c\u63cf\u8ff0\u632f\u5e45\u4e0d\u6301\u7eed\u8870\u51cf\u7684\u5de5\u4f5c\u72b6\u6001\uff0c\u4e0d\u8868\u793a\u6469\u64e6\u548c\u8017\u6563\u771f\u7684\u4e0d\u5b58\u5728\u3002\n\n\u80fd\u6e90\u548c\u63a7\u5236\u6761\u4ef6\u4e0d\u518d\u6ee1\u8db3\u65f6\uff0c\u632f\u52a8\u4e5f\u53ef\u80fd\u51cf\u5f31\u6216\u505c\u6b62\u3002"
    },
    {
      "block": 6,
      "text": "\u5bf9\u5916\u754c\u7ed9\u5b9a\u7684\u5468\u671f\u6027\u9a71\u52a8\u529b\uff0c\u5728\u8fd9\u91cc\u8ba8\u8bba\u7684\u7a33\u5b9a\u5468\u671f\u54cd\u5e94\u4e2d\uff0c\u53d7\u8feb\u632f\u52a8\u7684\u9891\u7387\u4e0e\u9a71\u52a8\u529b\u9891\u7387\u4e00\u81f4\u3002\n\u5176\u632f\u5e45\u4e0d\u4ec5\u53d6\u51b3\u4e8e\u5916\u529b\u632f\u5e45\uff0c\u8fd8\u53d6\u51b3\u4e8e\u9a71\u52a8\u9891\u7387\u3001\u7cfb\u7edf\u7684\u56fa\u6709\u6027\u8d28\u548c\u963b\u5c3c\uff1b\n\u8d77\u521d\u8fd8\u53ef\u80fd\u53e0\u52a0\u9010\u6e10\u8870\u51cf\u7684\u77ac\u6001\u632f\u52a8\u3002\n\n\u81ea\u632f\u7684\u9891\u7387\u548c\u7a33\u5b9a\u632f\u5e45\u7531\u632f\u5b50\u3001\u80fd\u6e90\u3001\u53cd\u9988\u548c\u8017\u6563\u7684\u5171\u540c\u4f5c\u7528\u786e\u5b9a\uff0c\u4e0d\u80fd\u628a\u80fd\u6e90\u4f9b\u7ed9\u7684\u5f71\u54cd\u6392\u9664\u5728\u201c\u7cfb\u7edf\u672c\u8eab\u7684\u6027\u8d28\u201d\u4e4b\u5916\u3002\n\u82e5\u7cfb\u7edf\u5728\u7ed9\u5b9a\u6761\u4ef6\u4e0b\u5177\u6709\u540c\u4e00\u4e2a\u7a33\u5b9a\u7684\u81ea\u632f\u72b6\u6001\uff0c\u80fd\u8fdb\u5165\u8be5\u72b6\u6001\u7684\u4e0d\u540c\u521d\u59cb\u63a8\u52a8\uff0c\u53ef\u4ee5\u5728\u8fc7\u6e21\u8fc7\u7a0b\u540e\u8d8b\u5411\u76f8\u540c\u7684\u632f\u5e45\u3002\n\u8fd9\u4e0d\u662f\u8bf4\u4efb\u610f\u542f\u52a8\u6761\u4ef6\u90fd\u4e00\u5b9a\u5f15\u8d77\u81ea\u632f\uff0c\u4e5f\u4e0d\u662f\u8bf4\u6240\u6709\u81ea\u632f\u7cfb\u7edf\u90fd\u53ea\u6709\u4e00\u4e2a\u53ef\u80fd\u7684\u632f\u5e45\u3002\n\n\u81ea\u7531\u632f\u52a8\u6ca1\u6709\u6301\u7eed\u8865\u7ed9\u673a\u68b0\u80fd\uff0c\u6709\u963b\u5c3c\u65f6\u4f1a\u9010\u6e10\u8870\u51cf\uff1b\n\u65e0\u963b\u5c3c\u7406\u60f3\u81ea\u7531\u632f\u52a8\u5219\u53ef\u4ee5\u4fdd\u6301\u632f\u5e45\uff0c\u56e0\u6b64\u201c\u4e0d\u8870\u51cf\u201d\u672c\u8eab\u4e0d\u80fd\u533a\u5206\u81ea\u7531\u632f\u52a8\u548c\u81ea\u632f\u3002\n\u81ea\u7531\u632f\u52a8\u7684\u80fd\u91cf\u548c\u632f\u5e45\u7531\u521d\u59cb\u6761\u4ef6\u51b3\u5b9a\uff0c\u4e0e\u81ea\u632f\u4e2d\u6301\u7eed\u4f9b\u80fd\u5e76\u8d8b\u5411\u7a33\u5b9a\u5de5\u4f5c\u72b6\u6001\u7684\u60c5\u5f62\u4e0d\u540c\u3002"
    },
    {
      "block": 8,
      "text": "\u56de\u987e\u672c\u7ae0\u8ba8\u8bba\u7684\u5468\u671f\u6027\u673a\u68b0\u632f\u52a8\uff0c\u9664\u4e86\u4efb\u4e00\u65f6\u523b\u7684\u4f4d\u7f6e\u4e0e\u901f\u5ea6\uff0c\u8fd8\u8981\u628a\u63e1\u632f\u5e45\u3001\u5468\u671f\u548c\u9891\u7387\u7b49\u8868\u5f81\u6574\u4f53\u8fc7\u7a0b\u7684\u91cf\u3002\n\u5bf9\u5728\u4e07\u6709\u5f15\u529b\u4f5c\u7528\u4e0b\u8fd0\u52a8\u7684\u5b87\u5b99\u98de\u8239\u6216\u884c\u661f\uff0c\u4e5f\u53ef\u4ee5\u7814\u7a76\u4efb\u4e00\u65f6\u523b\u7684\u4f4d\u7f6e\u4e0e\u901f\u5ea6\uff1b\n\u632f\u52a8\u7814\u7a76\u5e76\u4e0d\u662f\u653e\u5f03\u8fd9\u4e9b\u8fd0\u52a8\u91cf\uff0c\u800c\u662f\u7740\u91cd\u8ba4\u8bc6\u53cd\u590d\u8fd0\u52a8\u7684\u5171\u540c\u89c4\u5f8b\u3002\n\n\u81ea\u7531\u3001\u53d7\u8feb\u548c\u81ea\u632f\u7cfb\u7edf\u90fd\u53ef\u4ee5\u4ece\u56de\u590d\u4f5c\u7528\u3001\u60ef\u6027\u3001\u80fd\u91cf\u4e0e\u8017\u6563\u7b49\u65b9\u9762\u6bd4\u8f83\uff0c\u4f46\u5b83\u4eec\u7684\u8865\u80fd\u65b9\u5f0f\u4e0e\u8282\u62cd\u6765\u6e90\u4e0d\u540c\u3002\n\u7814\u7a76\u53d7\u8feb\u632f\u52a8\u65f6\uff0c\u8fd8\u8981\u6bd4\u8f83\u9a71\u52a8\u529b\u9891\u7387\u4e0e\u56fa\u6709\u9891\u7387\uff0c\u5e76\u8bf4\u660e\u9a71\u52a8\u5f3a\u5ea6\u548c\u963b\u5c3c\u7b49\u6761\u4ef6\uff0c\u4e0d\u80fd\u53ea\u7528\u9891\u7387\u6bd4\u5c31\u51b3\u5b9a\u6240\u6709\u54cd\u5e94\u7684\u5f3a\u5f31\u3002\n\u632f\u5e45\u548c\u5468\u671f\u7684\u610f\u4e49\u4e5f\u8981\u7ed3\u5408\u6761\u4ef6\u8bf4\u660e\uff1a\u963b\u5c3c\u8fc7\u7a0b\u4e2d\u632f\u5e45\u4f1a\u53d8\u5316\uff0c\u7a33\u5b9a\u5de5\u4f5c\u72b6\u6001\u4e0e\u521d\u59cb\u8fc7\u6e21\u8fc7\u7a0b\u4e0d\u80fd\u6df7\u5728\u4e00\u8d77\u3002"
    }
  ],
