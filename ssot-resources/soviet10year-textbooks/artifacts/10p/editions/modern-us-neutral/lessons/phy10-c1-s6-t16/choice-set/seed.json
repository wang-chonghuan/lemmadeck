  "exercises": [
    {
      "number": "1",
      "text": "1. \u80fd\u5426\u9009\u62e9\u8fd9\u6837\u7684\u53c2\u8003\u7cfb\uff0c\u5728\u8fd9\u4e2a\u53c2\u8003\u7cfb\u4e2d\u8f7d\u6d41\u5bfc\u4f53\u7684\u5468\u56f4\u7a7a\u95f4\u4e2d\u7684\u78c1\u611f\u5e94\u5f3a\u5ea6\u4e3a\u96f6\uff1f\n\u8ba8\u8bba\u65f6\u5e94\u8bf4\u660e\u6240\u91c7\u7528\u7684\u5bfc\u4f53\u7535\u8377\u4e0e\u7535\u6d41\u6a21\u578b\u3001\u53c2\u8003\u7cfb\u7c7b\u578b\uff1b\u5982\u679c\u4ec5\u51ed\u9898\u4e2d\u6761\u4ef6\u4e0d\u80fd\u552f\u4e00\u786e\u5b9a\uff0c\u5c31\u8bf4\u660e\u8fd8\u9700\u8981\u54ea\u4e9b\u6761\u4ef6\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u628a\u53d1\u5c04\u632f\u8361\u5668\u4e0e\u63a5\u6536\u632f\u8361\u5668\u5f7c\u6b64\u5782\u76f4\u653e\u7f6e\uff0c\u5728\u63a5\u6536\u632f\u8361\u5668\u4e2d\u4f1a\u4ea7\u751f\u632f\u8361\u5417\uff1f\n\u8bf7\u8bf4\u660e\u6240\u91c7\u7528\u7684\u632f\u8361\u5668\u6a21\u578b\u548c\u53d1\u5c04\u3001\u63a5\u6536\u88c5\u7f6e\u7684\u76f8\u5bf9\u4f4d\u7f6e\uff0c\u5e76\u6307\u51fa\u7ed3\u8bba\u9002\u7528\u7684\u6761\u4ef6\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u5728\u56fe 120 \u6240\u793a\u7684\u65e0\u7ebf\u7535\u63a5\u6536\u673a\u7ebf\u8def\u4e2d\uff0c$L=2\\times10^{-4}$ \u4ea8\u5229\uff0c\u53ef\u53d8\u7535\u5bb9\u5668\u7684\u7535\u5bb9 $C$ \u53ef\u5728 12 \u5230 450 \u76ae\u6cd5\u62c9\u95f4\u53d8\u5316\u3002\u8fd9\u4e2a\u65e0\u7ebf\u7535\u63a5\u6536\u673a\u63a5\u6536\u7684\u6ce2\u957f\u662f\u591a\u5927\uff1f",
      "figure_ids": [
        "fig-120"
      ]
    },
    {
      "number": "4",
      "text": "4. \u56fe 127 \u6240\u793a\u4e3a\u7535\u89c6\u63a5\u6536\u5929\u7ebf\u3002\u5bf9\u4ece\u7535\u89c6\u4e2d\u5fc3\u53d1\u51fa\u7684\u6ce2\u7684\u78c1\u611f\u5e94\u5f3a\u5ea6\u77e2\u91cf\u7684\u632f\u52a8\u65b9\u5411\u53ef\u4ee5\u505a\u51fa\u4ec0\u4e48\u5224\u65ad\uff1f\n\u53ea\u6839\u636e\u56fe\u4e2d\u786e\u5b9e\u7ed9\u51fa\u7684\u4fe1\u606f\u4f5c\u5224\u65ad\uff1b\u5982\u679c\u9700\u8981\u5173\u4e8e\u5165\u5c04\u6ce2\u3001\u4f20\u64ad\u65b9\u5411\u6216\u5929\u7ebf\u5339\u914d\u7684\u989d\u5916\u5047\u8bbe\uff0c\u5e94\u628a\u5047\u8bbe\u548c\u7531\u6b64\u5f97\u5230\u7684\u7ed3\u8bba\u5206\u522b\u8bf4\u660e\u3002",
      "figure_ids": [
