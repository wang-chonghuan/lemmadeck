  "exercises": [
    {
      "number": "1",
      "text": "1. \u8d28\u91cf $m=100$ \u514b\u7684\u91cd\u7269\uff0c\u5728\u5f39\u7c27\u529b\u7684\u4f5c\u7528\u4e0b\u4ee5 $\\nu=2$ \u8d6b\u5179\u7684\u9891\u7387\u8fdb\u884c\u81ea\u7531\u7b80\u8c10\u632f\u52a8\u3002\n\u5f39\u7c27\u7684\u652f\u70b9\u56fa\u5b9a\uff0c\u5f39\u7c27\u8d28\u91cf\u548c\u963b\u529b\u53ef\u5ffd\u7565\uff0c\u5f39\u529b\u9075\u5faa\u80e1\u514b\u5b9a\u5f8b\uff1b\u8fd9\u91cc\u7684\u9891\u7387\u6307\u6bcf\u79d2\u5b8c\u6210\u7684\u5b8c\u6574\u632f\u52a8\u6b21\u6570\u3002\n\u6c42\u5f39\u7c27\u7684\u521a\u5ea6 $k$\uff0c\u5e76\u5199\u51fa\u5355\u4f4d\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u539f\u4e66\u4ee5\u5217\u5b81\u683c\u52d2\u4f0a\u6c99\u6377\u592b\u65af\u57fa\u5927\u6559\u5802\u7684\u5927\u949f\u4e3a\u6d4b\u91cf\u573a\u666f\uff0c\u7ed9\u51fa\u7684\u6446\u957f\u4e3a $98$ \u7c73\uff1b\u8fd9\u91cc\u4fdd\u7559\u539f\u4e66\u7684\u5386\u53f2\u540d\u79f0\u548c\u6570\u636e\uff0c\u4e0d\u5c06\u5176\u4f5c\u4e3a\u5bf9\u8be5\u88c5\u7f6e\u73b0\u72b6\u7684\u6d4b\u91cf\u58f0\u660e\u3002\n\u5c06\u6446\u7406\u60f3\u5316\u4e3a\u56fa\u5b9a\u652f\u70b9\u4e0b\u7684\u5c0f\u89d2\u5ea6\u5355\u6446\uff0c\u6446\u7403\u89c6\u4e3a\u8d28\u70b9\uff0c\u60ac\u6302\u90e8\u5206\u7684\u8d28\u91cf\u548c\u7a7a\u6c14\u963b\u529b\u53ef\u5ffd\u7565\uff0c\u6446\u957f\u6307\u652f\u70b9\u5230\u6446\u7403\u8d28\u5fc3\u7684\u8ddd\u79bb\u3002\n\u6c42\u8fd9\u4e2a\u6446\u7684\u5468\u671f\uff0c\u53ef\u7528\u5f53\u5730\u91cd\u529b\u52a0\u901f\u5ea6\u8868\u793a\uff1b\u82e5\u4f5c\u6570\u503c\u4f30\u7b97\uff0c\u5e94\u8bf4\u660e\u6240\u91c7\u7528\u7684\u91cd\u529b\u52a0\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u4e00\u4e2a\u6446\u5b8c\u6210\u632f\u52a8 $n_1=10$\uff0c\u800c\u53e6\u4e00\u4e2a\u6446\u5728\u540c\u4e00\u65f6\u95f4\u5185\u5b8c\u6210\u632f\u52a8 $n_2=6$\u3002\n\u4e24\u4e2a\u6446\u957f\u4e4b\u5dee $\\Delta l=16$ \u5398\u7c73\uff0c\u8fd9\u91cc\u7684\u5dee\u6307\u8f83\u957f\u6446\u957f\u51cf\u53bb\u8f83\u77ed\u6446\u957f\u3002\n\u4e24\u6446\u5747\u5728\u540c\u4e00\u5730\u70b9\u4f5c\u5c0f\u89d2\u5ea6\u81ea\u7531\u632f\u52a8\uff0c\u53ef\u89c6\u4e3a\u963b\u529b\u53ef\u5ffd\u7565\u7684\u7406\u60f3\u5355\u6446\u3002\n\u6c42\u6446\u957f $l_1$ \u53ca $l_2$ \u5404\u4e3a\u591a\u5c11\uff0c\u5b83\u4eec\u5206\u522b\u5bf9\u5e94\u524d\u8ff0\u4e24\u4e2a\u6446\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u5982\u679c\u628a\u540c\u4e00\u4e2a\u6446\u4ece\u5730\u7403\u8868\u9762\u79fb\u5230\u6708\u7403\u8868\u9762\uff0c\u4fdd\u6301\u6446\u957f\u4e0d\u53d8\uff0c\u6446\u7684\u5c0f\u89d2\u5ea6\u632f\u52a8\u5468\u671f\u5c06\u5982\u4f55\u53d8\u5316\uff1f\n\u6309\u539f\u9898\u7ed9\u5b9a\u7684\u8fd1\u4f3c\u6570\u636e\uff0c\u6708\u7403\u7684\u8d28\u91cf\u662f\u5730\u7403\u7684 $\\frac{1}{81}$\uff0c\u5730\u7403\u7684\u534a\u5f84\u662f\u6708\u7403\u7684 $3.7$ \u500d\u3002\n\u5c06\u4e24\u5929\u4f53\u89c6\u4e3a\u7403\u5bf9\u79f0\u7684\u8d28\u91cf\u5206\u5e03\uff0c\u5ffd\u7565\u81ea\u8f6c\u548c\u5730\u5f62\u5bf9\u8868\u9762\u91cd\u529b\u7684\u5f71\u54cd\uff0c\u6446\u7684\u963b\u529b\u53ef\u5ffd\u7565\uff1b\u6c42\u5468\u671f\u53d8\u5316\u7684\u8fd1\u4f3c\u500d\u6570\u3002",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5. \u4f7f\u60ac\u6302\u5728\u957f\u7ef3\u4e0a\u7684\u5c0f\u7403\u504f\u79bb\u5e73\u8861\u4f4d\u7f6e\u4e00\u4e2a\u5f88\u5c0f\u89d2\u5ea6\uff0c\u7136\u540e\u4ece\u9759\u6b62\u91ca\u653e\u5b83\uff1b\u53e6\u4e00\u4e2a\u5c0f\u7403\u4ee5\u96f6\u521d\u901f\u5ea6\u7531\u7ef3\u7684\u60ac\u6302\u70b9\u6cbf\u7ad6\u76f4\u65b9\u5411\u81ea\u7531\u4e0b\u843d\u3002\n\u60ac\u6302\u70b9\u56fa\u5b9a\uff0c\u7ef3\u8f7b\u4e14\u4e0d\u53ef\u4f38\u957f\uff0c\u4e24\u5c0f\u7403\u53ef\u89c6\u4e3a\u8d28\u70b9\uff0c\u5904\u4e8e\u540c\u4e00\u5747\u5300\u91cd\u529b\u573a\uff0c\u5ffd\u7565\u7a7a\u6c14\u963b\u529b\u53ca\u4e24\u7403\u4e4b\u95f4\u7684\u76f8\u4e92\u4f5c\u7528\u3002\n\u5982\u679c\u4e24\u4e2a\u5c0f\u7403\u540c\u65f6\u5f00\u59cb\u8fd0\u52a8\uff0c\u54ea\u4e00\u4e2a\u7403\u9996\u6b21\u5230\u8fbe\u60ac\u6302\u5c0f\u7403\u7684\u5e73\u8861\u4f4d\u7f6e\u8f83\u65e9\uff1f\u8bf4\u660e\u6bd4\u8f83\u7684\u4f9d\u636e\u3002",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "6. \u4f7f\u5f39\u7c27\u4e0a\u7684\u5c0f\u7403\u79bb\u5f00\u5e73\u8861\u4f4d\u7f6e $1$ \u5398\u7c73\u540e\u4ece\u9759\u6b62\u91ca\u653e\uff0c\u5c0f\u7403\u7684\u632f\u52a8\u9891\u7387\u4e3a $\\nu=5$ \u8d6b\u5179\u3002\n\u4ece\u91ca\u653e\u65f6\u523b\u5f00\u59cb\u8ba1\u65f6\uff0c\u95ee\u5728 $2$ \u79d2\u949f\u5185\u5c0f\u7403\u901a\u8fc7\u591a\u5c11\u8def\u7a0b\uff1f\u8fd9\u91cc\u7684\u8def\u7a0b\u6307\u6cbf\u8fd0\u52a8\u8f68\u8ff9\u7d2f\u8ba1\u901a\u8fc7\u7684\u957f\u5ea6\uff0c\u800c\u4e0d\u662f\u8fd9\u6bb5\u65f6\u95f4\u7684\u4f4d\u79fb\u3002\n\u5f39\u7c27\u7684\u652f\u70b9\u56fa\u5b9a\uff0c\u5f39\u529b\u9075\u5faa\u80e1\u514b\u5b9a\u5f8b\uff0c\u5f39\u7c27\u8d28\u91cf\u548c\u632f\u52a8\u963b\u5c3c\u53ef\u5ffd\u7565\u3002",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "7. \u6cbf $OX$ \u8f74\u8fdb\u884c\u7b80\u8c10\u632f\u52a8\u7684\u7269\u4f53\uff0c\u5176\u4f4d\u79fb\u6309 $x=5\\cos2\\pi t$ \u7684\u89c4\u5f8b\u53d8\u5316\u3002\n\u4f4d\u79fb\u4ee5\u5398\u7c73\u8868\u793a\uff0c\u65f6\u95f4\u4ee5\u79d2\u8868\u793a\uff1b\u8fd9\u91cc\u7684\u632f\u52a8\u76f8\u4f4d\u6307\u4f4d\u79fb\u8868\u8fbe\u5f0f\u4e2d\u4f59\u5f26\u51fd\u6570\u7684\u81ea\u53d8\u91cf\u3002\n\u6c42\u901f\u5ea6\u632f\u5e45\uff0c\u5373\u8fd0\u52a8\u4e2d\u7684\u6700\u5927\u901f\u7387\uff0c\u5e76\u6c42\u5f53\u4f4d\u79fb\u7684\u632f\u52a8\u76f8\u4f4d\u7b49\u4e8e $\\frac{5}{6}\\pi$ \u65f6\u901f\u5ea6\u5728\u8f74\u4e0a\u7684\u6295\u5f71\uff0c\u6295\u5f71\u5e94\u4fdd\u7559\u6b63\u8d1f\u53f7\u3002",
      "figure_ids": []
    },
    {
      "number": "8",
      "text": "8. \u8d28\u91cf\u4e3a $200$ \u514b\u7684\u7269\u4f53\uff0c\u5728\u521a\u5ea6\u4e3a $16$ \u725b/\u7c73\u7684\u5f39\u7c27\u4f5c\u7528\u4e0b\uff0c\u5728\u6c34\u5e73\u9762\u4e0a\u81ea\u7531\u632f\u52a8\uff0c\u5176\u632f\u5e45\u4e3a $2$ \u5398\u7c73\u3002\n\u5f39\u7c27\u7684\u53e6\u4e00\u7aef\u56fa\u5b9a\uff0c\u5f39\u529b\u9075\u5faa\u80e1\u514b\u5b9a\u5f8b\uff0c\u5f39\u7c27\u8d28\u91cf\u3001\u6469\u64e6\u548c\u7a7a\u6c14\u963b\u529b\u53ef\u5ffd\u7565\uff1b\u5e73\u8861\u4f4d\u7f6e\u5bf9\u5e94\u5f39\u7c27\u672a\u5f62\u53d8\u7684\u4f4d\u7f6e\u3002\n\u4ee5\u5f39\u7c27\u672a\u5f62\u53d8\u65f6\u7684\u5f39\u6027\u52bf\u80fd\u4e3a\u96f6\uff0c\u5e76\u5c06\u8fd0\u52a8\u4e2d\u4e0d\u53d8\u7684\u91cd\u529b\u52bf\u80fd\u53d6\u4e3a\u96f6\uff1b\u7cfb\u7edf\u80fd\u91cf\u6307\u7269\u4f53\u4e0e\u5f39\u7c27\u7684\u603b\u673a\u68b0\u80fd\uff0c\u91cd\u529b\u548c\u652f\u6301\u529b\u5728\u8be5\u6c34\u5e73\u8fd0\u52a8\u4e2d\u4e0d\u505a\u529f\u3002\n\u6c42\u7269\u4f53\u632f\u52a8\u7684\u5706\u9891\u7387\u3001\u7cfb\u7edf\u80fd\u91cf\u548c\u901f\u5ea6\u632f\u5e45\uff0c\u901f\u5ea6\u632f\u5e45\u6307\u6700\u5927\u901f\u7387\u3002",
      "figure_ids": []
    },
    {
      "number": "9",
      "text": "9. \u4e00\u5c0f\u65b9\u6728\u5757\u6cbf\u7740\u7403\u5f62\u7897\u5e95\u8fdb\u884c\u81ea\u7531\u632f\u52a8\uff08\u56fe $23$\uff09\uff0c\u4e0d\u8ba1\u6469\u64e6\u3002\u5982\u679c\u7897\u5e95\u7684\u66f2\u7387\u534a\u5f84\u4e3a $R$\uff0c\u6728\u5757\u7684\u632f\u52a8\u5468\u671f\u662f\u591a\u5c11\uff1f\n\u7897\u56fa\u5b9a\uff0c\u6728\u5757\u76f8\u5bf9\u4e8e\u7897\u7684\u5c3a\u5bf8\u5f88\u5c0f\uff0c\u53ef\u89c6\u4e3a\u8d28\u70b9\uff0c\u5ffd\u7565\u6728\u5757\u7684\u8f6c\u52a8\u548c\u7a7a\u6c14\u963b\u529b\uff0c\u8fd0\u52a8\u4e2d\u4fdd\u6301\u4e0e\u7897\u9762\u63a5\u89e6\u3002\n\u6728\u5757\u6cbf\u7ecf\u8fc7\u7897\u5e95\u6700\u4f4e\u70b9\u7684\u7ad6\u76f4\u622a\u9762\u6ed1\u52a8\uff0c\u76f8\u5bf9\u4e8e\u6700\u4f4e\u70b9\u7684\u504f\u79bb\u5f88\u5c0f\uff0c\u5bf9\u5e94\u7684\u5706\u5fc3\u89d2\u4e5f\u5f88\u5c0f\u3002\n\u6c42\u8fd9\u4e00\u5c0f\u89d2\u5ea6\u8fd1\u4f3c\u4e0b\u7684\u632f\u52a8\u5468\u671f\uff0c\u53ef\u7528\u5f53\u5730\u91cd\u529b\u52a0\u901f\u5ea6\u8868\u793a\u3002",
      "figure_ids": [
        "fig-23"
      ]
    },
    {
      "number": "10",
      "text": "10. \u6c7d\u8f66\u6cbf\u7740\u8d77\u4f0f\u4e0d\u5e73\u7684\u9053\u8def\u5300\u901f\u884c\u9a76\uff0c\u8def\u4e0a\u76f8\u90bb\u51f8\u8d77\u4e4b\u95f4\u7684\u8ddd\u79bb\u7ea6\u7b49\u4e8e $8$ \u7c73\uff0c\u5404\u51f8\u8d77\u7684\u5f62\u72b6\u76f8\u8fd1\u3002\n\u6c7d\u8f66\u5728\u677f\u7c27\u4e0a\u7684\u81ea\u7531\u632f\u52a8\u5468\u671f\u4e3a $1.5$ \u79d2\u3002\n\u5c06\u6c7d\u8f66\u7684\u7ad6\u76f4\u632f\u52a8\u8fd1\u4f3c\u4e3a\u5c0f\u632f\u5e45\u3001\u5f31\u963b\u5c3c\u7684\u5355\u4e00\u7ebf\u6027\u632f\u52a8\u6a21\u5f0f\uff0c\u6bcf\u7ecf\u8fc7\u4e00\u4e2a\u51f8\u8d77\u4ea7\u751f\u4e00\u6b21\u4e3b\u8981\u6fc0\u52b1\uff0c\u53ea\u8003\u8651\u51f8\u8d77\u901a\u8fc7\u9891\u7387\u800c\u5ffd\u7565\u66f4\u9ad8\u6b21\u8c10\u6ce2\u3002\n\u5728\u8fd9\u4e00\u6a21\u578b\u4e0b\uff0c\u6c7d\u8f66\u4ee5\u591a\u5927\u7684\u8fd1\u4f3c\u901f\u5ea6\u884c\u9a76\u65f6\uff0c\u4f1a\u56e0\u63a5\u8fd1\u5171\u632f\u800c\u4f7f\u7ad6\u76f4\u632f\u52a8\u7279\u522b\u660e\u663e\uff1f\u8bf4\u660e\u6240\u6bd4\u8f83\u7684\u9891\u7387\u3002",
