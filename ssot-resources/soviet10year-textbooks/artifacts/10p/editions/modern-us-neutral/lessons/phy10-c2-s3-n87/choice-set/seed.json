      "text": "4. \u7528\u77f3\u5934\u7838\u900f\u660e\u7684\u51b0\u5757\u4ee5\u540e\uff0c\u4ea7\u751f\u7684\u88c2\u75d5\u6709\u5f69\u8679\u7684\u95ea\u5149\u3002\u8fd9\u662f\u4e3a\u4ec0\u4e48\uff1f",
      "figure_ids": []
