    {
      "number": "5",
      "text": "5. \u6ce2\u957f\u5728\u6c34\u4e2d\u51cf\u5c0f\u5230\u539f\u6765\u7684 $\\frac{1}{n}$\uff08$n$ \u662f\u6c34\u5bf9\u7a7a\u6c14\u7684\u6298\u5c04\u7387\uff09\u3002\u8fd9\u662f\u5426\u610f\u5473\u7740\u6f5c\u6c34\u5458\u5728\u6c34\u4e0b\u7684\u81ea\u7136\u5149\u4e2d\u4e0d\u80fd\u770b\u89c1\u5468\u56f4\u7684\u7269\u4f53\uff1f",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "6. \u5217\u4e3e\u5e72\u6d89\u7684\u4e3b\u8981\u5e94\u7528\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u76f8\u5e72\u5149\u6ce2\u7684\u9891\u7387\u76f8\u540c\uff0c\u76f8\u4f4d\u5dee\u4fdd\u6301\u7a33\u5b9a\uff0c\u4e5f\u5c31\u662f\u632f\u52a8\u4e4b\u95f4\u7684\u5148\u540e\u5173\u7cfb\u4e0d\u968f\u65f6\u95f4\u4e71\u53d8\u3002\n\u628a\u540c\u4e00\u675f\u5149\u5206\u6210\u4e0d\u540c\u7684\u4f20\u64ad\u8def\u5f84\uff0c\u518d\u8ba9\u5b83\u4eec\u76f8\u9047\uff0c\u5c31\u80fd\u4fdd\u6301\u8fd9\u6837\u7684\u5173\u7cfb\u3002\n\n\u5229\u7528\u5e72\u6d89\u8fdb\u884c\u6d4b\u91cf\u7684\u4eea\u5668\u53eb\u5e72\u6d89\u4eea\u3002\n\u5149\u7a0b\u6539\u53d8\u4f1a\u4f7f\u660e\u6697\u6761\u7eb9\u7684\u4f4d\u7f6e\u6539\u53d8\uff0c\u56e0\u6b64\u5e72\u6d89\u4eea\u53ef\u4ee5\u7cbe\u786e\u6d4b\u91cf\u5149\u7684\u6ce2\u957f\u3001\u6c14\u4f53\u7684\u6298\u5c04\u7387\u7b49\u91cf\uff0c\u4e5f\u53ef\u4ee5\u7528\u4e8e\u4e13\u95e8\u7684\u68c0\u9a8c\u3002"
    },
    {
      "block": 6,
      "text": "**\u5149\u5b66\u589e\u900f** \u8981\u89e3\u51b3\u7684\u662f\u5149\u5b66\u73bb\u7483\u8868\u9762\u7684\u53cd\u5c04\u95ee\u9898\u3002\n\u6444\u5f71\u955c\u5934\u3001\u7535\u5f71\u653e\u6620\u673a\u955c\u5934\u3001\u6f5c\u671b\u955c\u7b49\u88c5\u7f6e\u5305\u542b\u900f\u955c\u548c\u68f1\u955c\uff0c\u5149\u4f1a\u4f9d\u6b21\u7ecf\u8fc7\u8bb8\u591a\u8868\u9762\u3002\n\u539f\u4e66\u4e3e\u4f8b\u8bf4\uff0c\u6444\u5f71\u955c\u5934\u7684\u53cd\u5c04\u9762\u8d85\u8fc7 $10$ \u4e2a\uff0c\u6f5c\u6c34\u8247\u6f5c\u671b\u955c\u7684\u53cd\u5c04\u9762\u53ef\u8fbe $40$ \u4e2a\u3002\n\n\u5149\u5782\u76f4\u5165\u5c04\u65f6\uff0c\u6bcf\u4e2a\u8868\u9762\u53ef\u80fd\u53cd\u5c04\u5165\u5c04\u80fd\u91cf\u7684 $5$ \u81f3 $9\\%$\uff0c\u591a\u6b21\u53cd\u5c04\u4f1a\u7d2f\u79ef\u51cf\u5c11\u5411\u524d\u4f20\u64ad\u7684\u5149\u3002\n\u539f\u4e66\u6240\u8ff0\u88c5\u7f6e\u4e2d\uff0c\u6700\u7ec8\u901a\u8fc7\u7684\u5149\u6709\u65f6\u53ea\u5360\u5165\u5c04\u80fd\u91cf\u7684 $10$ \u81f3 $20\\%$\uff0c\u50cf\u4fbf\u4e0d\u591f\u660e\u4eae\u3002\n\n\u53cd\u5c04\u8fd8\u4f1a\u5f71\u54cd\u6e05\u6670\u5ea6\u3002\n\u6709\u4e9b\u5149\u7ecf\u8fc7\u5185\u8868\u9762\u591a\u6b21\u53cd\u5c04\u540e\u53c8\u5411\u524d\u7a7f\u51fa\uff0c\u5374\u4e0d\u518d\u4f1a\u805a\u5230\u6b63\u786e\u7684\u6210\u50cf\u4f4d\u7f6e\uff0c\u800c\u6210\u4e3a\u6742\u6563\u5149\uff0c\u5728\u50cf\u4e0a\u5f62\u6210\u539f\u4e66\u6240\u8bf4\u7684\u201c\u7ff3\u5f71\u201d\u3002"
    },
    {
      "block": 11,
      "text": "\u628a\u8584\u819c\u4e0a\u8868\u9762\u53cd\u5c04\u7684\u5149\u53eb\u6ce2 $1$\uff0c\u4ece\u4e0b\u8868\u9762\u53cd\u5c04\u540e\u8fd4\u56de\u7684\u5149\u53eb\u6ce2 $2$\u3002\n\u4e0b\u8868\u9762\u7684\u53cd\u5c04\u5149\u6bd4\u4e0a\u8868\u9762\u7684\u53cd\u5c04\u5149\u591a\u8d70\u4e86\u5728\u819c\u5185\u5f80\u8fd4\u7684\u8def\uff0c\u5782\u76f4\u5165\u5c04\u65f6\u8fd9\u6bb5\u51e0\u4f55\u8def\u7a0b\u662f $2h$\uff0c\u4e5f\u5c31\u662f\u819c\u539a\u7684\u4e24\u500d\u3002\n\u8fd9\u6bb5\u8def\u662f\u5728\u8584\u819c\u5185\u8d70\u8fc7\u7684\uff0c\u5fc5\u987b\u4e0e\u819c\u5185\u6ce2\u957f\u6bd4\u8f83\uff0c\u4e0d\u80fd\u76f4\u63a5\u4e0e\u771f\u7a7a\u6ce2\u957f\u6bd4\u8f83\u3002\n\n\u819c\u5185\u6ce2\u957f\u8bb0\u4e3a $\\lambda_{\\text{\u819c}}$\uff0c\u771f\u7a7a\u6ce2\u957f\u8bb0\u4e3a $\\lambda$\uff0c\u524d\u8005\u662f\u540e\u8005\u7684 $\\frac{1}{n_{\\text{\u819c}}}$\uff0c\u56e0\u4e3a\u5149\u8fdb\u5165\u8584\u819c\u540e\u9891\u7387\u4e0d\u53d8\u800c\u4f20\u64ad\u901f\u5ea6\u51cf\u5c0f\u3002\n\u9891\u7387\u662f\u6bcf\u79d2\u632f\u52a8\u7684\u6b21\u6570\u3002\n\n\u5149\u7a7f\u8fc7\u9759\u6b62\u7684\u4ecb\u8d28\u4ea4\u754c\u9762\u65f6\uff0c\u9891\u7387\u4fdd\u6301\u4e0d\u53d8\uff0c\u901f\u5ea6\u548c\u6ce2\u957f\u53ef\u4ee5\u6539\u53d8\u3002\n\u6bd4\u8f83\u5355\u8272\u5149\u7684\u989c\u8272\u65f6\uff0c\u8981\u8054\u7cfb\u5b83\u7684\u9891\u7387\uff0c\u4e0d\u80fd\u53ea\u6bd4\u8f83\u5b83\u5728\u4e0d\u540c\u4ecb\u8d28\u4e2d\u7684\u6ce2\u957f\u3002"
    },
    {
      "block": 12,
      "text": "$\\lambda_{\\text{\u819c}}=\\frac{\\lambda}{n_{\\text{\u819c}}}$"
    },
    {
      "block": 14,
      "text": "\u2460 \u7a7a\u6c14\u3001\u8584\u819c\u548c\u73bb\u7483\u6ee1\u8db3 $n_{\\text{\u7a7a}}<n_{\\text{\u819c}}$\uff0c$n_{\\text{\u819c}}<n_{\\text{\u73bb}}$\uff0c\u6240\u4ee5\u8fd9\u4e24\u6b21\u53cd\u5c04\u90fd\u662f\u4ece\u6298\u5c04\u7387\u8f83\u5c0f\u7684\u4ecb\u8d28\u5c04\u5411\u6298\u5c04\u7387\u8f83\u5927\u7684\u4ecb\u8d28\u3002\n\u6bcf\u4e2a\u53cd\u5c04\u6ce2\u5728\u76f8\u5e94\u7684\u53cd\u5c04\u5904\u90fd\u6709 $\\pi$ \u7684\u76f8\u4f4d\u53d8\u5316\uff0c\u4e5f\u5c31\u662f\u632f\u52a8\u7684\u65b9\u5411\u7ffb\u8f6c\u3002\n\u6ce2 $1$ \u548c\u6ce2 $2$ \u90fd\u53d1\u751f\u540c\u6837\u7684\u7ffb\u8f6c\uff0c\u56e0\u6b64\u53cd\u5c04\u672c\u8eab\u6ca1\u6709\u7ed9\u5b83\u4eec\u589e\u52a0\u4e0d\u540c\u7684\u76f8\u4f4d\u53d8\u5316\u3002\n\n\u5728\u8fd9\u91cc\uff0c\u76f8\u5bf9\u76f8\u4f4d\u7531\u591a\u8d70\u7684\u819c\u5185\u8def\u7a0b\u51b3\u5b9a\uff1b\n\u6539\u53d8\u819c\u539a\u5c31\u6539\u53d8\u8fd9\u4e2a\u76f8\u5bf9\u76f8\u4f4d\u3002"
    },
    {
      "block": 16,
      "text": "\u76f8\u4f4d\u53cd\u5411\u8fd8\u4e0d\u591f\uff0c\u53cd\u5c04\u6ce2\u7684\u632f\u5e45\u4e5f\u5f88\u91cd\u8981\u3002\n\u632f\u5e45\u76f8\u7b49\u65f6\uff0c\u540c\u6837\u5927\u5c0f\u7684\u76f8\u53cd\u632f\u52a8\u53ef\u4ee5\u5b8c\u5168\u62b5\u6d88\uff1b\n\u632f\u5e45\u53ea\u662f\u5f88\u63a5\u8fd1\u65f6\uff0c\u53ea\u80fd\u5927\u5e45\u524a\u5f31\uff0c\u4ecd\u4f1a\u7559\u4e0b\u8f83\u5c0f\u7684\u53cd\u5c04\u3002\n\n\u6240\u4ee5\u8bbe\u8ba1\u8584\u819c\u65f6\uff0c\u65e2\u8981\u9009\u539a\u5ea6\u6765\u5b89\u6392\u76f8\u4f4d\uff0c\u4e5f\u8981\u9009\u6298\u5c04\u7387\u6765\u4f7f\u53cd\u5c04\u632f\u5e45\u5c3d\u91cf\u76f8\u7b49\u3002\n\u76f8\u90bb\u4ecb\u8d28\u7684\u6298\u5c04\u7387\u5173\u7cfb\u51b3\u5b9a\u754c\u9762\u53cd\u5c04\u7684\u5f3a\u5f31\uff0c\u56e0\u6b64\u9009\u7528\u5408\u9002\u7684\u8584\u819c\u6750\u6599\u662f\u589e\u900f\u7684\u53e6\u4e00\u9879\u6761\u4ef6\u3002"
    },
    {
      "block": 17,
      "text": "\u767d\u5149\u5305\u542b\u4e0d\u540c\u9891\u7387\u7684\u5149\uff0c\u5404\u79cd\u989c\u8272\u4e0d\u80fd\u90fd\u7528\u540c\u4e00\u5c42\u8584\u819c\u8fbe\u5230\u6700\u5f3a\u7684\u53cd\u5c04\u62b5\u6d88\u3002\n\u516c\u5f0f (7.8) \u4e2d\u6240\u9700\u539a\u5ea6\u968f\u6ce2\u957f\u6539\u53d8\uff0c\u6240\u4ee5\u9488\u5bf9\u67d0\u79cd\u6ce2\u957f\u8bbe\u8ba1\u7684\u8584\u819c\uff0c\u5bf9\u522b\u7684\u6ce2\u957f\u4e0d\u4e00\u5b9a\u540c\u6837\u6709\u6548\u3002\n\u539f\u4e66\u9009\u5149\u8c31\u4e2d\u90e8\u7684\u7eff\u5149\uff0c\u5176\u771f\u7a7a\u6ce2\u957f\u4e3a $\\lambda_{\\text{\u7eff}}=5.5\\times10^{-5}$ \u5398\u7c73\u3002\n\n\u5bf9\u4e8e\u5782\u76f4\u5165\u5c04\u7684\u8fd9\u675f\u7eff\u5149\uff0c\u5728\u53cd\u5c04\u632f\u5e45\u76f8\u7b49\u7684\u7406\u60f3\u6761\u4ef6\u4e0b\uff0c\u53d6\u819c\u539a\u4e3a\u7eff\u5149\u819c\u5185\u6ce2\u957f\u7684 $\\frac{1}{4}$\uff0c\u53ef\u4ee5\u4f7f\u53cd\u5c04\u76f8\u4e92\u62b5\u6d88\uff1b\n\u632f\u5e45\u53ea\u662f\u63a5\u8fd1\u65f6\u5219\u7559\u4e0b\u5f88\u5f31\u7684\u53cd\u5c04\u2460\u3002"
    },
    {
      "block": 20,
      "text": "\u5bf9\u4e8e\u539f\u4e66\u63cf\u8ff0\u7684\u8fd9\u79cd\u7eff\u5149\u589e\u900f\u819c\uff0c\u5149\u8c31\u8fb9\u7f18\u7684\u7ea2\u5149\u548c\u7d2b\u5149\u4e0d\u50cf\u7eff\u5149\u90a3\u6837\u88ab\u663e\u8457\u524a\u5f31\u3002\n\u5269\u4f59\u53cd\u5c04\u5149\u4e2d\u7684\u989c\u8272\u6bd4\u4f8b\u56e0\u6b64\u6539\u53d8\uff0c\u955c\u5934\u8868\u9762\u7684\u53cd\u5149\u53ef\u4ee5\u663e\u51fa\u6de1\u7d2b\u8272\u8c03\u3002\n\u8fd9\u8bf4\u7684\u662f\u6ca1\u6709\u900f\u8fc7\u53bb\u800c\u88ab\u53cd\u5c04\u56de\u6765\u7684\u5149\uff0c\u5e76\u4e0d\u662f\u8bf4\u955c\u5934\u53ea\u8ba9\u7d2b\u5149\u901a\u8fc7\u3002\n\n\u539f\u4e66\u4e5f\u6307\u51fa\uff0c\u7b80\u5355\u3001\u4fbf\u5b9c\u7684\u6444\u5f71\u673a\u955c\u5934\u4e5f\u53ef\u4ee5\u91c7\u7528\u8fd9\u79cd\u589e\u900f\u5904\u7406\u3002\n\u628a\u539f\u4e66\u63cf\u8ff0\u7684\u51b0\u88c2\u75d5\u5f53\u4f5c\u8584\u5c42\u6a21\u578b\u65f6\uff0c\u8981\u4ee5\u88c2\u75d5\u4e2d\u6709\u5f88\u8584\u7684\u7a7a\u6c14\u95f4\u9699\u3001\u5408\u9002\u7684\u7167\u660e\u53ca\u80fd\u76f8\u9047\u7684\u4e24\u675f\u53cd\u5c04\u5149\u4e3a\u524d\u63d0\u3002\n\u5728\u8fd9\u4e9b\u6761\u4ef6\u4e0b\u51fa\u73b0\u5f69\u8272\u53cd\u5149\u662f\u53ef\u80fd\u7684\u89c2\u5bdf\uff0c\u5e76\u4e0d\u610f\u5473\u7740\u6240\u6709\u88c2\u75d5\u90fd\u4f1a\u6709\u5f69\u8679\u95ea\u5149\u3002\n\n\u8fd9\u79cd\u8584\u5c42\u601d\u8def\u4e0d\u80fd\u76f4\u63a5\u7167\u642c\u589e\u900f\u819c\u7684\u539a\u5ea6\u89c4\u5219\u3002\n\u539f\u4e66\u63cf\u8ff0\u7684\u662f\u4e00\u79cd\u89c2\u5bdf\uff0c\u4e0d\u662f\u8981\u6c42\u4f60\u5236\u9020\u88c2\u75d5\u3002"
    },
    {
      "block": 21,
      "text": "\u5149\u4e0e\u5149\u76f8\u4e92\u62b5\u6d88\uff0c\u8bf4\u7684\u662f\u67d0\u4e2a\u65b9\u5411\u4e0a\u7684\u632f\u52a8\u53e0\u52a0\u53d8\u5c0f\uff0c\u5e76\u4e0d\u662f\u5149\u80fd\u88ab\u6d88\u706d\uff0c\u4e5f\u4e0d\u662f\u5e72\u6d89\u672c\u8eab\u628a\u5149\u80fd\u53d8\u6210\u70ed\u3002\n\u5c31\u50cf\u673a\u68b0\u6ce2\u5e72\u6d89\u4e00\u6837\uff0c\u67d0\u5904\u53d8\u6697\u610f\u5473\u7740\u8f83\u5c11\u80fd\u91cf\u4f20\u5230\u90a3\u91cc\uff0c\u80fd\u91cf\u7684\u4f20\u64ad\u5206\u914d\u53d1\u751f\u4e86\u53d8\u5316\u3002\n\u5728\u8fd9\u91cc\u7684\u900f\u660e\u3001\u65e0\u5438\u6536\u7406\u60f3\u6a21\u578b\u4e2d\uff0c\u53cd\u5c04\u51cf\u5c11\u7684\u80fd\u91cf\u8f6c\u800c\u8fdb\u5165\u900f\u5c04\u5149\u3002\n\n\u5bf9\u9009\u5b9a\u6ce2\u957f\uff0c\u82e5\u53cd\u5c04\u5b8c\u5168\u62b5\u6d88\u4e14\u6ca1\u6709\u5176\u4ed6\u635f\u8017\uff0c\u5168\u90e8\u5165\u5c04\u80fd\u91cf\u4fbf\u5411\u524d\u900f\u8fc7\u955c\u5934\uff1b\n\u5b9e\u9645\u88c5\u7f6e\u82e5\u6709\u5438\u6536\u6216\u5176\u4ed6\u635f\u8017\uff0c\u4e0d\u80fd\u4ec5\u51ed\u53cd\u5c04\u5f88\u5f31\u5c31\u65ad\u8a00\u5168\u90e8\u80fd\u91cf\u90fd\u900f\u8fc7\u4e86\u3002"
    }
  ],
