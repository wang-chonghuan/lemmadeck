  },
  "exercises": [
    {
      "number": "1",
      "text": "1. \u5bf9\u7b80\u8c10\u632f\u52a8\uff0c\u4fdd\u6301\u4f4d\u79fb\u632f\u5e45\u4e0d\u53d8\uff0c\u628a\u632f\u52a8\u9891\u7387\u6bd4\u539f\u6765\u201c\u589e\u52a0 $1$ \u500d\u201d\uff0c\u5373\u589e\u5927\u5230\u539f\u6765\u7684\u4e24\u500d\u3002\n\u6c42\u901f\u5ea6\u632f\u5e45\u548c\u52a0\u901f\u5ea6\u632f\u5e45\u5206\u522b\u53d8\u4e3a\u539f\u6765\u7684\u591a\u5c11\u500d\uff0c\u5e76\u8bf4\u660e\u5404\u81ea\u589e\u52a0\u4e86\u591a\u5c11\u500d\u3002\n\u8fd9\u91cc\u6bd4\u8f83\u7684\u662f\u6ee1\u8db3\u7b80\u8c10\u632f\u52a8\u6761\u4ef6\u7684\u8fd0\u52a8\uff0c\u4e0d\u80fd\u53ea\u51ed\u9891\u7387\u6bd4\u8f83\u4efb\u610f\u632f\u52a8\uff1b\u901f\u5ea6\u548c\u52a0\u901f\u5ea6\u7684\u632f\u5e45\u5206\u522b\u6307\u5bf9\u5e94\u91cf\u5927\u5c0f\u7684\u6700\u5927\u503c\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u539f\u4e66\u95ee\uff1a\u201c\u7b80\u8c10\u632f\u52a8\u4e2d\u5f53\u7269\u4f53\u4f4d\u79fb\u51cf\u5c11\u65f6\uff0c\u901f\u5ea6\u548c\u52a0\u901f\u5ea6\u600e\u6837\u53d8\u5316\uff1f\u201d\n\u5148\u5224\u65ad\u8fd9\u53e5\u8bdd\u662f\u5426\u8db3\u4ee5\u7ed9\u51fa\u7edf\u4e00\u7684\u7ed3\u8bba\uff0c\u5e76\u533a\u5206\u5e26\u6b63\u8d1f\u53f7\u7684\u4f4d\u79fb\u51cf\u5c0f\u4e0e\u5230\u5e73\u8861\u4f4d\u7f6e\u7684\u8ddd\u79bb\u51cf\u5c0f\u3002\n\u5728\u4f4d\u79fb\u632f\u5e45\u56fa\u5b9a\u7684\u540c\u4e00\u7b80\u8c10\u8fd0\u52a8\u4e2d\uff0c\u5206\u522b\u8ba8\u8bba\u7269\u4f53\u5411\u5e73\u8861\u4f4d\u7f6e\u8fd0\u52a8\u548c\u79bb\u5f00\u5e73\u8861\u4f4d\u7f6e\u8fd0\u52a8\u7684\u60c5\u5f62\u3002\n\u660e\u786e\u6240\u8ba8\u8bba\u7684\u662f\u901f\u5ea6\u7684\u65b9\u5411\u8fd8\u662f\u901f\u7387\u3001\u52a0\u901f\u5ea6\u7684\u65b9\u5411\u8fd8\u662f\u5927\u5c0f\uff1b\u8bf4\u660e\u4f4d\u79fb\u6240\u5728\u4e00\u4fa7\u548c\u8fd0\u52a8\u5206\u652f\u600e\u6837\u5f71\u54cd\u5224\u65ad\u3002\n\u4e0d\u80fd\u53ea\u7531\u201c\u4f4d\u79fb\u51cf\u5c11\u201d\u5c31\u5047\u5b9a\u901f\u7387\u6216\u52a0\u901f\u5ea6\u7684\u5927\u5c0f\u5177\u6709\u552f\u4e00\u7684\u53d8\u5316\u8d8b\u52bf\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u5e26\u6446\u7684\u949f\u5728\u590f\u5929\u8fd8\u662f\u5728\u51ac\u5929\u8d70\u5f97\u8f83\u5feb\uff1f\n\u6bd4\u8f83\u540c\u4e00\u53f0\u6ca1\u6709\u6e29\u5ea6\u8865\u507f\u7684\u6446\u949f\uff0c\u4ee5\u590f\u5b63\u73af\u5883\u8f83\u6696\u3001\u51ac\u5b63\u73af\u5883\u8f83\u51b7\u4e3a\u6761\u4ef6\uff0c\u5e76\u5047\u8bbe\u6446\u6746\u5177\u6709\u901a\u5e38\u7684\u6b63\u70ed\u81a8\u80c0\u6027\u8d28\u3002\n\u6bcf\u6b21\u6bd4\u8f83\u524d\uff0c\u6446\u6746\u548c\u6446\u7403\u90fd\u5df2\u4e0e\u7a33\u5b9a\u73af\u5883\u8fbe\u5230\u8fd1\u4f3c\u70ed\u5e73\u8861\u3002\n\u91c7\u7528\u6446\u6746\u8d28\u91cf\u53ef\u5ffd\u7565\u3001\u6446\u7403\u53ef\u6309\u8d28\u70b9\u5904\u7406\u7684\u5c0f\u89d2\u5ea6\u5355\u6446\u8fd1\u4f3c\uff0c\u6446\u957f\u53d6\u652f\u70b9\u5230\u6446\u7403\u8d28\u5fc3\u7684\u8ddd\u79bb\uff1b\u652f\u70b9\u6761\u4ef6\u548c\u6240\u5728\u5730\u7684\u91cd\u529b\u6761\u4ef6\u4fdd\u6301\u76f8\u540c\u3002\n\u5ffd\u7565\u5176\u4ed6\u6e29\u5ea6\u5f71\u54cd\u4ee5\u53ca\u9a71\u52a8\u3001\u963b\u5c3c\u5bf9\u8ba1\u65f6\u5468\u671f\u7684\u5fae\u5c0f\u5f71\u54cd\uff0c\u8bf4\u660e\u6e29\u5ea6\u600e\u6837\u6539\u53d8\u6446\u957f\u548c\u5468\u671f\uff0c\u518d\u636e\u6b64\u5224\u65ad\u8d70\u65f6\u5feb\u6162\u3002\n\u4e0d\u80fd\u53ea\u51ed\u5b63\u8282\u540d\u79f0\u5224\u65ad\u5b9e\u9645\u6e29\u5ea6\uff0c\u4e5f\u4e0d\u80fd\u628a\u7ed3\u8bba\u76f4\u63a5\u7528\u4e8e\u6709\u6e29\u5ea6\u8865\u507f\u7684\u6446\u949f\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u539f\u4e66\u7684\u63d0\u95ee\u662f\uff1a\u201c\u4e3a\u4ec0\u4e48\u5f39\u7c27\u4e0a\u7684\u7269\u4f53\u632f\u52a8\u9891\u7387\u4e0e\u5176\u8d28\u91cf\u65e0\u5173\uff1f\u201d\n\u8bf7\u5148\u6279\u5224\u6027\u5224\u65ad\u8fd9\u4e2a\u524d\u63d0\u662f\u5426\u6210\u7acb\uff0c\u4e0d\u8981\u628a\u5176\u4e2d\u7684\u201c\u4e0e\u5176\u8d28\u91cf\u65e0\u5173\u201d\u5f53\u4f5c\u5df2\u77e5\u89c4\u5f8b\u3002\n\u5bf9\u6ee1\u8db3\u80e1\u514b\u5b9a\u5f8b\u7684\u540c\u4e00\u6839\u8f7b\u5f39\u7c27\uff0c\u4fdd\u6301\u5f39\u7c27\u521a\u5ea6\u548c\u652f\u5ea7\u6761\u4ef6\u4e0d\u53d8\uff0c\u6bd4\u8f83\u4e0d\u540c\u8d28\u91cf\u7269\u4f53\u7684\u81ea\u7531\u632f\u52a8\uff1b\u5ffd\u7565\u963b\u529b\u4e0e\u5f39\u7c27\u81ea\u8eab\u7684\u8d28\u91cf\u3002\n\u5229\u7528\u524d\u9762\u5b66\u8fc7\u7684\u5173\u7cfb\uff0c\u8bf4\u660e\u8fd9\u79cd\u7406\u60f3\u5f39\u7c27\u632f\u52a8\u7684\u9891\u7387\u5b9e\u9645\u600e\u6837\u4f9d\u8d56\u7269\u4f53\u8d28\u91cf\uff0c\u5e76\u89e3\u91ca\u539f\u95ee\u9898\u7684\u524d\u63d0\u4e3a\u4ec0\u4e48\u4e0d\u6210\u7acb\u3002\n\u518d\u4e0e\u6446\u957f\u548c\u91cd\u529b\u6761\u4ef6\u76f8\u540c\u7684\u5c0f\u89d2\u5ea6\u7406\u60f3\u5355\u6446\u4f5c\u533a\u5206\uff0c\u8bf4\u660e\u4e0d\u80fd\u628a\u4e24\u7c7b\u7cfb\u7edf\u7684\u8d28\u91cf\u5173\u7cfb\u6df7\u7528\u3002",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5. \u4e24\u4e2a\u6446\u7684\u7403\u534a\u5f84\u3001\u5916\u5f62\u548c\u8868\u9762\u6761\u4ef6\u76f8\u540c\u800c\u8d28\u91cf\u4e0d\u540c\uff0c\u5206\u522b\u60ac\u6302\u5728\u7b49\u957f\u7684\u8f7b\u7ef3\u4e0a\uff0c\u652f\u70b9\u5230\u6446\u7403\u8d28\u5fc3\u7684\u8ddd\u79bb\u4e5f\u76f8\u540c\u3002\n\u4fdd\u6301\u652f\u70b9\u6761\u4ef6\u548c\u7a7a\u6c14\u73af\u5883\u76f8\u540c\uff0c\u5ffd\u7565\u7ef3\u7684\u4f38\u957f\u3001\u652f\u70b9\u6469\u64e6\u548c\u7a7a\u6c14\u6d6e\u529b\u7684\u5f71\u54cd\u3002\n\u6bd4\u8f83\u4e24\u6446\u4ece\u76f8\u540c\u7684\u5c0f\u89d2\u5ea6\u632f\u5e45\u91ca\u653e\u540e\u7684\u81ea\u7531\u632f\u52a8\uff0c\u5047\u8bbe\u7a7a\u6c14\u963b\u529b\u662f\u4e3b\u8981\u8017\u6563\u6765\u6e90\uff0c\u963b\u5c3c\u8f83\u5f31\uff0c\u7269\u4f53\u4ecd\u4f5c\u5f80\u590d\u632f\u52a8\u3002\n\u5728\u6240\u6bd4\u8f83\u7684\u901f\u7387\u8303\u56f4\u5185\uff0c\u5047\u8bbe\u4e24\u7403\u5728\u76f8\u540c\u901f\u7387\u4e0b\u53d7\u5230\u7684\u7a7a\u6c14\u963b\u529b\u8fd1\u4f3c\u76f8\u540c\u3002\n\u95ee\u8f7b\u7403\u548c\u91cd\u7403\u54ea\u4e00\u4e2a\u6446\u7684\u632f\u52a8\u632f\u5e45\u8870\u51cf\u5f97\u8f83\u5feb\uff0c\u5e76\u7528\u963b\u529b\u4f5c\u7528\u4e0e\u60ef\u6027\u7684\u6bd4\u8f83\u89e3\u91ca\u3002\n\u8fd9\u91cc\u6bd4\u8f83\u632f\u5e45\u76f8\u5bf9\u521d\u59cb\u503c\u7684\u8870\u51cf\u5feb\u6162\uff0c\u4e0d\u662f\u8ba4\u5b9a\u67d0\u4e2a\u7cbe\u786e\u505c\u6b62\u65f6\u523b\uff1b\u8bf4\u660e\u4e3a\u4ec0\u4e48\u4e0d\u80fd\u628a\u5224\u65ad\u63a8\u5e7f\u5230\u963b\u529b\u673a\u5236\u3001\u5916\u5f62\u6216\u5176\u4ed6\u6761\u4ef6\u4e0d\u540c\u7684\u4efb\u610f\u4e24\u4e2a\u6446\u3002",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 0,
      "text": "\u5bf9\u524d\u9762\u8ba8\u8bba\u7684\u7406\u60f3\u5f39\u7c27\u7cfb\u7edf\uff0c\u4ee5\u53ca\u5c0f\u89d2\u5ea6\u8fd1\u4f3c\u4e0b\u7684\u6446\uff0c\u5ffd\u7565\u963b\u529b\u65f6\uff0c\u81ea\u7531\u632f\u52a8\u53ef\u4ee5\u7528\u7b80\u8c10\u632f\u52a8\u63cf\u8ff0\u3002\n\u8fd9\u8fd8\u8981\u6c42\u56de\u590d\u4f5c\u7528\u7b26\u5408\u524d\u9762\u91c7\u7528\u7684\u6a21\u578b\uff0c\u4e0d\u80fd\u628a\u201c\u6ca1\u6709\u6469\u64e6\u201d\u5f53\u6210\u4efb\u4f55\u81ea\u7531\u632f\u52a8\u90fd\u662f\u7b80\u8c10\u632f\u52a8\u7684\u5145\u5206\u6761\u4ef6\u3002\n\u5b9e\u9645\u632f\u52a8\u4e2d\u5f80\u5f80\u5b58\u5728\u6469\u64e6\u548c\u7a7a\u6c14\u963b\u529b\u7b49\u963b\u788d\u8fd0\u52a8\u7684\u4f5c\u7528\u3002\n\n\u8fd9\u4e9b\u963b\u529b\u5373\u4f7f\u5f88\u5c0f\uff0c\u4e5f\u4f1a\u9010\u6e10\u6539\u53d8\u632f\u52a8\u7684\u80fd\u91cf\u548c\u632f\u5e45\u3002"
    },
    {
      "block": 1,
      "text": "\u5bf9\u8fd9\u91cc\u6ca1\u6709\u6301\u7eed\u5916\u529b\u9a71\u52a8\u7684\u632f\u52a8\u7cfb\u7edf\uff0c\u963b\u529b\u5bf9\u8fd0\u52a8\u4f5c\u8d1f\u529f\uff0c\u4f7f\u7cfb\u7edf\u7684\u673a\u68b0\u80fd\u9010\u6e10\u8f6c\u5316\u4e3a\u7cfb\u7edf\u548c\u5468\u56f4\u4ecb\u8d28\u7684\u5185\u80fd\u3002\n\u80fd\u91cf\u5e76\u6ca1\u6709\u6d88\u5931\uff0c\u800c\u662f\u53ef\u4ee5\u7528\u4e8e\u5f80\u590d\u8fd0\u52a8\u7684\u673a\u68b0\u80fd\u51cf\u5c11\u4e86\u3002\n\u5f53\u963b\u5c3c\u8f83\u5f31\u3001\u7269\u4f53\u4ecd\u6765\u56de\u901a\u8fc7\u5e73\u8861\u4f4d\u7f6e\u65f6\uff0c\u504f\u79bb\u5e73\u8861\u4f4d\u7f6e\u7684\u6700\u5927\u503c\uff0c\u4e5f\u5c31\u662f\u632f\u5e45\uff0c\u968f\u65f6\u95f4\u9010\u6e10\u51cf\u5c0f\u3002\n\n\u8fd9\u79cd\u6b20\u963b\u5c3c\u8fd0\u52a8\u5c31\u662f\u672c\u8bfe\u56fe\u7ebf\u6240\u8868\u793a\u7684\u963b\u5c3c\u632f\u52a8\u3002\n\u963b\u529b\u8f83\u5927\u65f6\uff0c\u7cfb\u7edf\u4e5f\u53ef\u80fd\u4e0d\u518d\u5f80\u590d\u632f\u52a8\uff0c\u800c\u662f\u76f4\u63a5\u8d8b\u5411\u5e73\u8861\u4f4d\u7f6e\u3002\n\u6240\u4ee5\u4e0d\u80fd\u628a\u6240\u6709\u6709\u963b\u529b\u7684\u8fd0\u52a8\u90fd\u753b\u6210\u632f\u5e45\u9010\u6e10\u7f29\u5c0f\u7684\u6ce2\u5f62\u3002\n\n\u539f\u4e66\u7528\u201c\u673a\u68b0\u80fd\u7684\u50a8\u5907\u8017\u5c3d\u540e\u632f\u52a8\u505c\u6b62\u201d\u63cf\u8ff0\u6700\u7ec8\u7684\u9759\u6b62\u3002\n\u8fd9\u4e0d\u4fdd\u8bc1\u632f\u5e45\u5728\u67d0\u4e2a\u6709\u9650\u65f6\u523b\u6070\u597d\u53d8\u6210\u96f6\uff1b\n\u5728\u901a\u5e38\u7684\u7ebf\u6027\u9ecf\u6027\u963b\u5c3c\u7406\u60f3\u6a21\u578b\u4e2d\uff0c\u632f\u5e45\u53ef\u4ee5\u4e0d\u65ad\u8d8b\u8fd1\u96f6\u3002\n\n\u5b9e\u9a8c\u4e2d\u8bf4\u632f\u52a8\u201c\u505c\u6b62\u201d\uff0c\u4e5f\u53ef\u80fd\u53ea\u662f\u632f\u5e45\u5df2\u5c0f\u5230\u96be\u4ee5\u5206\u8fa8\u3002\n\u4e0d\u540c\u6469\u64e6\u673a\u5236\u4e0b\u7684\u6700\u7ec8\u505c\u6b62\u8fc7\u7a0b\u53ef\u80fd\u4e0d\u540c\uff0c\u4e0d\u80fd\u4ec5\u51ed\u793a\u610f\u56fe\u89c4\u5b9a\u7edf\u4e00\u7684\u7cbe\u786e\u505c\u6b62\u65f6\u523b\u3002"
    }
  ],
