  "exercises": [
    {
      "number": "1",
      "text": "1. \u5728\u4ec0\u4e48\u6761\u4ef6\u4e0b\uff0c\u7535\u8def\u4e2d\u4f1a\u53d1\u751f\u53d7\u8feb\u7535\u632f\u8361\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u5728\u53ea\u542b\u7535\u963b\u7684\u4ea4\u6d41\u7535\u8def\u4e2d\uff0c\u7535\u6d41\u4e0e\u7535\u538b\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u8bfe\u672c\u7ed9\u51fa\u7684\u4e24\u79cd\u4ea4\u6d41\u7167\u660e\u7ebf\u8def\uff0c\u7535\u538b\u6709\u6548\u503c\u5206\u522b\u4e3a 220 \u4f0f\u548c 127 \u4f0f\u3002\u5047\u5b9a\u4e24\u79cd\u7535\u538b\u90fd\u6309\u6b63\u5f26\u89c4\u5f8b\u53d8\u5316\uff0c\u5b83\u4eec\u5404\u81ea\u7684\u7535\u538b\u632f\u5e45\u662f\u591a\u5c11\uff1f\u8fd9\u662f\u7eb8\u9762\u8ba1\u7b97\u9898\uff0c\u4e0d\u8fdb\u884c\u7ebf\u8def\u6d4b\u91cf\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u7535\u6d41\u6709\u6548\u503c\u548c\u7535\u538b\u6709\u6548\u503c\u5206\u522b\u662f\u600e\u6837\u5b9a\u4e49\u7684\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 14,
      "text": "**\u7535\u6d41\u6709\u6548\u503c\u5c31\u662f\u7535\u6d41\u5e73\u65b9\u7684\u65f6\u95f4\u5e73\u5747\u503c\u7684\u975e\u8d1f\u5e73\u65b9\u6839\uff0c\u4e5f\u53eb\u65b9\u5747\u6839\u503c\u3002**\n\u8bb0\u4f4f\u8fd0\u7b97\u7684\u5148\u540e\u987a\u5e8f\uff1a\u5148\u5e73\u65b9\uff0c\u518d\u6c42\u5e73\u5747\uff0c\u6700\u540e\u5f00\u5e73\u65b9\u3002\n\n\u5e73\u65b9\u4f7f\u4e0d\u540c\u65b9\u5411\u7684\u7535\u6d41\u4e0d\u4f1a\u62b5\u6d88\uff1b\n\u6700\u540e\u5f00\u5e73\u65b9\uff0c\u8ba9\u7ed3\u679c\u56de\u5230\u7535\u6d41\u7684\u5355\u4f4d\u3002\n\n\u7528 $I$ \u8868\u793a\u7535\u6d41\u6709\u6548\u503c\uff1b\n\u8fd9\u4e2a\u5b9a\u4e49\u4e5f\u9002\u7528\u4e8e\u5176\u4ed6\u6ce2\u5f62\uff0c\u4f46\u4e0b\u9762\u7531\u632f\u5e45\u76f4\u63a5\u6c42\u6709\u6548\u503c\u7684\u7ed3\u679c\u53ea\u9002\u7528\u4e8e\u672c\u8bfe\u7684\u6b63\u5f26\u7535\u6d41\uff1a"
    },
    {
      "block": 16,
      "text": "\u6709\u6548\u503c\u8fd8\u53ef\u4ee5\u7528\u76f8\u540c\u7684\u53d1\u70ed\u6548\u679c\u6765\u7406\u89e3\u3002\n\u5728\u540c\u4e00\u4e2a\u7535\u963b\u503c\u56fa\u5b9a\u7684\u7eaf\u7535\u963b $R$ \u4e0a\uff0c\u82e5\u76f4\u6d41\u7535\u6d41\u7684\u5927\u5c0f\u7b49\u4e8e\u4ea4\u6d41\u7535\u6d41\u7684\u6709\u6548\u503c\uff0c\u5b83\u4eec\u7684\u5e73\u5747\u53d1\u70ed\u529f\u7387\u76f8\u540c\u3002\n\u6bd4\u8f83\u76f8\u540c\u957f\u5ea6\u7684\u6574\u5468\u671f\u65f6\u95f4\u95f4\u9694\u65f6\uff0c\u5b83\u4eec\u8f6c\u5316\u4e3a\u70ed\u7684\u603b\u80fd\u91cf\u4e5f\u76f8\u540c\u3002\n\n\u5982\u679c\u6bd4\u8f83\u7684\u65f6\u95f4\u4e0d\u662f\u6574\u5468\u671f\uff0c\u5c31\u5fc5\u987b\u4f7f\u7528\u9488\u5bf9\u90a3\u6bb5\u5b9e\u9645\u65f6\u95f4\u6c42\u5f97\u7684\u6709\u6548\u503c\uff1b\n\u4e0d\u80fd\u4fdd\u8bc1\u5468\u671f\u6709\u6548\u503c\u4f1a\u7ed9\u51fa\u4efb\u610f\u77ed\u65f6\u95f4\u5185\u5b8c\u5168\u76f8\u540c\u7684\u80fd\u91cf\u3002\n\u8fd9\u91cc\u662f\u5728\u6bd4\u8f83\u540c\u4e00\u4e2a\u7535\u963b\u4e0a\u7684\u80fd\u91cf\uff0c\u4e0d\u662f\u8bf4\u76f4\u6d41\u7535\u6d41\u548c\u4ea4\u6d41\u7535\u6d41\u7684\u6bcf\u4e2a\u77ac\u65f6\u503c\u90fd\u76f8\u540c\u3002"
    },
    {
      "block": 17,
      "text": "\u7535\u538b\u4e5f\u6709\u77ac\u65f6\u503c\u3001\u632f\u5e45\u548c\u6709\u6548\u503c\uff0c\u4e0d\u80fd\u628a\u5b83\u4eec\u6df7\u4e3a\u4e00\u8c08\u3002\n\u6c42\u7535\u538b\u6709\u6548\u503c\u7684\u65b9\u6cd5\u4e0e\u7535\u6d41\u76f8\u540c\uff1a\u628a\u77ac\u65f6\u7535\u538b\u5e73\u65b9\uff0c\u5728\u9009\u5b9a\u7684\u65f6\u95f4\u95f4\u9694\u5185\u6309\u65f6\u95f4\u6c42\u5e73\u5747\uff0c\u518d\u53d6\u975e\u8d1f\u5e73\u65b9\u6839\u3002\n\n\u7528\u5c0f\u5199 u \u8868\u793a\u77ac\u65f6\u7535\u538b\uff0c\u7528 U \u8868\u793a\u7535\u538b\u6709\u6548\u503c\uff1b\n\u5bf9\u4e8e\u6309\u6b63\u5f26\u89c4\u5f8b\u53d8\u5316\u7684\u7535\u538b\uff0c\u5728\u5b8c\u6574\u5468\u671f\u5185\u6c42\u5e73\u5747\u5c31\u5f97\u5230\uff1a"
    },
    {
      "block": 20,
      "text": "\u632f\u5e45\u548c\u6709\u6548\u503c\u90fd\u80fd\u63cf\u8ff0\u4ea4\u6d41\u7535\uff0c\u4f46\u5b83\u4eec\u56de\u7b54\u7684\u95ee\u9898\u4e0d\u540c\u3002\n\u632f\u5e45\u63cf\u8ff0\u7535\u6d41\u6216\u7535\u538b\u80fd\u8fbe\u5230\u7684\u5cf0\u503c\uff1b\n\u6709\u6548\u503c\u4fbf\u4e8e\u8ba1\u7b97\u7535\u963b\u4e0a\u7684\u5e73\u5747\u529f\u7387\u3002\n\n\u5bf9\u672c\u8bfe\u7535\u963b\u503c\u56fa\u5b9a\u7684\u7eaf\u7535\u963b\uff0c\u4e0b\u9762\u7684 I \u548c U \u90fd\u8868\u793a\u5728\u540c\u4e00\u65f6\u95f4\u95f4\u9694\u5185\u6c42\u5f97\u7684\u6709\u6548\u503c\uff0cP \u8868\u793a\u8be5\u65f6\u95f4\u95f4\u9694\u5185\u7684\u5e73\u5747\u529f\u7387\u3002\n\u56e0\u4e3a\u8fd9\u4e2a\u7535\u963b\u4e24\u7aef\u7684\u77ac\u65f6\u7535\u538b\u4e0e\u7535\u6d41\u6210\u6b63\u6bd4\u3001\u540c\u76f8\uff0c\u624d\u53ef\u4ee5\u628a\u5e73\u5747\u529f\u7387\u4e5f\u5199\u6210\u4e24\u79cd\u6709\u6548\u503c\u7684\u4e58\u79ef\uff1b\n\u4e0d\u80fd\u628a\u8fd9\u4e00\u4e58\u79ef\u89c4\u5219\u76f4\u63a5\u7528\u4e8e\u542b\u6709\u7535\u611f\u6216\u7535\u5bb9\u7684\u4efb\u610f\u4ea4\u6d41\u7535\u8def\u3002"
    }
  ],
