  "exercises": [
    {
      "number": "1",
      "text": "1. \u56fe213\u662f\u8fc8\u514b\u5c14\u5b59\u6d4b\u5b9a\u5149\u901f\u7684\u5b9e\u9a8c\u793a\u610f\u56fe\u3002\u5149\u5728\u6574\u4e2a\u5f80\u8fd4\u8def\u5f84\u4e2d\u901a\u8fc7\u7684\u603b\u8ddd\u79bb\u7ea6\u4e3a71\u5343\u7c73\u3002\u8981\u5728\u76ee\u955c\u4e2d\u770b\u89c1\u5149\u6e90\uff0c\u65cb\u8f6c\u7684\u516b\u8fb9\u68f1\u955c\u6bcf\u79d2\u5e94\u8f6c\u591a\u5c11\u5708\uff1f\n\u7ea6\u5b9a\uff1a\u6c42\u8fd4\u56de\u5149\u56e0\u68f1\u955c\u8f6c\u52a8\u800c\u9996\u6b21\u91cd\u65b0\u8fdb\u5165\u76ee\u955c\u65f6\u7684\u975e\u96f6\u6700\u5c0f\u8f6c\u901f\uff1b\u5ffd\u7565\u7a7a\u6c14\u4e2d\u5149\u901f\u4e0e\u771f\u7a7a\u4e2d\u5149\u901f\u7684\u5dee\u522b\u3002",
      "figure_ids": [
        "fig-213"
      ]
    },
    {
      "number": "2",
      "text": "2. \u6c34\u5bf9\u771f\u7a7a\u6ce2\u957f\u4e3a$\\lambda=7\\times10^{-5}$\u5398\u7c73\u7684\u7ea2\u5149\u7684\u6298\u5c04\u7387\u4e3a$n_1=$1.33\u3002\n\u6c34\u5bf9\u771f\u7a7a\u6ce2\u957f\u4e3a$\\lambda=4\\times10^{-5}$\u5398\u7c73\u7684\u7d2b\u5149\u7684\u6298\u5c04\u7387\u4e3a$n_2=$1.343\u3002\n\u8ba1\u7b97\u8fd9\u4e24\u79cd\u5149\u5728\u6c34\u4e2d\u7684\u6ce2\u957f\u548c\u4f20\u64ad\u901f\u5ea6\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u4e24\u4e2a\u76f8\u5e72\u5149\u6e90$S_1$\u548c$S_2$\u53d1\u51fa\u6ce2\u957f\u4e3a$\\lambda=5\\times10^{-5}$\u5398\u7c73\u7684\u5149\u3002\u4e24\u5149\u6e90\u95f4\u8ddd\u4e3a$d=0.3$\u6beb\u7c73\uff0c\u5c4f\u5e55\u8ddd\u5149\u6e90$S_1$\u4e3a6\u7c73\u3002\u5c4f\u5e55\u4e0a\u7684$A$\u70b9\uff08\u56fe214\uff09\u4f1a\u51fa\u73b0\u4ec0\u4e48\u73b0\u8c61\uff1a\u4eae\u6591\u8fd8\u662f\u6697\u6591\uff1f\n\u7ea6\u5b9a\uff1a\u6309\u56fe\u793a\u7684\u7406\u60f3\u51e0\u4f55\uff0c\u89c2\u5bdf\u70b9\u662f\u5de6\u4fa7\u5149\u6e90\u5411\u5c4f\u5e55\u4f5c\u5782\u7ebf\u7684\u5782\u8db3\uff0c\u4e24\u5149\u6e90\u8fde\u7ebf\u5e73\u884c\u4e8e\u5c4f\u5e55\u3002\u5047\u5b9a\u4e24\u5149\u6e90\u53d1\u51fa\u7684\u5149\u540c\u76f8\u3001\u504f\u632f\u65b9\u5411\u76f8\u540c\uff0c\u5e76\u5728\u89c2\u5bdf\u70b9\u6709\u76f8\u7b49\u7684\u5149\u5f3a\u3002",
      "figure_ids": [
        "fig-214"
      ]
    },
    {
      "number": "4",
      "text": "4. \u5355\u8272\u6ce2\u5782\u76f4\u5165\u5c04\u5230\u5149\u6805\u5e38\u6570\u4e3a$d=1.2\\times10^{-3}$\u5398\u7c73\u7684\u884d\u5c04\u5149\u6805\u4e0a\u3002\u5982\u679c\u7b2c\u4e8c\u7ea7\u4e0e\u7b2c\u4e09\u7ea7\u5149\u8c31\u4e4b\u95f4\u7684\u5939\u89d2\u4e3a$\\Delta\\varphi=2^\\circ30'$\uff0c\u4f30\u7b97\u6ce2\u957f$\\lambda$\u3002\n\u7ea6\u5b9a\uff1a\u8fd9\u4e24\u7ea7\u5149\u8c31\u4f4d\u4e8e\u4e2d\u592e\u65b9\u5411\u7684\u540c\u4e00\u4fa7\u3002\u4f7f\u7528\u5c0f\u89d2\u8fd1\u4f3c\u8fdb\u884c\u4f30\u7b97\uff0c\u8ba1\u7b97\u65f6\u89d2\u5ea6\u7528\u5f27\u5ea6\u8868\u793a\uff0c\u5e76\u660e\u786e\u7ed3\u679c\u662f\u8fd1\u4f3c\u503c\u800c\u4e0d\u662f\u7cbe\u786e\u503c\u3002",
      "figure_ids": []
    }
  ],
