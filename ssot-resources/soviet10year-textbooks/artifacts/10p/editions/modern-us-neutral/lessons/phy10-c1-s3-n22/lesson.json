  "chapter": "振动和波",
  "section": "第一章　机械振动",
  "number": "22",
  "title": "交流电路中的有效电阻",
  "printed_title": "22. 交流电路中的有效电阻",
  "start_page": 60,
  "start_printed": 50,
  "figures": [
