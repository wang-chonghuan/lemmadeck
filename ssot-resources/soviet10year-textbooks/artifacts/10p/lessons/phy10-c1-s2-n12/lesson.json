  "section": "第一章　机械振动",
  "number": "12",
  "title": "阻尼振动",
  "printed_title": "12. 阻尼振动",
  "start_page": 37,
  "start_printed": 27,
  "figures": [
    {
      "id": "fig-16",
      "label": "图 16",
