{
  "schema": "ld-s10y-answer/mathlive-exact-contract@1",
  "cases": [
    {
      "name": "Chinese text",
      "input": "\\text{是}",
      "expected": ["是", "整式", "是整式"],
      "reject": ["\\text{否}"]
    },
    {
      "name": "plus-minus fraction",
      "input": "\\pm\\frac{2}{5}",
      "expected": ["{-2/5,2/5}", "-2/5,2/5", "2/5,-2/5", "±2/5"],
      "reject": ["\\pm\\frac{3}{5}"]
    },
    {
      "name": "not-equal fraction",
      "input": "x\\ne\\frac12",
      "expected": ["x≠1/2", "x!=1/2", "ℝ∖{1/2}", "R\\{1/2}"],
      "reject": ["x=\\frac12"]
    },
    {
      "name": "real numbers",
      "input": "\\mathbb{R}",
      "expected": ["R", "ℝ", "全体实数", "任意实数", "所有实数"],
      "reject": ["\\mathbb{Z}"]
    },
    {
      "name": "finite set",
      "input": "\\left\\{1,2,3,6\\right\\}",
      "expected": ["{1,2,3,6}", "1,2,3,6"],
      "reject": ["\\left\\{1,2,3,5\\right\\}"]
    },
    {
      "name": "plus-minus integer",
      "input": "\\pm6",
      "expected": ["{-6,6}", "-6,6", "6,-6", "±6"],
      "reject": ["\\pm5"]
    }
  ]
}
