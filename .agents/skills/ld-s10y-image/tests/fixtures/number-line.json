{
  "schema": "ld-s10y-image/figure-spec@2",
  "id": "fig-test-number-line",
  "mode": "deterministic",
  "description": "Three collinear points with equal five-unit intervals.",
  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/5m/figures/fig-29.png",
      "sha256": "1f3b6301c2ce4f4c3712c00b14792926ab69364ec31968dac31053622f60c9b6"
    },
    "authoritativeText": [
      {
        "lesson": "test",
        "text": "Show -5, 0, and 5 at equal intervals on a number line."
      }
    ],
    "inventory": [
      {
        "id": "number-line-facts",
        "description": "The three named points and their equal spacing on one number line.",
        "objects": ["left", "origin", "right", "number-line", "left-name", "right-name"],
        "assertions": [
          "left-distance",
          "right-distance",
          "equal-intervals",
          "same-line"
        ]
      }
    ]
  },
  "canvas": {
    "width": 1200,
    "height": 600,
    "boundingBox": [-7, 3, 7, -3],
    "background": "paper",
    "keepAspectRatio": true
  },
  "display": {
    "layout": "scroll",
    "minTextPx": 16,
    "widths": [600]
  },
  "objects": [
    {
      "id": "left",
      "type": "point",
      "at": [-5, 0],
      "fill": "accent"
    },
    {
      "id": "origin",
      "type": "point",
      "at": [0, 0],
      "fill": "accentSoft"
    },
    {
      "id": "right",
      "type": "point",
      "at": [5, 0],
      "fill": "accent"
    },
    {
      "id": "number-line",
      "type": "axis",
      "from": [-6.3, 0],
      "to": [6.3, 0],
      "stroke": "ink",
      "strokeWidth": 5,
      "tickSize": 0.18,
      "fontSize": 38,
      "ticks": [
        {
          "at": 0.1031746032,
          "label": "-5",
          "labelPlacement": {"position": "S", "gap": 54}
        },
        {
          "at": 0.5,
          "label": "0",
          "labelPlacement": {"position": "S", "gap": 54}
        },
        {
          "at": 0.8968253968,
          "label": "5",
          "labelPlacement": {"position": "S", "gap": 54}
        }
      ]
    },
    {
      "id": "left-name",
      "type": "text",
      "at": "left",
      "text": "A",
      "fontSize": 32,
      "labelPlacement": {"position": "N", "gap": 64}
    },
    {
      "id": "right-name",
      "type": "text",
      "at": "right",
      "text": "B",
      "fontSize": 32,
      "labelPlacement": {"position": "N", "gap": 64}
    }
  ],
  "assertions": [
    {
      "id": "left-distance",
      "type": "distance",
      "a": "left",
      "b": "origin",
      "value": 5
    },
    {
      "id": "right-distance",
      "type": "distance",
      "a": "origin",
      "b": "right",
      "value": 5
    },
    {
      "id": "equal-intervals",
      "type": "equalDistance",
      "a": "left",
      "b": "origin",
      "c": "origin",
      "d": "right"
    },
    {
      "id": "same-line",
      "type": "collinear",
      "a": "left",
      "b": "origin",
      "c": "right"
    },
    {
      "id": "point-count",
      "type": "objectCount",
      "objectType": "point",
      "count": 3
    }
  ],
  "layout": {
    "minLabelGap": 4,
    "avoidRegions": []
  }
}
