      "owner_exercise": null,
      "cont": false,
      "open": false,
      "samerow": false,
      "lines": [
        "在图121上给出了集合 $M=\\{4,7,11,19,22\\}$ 各元素",
        "之间的关系 $h$．从图上可以看出："
      ]
    },
    {
      "kind": "fig",
      "label": "图 121",
      "box": [
        928,
        976,
        413,
        296
      ],
      "owner_exercise": null,
