  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/9p/figures/fig-31.png",
      "sha256": "25b1d2a568c025120f984a3b9c167a4123ad1252d7598c19980a7fc1bd5cecbd"
