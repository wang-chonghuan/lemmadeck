      "questions": [
        {
          "id": "q01",
          "sourceNumbers": [
            "1"
          ],
          "mode": "single",
          "optionCount": 4,
          "task": "识别相干波的时间关系定义，同时保留同频和相位差稳定这两个条件。",
          "unitReason": "以完整的一组定义条件为响应单位，避免把原题必需的条件合取拆成互不关联的性质点击。",
          "limitations": [
            "识别正确陈述不能证明学习者能够自行组织并书写相干波的定义。"
          ]
        },
        {
          "id": "q02",
          "sourceNumbers": [
            "2"
          ],
          "mode": "single",
          "optionCount": 4,
          "task": "识别干涉是相干叠加所形成的稳定增强与减弱分布，并与衍射和吸收区别。",
          "unitReason": "以对现象的完整描述为响应单位，保留原题的定义能力目标，而非只辨认名称或一种振幅效应。",
          "limitations": [
            "识别不能证明学习者能够自行书写定义或推导叠加关系。"
          ]
        },
        {
          "id": "q03",
          "sourceNumbers": [
            "3"
          ],
          "mode": "single",
          "optionCount": 4,
          "task": "同时判断最大值与最小值，保留一般相位条件、有前提的程差条件以及最小值与完全相消的区别。",
          "unitReason": "以一个完整、相互一致的条件组作响应，最大值和最小值必须一起判断，不能悄悄删除程差规则的同相前提，也不是分散的公式空格点击。",
          "limitations": [
            "选择完整条件组不能证明学习者能独立书写或推导两类极值条件。"
          ]
        },
        {
          "id": "q04",
          "sourceNumbers": [
            "4"
          ],
          "mode": "single",
          "optionCount": 4,
          "task": "判断所提出的能量转化结论，区别叠加相消与实际耗散机制。",
          "unitReason": "以结论连同物理能量解释为响应单位，避免只提供是或否而丢失原题的概念区别。",
          "limitations": [
            "识别不能证明学习者能够独立解释能量重新分布或推导合场能量守恒。"
          ]
        },
        {
          "id": "q05",
          "sourceNumbers": [
            "5"
          ],
          "mode": "single",
          "optionCount": 4,
          "task": "识别完整的惠更斯波面构造，包括次波源位置和包络规则。",
          "unitReason": "次波源的陈述和后续波面的构造共同组成一个原理，应作为整体判断。",
          "limitations": [
            "选择原理陈述不能证明学习者能自行表述原理或独立构造新波面。"
          ]
        },
        {
          "id": "q06",
          "sourceNumbers": [
            "6"
          ],
          "mode": "multiple",
          "optionCount": 4,
          "task": "识别理想驻波定义，并与行波比较固定空间结构及平均能量输运。",
          "unitReason": "以一个多选比较共同覆盖同一原题要求的形成和定义以及输运区别，不把每个原文短句变成独立的是非点击。",
          "limitations": [
            "识别不能证明学习者能自由表述驻波定义和比较，或推导其空间与时间因子。"
          ]
        },
        {
          "id": "q07",
          "sourceNumbers": [
            "7"
          ],
          "mode": "single",
          "optionCount": 4,
          "task": "求相邻波节间距以及它比组成波的波长小几倍，明确所取比值方向。",
          "unitReason": "间距和原题要求的倍数是一个完整结果对，响应同时明确比值方向和单位，不另拆成计算点击。",
          "limitations": [
            "选择结果不能证明学习者能独立求相邻零点或书写比值计算。"
          ]
        },
        {
          "id": "q08",
          "sourceNumbers": [
            "8"
          ],
          "mode": "multiple",
          "optionCount": 4,
          "task": "识别障碍物和开口两种几何中明显衍射的尺寸与波长条件，不把较弱衍射等同于严格不存在。",
          "unitReason": "以一个多选题保留两种相关几何及共同尺寸比较这一物理任务，不需要来源图或新图。",
          "limitations": [
            "识别不能证明学习者能自行表述条件、举例或推导衍射图样。"
          ]
        }
      ],
