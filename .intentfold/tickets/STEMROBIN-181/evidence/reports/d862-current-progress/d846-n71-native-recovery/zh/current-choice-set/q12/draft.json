        "source_solution": "\u9009\u9879\u524d\u51bb\u7ed3\u7684\u6e90\u89e3\uff1a\u5728\u8fd1\u8f74\u6a21\u578b\u4e2d\uff0c\u4e3b\u7126\u70b9\u662f\u9760\u8fd1\u5e76\u5e73\u884c\u4e8e\u4e3b\u5149\u8f74\u7684\u5165\u5c04\u5149\u7ebf\u53cd\u5c04\u540e\uff0c\u5176\u53cd\u5c04\u7ebf\u6216\u5411\u540e\u5ef6\u957f\u7ebf\u5728\u4e3b\u8f74\u4e0a\u4f1a\u805a\u7684\u4f4d\u7f6e\u3002\u51f9\u9762\u955c\u53cd\u5c04\u7ebf\u5728\u5165\u5c04\u4fa7\u5b9e\u9645\u76f8\u4ea4\uff0c\u6545\u955c\u524d\u4e3b\u7126\u70b9\u662f\u5b9e\u7126\u70b9\uff1b\u51f8\u9762\u955c\u53cd\u5c04\u7ebf\u5728\u5165\u5c04\u4fa7\u53d1\u6563\uff0c\u5b83\u4eec\u5411\u540e\u5ef6\u957f\u5728\u955c\u540e\u76f8\u4ea4\uff0c\u6545\u4e3b\u7126\u70b9\u662f\u865a\u7126\u70b9\u3002\u5b9e\u9645\u53cd\u5c04\u7ebf\u4e0d\u7ecf\u8fc7\u955c\u540e\u7684\u865a\u7126\u70b9\u3002\u5c0f\u9ad8\u5ea6y\u7684\u6cd5\u7ebf\u503e\u89d2\u8fd1\u4f3cy/R\uff0c\u53cd\u5c04\u65b9\u5411\u6539\u53d8\u7ea62y/R\uff0c\u6240\u4ee5\u7126\u8ddd\u91cf\u503c\u5728\u4e00\u9636\u8fd1\u8f74\u6a21\u578b\u4e2d\u4e3aR/2\u800c\u975e\u66f2\u7387\u4e2d\u5fc3\u8ddd\u79bbR\u3002\u4efb\u610f\u5bbd\u7684\u7403\u9762\u955c\u5149\u675f\u4e0d\u80fd\u88ab\u5ba3\u79f0\u4e25\u683c\u5171\u70b9\uff0c\u9898\u76ee\u4e0d\u6269\u5c55\u5230\u8be5\u60c5\u5f62\u3002",
