        "stem": "\u5728\u8fd1\u8f74\u51f9\u9762\u955c\u7684\u5b9e\u50cf\u4f5c\u56fe\u60c5\u5f62\u4e2d\uff0c\u955c\u9762\u4e2d\u592e\u6709\u5c0f\u5b54\uff0c\u4ece\u8f74\u5916\u7269\u70b9\u53d1\u51fa\u3001\u5c04\u5411\u955c\u5b50\u9876\u70b9\u7684\u4e00\u6761\u5149\u7ebf\u7a7f\u8fc7\u4e86\u5c0f\u5b54\u3002\u7ecf\u8fc7\u66f2\u7387\u4e2d\u5fc3\u3001\u7ecf\u8fc7\u7126\u70b9\u4ee5\u53ca\u5e73\u884c\u4e3b\u5149\u8f74\u7684\u53e6\u4e09\u6761\u65b9\u4fbf\u5149\u7ebf\u5747\u843d\u5230\u6709\u6548\u53cd\u5c04\u9762\u4e0a\uff0c\u4e14\u5b83\u4eec\u7684\u53cd\u5c04\u5149\u8def\u4e24\u4e24\u4e0d\u91cd\u5408\u3002\u54ea\u4e00\u79cd\u65b9\u6848\u80fd\u7528\u5b9e\u9645\u53cd\u5c04\u5149\u7ebf\u5b9a\u4f4d\u8fd9\u4e2a\u7269\u70b9\u7684\u50cf\u70b9\uff1f",
        "figure_ids": [],
