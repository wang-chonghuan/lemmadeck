      "intent": {
        "task": "\u5224\u65ad\u4e00\u4e2a\u5b8c\u6574\u7684\u3001\u53d7\u5b9e\u9645\u955c\u9762\u53ef\u7528\u6027\u9650\u5236\u7684\u4e24\u7ebf\u5b9a\u4f4d\u65b9\u6848\uff1b\u533a\u5206\u5145\u5206\u7684\u4e24\u6761\u7ebf\u3001\u975e\u5fc5\u8981\u7684\u7b2c\u4e09\u6761\u7ebf\u3001\u5355\u7ebf\u6b20\u5b9a\u548c\u5b54\u4e2d\u4e0d\u5b58\u5728\u7684\u53cd\u5c04\u3002",
        "source_solution": "\u6e90\u89e3\u5148\u4e8e\u9009\u9879\u51bb\u7ed3\uff1a\u66f2\u7387\u4e2d\u5fc3\u5149\u7ebf\u539f\u8def\u8fd4\u56de\uff0c\u7126\u70b9\u5149\u7ebf\u53cd\u5c04\u540e\u5e73\u884c\u4e3b\u5149\u8f74\uff0c\u9876\u70b9\u5149\u7ebf\u5173\u4e8e\u4e3b\u5149\u8f74\u5bf9\u79f0\uff0c\u8f74\u5e73\u884c\u5149\u7ebf\u53cd\u5c04\u540e\u7ecf\u7126\u70b9\u3002\u8fd9\u4e9b\u89c4\u5f8b\u9650\u4e8e\u79cd\u5b50\u7684\u8fd1\u8f74\u51f9\u9762\u955c\u6210\u50cf\u8303\u56f4\u3002\u7531\u540c\u4e00\u7269\u70b9\u51fa\u53d1\u7684\u4e24\u6761\u5b9e\u9645\u53ef\u53cd\u5c04\u3001\u4e92\u4e0d\u91cd\u5408\u7684\u65b9\u4fbf\u5149\u7ebf\uff0c\u5728\u8be5\u5b9e\u50cf\u6a21\u578b\u4e2d\u4ee5\u53cd\u5c04\u7ebf\u7684\u4ea4\u70b9\u5b9a\u4f4d\u50cf\u70b9\uff1b\u7b2c\u4e09\u6761\u53ea\u662f\u6821\u6838\uff0c\u4e0d\u662f\u5fc5\u9700\u3002\u4e2d\u592e\u5c0f\u5b54\u4e0d\u63d0\u4f9b\u53cd\u5c04\u7ebf\uff0c\u6240\u4ee5\u5e94\u6539\u9009\u5269\u4f59\u6709\u6548\u955c\u9762\u53cd\u5c04\u7684\u4e24\u6761\u3002\u4e00\u4e2a\u53cd\u5c04\u76f4\u7ebf\u53ea\u80fd\u7ed9\u51fa\u4f4d\u7f6e\u8f68\u8ff9\uff0c\u4e0d\u80fd\u72ec\u81ea\u9009\u51fa\u552f\u4e00\u50cf\u70b9\u3002",
        "unit_reason": "\u8fd9\u662f\u539f\u9009\u4e2d\u5b9a\u4e49\u4e0a\u4e0b\u6587\u4e2d\u7684\u4e24\u7ebf\u5145\u5206\u6027\u548c\u5b9e\u9645\u53ef\u7528\u6027\u5224\u65ad\uff0c\u4e0e\u53e6\u4e00\u9898\u7684\u56db\u79cd\u5149\u7ebf\u5bf9\u5e94\u8fa8\u8ba4\u4e0d\u540c\u3002\u7528\u4e00\u4e2a native single \u6bd4\u8f83\u5b8c\u6574\u4f5c\u56fe\u65b9\u6848\uff0c\u907f\u514d\u628a\u662f\u5426\u9700\u8981\u7b2c\u4e09\u6761\u3001\u662f\u5426\u80fd\u5728\u5b54\u5904\u53cd\u5c04\u5206\u522b\u505a\u6210\u788e\u7247\u5316\u662f\u975e\u9898\u3002\u6ca1\u6709\u9884\u8bbe\u56fa\u5b9a\u9898\u989d\u3002",
