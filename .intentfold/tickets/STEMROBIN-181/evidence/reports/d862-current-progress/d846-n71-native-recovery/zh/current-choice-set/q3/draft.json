            "misconception": "\u53ea\u51ed\u5165\u5c04\u7ebf\u6307\u5411\u51e0\u4f55\u9876\u70b9\u4fbf\u5957\u7528\u9876\u70b9\u53cd\u5c04\u89c4\u5f8b\uff0c\u5ffd\u7565\u9876\u70b9\u5904\u662f\u5b54\u800c\u975e\u53cd\u5c04\u9762\uff0c\u753b\u51fa\u865a\u6784\u7684\u53cd\u5c04\u7ebf\u540e\u4e0e\u53e6\u4e00\u6761\u7ebf\u6c42\u4ea4\u3002"
          },
          {
            "option_id": "c",
            "truth": "correct",
            "derivation": "\u53e6\u4e09\u6761\u65b9\u4fbf\u5149\u7ebf\u5747\u5b9e\u9645\u53cd\u5c04\u4e14\u53cd\u5c04\u8def\u5f84\u4e0d\u91cd\u5408\u3002\u8fd1\u8f74\u5b9e\u50cf\u6a21\u578b\u4f7f\u540c\u4e00\u7269\u70b9\u7684\u8fd9\u4e9b\u53cd\u5c04\u5149\u7ebf\u901a\u8fc7\u540c\u4e00\u50cf\u70b9\uff0c\u6545\u4efb\u53d6\u4e24\u6761\u5e76\u6c42\u4ea4\u5373\u53ef\u552f\u4e00\u5b9a\u4f4d\uff1b\u4e0d\u9700\u8981\u5047\u8bbe\u7a7f\u5b54\u5149\u7ebf\u4e5f\u53cd\u5c04\u3002",
            "misconception": null
