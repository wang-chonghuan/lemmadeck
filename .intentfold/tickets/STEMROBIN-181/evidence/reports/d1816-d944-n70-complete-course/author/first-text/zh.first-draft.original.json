  "chapter": "第二编 电动力学基础",
  "section": "第八章 静电学",
  "number": "70",
  "title": "均匀带电球面和无限大平面的场强",
  "printed_title": "70. 均匀带电球面和无限大平面的场强",
  "start_page": 175,
  "start_printed": 166,
  "figures": [
    {
      "id": "fig-125",
      "label": "图125",
      "page": 175
