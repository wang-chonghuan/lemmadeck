      "nativeHtml": {
        "path": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d038-9p-conclusion-author/work-en/render/9p/modern-us-neutral/phy9-conclusion/text.html",
