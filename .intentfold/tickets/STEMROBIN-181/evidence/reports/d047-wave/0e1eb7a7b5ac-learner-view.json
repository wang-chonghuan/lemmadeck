        "options": [
          {
            "id": "A",
            "text": "横波：质点振动方向与传播方向垂直，例如沿弹簧连接球链传播的密集区域。纵波：质点振动方向与传播方向平行，例如绷紧弹性绳上的侧向波。",
            "figure_ids": []
          },
          {
            "id": "B",
