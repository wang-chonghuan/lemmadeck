    {
      "id": "n39-wave-speed",
      "view": {
        "mode": "single",
        "stem": "对周期性行波，$v$ 表示波速，$\\lambda$ 表示波长，$T$ 表示振动周期，$\\nu$ 表示振动频率。哪个关系式正确？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "$v=\\dfrac{\\lambda}{T}=\\lambda\\nu$",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "$v=\\dfrac{T}{\\lambda}=\\dfrac{1}{\\lambda\\nu}$",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "$v=\\lambda T=\\dfrac{\\lambda}{\\nu}$",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "$v=\\dfrac{2\\lambda}{T}=2\\lambda\\nu$",
            "figure_ids": []
          }
        ]
      }
    },
