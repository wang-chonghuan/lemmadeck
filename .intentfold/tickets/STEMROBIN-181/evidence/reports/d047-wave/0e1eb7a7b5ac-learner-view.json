      "view": {
        "mode": "multiple",
        "stem": "考虑弹性介质中的小振幅前进机械波。哪些说法正确描述了波和介质的运动？选出所有正确说法。",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "波是一种扰动，它通过相邻质点依次传递振动而传播。",
            "figure_ids": []
          },
          {
            "id": "B",
            "text": "每个质点都跟随扰动，从波源一直移动到介质的远端。",
            "figure_ids": []
          },
          {
            "id": "C",
            "text": "质点在局部位置附近振动，而扰动沿介质传递能量。",
            "figure_ids": []
          },
          {
            "id": "D",
            "text": "扰动通过介质的整个过程中，各质点始终保持静止。",
            "figure_ids": []
          },
          {
            "id": "E",
            "text": "无论离波源多远，所有质点都在同一时刻开始运动。",
            "figure_ids": []
          }
        ]
      }
    },
