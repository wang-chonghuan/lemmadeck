      "view": {
        "mode": "single",
        "stem": "对周期性行波，哪项说法给出了波长的定义？",
        "figure_ids": [],
        "options": [
          {
            "id": "A",
            "text": "沿传播方向任意两个不同的、振动相位相同的质点之间的距离。",
