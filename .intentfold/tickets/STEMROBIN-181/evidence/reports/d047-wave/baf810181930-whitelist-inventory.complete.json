  "concept_candidates": [
    {
      "block": 0,
      "text": "\u5728\u6a2a\u6ce2\u4f20\u64ad\u65f6\uff0c\u5f53\u632f\u52a8\u4f20\u5230\u4e86\u7b2c\u5341\u4e09\u4e2a\u7403\u540e\uff0c\u7b2c\u4e00\u4e2a\u548c\u7b2c\u5341\u4e09\u4e2a\u7403\u5c06\u4f5c\u5b8c\u5168\u76f8\u540c\u7684\u632f\u52a8\u3002\n\u5f53\u7b2c\u4e00\u4e2a\u7403\u5728\u5e73\u8861\u4f4d\u7f6e\u4e0a\u5e76\u5411\u5de6\u8fd0\u52a8\u65f6\uff08\u89c1\u56fe70e\uff09\uff0c\u7b2c\u5341\u4e09\u4e2a\u7403\u4e5f\u5728\u5e73\u8861\u4f4d\u7f6e\uff0c\u5e76\u4e14\u4e5f\u5411\u5de6\u8fd0\u52a8\u3002\n\u53c8\u8fc7\u4e86$\\frac{1}{4}$\u5468\u671f\uff0c\u7b2c\u4e00\u4e2a\u7403\u5411\u5de6\u8fd0\u52a8\u5230\u6700\u5927\u504f\u79fb\u4f4d\u7f6e\uff0c\u7b2c\u5341\u4e09\u4e2a\u7403\u540c\u6837\u4e5f\u5230\u8fbe\u8fd9\u6837\u7684\u4f4d\u7f6e\uff08\u89c1\u56fe70f\uff09\u3002\n\n\u8fd9\u4e24\u4e2a\u7403\u7684\u632f\u52a8\u76f8\u4f4d\u603b\u662f\u76f8\u540c\u7684\u3002\n**\u76f8\u8ddd\u6700\u8fd1\u7684\u632f\u52a8\u76f8\u4f4d\u76f8\u540c\u7684\u4e24\u4e2a\u70b9\u95f4\u7684\u8ddd\u79bb\u53eb\u505a\u6ce2\u957f**\u3002\n\u6240\u4ee5\uff0c\u7b2c\u4e00\u4e2a\u7403\u548c\u7b2c\u5341\u4e09\u4e2a\u7403\u4e4b\u95f4\u7684\u8ddd\u79bb\uff0c\u7b2c\u4e8c\u4e2a\u7403\u548c\u7b2c\u5341\u56db\u4e2a\u7403\u4e4b\u95f4\u7684\u8ddd\u79bb\uff0c\u7b2c\u4e09\u4e2a\u7403\u548c\u7b2c\u5341\u4e94\u4e2a\u7403\u4e4b\u95f4\u7684\u8ddd\u79bb\u90fd\u7b49\u4e8e\u6ce2\u957f\uff08\u89c1\u56fe70e\u3001f\uff09\u3002"
    },
    {
      "block": 1,
      "text": "\u56fe71b\u6240\u793a\u7eb5\u6ce2\u7684\u6ce2\u957f\u7b49\u4e8e\u7b2c\u4e8c\u4e2a\u7403\u4e0e\u7b2c\u5341\u56db\u4e2a\u7403\u4e4b\u95f4\u7684\u8ddd\u79bb\uff0c\u6216\u7b2c\u56db\u4e2a\u7403\u4e0e\u7b2c\u5341\u516d\u4e2a\u7403\u4e4b\u95f4\u7684\u8ddd\u79bb\u3002\n\u6ce2\u957f\u7528\u5e0c\u814a\u5b57\u6bcd$\\lambda$\u8868\u793a\u3002"
    },
    {
      "block": 2,
      "text": "\u5728\u6ce2\u4f20\u64ad\u65f6\uff0c\u7269\u4f53\u7684\u4e0d\u540c\u70b9\uff08\u4f8b\u5982\u8fd9\u4e2a\u6a21\u578b\u4e2d\u7684\u5404\u4e2a\u7403\uff09\uff0c\u53ea\u8981\u5b83\u4eec\u4e4b\u95f4\u7684\u8ddd\u79bb\u4e0d\u7b49\u4e8e$n\\lambda$\uff08$n$\u4e3a\u6574\u6570\uff09\uff0c\u5c31\u4ee5\u4e0d\u540c\u7684\u76f8\u4f4d\u632f\u52a8\u3002\n\u76f8\u8ddd$\\lambda/2$\u7684\u7b2c\u4e00\u4e2a\u7403\u548c\u7b2c\u4e03\u4e2a\u7403\uff08\u89c1\u56fe70\uff09\u4ee5\u76f8\u53cd\u7684\u76f8\u4f4d\u632f\u52a8\uff1a\u5f53\u7b2c\u4e00\u4e2a\u7403\u5411\u5de6\u8fd0\u52a8\u65f6\uff0c\u7b2c\u4e03\u4e2a\u7403\u5c31\u5411\u53f3\u8fd0\u52a8\uff0c\u53cd\u8fc7\u6765\u4e5f\u662f\u8fd9\u6837\u3002"
    },
    {
      "block": 3,
      "text": "\u5728\u4e00\u4e2a\u5468\u671f\u5185\uff0c\u6ce2\u4f20\u64ad\u7684\u8ddd\u79bb\u4e3a$\\lambda$\uff08\u89c1\u56fe70e\uff09\u3002\n\u56e0\u6b64\uff0c\u6ce2\u901f\u53ef\u7531\u4e0b\u9762\u7684\u516c\u5f0f\u6c42\u51fa\uff1a\n$v=\\frac{\\lambda}{T}$ (4.1)\n\n\u56e0\u4e3a\u5468\u671f$T$\u4e0e\u9891\u7387$\\nu$\u7684\u5173\u7cfb\u4e3a\n$T=\\frac{1}{\\nu}$\uff0c\n\u6240\u4ee5\uff1a\n$v=\\lambda\\nu$ (4.2)"
    },
    {
      "block": 4,
      "text": "**\u6ce2\u901f\u7b49\u4e8e\u6ce2\u957f\u4e0e\u632f\u52a8\u9891\u7387\u7684\u4e58\u79ef**\u3002"
    },
    {
      "block": 5,
      "text": "\u6ce2\u6cbf\u7ef3\u4f20\u64ad\u65f6\uff0c\u6211\u4eec\u53ef\u4ee5\u89c2\u5bdf\u5230\u4e24\u79cd\u5468\u671f\u6027\u3002"
    },
    {
      "block": 6,
      "text": "\u7b2c\u4e00\uff0c\u7ef3\u7684\u6bcf\u4e2a\u8d28\u70b9\u968f\u65f6\u95f4\u4f5c\u5468\u671f\u6027\u632f\u52a8\u3002\n\u5728\u8c10\u632f\u52a8\u7684\u60c5\u51b5\u4e0b\uff0c\u8fd9\u4e9b\u632f\u52a8\u9075\u5faa\u6b63\u5f26\u6216\u4f59\u5f26\u89c4\u5f8b\uff0c\u5404\u8d28\u70b9\u7684\u9891\u7387\u548c\u632f\u5e45\u76f8\u540c\uff0c\u533a\u522b\u4ec5\u5728\u4e8e\u76f8\u4f4d\u3002"
    },
    {
      "block": 7,
      "text": "\u7b2c\u4e8c\uff0c\u5728\u4efb\u4e00\u65f6\u523b\uff0c\u7ef3\u4e0a\u6bcf\u9694$\\lambda$\u7684\u8ddd\u79bb\u5c31\u4f1a\u51fa\u73b0\u91cd\u590d\u7684\u6ce2\u5f62\u3002\n\u56fe72\u4e2d\u8fc7$O$\u70b9\u7684\u66f2\u7ebf\u8868\u793a\u67d0\u4e00\u65f6\u523b\u7684\u6ce2\u5f62\u3002\n\u968f\u7740\u65f6\u95f4\u63a8\u79fb\uff0c\u6574\u4e2a\u6ce2\u5f62\u4ee5\u901f\u5ea6$v$\u4ece\u5de6\u5411\u53f3\u79fb\u52a8\u3002"
    },
    {
      "block": 10,
      "text": "\u7ecf\u8fc7\u4e00\u6bb5\u65f6\u95f4\n$\\Delta t=\\frac{\\Delta s}{v}$\n\u6ce2\u5f62\u5c31\u53d8\u6210\u56fe\u4e2d\u4e0d\u8fc7$O$\u70b9\u7684\u90a3\u6761\u66f2\u7ebf\u3002"
    },
    {
      "block": 11,
      "text": "\u8868\u793a\u6ce2\u901f\u3001\u6ce2\u957f\u4e0e\u632f\u52a8\u9891\u7387\u5173\u7cfb\u7684\u516c\u5f0f(4.2)\uff0c\u540c\u6837\u9002\u7528\u4e8e\u7eb5\u6ce2\u3002"
    }
  ],
