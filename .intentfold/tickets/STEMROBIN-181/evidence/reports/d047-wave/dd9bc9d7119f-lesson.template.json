      "historical_entities": []
    },
    {
      "kind": "p",
      "text": "音叉的振动阻尼较小，所以共振曲线比较尖锐。\n这与第14节的讨论一致。",
      "id": null,
      "label": null,
      "printed_page": 112,
      "source_refs": [
        "p0122#9"
      ],
      "source_text": "音叉振动的阻尼小，所以共鸣曲线非常尖锐（见第14节）。",
      "changes": [
        "wording",
        "modernized",
        "layout"
      ],
      "numeric_changes": [],
      "historical_entities": []
    }
  ],
