        "requires": ["pointRelationships"]
      },
      {
        "id": "src184-anterior",
        "description": "Cornea 2 is the forward bulge, aqueous chamber 4 is behind it and before iris 3, and convex crystalline lens 6 is behind pupil 5. Muscle 7 is at the upper lens attachment. Label 5 forks to both iris aperture margins. Target dots and exact coordinates are modern schematic aids.",
        "objects": ["cornea", "iris-upper", "iris-lower", "lens", "muscle-upper", "muscle-lower", "cornea-target", "aqueous-target", "iris-target", "lens-target", "muscle-target", "pupil-upper", "pupil-lower", "callout-2", "callout-3", "callout-4", "callout-5-upper", "callout-5-lower", "callout-6", "callout-7", "number-2", "number-3", "number-4", "number-5", "number-6", "number-7"],
        "assertions": ["label-2-target", "label-3-target", "label-4-target", "label-5-upper-target", "label-5-lower-target", "label-6-target", "label-7-target", "cornea-before-aqueous", "aqueous-before-iris", "iris-before-lens", "muscle-above-lens", "pupil-gap", "pupil-to-iris", "pupil-to-lens"],
        "requires": ["pointRelationships"]
      },
      {
        "id": "src184-vitreous",
        "description": "8 identifies the large clear vitreous chamber behind the lens; its source leader descends from above the globe. The clean leader terminates within the chamber as a modern clarification.",
        "objects": ["vitreous-target", "lens-target", "callout-8", "number-8"],
        "assertions": ["label-8-target", "vitreous-behind-lens"],
        "requires": ["pointRelationships"]
      },
      {
        "id": "src184-axis",
        "description": "An unarrowed horizontal dashed axis extends through the anterior opening toward the inner posterior wall; there are no incoming rays, angles, focal points, or image arrows.",
        "objects": ["eye-axis"],
        "assertions": ["axis-horizontal", "axis-through-pupil"]
      }
    ]
  },
