        "requires": ["pointRelationships"]
      },
      {
        "id": "src185-eye",
        "description": "Contextual right-side eye outline faces left; the sight-ray vertex is within the anterior portion and the rear-going upper rays end on the posterior outline. No labelled lens or retinal-image arrow occurs.",
