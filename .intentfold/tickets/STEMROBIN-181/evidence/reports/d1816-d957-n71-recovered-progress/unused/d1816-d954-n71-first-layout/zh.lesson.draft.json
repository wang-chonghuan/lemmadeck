          "label": "图132",
          "printed_page": 170,
          "source_refs": [
            "p0179#4"
          ]
        },
        {
          "kind": "fig",
          "text": "",
          "id": "fig-133",
          "label": "图133",
          "printed_page": 170,
          "source_refs": [
            "p0179#5"
