        "path": "/Users/yong/.codex/worktrees/stemrobin-181-six/lemmadeck/.tmp/STEMROBIN-181/d1816-d194/work/adapt/10p/modern-us-neutral/lessons/phy10-c1-s3-n21/lesson.template.json",
