          "text": "<!-- p -->        正文段"
        },
        {
          "line": 206,
          "text": "<!-- exhead -->   习题栏标题（复习题 / 家庭作业题）"
        },
        {
          "line": 207,
          "text": "<!-- ex 20 -->    第 20 题，20 是原书题号"
        },
        {
          "line": 208,
          "text": "<!-- fig 图 7 box 790,1640,490,250 -->   插图/表格，框照网格估"
        },
        {
          "line": 209,
          "text": "<!-- fig 表 box 790,1640,490,250 owner-ex 20 --> 无编号练习图，明确归第 20 题"
        },
        {
          "line": 210,
          "text": "<!-- cap 图 7 --> 印刷出来的图题行       <!-- foot --> 页码"
        },
        {
          "line": 211,
          "text": "```"
        },
        {
          "line": 212,
          "text": ""
        },
        {
          "line": 213,
          "text": "三个标记："
        },
        {
          "line": 214,
          "text": ""
        },
        {
          "line": 215,
          "text": "- `open` —— 这个对象还没完，下面接着（**跨页、也跨插图**）"
        },
        {
          "line": 216,
          "text": "- `cont` —— 承接上一个同类对象"
        },
        {
          "line": 217,
          "text": "- `samerow` —— 本块与上一块共享印刷行（正文右侧的图题、并排的两个图题）；"
        },
        {
          "line": 218,
          "text": "  多行 `cap` 表示每一行都与相邻图题或正文同排，其他块只表示首行同排"
        },
        {
          "line": 219,
          "text": ""
        },
        {
          "line": 220,
          "text": "一个被插图从中间截断的段落，写成 `p open` … `fig` … `p cont`，cap2 会接成一段。"
        },
        {
          "line": 221,
          "text": "配对时 `fig`/`cap`/`foot` 是透明的。"
        },
        {
          "line": 222,
          "text": ""
        }
      ]
    },
    "assembly": {
      "path": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.claude/skills/ld-s10y-lesson/tools/assemble.py",
      "sha256": "4f16b51802a415cebcfec6fb359549027f8b3bd6ba8d62ef0fad5f0187494340",
      "function": "merge_across_pages",
      "exact_lines": [
        {
          "line": 53,
          "text": "def merge_across_pages(stream: list[dict]) -> tuple[list[dict], list[str]]:"
        },
        {
          "line": 54,
          "text": "    \"\"\"open 的块与下一页 cont 的块接成一个对象。文本一个字不改，只是接上。\"\"\""
        },
        {
          "line": 55,
          "text": "    # 页码、插图、图题都可能夹在一个对象的两半之间（文字环绕的插图、页脚），"
        },
        {
          "line": 56,
          "text": "    # 配对时要当它们不存在——否则一段被插图打断的正文就永远接不上。"
        },
        {
          "line": 57,
          "text": "    TRANSPARENT = (\"foot\", \"fig\", \"cap\")"
        },
        {
          "line": 58,
          "text": "    def transparent(block):"
        },
        {
          "line": 59,
          "text": "        return block[\"kind\"] in TRANSPARENT or ("
        },
        {
          "line": 60,
          "text": "            block[\"kind\"] == \"p\" and block.get(\"label\") == \"footnote\""
        },
        {
          "line": 61,
          "text": "        )"
        },
        {
          "line": 62,
          "text": "    out, warn = [], []"
        },
        {
          "line": 63,
          "text": "    for b in stream:"
        },
        {
          "line": 64,
          "text": "        b = dict(b)"
        },
        {
          "line": 65,
          "text": "        if b[\"kind\"] == \"p\" and b.get(\"label\") != \"footnote\":"
        },
        {
          "line": 66,
          "text": "            b[\"footnote_callouts\"] = ["
        },
        {
          "line": 67,
          "text": "                {\"marker\": marker, \"ref\": b[\"ref\"]}"
        },
        {
          "line": 68,
          "text": "                for marker in sorted(set(re.findall(f\"[{FOOTNOTE_MARKERS}]\", B.text_of(b))))"
        },
        {
          "line": 69,
          "text": "            ]"
        },
        {
          "line": 70,
          "text": "        prev = next((x for x in reversed(out) if not transparent(x)), None)"
        },
        {
          "line": 71,
          "text": "        if transparent(b):"
        },
        {
          "line": 72,
          "text": "            out.append(dict(b))"
        },
        {
          "line": 73,
          "text": "            continue"
        },
        {
          "line": 74,
          "text": "        if b.get(\"cont\"):"
        },
        {
          "line": 75,
          "text": "            if prev is None or not prev.get(\"open\"):"
        },
        {
          "line": 76,
          "text": "                warn.append(f\"{b['ref']}: 标了 cont，但上一块没标 open\")"
        },
        {
          "line": 77,
          "text": "            elif prev[\"kind\"] != b[\"kind\"] or ("
        },
        {
          "line": 78,
          "text": "                    b[\"kind\"] == \"ex\" and prev.get(\"label\") not in (None, b.get(\"label\"))):"
        },
        {
          "line": 79,
          "text": "                warn.append(f\"{b['ref']}: cont 接不上——上块是 {prev['kind']}\""
        },
        {
          "line": 80,
          "text": "                            f\"{prev.get('label') or ''}，本块是 {b['kind']}{b.get('label') or ''}\")"
        },
        {
          "line": 81,
          "text": "            elif not 0 <= b[\"page\"] - int("
        },
        {
          "line": 82,
          "text": "                    BLOCKREF.match((prev.get(\"spans\") or [prev[\"ref\"]])[-1]).group(1)"
        },
        {
          "line": 83,
          "text": "            ) <= 1:"
        },
        {
          "line": 84,
          "text": "                warn.append(f\"{b['ref']}: cont 接不上——与上块末页不相邻\")"
        },
        {
          "line": 85,
          "text": "            else:"
        },
        {
          "line": 86,
          "text": "                prev[\"lines\"] += b[\"lines\"]"
        },
        {
          "line": 87,
          "text": "                prev[\"open\"] = b.get(\"open\", False)"
        },
        {
          "line": 88,
          "text": "                prev.setdefault(\"spans\", [prev[\"ref\"]]).append(b[\"ref\"])"
        },
        {
          "line": 89,
          "text": "                prev.setdefault(\"footnote_callouts\", []).extend("
        },
        {
          "line": 90,
          "text": "                    b.get(\"footnote_callouts\", [])"
        },
        {
          "line": 91,
          "text": "                )"
        },
        {
          "line": 92,
          "text": "                continue"
        },
        {
          "line": 93,
          "text": "        elif prev is not None and prev.get(\"open\") and prev[\"page\"] != b[\"page\"]:"
        },
        {
          "line": 94,
          "text": "            warn.append(f\"{prev['ref']}: 标了 open，但下一页首块没标 cont\")"
        },
        {
          "line": 95,
          "text": "        out.append(dict(b))"
        },
        {
          "line": 96,
          "text": "    return out, warn"
        },
        {
          "line": 97,
          "text": ""
        },
        {
          "line": 98,
          "text": ""
        },
        {
          "line": 99,
          "text": "def cut_lessons(stream: list[dict]) -> list[dict]:"
        },
        {
          "line": 100,
          "text": "    \"\"\"h3 开一节。h1/h2 记作祖先标题，跟着下一节走。\"\"\""
        }
