  "science_checks": [
    {
      "id": "S1",
      "status": "pass",
      "source_refs": [
        "p0184#3",
        "p0184#4"
      ],
      "topic": "Electrostatic conservative work and energy",
      "judgment": "Fixed-source electrostatics is correctly scoped: field work depends on endpoints, closed-path work is zero and A equals minus the potential-energy change. The text does not infer that every time-dependent field is conservative merely from energy conservation. A refers to electric-field work, not all forces' work."
    },
    {
      "id": "S2",
      "status": "pass",
      "source_refs": [
        "p0184#5",
        "p0184#6",
        "p0184#7",
        "p0184#8"
      ],
      "topic": "Potential independent of test charge",
      "judgment": "The source distribution is fixed, probe disturbance negligible, q nonzero and signed, and the reference shared. The interaction potential energy is proportional to q at a given point; division gives a source-field property rather than a property of the probe. The prose explicitly distinguishes potential energy from kinetic or total energy and explains the unit-positive-charge interpretation."
    },
    {
      "id": "S3",
      "status": "pass",
      "source_refs": [
        "p0184#9"
      ],
      "topic": "Vector field versus scalar potential",
      "judgment": "E is a vector determining the charge force and U is a scalar specifying interaction potential energy when the charge and reference are given. The text does not identify negative-charge force direction with the E-vector direction or divide force magnitudes incorrectly."
    },
    {
      "id": "S4",
      "status": "pass",
      "source_refs": [
        "p0184#10",
        "p0185#1",
        "p0185#2"
      ],
      "topic": "Uniform-plate expression and zero reference",
      "judgment": "U=Ed is restricted to the stated uniform region between parallel charged plates, with edge effects ignored, E interpreted as magnitude, distance measured from the negative plate toward the positive plate, and that plate chosen as zero. Potential increases opposite the field direction, so the positive sign of Ed is consistent. This is not asserted as the expression for every electrostatic field."
    },
    {
      "id": "S5",
      "status": "pass",
      "source_refs": [
        "p0185#3",
        "p0185#4",
        "p0185#5"
      ],
      "topic": "Reference shifts and equation8-25",
      "judgment": "Changing the common potential zero adds the same constant to all U values; differences and the specified electric work remain unchanged. A=-q(U2-U1) is valid for signed q. The original unindexed E_P term is explicitly defined as starting potential energy, so the original equation is internally interpretable without inserting a new subscript or registering an erratum."
    },
    {
      "id": "S6",
      "status": "pass",
      "source_refs": [
        "p0185#6",
        "p0185#7",
        "p0185#8",
        "p0185#10",
        "p0185#11",
        "p0185#12"
      ],
      "topic": "Endpoint order, voltage and work signs",
      "judgment": "The lesson explicitly defines Delta U as final minus initial and its V as initial minus final, so V=-Delta U=A/q. Reversing endpoint order reverses V. Positive q with increasing U gives negative field work; negative q with increasing U gives positive work. The text does not make a universal voltage-sign convention or use |q| in place of signed q."
    },
    {
      "id": "S7",
      "status": "pass",
      "source_refs": [
        "p0185#9",
        "p0185#13"
      ],
      "topic": "Circuit example limits",
      "judgment": "The lighting example is limited to circuit portions describable by the electrostatic model. It does not equate emf, source-internal non-electric work or induction-loop total work with static potential difference. No hazardous circuit procedure is introduced."
    },
    {
      "id": "S8",
      "status": "pass",
      "source_refs": [
        "p0186#1",
        "p0186#2",
        "p0186#3"
      ],
      "topic": "SI and historical electrostatic units",
      "judgment": "One volt is correctly expressed as one joule per coulomb, with the positive test-charge and endpoint order specified for positive work. The historical electrostatic unit is expressed as one erg per electrostatic charge unit. The two unit systems are distinguished rather than mixed numerically."
    },
    {
      "id": "S9",
      "status": "pass",
      "source_refs": [
        "p0186#4",
        "p0186#5"
      ],
      "topic": "Printed conversion approximation",
      "judgment": "The original equality chain, powers10^7/3x10^9 and1/300 remain exact source atoms. The prose explicitly says the conversion coefficients are the book's approximate values and not exact modern definitions. The ratio of the stated rounded coefficients is1/300; no new constants or numerical correction are required."
    }
  ],
