      "locales": {
        "zh": {
          "prompt_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/zh/exercises.template.json",
          "prompt_pointer": "/exercises/4/text",
          "source_snapshot_pointer": "/source/data/exercises/4",
          "answer_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/zh/answer-keys.candidate.json",
          "answer_pointer": "/answers/4/displayAnswer",
          "prompt": "5. 什么叫透镜的主焦点？",
          "prompt_sha256": "03ca350fd2cab8db6b645f1047b039865cafeb26af36c90a123907206ee6428e",
          "displayAnswer": "在近轴模型中，平行于透镜主光轴的入射光线经透镜后会聚的点，或折射光线反向延长线相交的点，叫做该入射方向对应的像方主焦点。\n会聚透镜的实际折射光线通过实焦点；发散透镜的实际光线发散，只有反向延长线通过虚焦点。\n反向延长线不是光实际传播的路径，透镜也不是只有一个焦点。",
          "display_answer_sha256": "ceb22d374c8d9eff7f1ccd73c16799e5bcd817a127ba6104522471740cfba74c",
          "source": "derived",
          "grading": "ungraded",
          "parts": []
        },
        "en": {
          "prompt_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/en/exercises.template.json",
          "prompt_pointer": "/exercises/4/text",
          "source_snapshot_pointer": "/source/data/exercises/4",
          "answer_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/en/answer-keys.candidate.json",
          "answer_pointer": "/answers/4/displayAnswer",
          "prompt": "5. What is the principal focus of a lens?",
          "prompt_sha256": "d78061d7ee2b4fea237ca44970c891a3cd72c273d116d8faa3c915f072657da3",
          "displayAnswer": "In the paraxial model, the image-side principal focus for a given direction of incidence is the point where rays incident parallel to the principal axis converge after the lens, or where their backward extensions meet.\nActual refracted rays from a converging lens pass through a real focus. Rays from a diverging lens spread out; only their backward extensions pass through a virtual focus.\nBackward extensions are not actual light paths, and a lens does not have only one focus.",
          "display_answer_sha256": "3a40a2fb03e8878b59cf8c76d9bdb9d9ebe131b0c0b85ad84db0fb3839ffd62c",
          "source": "derived",
          "grading": "ungraded",
          "parts": []
        }
      }
