      "locales": {
        "zh": {
          "prompt_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/zh/exercises.template.json",
          "prompt_pointer": "/exercises/7/text",
          "source_snapshot_pointer": "/source/data/exercises/7",
          "answer_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/zh/answer-keys.candidate.json",
          "answer_pointer": "/answers/7/displayAnswer",
          "prompt": "8. 什么叫做透镜的放大率？",
          "prompt_sha256": "892abc3fc2593a1c1cff5521cc57da82f30375db0b00f2285410a13c41987ac1",
          "displayAnswer": "线放大率是像的线性尺寸与物体对应线性尺寸之比。\n若非零物体高度为 $h$，像高为 $H$，两者按尺寸的大小取值，则 $\\Gamma=H/h$。\n薄透镜近轴模型中有 $\\Gamma=|f|/|d|$。\n这里放大率是非负的大小比，不以它的符号表示正立或倒立；像的方向须另行判断。",
          "display_answer_sha256": "9651d43291c7e3b53f147f72b9ce8732aca047ade707bc8ae598ee6dc69766e8",
          "source": "derived",
          "grading": "ungraded",
          "parts": []
        },
        "en": {
          "prompt_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/en/exercises.template.json",
          "prompt_pointer": "/exercises/7/text",
          "source_snapshot_pointer": "/source/data/exercises/7",
          "answer_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/en/answer-keys.candidate.json",
          "answer_pointer": "/answers/7/displayAnswer",
          "prompt": "8. What is the magnification of a lens?",
          "prompt_sha256": "9b0ade37920195ffca60bc2c835559bcfce8e0367849b0237d7dec8d6b1ad641",
          "displayAnswer": "Linear magnification is image linear size divided by the corresponding object linear size.\nFor nonzero object height $h$ and image height $H$, both taken as size magnitudes, $\\Gamma=H/h$.\nIn the paraxial thin-lens model, $\\Gamma=|f|/|d|$.\nThis magnification is a nonnegative size ratio, not a signed indication of upright or inverted orientation; orientation is determined separately.",
          "display_answer_sha256": "3e7834a61f37f14aadf1600234231e37d493b7aa31bd20859f28a664d1d7680f",
          "source": "derived",
          "grading": "ungraded",
