      "locales": {
        "zh": {
          "prompt_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/zh/exercises.template.json",
          "prompt_pointer": "/exercises/2/text",
          "source_snapshot_pointer": "/source/data/exercises/2",
          "answer_file": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d610-n77-first-written-answer-author/zh/answer-keys.candidate.json",
          "answer_pointer": "/answers/2/displayAnswer",
          "prompt": "3. 全反射的临界角等于什么？",
          "prompt_sha256": "e68c655e1e339beafd2c873483172fd43b598b4c885ea10792794e66f7f8635c",
          "displayAnswer": "在两种透明介质的理想界面上，只有从较大折射率介质射向较小折射率介质，即 $n_1>n_2$ 时，才有全反射临界角。\n临界角从法线量起，是折射角达到直角时的入射角，满足 $\\sin\\theta_c=n_2/n_1$。\n因此 $\\theta_c=\\arcsin(n_2/n_1)$。\n入射角大于临界角时发生全反射；等于临界角是折射光线沿界面的极限情况。",
          "display_answer_sha256": "0ab2122cccc11b5c110de76880d0315546826ec3ac05ccaea1953c568151df43",
          "source": "derived",
          "grading": "ungraded",
          "parts": []
        },
