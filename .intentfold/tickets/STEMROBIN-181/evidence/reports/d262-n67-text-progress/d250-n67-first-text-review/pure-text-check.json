      "mathSignatureCandidate": [
        "S"
      ],
      "inMemoryNormalizedText": "The solid angle subtended by the same set of rays is independent of the sphere radius, because the intercepted area $S$ is proportional to the radius squared.\n\nIts unit is the steradian.\nA solid angle of one steradian intercepts a spherical area whose numerical value equals the square of the radius expressed in the corresponding units.",
      "normalizationWouldChangeText": true,
      "sourceSnapshotPreserved": true,
      "sourceRefsPreserved": true,
      "embeddedSourcePreserved": true,
      "textMatchesAuthoredList": true
    },
    {
