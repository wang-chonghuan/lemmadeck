      ],
      "mathSignatureCandidate": [
        "4\\pi",
        "I=\\frac{\\Phi}{4\\pi}"
      ],
      "inMemoryNormalizedText": "For an ideal point source emitting uniformly in every direction, the full solid angle is $4\\pi$ steradians, and therefore:\n$I=\\frac{\\Phi}{4\\pi}$ (6.4)",
      "normalizationWouldChangeText": false,
      "sourceSnapshotPreserved": true,
      "sourceRefsPreserved": true,
      "embeddedSourcePreserved": true,
      "textMatchesAuthoredList": true
    },
    {
