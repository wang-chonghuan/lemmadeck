      "ordinal": 14,
      "sourceRefs": [
        "p0175#8"
      ],
      "nativeTextErrors": [
        "en.prose[13] 的数学公式变化没有匹配已绑定勘误"
      ],
      "delimiterErrors": [],
      "mathSignatureSource": [
        "\\Omega",
        "\\Phi",
