      "mathSignatureSource": [
        "\\Phi"
      ],
      "mathSignatureCandidate": [
        "\\Phi"
      ],
      "inMemoryNormalizedText": "Here $\\Phi$ is the total luminous flux emitted by the source in all directions, or total optical-radiation power evaluated according to visual response.",
      "normalizationWouldChangeText": false,
      "sourceSnapshotPreserved": true,
      "sourceRefsPreserved": true,
      "embeddedSourcePreserved": true,
      "textMatchesAuthoredList": true
    },
    {
      "language": "en",
      "ordinal": 17,
      "sourceRefs": [
        "p0176#2"
      ],
      "nativeTextErrors": [],
      "delimiterErrors": [],
      "mathSignatureSource": [],
      "mathSignatureCandidate": [],
      "inMemoryNormalizedText": "The International System of Units uses the candela as the unit of luminous intensity①.\n\nThe original book describes a special light emitter as a measurement standard, for example for 1 candela;\n\nthis description does not mean a measurement standard may be chosen arbitrarily.\n\nOther photometric units, including the luminous-flux unit, can be derived from the luminous-intensity unit.",
      "normalizationWouldChangeText": true,
      "sourceSnapshotPreserved": true,
      "sourceRefsPreserved": true,
      "embeddedSourcePreserved": true,
      "textMatchesAuthoredList": true
    },
    {
      "language": "en",
      "ordinal": 18,
      "sourceRefs": [
        "p0176#9"
      ],
      "nativeTextErrors": [],
      "delimiterErrors": [],
      "mathSignatureSource": [],
      "mathSignatureCandidate": [],
      "inMemoryNormalizedText": "① The original footnote records the older Chinese name translated as candlepower;\nthis lesson uses the name candela.",
      "normalizationWouldChangeText": true,
      "sourceSnapshotPreserved": true,
      "sourceRefsPreserved": true,
      "embeddedSourcePreserved": true,
      "textMatchesAuthoredList": true
    },
    {
      "language": "en",
      "ordinal": 19,
      "sourceRefs": [
        "p0176#3"
      ],
      "nativeTextErrors": [],
      "delimiterErrors": [],
      "mathSignatureSource": [],
      "mathSignatureCandidate": [],
      "inMemoryNormalizedText": "Unit of luminous flux. Luminous flux is measured in lumens.\n\nAn ideal point source with a luminous intensity of 1 candela, emitting uniformly over the directional region considered, emits 1 lumen within a solid angle of 1 steradian.",
      "normalizationWouldChangeText": true,
      "sourceSnapshotPreserved": true,
      "sourceRefsPreserved": true,
      "embeddedSourcePreserved": true,
      "textMatchesAuthoredList": true
    }
