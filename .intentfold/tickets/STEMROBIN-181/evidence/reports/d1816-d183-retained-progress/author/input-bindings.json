              "id": null,
              "label": null,
              "printed_page": 49,
              "source_refs": [
                "p0059#6"
              ]
            },
            {
              "kind": "p",
              "text": "所以磁通量按简谐规律变化：$\\Phi=BS\\cos\\omega t$",
              "id": null,
              "label": null,
              "printed_page": 49,
              "source_refs": [
                "p0059#7"
              ]
            },
            {
              "kind": "cap",
              "text": "图 33",
              "id": null,
              "label": "图 33",
              "printed_page": 49,
              "source_refs": [
                "p0059#8"
