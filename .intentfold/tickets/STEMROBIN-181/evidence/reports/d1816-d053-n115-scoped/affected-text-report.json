      },
      {
        "claim": "Conventional-current-selected normal and torque",
        "passages": [
          "R1-NORMAL-TURNS-TORQUE-ENERGY",
          "R3-POSITIVE-CURRENT-DIRECTION"
        ],
        "observation": "R1 explicitly curls right-hand fingers along loop current and uses the thumb for the perpendicular normal. R3 specifies positive current along the wire element. Both added sentences select this same normal using conventional current, not electron drift."
      },
      {
        "claim": "Turns, stable/unstable alignment and reversal settling",
        "passages": [
          "R1-NORMAL-TURNS-TORQUE-ENERGY",
          "R1-ENERGY-MINIMUM"
        ],
        "observation": "R1 provides turn scaling, torque and dipole potential energy, with aligned moment minimizing energy. Existing equilibrium, disturbance and damping reasoning stays explicitly conditional. The repaired normal no longer permits swapping the same-direction stable and opposite-direction unstable labels. No new science derivation or apparatus-polarity inference performed."
      },
      {
        "claim": "Net force versus local force/torque; ideal paired leads and charge sign",
        "passages": [
          "R1-NET-FORCE",
          "R1-NORMAL-TURNS-TORQUE-ENERGY",
          "R2-MAXWELL-UNIFICATION-LORENTZ"
        ],
        "observation": "R1 directly gives zero net force for arbitrary closed current loops in a uniform field while allowing torque; full R2 retains charge-sign dependence through the Lorentz force. Previously reviewed equal/opposite ideal-lead reasoning and real-lead approximate cancellation remain conditional; no zero-local-force claim is introduced."
      }
