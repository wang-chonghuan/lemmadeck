    {
      "id": "source-q6-work-model-limit",
      "severity": "informational-conditional-model",
      "status": "explicit-source-versus-visible-model-distinction",
      "evidence": "The saved first source solution assumed ordinary net-on-gas compression, with an explicit sign and textbook closed-system model. The original sentence does not separately define signed work actor or gross drive expenditure. Visible question and both final answers declare net work and retain alternative-reading limits; the +10K result is not unconditional.",
      "blocking": false
    },
