    "pageOpening": "关系式（6.17）或（6.18）叫做薄透镜公式.",
    "runInHeading": "透镜的放大率",
    "runInHeadingRow": 14,
    "runInHeadingSharesProseRow": true,
    "runInHeadingNativeRef": "p0205#3",
    "runInHeadingJsonPointer": "/blocks/2/lines/0",
