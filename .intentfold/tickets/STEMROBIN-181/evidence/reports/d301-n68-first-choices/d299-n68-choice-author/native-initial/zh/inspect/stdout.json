    {
      "number": "1",
      "text": "\u4ec0\u4e48\u662f\u5149\u7ebf\uff1f",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "\u4ec0\u4e48\u662f\u5149\u901a\u91cf\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "\u4ec0\u4e48\u662f\u53d1\u5149\u5f3a\u5ea6\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "\u70b9\u5149\u6e90\u5728\u8868\u9762\u4e0a\u4ea7\u751f\u7684\u7167\u5ea6\u4e0e\u54ea\u4e9b\u56e0\u7d20\u6709\u5173\uff1f",
      "figure_ids": []
    }
  ],
  "concept_candidates": [
    {
      "block": 0,
      "text": "\u5149\u6e90\u7167\u5728\u7269\u4f53\u8868\u9762\u65f6\uff0c\u7167\u660e\u901a\u5e38\u5e76\u4e0d\u5747\u5300\u3002\n\u4f8b\u5982\uff0c\u60ac\u5728\u684c\u5b50\u4e0a\u65b9\u7684\u706f\u5f80\u5f80\u628a\u684c\u9762\u4e2d\u5fc3\u7167\u5f97\u6700\u4eae\uff0c\u8fb9\u7f18\u5904\u5219\u660e\u663e\u8f83\u6697\u3002\n\u5373\u4f7f\u628a\u706f\u770b\u4f5c\u70b9\u5149\u6e90\uff0c\u684c\u9762\u4e2d\u5fc3\u63a5\u6536\u5230\u7684\u5149\u901a\u91cf\u4e5f\u6bd4\u8fb9\u7f18\u5904\u591a\uff0c\u56e0\u6b64\u8fd9\u79cd\u5dee\u5f02\u4e0d\u53ea\u662f\u706f\u5728\u4e0d\u540c\u65b9\u5411\u4e0a\u7684\u53d1\u5149\u5f3a\u5ea6\u4e0d\u540c\u9020\u6210\u7684\u3002"
    },
    {
      "block": 1,
      "text": "\u7167\u5728\u67d0\u4e2a\u8868\u9762\u4e0a\u7684\u5149\u901a\u91cf $\\Phi$ \u4e0e\u8be5\u8868\u9762\u9762\u79ef $S$ \u7684\u6bd4\u503c\uff0c\u7ed9\u51fa\u8be5\u6709\u9650\u9762\u79ef\u4e0a\u7684\u5e73\u5747\u7167\u5ea6 $E$\u3002\n$E=\\frac{\\Phi}{S}$ (6.5)\n\u5f53\u7167\u660e\u5747\u5300\u65f6\uff0c\u8fd9\u4e2a\u5e73\u5747\u503c\u4e5f\u7b49\u4e8e\u8868\u9762\u5404\u70b9\u7684\u7167\u5ea6\u3002"
    },
    {
      "block": 2,
      "text": "\u7167\u5ea6\u7684\u5355\u4f4d\u662f\u52d2\u514b\u65af\u3002\n\u5f53 1 \u6d41\u660e\u7684\u5149\u901a\u91cf\u5747\u5300\u5206\u5e03\u5728\u9762\u79ef\u4e3a 1 \u7c73$^2$ \u7684\u8868\u9762\u4e0a\u65f6\uff0c\u8be5\u8868\u9762\u7684\u7167\u5ea6\u5c31\u662f\u4e00\u4e2a\u52d2\u514b\u65af\u3002"
    },
    {
      "block": 3,
      "text": "\u8fdb\u884c\u5149\u5ea6\u5b66\u8ba1\u7b97\u65f6\uff0c\u9700\u8981\u77e5\u9053\u8868\u9762\u7684\u7167\u5ea6 $E$ \u4e0e\u8868\u9762\u76f8\u5bf9\u4e8e\u5165\u5c04\u5149\u7ebf\u7684\u671d\u5411\u3001\u5230\u5149\u6e90\u7684\u8ddd\u79bb $R$ \u4ee5\u53ca\u5149\u6e90\u53d1\u5149\u5f3a\u5ea6 $I$ \u4e4b\u95f4\u7684\u5173\u7cfb\u3002"
    },
    {
      "block": 4,
      "text": "\u5728\u5176\u4ed6\u6761\u4ef6\u76f8\u540c\u7684\u60c5\u51b5\u4e0b\uff0c\u7167\u5ea6\u4e0e\u5149\u6e90\u7684\u53d1\u5149\u5f3a\u5ea6\u6210\u6b63\u6bd4\u3002\n\u628a\u4e24\u4e2a\u76f8\u540c\u7684\u5149\u6e90\u653e\u5728\u540c\u4e00\u4f4d\u7f6e\uff0c\u5b83\u4eec\u5728\u5355\u4f4d\u65f6\u95f4\u5185\u6cbf\u67d0\u4e2a\u65b9\u5411\u53d1\u51fa\u7684\u5149\u80fd\uff0c\u662f\u4e00\u4e2a\u5149\u6e90\u53d1\u51fa\u5149\u80fd\u7684\u4e24\u500d\u3002\n\u8fd9\u4e24\u4e2a\u5149\u6e90\u53ef\u4ee5\u7b49\u6548\u5730\u770b\u6210\u4e00\u4e2a\u53d1\u5149\u5f3a\u5ea6\u4e3a\u539f\u6765\u4e24\u500d\u7684\u5149\u6e90\u3002"
    },
    {
      "block": 5,
      "text": "\u628a\u5404\u65b9\u5411\u53d1\u5149\u5f3a\u5ea6\u90fd\u4e3a\u540c\u4e00\u4e2a I \u7684\u5747\u5300\u70b9\u5149\u6e90\u653e\u5728\u7403\u9762\u7684\u4e2d\u5fc3\uff0c\u5c31\u53ef\u4ee5\u7814\u7a76\u7167\u5ea6\u4e0e\u8ddd\u79bb\u7684\u5173\u7cfb\u3002\n\u7403\u9762\u7684\u9762\u79ef\u4e3a $S=4\\pi R^2$\uff0c\u5168\u90e8\u5149\u901a\u91cf\u4e3a $\\Phi=4\\pi I$\uff0c\u89c1\u516c\u5f0f 6.4\u3002\n\u56e0\u6b64\uff0c\u7403\u9762\u4e0a\u7684\u7167\u5ea6\u4e3a\uff1a\n$E=\\frac{\\Phi}{S}=\\frac{4\\pi I}{4\\pi R^2}=\\frac{I}{R^2}$"
    },
    {
      "block": 6,
      "text": "\u56e0\u6b64\uff0c\u8868\u9762\u7684\u7167\u5ea6\u4e0e\u5b83\u5230\u5149\u6e90\u7684\u8ddd\u79bb\u7684\u5e73\u65b9\u6210\u53cd\u6bd4\u3002"
    },
    {
      "block": 7,
      "text": "\u5728\u4e0a\u8ff0\u7403\u9762\u60c5\u5f62\u4e2d\uff0c\u5149\u7ebf\u5782\u76f4\u5165\u5c04\u5230\u8868\u9762\u3002\n\u5149\u7ebf\u5e76\u4e0d\u603b\u662f\u5782\u76f4\u5165\u5c04\uff0c\u5b83\u76f8\u5bf9\u4e8e\u8868\u9762\u7684\u65b9\u5411\u7528\u5165\u5c04\u89d2\u8868\u793a\u3002"
    },
    {
      "block": 8,
      "text": "\u5165\u5c04\u5149\u7ebf\u4e0e\u7ecf\u8fc7\u5165\u5c04\u70b9\u3001\u5782\u76f4\u4e8e\u8868\u9762\u7684\u5916\u5782\u7ebf\u4e4b\u95f4\u7684\u5939\u89d2 $\\alpha$\uff0c\u53eb\u505a\u5149\u7ebf\u7684\u5165\u5c04\u89d2\uff0c\u89c1\u56fe 135\u3002"
    },
    {
      "block": 10,
      "text": "\u4f4d\u4e8e\u7403\u9762\u4e2d\u5fc3\u7684\u5149\u6e90\u53d1\u51fa\u7684\u5149\u7ebf\u5c04\u5230\u7403\u9762\u65f6\uff0c\u5165\u5c04\u89d2\u4e3a\u96f6\u3002"
    },
    {
      "block": 12,
      "text": "\u4e0b\u9762\u4fdd\u6301\u5149\u6e90\u5230\u88ab\u7167\u8868\u9762\u7684\u8ddd\u79bb\u4e0d\u53d8\uff0c\u7814\u7a76\u5165\u5c04\u89d2\u4e0d\u4e3a\u96f6\u65f6\uff0c\u8868\u9762\u7684\u7167\u5ea6\u600e\u6837\u53d8\u5316\u3002"
    },
    {
      "block": 13,
      "text": "\u53d6\u8fd9\u4e2a\u7403\u9762\u5185\u8868\u9762\u4e0a\u5f88\u5c0f\u7684\u4e00\u90e8\u5206\u3002\n\u5982\u679c\u5b83\u7684\u5c3a\u5bf8\u8fdc\u5c0f\u4e8e\u7403\u9762\u7684\u534a\u5f84\uff0c\u5c31\u53ef\u4ee5\u628a\u5b83\u8fd1\u4f3c\u770b\u6210\u5e73\u9762\uff0c\u5e76\u628a\u5c04\u5230\u5b83\u4e0a\u9762\u7684\u5149\u7ebf\u8fd1\u4f3c\u770b\u6210\u5e73\u884c\u5149\u7ebf\u3002\n\n\u8bbe\u8fd9\u90e8\u5206\u9762\u79ef\u4e3a $\\Delta S_0$\uff0c\u89c1\u56fe 136\u3002\n\u518d\u8003\u8651\u53e6\u4e00\u4e2a\u5e73\u9762\uff0c\u5149\u6e90\u5c04\u5230\u5b83\u4e0a\u9762\u7684\u5149\u901a\u91cf\u4e0e\u5c04\u5230\u7b2c\u4e00\u4e2a\u5e73\u9762\u4e0a\u7684\u76f8\u540c\u3002\n\u5982\u679c\u7b2c\u4e8c\u4e2a\u5e73\u9762\u4e0e\u7b2c\u4e00\u4e2a\u5e73\u9762\u6210 $\\alpha$ \u89d2\uff0c\u5149\u7ebf\u5728\u7b2c\u4e8c\u4e2a\u5e73\u9762\u4e0a\u7684\u5165\u5c04\u89d2\u4e5f\u4e3a $\\alpha$\u3002\n\n\u7b2c\u4e8c\u4e2a\u5e73\u9762\u7684\u9762\u79ef\u4e3a $\\Delta S$\u3002\n\u4e24\u4e2a\u5e73\u9762\u7684\u5bbd\u5ea6\u540c\u4e3a $a$\uff0c\u4f46\u957f\u5ea6\u5206\u522b\u4e3a $b$ \u548c $b_0$\uff0c\u7531\u56fe\u4e2d\u7684\u5173\u7cfb\u53ef\u5f97\uff1a\n$\\frac{b_0}{b}=\\cos\\alpha$"
    },
    {
      "block": 16,
      "text": "\u56e0\u6b64\uff0c\u4e24\u5757\u9762\u79ef\u7684\u6bd4\u503c\u4e3a\uff1a\n$\\frac{\\Delta S_0}{\\Delta S}=\\frac{ab_0}{ab}=\\cos\\alpha$"
    },
    {
      "block": 17,
      "text": "\u5f53\u4e24\u5757\u9762\u79ef\u63a5\u6536\u5230\u7684\u5149\u901a\u91cf\u90fd\u4e3a $\\Delta\\Phi$ \u65f6\uff0c\u5b83\u4eec\u7684\u7167\u5ea6\u5206\u522b\u4e3a\uff1a\n$E=\\frac{\\Delta\\Phi}{\\Delta S}$\uff0c\n$E_0=\\frac{\\Delta\\Phi}{\\Delta S_0}$"
    },
    {
      "block": 18,
      "text": "\u4e24\u8005\u7684\u7167\u5ea6\u6bd4\u4e3a\uff1a\n$\\frac{E}{E_0}=\\frac{\\Delta S_0}{\\Delta S}=\\cos\\alpha$"
    },
    {
      "block": 19,
      "text": "\u56e0\u6b64\uff0c\u5149\u7ebf\u659c\u5c04\u65f6\u7684\u7167\u5ea6 $E$ \u4e0e\u5149\u7ebf\u5782\u76f4\u5165\u5c04\u65f6\u7684\u7167\u5ea6 $E_0$ \u6ee1\u8db3\uff1a\n$E=E_0\\cos\\alpha$ (6.6)"
    },
    {
      "block": 20,
      "text": "\u8fd9\u8bf4\u660e\u8868\u9762\u7684\u7167\u5ea6\u4e0e\u5149\u7ebf\u5165\u5c04\u89d2\u7684\u4f59\u5f26\u6210\u6b63\u6bd4\u3002"
    },
    {
      "block": 21,
      "text": "\u628a\u8fd9\u4e9b\u7ed3\u679c\u7ed3\u5408\u8d77\u6765\uff0c\u5c31\u5f97\u5230\u70b9\u5149\u6e90\u7167\u5ea6\u7684\u4e00\u822c\u5173\u7cfb\u3002"
    },
    {
      "block": 22,
      "text": "\u70b9\u5149\u6e90\u4ea7\u751f\u7684\u7167\u5ea6\u4e0e\u53d1\u5149\u5f3a\u5ea6\u53ca\u5165\u5c04\u89d2\u7684\u4f59\u5f26\u6210\u6b63\u6bd4\uff0c\u4e0e\u5149\u6e90\u5230\u8868\u9762\u7684\u8ddd\u79bb\u7684\u5e73\u65b9\u6210\u53cd\u6bd4\uff1a\n$E=\\frac{I}{R^2}\\cos\\alpha$ (6.7)"
    },
    {
      "block": 23,
      "text": "\u5982\u679c\u6709\u591a\u4e2a\u5149\u6e90\uff0c\u8868\u9762\u7684\u603b\u7167\u5ea6\u7b49\u4e8e\u5404\u4e2a\u5149\u6e90\u5355\u72ec\u4ea7\u751f\u7684\u7167\u5ea6\u4e4b\u548c\u3002"
    },
    {
      "block": 24,
      "text": "\u7167\u5ea6\u53ef\u4ee5\u7528\u4e13\u95e8\u7684\u4eea\u5668\u6d4b\u91cf\uff0c\u539f\u4e66\u79f0\u5b83\u4e3a\u6d41\u660e\u8ba1\uff08\u7167\u5ea6\u8ba1\uff09\u3002\n\u6444\u5f71\u5e08\u7528\u6765\u786e\u5b9a\u66dd\u5149\u65f6\u95f4\u7684\u66dd\u5149\u8868\uff0c\u4e5f\u4ee5\u7167\u5ea6\u6d4b\u91cf\u4e3a\u57fa\u7840\u3002"
    },
    {
      "block": 25,
      "text": "\u4e3a\u4f4f\u5b85\u548c\u516c\u5171\u573a\u6240\u8bbe\u7f6e\u7167\u5ea6\u8981\u6c42\uff0c\u662f\u4e3a\u4e86\u63d0\u4f9b\u5408\u9002\u7684\u751f\u6d3b\u548c\u5de5\u4f5c\u73af\u5883\uff0c\u5e76\u4fdd\u62a4\u6b63\u5e38\u89c6\u529b\u3002\n\u539f\u4e66\u4e3e\u51fa\u7684\u6570\u503c\u662f\uff1a\u6559\u5ba4\u9ed1\u677f 150 \u6d41\u660e\uff0c\u5b66\u6821\u697c\u68af 30 \u6d41\u660e\u3002"
    }
  ],
