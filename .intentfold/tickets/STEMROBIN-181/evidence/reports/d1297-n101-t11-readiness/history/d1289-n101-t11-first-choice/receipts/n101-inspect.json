}{4}\\\\frac{v^4}{c^4}$\\uff0c\\u53ef\\u5f97\\uff1a\\n$\\\\sqrt{1-\\\\frac{v^2}{c^2}}\\\\approx 1-\\\\frac{1}{2}\\\\frac{v^2}{c^2}$\"\n    },\n    {\n      \"block\": 4,\n      \"text\": \"\\u6240\\u4ee5\\uff1a\\n$m\\\\approx\\\\frac{m_0}{1-\\\\frac{1}{2}\\\\frac{v^2}{c^2}}$\\n\\u628a\\u5206\\u5b50\\u548c\\u5206\\u6bcd\\u90fd\\u4e58\\u4ee5$\\\\left(1+\\\\frac{1}{2}\\\\frac{v^2}{c^2}\\\\right)$\\uff0c\\u518d\\u5ffd\\u7565$\\\\frac{1}{4}\\\\frac{v^4}{c^4}$\\u9879\\uff0c\\u53ef\\u5f97\\u8fd1\\u4f3c\\u516c\\u5f0f\\uff1a\\n$m\\\\approx m_0+\\\\frac{1}{2}m_0v^2\\\\frac{1}{c^2}$ (8.11)\"\n    },\n    {\n      \"block\": 5,\n      \"text\": \"\\u5728\\u4f4e\\u901f\\u8fd1\\u4f3c\\u4e0b\\uff0c\\u7269\\u4f53\\u7684\\u52a8\\u80fd\\u589e\\u52a0$\\\\Delta K=\\\\frac{1}{2}m_0v^2$\\u65f6\\uff0c\\u5176\\u5386\\u53f2\\u76f8\\u5bf9\\u8bba\\u8d28\\u91cf\\u7684\\u53d8\\u5316$\\\\Delta m=m-m_0$\\u53ef\\u8868\\u793a\\u4e3a\\uff1a\\n$\\\\Delta m=\\\\frac{\\\\Delta K}{c^2}$\"\n    },\n    {\n      \"block\": 6,\n      \"text\": \"\\u8fd9\\u5c31\\u662f\\u8bf4\\uff0c**\\u7269\\u4f53\\u901f\\u5ea6\\u589e\\u5927\\u65f6\\uff0c\\u5386\\u53f2\\u76f8\\u5bf9\\u8bba\\u8d28\\u91cf\\u7684\\u589e\\u52a0\\u91cf\\u7b49\\u4e8e\\u7ed9\\u4e88\\u7269\\u4f53\\u7684\\u52a8\\u80fd\\u9664\\u4ee5\\u5149\\u901f\\u7684\\u5e73\\u65b9**\\u3002\\n\\u8fd9\\u4e0d\\u662f\\u8bf4\\u7269\\u4f53\\u7684\\u4e0d\\u53d8\\u9759\\u8d28\\u91cf\\u4f1a\\u56e0\\u6574\\u4f53\\u8fd0\\u52a8\\u901f\\u5ea6\\u589e\\u5927\\u800c\\u589e\\u52a0\\u3002\"\n    },\n    {\n      \"block\": 7,\n      \"text\": \"**\\u7231\\u56e0\\u65af\\u5766\\u516c\\u5f0f**\\u3002\\n\\u7231\\u56e0\\u65af\\u5766\\u5229\\u7528\\u76f8\\u5bf9\\u8bba\\u5f97\\u5230\\u80fd\\u91cf\\u4e0e\\u8d28\\u91cf\\u4e4b\\u95f4\\u7b80\\u6d01\\u800c\\u666e\\u904d\\u7684\\u5173\\u7cfb\\u3002\\n\\u8fd9\\u91cc\\u7684\\u80fd\\u91cf\\u662f\\u6240\\u9009\\u53c2\\u8003\\u7cfb\\u4e2d\\u7684\\u603b\\u80fd\\u91cf\\uff0c\\u8d28\\u91cf\\u6cbf\\u7528\\u539f\\u4e66\\u7684\\u5386\\u53f2\\u76f8\\u5bf9\\u8bba\\u8d28\\u91cf\\u5b9a\\u4e49\\uff0c\\u516c\\u5f0f\\u4e3a\\uff1a\\n$E=mc^2=\\\\frac{m_0c^2}{\\\\sqrt{1-\\\\frac{v^2}{c^2}}}$ (8.12)\"\n    },\n    {\n      \"block\": 8,\n      \"text\": \"**\\u6309\\u539f\\u4e66\\u7684\\u8d28\\u91cf\\u5b9a\\u4e49\\uff0c\\u7269\\u4f53\\u6216\\u7269\\u4f53\\u7cfb\\u7684\\u80fd\\u91cf\\u7b49\\u4e8e\\u5176\\u8d28\\u91cf\\u4e58\\u4ee5\\u5149\\u901f\\u7684\\u5e73\\u65b9**\\u3002\\n\\u539f\\u4e66\\u8bc4\\u4ef7\\u8bf4\\uff0c\\u5728\\u6574\\u4e2a\\u7269\\u7406\\u5b66\\u4e2d\\uff0c\\u53ea\\u6709\\u4e24\\u4e09\\u4e2a\\u516c\\u5f0f\\u80fd\\u8fd9\\u6837\\u7b80\\u6d01\\u800c\\u666e\\u904d\\u5730\\u8054\\u7cfb\\u91cd\\u8981\\u7684\\u7269\\u7406\\u91cf\\u3002\"\n    },\n    {\n      \"block\": 9,\n      \"text\": \"\\u6309\\u539f\\u4e66\\u7684\\u8d28\\u91cf\\u5b9a\\u4e49\\uff0c\\u5728\\u540c\\u4e00\\u53c2\\u8003\\u7cfb\\u4e2d\\u6bd4\\u8f83\\u540c\\u4e00\\u7cfb\\u7edf\\uff0c\\u7cfb\\u7edf\\u7684\\u603b\\u80fd\\u91cf\\u6539\\u53d8\\u65f6\\uff0c\\u76f8\\u5e94\\u7684\\u5386\\u53f2\\u76f8\\u5bf9\\u8bba\\u8d28\\u91cf\\u4e5f\\u6539\\u53d8\\u3002\\n\\u82e5\\u7cfb\\u7edf\\u524d\\u540e\\u5747\\u9759\\u6b62\\u5728\\u8fd9\\u4e2a\\u53c2\\u8003\\u7cfb\\u4e2d\\uff0c\\u6bd4\\u8f83\\u7684\\u5c31\\u662f\\u7cfb\\u7edf\\u7684\\u9759\\u80fd\\u53d8\\u5316\\uff0c\\u76f8\\u5e94\\u8d28\\u91cf\\u53d8\\u5316\\u662f\\u4e0d\\u53d8\\u8d28\\u91cf\\u7684\\u53d8\\u5316\\uff1a\\n$\\\\Delta m=\\\\frac{\\\\Delta E}{c^2}$ (8.13)\"\n    },\n    {\n      \"block\": 10,\n      \"text\": \"\\u7cfb\\u6570$\\\\frac{1}{c^2}$\\u975e\\u5e38\\u5c0f\\uff0c\\u56e0\\u6b64\\uff0c\\u8981\\u51fa\\u73b0\\u660e\\u663e\\u7684\\u8d28\\u91cf\\u53d8\\u5316\\uff0c\\u80fd\\u91cf\\u53d8\\u5316\\u5fc5\\u987b\\u975e\\u5e38\\u5927\\u3002\\n\\u539f\\u4e66\\u8ba8\\u8bba\\u901a\\u5e38\\u6761\\u4ef6\\u4e0b\\u7684\\u5316\\u5b66\\u53cd\\u5e94\\u548c\\u52a0\\u70ed\\uff0c\\u8ba4\\u4e3a\\u80fd\\u91cf\\u53d8\\u5316\\u5c0f\\u5230\\u65e0\\u6cd5\\u5728\\u5b9e\\u9a8c\\u4e2d\\u53d1\\u73b0\\u76f8\\u5e94\\u7684\\u8d28\\u91