  "exercises": [
    {
      "number": "1",
      "text": "1. \u5199\u51fa\u539f\u4e66\u4e2d\u8868\u793a\u7269\u4f53\u7684\u5386\u53f2\u76f8\u5bf9\u8bba\u8d28\u91cf\u4e0e\u8fd0\u52a8\u901f\u5ea6\u4e4b\u95f4\u5173\u7cfb\u7684\u516c\u5f0f\u3002",
      "figure_ids": []
    },
    {
      "number": "2",
      "text": "2. \u8d28\u80fd\u5173\u7cfb\u5b9a\u5f8b\u7684\u5185\u5bb9\u662f\u4ec0\u4e48\uff1f",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u4ec0\u4e48\u662f\u9759\u80fd\uff1f",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u5728\u539f\u4e66\u6240\u8ba8\u8bba\u7684\u901a\u5e38\u6761\u4ef6\u548c\u5b9e\u9a8c\u6d4b\u91cf\u80fd\u529b\u4e0b\uff0c\u4e3a\u4ec0\u4e48\u96be\u4ee5\u901a\u8fc7\u5b9e\u9a8c\u6d4b\u51fa\u7269\u4f53\u52a0\u70ed\u65f6\u7684\u8d28\u91cf\u589e\u52a0\uff1f",
      "figure_ids": []
    }
  ],
  "concepts": [
    {
      "block": 1,
      "text": "\u539f\u4e66\u4ece\u80fd\u91cf\u5b88\u6052\u5b9a\u5f8b\u548c\u968f\u901f\u5ea6\u53d8\u5316\u7684\u201c\u8d28\u91cf\u201d\u6765\u8bf4\u660e\u8d28\u80fd\u8054\u7cfb\u3002\n\u8fd9\u91cc\u6cbf\u7528\u539f\u4e66\u7684\u5386\u53f2\u201c\u76f8\u5bf9\u8bba\u8d28\u91cf\u201d\u6982\u5ff5\uff0c\u4e0d\u628a\u5b83\u4e0e\u7269\u4f53\u7684\u4e0d\u53d8\u9759\u8d28\u91cf\u6df7\u4e3a\u4e00\u8c08\u3002\n\u7ed9\u5bb9\u5668\u4e2d\u7684\u6c14\u4f53\u52a0\u70ed\uff0c\u5c31\u662f\u4f7f\u6c14\u4f53\u83b7\u5f97\u80fd\u91cf\u3002\n\n\u5206\u5b50\u7684\u65e0\u89c4\u5219\u70ed\u8fd0\u52a8\u901f\u5ea6\u4e0e\u6e29\u5ea6\u6709\u5173\uff0c\u52a0\u70ed\u65f6\u4f1a\u589e\u5927\u3002\n\u6839\u636e\u516c\u5f0f(8.9)\uff0c\u901f\u5ea6\u589e\u5927\u610f\u5473\u7740\u5404\u5206\u5b50\u7684\u5386\u53f2\u76f8\u5bf9\u8bba\u8d28\u91cf\u589e\u5927\uff0c\u800c\u4e0d\u662f\u5404\u5206\u5b50\u7684\u4e0d\u53d8\u9759\u8d28\u91cf\u56e0\u8fd0\u52a8\u800c\u589e\u5927\u3002\n\n\u8fd9\u91cc\u5728\u6c14\u4f53\u6574\u4f53\u9759\u6b62\u7684\u53c2\u8003\u7cfb\u4e2d\uff0c\u6bd4\u8f83\u5bb9\u5668\u4e2d\u540c\u4e00\u4efd\u6c14\u4f53\uff0c\u4e14\u6ca1\u6709\u7269\u8d28\u6d41\u5931\u3002\n\u6c14\u4f53\u4fdd\u7559\u6240\u83b7\u5f97\u7684\u70ed\u80fd\u65f6\uff0c\u5185\u80fd\u589e\u52a0\uff0c\u6574\u4f53\u7684\u4e0d\u53d8\u8d28\u91cf\u4e5f\u589e\u52a0\uff0c\u8bf4\u660e\u6c14\u4f53\u7684\u8d28\u91cf\u4e0e\u80fd\u91cf\u4e4b\u95f4\u5b58\u5728\u8054\u7cfb\u3002"
    },
    {
      "block": 7,
      "text": "**\u7231\u56e0\u65af\u5766\u516c\u5f0f**\u3002\n\u7231\u56e0\u65af\u5766\u5229\u7528\u76f8\u5bf9\u8bba\u5f97\u5230\u80fd\u91cf\u4e0e\u8d28\u91cf\u4e4b\u95f4\u7b80\u6d01\u800c\u666e\u904d\u7684\u5173\u7cfb\u3002\n\u8fd9\u91cc\u7684\u80fd\u91cf\u662f\u6240\u9009\u53c2\u8003\u7cfb\u4e2d\u7684\u603b\u80fd\u91cf\uff0c\u8d28\u91cf\u6cbf\u7528\u539f\u4e66\u7684\u5386\u53f2\u76f8\u5bf9\u8bba\u8d28\u91cf\u5b9a\u4e49\uff0c\u516c\u5f0f\u4e3a\uff1a\n$E=mc^2=\\frac{m_0c^2}{\\sqrt{1-\\frac{v^2}{c^2}}}$ (8.12)"
    },
    {
      "block": 9,
      "text": "\u6309\u539f\u4e66\u7684\u8d28\u91cf\u5b9a\u4e49\uff0c\u5728\u540c\u4e00\u53c2\u8003\u7cfb\u4e2d\u6bd4\u8f83\u540c\u4e00\u7cfb\u7edf\uff0c\u7cfb\u7edf\u7684\u603b\u80fd\u91cf\u6539\u53d8\u65f6\uff0c\u76f8\u5e94\u7684\u5386\u53f2\u76f8\u5bf9\u8bba\u8d28\u91cf\u4e5f\u6539\u53d8\u3002\n\u82e5\u7cfb\u7edf\u524d\u540e\u5747\u9759\u6b62\u5728\u8fd9\u4e2a\u53c2\u8003\u7cfb\u4e2d\uff0c\u6bd4\u8f83\u7684\u5c31\u662f\u7cfb\u7edf\u7684\u9759\u80fd\u53d8\u5316\uff0c\u76f8\u5e94\u8d28\u91cf\u53d8\u5316\u662f\u4e0d\u53d8\u8d28\u91cf\u7684\u53d8\u5316\uff1a\n$\\Delta m=\\frac{\\Delta E}{c^2}$ (8.13)"
    },
    {
      "block": 10,
      "text": "\u7cfb\u6570$\\frac{1}{c^2}$\u975e\u5e38\u5c0f\uff0c\u56e0\u6b64\uff0c\u8981\u51fa\u73b0\u660e\u663e\u7684\u8d28\u91cf\u53d8\u5316\uff0c\u80fd\u91cf\u53d8\u5316\u5fc5\u987b\u975e\u5e38\u5927\u3002\n\u539f\u4e66\u8ba8\u8bba\u901a\u5e38\u6761\u4ef6\u4e0b\u7684\u5316\u5b66\u53cd\u5e94\u548c\u52a0\u70ed\uff0c\u8ba4\u4e3a\u80fd\u91cf\u53d8\u5316\u5c0f\u5230\u65e0\u6cd5\u5728\u5b9e\u9a8c\u4e2d\u53d1\u73b0\u76f8\u5e94\u7684\u8d28\u91cf\u53d8\u5316\u3002\n\u539f\u4e66\u4e3e\u4f8b\u8bf4\uff0c\u6eda\u70eb\u7684\u8336\u58f6\u6bd4\u51b7\u8336\u58f6\u7684\u8d28\u91cf\u5927\u4e9b\uff0c\u4f46\u5373\u4f7f\u7528\u6700\u7075\u654f\u7684\u5929\u5e73\uff0c\u4e5f\u6d4b\u4e0d\u51fa\u8fd9\u4e2a\u5dee\u522b\u3002\n\n\u6bd4\u8f83\u7684\u662f\u540c\u4e00\u8336\u58f6\u53ca\u5176\u5185\u5bb9\u7269\uff0c\u5728\u7269\u8d28\u4e0d\u6d41\u5931\u4e14\u70ed\u80fd\u4fdd\u7559\u65f6\u7684\u9759\u6b62\u72b6\u6001\u3002\n\u8fd9\u91cc\u4fdd\u7559\u7684\u662f\u539f\u4e66\u5bf9\u5f53\u65f6\u5b9e\u9a8c\u80fd\u529b\u7684\u8bf4\u660e\uff0c\u4e0d\u628a\u5b83\u5f53\u4f5c\u4efb\u4f55\u65f6\u4ee3\u90fd\u65e0\u6cd5\u6d4b\u91cf\u7684\u65ad\u8a00\u3002\n\u539f\u4e66\u5c06\u8fd9\u79cd\u60c5\u5f62\u4e0e\u539f\u5b50\u6838\u548c\u57fa\u672c\u7c92\u5b50\u7684\u53d8\u5316\u4f5c\u5bf9\u6bd4\uff1a\u5728\u540e\u8005\u4e2d\uff0c\u80fd\u91cf\u53d8\u5316\u8db3\u591f\u5927\uff0c\u76f8\u5e94\u7684\u8d28\u91cf\u53d8\u5316\u4fbf\u80fd\u88ab\u89c9\u5bdf\u3002"
    },
    {
      "block": 14,
      "text": "\u5728\u8fd9\u91cc\u4fdd\u7559\u7684\u4e8c\u9636\u8fd1\u4f3c\u7cbe\u5ea6\u5185\uff0c\u7b2c\u4e8c\u9879\u662f\u901a\u5e38\u7684\u4f4e\u901f\u52a8\u80fd\uff0c\u7b2c\u4e00\u9879\u5219\u662f\u8fd9\u4e2a\u7ed3\u679c\u6700\u6709\u65b0\u610f\u7684\u90e8\u5206\u3002\n\u7b2c\u4e00\u9879\u7ed9\u51fa\u7269\u4f53\u901f\u5ea6\u4e3a0\u65f6\u7684\u80fd\u91cf\uff0c\u5373**\u9759\u80fd**$E_0$\uff1a\n$E_0=m_0c^2$ (8.15)"
    }
  ],
