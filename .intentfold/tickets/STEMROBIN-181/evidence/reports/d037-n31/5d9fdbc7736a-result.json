        "path": "/Users/yong/.codex/worktrees/00b1/lemmadeck/.intentfold/tickets/STEMROBIN-181/tmp/d037-10p-n31-rebound/zh/work/render/10p/modern-us-neutral/phy10-c1-s4-n31/text.html",
