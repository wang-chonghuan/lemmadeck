  "source": {
    "image": {
      "path": "ssot-resources/soviet10year-textbooks/artifacts/9p/figures/fig-113.png",
      "sha256": "7355322b0274f8222a047b914055c5b5df55d00441aad71e3c0ca414b1d2d356"
