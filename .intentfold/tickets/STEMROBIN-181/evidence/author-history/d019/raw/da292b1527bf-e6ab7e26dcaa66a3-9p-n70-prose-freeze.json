  "changeRationale": [
    {
      "source_refs": ["p0175#5"],
      "reason": "Condition the local-plane approximation on a smooth surface and a sufficiently small scale; do not identify every approximately spherical natural object with a conducting electrostatic sphere."
    },
    {
      "source_refs": ["p0175#6", "p0175#7", "p0176#1", "p0176#3"],
      "reason": "Specify an isolated sphere, undisturbed spherical symmetry, electrostatic equilibrium and a homogeneous linear isotropic medium. Define q as total sphere charge, distinguish radial direction from field magnitude, and interpret the original boundary equality as an exterior one-sided limit."
    },
    {
      "source_refs": ["p0176#4", "p0176#5", "p0176#10"],
      "reason": "Preserve the original square-centimetre wording in source_text while requiring square metres for SI substitution. No original conversion value or numerical erratum is inferred."
    },
    {
      "source_refs": ["p0176#6", "p0176#8", "p0176#10", "p0176#11"],
      "reason": "State an independent infinite sheet in identical media on both sides, without an imposed external field. Describe uniform vectors within each half-space, equal magnitudes and opposite directions across the sheet, and distinguish the two-sided sheet factor from the one-sided conductor boundary model."
    },
    {
      "source_refs": ["p0176#12", "p0176#13"],
      "reason": "Keep the original electrostatic-unit formula and explain that its unit convention must not be mixed with SI numerical inputs."
    },
    {
      "source_refs": ["p0176#14", "p0177#1"],
      "reason": "Limit the finite-sheet approximation to uniform central regions near the plane and far from edges. Require the actual spatial scale, area accumulation and vector sum rather than an unqualified inverse-square argument."
    }
  ],
