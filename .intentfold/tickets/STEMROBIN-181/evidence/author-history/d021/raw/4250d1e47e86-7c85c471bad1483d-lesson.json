  "section": "第八章 静电学",
  "number": "84",
  "title": "电场的能量",
  "printed_title": "84. 电场的能量",
  "start_page": 206,
  "start_printed": 197,
  "figures": [
    {
      "id": "fig-160",
      "label": "图160",
