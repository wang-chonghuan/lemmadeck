  "exercises": [
    {
      "number": "1",
      "text": "1. \u4ece\u5706\u76d8\u4e0a\u6316\u53bb\u4e00\u4e2a\u6247\u5f62\uff08\u56fe101\uff09\u3002\n\u8bbe\u5706\u76d8\u7531\u5747\u5300\u3001\u5404\u5411\u540c\u6027\u7684\u6750\u6599\u5236\u6210\uff0c\u6e29\u5ea6\u5747\u5300\u5347\u9ad8\u65f6\u53ef\u81ea\u7531\u81a8\u80c0\uff0c\u4e0d\u53d7\u5916\u90e8\u7ea6\u675f\uff0c\u4e5f\u6ca1\u6709\u76f8\u53d8\u3002\n\u5728\u8fd9\u4e2a\u6a21\u578b\u4e0b\uff0c\u52a0\u70ed\u5706\u76d8\u65f6\u89d2\u5ea6$\\varphi$\u662f\u5426\u53d8\u5316\uff1f\u8bf7\u8bf4\u660e\u7406\u7531\u3002\u672c\u9898\u53ea\u4f5c\u6982\u5ff5\u5206\u6790\uff0c\u4e0d\u8981\u6c42\u5b9e\u9645\u52a0\u70ed\u3002",
      "figure_ids": [
        "fig-101"
      ]
    },
    {
      "number": "2",
      "text": "2. \u8003\u8651\u539f\u4e66\u7ed9\u51fa\u7684\u6db2\u4f53\u53d7\u70ed\u540e\u6db2\u9762\u5347\u9ad8\u7684\u60c5\u5f62\uff0c\u4f8b\u5982\u6e29\u5ea6\u8ba1\u4e2d\u7684\u6c34\u94f6\u3002\n\u5bb9\u5668\u7684\u5bb9\u91cf\uff08\u5185\u4f53\u79ef\uff09\u4e5f\u968f\u6e29\u5ea6\u5347\u9ad8\u800c\u589e\u5927\uff0c\u4e3a\u4ec0\u4e48\u6db2\u9762\u4ecd\u4f1a\u5347\u9ad8\uff1f\n\u5728\u540c\u4e00\u5bb9\u5668\u4e2d\uff0c\u8bbe\u6db2\u4f53\u4e0e\u5bb9\u5668\u90fd\u8fbe\u5230\u76f8\u540c\u7684\u5747\u5300\u6e29\u5ea6\uff0c\u6db2\u4f53\u8d28\u91cf\u4e0d\u53d8\uff0c\u6ca1\u6709\u84b8\u53d1\u3001\u6cc4\u6f0f\u6216\u76f8\u53d8\u3002\u7528\u6db2\u4f53\u548c\u5bb9\u5668\u7684\u4f53\u79ef\u53d8\u5316\u89e3\u91ca\u9898\u7ed9\u73b0\u8c61\uff0c\u4e0d\u628a\u5b83\u5f53\u4f5c\u6240\u6709\u6db2\u4f53\u4e0e\u5bb9\u5668\u7ec4\u5408\u7684\u666e\u904d\u89c4\u5f8b\u3002\n\u6c34\u94f6\u6e29\u5ea6\u8ba1\u53ea\u662f\u539f\u4e66\u7684\u5386\u53f2\u5668\u6750\u4f8b\u5b50\uff0c\u672c\u9898\u4ec5\u4f5c\u6982\u5ff5\u5206\u6790\uff0c\u4e0d\u8fdb\u884c\u6c34\u94f6\u64cd\u4f5c\u6216\u52a0\u70ed\u5b9e\u9a8c\u3002",
      "figure_ids": []
    },
    {
      "number": "3",
      "text": "3. \u4e24\u4e2a\u6c34\u94f6\u6e29\u5ea6\u8ba1\u7684\u6bdb\u7ec6\u7ba1\u76f4\u5f84\u76f8\u540c\u3002\n\u5728\u76f8\u540c\u6e29\u5ea6\u4e0e\u6d4b\u6e29\u8303\u56f4\u5185\uff0c\u8bbe\u6c34\u94f6\u7ec4\u6210\u3001\u73bb\u7483\u6750\u6599\u53ca\u81a8\u80c0\u6027\u8d28\u76f8\u540c\uff0c\u6bdb\u7ec6\u7ba1\u5185\u5f84\u5747\u5300\uff0c\u6db2\u67f1\u672a\u8fbe\u5230\u7ba1\u7aef\u3002\u91c7\u7528\u53ea\u6bd4\u8f83\u6c34\u94f6\u69fd\u4f53\u79ef\u4e0d\u540c\u7684\u7406\u60f3\u7ed3\u6784\uff0c\u5ffd\u7565\u6bdb\u7ec6\u7ba1\u5185\u6c34\u94f6\u4f53\u79ef\u5bf9\u6bd4\u8f83\u7684\u5f71\u54cd\u3002\n\u8fd9\u91cc\u7684\u7075\u654f\u5ea6\u6307\u8fbe\u5230\u70ed\u5e73\u8861\u540e\uff0c\u540c\u6837\u6e29\u5ea6\u53d8\u5316\u5f15\u8d77\u7684\u6db2\u67f1\u9ad8\u5ea6\u53d8\u5316\uff0c\u4e0d\u662f\u54cd\u5e94\u5feb\u6162\u3002\u54ea\u4e2a\u6e29\u5ea6\u8ba1\u7684\u7075\u654f\u5ea6\u9ad8\uff1a\u6c34\u94f6\u69fd\u5927\u7684\u8fd8\u662f\u6c34\u94f6\u69fd\u5c0f\u7684\uff1f\u8bf7\u8bf4\u660e\u7406\u7531\u3002\n\u8fd9\u662f\u5bf9\u539f\u4e66\u5386\u53f2\u5668\u6750\u7684\u6982\u5ff5\u5206\u6790\uff0c\u4e0d\u64cd\u4f5c\u6c34\u94f6\u6216\u5b9e\u9645\u52a0\u70ed\u3002",
      "figure_ids": []
    },
    {
      "number": "4",
      "text": "4. \u7ed9\u76f4\u5f84\u4e3a1\u7c73\u7684\u6728\u8f6e\u5957\u4e00\u94c1\u7b8d\uff0c\u94c1\u7b8d\u52a0\u70ed\u524d\u7684\u5185\u5f84\u6bd4\u6728\u8f6e\u76f4\u5f84\u5c0f5\u6beb\u7c73\u3002\u4f7f\u94c1\u7b8d\u7684\u5185\u5f84\u521a\u597d\u8fbe\u5230\u6728\u8f6e\u76f4\u5f84\uff0c\u81f3\u5c11\u9700\u8981\u628a\u94c1\u7b8d\u7684\u6e29\u5ea6\u5347\u9ad8\u591a\u5c11\uff1f\u94c1\u7684\u7ebf\u80c0\u7cfb\u6570$\\beta=12\\times10^{-6}$\u5ea6$^{-1}$\u3002\n\u8bbe\u94c1\u7b8d\u5747\u5300\u3001\u5404\u5411\u540c\u6027\u5e76\u53ef\u81ea\u7531\u81a8\u80c0\uff0c\u6728\u8f6e\u76f4\u5f84\u4e0d\u53d8\uff0c\u7ebf\u80c0\u7cfb\u6570\u5728\u8003\u8651\u7684\u6e29\u533a\u5185\u89c6\u4e3a\u5e38\u91cf\u3002\u4ee5\u94c1\u7b8d\u52a0\u70ed\u524d\u7684\u5185\u5f84 D0 \u4e3a\u53c2\u8003\u76f4\u5f84\uff0c\u4e0d\u4ee5\u6728\u8f6e\u76f4\u5f84\u4ee3\u66ff\uff1b\u91c7\u7528\u7ebf\u6027\u70ed\u81a8\u80c0\u8fd1\u4f3c\uff0c\u4e0d\u53e6\u52a0\u88c5\u914d\u95f4\u9699\u3002\n\u8fd9\u662f\u539f\u4e66\u5957\u7b8d\u60c5\u5883\u7684\u7406\u8bba\u8ba1\u7b97\uff0c\u4e0d\u8981\u6c42\u52a0\u70ed\u6216\u88c5\u914d\u64cd\u4f5c\u3002",
      "figure_ids": []
    },
    {
      "number": "5",
      "text": "5. \u5bb9\u5668\u4e2d\u7684\u6c7d\u6cb9\u57280\u00b0C\u65f6\u91cd88\u725b\u987f\u300260\u00b0C\u65f6\u5360\u6709\u76f8\u540c\u4f53\u79ef\u7684\u6c7d\u6cb9\u91cd83\u725b\u987f\u3002\u8bd5\u6c42\u6c7d\u6cb9\u7684\u4f53\u80c0\u7cfb\u6570\u3002\n\u8fd9\u91cc\u6bd4\u8f83\u7684\u662f\u76f8\u540c\u4e14\u56fa\u5b9a\u7684\u5b9e\u9645\u4f53\u79ef\uff0c\u4e0d\u968f\u5bb9\u5668\u7684\u70ed\u81a8\u80c0\u6539\u53d8\uff1b\u4e24\u6b21\u53d6\u6837\u4e0d\u8981\u6c42\u8d28\u91cf\u76f8\u540c\u3002\u8bbe\u6c7d\u6cb9\u7ec4\u6210\u3001\u538b\u529b\u548c\u5f53\u5730\u91cd\u529b\u6761\u4ef6\u76f8\u540c\uff0c\u5ffd\u7565\u6325\u53d1\u6216\u6210\u5206\u53d8\u5316\uff0c\u7528\u521d\u59cb\u72b6\u6001\u4e3a\u53c2\u8003\u7684\u7ebf\u6027\u4f53\u81a8\u80c0\u8fd1\u4f3c\uff0c\u5c06\u4f53\u80c0\u7cfb\u6570\u89c6\u4e3a\u6b64\u6e29\u533a\u5185\u7684\u5e73\u5747\u503c\u3002\n\u672c\u9898\u53ea\u5206\u6790\u539f\u4e66\u7ed9\u5b9a\u6570\u636e\uff0c\u4e0d\u8fdb\u884c\u6c7d\u6cb9\u53d6\u6837\u3001\u79f0\u91cf\u6216\u52a0\u70ed\u64cd\u4f5c\u3002",
      "figure_ids": []
    },
    {
      "number": "6",
      "text": "6. \u57280\u00b0C\u65f6\uff0c\u4e00\u6839\u94a2\u6881\u7d27\u7d27\u5730\u56fa\u5b9a\u5728\u4e24\u5835\u5899\u4e4b\u95f4\u3002\u6e29\u5ea6\u5347\u9ad8\u523010\u00b0C\u65f6\uff0c\u94a2\u6881\u7ed9\u5899\u7684\u5e94\u529b\u4e3a$3\\times10^7$\u725b\u987f/\u7c73$^2$\u3002\u572825\u00b0C\u65f6\uff0c\u94a2\u6881\u7ed9\u5899\u7684\u5e94\u529b\u662f\u591a\u5927\uff1f\n\u8bbe\u521d\u59cb\u56fa\u5b9a\u65f6\u65e0\u9884\u5e94\u529b\uff0c\u5899\u95f4\u8ddd\u548c\u63a5\u89e6\u622a\u9762\u4fdd\u6301\u4e0d\u53d8\uff0c\u94a2\u6881\u6e29\u5ea6\u5747\u5300\u3002\u53ea\u8003\u8651\u8f74\u5411\u53d7\u7ea6\u675f\u7684\u7ebf\u5f39\u6027\u6a21\u578b\uff0c\u5f39\u6027\u6a21\u91cf\u4e0e\u7ebf\u80c0\u7cfb\u6570\u5728\u6b64\u6e29\u533a\u5185\u89c6\u4e3a\u5e38\u91cf\uff0c\u5ffd\u7565\u5899\u4f53\u5f62\u53d8\uff0c\u4e0d\u53d1\u751f\u5c48\u66f2\u6216\u5851\u6027\u53d8\u5f62\u3002\n\u672c\u9898\u4ec5\u4f5c\u7406\u8bba\u5206\u6790\uff0c\u4e0d\u5b9e\u9645\u52a0\u70ed\u53d7\u7ea6\u675f\u7684\u94a2\u6881\u3002",
      "figure_ids": []
    },
    {
      "number": "7",
      "text": "7. \u539f\u4e66\u7528\u201c\u81ea\u52a8\u4fdd\u6301\u6e29\u5ea6\u4e0d\u53d8\u201d\u63cf\u8ff0\u6052\u6e29\u7bb1\u7684\u6e29\u63a7\u7535\u8def\uff0c\u5176\u4e2d\u7684\u53cc\u91d1\u5c5e\u7247\u5728\u6e29\u5ea6\u5347\u9ad8\u65f6\u5207\u65ad\u52a0\u70ed\u5668\u7535\u8def\uff08\u56fe102\uff09\u3002\u8fd9\u91cc\u8ba8\u8bba\u63a5\u70b9\u5f00\u95ed\u5bf9\u6e29\u5ea6\u7684\u8c03\u8282\uff0c\u4e0d\u628a\u5b83\u7406\u89e3\u4e3a\u4efb\u4f55\u65f6\u523b\u6e29\u5ea6\u90fd\u7cbe\u786e\u4e0d\u53d8\u3002\n\u8bbe\u4e24\u5c42\u91d1\u5c5e\u7262\u56fa\u7ed3\u5408\u3001\u5171\u540c\u53d7\u70ed\uff0c\u5747\u4fdd\u6301\u5f39\u6027\uff0c\u7ebf\u80c0\u7cfb\u6570\u5728\u8003\u8651\u7684\u6e29\u533a\u5185\u89c6\u4e3a\u5e38\u91cf\u3002\u6309\u539f\u56fe\u7684\u4e0a\u4e0b\u5c42\u3001\u56fa\u5b9a\u7aef\u548c\u63a5\u70b9\u4f4d\u7f6e\u4f5c\u5b9a\u6027\u5206\u6790\uff0c\u4e0d\u6539\u53d8\u539f\u56fe\u6784\u578b\u3002\n\u7535\u8def\u7684\u5de5\u4f5c\u539f\u7406\u662f\u4ec0\u4e48\uff1f\u53cc\u91d1\u5c5e\u7247\u4e0b\u9762\u548c\u4e0a\u9762\u7684\u91d1\u5c5e\uff0c\u54ea\u4e00\u79cd\u7ebf\u80c0\u7cfb\u6570\u5c0f\uff1f\u4e3a\u4e86\u5728\u6e29\u5ea6\u5347\u9ad8\u65f6\u8ba9\u53cc\u91d1\u5c5e\u7247\u63a5\u901a\u7535\u8def\uff0c\u4f5c\u4e3a\u4fe1\u53f7\u5668\uff0c\u7535\u8def\u7684\u63a5\u70b9\u5b89\u6392\u5e94\u5f53\u600e\u6837\u6539\u53d8\uff1f\n\u672c\u9898\u53ea\u8bf4\u660e\u6982\u5ff5\u4e0a\u7684\u7535\u8def\u6539\u53d8\uff0c\u4e0d\u5b9e\u9645\u63a5\u7ebf\u3001\u6539\u88c5\u6052\u6e29\u5668\u3001\u64cd\u4f5c\u52a0\u70ed\u5668\u6216\u63a5\u89e6\u5e02\u7535\u3002",
      "figure_ids": [
